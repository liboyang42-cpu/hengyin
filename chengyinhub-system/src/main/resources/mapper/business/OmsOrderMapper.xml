    <update id="markCommerceOrderPaid">
        update oms_order
        set status = 1, pay_type = 1, payment_transaction_id = #{transactionId},
            payment_time = now(), update_time = now()
        where id = #{id} and status = 0 and biz_type is not null
    </update>

    <select id="selectPendingCommerceOrders" resultMap="OmsOrderResult">
        <include refid="selectOmsOrderVo"/>
        where id &gt; #{afterId} and status = 0 and create_time &lt; #{before}
          and biz_type in ('premium_template','promotion_slot','custom_event')
        order by id limit #{limit}
    </select>
    <update id="markCommerceOrderClosed">
        update oms_order set status = 5, update_time = now()
        where id = #{id} and status = 0 and biz_type in ('premium_template','promotion_slot','custom_event')
    </update>

    <delete id="deleteOmsOrderById" parameterType="Long">
        delete from oms_order where id = #{id}
    </delete>

    <delete id="deleteOmsOrderByIds" parameterType="String">
        delete from oms_order where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- PII 加密历史回填:未迁移=receiver_phone_hash 为空且有收货手机 -->
    <select id="selectLegacyReceiverPiiIds" resultType="java.lang.Long">
        select id from oms_order
        where receiver_phone_hash is null and receiver_phone is not null and receiver_phone != ''
        limit #{limit}
    </select>

    <update id="backfillOrderReceiverPii">
        update oms_order
        set receiver_name = #{receiverName,typeHandler=com.chengyinhub.business.security.PiiCryptoTypeHandler},
            receiver_phone = #{receiverPhone,typeHandler=com.chengyinhub.business.security.PiiCryptoTypeHandler},
            receiver_phone_hash = #{receiverPhone,typeHandler=com.chengyinhub.business.security.PiiBlindIndexTypeHandler},
            receiver_detail_address = #{receiverDetailAddress,typeHandler=com.chengyinhub.business.security.PiiCryptoTypeHandler}
        where id = #{id} and receiver_phone_hash is null
    </update>
    <select id="selectCommerceOrderForUpdate" resultMap="OmsOrderResult" useCache="false" flushCache="true">
        <include refid="selectOmsOrderVo"/>
        WHERE order_sn=#{orderSn} AND biz_type IN ('premium_template','promotion_slot','custom_event') FOR UPDATE
    </select>
    <update id="bindCommercePaymentProof">
        UPDATE oms_order
        SET verified_payment_fact_id=#{factId}, verified_payment_fact_hash=CAST(#{factHash} AS BINARY)
        WHERE id=#{order.id} AND order_sn=#{order.orderSn} AND member_id=#{order.memberId}
          AND mms_merchant_id=#{order.mmsMerchantId} AND biz_type=#{order.bizType} AND pay_amount=#{order.payAmount}
          AND status=1 AND payment_transaction_id=#{transactionId}
          AND verified_payment_fact_id IS NULL AND verified_payment_fact_hash IS NULL
    </update>
    <select id="selectOmsOrderByIdForUpdate" resultMap="OmsOrderResult" useCache="false" flushCache="true">
        <include refid="selectOmsOrderVo"/>
        WHERE id=#{id} FOR UPDATE
    </select>
