    <sql id="selectOmsOrderVo">
        select id, order_type, order_sn, pay_id, member_id, mms_merchant_id, product_quantity, product_total_amount, delivery_fee, pay_amount, tax_fee, order_total_amount, points_amount, pay_type, status, aftersale_status, delivery_company, delivery_sn, auto_confirm_day, receiver_name, receiver_phone, receiver_phone_code, receiver_province, receiver_detail_address, order_note, merchant_note, confirm_status, payment_time, delivery_time, receive_time, member_coupon_id, coupon_amount, del_flag, biz_type, entitlement_max_usage, entitlement_days, payment_transaction_id, commerce_request_id, verified_payment_fact_id, CONVERT(verified_payment_fact_hash USING ascii) AS verified_payment_fact_hash, create_by, create_time, update_by, update_time from oms_order
    </sql>

    <sql id="merchantLedgerWhere">
        where mms_merchant_id = #{merchantId}
          and (del_flag is null or del_flag != 2)
          <if test="status != null">and status = #{status}</if>
          <if test="aftersaleOnly != null and aftersaleOnly">and aftersale_status &gt; 1</if>
          <if test="beginTime != null">and create_time &gt;= #{beginTime}</if>
          <if test="endTime != null">and create_time &lt; #{endTime}</if>
    </sql>

    <select id="selectOmsOrderList" parameterType="OmsOrder" resultMap="OmsOrderResult">
        <include refid="selectOmsOrderVo"/>
        <where>  
            <if test="orderType != null "> and order_type = #{orderType}</if>
            <if test="orderSn != null  and orderSn != ''"> and order_sn = #{orderSn}</if>
            <if test="payId != null "> and pay_id = #{payId}</if>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="mmsMerchantId != null "> and mms_merchant_id = #{mmsMerchantId}</if>
            <if test="productQuantity != null "> and product_quantity = #{productQuantity}</if>
            <if test="productTotalAmount != null "> and product_total_amount = #{productTotalAmount}</if>
            <if test="deliveryFee != null "> and delivery_fee = #{deliveryFee}</if>
            <if test="payAmount != null "> and pay_amount = #{payAmount}</if>
            <if test="taxFee != null "> and tax_fee = #{taxFee}</if>
            <if test="orderTotalAmount != null "> and order_total_amount = #{orderTotalAmount}</if>
            <if test="pointsAmount != null "> and points_amount = #{pointsAmount}</if>
            <if test="payType != null "> and pay_type = #{payType}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="aftersaleStatus != null "> and aftersale_status = #{aftersaleStatus}</if>
            <if test="deliveryCompany != null  and deliveryCompany != ''"> and delivery_company = #{deliveryCompany}</if>
            <if test="deliverySn != null  and deliverySn != ''"> and delivery_sn = #{deliverySn}</if>
            <if test="autoConfirmDay != null "> and auto_confirm_day = #{autoConfirmDay}</if>
            <!-- PII 加密后:收货人姓名/详细地址密文不可检索(合规§6.3);手机号走盲索引精确匹配。
                 dual-read:回填收敛前存量行 receiver_phone_hash 为 NULL、receiver_phone 仍明文,故 OR 上明文等值(裸参不加密)兜底,
                 让部署当晚仍能按手机搜到历史订单;回填后自然不再命中明文分支,无副作用。 -->
            <if test="receiverPhone != null  and receiverPhone != ''"> and (receiver_phone_hash = #{receiverPhone, typeHandler=com.chengyinhub.business.security.PiiBlindIndexTypeHandler} or receiver_phone = #{receiverPhone})</if>
            <if test="receiverPhoneCode != null  and receiverPhoneCode != ''"> and receiver_phone_code = #{receiverPhoneCode}</if>
            <if test="receiverProvince != null  and receiverProvince != ''"> and receiver_province = #{receiverProvince}</if>
            <if test="orderNote != null  and orderNote != ''"> and order_note = #{orderNote}</if>
            <if test="merchantNote != null  and merchantNote != ''"> and merchant_note = #{merchantNote}</if>
            <if test="confirmStatus != null "> and confirm_status = #{confirmStatus}</if>
            <if test="paymentTime != null "> and payment_time = #{paymentTime}</if>
            <if test="deliveryTime != null "> and delivery_time = #{deliveryTime}</if>
            <if test="receiveTime != null "> and receive_time = #{receiveTime}</if>
            <if test="memberCouponId != null "> and member_coupon_id = #{memberCouponId}</if>
            <if test="couponAmount != null "> and coupon_amount = #{couponAmount}</if>
        </where>
    </select>

    <select id="selectMerchantLedgerOrders" resultMap="OmsOrderResult">
        <include refid="selectOmsOrderVo"/>
        <include refid="merchantLedgerWhere"/>
        order by create_time desc, id desc
    </select>

    <select id="selectMerchantLedgerSummary" resultType="map">
        select count(1) as orderCount,
               coalesce(sum(coalesce(nullif(pay_amount, 0), order_total_amount, 0)), 0) as orderAmount,
               sum(case when aftersale_status &gt; 1 then 1 else 0 end) as aftersaleCount
        from oms_order
        <include refid="merchantLedgerWhere"/>
    </select>
    
    <select id="selectOmsOrderById" parameterType="Long" resultMap="OmsOrderResult">
        <include refid="selectOmsOrderVo"/>
        where id = #{id}
    </select>

    <select id="selectOmsOrderByOrderSn" parameterType="String" resultMap="OmsOrderResult">
        <include refid="selectOmsOrderVo"/>
        where order_sn = #{orderSn}
        limit 1
    </select>

    <select id="selectCommerceOrderByRequest" resultMap="OmsOrderResult">
        <include refid="selectOmsOrderVo"/>
        where member_id = #{memberId}
          and mms_merchant_id = #{merchantId}
          and biz_type = #{bizType}
          and commerce_request_id = #{requestId}
        limit 1
    </select>

