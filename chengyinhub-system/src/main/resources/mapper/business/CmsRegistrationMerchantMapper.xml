    <!-- A-13 防双中标:compare-and-set 原子占槽,仅待定(audit_status=0/null)可置中标 -->
    <update id="confirmWinnerIfPending" parameterType="java.lang.Long">
        update cms_registration_merchant
        set audit_status = 1, status = 1, audit_time = now(), update_time = now()
        where id = #{id}
          and del_flag = 0
          and (audit_status is null or audit_status = 0)
    </update>

    <!-- Cancel and winner selection compete on this same row; neither can overwrite the other's terminal. -->
    <update id="cancelUnwonByMember">
        update cms_registration_merchant
        set del_flag = 2, update_by = #{username}, update_time = #{updateTime}
        where id = #{id}
          and member_id = #{memberId}
          and del_flag = 0
          and (audit_status is null or audit_status in (0, 2))
    </update>

    <!-- 调配驳回与选中共用 audit_status=0/null 起点；两个 CAS 并发时只能一个成功。 -->
    <update id="rejectIfPending">
        update cms_registration_merchant
        set audit_status = 2,
            status = 3,
            reason = #{reason},
            audit_time = now(),
            update_time = now()
        where id = #{id}
          and del_flag = 0
          and (audit_status is null or audit_status = 0)
    </update>

    <!--
      商家编辑专用 CAS。不能复用按 id 的通用 update：审核方可能在“先读后写”窗口中标，
      也只有本语句能把“限定人数”从数字明确清回 NULL。
    -->
    <update id="updateEditableFieldsIfStateMatches">
        update cms_registration_merchant
        <trim prefix="SET" suffixOverrides=",">
            <if test="patch.picUrl != null">pic_url = #{patch.picUrl},</if>
            <if test="patch.address != null">address = #{patch.address},</if>
            <if test="patch.addressName != null">address_name = #{patch.addressName},</if>
            <if test="patch.longitude != null">longitude = #{patch.longitude},</if>
            <if test="patch.latitude != null">latitude = #{patch.latitude},</if>
            <if test="patch.cooperateDate != null">cooperate_date = #{patch.cooperateDate},</if>
            <if test="patch.activityDesc != null">activity_desc = #{patch.activityDesc},</if>
            limit_num = #{patch.limitNum},
            <if test="patch.startDate != null">start_date = #{patch.startDate},</if>
            <if test="patch.endDate != null">end_date = #{patch.endDate},</if>
            <if test="rejected">
                status = 0,
                audit_status = 0,
                reason = '',
                <!-- 退回待定 ⇒ 上一次审核作废,时间跟着清掉。留着会让进度行印一个
                     「审核通过」时刻,而当前状态其实是「审核中」。 -->
                audit_time = null,
            </if>
            <if test="patch.updateBy != null">update_by = #{patch.updateBy},</if>
            <if test="patch.updateTime != null">update_time = #{patch.updateTime},</if>
        </trim>
        where id = #{patch.id}
          and member_id = #{memberId}
          and coalesce(del_flag, 0) = 0
          and coalesce(status, 0) = #{expectedStatus}
          and coalesce(audit_status, 0) = #{expectedAuditStatus}
    </update>

