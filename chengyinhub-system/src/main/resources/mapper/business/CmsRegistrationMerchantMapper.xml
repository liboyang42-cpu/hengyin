    <select id="countByTopicId" parameterType="Long" resultType="int">
        select count(1) from cms_registration_merchant where topic_id = #{topicId} and status = 1 and del_flag = 0
    </select>

    <select id="countByTopicIds" resultType="map">
        select topic_id as topicId, count(*) as merchantCount
        from cms_registration_merchant
        where status = 1 and del_flag = 0
          and topic_id in
          <foreach collection="topicIds" item="topicId" open="(" separator="," close=")">
              #{topicId}
          </foreach>
