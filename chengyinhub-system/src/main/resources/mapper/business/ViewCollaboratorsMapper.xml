    </update>

    <delete id="deleteViewCollaboratorsById" parameterType="Long">
        delete from view_collaborators where id = #{id}
    </delete>

    <delete id="deleteViewCollaboratorsByIds" parameterType="String">
        delete from view_collaborators where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
