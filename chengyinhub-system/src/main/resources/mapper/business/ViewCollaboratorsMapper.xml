    <sql id="selectViewCollaboratorsVo">
        select id, data_type, data_id, member_id, create_by, create_time, update_by, update_time, member_nickname, member_avatar, member_phone, member_real_name, member_sex, member_status from view_collaborators
    </sql>

    <select id="selectViewCollaboratorsList" parameterType="ViewCollaborators" resultMap="ViewCollaboratorsResult">
        <include refid="selectViewCollaboratorsVo"/>
        <where>  
            <if test="dataType != null "> and data_type = #{dataType}</if>
            <if test="dataId != null "> and data_id = #{dataId}</if>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="memberNickname != null  and memberNickname != ''"> and member_nickname like concat('%', #{memberNickname}, '%')</if>
            <if test="memberAvatar != null  and memberAvatar != ''"> and member_avatar = #{memberAvatar}</if>
            <if test="memberPhone != null  and memberPhone != ''"> and member_phone = #{memberPhone}</if>
            <if test="memberRealName != null  and memberRealName != ''"> and member_real_name like concat('%', #{memberRealName}, '%')</if>
            <if test="memberSex != null "> and member_sex = #{memberSex}</if>
            <if test="memberStatus != null "> and member_status = #{memberStatus}</if>
        </where>
    </select>
    
    <select id="selectViewCollaboratorsById" parameterType="Long" resultMap="ViewCollaboratorsResult">
        <include refid="selectViewCollaboratorsVo"/>
        where id = #{id}
    </select>

    <insert id="insertViewCollaborators" parameterType="ViewCollaborators">
