<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.CmsPresetThemeStyleMapper">

    <resultMap type="CmsPresetThemeStyle" id="CmsPresetThemeStyleResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="coverImg"    column="cover_img"    />
        <result property="toneTokens"    column="tone_tokens"    />
        <result property="defaultTitle"    column="default_title"    />
        <result property="defaultSubtitle"    column="default_subtitle"    />
        <result property="defaultDesc"    column="default_desc"    />
        <result property="defaultCategoryIds"    column="default_category_ids"    />
        <result property="sort"    column="sort"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectCmsPresetThemeStyleVo">
        select id, name, cover_img, tone_tokens, default_title, default_subtitle, default_desc, default_category_ids, sort, status, del_flag, create_by, create_time, update_by, update_time, remark from preset_theme_style
    </sql>

    <select id="selectCmsPresetThemeStyleList" parameterType="CmsPresetThemeStyle" resultMap="CmsPresetThemeStyleResult">
        <include refid="selectCmsPresetThemeStyleVo"/>
        <where>
            del_flag = 0
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort asc, id asc
    </select>

    <select id="selectCmsPresetThemeStyleById" parameterType="Long" resultMap="CmsPresetThemeStyleResult">
        <include refid="selectCmsPresetThemeStyleVo"/>
        where id = #{id}
    </select>

    <insert id="insertCmsPresetThemeStyle" parameterType="CmsPresetThemeStyle" useGeneratedKeys="true" keyProperty="id">
        insert into preset_theme_style
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="coverImg != null">cover_img,</if>
            <if test="toneTokens != null">tone_tokens,</if>
            <if test="defaultTitle != null">default_title,</if>
            <if test="defaultSubtitle != null">default_subtitle,</if>
            <if test="defaultDesc != null">default_desc,</if>
            <if test="defaultCategoryIds != null">default_category_ids,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="coverImg != null">#{coverImg},</if>
            <if test="toneTokens != null">#{toneTokens},</if>
            <if test="defaultTitle != null">#{defaultTitle},</if>
            <if test="defaultSubtitle != null">#{defaultSubtitle},</if>
            <if test="defaultDesc != null">#{defaultDesc},</if>
            <if test="defaultCategoryIds != null">#{defaultCategoryIds},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateCmsPresetThemeStyle" parameterType="CmsPresetThemeStyle">
        update preset_theme_style
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="coverImg != null">cover_img = #{coverImg},</if>
            <if test="toneTokens != null">tone_tokens = #{toneTokens},</if>
            <if test="defaultTitle != null">default_title = #{defaultTitle},</if>
            <if test="defaultSubtitle != null">default_subtitle = #{defaultSubtitle},</if>
            <if test="defaultDesc != null">default_desc = #{defaultDesc},</if>
            <if test="defaultCategoryIds != null">default_category_ids = #{defaultCategoryIds},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteCmsPresetThemeStyleById" parameterType="Long">
        update preset_theme_style set del_flag = 2 where id = #{id}
    </update>

    <update id="deleteCmsPresetThemeStyleByIds" parameterType="String">
        update preset_theme_style set del_flag = 2 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
