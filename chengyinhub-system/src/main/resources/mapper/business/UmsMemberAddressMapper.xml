<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.UmsMemberAddressMapper">
    
    <resultMap type="UmsMemberAddress" id="UmsMemberAddressResult">
        <result property="id"    column="id"    />
        <result property="memberId"    column="member_id"    />
        <result property="fullName"    column="full_name"    />
        <result property="areaCode"    column="area_code"    />
        <result property="mobilePhone"    column="mobile_phone"    />
        <result property="province"    column="province"    />
        <result property="detailAddress"    column="detail_address"    />
        <result property="isDefault"    column="is_default"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="requestId"  column="request_id"  />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectUmsMemberAddressVo">
        select id, member_id, full_name, area_code, mobile_phone, province, detail_address, is_default, del_flag, request_id, create_by, create_time, update_by, update_time from ums_member_address
    </sql>

    <select id="selectUmsMemberAddressList" parameterType="UmsMemberAddress" resultMap="UmsMemberAddressResult">
        <include refid="selectUmsMemberAddressVo"/>
        <where>  
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="fullName != null  and fullName != ''"> and full_name like concat('%', #{fullName}, '%')</if>
            <if test="areaCode != null  and areaCode != ''"> and area_code = #{areaCode}</if>
            <if test="mobilePhone != null  and mobilePhone != ''"> and mobile_phone = #{mobilePhone}</if>
            <if test="province != null  and province != ''"> and province = #{province}</if>
            <if test="detailAddress != null  and detailAddress != ''"> and detail_address = #{detailAddress}</if>
            <if test="isDefault != null "> and is_default = #{isDefault}</if>
        </where>
    </select>
    
    <select id="selectUmsMemberAddressById" parameterType="Long" resultMap="UmsMemberAddressResult">
        <include refid="selectUmsMemberAddressVo"/>
        where id = #{id}
    </select>

    <select id="selectOwnedAddressById" resultMap="UmsMemberAddressResult">
        <include refid="selectUmsMemberAddressVo"/>
        WHERE id = #{id}
          AND member_id = #{memberId}
          AND del_flag = 0
    </select>

    <select id="selectOwnedAddressList" resultMap="UmsMemberAddressResult">
        <include refid="selectUmsMemberAddressVo"/>
        WHERE member_id = #{memberId}
          AND del_flag = 0
        ORDER BY is_default DESC, id DESC
    </select>

    <select id="selectOwnedAddressByRequestId" resultMap="UmsMemberAddressResult">
        <include refid="selectUmsMemberAddressVo"/>
        WHERE member_id = #{memberId}
          AND request_id = #{requestId}
          AND del_flag = 0
        LIMIT 1
    </select>

    <select id="lockMemberAddressScope" resultType="long">
        SELECT id FROM ums_member WHERE id = #{memberId} FOR UPDATE
    </select>

    <select id="lockActiveUmsMemberAddressByIdAndMemberId" parameterType="map" resultMap="UmsMemberAddressResult">
        <include refid="selectUmsMemberAddressVo"/>
        where id = #{id}
          and member_id = #{memberId}
          and del_flag = '0'
        for update
    </select>

    <insert id="insertUmsMemberAddress" parameterType="UmsMemberAddress" useGeneratedKeys="true" keyProperty="id">
        insert into ums_member_address
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="memberId != null">member_id,</if>
            <if test="fullName != null">full_name,</if>
            <if test="areaCode != null">area_code,</if>
            <if test="mobilePhone != null">mobile_phone,</if>
            <if test="province != null">province,</if>
            <if test="detailAddress != null">detail_address,</if>
            <if test="isDefault != null">is_default,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="requestId != null">request_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="memberId != null">#{memberId},</if>
            <if test="fullName != null">#{fullName},</if>
            <if test="areaCode != null">#{areaCode},</if>
            <if test="mobilePhone != null">#{mobilePhone},</if>
            <if test="province != null">#{province},</if>
            <if test="detailAddress != null">#{detailAddress},</if>
            <if test="isDefault != null">#{isDefault},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="requestId != null">#{requestId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateUmsMemberAddress" parameterType="UmsMemberAddress">
        update ums_member_address
        <trim prefix="SET" suffixOverrides=",">
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="fullName != null">full_name = #{fullName},</if>
            <if test="areaCode != null">area_code = #{areaCode},</if>
            <if test="mobilePhone != null">mobile_phone = #{mobilePhone},</if>
            <if test="province != null">province = #{province},</if>
            <if test="detailAddress != null">detail_address = #{detailAddress},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="updateOwnedAddress">
        UPDATE ums_member_address
        <trim prefix="SET" suffixOverrides=",">
            <if test="address.fullName != null">full_name = #{address.fullName},</if>
            <if test="address.areaCode != null">area_code = #{address.areaCode},</if>
            <if test="address.mobilePhone != null">mobile_phone = #{address.mobilePhone},</if>
            <if test="address.province != null">province = #{address.province},</if>
            <if test="address.detailAddress != null">detail_address = #{address.detailAddress},</if>
            <if test="address.isDefault != null">is_default = #{address.isDefault},</if>
            update_time = #{address.updateTime},
        </trim>
        WHERE id = #{address.id}
          AND member_id = #{memberId}
          AND del_flag = 0
    </update>

    <delete id="deleteUmsMemberAddressById" parameterType="Long">
        delete from ums_member_address where id = #{id}
    </delete>

    <update id="deleteOwnedAddress">
        UPDATE ums_member_address
        SET del_flag = 2,
            is_default = 0,
            update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
          AND member_id = #{memberId}
          AND del_flag = 0
    </update>

    <delete id="deleteUmsMemberAddressByIds" parameterType="String">
        delete from ums_member_address where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <update id="updateUmsMemberAddressIsDefault" parameterType="UmsMemberAddress">
        UPDATE ums_member_address
        SET is_default = 0
        WHERE member_id = #{memberId}
        AND is_default = 1  <!-- 只更新当前已经是默认的地址 -->
        AND id != #{id}
        AND EXISTS (SELECT 1 FROM ums_member_address
        WHERE id = #{id} AND member_id = #{memberId})
    </update>

    <update id="setOwnedAddressDefault">
        UPDATE ums_member_address
        SET is_default = 1,
            update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
          AND member_id = #{memberId}
          AND del_flag = 0
    </update>

    <update id="clearOtherOwnedDefaults">
        UPDATE ums_member_address
        SET is_default = 0,
            update_time = CURRENT_TIMESTAMP
        WHERE member_id = #{memberId}
          AND del_flag = 0
          AND id != #{id}
          AND is_default = 1
    </update>
</mapper>
