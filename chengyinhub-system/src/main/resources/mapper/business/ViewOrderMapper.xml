    </sql>

    <select id="selectViewOrderList" parameterType="ViewOrder" resultMap="ViewOrderResult">
        <include refid="selectViewOrderVo"/>
        <where>  
            <if test="orderType != null "> and order_type = #{orderType}</if>
            <if test="orderSn != null  and orderSn != ''"> and order_sn = #{orderSn}</if>
