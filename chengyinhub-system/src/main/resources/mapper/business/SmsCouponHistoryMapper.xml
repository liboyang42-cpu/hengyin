<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.SmsCouponHistoryMapper">
    
    <resultMap type="SmsCouponHistory" id="SmsCouponHistoryResult">
        <result property="id"    column="id"    />
        <result property="couponId"    column="coupon_id"    />
        <result property="memberId"    column="member_id"    />
        <result property="couponCode"    column="coupon_code"    />
        <result property="qrcodeUrl"    column="qrcode_url"    />
        <result property="getType"    column="get_type"    />
        <result property="getTime"    column="get_time"    />
        <result property="useStatus"    column="use_status"    />
        <result property="useTime"    column="use_time"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderSn"    column="order_sn"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="note"    column="note"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSmsCouponHistoryVo">
        select id, coupon_id, member_id, coupon_code,qrcode_url, get_type, get_time, use_status, use_time, order_id, order_sn, start_time, end_time, note, del_flag, create_by, create_time, update_by, update_time from sms_coupon_history
    </sql>

    <select id="selectSmsCouponHistoryList" parameterType="SmsCouponHistory" resultMap="SmsCouponHistoryResult">
        <include refid="selectSmsCouponHistoryVo"/>
        <where>  
            <if test="couponId != null "> and coupon_id = #{couponId}</if>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="couponCode != null  and couponCode != ''"> and coupon_code = #{couponCode}</if>
            <if test="getType != null "> and get_type = #{getType}</if>
            <if test="getTime != null "> and get_time = #{getTime}</if>
            <if test="useStatus != null "> and use_status = #{useStatus}</if>
            <if test="useTime != null "> and use_time = #{useTime}</if>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="orderSn != null  and orderSn != ''"> and order_sn = #{orderSn}</if>
            <if test="startTime != null "> and start_time = #{startTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="note != null  and note != ''"> and note = #{note}</if>
            <if test="delFlag != null "> and ifnull(del_flag, 0) = #{delFlag}</if>
        </where>
    </select>
    
    <select id="selectSmsCouponHistoryById" parameterType="Long" resultMap="SmsCouponHistoryResult">
        <include refid="selectSmsCouponHistoryVo"/>
        where id = #{id}
    </select>

    <select id="selectSmsCouponHistoryByIdForUpdate" parameterType="Long" resultMap="SmsCouponHistoryResult">
        <include refid="selectSmsCouponHistoryVo"/>
        where id = #{id}
        for update
    </select>

    <update id="claimUnusedCoupon">
        update sms_coupon_history
        set use_status = 1,
            use_time = #{useTime},
            update_time = #{useTime}
        where id = #{id}
          and use_status = 0
          and ifnull(del_flag, 0) = 0
          and (end_time is null or end_time &gt;= #{useTime})
          and (start_time is null or start_time &lt;= #{useTime})
    </update>

    <update id="expireUnusedCoupon">
        update sms_coupon_history
        set use_status = 2,
            update_time = #{updateTime}
        where id = #{id}
          and use_status = 0
          and ifnull(del_flag, 0) = 0
          and end_time is not null
          and end_time &lt; #{updateTime}
    </update>

    <!-- 撤销核销:1→0 的条件 UPDATE 是撤销唯一的幂等闸(第二次拿 0 行,不触碰计数/结算/审计)。
         use_time 刻意保留:它记录「被撤销的那次核销发生在何时」,再核销时会被覆盖。
         原子性由 WHERE use_status = 1 保证,不靠调用方先查再判。 -->
    <update id="reverseUsedCoupon">
        update sms_coupon_history
        set use_status = 0,
            update_time = #{reversedAt}
        where id = #{id}
          and use_status = 1
          and ifnull(del_flag, 0) = 0
    </update>

    <insert id="insertSmsCouponHistory" parameterType="SmsCouponHistory" useGeneratedKeys="true" keyProperty="id">
        insert into sms_coupon_history
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="couponId != null">coupon_id,</if>
            <if test="memberId != null">member_id,</if>
            <if test="couponCode != null and couponCode != ''">coupon_code,</if>
            <if test="qrcodeUrl != null and qrcodeUrl != ''">qrcode_url,</if>
            <if test="getType != null">get_type,</if>
            <if test="getTime != null">get_time,</if>
            <if test="useStatus != null">use_status,</if>
            <if test="useTime != null">use_time,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderSn != null">order_sn,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="note != null">note,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="couponId != null">#{couponId},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="couponCode != null and couponCode != ''">#{couponCode},</if>
            <if test="qrcodeUrl != null and qrcodeUrl != ''">#{qrcodeUrl},</if>
            <if test="getType != null">#{getType},</if>
            <if test="getTime != null">#{getTime},</if>
            <if test="useStatus != null">#{useStatus},</if>
            <if test="useTime != null">#{useTime},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderSn != null">#{orderSn},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="note != null">#{note},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSmsCouponHistory" parameterType="SmsCouponHistory">
        update sms_coupon_history
        <trim prefix="SET" suffixOverrides=",">
            <if test="couponId != null">coupon_id = #{couponId},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="couponCode != null and couponCode != ''">coupon_code = #{couponCode},</if>
            <if test="qrcodeUrl != null and qrcodeUrl != ''">qrcode_url = #{qrcodeUrl},</if>
            <if test="getType != null">get_type = #{getType},</if>
            <if test="getTime != null">get_time = #{getTime},</if>
            <if test="useStatus != null">use_status = #{useStatus},</if>
            <if test="useTime != null">use_time = #{useTime},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderSn != null">order_sn = #{orderSn},</if>
            <if test="startTime != null">start_time = start_time,</if>
            <if test="endTime != null">end_time = end_time,</if>
            <if test="note != null">note = #{note},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
        <!-- Issued validity is immutable. Supplied dates assert the existing snapshot,
             including legacy NULL: a new non-NULL value cannot invent missing history.
             Guard in this same UPDATE so concurrent callers cannot pass a stale pre-read. -->
        <if test="startTime != null">and start_time = #{startTime}</if>
        <if test="endTime != null">and end_time = #{endTime}</if>
    </update>

    <delete id="deleteSmsCouponHistoryById" parameterType="Long">
        delete from sms_coupon_history where id = #{id}
    </delete>

    <delete id="deleteSmsCouponHistoryByIds" parameterType="String">
        delete from sms_coupon_history where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 过期任务只允许 0未使用 → 2已过期；1已核销是资金/权益终态，绝不能覆盖。 -->
    <update id="updateExpiredCouponsByMemberId" parameterType="java.lang.Long">
        update sms_coupon_history
        set
            use_status = 2,
            update_time = now()
            where member_id = #{memberId} and use_status = 0 and del_flag = 0 and end_time &lt; now()
    </update>
    <!-- 第二轮拍板第 4 条:后台撤销核销勾选「同时冲回积分和经验」用。 -->
    <!-- 通关券发放没回写 history id:取「同一玩家同一张券、领取时间落在幂等日志落位前后 1 分钟内」最新那张。
         通关券在同一事务里晚于节点券发放,同一模板撞车时取最新那张才是它;get_time 为空的来源不明,不认。
         时间比较留在库里做(日志与领取记录同一时钟),不经 Java 日期换时区。 -->
    <select id="selectCompletionRewardHistoryId" resultType="java.lang.Long">
        select h.id
        from sms_coupon_history h
        join cms_topic_completion_coupon_reward_log l
          on l.topic_id = #{topicId} and l.member_id = h.member_id and l.coupon_id = h.coupon_id
        where h.member_id = #{memberId}
          and ifnull(h.del_flag, 0) = 0
          and h.get_time between date_sub(l.created_at, interval 1 minute) and date_add(l.created_at, interval 1 minute)
        order by h.id desc
        limit 1
    </select>

    <!-- 未使用的连带券作废:0→2(钱包只有未使用/已使用/已过期三态,作废落「已过期」),备注写原因。 -->
    <update id="voidUnusedCoupon">
        update sms_coupon_history
        set use_status = 2,
            note = #{note},
            update_time = now()
        where id = #{id}
          and use_status = 0
          and ifnull(del_flag, 0) = 0
    </update>

</mapper>
