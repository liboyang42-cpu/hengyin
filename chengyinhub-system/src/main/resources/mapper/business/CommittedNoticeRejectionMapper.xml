<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.CommittedNoticeRejectionMapper">
    <resultMap id="Rejection" type="com.chengyinhub.business.domain.BusinessAuditEvent">
        <id property="id" column="id"/>
        <result property="actorType" column="actor_type"/>
        <result property="actorMemberId" column="actor_member_id"/>
        <result property="beforeJson" column="before_json"/>
        <result property="afterJson" column="after_json"/>
    </resultMap>
    <!-- INSERT before lock-read: do not hold a missing-row gap lock while attempting this append. -->
    <insert id="insertIgnore" parameterType="com.chengyinhub.business.domain.BusinessAuditEvent">
        insert ignore into business_audit_event
            (domain_type,domain_id,owner_member_id,actor_type,actor_member_id,actor_role_code,
             action,target_type,target_id,before_json,after_json,reason,request_id,create_time)
        values ('PLATFORM',#{domainId},0,#{actorType},#{actorMemberId},#{actorRoleCode},
                'COMPLAINT_CLOSE_NOTICE_REJECTED','COOP_COMPLAINT',#{targetId},
                #{beforeJson},#{afterJson},'INVALID_RECIPIENT',#{requestId},now())
    </insert>
    <select id="selectForUpdate" resultMap="Rejection" useCache="false" flushCache="true">
        select id,actor_type,actor_member_id,before_json,after_json from business_audit_event
        where domain_type='PLATFORM' and domain_id=#{complaintId}
          and action='COMPLAINT_CLOSE_NOTICE_REJECTED' and request_id=#{eventKey}
        for update
    </select>
</mapper>
