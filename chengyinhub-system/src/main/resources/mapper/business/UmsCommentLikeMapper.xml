<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.UmsCommentLikeMapper">
    
    <resultMap type="UmsCommentLike" id="UmsCommentLikeResult">
        <result property="id"    column="id"    />
        <result property="memberId"    column="member_id"    />
        <result property="commentId"    column="comment_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectUmsCommentLikeVo">
        select id, member_id, comment_id, create_by, create_time, update_by, update_time from ums_comment_like
    </sql>

    <select id="selectUmsCommentLikeList" parameterType="UmsCommentLike" resultMap="UmsCommentLikeResult">
        <include refid="selectUmsCommentLikeVo"/>
        <where>  
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="commentId != null "> and comment_id = #{commentId}</if>
        </where>
    </select>
    
    <select id="selectUmsCommentLikeById" parameterType="Long" resultMap="UmsCommentLikeResult">
        <include refid="selectUmsCommentLikeVo"/>
        where id = #{id}
    </select>

    <insert id="insertUmsCommentLike" parameterType="UmsCommentLike" useGeneratedKeys="true" keyProperty="id">
        insert into ums_comment_like
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="memberId != null">member_id,</if>
            <if test="commentId != null">comment_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="memberId != null">#{memberId},</if>
            <if test="commentId != null">#{commentId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateUmsCommentLike" parameterType="UmsCommentLike">
        update ums_comment_like
        <trim prefix="SET" suffixOverrides=",">
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="commentId != null">comment_id = #{commentId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteUmsCommentLikeById" parameterType="Long">
        delete from ums_comment_like where id = #{id}
    </delete>

    <delete id="deleteUmsCommentLikeByIds" parameterType="String">
        delete from ums_comment_like where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>