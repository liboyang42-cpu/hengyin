    <sql id="selectMmsMerchantVo">
        select id, member_id, name, wechat, wechat_qrcode, category_id, category_ids, logo, description, derivatives, derivative_benefits, website, preference, phone, address, business_time, business_license, status, reson, disable_reason, account_status, business_status, del_flag, capacity, available_time, suit_activity_types, charge_type, demand, coop_open, cover_image, slogan, city_role, story_title, gallery, tags, featured_type, featured_id, service_tag, service_text, location_lat, location_lng, location_verified, create_by, create_time, update_by, update_time from mms_merchant
    </sql>

    <!-- 商家列表筛选条件:普通列表与距离排序列表共用,保证两条路径筛选口径完全一致 -->
    <sql id="merchantListCriteria">
        <if test="memberId != null "> and member_id = #{memberId}</if>
        <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        <if test="wechat != null  and wechat != ''"> and wechat = #{wechat}</if>
        <!-- CU-M-62:保持整值相等。分诊曾建议改 FIND_IN_SET(以为本列存多值 CSV)——实测不成立:
             本列经 MmsMerchant.categoryId(Integer) 映射,库里真写逗号串会在 resultMap 处直接报错
             (Cannot determine value type from string '21,4001'),根本到不了筛选这一步;
             ApiMerchantController.publicCategories 里的 split(",") 是 Integer 时代的遗留写法,
             对 Integer 恒为单段。FIND_IN_SET 对单值行为等价,只徒增一次隐式转换 + 用不上索引。 -->
        <if test="categoryId != null "> and category_id = #{categoryId}</if>
        <if test="tags != null  and tags != ''"> and tags like concat('%', #{tags}, '%')</if>
        <if test="cityRole != null  and cityRole != ''"> and city_role like concat('%', #{cityRole}, '%')</if>
        <if test="logo != null  and logo != ''"> and logo = #{logo}</if>
        <if test="description != null  and description != ''"> and description = #{description}</if>
        <if test="derivatives != null  and derivatives != ''"> and derivatives = #{derivatives}</if>
        <if test="website != null  and website != ''"> and website = #{website}</if>
        <if test="preference != null  and preference != ''"> and preference = #{preference}</if>
        <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
        <if test="address != null  and address != ''"> and address = #{address}</if>
        <if test="businessTime != null  and businessTime != ''"> and business_time = #{businessTime}</if>
        <if test="status != null "> and status = #{status}</if>
        <if test="reson != null  and reson != ''"> and reson = #{reson}</if>
        <if test="accountStatus != null "> and account_status = #{accountStatus}</if>
        <if test="coopOpen != null "> and coop_open = #{coopOpen}</if>
        <if test="delFlag != null "> and del_flag = #{delFlag}</if>
    </sql>

    <select id="selectMmsMerchantList" parameterType="MmsMerchant" resultMap="MmsMerchantResult">
        <include refid="selectMmsMerchantVo"/>
        <where>
            <include refid="merchantListCriteria"/>
        </where>
    </select>

    <!-- 距离排序结果:复用商家列映射,追加 distance(米) -->
    <resultMap id="MerchantSearchResult" type="com.chengyinhub.business.domain.dto.MerchantSearchQuery" extends="MmsMerchantResult">
        <result property="distance"    column="distance"    />
    </resultMap>

    <!--
      商家搜索/发现(E5)按距离升序:与 selectMmsMerchantList 同筛选(共用 merchantListCriteria)。
      距离用 Haversine 直线距离(米),口径同 MerchantLeadMapper.selectNearbyLeads;
      LEAST(1, ...) 防浮点误差致 ACOS 入参 > 1 报错。
      无坐标商家(location_lat/location_lng 为 null)distance 计算结果为 null,
      order by 先按 distance is null 升序(有坐标在前),再按 distance 升序 —— 无坐标一律排最后,不占前排。
    -->
    <select id="selectMerchantListByDistance" parameterType="com.chengyinhub.business.domain.dto.MerchantSearchQuery" resultMap="MerchantSearchResult">
        select id, member_id, name, wechat, wechat_qrcode, category_id, category_ids, logo, description, derivatives, derivative_benefits, website, preference,
               phone, address, business_time, business_license, status, reson, disable_reason, account_status, business_status,
               del_flag, capacity, available_time, suit_activity_types, charge_type, demand, coop_open,
               cover_image, slogan, city_role, story_title, gallery, tags, featured_type, featured_id,
               service_tag, service_text,
               location_lat, location_lng, location_verified, create_by, create_time, update_by, update_time,
               (6371000 * acos(least(1,
                   cos(radians(#{originLat})) * cos(radians(location_lat))
                   * cos(radians(location_lng) - radians(#{originLng}))
                   + sin(radians(#{originLat})) * sin(radians(location_lat))
               ))) as distance
        from mms_merchant
        <where>
            <include refid="merchantListCriteria"/>
        </where>
        order by (distance is null) asc, distance asc, id desc
    </select>

