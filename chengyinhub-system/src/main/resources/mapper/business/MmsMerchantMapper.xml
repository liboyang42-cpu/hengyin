            <!-- 平台停用原因走 updatePlatformAccountStatus;本动态更新只作通用字段透传(如编辑资料回写),不与 reson 混淆 -->
            <if test="disableReason != null">disable_reason = #{disableReason},</if>
            <if test="accountStatus != null">account_status = #{accountStatus},</if>
