    <!-- 承接设置显式清空接待人数(M-13):共用 update 里 null=不改,清空只能走这条,由 Service 在 COOP_MANAGE 下调用 -->
    <update id="clearMerchantCapacity">
        update mms_merchant set capacity = null, update_by = #{updateBy}, update_time = #{updateTime}
        where id = #{id} and del_flag = 0
    </update>

    <!--
      招牌主推显式清除(CU-M-78):接口层把 type=0/id=null 定义为「解除主推」,但共用 update 的
      featured_id 一律 <if test="featuredId != null"> ⇒ 没有任何 SQL 能把 featured_id 写回 NULL,
      清除意图在持久层被静默丢弃(公开页已隐藏,库里还留着旧活动 id)。带 featuredType=0 且
      featuredId=null 时由 Service 调用,固定 SET 两列。
    -->
    <update id="clearMerchantFeatured">
        update mms_merchant set featured_type = 0, featured_id = null, update_by = #{updateBy}, update_time = #{updateTime}
        where id = #{id} and del_flag = 0
    </update>

    <!--
      平台停用/启用商家账号:只写 account_status + disable_reason 两列白名单(固定 SET,不带动态 if),
      避免通用 update 的字段透传把审核驳回原因 reson 或其它资料顺带写坏。
      停用必带原因、启用清空原因,由 Service 校验;WHERE 复核未删除。
    -->
    <update id="updatePlatformAccountStatus">
        update mms_merchant
        set account_status = #{accountStatus},
            disable_reason = #{disableReason},
            update_by = #{updateBy},
            update_time = #{updateTime}
        where id = #{id}
          and del_flag = 0
    </update>

    <!-- Owner 自助重提入驻资料：字段白名单 + 归属/状态原子条件，不接受 owner/账号状态写入。 -->
    <update id="updateOwnerRegistrationProfile">
        update mms_merchant
        <set>
            <if test="merchant.name != null">name = #{merchant.name},</if>
            <if test="merchant.wechat != null">wechat = #{merchant.wechat},</if>
            <if test="merchant.categoryId != null">category_id = #{merchant.categoryId},</if>
            <if test="merchant.description != null">description = #{merchant.description},</if>
            <if test="merchant.derivatives != null">derivatives = #{merchant.derivatives},</if>
            <if test="merchant.derivativeBenefits != null">derivative_benefits = #{merchant.derivativeBenefits},</if>
            <if test="merchant.preference != null">preference = #{merchant.preference},</if>
            <if test="merchant.phone != null">phone = #{merchant.phone},</if>
            <if test="merchant.address != null">address = #{merchant.address},</if>
            <if test="merchant.businessTime != null">business_time = #{merchant.businessTime},</if>
            <if test="merchant.businessLicense != null">business_license = #{merchant.businessLicense},</if>
            <if test="merchant.locationLat != null">location_lat = #{merchant.locationLat},</if>
            <if test="merchant.locationLng != null">location_lng = #{merchant.locationLng},</if>
            <if test="merchant.locationVerified != null">location_verified = #{merchant.locationVerified},</if>
            status = 0,
            reson = '',
            update_by = #{merchant.updateBy},
            update_time = #{merchant.updateTime}
        </set>
        where id = #{merchant.id}
          and member_id = #{expectedOwnerMemberId}
          and del_flag = 0
          and account_status is not null and account_status &lt;&gt; 2
          and status in (0, 2)
    </update>

    <delete id="deleteMmsMerchantById" parameterType="Long">
        delete from mms_merchant where id = #{id}
    </delete>

    <delete id="deleteMmsMerchantByIds" parameterType="String">
        delete from mms_merchant where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <update id="clearProfileMedia">
        update mms_merchant set logo = null, cover_image = null, gallery = null, wechat_qrcode = null where id = #{id}
    </update>

    <update id="claimOwnerCas">
        update mms_merchant
        set member_id = #{claimantMemberId}, update_by = #{auditorId}, update_time = now()
        where id = #{merchantId}
          and member_id is null
          and status = 1
          and account_status = 1
          and del_flag = 0
    </update>

