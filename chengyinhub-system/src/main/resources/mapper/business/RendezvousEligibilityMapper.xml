<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.service.rendezvous.RendezvousEligibilityMapper">
  <resultMap id="ruleRow" type="com.chengyinhub.business.service.rendezvous.RendezvousEligibilityMapper$Rule">
    <result property="decision" column="decision"/>
    <result property="minAge" column="min_age"/>
    <result property="maxAge" column="max_age"/>
    <result property="regionCode" column="region_code"/>
    <result property="windowStart" column="window_start"/>
    <result property="windowEnd" column="window_end"/>
  </resultMap>
  <resultMap id="factRow" type="com.chengyinhub.business.service.rendezvous.RendezvousEligibilityMapper$Fact">
    <result property="ruleVersion" column="rule_version"/>
    <result property="ageYears" column="age_years"/>
    <result property="regionCode" column="region_code"/>
    <result property="reviewedAt" column="reviewed_at"/>
    <result property="expiresAt" column="expires_at"/>
  </resultMap>
  <select id="currentVersion" resultType="java.lang.String" useCache="false">
    SELECT version_id FROM w16_eligibility_current WHERE id = 1
  </select>
  <select id="rule" resultMap="ruleRow" useCache="false">
    SELECT decision, min_age, max_age, region_code, window_start, window_end
    FROM w16_eligibility_rule WHERE version_id = #{versionId}
  </select>
  <select id="fact" resultMap="factRow" useCache="false">
    SELECT rule_version, age_years, region_code, reviewed_at, expires_at
    FROM w16_eligibility_fact WHERE actor_id = #{actor}
  </select>
</mapper>
