<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.service.rendezvous.RendezvousMeetingEvidenceMapper">
  <resultMap id="evidenceFact" type="com.chengyinhub.business.service.rendezvous.RendezvousMeetingEvidence$Fact">
    <result property="activityId" column="activity_id"/>
    <result property="placeId" column="place_id"/>
    <result property="firstActor" column="first_actor"/>
    <result property="secondActor" column="second_actor"/>
    <result property="riskClear" column="risk_clear"/>
    <result property="timeDistancePlausible" column="time_distance_plausible"/>
    <result property="merchantRequired" column="merchant_required"/>
    <result property="merchantVerified" column="merchant_verified"/>
    <result property="reviewRequired" column="review_required"/>
    <result property="reviewApproved" column="review_approved"/>
    <result property="source" column="fact_source"/>
    <result property="ruleVersion" column="rule_version"/>
  </resultMap>
  <select id="find" resultMap="evidenceFact" useCache="false">
    SELECT match_id, activity_id, place_id, first_actor, second_actor, risk_clear, time_distance_plausible,
           merchant_required, merchant_verified, review_required, review_approved, fact_source, rule_version
    FROM w16_meeting_evidence WHERE match_id=#{matchId}
  </select>
</mapper>
