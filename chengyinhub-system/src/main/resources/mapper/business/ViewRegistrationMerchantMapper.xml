    <sql id="selectViewRegistrationMerchantVo">
        select id, member_id, topic_id, mode, node_id, address, address_name, longitude, latitude, template_id, pic_url, email, start_date, end_date, cooperate_date, activity_desc, limit_num, rule_instructions, validation_method, question_name, question_answer, feedback_text, coupon_id, question_a, question_b, question_c, question_d, correct_answer, status, audit_time, sharing_rate, sharing_amount, reason, del_flag, create_by, create_time, update_by, update_time, topic_member_id, topic_type, related_topic_id, topic_name, topic_subtitle, topic_description, topic_address_name, total_time, total_mileage, location_count, template_count, topic_start_date, topic_end_date, topic_img_url, topic_img_arr, category_ids, topic_status, topic_reason, user_status, merchant_status, merchant_sign_up_start_date, merchant_sign_up_end_date, topic_del_flag, is_sync, is_recommend, topic_check_status, is_settlement, topic_create_by, topic_create_time, topic_update_by, topic_update_time, display_status, is_in_progress, is_ended, is_under_review, is_rejected from view_registration_merchant
    </sql>

    <select id="selectViewRegistrationMerchantList" parameterType="ViewRegistrationMerchant" resultMap="ViewRegistrationMerchantResult">
        <include refid="selectViewRegistrationMerchantVo"/>
        <where>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="topicId != null "> and topic_id = #{topicId}</if>
            <if test="mode != null "> and mode = #{mode}</if>
            <if test="nodeId != null "> and node_id = #{nodeId}</if>

            <!-- 新增searchStatus查询条件：使用视图中的计算字段 -->
            <if test="searchStatus != null">
                <choose>
                    <!-- 0: 全部 -->
                    <when test="searchStatus == 0">
                        <!-- 不添加额外条件，显示全部 -->
                    </when>

                    <!-- 1: 进行中 -->
                    <when test="searchStatus == 1">
                        and is_in_progress = 1
                    </when>

                    <!-- 2: 审核中 -->
                    <when test="searchStatus == 2">
                        and is_under_review = 1
                    </when>

                    <!-- 3: 已驳回 -->
                    <when test="searchStatus == 3">
                        and is_rejected = 1
                    </when>

                    <!-- 4: 已结束 -->
                    <when test="searchStatus == 4">
                        and is_ended = 1
                    </when>

                    <!-- 如果searchStatus是其他值，可以添加默认处理 -->
                    <otherwise>
                        <!-- 可以按searchStatus的值直接匹配status字段 -->
                        and status = #{searchStatus}
                    </otherwise>
                </choose>
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectViewRegistrationMerchantById" parameterType="Long" resultMap="ViewRegistrationMerchantResult">
        <include refid="selectViewRegistrationMerchantVo"/>
        where id = #{id}
    </select>

