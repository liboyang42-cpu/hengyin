<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.chengyinhub.business.mapper.ImConversationMapper">

    <resultMap type="ImConversation" id="ImConversationResult">
        <result property="id"          column="id"            />
        <result property="type"        column="type"          />
        <result property="bizKey"      column="biz_key"       />
        <result property="lastMsgType" column="last_msg_type" />
        <result property="lastMsgText" column="last_msg_text" />
        <result property="lastMsgAt"   column="last_msg_at"   />
        <result property="status"      column="status"        />
        <result property="createBy"    column="create_by"     />
        <result property="createTime"  column="create_time"   />
        <result property="updateBy"    column="update_by"     />
        <result property="updateTime"  column="update_time"   />
        <result property="remark"      column="remark"        />
    </resultMap>

    <sql id="selectImConversationVo">
        select id, type, biz_key, last_msg_type, last_msg_text, last_msg_at, status, create_by, create_time, update_by, update_time, remark from im_conversation
    </sql>

    <select id="selectImConversationById" parameterType="Long" resultMap="ImConversationResult">
        <include refid="selectImConversationVo"/>
        where id = #{id}
    </select>

    <select id="selectImConversationByIdForUpdate" parameterType="Long" resultMap="ImConversationResult">
        <include refid="selectImConversationVo"/>
        where id = #{id} for update
    </select>

    <select id="selectByTypeAndBizKey" resultMap="ImConversationResult">
        <include refid="selectImConversationVo"/>
        where type = #{type} and biz_key = #{bizKey} limit 1
    </select>

    <select id="selectByType" resultMap="ImConversationResult">
        <include refid="selectImConversationVo"/>
        where type = #{type} and status = 0
        order by last_msg_at desc
    </select>

    <insert id="insertImConversation" parameterType="ImConversation" useGeneratedKeys="true" keyProperty="id">
        insert into im_conversation (type, biz_key, last_msg_type, last_msg_text, last_msg_at, status, create_time)
        values (#{type}, #{bizKey}, #{lastMsgType}, #{lastMsgText}, #{lastMsgAt}, #{status}, sysdate())
    </insert>

    <update id="updateLastMessage">
        update im_conversation
        set last_msg_type = #{msgType}, last_msg_text = #{text}, last_msg_at = #{at}
        where id = #{id}
    </update>

    <update id="closeConversation">
        update im_conversation set status = 1, update_time = now() where id = #{id} and status = 0
    </update>

</mapper>
