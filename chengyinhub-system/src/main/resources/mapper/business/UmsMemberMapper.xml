    <update id="bindWxOpenIdIfBlank">
        update ums_member
        set wx_open_id = #{wxOpenId}
        where id = #{id}
          and (wx_open_id is null or trim(wx_open_id) = '')
    </update>

    <update id="upgradePasswordIfMatches">
        update ums_member
        set password = #{upgradedPassword}
        where id = #{id}
          and password = #{observedPassword}
    </update>

    <select id="selectLegacyPlaintextPasswords" resultMap="UmsMemberResult">
        select id, password
        from ums_member
        where id &gt; #{afterId}
          and password is not null
          and password &lt;&gt; ''
          and password not like '$2%'
        order by id
        limit #{limit}
    </select>

    <update id="hashLegacyPasswordIfUnchanged">
        update ums_member
        set password = #{hashedPassword}
        where id = #{id}
          and cast(password as binary) = cast(#{observedPassword} as binary)
          and password not like '$2%'
    </update>

    <delete id="deleteUmsMemberById" parameterType="Long">
        delete from ums_member where id = #{id}
    </delete>

    <delete id="deleteUmsMemberByIds" parameterType="String">
        delete from ums_member where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 扣除用户积分 -->
    <update id="deductPoints">
        UPDATE ums_member
        SET point = point - #{point}
        WHERE id = #{id}
          AND point >= #{point}
    </update>

    <!-- 增加用户积分 -->
    <update id="addPoints">
        UPDATE ums_member
        SET point = point + #{point}
        WHERE id = #{id}
    </update>

    <!-- 扣除用户余额 -->
    <update id="deductBalance">
        UPDATE ums_member
        SET balance = balance - #{balance}
        WHERE id = #{id}
          AND balance >= #{balance}
    </update>

    <!--
        提现专用:扣款的同时给冻结额留底,护栏与扣款同一条 UPDATE ⇒ 原子。
        ⚠️ 别改回 `balance >= #{amount}` —— 那样冻结额只是个摆设,并发下会被提走(见 mapper javadoc)。
    -->
    <update id="deductWithdrawableBalance">
        UPDATE ums_member
        SET balance = balance - #{amount}
        WHERE id = #{id}
          AND balance - #{frozen} >= #{amount}
    </update>

    <!-- 增加用户余额 -->
    <update id="addBalance">
        UPDATE ums_member
        SET balance = balance + #{balance}
        WHERE id = #{id}
    </update>

    <resultMap type="com.chengyinhub.business.domain.vo.HomeDataVO" id="HomeDataVOResult">
        <result property="userNum"    column="userNum"    />
        <result property="merchantNum"    column="merchantNum"    />
        <result property="merchantAuditNum"    column="merchantAuditNum"    />
        <result property="creativeSquareNum"    column="creativeSquareNum"    />
        <result property="topicNum"    column="topicNum"    />
        <result property="activityNum"    column="activityNum"    />
        <result property="memberTemplateNum"    column="memberTemplateNum"    />
    </resultMap>

    <select id="selectHomeDataList" parameterType="com.chengyinhub.business.domain.vo.HomeDataVO" resultMap="HomeDataVOResult">
        SELECT
            #用户总数
            (SELECT COUNT(*) FROM ums_member where del_flag=0) AS userNum,
            #商家总数
            (SELECT COUNT(*) FROM mms_merchant WHERE del_flag=0) AS merchantNum,
            #商家待审核数
            (SELECT COUNT(*) FROM mms_merchant WHERE del_flag=0 AND `status`=0) AS merchantAuditNum,
            #待审核帖文数
            (SELECT COUNT(*) FROM ums_creative_square WHERE del_flag=0 AND check_status=0) AS creativeSquareNum,
            #主题数量
            (SELECT COUNT(*) FROM cms_topic WHERE del_flag=0 and check_status=0) AS topicNum,
            #活动数量
            (SELECT COUNT(*) FROM cms_activity WHERE del_flag=0 and check_status=0) AS activityNum,
            #用户模板数量
            (SELECT COUNT(*) FROM cms_member_template WHERE del_flag=0 and check_status=0) AS memberTemplateNum
            <!-- totalSalesAmount 已移除:它是平台全量已支付营收(SUM(total_amount) WHERE payment_status=2),
                 但首页从来没渲染过它 —— index.vue 只读 merchantAuditNum / creativeSquareNum /
                 topicNum / activityNum / memberTemplateNum 五个。
                 payment_status 有索引,可 total_amount 不在索引里,所以它是「索引范围扫 + 逐行回表」,
                 成本随历史已支付订单数线性增长,而这条查询每次有人打开后台首页都会跑一遍。
                 更要紧的是它把营收发给了所有后台角色 —— 包括 auditor,而 auditor 是
                 role_permission_contract 里明确挡在全部资金/PII 权限之外的那个角色。
                 结论与 X09 的假开关、X03 的 nodeTypes 同一条:没人消费的数据不该加权限门,该删掉。
                 日后真要在首页显示营收,连同权限判据一起重新设计,别把这条加回来。 -->
    </select>

    <!-- 获取用户积分排名信息 -->
    <select id="selectUserRankInfo" resultType="java.util.HashMap">
        <![CDATA[
        SELECT
            user_rank,
            total_users,
            CASE
                WHEN user_rank_percentage <= 0.2 THEN 'TOP20%'
                WHEN user_rank_percentage <= 0.4 THEN 'TOP40%'
                WHEN user_rank_percentage <= 0.6 THEN 'TOP60%'
                WHEN user_rank_percentage <= 0.8 THEN 'TOP80%'
                ELSE 'TOP100%'
                END as rank_percentage
        FROM (
                 SELECT
                     @user_rank := @user_rank + 1 as user_rank,
                @total_users := total_users AS total_users,
                (@user_rank / total_users) as user_rank_percentage,
                m.id
                 FROM
                     ums_member m,
                     (SELECT @user_rank := 0, @total_users := (SELECT COUNT(*) FROM ums_member WHERE del_flag = 0)) r,
                     (SELECT COUNT(*) as total_users FROM ums_member WHERE del_flag = 0) t
                 WHERE
                     m.del_flag = 0
                 ORDER BY
                     m.point DESC, m.create_time ASC
             ) ranked
        WHERE
            ranked.id = #{memberId}
        ]]>
    </select>



    <!-- 获取用户积分排名信息 -->
    <select id="selectUserBalanceRankInfo" resultType="java.util.HashMap">
        <![CDATA[
        SELECT
            user_rank,
            total_users,
            CASE
                WHEN user_rank_percentage <= 0.2 THEN 'TOP20%'
