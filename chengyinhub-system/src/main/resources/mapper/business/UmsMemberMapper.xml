                ELSE 'TOP100%'
                END as rank_percentage
        FROM (
                 SELECT
                     @user_rank := @user_rank + 1 as user_rank,
                @total_users := total_users AS total_users,
                (@user_rank / total_users) as user_rank_percentage,
                m.id
                 FROM
                     ums_member m,
                     (SELECT @user_rank := 0, @total_users := (SELECT COUNT(*) FROM ums_member WHERE del_flag = 0)) r,
                     (SELECT COUNT(*) as total_users FROM ums_member WHERE del_flag = 0) t
                 WHERE
                     m.del_flag = 0
