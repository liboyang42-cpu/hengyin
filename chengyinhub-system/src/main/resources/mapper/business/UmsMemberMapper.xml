    <sql id="selectUmsMemberVo">
        select id, user_type, role, phone, password, level_id, name,wechat, status, invite_user_id, login_ip, login_time, nickname, avatar, sex, wx_open_id, app_open_id, union_id, apple_id, area_id, birthday, mark, tag_ids,case_pics, case_introducton,website, work_address, introduction, balance, point, del_flag, create_by, create_time, update_by, update_time from ums_member
    </sql>

    <select id="selectUmsMemberList" parameterType="UmsMember" resultMap="UmsMemberResult">
        <include refid="selectUmsMemberVo"/>
        <where>
            <if test="delFlag != null "> and del_flag = #{delFlag}</if>
            <if test="userType != null "> and user_type = #{userType}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="password != null  and password != ''"> and password = #{password}</if>
            <if test="levelId != null "> and level_id = #{levelId}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="inviteUserId != null  and inviteUserId != ''"> and invite_user_id = #{inviteUserId}</if>
            <if test="loginIp != null  and loginIp != ''"> and login_ip = #{loginIp}</if>
            <if test="loginTime != null "> and login_time = #{loginTime}</if>
            <if test="nickname != null  and nickname != ''"> and nickname like concat('%', #{nickname}, '%')</if>
            <if test="avatar != null  and avatar != ''"> and avatar = #{avatar}</if>
            <if test="sex != null "> and sex = #{sex}</if>
            <if test="wxOpenId != null  and wxOpenId != ''"> and wx_open_id = #{wxOpenId}</if>
            <if test="appOpenId != null  and appOpenId != ''"> and app_open_id = #{appOpenId}</if>
            <if test="unionId != null  and unionId != ''"> and union_id = #{unionId}</if>
            <if test="appleId != null  and appleId != ''"> and apple_id = #{appleId}</if>
            <if test="areaId != null "> and area_id = #{areaId}</if>
            <if test="birthday != null "> and birthday = #{birthday}</if>
            <if test="mark != null  and mark != ''"> and mark = #{mark}</if>
            <if test="tagIds != null  and tagIds != ''"> and tag_ids = #{tagIds}</if>
            <if test="point != null "> and point = #{point}</if>
            <if test="startTime != null  and startTime != '' ">
                and create_time &gt;= #{startTime}
            </if>
            <if test="endTime != null  and endTime != '' ">
                and create_time &lt;= #{endTime}
            </if>
        </where>
    </select>

    <select id="selectUmsMemberById" parameterType="Long" resultMap="UmsMemberResult">
        <include refid="selectUmsMemberVo"/>
        where id = #{id}
    </select>

    <select id="countActiveNickname" resultType="int">
        select count(1) from ums_member
        where nickname_key = lower(trim(#{nickname}))
        <if test="excludeMemberId != null">
            and id != #{excludeMemberId}
        </if>
    </select>

    <select id="lockMemberById" parameterType="Long" resultType="java.lang.Long">
        select id from ums_member where id = #{id} for update
    </select>

    <select id="selectBalanceForUpdate" parameterType="Long" resultType="java.math.BigDecimal"
            useCache="false" flushCache="true">
        select coalesce(balance, 0) from ums_member where id = #{id} for update
    </select>

    <select id="selectPointsForUpdate" parameterType="Long" resultType="java.lang.Long"
            useCache="false" flushCache="true">
        select point from ums_member where id = #{id} for update
    </select>

    <select id="lockActiveMemberById" parameterType="Long" resultType="java.lang.Long"
            useCache="false" flushCache="true">
        select id from ums_member
        where id = #{id} and status = 1 and del_flag = 0
        for update
    </select>

    <select id="selectRolePermissionSubject" resultMap="UmsMemberResult">
        SELECT id, role, status, del_flag FROM ums_member WHERE id = #{id}
    </select>

