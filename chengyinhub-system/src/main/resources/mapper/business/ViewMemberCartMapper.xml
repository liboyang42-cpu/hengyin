    <sql id="selectViewMemberCartVo">
        select id, member_id, merchant_id, cart_type, product_id, sku_id, sp_data, quantity, status, is_buy, create_by, create_time, update_by, update_time, product_name, product_pic, price, original_price, sku_name, sku_name_ar, sku_pic, weight from view_member_cart
    </sql>

    <select id="selectViewMemberCartList" parameterType="ViewMemberCart" resultMap="ViewMemberCartResult">
        <include refid="selectViewMemberCartVo"/>
        <where>  
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="merchantId != null "> and merchant_id = #{merchantId}</if>
            <if test="cartType != null "> and cart_type = #{cartType}</if>
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="skuId != null "> and sku_id = #{skuId}</if>
            <if test="spData != null  and spData != ''"> and sp_data = #{spData}</if>
            <if test="quantity != null "> and quantity = #{quantity}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="isBuy != null "> and is_buy = #{isBuy}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="productPic != null  and productPic != ''"> and product_pic = #{productPic}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="originalPrice != null "> and original_price = #{originalPrice}</if>
            <if test="skuName != null  and skuName != ''"> and sku_name like concat('%', #{skuName}, '%')</if>
            <if test="skuNameAr != null  and skuNameAr != ''"> and sku_name_ar = #{skuNameAr}</if>
            <if test="skuPic != null  and skuPic != ''"> and sku_pic = #{skuPic}</if>
            <if test="weight != null "> and weight = #{weight}</if>
        </where>
    </select>
    
    <select id="selectViewMemberCartById" parameterType="Long" resultMap="ViewMemberCartResult">
        <include refid="selectViewMemberCartVo"/>
        where id = #{id}
    </select>

