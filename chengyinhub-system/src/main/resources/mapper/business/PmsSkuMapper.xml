<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.PmsSkuMapper">
    
    <resultMap type="PmsSku" id="PmsSkuResult">
        <result property="id"    column="id"    />
        <result property="skuSnapshotId"    column="sku_snapshot_id"    />
        <result property="productId"    column="product_id"    />
        <result property="outSkuId"    column="out_sku_id"    />
        <result property="skuName"    column="sku_name"    />
        <result property="skuNameAr"    column="sku_name_ar"    />
        <result property="price"    column="price"    />
        <result property="weight"    column="weight"    />
        <result property="originalPrice"    column="original_price"    />
        <result property="pic"    column="pic"    />
        <result property="stock"    column="stock"    />
        <result property="spData"    column="sp_data"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectPmsSkuVo">
        select id, sku_snapshot_id, product_id, out_sku_id, sku_name, sku_name_ar, price, weight, original_price, pic, stock, sp_data, create_by, create_time, update_by, update_time from pms_sku
    </sql>

    <select id="selectPmsSkuList" parameterType="PmsSku" resultMap="PmsSkuResult">
        <include refid="selectPmsSkuVo"/>
        <where>  
            <if test="skuSnapshotId != null "> and sku_snapshot_id = #{skuSnapshotId}</if>
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="outSkuId != null  and outSkuId != ''"> and out_sku_id = #{outSkuId}</if>
            <if test="skuName != null  and skuName != ''"> and sku_name like concat('%', #{skuName}, '%')</if>
            <if test="skuNameAr != null  and skuNameAr != ''"> and sku_name_ar = #{skuNameAr}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="weight != null "> and weight = #{weight}</if>
            <if test="originalPrice != null "> and original_price = #{originalPrice}</if>
            <if test="pic != null  and pic != ''"> and pic = #{pic}</if>
            <if test="stock != null "> and stock = #{stock}</if>
            <if test="spData != null  and spData != ''"> and sp_data = #{spData}</if>
        </where>
    </select>
    
    <select id="selectPmsSkuById" parameterType="Long" resultMap="PmsSkuResult">
        <include refid="selectPmsSkuVo"/>
        where id = #{id}
    </select>

    <insert id="insertPmsSku" parameterType="PmsSku" useGeneratedKeys="true" keyProperty="id">
        insert into pms_sku
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="skuSnapshotId != null">sku_snapshot_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="outSkuId != null">out_sku_id,</if>
            <if test="skuName != null">sku_name,</if>
            <if test="skuNameAr != null">sku_name_ar,</if>
            <if test="price != null">price,</if>
            <if test="weight != null">weight,</if>
            <if test="originalPrice != null">original_price,</if>
            <if test="pic != null">pic,</if>
            <if test="stock != null">stock,</if>
            <if test="spData != null">sp_data,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="skuSnapshotId != null">#{skuSnapshotId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="outSkuId != null">#{outSkuId},</if>
            <if test="skuName != null">#{skuName},</if>
            <if test="skuNameAr != null">#{skuNameAr},</if>
            <if test="price != null">#{price},</if>
            <if test="weight != null">#{weight},</if>
            <if test="originalPrice != null">#{originalPrice},</if>
            <if test="pic != null">#{pic},</if>
            <if test="stock != null">#{stock},</if>
            <if test="spData != null">#{spData},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <!-- P0-C 原子扣库存:仅 stock>=qty 才扣,返回受影响行数(0=库存不足),防超卖 + 防负数量刷库存 -->
    <update id="deductStock">
        update pms_sku
        set stock = stock - #{qty}
        where id = #{id}
          and stock >= #{qty}
    </update>

    <update id="deductStockForProduct">
        update pms_sku
        set stock = stock - #{qty}
        where id = #{id}
          and product_id = #{productId}
          and stock >= #{qty}
    </update>

    <update id="updatePmsSku" parameterType="PmsSku">
        update pms_sku
        <trim prefix="SET" suffixOverrides=",">
            <if test="skuSnapshotId != null">sku_snapshot_id = #{skuSnapshotId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="outSkuId != null">out_sku_id = #{outSkuId},</if>
            <if test="skuName != null">sku_name = #{skuName},</if>
            <if test="skuNameAr != null">sku_name_ar = #{skuNameAr},</if>
            <if test="price != null">price = #{price},</if>
            <if test="weight != null">weight = #{weight},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="pic != null">pic = #{pic},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="spData != null">sp_data = #{spData},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePmsSkuById" parameterType="Long">
        delete from pms_sku where id = #{id}
    </delete>

    <delete id="deletePmsSkuByIds" parameterType="String">
        delete from pms_sku where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
