    <delete id="deleteCmsTopicChapterById" parameterType="Long">
        delete from cms_topic_chapter where id = #{id}
    </delete>

    <delete id="deleteCmsTopicChapterByIds" parameterType="String">
        delete from cms_topic_chapter where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- P0-15 容量校验的加锁锚点。order by id 与调用方的升序入参一起构成全局一致的加锁顺序(防 ABBA)。
         只 select id:拿的是行锁,不需要回表取列。 -->
    <select id="lockChaptersForCapacity" resultType="java.lang.Long">
        select id from cms_topic_chapter
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by id asc
        for update
    </select>

    <!-- [D21] 无条件覆盖四个供给条款列 —— 可空条款列的 **null 就是要写进去的值**。
         ⚠️ 这里刻意**没有** <if test="xx != null">:通用的 updateCmsTopicChapter 有,
         所以它传 null 时只跳过、不清空 ⇒「计酬档改引流档」会把 max_per_head_fee 留在库里,
         哪天改回计酬档那个旧上限会静默生效。这条就是为了避开那个语义而单独存在的,别给它加 <if>。
         max_merchant 是 NOT NULL；应用层要求调用方显式传 0 表示不限。 -->
    <!--
      [2026-09-11] 归属人开关商家承接。一条语句同时做两件事,少一件就是洞:
        ① WHERE 里带 **owner 谓词** —— 归属只在 Java 侧判过一次,那是「先读后写」,
           两次请求之间归属可能已经变了;而 updateCmsTopicChapter 是裸 where id = #{id},
           拿它落这条写就等于没有库级闸(AGENTS.md 的已知坑:新增写接口 WHERE 必须带 owner)。
        ② 已结束的章节写不进去 —— 结束是不可逆的,不能靠一条能来回拨的开关复活。
      返回 0 = 没写成(不是自己的 / 已结束 / 章节不在),调用方据此回错,别当成功。
    -->
    <update id="setRecruitEnabledIfOwned">
        update cms_topic_chapter c
          join cms_topic t on t.id = c.topic_id
           set c.recruit_enabled = #{enabled},
               c.update_time = now()
         where c.id = #{chapterId}
           and t.member_id = #{memberId}
           and c.finish_time is null
    </update>

    <!--
      [2026-09-11] 归属人结束本章。除了 owner 谓词,还要 **finish_time is null** 这道 CAS ——
      Java 侧那句 if (chapter.getFinishTime() != null) 是先读后写,两个并发请求都能通过,
      第二次会把第一次记下的时刻覆盖掉。而结算是按那个时刻对账的,
      覆盖之后「动作看上去成功了、对账基准悄悄变了」—— 最坏的一种静默错误。
      写法与同仓 CmsRegistrationMerchantMapper#confirmWinnerIfPending 同构。
      返回 0 = 没写成(不是自己的 / 已经结束过 / 章节不在)。
    -->
    <update id="finishChapterIfOwned">
        update cms_topic_chapter c
          join cms_topic t on t.id = c.topic_id
           set c.finish_time = now(),
               c.recruit_enabled = 0,
               c.update_time = now()
         where c.id = #{chapterId}
           and t.member_id = #{memberId}
           and c.finish_time is null
    </update>

    <update id="updateSupplyTerms">
        update cms_topic_chapter
           set terms_mode = #{termsMode},
               perk_min_value = #{perkMinValue},
               max_per_head_fee = #{maxPerHeadFee},
               max_merchant = #{maxMerchant},
               update_time = #{updateTime}
         where id = #{chapterId}
    </update>

    <select id="selectRequiredByTopic" parameterType="Long" resultMap="CmsTopicChapterResult">
        <include refid="selectCmsTopicChapterVo"/>
        where topic_id = #{topicId} and required = 1
        order by sort_id asc, id asc
    </select>
</mapper>
