    <!-- 显式列清单（非 select *）：新列不加在这里就查不出来，resultMap 配了也是空值 -->
    <sql id="selectCmsTopicChapterVo">
        select id, topic_id, name, description, blocks, atmosphere_preset, audio_url, img_arr, total_time, total_mileage, location_count, template_count,sort_id, category, category_id, recruit_enabled, finish_time, perk_min_value, max_merchant, required, terms_mode, circle_candidate_code, circle_role, circle_policy, circle_enabled, max_per_head_fee, allowed_validation_methods, max_node_xp, need_group, create_by, create_time, update_by, update_time from cms_topic_chapter
    </sql>

    <select id="selectCmsTopicChapterList" parameterType="CmsTopicChapter" resultMap="CmsTopicChapterResult">
        <include refid="selectCmsTopicChapterVo"/>
        <where>  
            <if test="topicId != null "> and topic_id = #{topicId}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="imgArr != null  and imgArr != ''"> and img_arr = #{imgArr}</if>
            <if test="totalTime != null "> and total_time = #{totalTime}</if>
            <if test="totalMileage != null "> and total_mileage = #{totalMileage}</if>
            <if test="locationCount != null "> and location_count = #{locationCount}</if>
            <if test="templateCount != null "> and template_count = #{templateCount}</if>
        </where>

        order by sort_id asc
    </select>
    
    <select id="selectCmsTopicChapterById" parameterType="Long" resultMap="CmsTopicChapterResult">
        <include refid="selectCmsTopicChapterVo"/>
        where id = #{id}
    </select>

    <select id="countContentByTopicForUpdate" resultType="java.lang.Long" useCache="false" flushCache="true">
        select count(*) from cms_topic_chapter where topic_id = #{topicId} for update nowait
    </select>

    <select id="selectContentByIdForUpdate" resultMap="CmsTopicChapterResult" useCache="false" flushCache="true">
        <include refid="selectCmsTopicChapterVo"/>
        where id = #{id} for update nowait
    </select>

    <select id="selectByTopicForUpdate" parameterType="Long" resultMap="CmsTopicChapterResult">
        <include refid="selectCmsTopicChapterVo"/>
        where topic_id = #{topicId}
        order by sort_id asc, id asc
        for update
    </select>

    <insert id="insertCmsTopicChapter" parameterType="CmsTopicChapter" useGeneratedKeys="true" keyProperty="id">
