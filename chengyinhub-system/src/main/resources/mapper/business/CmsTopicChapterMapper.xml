    <update id="updateCmsTopicChapter" parameterType="CmsTopicChapter">
        update cms_topic_chapter
        <trim prefix="SET" suffixOverrides=",">
            <if test="topicId != null">topic_id = #{topicId},</if>
            <if test="name != null">name = #{name},</if>
