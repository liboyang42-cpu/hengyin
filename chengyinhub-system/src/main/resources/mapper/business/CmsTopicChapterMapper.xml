        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="topicId != null">topic_id,</if>
            <if test="name != null">name,</if>
            <if test="description != null">description,</if>
            <if test="blocksJson != null">blocks,</if>
            <if test="atmospherePreset != null">atmosphere_preset,</if>
            <if test="audioUrl != null">audio_url,</if>
            <if test="imgArr != null">img_arr,</if>
            <if test="totalTime != null">total_time,</if>
            <if test="totalMileage != null">total_mileage,</if>
            <if test="locationCount != null">location_count,</if>
            <if test="templateCount != null">template_count,</if>
            <if test="sortId != null">sort_id,</if>
            <if test="category != null">category,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="recruitEnabled != null">recruit_enabled,</if>
            <if test="perkMinValue != null">perk_min_value,</if>
            <if test="maxMerchant != null">max_merchant,</if>
            <if test="required != null">required,</if>
            <if test="termsMode != null">terms_mode,</if>
            <if test="circleCandidateCode != null">circle_candidate_code,</if>
            <if test="circleRole != null">circle_role,</if>
            <if test="circlePolicy != null">circle_policy,</if>
            <if test="circleEnabled != null">circle_enabled,</if>
            <if test="maxPerHeadFee != null">max_per_head_fee,</if>
            <if test="allowedValidationMethods != null">allowed_validation_methods,</if>
            <if test="maxNodeXp != null">max_node_xp,</if>
            <if test="needGroup != null">need_group,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="topicId != null">#{topicId},</if>
            <if test="name != null">#{name},</if>
            <if test="description != null">#{description},</if>
            <if test="blocksJson != null">#{blocksJson},</if>
            <if test="atmospherePreset != null">#{atmospherePreset},</if>
