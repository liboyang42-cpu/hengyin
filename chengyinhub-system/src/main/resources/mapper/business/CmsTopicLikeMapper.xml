<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.CmsTopicLikeMapper">
    
    <resultMap type="CmsTopicLike" id="CmsTopicLikeResult">
        <result property="id"    column="id"    />
        <result property="memberId"    column="member_id"    />
        <result property="dataId"    column="data_id"    />
        <result property="likeType"    column="like_type"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectCmsTopicLikeVo">
        select id, member_id, data_id, like_type, create_by, create_time, update_by, update_time from cms_topic_like
    </sql>

    <select id="selectCmsTopicLikeList" parameterType="CmsTopicLike" resultMap="CmsTopicLikeResult">
        <include refid="selectCmsTopicLikeVo"/>
        <where>  
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="dataId != null "> and data_id = #{dataId}</if>
            <if test="likeType != null "> and like_type = #{likeType}</if>
        </where>
    </select>
    
    <select id="selectCmsTopicLikeById" parameterType="Long" resultMap="CmsTopicLikeResult">
        <include refid="selectCmsTopicLikeVo"/>
        where id = #{id}
    </select>

    <insert id="insertCmsTopicLike" parameterType="CmsTopicLike" useGeneratedKeys="true" keyProperty="id">
        insert into cms_topic_like
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="memberId != null">member_id,</if>
            <if test="dataId != null">data_id,</if>
            <if test="likeType != null">like_type,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="memberId != null">#{memberId},</if>
            <if test="dataId != null">#{dataId},</if>
            <if test="likeType != null">#{likeType},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateCmsTopicLike" parameterType="CmsTopicLike">
        update cms_topic_like
        <trim prefix="SET" suffixOverrides=",">
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="dataId != null">data_id = #{dataId},</if>
            <if test="likeType != null">like_type = #{likeType},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <select id="selectUmsMemberLikeNumByMemberId" resultType="Integer">
        select count(1) from cms_topic_like where member_id = #{member_id}
    </select>

    <select id="selectCmsTopicLikesByMemberAndDataIds" resultMap="CmsTopicLikeResult">
        <include refid="selectCmsTopicLikeVo"/>
        where member_id = #{memberId} and data_id in
        <foreach item="dataId" collection="dataIds" open="(" separator="," close=")">
            #{dataId}
        </foreach>
    </select>

    <!-- Exact own-topic predicate. No optional WHERE and no like_type filtering. -->
    <select id="countOwnTopicLikes" resultType="java.lang.Long">
        select count(1) from cms_topic_like
        where member_id = #{memberId,jdbcType=BIGINT}
          and data_id = #{topicId,jdbcType=BIGINT}
          and #{memberId,jdbcType=BIGINT} &gt; 0
          and #{topicId,jdbcType=BIGINT} &gt; 0
    </select>

    <delete id="deleteOwnTopicLikes">
        delete from cms_topic_like
        where member_id = #{memberId,jdbcType=BIGINT}
          and data_id = #{topicId,jdbcType=BIGINT}
          and #{memberId,jdbcType=BIGINT} &gt; 0
          and #{topicId,jdbcType=BIGINT} &gt; 0
    </delete>

    <delete id="deleteCmsTopicLikeById" parameterType="Long">
        delete from cms_topic_like where id = #{id}
    </delete>

    <delete id="deleteCmsTopicLikeByIds" parameterType="String">
        delete from cms_topic_like where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <insert id="ensureOwnedLike">
        insert into cms_topic_like(member_id, data_id, like_type, create_time)
        values (#{memberId}, #{topicId}, 1, now())
        on duplicate key update like_type = 1
    </insert>
    <delete id="deleteOwnedLike">
        delete from cms_topic_like where member_id = #{memberId} and data_id = #{topicId}
    </delete>
</mapper>