<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.OfficialBroadcastMapper">

    <resultMap type="OfficialBroadcast" id="OfficialBroadcastResult">
        <result property="clientRequestId" column="client_request_id" />
        <result property="requestOwner" column="request_owner" />
        <result property="requestHash" column="request_hash" />
        <result property="id"            column="id"             />
        <result property="eventId"       column="event_id"       />
        <result property="title"         column="title"          />
        <result property="audience"      column="audience"       />
        <result property="copyMode"      column="copy_mode"      />
        <result property="contentJson"   column="content_json"   />
        <result property="channels"      column="channels"       />
        <result property="city"          column="city"           />
        <result property="scheduledTime" column="scheduled_time" />
        <result property="status"        column="status"         />
        <result property="reachedCount"  column="reached_count"  />
        <result property="senderAccount" column="sender_account" />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectOfficialBroadcastVo">
        select client_request_id,request_owner,request_hash,id, event_id, title, audience, copy_mode, content_json, channels, city,
               scheduled_time, status, reached_count, sender_account, create_time
        from official_broadcast
    </sql>

    <select id="selectOfficialBroadcastById" resultMap="OfficialBroadcastResult">
        <include refid="selectOfficialBroadcastVo"/>
        where id = #{id}
    </select>

    <select id="selectBySender" resultMap="OfficialBroadcastResult">
        <include refid="selectOfficialBroadcastVo"/>
        where sender_account = #{senderAccount}
        order by id desc
    </select>

    <select id="selectByEvent" resultMap="OfficialBroadcastResult">
        <include refid="selectOfficialBroadcastVo"/>
        where event_id = #{eventId}
        order by create_time asc, id asc
    </select>

    <select id="selectDueScheduled" resultMap="OfficialBroadcastResult">
        <include refid="selectOfficialBroadcastVo"/>
        where status = 1 and audience_frozen=0 and scheduled_time is not null and scheduled_time &lt;= now()
    </select>

    <insert id="insertOfficialBroadcast" parameterType="OfficialBroadcast" useGeneratedKeys="true" keyProperty="id">
        insert into official_broadcast
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="clientRequestId != null">client_request_id,request_owner,request_hash,</if>
            <if test="eventId != null">event_id,</if>
            <if test="title != null">title,</if>
            <if test="audience != null">audience,</if>
            <if test="copyMode != null">copy_mode,</if>
            <if test="contentJson != null">content_json,</if>
            <if test="channels != null">channels,</if>
            <if test="city != null">city,</if>
            <if test="scheduledTime != null">scheduled_time,</if>
            <if test="status != null">status,</if>
            <if test="senderAccount != null">sender_account,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="clientRequestId != null">#{clientRequestId},#{requestOwner},#{requestHash},</if>
            <if test="eventId != null">#{eventId},</if>
            <if test="title != null">#{title},</if>
            <if test="audience != null">#{audience},</if>
            <if test="copyMode != null">#{copyMode},</if>
            <if test="contentJson != null">#{contentJson},</if>
            <if test="channels != null">#{channels},</if>
            <if test="city != null">#{city},</if>
            <if test="scheduledTime != null">#{scheduledTime},</if>
            <if test="status != null">#{status},</if>
            <if test="senderAccount != null">#{senderAccount},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateOfficialBroadcast" parameterType="OfficialBroadcast">
        update official_broadcast
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null">title = #{title},</if>
            <if test="audience != null">audience = #{audience},</if>
            <if test="copyMode != null">copy_mode = #{copyMode},</if>
            <if test="contentJson != null">content_json = #{contentJson},</if>
            <if test="channels != null">channels = #{channels},</if>
            <if test="city != null">city = #{city},</if>
            <if test="scheduledTime != null">scheduled_time = #{scheduledTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="reachedCount != null">reached_count = #{reachedCount},</if>
        </trim>
        where id = #{id}
    </update>

 <select id="lockDispatch" resultType="map">select id,status,audience_frozen from official_broadcast where id=#{id} for update</select>
 <update id="freezeAudience">update official_broadcast set audience_frozen=1 where id=#{id}</update>
<select id="findRequest" resultMap="OfficialBroadcastResult"><include refid="selectOfficialBroadcastVo"/> where request_owner=#{owner} and client_request_id=#{key}</select>
 <insert id="reserveCreation">insert ignore into official_broadcast_creation(request_owner,request_id,state) values(#{owner},#{key},'PENDING')</insert>
 <select id="readCreation" resultType="map">select state,broadcast_id from official_broadcast_creation where request_owner=#{owner} and request_id=#{key}</select>
 <select id="lockCreation" resultType="map">select state,broadcast_id from official_broadcast_creation where request_owner=#{owner} and request_id=#{key} for update</select>
 <update id="finishCreation">update official_broadcast_creation set state=#{state},broadcast_id=#{broadcast} where request_owner=#{owner} and request_id=#{key} and state='PENDING'</update>
</mapper>
