            <if test="pauseNotificationPlan != null">pause_notification_plan = #{pauseNotificationPlan},</if>
            <if test="pauseNotificationStatus != null">pause_notification_status = #{pauseNotificationStatus},</if>
            <if test="resumeNote != null">resume_note = #{resumeNote},</if>
