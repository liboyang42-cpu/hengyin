<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.UmsMemberWithdrawalMapper">
    
    <resultMap type="UmsMemberWithdrawal" id="UmsMemberWithdrawalResult">
        <result property="id"    column="id"    />
        <result property="memberId"    column="member_id"    />
        <result property="requestId" column="request_id" />
        <result property="requestFingerprint" column="request_fingerprint" />
        <result property="realname"    column="realname"    />
        <result property="bankName"    column="bank_name"    />
        <result property="bankAccount"    column="bank_account"    />
        <result property="mobilephone"    column="mobilephone"    />
        <result property="realnameEncrypted" column="realname_enc" />
        <result property="bankNameEncrypted" column="bank_name_enc" />
        <result property="bankAccountEncrypted" column="bank_account_enc" />
        <result property="mobilephoneEncrypted" column="mobilephone_enc" />
        <result property="realnameMask" column="realname_mask" />
        <result property="bankNameMask" column="bank_name_mask" />
        <result property="bankAccountMask" column="bank_account_mask" />
        <result property="mobilephoneMask" column="mobilephone_mask" />
        <result property="piiCipherVersion" column="pii_cipher_version" />
        <result property="piiMigratedAt" column="pii_migrated_at" />
        <result property="withdrawalAmount"    column="withdrawal_amount"    />
        <result property="serviceFee"    column="service_fee"    />
        <result property="receivedAmount"    column="received_amount"    />
        <result property="status"    column="status"    />
        <result property="payoutReference" column="payout_reference" />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="auditTime"    column="audit_time"    />
        <result property="auditBy"    column="audit_by"    />
        <result property="handleBy"    column="handle_by"    />
        <result property="handleTime"    column="handle_time"    />
    </resultMap>

    <sql id="selectUmsMemberWithdrawalVo">
        select id, member_id, request_id, request_fingerprint, realname, bank_name, bank_account, mobilephone,
               realname_enc, bank_name_enc, bank_account_enc, mobilephone_enc,
               realname_mask, bank_name_mask, bank_account_mask, mobilephone_mask,
               pii_cipher_version, pii_migrated_at,
               withdrawal_amount, service_fee, received_amount, status, payout_reference, del_flag, remark,
               create_by, create_time, update_by, update_time, audit_time, audit_by, handle_by, handle_time
        from ums_member_withdrawal
    </sql>

    <select id="selectUmsMemberWithdrawalList" parameterType="UmsMemberWithdrawal" resultMap="UmsMemberWithdrawalResult">
        <include refid="selectUmsMemberWithdrawalVo"/>
        <where>  
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="realname != null  and realname != ''"> and realname like concat('%', #{realname}, '%')</if>
            <if test="bankName != null  and bankName != ''"> and bank_name like concat('%', #{bankName}, '%')</if>
            <if test="bankAccount != null  and bankAccount != ''"> and bank_account = #{bankAccount}</if>
            <if test="mobilephone != null  and mobilephone != ''"> and mobilephone = #{mobilephone}</if>
            <if test="withdrawalAmount != null "> and withdrawal_amount = #{withdrawalAmount}</if>
            <if test="serviceFee != null "> and service_fee = #{serviceFee}</if>
            <if test="receivedAmount != null "> and received_amount = #{receivedAmount}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="payoutReference != null and payoutReference != ''"> and payout_reference = #{payoutReference}</if>
            <if test="auditTime != null "> and audit_time = #{auditTime}</if>
            <if test="auditBy != null "> and audit_by = #{auditBy}</if>
            <if test="handleBy != null "> and handle_by = #{handleBy}</if>
            <if test="handleTime != null "> and handle_time = #{handleTime}</if>
        </where>
    </select>
    
    <select id="selectUmsMemberWithdrawalById" parameterType="Long" resultMap="UmsMemberWithdrawalResult">
        <include refid="selectUmsMemberWithdrawalVo"/>
        where id = #{id}
    </select>

    <select id="selectUmsMemberWithdrawalByIdForUpdate" parameterType="Long" resultMap="UmsMemberWithdrawalResult">
        <include refid="selectUmsMemberWithdrawalVo"/>
        where id = #{id}
        for update
    </select>

    <select id="selectByMemberAndRequest" resultMap="UmsMemberWithdrawalResult">
        <include refid="selectUmsMemberWithdrawalVo"/>
        where member_id = #{memberId} and request_id = #{requestId}
    </select>

    <select id="selectByMemberAndRequestForUpdate" resultMap="UmsMemberWithdrawalResult">
        <include refid="selectUmsMemberWithdrawalVo"/>
        where member_id = #{memberId} and request_id = #{requestId}
        for update
    </select>

    <select id="selectPendingIdByMemberForUpdate" resultType="long">
        select id from ums_member_withdrawal
        where member_id = #{memberId} and status in (0, 1) and del_flag = 0
        order by id
        limit 1
        for update
    </select>

    <insert id="insertUmsMemberWithdrawal" parameterType="UmsMemberWithdrawal" useGeneratedKeys="true" keyProperty="id">
        insert into ums_member_withdrawal
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="memberId != null">member_id,</if>
            <if test="requestId != null">request_id,</if>
            <if test="requestFingerprint != null">request_fingerprint,</if>
            <if test="realnameEncrypted != null">realname_enc,</if>
            <if test="bankNameEncrypted != null">bank_name_enc,</if>
            <if test="bankAccountEncrypted != null">bank_account_enc,</if>
            <if test="mobilephoneEncrypted != null">mobilephone_enc,</if>
            <if test="realnameMask != null">realname_mask,</if>
            <if test="bankNameMask != null">bank_name_mask,</if>
            <if test="bankAccountMask != null">bank_account_mask,</if>
            <if test="mobilephoneMask != null">mobilephone_mask,</if>
            <if test="piiCipherVersion != null">pii_cipher_version,</if>
            <if test="piiMigratedAt != null">pii_migrated_at,</if>
            <if test="withdrawalAmount != null">withdrawal_amount,</if>
            <if test="serviceFee != null">service_fee,</if>
            <if test="receivedAmount != null">received_amount,</if>
            <if test="status != null">status,</if>
            <if test="payoutReference != null">payout_reference,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="handleBy != null">handle_by,</if>
            <if test="handleTime != null">handle_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="memberId != null">#{memberId},</if>
            <if test="requestId != null">#{requestId},</if>
            <if test="requestFingerprint != null">#{requestFingerprint},</if>
            <if test="realnameEncrypted != null">#{realnameEncrypted},</if>
            <if test="bankNameEncrypted != null">#{bankNameEncrypted},</if>
            <if test="bankAccountEncrypted != null">#{bankAccountEncrypted},</if>
            <if test="mobilephoneEncrypted != null">#{mobilephoneEncrypted},</if>
            <if test="realnameMask != null">#{realnameMask},</if>
            <if test="bankNameMask != null">#{bankNameMask},</if>
            <if test="bankAccountMask != null">#{bankAccountMask},</if>
            <if test="mobilephoneMask != null">#{mobilephoneMask},</if>
            <if test="piiCipherVersion != null">#{piiCipherVersion},</if>
            <if test="piiMigratedAt != null">#{piiMigratedAt},</if>
            <if test="withdrawalAmount != null">#{withdrawalAmount},</if>
            <if test="serviceFee != null">#{serviceFee},</if>
            <if test="receivedAmount != null">#{receivedAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="payoutReference != null">#{payoutReference},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="handleBy != null">#{handleBy},</if>
            <if test="handleTime != null">#{handleTime},</if>
         </trim>
    </insert>

    <update id="updateUmsMemberWithdrawal" parameterType="UmsMemberWithdrawal">
        update ums_member_withdrawal
        <trim prefix="SET" suffixOverrides=",">
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="realnameEncrypted != null">realname_enc = #{realnameEncrypted},</if>
            <if test="bankNameEncrypted != null">bank_name_enc = #{bankNameEncrypted},</if>
            <if test="bankAccountEncrypted != null">bank_account_enc = #{bankAccountEncrypted},</if>
            <if test="mobilephoneEncrypted != null">mobilephone_enc = #{mobilephoneEncrypted},</if>
            <if test="realnameMask != null">realname_mask = #{realnameMask},</if>
            <if test="bankNameMask != null">bank_name_mask = #{bankNameMask},</if>
            <if test="bankAccountMask != null">bank_account_mask = #{bankAccountMask},</if>
            <if test="mobilephoneMask != null">mobilephone_mask = #{mobilephoneMask},</if>
            <if test="piiCipherVersion != null">pii_cipher_version = #{piiCipherVersion},</if>
            <if test="piiMigratedAt != null">pii_migrated_at = #{piiMigratedAt},</if>
            <if test="withdrawalAmount != null">withdrawal_amount = #{withdrawalAmount},</if>
            <if test="serviceFee != null">service_fee = #{serviceFee},</if>
            <if test="receivedAmount != null">received_amount = #{receivedAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="payoutReference != null">payout_reference = #{payoutReference},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="auditBy != null">audit_by = #{auditBy},</if>
            <if test="handleBy != null">handle_by = #{handleBy},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
        </trim>
        where id = #{id}
    </update>

    <select id="selectLegacySensitiveRows" resultMap="UmsMemberWithdrawalResult">
        <include refid="selectUmsMemberWithdrawalVo"/>
        where pii_cipher_version is null
          and (realname is not null or bank_name is not null or bank_account is not null or mobilephone is not null)
        order by id asc
        limit #{limit}
    </select>

    <update id="migrateSensitiveData" parameterType="UmsMemberWithdrawal">
        update ums_member_withdrawal
        set realname = null,
            bank_name = null,
            bank_account = null,
            mobilephone = null,
            realname_enc = #{realnameEncrypted},
            bank_name_enc = #{bankNameEncrypted},
            bank_account_enc = #{bankAccountEncrypted},
            mobilephone_enc = #{mobilephoneEncrypted},
            realname_mask = #{realnameMask},
            bank_name_mask = #{bankNameMask},
            bank_account_mask = #{bankAccountMask},
            mobilephone_mask = #{mobilephoneMask},
            pii_cipher_version = #{piiCipherVersion},
            pii_migrated_at = #{piiMigratedAt}
        where id = #{id}
          and pii_cipher_version is null
    </update>

    <update id="updateWithdrawalStatusIfPending">
        update ums_member_withdrawal
        set status = #{status},
            audit_by = #{auditBy},
            audit_time = #{auditTime},
            remark = #{remark},
            update_time = #{auditTime}
        where id = #{id}
          and status = 0
          and del_flag = 0
    </update>

    <update id="updateWithdrawalPaidIfApproved">
        update ums_member_withdrawal
        set status = 3,
            payout_reference = #{payoutReference},
            handle_by = #{handleBy},
            handle_time = #{handleTime},
            update_time = #{handleTime}
        where id = #{id}
          and status = 1
          and del_flag = 0
    </update>

    <!-- 用户撤回只允许本人待审核单；owner/status/del_flag 必须在同一条 CAS。 -->
    <update id="softDeletePendingByMember">
        update ums_member_withdrawal
        set del_flag = 2,
            update_time = #{updateTime}
        where id = #{id}
          and member_id = #{memberId}
          and status = 0
          and del_flag = 0
    </update>

    <select id="countPendingByMember" resultType="int">
        select count(*) from ums_member_withdrawal
        where member_id = #{memberId} and status in (0, 1) and del_flag = 0
    </select>

    <delete id="deleteUmsMemberWithdrawalById" parameterType="Long">
        delete from ums_member_withdrawal where id = #{id}
    </delete>

    <delete id="deleteUmsMemberWithdrawalByIds" parameterType="String">
        delete from ums_member_withdrawal where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
