<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.ExploreBundleRefundMapper">
    <resultMap id="Hold" type="com.chengyinhub.business.domain.ExploreBundleRefundHold">
        <id property="registrationId" column="registration_id"/>
        <result property="holderMemberId" column="holder_member_id"/>
        <result property="sourceRegistrationId" column="source_registration_id"/>
        <result property="refundId" column="refund_id"/>
        <result property="refundNo" column="refund_no"/>
        <result property="cashAmount" column="cash_amount"/>
        <result property="state" column="state"/>
        <result property="version" column="version"/>
    </resultMap>
    <select id="selectByRegistration" resultMap="Hold">
        select * from explore_bundle_refund_hold where registration_id=#{registrationId}
    </select>
    <select id="selectByRegistrationForUpdate" resultMap="Hold">
        select * from explore_bundle_refund_hold where registration_id=#{registrationId} for update
    </select>
    <insert id="insert">
        insert into explore_bundle_refund_hold
        (registration_id,holder_member_id,source_registration_id,refund_id,refund_no,cash_amount,state,version)
        values (#{registrationId},#{holderMemberId},#{sourceRegistrationId},#{refundId},#{refundNo},#{cashAmount},#{state},0)
    </insert>
    <update id="update">
        update explore_bundle_refund_hold set refund_id=#{refundId}, refund_no=#{refundNo},state=#{state},
        version=version+1,update_time=current_timestamp
        where registration_id=#{registrationId} and version=#{version}
    </update>
</mapper>
