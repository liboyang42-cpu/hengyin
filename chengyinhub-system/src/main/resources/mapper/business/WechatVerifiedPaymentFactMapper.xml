<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.WechatVerifiedPaymentFactMapper">
    <insert id="insertIgnore" parameterType="map" useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO wx_verified_payment_fact
          (fact_kind,mchid,appid,business_out_trade_no,wx_out_trade_no,merchant_event_no,provider_id,
           transaction_id,trade_type,currency,total_fen,amount_fen,success_at,intent_request_hash,
           fact_hash,verification_version,verification_outcome,verification_method,original_payment_state)
        VALUES (#{fact_kind},#{mchid},#{appid},#{business_out_trade_no},#{wx_out_trade_no},#{merchant_event_no},#{provider_id},
           #{transaction_id},#{trade_type},#{currency},#{total_fen},#{amount_fen},#{success_at},#{intent_request_hash},
           #{fact_hash},1,'VERIFIED','SDK_QUERY_ORIGINAL_ORDER',#{original_payment_state})
    </insert>
    <select id="selectMatching" resultType="map">
        SELECT * FROM wx_verified_payment_fact WHERE fact_kind=#{kind} AND mchid=#{mchid}
          AND (provider_id=#{providerId} OR merchant_event_no=#{eventNo}) ORDER BY id
    </select>
    <select id="selectSuccessesByBusiness" resultType="map" useCache="false">
        SELECT * FROM wx_verified_payment_fact WHERE business_out_trade_no=#{businessNo} ORDER BY id
    </select>
    <select id="selectById" resultType="map">SELECT * FROM wx_verified_payment_fact WHERE id=#{id}</select>
    <insert id="insertRejection" parameterType="map">
        INSERT IGNORE INTO wx_verified_payment_fact_rejection
          (rejection_key,rejection_reason,original_fact_id,candidate_fact_hash,notify_hash,candidate_facts)
        VALUES (#{rejection_key},#{rejection_reason},#{original_fact_id},#{candidate_fact_hash},#{notify_hash},#{candidate_facts})
    </insert>
    <insert id="insertInboxLink" parameterType="map">
        INSERT IGNORE INTO wx_payment_callback_fact_link (inbox_id,notify_hash,fact_id,fact_hash)
        VALUES (#{inbox_id},#{notify_hash},#{fact_id},#{fact_hash})
    </insert>
    <select id="selectInboxLink" resultType="map" useCache="false" flushCache="true">
        SELECT inbox_id,notify_hash,fact_id,fact_hash FROM wx_payment_callback_fact_link WHERE notify_hash IN (LOWER(#{notifyHash}),UPPER(#{notifyHash})) FOR SHARE
    </select>
</mapper>
