<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengyinhub.business.mapper.ClubPostRevisionMapper">
    <resultMap id="ClubPostRevisionResult" type="ClubPostRevision">
        <id property="id" column="id" />
        <result property="postId" column="post_id" />
        <result property="clubId" column="club_id" />
        <result property="editorMemberId" column="editor_member_id" />
        <result property="snapshotVersion" column="snapshot_version" />
        <result property="content" column="content" />
        <result property="images" column="images" />
        <result property="type" column="type" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <insert id="insertClubPostRevision" parameterType="ClubPostRevision" useGeneratedKeys="true" keyProperty="id">
        insert into club_post_revision
          (post_id, club_id, editor_member_id, snapshot_version, content, images, type, create_time)
        values
          (#{postId}, #{clubId}, #{editorMemberId}, #{snapshotVersion}, #{content}, #{images}, #{type}, #{createTime})
    </insert>

    <select id="selectByPostId" parameterType="Long" resultMap="ClubPostRevisionResult">
        select id, post_id, club_id, editor_member_id, snapshot_version, content, images, type, create_time
        from club_post_revision
        where post_id = #{postId}
        order by snapshot_version desc, id desc
        limit 20
    </select>
</mapper>
