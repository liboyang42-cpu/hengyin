    <sql id="ViewRegistrationFilter">
        <where>  
            <if test="registrationNo != null  and registrationNo != ''"> and registration_no = #{registrationNo}</if>
            <if test="ownerType != null "> and owner_type = #{ownerType}</if>
            <if test="ownerId != null "> and owner_id = #{ownerId}</if>
            <if test="activityTitle != null  and activityTitle != ''"> and activity_title = #{activityTitle}</if>
            <if test="ticketId != null "> and ticket_id = #{ticketId}</if>
            <if test="ticketName != null  and ticketName != ''"> and ticket_name like concat('%', #{ticketName}, '%')</if>
            <if test="ticketPrice != null "> and ticket_price = #{ticketPrice}</if>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <!-- PII 加密后姓名/手机/邮箱/地址密文不可检索(合规§6.3):此视图检索能力下线,
                 按手机号查请走基表报名列表(CmsRegistration,phone_hash 盲索引)。 -->

            <if test="addressId != null "> and address_id = #{addressId}</if>
            <if test="orderNum != null "> and order_num = #{orderNum}</if>
            <if test="originalAmount != null "> and original_amount = #{originalAmount}</if>
            <if test="discountAmount != null "> and discount_amount = #{discountAmount}</if>
            <if test="totalAmount != null "> and total_amount = #{totalAmount}</if>
            <if test="pointUsed != null "> and point_used = #{pointUsed}</if>
            <if test="pointDeductAmount != null "> and point_deduct_amount = #{pointDeductAmount}</if>
