            <if test="maxPointDeduct != null "> and max_point_deduct = #{maxPointDeduct}</if>
            <if test="payableAmount != null "> and payable_amount = #{payableAmount}</if>
            <if test="paymentStatus != null "> and payment_status = #{paymentStatus}</if>
            <if test="paymentType != null "> and payment_type = #{paymentType}</if>
            <if test="paymentTime != null "> and payment_time = #{paymentTime}</if>
            <if test="transactionId != null  and transactionId != ''"> and transaction_id = #{transactionId}</if>
            <if test="pointPaymentAmount != null "> and point_payment_amount = #{pointPaymentAmount}</if>
            <if test="wechatPaymentAmount != null "> and wechat_payment_amount = #{wechatPaymentAmount}</if>
            <if test="registrationStatus != null "> and registration_status = #{registrationStatus}</if>
            <if test="payExpireTime != null "> and pay_expire_time = #{payExpireTime}</if>
            <if test="verificationCode != null  and verificationCode != ''"> and verification_code = #{verificationCode}</if>
            <if test="qrcodeUrl != null  and qrcodeUrl != ''"> and qrcode_url = #{qrcodeUrl}</if>
            <if test="verificationStatus != null "> and verification_status = #{verificationStatus}</if>
            <if test="verificationTime != null "> and verification_time = #{verificationTime}</if>
            <if test="verifierId != null "> and verifier_id = #{verifierId}</if>
            <if test="pointsReturned != null "> and points_returned = #{pointsReturned}</if>
            <if test="avatar != null  and avatar != ''"> and avatar = #{avatar}</if>
            <if test="nickname != null  and nickname != ''"> and nickname like concat('%', #{nickname}, '%')</if>
        </where>
    </sql>

    <select id="selectViewRegistrationList" parameterType="ViewRegistration" resultMap="ViewRegistrationResult">
        <include refid="selectViewRegistrationVo"/>
        <include refid="ViewRegistrationFilter"/>
    </select>

    <select id="selectRegistrationSummaries" parameterType="ViewRegistration" resultMap="RegistrationSummaryResult">
