<!-- Chain acceptance fixture logging (ci/chain_acceptance.py). The packaged logback.xml writes to
     /home/ruoyi/logs, which the non-root GitHub runner user cannot create; Spring Boot then aborts with
     "Logging system failed to initialize". Console only: the driver captures it as application.log. -->
<configuration>
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%date %level [%thread] %logger - %msg%n</pattern></encoder>
  </appender>
  <root level="INFO"><appender-ref ref="console"/></root>
</configuration>
