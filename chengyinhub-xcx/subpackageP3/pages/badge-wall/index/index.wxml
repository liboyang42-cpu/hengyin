<!-- 勋章墙:整屏 WebGL 数字装置。canvas 铺满视口,cover-view 做原生层之上的悬浮字幕层/详情 sheet;
     无 WebGL 或引擎失败 → 静态网格降级(L0)。 -->
<!-- 2026-10-30 业主定稿 P-3:勋章墙成了「收集册 · 勋章」:整屏浅色流动底、两个一排、计数换成一圈点、点一枚飞到屏幕中间 -->
<view class="theme-light" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);">
  <album-aura wx:if="{{viewMode === 'list'}}" />
  <cy-nav-bar wx:if="{{viewMode === 'list'}}" overlay />
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
<view class="bw" style="--sbh:{{statusBarHeight}}px; --nbh:{{navBarHeight}}px;">

  <!-- 主体:单 WebGL canvas -->
  <block wx:if="{{viewMode === 'wall' && (!loaded || badges.length)}}">
    <canvas wx:if="{{!glFail && !loadFail && !partialFail}}" type="webgl" id="wall" class="bw-gl"
            disable-scroll="{{true}}"
            bindtouchstart="onTouch" bindtouchmove="onTouch" bindtouchend="onTouchEnd"
            bindtouchcancel="onTouchEnd"></canvas>

    <!-- L0 降级:静态网格 -->
    <scroll-view wx:else scroll-y class="bw-fallback" style="padding-top:{{statusBarHeight + 60}}px;">
      <view class="bw-fb-grid">
        <view class="bw-fb-item" wx:for="{{badges}}" wx:key="index" bindtap="onFbTap" data-idx="{{index}}" hover-class="cy-pressed" hover-stay-time="80">
          <image class="bw-fb-img" src="{{item.iconUrl}}" mode="aspectFit" wx:if="{{item.iconUrl}}"></image>
          <view class="bw-fb-img bw-fb-ph" wx:else aria-role="img" aria-label="默认勋章图标">
            <cy-icon name="star" size="48" />
          </view>
          <text class="bw-fb-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </block>

  <scroll-view class="bw-list" scroll-y wx:if="{{viewMode === 'list' && badges.length && !loadFail && !partialFail}}" style="{{pmList === 1 ? '--pm-b:1;' : (pmList === 2 ? '--pm-b-d:.32s;--pm-b-s:1;' : '')}}">
    <album-head active="medal" />
    <!-- 计数(参考 mymind):一圈 24 颗点,按已点亮的比例一颗颗亮起;中间枚数,右边一句宋体 -->
    <view class="bw-sum" aria-role="text" aria-label="已点亮 {{unlockedCount}} 枚，共 {{badges.length}} 枚">
      <view class="bw-ring {{ringOn ? 'is-on' : ''}}" aria-hidden="true">
        <view wx:for="{{ringDots}}" wx:key="i" class="bw-dot {{item.lit ? 'is-lit' : ''}}" style="left:{{item.x}}%;top:{{item.y}}%;transition-delay:{{item.d}}ms;"></view>
        <view class="bw-ring__num"><text class="bw-ring__n">{{unlockedCount}}</text><text class="bw-ring__t">共 {{badges.length}}</text></view>
      </view>
      <text class="bw-say" aria-hidden="true">{{ringSay}}</text>
    </view>
    <!-- 2026-10-28 业主:一行两个勋章,直接看到勋章长什么样;没解锁的变灰,但还认得出是什么。勋章下面不垫灰色方块。 -->
    <block wx:for="{{badgeGroups}}" wx:for-item="group" wx:key="key">
      <text class="bw-list-h" wx:if="{{group.title}}">{{group.title}}</text>
      <view class="bw-grid">
        <view class="bw-cell" wx:for="{{group.items}}" wx:for-item="item" wx:key="_idx" bindtap="onFbTap" data-idx="{{item._idx}}" hover-class="cy-pressed" hover-stay-time="80" style="--pmi:{{item._idx}};"
              aria-role="button" aria-label="{{item.name}}，{{item.locked ? '尚未点亮' : '已点亮'}}">
          <view class="bw-card bw-card--{{item.rarity || 0}} {{item.locked ? 'is-locked' : ''}} {{flyIdx === item._idx ? 'is-away' : ''}}">
          <view class="bw-medal {{item.locked ? 'is-locked' : ''}}" id="bw-medal-{{item._idx}}">
            <image wx:if="{{item.iconUrl}}" class="bw-medal__img" src="{{item.iconUrl}}" mode="aspectFit" />
            <image wx:elif="{{pins[item.pinId]}}" class="bw-medal__pin" src="{{pins[item.pinId]}}" mode="aspectFit" aria-hidden="true" />
          </view>
          </view>
          <text class="bw-cell__name ep1">{{item.name}}</text>
          <text class="bw-cell__meta ep1">{{item.locked ? (item.cond || '尚未点亮') : (item.time || '已点亮')}}</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- 列表模式首屏加载占位:数据未到前不留空白黑屏 -->
  <view class="bw-list" wx:if="{{viewMode === 'list' && !loaded && !loadFail && !partialFail}}">
    <cy-skeleton type="list" count="5" loading-label="正在加载勋章" />
  </view>

  <cy-empty class="bw-empty-state" fill size="lg" title="还没有点亮勋章"
    cta="去探索" bind:cta="goExplore"
    wx:if="{{loaded && !badges.length && !loadFail && !partialFail}}" />

  <!-- 原生 WebGL 覆盖层:普通 view 会被 canvas 原生层压住,返回必须留在 cover-view 上 -->
  <cover-view class="bw-top" wx:if="{{viewMode === 'wall'}}" style="padding-top:{{statusBarHeight}}px;">
    <cover-view class="bw-top-bar" style="height:{{navBarHeight}}px;">
      <cover-view class="bw-back-hit" bindtap="goBack" aria-role="button" aria-label="返回" hover-class="cy-pressed" hover-stay-time="80">
        <cover-view class="bw-back-inner"><cover-image class="bw-back-icon" src="/subpackageP3/images/icon_back.png" mode="aspectFit" /></cover-view>
      </cover-view>
    </cover-view>
    <!-- 信息层必须继续使用 cover-view，避免被 WebGL 原生层压住。 -->
    <cover-view class="bw-cap">
      <cover-view class="bw-head">
        <cover-view class="bw-page-title"><cover-view class="bw-cap-t">勋章墙</cover-view></cover-view>
        <cover-view class="bw-cap-s" wx:if="{{loaded}}">已点亮 {{unlockedCount}} / {{badges.length}} · 还有 {{ lockedCount || 0 }} 枚等待探索</cover-view>
        <cover-view class="bw-cap-s" wx:else>正在唤醒勋章…</cover-view>
        <!-- 从玩法侧带 badgeCode 跳进来时的回读结论。找不到就照实说,不假装已落位。
             ⚠️必须留在 bw-cap 这棵 cover-view 里:普通 view 会被 WebGL 原生层压住,
             放在 canvas 之外的游离 cover-view 则根本不渲染(2026-08-25 截图实证)。 -->
        <cover-view class="bw-focus" wx:if="{{focusText}}">{{focusText}}</cover-view>
        <!-- 2026-10-27 owner P-30:去掉「墙 / 列表」切换,只有一页:上面已点亮,下面未解锁 -->
      </cover-view>
    </cover-view>
  </cover-view>

  <!-- 请求失败/部分数据失败:身份卡仍可见,但不能把缺失的城市纪念章静默当成完整结果 -->
  <cy-error load-failure="{{loadFail && !wallAuthRequired && !wallAccessDenied}}" class="bw-error-state" wx:if="{{loadFail || partialFail || (glFail && viewMode === 'wall')}}" fill size="lg"
    icon="empty-state"
    title="{{wallAuthRequired ? '登录后查看我的勋章' : loadFail ? '勋章数据没有到达' : partialFail ? '部分勋章数据未到达，当前结果不完整' : glFail ? '勋章墙渲染失败' : ''}}"
    sub="{{partialFail ? '部分内容未更新' : ''}}"
    retry="{{wallAuthRequired ? '登录' : '重试'}}" bind:retry="retryWall" />

  <!-- 详情 veil + sheet:同样必须在原生 canvas 之上;外观照玩家场景弹窗 cy-scene-sheet(标题行只放标题与叉) -->
  <cover-view class="bw-veil {{sheetOn ? 'on' : ''}}" bindtap="closeSheet" catchtouchmove="noop" hover-class="cy-pressed" hover-stay-time="80"></cover-view>
  <cover-view class="bw-sheet {{sheetOn ? 'on' : ''}}">
    <cover-view class="bw-sh-hd">
      <cover-view class="bw-sh-name">{{sheet.name}}</cover-view>
      <cover-view class="bw-sh-x" bindtap="closeSheet" aria-role="button" aria-label="关闭勋章详情" hover-class="cy-pressed" hover-stay-time="80">
        <cover-view class="bw-sh-x-visual"><cover-image class="bw-sh-x-icon" src="/subpackageP3/images/icon_close_sm.png" mode="aspectFit" /></cover-view>
      </cover-view>
    </cover-view>
    <cover-view class="bw-sh-body"><cover-image wx:if="{{!sheet.iconUrl && pins[sheet.pinId] && sheet.locked}}" class="bw-sh-pin" src="{{pins[sheet.pinId]}}" mode="aspectFit" /><cover-image wx:elif="{{!sheet.iconUrl && pins[sheet.pinId]}}" class="bw-sh-pin" src="{{pins[sheet.pinId]}}" mode="aspectFit" bindtap="goBadge3d" aria-role="button" aria-label="旋转查看{{sheet.name}}" hover-class="cy-pressed" hover-stay-time="80" />
      <!-- 类别小胶囊:放在标题下一行(不跟叉挤在标题行);它就是原来「来源」那一格说的事,来源行因此删掉 -->
      <cover-view class="bw-sh-rar" style="color:{{sheet.rarColor}};">{{sheet.rarZh}}</cover-view>
      <cover-view class="bw-sh-desc">{{sheet.desc}}</cover-view>
      <cover-view class="bw-sh-meta">
        <cover-view class="bw-sm"><cover-view class="bw-sm-k">获得时间</cover-view><cover-view class="bw-sm-v">{{sheet.time || '—'}}</cover-view></cover-view>
        <cover-view class="bw-sm bw-sm--wide" wx:if="{{sheet.cond}}"><cover-view class="bw-sm-k">{{sheet.time === '未点亮' ? '如何点亮' : '获得条件'}}</cover-view><cover-view class="bw-sm-v">{{sheet.cond}}</cover-view></cover-view>
      </cover-view>
      <!-- 双样式:珐琅勋章可进 3D 转台细看;发光勋章墙上本体即是终态 -->
      <cover-view class="bw-sh-3d" wx:if="{{sheet.style=='enamel' || (!sheet.iconUrl && sheet.pinId && !sheet.locked)}}" bindtap="goBadge3d" aria-role="button" aria-label="查看 3D 徽章" hover-class="cy-pressed" hover-stay-time="80">查看 3D 徽章<cover-image class="bw-sh-3d-icon" src="/images/icon_right.png" mode="aspectFit" /></cover-view>
    </cover-view>
  </cover-view>
  <!-- 2026-10-30 业主:点开不是新页面 —— 那一枚自己从格子里飞到屏幕中间放大,底下压暗;点空白处飞回去,点勋章进 3D 转台 -->
  <view class="bw-fly {{fly.on ? 'is-on' : ''}}" wx:if="{{fly.show}}" bindtap="closeFly" catchtouchmove="noop" aria-role="dialog" aria-label="{{fly.name}}">
    <view class="bw-fly__veil"></view>
    <image class="bw-fly__pin {{fly.locked ? 'is-locked' : ''}}" src="{{fly.src}}" mode="aspectFit" style="{{fly.style}}" catchtap="onFlyPin"
           aria-role="button" aria-label="{{fly.locked ? fly.name : '转动查看' + fly.name}}" />
    <view class="bw-fly__cap"><text class="bw-fly__name">{{fly.name}}</text><text class="bw-fly__meta">{{fly.meta}}</text></view>
  </view>
  <!-- 2026-10-28 珐琅徽章离屏画布:只用来生成徽记图,不显示 -->
  <canvas type="2d" id="pinCanvas" class="bw-pin-canvas"></canvas>
</view>
</view>
