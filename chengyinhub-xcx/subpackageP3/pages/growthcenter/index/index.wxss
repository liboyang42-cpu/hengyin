page { background: var(--cy-bg-page); }
/* Figma 390 pt 局部刻度(PG-057:改名 --gc-*,不再在页内改写全局 --cy-* token,子组件吃全局刻度)。 */
.gc-page {
  --gc-page-x: 16px; --gc-space-1: 4px; --gc-space-2: 8px; --gc-space-3: 12px; --gc-space-4: 16px;
  --gc-space-5: 24px; --gc-space-6: 32px; --gc-space-8: 48px; --gc-font-page-title: 29px;
  --gc-type-data-xl: 36px; --gc-radius-lg: 16px;
  --gc-font-subtitle: 16px; --gc-font-title: 18px; --gc-font-body: 14px; --gc-font-label: 12px; --gc-font-display: 20px;
  --gc-radius-placeholder: 8px; --gc-radius-placeholder-small: 4px;
  min-height: 100vh; box-sizing: border-box; background: var(--cy-bg-page);
  padding-bottom: calc(36px + var(--cy-safe-bottom));
  font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif; color: var(--cy-color-text-primary);
}
.gc-row--press { opacity: .72; }
.gc-muted { color: var(--cy-color-text-secondary); }
.gc-score-card { margin: 0 var(--gc-page-x); }
.gc-profile-row { display: flex; align-items: center; justify-content: space-between; gap: var(--gc-space-3); min-height: 48px; }
.gc-score-person { display: flex; align-items: center; gap: var(--gc-space-3); flex: 1; min-width: 0; }
.gc-score-avatar { width: var(--gc-space-8); height: var(--gc-space-8); border-radius: var(--cy-radius-pill); flex: none; overflow: hidden; }
.gc-score-avatar__im { display: block; width: 100%; height: 100%; } /* motion-1118 v2:外框管尺寸与占位色,头像在框里淡入 */
.gc-profile-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--gc-font-subtitle); line-height: 38px; font-weight: 700; }
.gc-score-line { display: flex; align-items: center; justify-content: flex-end; gap: var(--gc-space-2); flex: none; }
.gc-score-value { font-size: var(--gc-type-data-xl); line-height: 48px; font-weight: 600; font-variant-numeric: tabular-nums; }
.gc-score-unit { color: var(--cy-color-text-secondary); font-size: var(--gc-font-body); line-height: 22px; }
.gc-score-rank { display: flex; align-items: center; justify-content: space-between; gap: var(--gc-space-3); margin-top: var(--gc-space-4); padding: 0 var(--gc-space-4); height: 48px; border-radius: var(--gc-radius-lg); background: var(--cy-color-bg-elevated); box-sizing: border-box; }
.gc-rank-label { min-width: 0; font-size: var(--gc-font-body); line-height: 22px; }
.gc-score-link { display: flex; align-items: center; gap: var(--gc-space-1); flex: none; color: var(--cy-color-text-secondary); font-size: var(--gc-font-label); line-height: 18px; }
.gc-arrow-icon { width: 16px; height: 16px; flex: none; }
.gc-section { margin: var(--gc-space-6) var(--gc-page-x) 0; }
.gc-section-head { display: flex; align-items: center; justify-content: space-between; gap: var(--gc-space-3); margin-bottom: var(--gc-space-3); min-height: 26px; }
.gc-section-title { font-size: var(--gc-font-title); line-height: 26px; font-weight: 700; }
.gc-section-meta { color: var(--cy-color-text-secondary); font-size: var(--gc-font-label); line-height: 18px; }
.gc-metric-list, .gc-badge-list { overflow: hidden; border-radius: var(--gc-radius-lg); background: var(--cy-color-bg-elevated); }
.gc-metric-row { display: flex; align-items: center; justify-content: space-between; gap: var(--gc-space-3); height: 44px; padding: 0 var(--gc-space-4); }
.gc-metric-label { color: var(--cy-color-text-secondary); font-size: var(--gc-font-body); line-height: 22px; }
.gc-metric-value { display: flex; align-items: center; gap: var(--gc-space-1); font-size: var(--gc-font-display); line-height: 26px; font-weight: 600; font-variant-numeric: tabular-nums; }
.gc-metric-value text + text { color: var(--cy-color-text-secondary); font-size: var(--gc-font-label); line-height: 18px; font-weight: 400; }
.gc-badge-row { display: flex; align-items: center; gap: var(--gc-space-3); min-height: 64px; padding: var(--gc-space-4); box-sizing: border-box; }
.gc-badge-row + .gc-badge-row { border-top: 1rpx solid var(--cy-color-border-subtle); }
.gc-badge-disc { width: 40px; height: 40px; border-radius: var(--cy-radius-md); display: flex; align-items: center; justify-content: center; font-size: var(--gc-font-title); font-weight: 700; overflow: hidden; background: var(--cy-color-bg-surface-subtle); flex: none; }
.gc-badge-icon { width: 38px; height: 38px; border-radius: 50%; }
.gc-badge-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: var(--gc-space-1); }
.gc-badge-name { overflow: hidden; font-size: var(--gc-font-subtitle); font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.gc-badge-moment { color: var(--cy-color-text-secondary); font-size: var(--gc-font-label); line-height: 18px; }
.gc-badge-empty, .gc-badge-loading { display: flex; flex-direction: column; gap: var(--gc-space-3); padding: var(--gc-space-4); border-radius: var(--gc-radius-lg); background: var(--cy-color-bg-elevated); }
.gc-empty-heading { display: flex; align-items: center; gap: var(--gc-space-2); font-size: var(--gc-font-body); line-height: 22px; font-weight: 500; }
.gc-star-icon { width: 20px; height: 20px; flex: none; }
.gc-score-skeleton, .gc-skeleton-label, .gc-skeleton-value, .gc-badge-skeleton { background: var(--cy-color-bg-raised); }
.gc-score-skeleton { width: 92px; height: 42px; border-radius: var(--gc-radius-placeholder); }
.gc-skeleton-label { width: 70px; height: 10px; border-radius: var(--gc-radius-placeholder-small); }
.gc-skeleton-value { width: 48px; height: 10px; border-radius: var(--gc-radius-placeholder-small); }
.gc-badge-loading { color: var(--cy-color-text-secondary); font-size: var(--gc-font-body); line-height: 22px; }
.gc-badge-skeleton { height: 44px; border-radius: var(--gc-radius-placeholder); }
.gc-sr-status { position: fixed; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }

/* 2026-10-23 页面动效(utils/page-motion.js):容器 --pm-* 置 1 时先隐着,再依次浮上来;静止时无过渡,按压反馈不受影响;减少动态效果时从不触发 */
.gc-metric-row { filter: opacity(calc(1 - var(--pm-g, 0))); translate: 0 calc(var(--pm-g, 0) * 31rpx); transition: filter var(--pm-g-d, 0s) ease, translate var(--pm-g-d, 0s) cubic-bezier(.2,.82,.2,1), transform var(--cy-motion-press) var(--cy-ease-out), opacity var(--cy-motion-press) var(--cy-ease-out); transition-delay: calc(var(--pm-g-s, 0) * 0ms), calc(var(--pm-g-s, 0) * 0ms), 0s, 0s; }
.gc-metric-row:nth-child(2) { transition-delay: calc(var(--pm-g-s, 0) * 40ms), calc(var(--pm-g-s, 0) * 40ms), 0s, 0s; }
.gc-metric-row:nth-child(3) { transition-delay: calc(var(--pm-g-s, 0) * 80ms), calc(var(--pm-g-s, 0) * 80ms), 0s, 0s; }
.gc-metric-row:nth-child(4) { transition-delay: calc(var(--pm-g-s, 0) * 120ms), calc(var(--pm-g-s, 0) * 120ms), 0s, 0s; }
.gc-metric-row:nth-child(n+5) { transition-delay: calc(var(--pm-g-s, 0) * 160ms), calc(var(--pm-g-s, 0) * 160ms), 0s, 0s; }
.gc-badge-row { filter: opacity(calc(1 - var(--pm-g, 0))); translate: 0 calc(var(--pm-g, 0) * 31rpx); transition: filter var(--pm-g-d, 0s) ease, translate var(--pm-g-d, 0s) cubic-bezier(.2,.82,.2,1), transform var(--cy-motion-press) var(--cy-ease-out), opacity var(--cy-motion-press) var(--cy-ease-out); transition-delay: calc(var(--pm-g-s, 0) * 160ms), calc(var(--pm-g-s, 0) * 160ms), 0s, 0s; }
.gc-badge-row:nth-child(2) { transition-delay: calc(var(--pm-g-s, 0) * 200ms), calc(var(--pm-g-s, 0) * 200ms), 0s, 0s; }
.gc-badge-row:nth-child(3) { transition-delay: calc(var(--pm-g-s, 0) * 240ms), calc(var(--pm-g-s, 0) * 240ms), 0s, 0s; }
.gc-badge-row:nth-child(4) { transition-delay: calc(var(--pm-g-s, 0) * 280ms), calc(var(--pm-g-s, 0) * 280ms), 0s, 0s; }
.gc-badge-row:nth-child(5) { transition-delay: calc(var(--pm-g-s, 0) * 320ms), calc(var(--pm-g-s, 0) * 320ms), 0s, 0s; }
.gc-badge-row:nth-child(6) { transition-delay: calc(var(--pm-g-s, 0) * 360ms), calc(var(--pm-g-s, 0) * 360ms), 0s, 0s; }
.gc-badge-row:nth-child(7) { transition-delay: calc(var(--pm-g-s, 0) * 400ms), calc(var(--pm-g-s, 0) * 400ms), 0s, 0s; }
.gc-badge-row:nth-child(8) { transition-delay: calc(var(--pm-g-s, 0) * 440ms), calc(var(--pm-g-s, 0) * 440ms), 0s, 0s; }
.gc-badge-row:nth-child(n+9) { transition-delay: calc(var(--pm-g-s, 0) * 480ms), calc(var(--pm-g-s, 0) * 480ms), 0s, 0s; }

/* 细节打磨二期 L1/L5/L7 */
.gc-score-unit,
.gc-rank-label,
.gc-score-link,
.gc-metric-label { font-variant-numeric: tabular-nums; }
/* PG-057:原 cy-page-title 内联 style 收为页面级 class */
.gc-title { --cy-space-5: 0px; --cy-space-2: 16px; --cy-page-title-leading: 38px; --cy-page-title-weight: 700; }
