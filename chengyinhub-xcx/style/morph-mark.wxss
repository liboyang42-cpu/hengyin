/* 成功 morph 标记(qx-u3,ref3「Morph」):按钮收成圆 → 转圈 → 勾弹出 + 一圈脉冲散开。
 * 只走 transition,不新增 keyframes(转圈复用宿主已有的那条旋转,宿主给 .cy-mm__spin 挂 animation)。
 * 结构:<view class="cy-mm cy-mm--{{idle|busy|done}}"><view class="cy-mm__spin"/><view class="cy-mm__check"/></view>
 * 颜色读 --cy-mm-fg(宿主按自己的前景色给),拿不到就跟 currentColor。 */
.cy-mm {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  margin: -20rpx 0 0 -20rpx;
  pointer-events: none;
  color: var(--cy-mm-fg, currentColor);
}
.cy-mm__spin {
  position: absolute;
  left: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 4rpx solid currentColor;
  border-top-color: transparent;
  border-radius: 50%; /* ds-ok */
  opacity: 0;
  transition: opacity var(--cy-motion-fast) var(--cy-ease-out);
}
.cy-mm--busy .cy-mm__spin { opacity: 1; }
/* 勾:右边 + 下边两条边转 45° 成一个 √,从 .3 弹到 1(spring 过冲 = 图标那一下脉冲) */
.cy-mm__check {
  position: absolute;
  left: 13rpx;
  top: 3rpx;
  width: 12rpx;
  height: 24rpx;
  border-right: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  transform: rotate(45deg) scale(.3);
  opacity: 0;
  transition: transform var(--cy-motion-fast) var(--cy-ease-out), opacity var(--cy-motion-fast) var(--cy-ease-out);
}
.cy-mm--done .cy-mm__check {
  transform: rotate(45deg) scale(1);
  opacity: 1;
  transition: transform var(--cy-motion-slow) var(--cy-ease-spring), opacity var(--cy-motion-fast) var(--cy-ease-out);
}
/* 脉冲圈:busy 时已是半透明但缩成 0(看不见);进 done 时一边放大一边淡出 —— 一次性,纯 transition。 */
.cy-mm::after {
  content: '';
  position: absolute;
  left: -16rpx;
  top: -16rpx;
  right: -16rpx;
  bottom: -16rpx;
  border-radius: 50%; /* ds-ok */
  border: 3rpx solid currentColor;
  opacity: 0;
  transform: scale(0);
}
.cy-mm--busy::after { opacity: .5; transform: scale(0); }
.cy-mm--done::after {
  opacity: 0;
  transform: scale(1.6);
  transition: transform var(--cy-motion-celebrate) var(--cy-ease-out), opacity var(--cy-motion-celebrate) var(--cy-ease-accelerate);
}
@media (prefers-reduced-motion: reduce) {
  .cy-mm__spin, .cy-mm__check, .cy-mm--done .cy-mm__check, .cy-mm--done::after { transition: none; }
  .cy-mm::after { display: none; }
}
