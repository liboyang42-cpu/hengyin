/* 2026-10-28 业主 m694:底部动作菜单统一成 Threads 的样子 ——
 * 分组的圆角白行,文字在左、图标在右,行内不写说明;删除这类破坏性动作单独一组、红色。
 * 用法:<view class="tm"> <view class="tm-group"> <view class="tm-row">…</view> </view> </view>
 * 行:<text class="tm-label">编辑</text><cy-icon class="tm-ico" name="edit" size="40" /> */
.tm { display: flex; flex-direction: column; gap: var(--cy-space-3); padding: var(--cy-space-1) 0 var(--cy-space-2); }
.tm-group { border-radius: var(--cy-radius-xl); overflow: hidden; background: var(--cy-color-bg-surface-subtle); }
.tm-row { min-height: 112rpx; display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-3); padding: 0 var(--cy-space-4); border-bottom: 1rpx solid var(--cy-color-border-subtle); font-size: var(--cy-font-body); color: var(--cy-color-text-primary); }
.tm-row:last-child { border-bottom: 0; }
.tm-label { flex: 1; min-width: 0; font-size: var(--cy-font-body); font-weight: 500; }
.tm-ico { flex: none; color: var(--cy-color-text-primary); }
.tm-row--on .tm-label { font-weight: 700; }
.tm-row--danger, .tm-row--danger .tm-ico { color: var(--cy-color-status-danger); }
