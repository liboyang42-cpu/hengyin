/* Figma 105:8 / 101:8 — 343 × 214，随页面宽度等比。 */
.photo-card { position: relative; display: flex; flex-direction: column; box-sizing: border-box; min-height: 428rpx; padding: 28rpx 24rpx; gap: 12rpx; overflow: hidden; border-radius: 44rpx; color: #fff; background: #30383d; }
.photo-card--pressed { opacity: .88; }
.photo-card__cover, .photo-card__gradient { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: inherit; pointer-events: none; }
.photo-card__top, .photo-card__body, .photo-card__space { position: relative; }
.photo-card__top { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; min-height: 56rpx; }
.photo-card__logo { display: flex; align-items: center; justify-content: center; flex: 0 0 56rpx; width: 56rpx; height: 56rpx; border-radius: 14rpx; overflow: hidden; }
.photo-card__logo-image { width: 100%; height: 100%; }
.photo-card__brand { width: 48rpx; height: 42.622rpx; }
.photo-card__space { flex: 1; min-height: 2rpx; }
.photo-card__body { display: flex; flex-direction: column; gap: 8rpx; flex-shrink: 0; width: 100%; }
.photo-card__name { display: block; font-size: 36rpx; font-weight: 700; line-height: 50rpx; overflow-wrap: anywhere; }
.photo-card__detail { display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; line-height: 30rpx; }
.photo-card__detail text { min-width: 0; overflow-wrap: anywhere; }
.photo-card__icon { flex: 0 0 24rpx; width: 24rpx; height: 24rpx; }
.photo-card__bottom { display: flex; align-items: center; gap: 12rpx; min-height: 24rpx; }
.photo-card__fill { flex: 1; min-width: 0; }
.photo-card__arrow { width: 24rpx; height: 24rpx; flex: 0 0 24rpx; margin-left: auto; }
.photo-card__skeleton { display: flex; flex-direction: column; gap: 12rpx; min-height: 372rpx; }
.photo-card__skeleton-logo, .photo-card__skeleton-line { border-radius: 12rpx; background: rgba(255,255,255,.15); }
.photo-card__skeleton-logo { width: 56rpx; height: 56rpx; }
.photo-card__skeleton-line { width: 72%; height: 30rpx; }
.photo-card__skeleton-line.short { width: 44%; }
