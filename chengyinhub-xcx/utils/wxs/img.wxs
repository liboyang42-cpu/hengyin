// 多图 CSV 工具(WXML 不支持 String.split,统一走 WXS)。
// 字段存"url1,url2,url3"逗号分隔;生产主题 imgArr 也有分号分隔的,两种都认 ——
// 只按逗号切时整串分号拼接被当成一张图,OSS 签名校验 403,详情第二屏上半整块黑(实走 A1 真因)。
// 缩略图取首张 first(),画廊取全部 list()。
// 兼容旧单图数据:无逗号时 first 返回原串、list 返回单元素数组。
// 后端 OSS 签名链接历史上存成 http://;真机不加载 http 图片,自有域名统一走 https(与 app.getImgUrl 同口径)。
var OWN_HTTP = getRegExp('^http://(chengyin-oss\\.oss-cn-shanghai\\.aliyuncs\\.com|www\\.chengyinhub\\.com)(/)', 'i');
var secure = function (u) {
  return u.replace(OWN_HTTP, 'https://$1$2');
};
var parts = function (s) {
  return ('' + s).split(';').join(',').split(',');
};
var first = function (s) {
  if (!s) return '';
  return secure(parts(s)[0] || '');
};
var list = function (s) {
  if (!s) return [];
  var arr = parts(s);
  var out = [];
  for (var i = 0; i < arr.length; i++) {
    if (arr[i]) out.push(secure(arr[i]));
  }
  return out;
};
// 单图字段(商家 Logo、店铺封面):只把自有域名 http 换成 https,其余原样(本地 /images/ 路径不动)
var one = function (s) {
  return s ? secure('' + s) : '';
};
// 按显示槽位出图(与 utils/image-url.js sized() 同一规则,tests/unit/image-url.test.js 对拍):
// 本桶 v1 签名原图 → {base}/api/common/img/{档位宽}/{orig|webp}/upload/<文件>?<原签名>;其余原样(只升 https)。
// ctx = 页面 data 里的 imgCtx(utils/image-url.js wxsContext():{ base, dpr, off, skip }),缺省时不改写;
// off = 本会话已熔断,skip[文件名] = 该文件缩略图出过错(binderror 退回原图),两者都不改写。
var WIDTHS = [160, 240, 320, 480, 640, 750, 960, 1080, 1280];
var SLOTS = { hero: 375, card: 343, half: 172, thumb: 96, avatar: 48, preview: 1280 };
var SIGNED_OSS = getRegExp('^https://chengyin-oss\\.oss-cn-shanghai\\.aliyuncs\\.com/upload/([0-9a-f]{32}\\.(?:jpg|jpeg|png))\\?([^#]*)$');
var signedQuery = function (q) {
  var pairs = ('' + q).split('&');
  if (pairs.length !== 3) return false;
  var seen = {};
  for (var i = 0; i < pairs.length; i++) {
    var at = pairs[i].indexOf('=');
    if (at <= 0 || at === pairs[i].length - 1) return false;
    var name = pairs[i].slice(0, at);
    if (name !== 'Expires' && name !== 'OSSAccessKeyId' && name !== 'Signature') return false;
    if (seen[name]) return false;
    seen[name] = true;
  }
  return true;
};
var fit = function (s, ctx, slot, webp) {
  if (!s) return '';
  var url = secure(('' + s).trim());
  if (!ctx || !ctx.base) return url;
  var m = url.match(SIGNED_OSS);
  if (!m || !signedQuery(m[2])) return url;
  if (ctx.off || (ctx.skip && ctx.skip[m[1]])) return url;
  var css = typeof slot === 'number' ? slot : SLOTS[slot];
  if (!(css > 0)) return url;
  var dpr = ctx.dpr > 0 ? ctx.dpr : 2;
  var px = Math.ceil(css * dpr);
  var width = WIDTHS[WIDTHS.length - 1];
  for (var i = 0; i < WIDTHS.length; i++) {
    if (WIDTHS[i] >= px) { width = WIDTHS[i]; break; }
  }
  return ('' + ctx.base).replace(getRegExp('/+$'), '') + '/api/common/img/' + width + '/' + (webp ? 'webp' : 'orig') + '/upload/' + m[1] + '?' + m[2];
};
module.exports = {
  first: first,
  list: list,
  one: one,
  fit: fit
};
