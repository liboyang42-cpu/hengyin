<block wx:for="{{stageKeys}}" wx:key="*this" wx:for-item="stageKey">
<cy-play-stage id="cy-play-stage" data-stage-key="{{stageKey}}" show="{{show}}" back-label="退出"
               calibrate-label="先听一下这儿有多吵" calibrate-ms="2000"
               bind:back="onClose" bind:calibratetick="onSample" bind:calibrated="onCalibrated"
               bind:run="onRun" bind:verdict="onVerdict">
  <!-- 与 quietHold 同一屏骨架,语义反过来:数字是「还差几秒」,过线时整屏烧红。
       不做音量条 —— 条是连续读数,这一屏要的是一句人话:「过线了,别停」。 -->
  <view class="sh {{running && loud ? 'sh--on' : ''}}">
    <view class="g-kicker sh__k">{{kicker}}</view>
    <view class="sh__n g-figure">{{left}}</view>
    <view class="sh__s">{{running ? (loud ? '过线了，保持舒适音量' : '舒适发声，等待本机阈值过线') : '本机相对 PCM 峰值持续过线 ' + seconds + ' 秒'}}</view>

    <view wx:if="{{running && hasFrame}}" class="sh__s">相对本机阈值 {{levelPct}}%（非分贝）</view>
    <view class="sh__s">使用舒适音量，不适请停止，勿持续大声喊叫</view>

    <view class="sh__b {{running || preparing ? 'sh__b--busy' : ''}}" bindtap="onStart"
          aria-role="button" aria-label="开始喊一嗓子" hover-class="sh__b--press" hover-stay-time="80">
      {{preparing ? '准备中' : (running ? '测量中' : '开始')}}
    </view>
  </view>
</cy-play-stage>

</block>
