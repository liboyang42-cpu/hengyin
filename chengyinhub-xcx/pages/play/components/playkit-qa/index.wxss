@import "/pages/play/style/play-surface.wxss";

/* cy-playkit-qa · 三种问答共用一屏(原型真源:模板编辑页 v2 · playkit qa)
 * 配色只有黑白两版:暗版给夜里的店内(默认),亮版给白天的街区。不给自由配色 ——
 * 一放开,同一条路线上的题会出现十种不搭的皮肤。 */
/* 底色由 stage 的皮肤类给(skin-qa / skin-qadark),这里只继承墨色 —— 
   壳自己再写一份 background 的话,改皮肤要改两处,迟早对不上 */
.qa { color: var(--ink); }

/* 题干在顶上(原型 .hdr 落在 84px),答题区在题干和按钮中间那块空里居中 */
.qa__q {
  font-size: var(--cy-play-question-size, var(--cy-type-sheet-title));     /* ds-ok 原型 .phone[data-skin=qa] .hdr .t 24px;内嵌档 = 原型 .card .ct 22px */
  font-weight: var(--pk-q-weight, 800);
  line-height: 1.38;
  letter-spacing: -.01em;
}
/* 题干之外的都在这一块里:一进来它是透明的,一秒后才淡进来。
   ★ flex:1 + 居中 —— 照原型 .qabody(163..719,justify-content:center),
   作答框落在这块空当的正中;不给 flex 的话它会贴着题干,底下空一大片。 */
.qa__body {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  flex: 1;
  min-height: 0;
  gap: 26rpx;                             /* ds-ok 原型 .qabody gap 13px */
  width: 100%;
  opacity: 1;
  transition: opacity .5s ease;
}
.qa--intro .qa__body { opacity: 0; }
.qa__cta--hold { opacity: 0; }        /* 按钮跟着一起等:题还没读完就给按钮,人只会扫按钮 */
.qa--reduced .qa__body { transition: none; }

.qa__media { width: 100%; }
.qa__img {
  width: 100%;
  height: 320rpx;
  border-radius: var(--cy-radius-md);
}
.qa__audio, .qa__lead {
  font-size: var(--cy-type-body);
  line-height: 1.75;
  color: var(--sub);
}
.qa__press { opacity: .88; }

/* 答案是一条**发丝下划线**,不是一个灰盒子。
   盒子会把「写答案」变成「填表格」;一条线只说「这儿写」。 */
.qa__input {
  width: 100%;
  background: transparent;
  border-bottom: 4rpx solid var(--soft);
  /* ⚠️ input 在小程序里**不会**跟着 font-size 长高:默认那点高度装不下 50rpx 的字,
     placeholder 会被从中间切掉(截图才看得出来,不报错)。高度按原型算死:
     25px 的字 + 上下各 13px = 56px。 */
  height: 112rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  font-size: var(--cy-type-sheet-title);
  font-weight: 800;
  text-align: left;
  color: var(--ink);
}
.qa__ph { color: var(--sub); font-weight: 600; }

/* 选项 = 试玩台 .qaopt 的细线文字行(2026-10-23 用户:「回到试玩台的样子」,取代 09-23 的白色整卡)。
   没选是灰字;选中往右让一截、加粗、尾巴亮一个小方块;对 = --ok,错 = --accent,只染字和方块。
   「往右让一截」原型用 padding-left 过渡;这里改成文字那块 translateX —— 布局属性每帧重排(motion ratchet)。 */
.qa__opts {
  width: 100%;
  background: transparent;
}
.qa__opt {
  display: flex;
  align-items: center;
  gap: 28rpx;                             /* ds-ok 原型 .qaopt gap 14px */
  width: 100%;
  padding: 38rpx 4rpx;                    /* ds-ok 原型 .qaopt 19px 2px */
  text-align: left;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--soft);
  font-size: var(--cy-type-card-title);
  font-weight: 500;
  line-height: 1.4;
  color: var(--sub);
  transition: color .18s ease, opacity .22s ease;
}
.qa__opt--first { border-top: 1rpx solid var(--soft); }
.qa__opt::after {
  content: '';
  flex: none;
  margin-left: auto;
  width: 14rpx; height: 14rpx;            /* ds-ok 原型 .qaopt .tail 7px */
  border-radius: 2rpx;                    /* ds-ok 同上 */
  background: transparent;
  transition: background .18s ease;
}
.qa__opt-main { display: flex; align-items: center; gap: 28rpx; flex: 1; min-width: 0; transition: transform .18s ease; }
.qa__tail { display: none; }
.qa__opt.is-on    { color: var(--ink); font-weight: 700; background: var(--soft); } /* 只变字重看不出选中(实走 A21) */
.qa__opt.is-right { color: var(--ok); font-weight: 700; }
.qa__opt.is-wrong { color: var(--accent); font-weight: 700; }
.qa__opt.is-on .qa__opt-main,
.qa__opt.is-right .qa__opt-main,
.qa__opt.is-wrong .qa__opt-main { transform: translateX(20rpx); }   /* ds-ok 原型 .qaopt.on padding-left 10px */
.qa__opt.is-on::after    { background: var(--ink); }
.qa__opt.is-right::after { background: var(--ok); }
.qa__opt.is-wrong::after { background: var(--accent); }
.qa__opt.is-dim   { color: var(--soft); }
.qa__opt-k {
  flex: none;
  width: 28rpx;                           /* ds-ok 原型 .qaopt .k 14px */
  font-family: var(--cy-font-numeric);
  font-size: var(--cy-type-label);
  font-weight: 600;
  color: var(--sub);
}
.qa__opt.is-on .qa__opt-k,
.qa__opt.is-right .qa__opt-k,
.qa__opt.is-wrong .qa__opt-k { color: inherit; }
/* 选项文案占满剩下的宽度 */
.qa__opt-t { flex: 1; min-width: 0; }
/* 交卷后的「你的选择 / 正确答案」只是小标签,不能跟选项文案平分宽度(原先复用 .qa__opt-t,整行被挤成三栏) */
.qa__opt-tag { flex: none; font-size: var(--cy-type-label); font-weight: 600; }
.qa__shot-lead {
  font-size: var(--cy-type-display);
  font-weight: 900;
  line-height: 1.45;
}
.qa__shot-note {
  font-size: var(--cy-type-body);
  line-height: 1.75;
  color: var(--sub);
}

/* 反馈是一块实心的话,不是一行浮字。浮字会和题干混成一段,读的人分不清哪句在回答他 */
/* 反馈块是「刚冒出来的一句」,不是本来就在那儿的一块 —— 原型 qafb .26s */
/* 同 pricepair:不写 both,动画没跑起来也不能把这块反馈藏没了 */
.qa__fb-enter { animation: qa-fb .26s cubic-bezier(.2, .8, .2, 1); }
@keyframes qa-fb { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: none; } }
.qa--reduced .qa__fb-enter { animation: none; }

.qa__fb {
  flex: none;
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx;                         /* ds-ok 原型 .qafb 15px */
  border-radius: 28rpx;                   /* ds-ok 原型 14px */
  background: var(--soft);
  font-size: var(--cy-type-body);
  line-height: 1.7;
  color: var(--ink);
  text-align: left;
}
.qa__fb-h {
  margin-bottom: 8rpx;                    /* ds-ok 原型 4px */
  font-size: var(--cy-type-label);
  font-weight: 800;
  letter-spacing: 1rpx;                   /* ds-ok 原型 .04em */
  color: var(--sub);
}

/* 时间到:题面、选项、反馈、按钮一起烧穿(原型 burnaway 1.5s)。
   烧的是纸,不是淡出 —— 所以走 sepia + brightness 往焦黄里推,再糊掉。 */
.qa--burning .qa__q,
.qa--burning .qa__body,
.qa__cta--burn { animation: qa-burn 1.5s ease-in forwards; }
@keyframes qa-burn {
  0%   { opacity: 1; filter: none; }
  22%  { opacity: 1; filter: brightness(1.25) sepia(.45) saturate(3) hue-rotate(-12deg); }
  55%  { opacity: .85; filter: blur(1rpx) brightness(1.6) sepia(.85) saturate(6) hue-rotate(-18deg); }
  80%  { opacity: .45; filter: blur(6rpx) brightness(1.9) sepia(1) saturate(7) hue-rotate(-20deg); }
  100% { opacity: 0; filter: blur(18rpx) brightness(2.1) sepia(1) saturate(8) hue-rotate(-22deg); }
}
.qa--reduced.qa--burning .qa__q,
.qa--reduced.qa--burning .qa__body { animation: none; }

/* 多选的服务端回执条:整体通过绿、没通过红 —— 服务端不给逐项对错,这一条就是全部结论 */
.qa__fb--ok { background: var(--cy-color-status-success-soft); color: var(--cy-color-status-success); }
.qa__fb--no { padding:var(--cy-space-2) 0; background:transparent; color:var(--cy-color-status-danger); }

/* P-10 打字题答错:下划线变红,反馈条用同一套红;下一次输入即清。只做颜色过渡,不抖动 */
.qa__input { transition: border-color .2s ease; }
.qa__input--wrong { border-bottom-color: var(--cy-color-status-danger); }

/* ===== 图片选项(l-kits 2026-11-10,照 proto/game page.css .imgopts--bare / .imgopt,px × 2 = rpx) =====
 * 没有底、没有卡:图就是选项。字母 + 文案压在图下沿的渐变上(图上的字永远白,不随外观翻转);
 * 描边是一层 ::after 盖在图上(opacity / 颜色切换,不过渡 box-shadow);选中上浮 6rpx、图放大 1.04;
 * 对 = 描边绿(--ok),错 = 描边红(--accent)+ 图压暗;其余变淡。圆角 / 切角读主题外观 --lk-r / --lk-cut,没有外观时落回 DS 圆角。 */
.qa__opts--pic { display: flex; flex-wrap: wrap; justify-content: space-between; row-gap: 24rpx; }  /* ds-ok 原型 gap 12px */
.qa__pic {
  position: relative;
  width: calc(50% - 12rpx);               /* ds-ok 两列,列距 24rpx */
  aspect-ratio: 1 / 1.1;                  /* ds-ok 原型 .imgopts--bare .imgopt */
  border-radius: var(--lk-r, var(--cy-radius-lg));
  clip-path: var(--lk-cut, none);
  overflow: hidden;
  background: var(--soft);
  box-shadow: 0 28rpx 60rpx rgba(0, 0, 0, .35);   /* ds-ok 原型 0 14px 30px */
  transition: transform var(--cy-motion-standard) var(--cy-ease-spring-soft, cubic-bezier(.34, 1.3, .64, 1)), opacity var(--cy-motion-standard) ease;
}
.qa__pic-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transition: transform .5s ease; }   /* ds-ok 原型 img .5s */
.qa__pic-img--none { display: flex; align-items: center; justify-content: center; font-family: var(--cy-font-numeric); font-size: var(--cy-type-display); font-weight: 800; color: var(--sub); }
.qa__pic-ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border: 4rpx solid var(--ink); border-radius: inherit; opacity: 0; pointer-events: none; transition: opacity var(--cy-motion-fast) ease; }
.qa__pic-lb {
  position: absolute; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; gap: 16rpx;
  padding: 56rpx 20rpx 20rpx;              /* ds-ok 原型 28px 10px 10px */
  background: linear-gradient(transparent, rgba(0, 0, 0, .72));   /* ds-ok 图上的渐变底 */
  color: #fff;                             /* ds-ok 图上的字永远白 */
  font-size: var(--cy-type-body);
  font-weight: 600;
  line-height: 1.3;
}
.qa__pic-k {
  flex: none; width: 40rpx; height: 40rpx; border-radius: 50%;   /* ds-ok 原型 20px 圆 */
  display: flex; align-items: center; justify-content: center;
  background: rgba(255, 255, 255, .22);    /* ds-ok 图上的字母圆 */
  font-family: var(--cy-font-numeric); font-size: var(--cy-type-label); font-weight: 700;
}
.qa__pic-t { flex: 1; min-width: 0; }
.qa__pic-tag {
  position: absolute; left: 16rpx; top: 16rpx;
  padding: 6rpx 14rpx; border-radius: var(--cy-radius-pill);
  background: rgba(0, 0, 0, .55); color: #fff;   /* ds-ok 图上的角标 */
  font-size: var(--cy-type-label); font-weight: 600;
}
.qa__pic.is-on { transform: translateY(-6rpx); }                  /* ds-ok 原型 -3px */
.qa__pic.is-on .qa__pic-ring { opacity: 1; }
.qa__pic.is-on .qa__pic-img { transform: scale(1.04); }
.qa__pic.is-right .qa__pic-ring { opacity: 1; border-color: var(--ok); }
.qa__pic.is-wrong .qa__pic-ring { opacity: 1; border-color: var(--accent); }
.qa__pic.is-wrong { opacity: .75; }
.qa__pic.is-dim { opacity: .4; }
.qa--reduced .qa__pic, .qa--reduced .qa__pic-img, .qa--reduced .qa__pic-ring { transition: none; }
.qa--reduced .qa__pic.is-on { transform: none; }
.qa--reduced .qa__pic.is-on .qa__pic-img { transform: none; }
