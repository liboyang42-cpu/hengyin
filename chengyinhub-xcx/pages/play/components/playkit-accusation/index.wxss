@import "/pages/play/style/play-surface.wxss";

/* cy-playkit-accusation · 指认结案(UG-03/04,r2 改版)。问答暗版皮肤。
   确认层的底色、字色走玩家弹层 token(--cy-comp-sheet-player-*),不在这里写灰。 */
.ac { color: var(--ink); align-items: stretch; text-align: center; }
.ac__q { font-size: var(--cy-type-sheet-title); font-weight: 800; line-height: 1.35; text-align: center; }
.ac__board { width: 100%; height: 300rpx; margin-top: var(--cy-space-4); border-radius: var(--cy-radius-lg); }
.ac__intro { margin-top: var(--cy-space-3); font-size: var(--cy-type-body); line-height: 1.7; color: var(--sub); text-align: center; }

/* 人物卡:3 人一排(4 人 2×2);选中一位后其余变淡 */
.ac__grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 20rpx; margin-top: var(--cy-space-5); }
.ac__card {
  box-sizing: border-box;
  padding: 20rpx 12rpx 24rpx;
  border-radius: var(--cy-radius-lg);
  background: var(--soft);
  text-align: center;
  transition: opacity .2s ease, transform .2s ease, box-shadow .2s ease;
}
.ac__grid--3 .ac__card { width: calc((100% - 40rpx) / 3); }
.ac__grid--2 .ac__card { width: calc((100% - 20rpx) / 2); }
.ac__grid.has-pick .ac__card { opacity: .45; }
.ac__grid.has-pick .ac__card.is-pick { opacity: 1; transform: translateY(-6rpx); box-shadow: inset 0 0 0 4rpx var(--ink); }
.ac__ava { position: relative; width: 150rpx; height: 150rpx; margin: 0 auto; }
.ac__grid--2 .ac__ava { width: 200rpx; height: 200rpx; }
.ac__ava-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 50%; background: var(--bg); }
.ac__ava-img--empty { display: flex; align-items: center; justify-content: center; font-size: var(--cy-type-sheet-title); font-weight: 800; color: var(--sub); }
.ac__check {
  position: absolute; right: 0; bottom: 0;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--ink); color: var(--bg);
}
.ac__name { margin-top: 16rpx; font-size: var(--cy-type-body); font-weight: 800; line-height: 1.3; }
.ac__id { margin-top: 4rpx; font-size: var(--cy-type-label); color: var(--sub); }
.ac__press { opacity: .88; }
.ac__file { margin-top: var(--cy-space-4); padding: var(--cy-space-3) var(--cy-space-4); border-radius: var(--cy-radius-lg); background: var(--soft); text-align: left; }
.ac__file-row { padding: 10rpx 0; font-size: var(--cy-type-body); line-height: 1.6; }
.ac__fb { margin-top: var(--cy-space-4); padding: var(--cy-space-3) var(--cy-space-4); border-radius: var(--cy-radius-pill);
  background: var(--cy-color-status-danger-soft); color: var(--accent); font-size: var(--cy-type-body); font-weight: 700; }

/* 结论屏:动图 + 大字结论 + 结局段,整屏居中 */
.ac__end { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-bottom: 160rpx; }  /* ds-ok 让出底部按钮 */
.ac--inline .ac__end { padding-bottom: 0; }
.ac__anim { width: 240rpx; height: 240rpx; }
.ac__verdict { margin-top: var(--cy-space-4); font-size: var(--cy-type-page-title); font-weight: 900; letter-spacing: 4rpx; color: var(--ink); }
.ac__verdict--FAILED { color: var(--accent); }
.ac__verdict--PENDING { font-size: var(--cy-type-sheet-title); color: var(--sub); }
.ac__end-text { margin-top: var(--cy-space-4); max-width: 600rpx; font-size: var(--cy-type-card-title); line-height: 1.7; color: var(--ink); text-align: center; }
.ac__end-img { width: 100%; height: 320rpx; margin-top: var(--cy-space-4); border-radius: var(--cy-radius-lg); }

/* 底栏:一枚主按钮,写明指认谁 */
.ac__bar {
  position: var(--pk-btn-pos, absolute);
  left: var(--pk-btn-x, var(--cy-page-x));
  right: var(--pk-btn-x, var(--cy-page-x));
  bottom: var(--pk-btn-bottom, calc(env(safe-area-inset-bottom) + 60rpx));
  margin-top: var(--pk-btn-mt, 0);
  z-index: 5;
}
.ac__bar .ac__go { position: static; }
.ac--reduced .ac__card { transition: none; }
/* 整屏档:人物多、证词长时本列自己滚,底部按钮不压住证词 */
.ac--full { overflow-y: auto; padding-bottom: calc(env(safe-area-inset-bottom) + 200rpx); }
.ac__q, .ac__board, .ac__intro, .ac__grid, .ac__file, .ac__fb { flex-shrink: 0; }
.ac__bar--full { left: 0; right: 0; bottom: 0; padding: 24rpx 40rpx calc(env(safe-area-inset-bottom) + 60rpx); background: var(--bg); }

/* 确认层(UG-03 二次确认):底部弹层,关闭在右上角 */
.ac-cf { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 30; }
.ac-cf__mask { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: var(--cy-color-overlay); }
.ac-cf__panel {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 56rpx 40rpx calc(env(safe-area-inset-bottom) + 48rpx);
  border-radius: var(--cy-comp-sheet-radius) var(--cy-comp-sheet-radius) 0 0;
  background: var(--cy-comp-sheet-player-bg);
  box-shadow: inset 0 2rpx 0 var(--cy-comp-sheet-player-border), 0 -24rpx 64rpx rgba(0, 0, 0, .5);   /* ds-ok 顶边亮线 + 上投影,把弹层从暗页上托起来 */
  color: var(--cy-comp-sheet-player-text);
  display: flex; flex-direction: column; align-items: center; text-align: center;
  animation: pk-in .3s cubic-bezier(.2, .9, .3, 1) both;   /* ds-ok 复用玩法屏入场关键帧 */
}
.ac--reduced ~ .ac-cf .ac-cf__panel { animation: none; }
.ac-cf__close { position: absolute; top: 16rpx; right: 16rpx; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center;
  color: var(--cy-comp-sheet-player-close-fg); }
.ac-cf__close::before { content: ''; position: absolute; width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--cy-comp-sheet-player-close-bg); }
.ac-cf__glyph { position: relative; display: flex; }
.ac-cf__ava { position: relative; width: 200rpx; height: 200rpx; }
.ac-cf__title { margin-top: var(--cy-space-4); font-size: var(--cy-type-sheet-title); font-weight: 800; line-height: 1.35; }
.ac-cf__id { margin-top: 8rpx; font-size: var(--cy-type-body); color: var(--cy-comp-sheet-player-text-secondary); }
.ac-cf__btn {
  align-self: stretch;
  margin-top: var(--cy-space-6);
  height: 112rpx; line-height: 112rpx;
  border-radius: 56rpx;                    /* ds-ok 与玩法屏主按钮同一胶囊 */
  background: var(--cy-comp-sheet-player-text); color: var(--cy-comp-sheet-player-bg);
  font-size: var(--cy-type-button); font-weight: 800;
}
