/* 动效 v2 时刻 1(章节开始)与时刻 3(通关)。规格 = docs/delivery/questo-ui-20261109/proto/motion-v2;390 宽稿 px × 1.923 = rpx。
   没有关键帧规则:动画走组件 animate() 与这里的 transition;外观色读 --lk-*,没有外观时回落原型深色。 */
.cm { --ma: var(--lk-a, #E9E2D0); --ma-rgb: var(--lk-a-rgb, 233,226,208); --mb-rgb: var(--lk-b-rgb, 154,160,170); --mi: var(--lk-ink, #F5F5F2); --mi-rgb: var(--lk-ink-rgb, 245,245,242); --mg: var(--lk-bg, #1F1F21);
  --m-nav: cubic-bezier(.32,.72,0,1); --m-spring: cubic-bezier(.34,1.56,.64,1); --m-out: cubic-bezier(.16,1,.3,1);
  position: absolute; inset: 0; overflow: hidden; color: var(--mi); line-height: 1.5; } /* ds-ok 回落原型定值 */
.cm__amb { position: absolute; inset: 0; background: radial-gradient(120% 70% at 50% 38%, rgba(var(--ma-rgb), .12), rgba(var(--ma-rgb), 0) 70%), var(--mg); }
.cm__stage { position: absolute; inset: 0; transform: translateY(var(--dy, 0rpx)); }
.cm__fade { opacity: 0; transform: translateY(27rpx); transition: opacity .5s var(--m-out), transform .6s var(--m-out); }
.cm__fade.is-in { opacity: 1; transform: none; }
.cm.is-skip .cm__fade, .cm.is-skip .cm__rd, .cm.is-skip .cm__dg, .cm.is-skip .cm__w, .cm--reduced .cm__fade, .cm--reduced .cm__rd, .cm--reduced .cm__dg, .cm--reduced .cm__w { transition: none !important; }
.cm__btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; height: 100rpx; margin: 0; padding: 0; border: 0; border-radius: 50rpx; font-size: 31rpx; line-height: 100rpx; font-weight: 600; }
.cm__btn::after { border: 0; }
.cm__btn--pri { background: var(--mi); color: var(--mg); }
.cm__btn--acc { background: var(--ma); color: var(--mg); }
.cm__btn--ghost { background: rgba(var(--mi-rgb), .08); color: var(--mi); }
.cm-pressed { opacity: .8; }

/* ---------- 时刻 1:章节开始 ---------- */
.cm__seal { position: absolute; left: 50%; top: 576.92rpx; width: 423.08rpx; height: 423.08rpx; margin: -211.54rpx 0 0 -211.54rpx; }
.cm__dot { position: absolute; left: 50%; top: 50%; width: 15.38rpx; height: 15.38rpx; margin: -7.69rpx; border-radius: 50%; background: var(--ma); box-shadow: 0 0 46.15rpx 11.54rpx var(--ma); transform: scale(0); }
.cm__dot.is-hold { transform: scale(1); }
.cm__dot.is-gone { opacity: 0; }
.cm__ring { position: absolute; inset: 0; border-radius: 50%; }
.cm__rd { position: absolute; left: 50%; top: 50%; width: 13.46rpx; height: 13.46rpx; margin: -6.73rpx; border-radius: 50%; background: var(--ma); opacity: 0; transform: rotate(var(--a, 0deg)) translateY(0rpx); transition: opacity .7s var(--m-nav), transform .7s var(--m-nav); }
.cm__rd.is-on { opacity: 1; transform: rotate(var(--a, 0deg)) translateY(-200rpx); }
.cm__num { position: absolute; inset: 0; }
.cm__dg { position: absolute; border-radius: 50%; background: var(--mi); opacity: 0; transform: scale(.2); transition: opacity .38s var(--m-spring), transform .38s var(--m-spring); }
.cm__dg.is-on { opacity: 1; transform: scale(1); }
.cm__halo { position: absolute; inset: -115.38rpx; border-radius: 50%; background: radial-gradient(circle, rgba(var(--ma-rgb), .38), rgba(var(--ma-rgb), 0) 62%); opacity: 0; transform: scale(.6); }
.cm__halo.is-on { opacity: .7; transform: scale(1); }
.cm__rays { position: absolute; inset: -269.23rpx; opacity: 0; background: repeating-conic-gradient(from 0deg, rgba(var(--ma-rgb), .16) 0deg 4deg, rgba(var(--ma-rgb), 0) 4deg 18deg); -webkit-mask: radial-gradient(circle, #000 20%, transparent 62%); mask: radial-gradient(circle, #000 20%, transparent 62%); } /* ds-ok 遮罩取样,不上屏 */
.cm__rays.is-on { opacity: .35; transform: rotate(40deg); }
.cm__col { position: absolute; left: 0; right: 0; top: 903.85rpx; display: flex; flex-direction: column; align-items: center; }
.cm__kick { box-sizing: border-box; width: 100%; padding-left: .24em; text-align: center; font-size: 23.08rpx; line-height: 34.62rpx; letter-spacing: .24em; color: rgba(var(--mi-rgb), .6); }
.cm__title { box-sizing: border-box; width: 100%; margin-top: 11.54rpx; padding: 0 46.15rpx; min-height: 76.92rpx; text-align: center; font-size: 53.85rpx; line-height: 80.77rpx; font-weight: 700; letter-spacing: .02em; }
.cm__w { display: inline-block; white-space: normal; opacity: 0; filter: blur(11.54rpx); transition: opacity .5s ease, filter .5s ease; }
.cm__w.is-in { opacity: 1; filter: none; }
.cm__stats { display: flex; justify-content: center; gap: 92.31rpx; margin-top: 46.15rpx; }
.cm__stat { display: flex; flex-direction: column; align-items: center; text-align: center; }
.cm__sv { display: block; font-size: 50rpx; line-height: 75rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.cm__sk { display: block; font-size: 23.08rpx; line-height: 40.38rpx; color: rgba(var(--mi-rgb), .5); }
.cm__cta { position: absolute; left: 46.15rpx; right: 46.15rpx; bottom: 80.77rpx; }

/* ---------- 时刻 3:通关 ---------- */
.cm__flash { position: absolute; inset: 0; background: radial-gradient(circle at 50% 39%, #fff, rgba(var(--ma-rgb), .6) 30%, rgba(var(--ma-rgb), 0) 60%); opacity: 0; z-index: 5; pointer-events: none; } /* ds-ok 闪光白 */
.cm__pts { position: absolute; left: 50%; top: 634.62rpx; width: 0; height: 0; }
.cm__pt { position: absolute; left: 0; top: 0; width: 5.77rpx; height: 5.77rpx; margin: -2.88rpx; border-radius: 50%; background: rgba(var(--mb-rgb), 1); opacity: 0; }
.cm__frays { position: absolute; left: 50%; top: 596.15rpx; width: 1076.92rpx; height: 1076.92rpx; margin: -538.46rpx; opacity: 0; background: repeating-conic-gradient(rgba(var(--ma-rgb), .22) 0deg 6deg, rgba(var(--ma-rgb), 0) 6deg 20deg); -webkit-mask: radial-gradient(circle, #000 12%, transparent 58%); mask: radial-gradient(circle, #000 12%, transparent 58%); } /* ds-ok 遮罩取样,不上屏 */
.cm__frays.is-on { opacity: 1; transform: rotate(30deg); }
.cm__ringx { position: absolute; left: 50%; top: 634.62rpx; width: 576.92rpx; height: 153.85rpx; margin: -76.92rpx 0 0 -288.46rpx; box-sizing: border-box; border-radius: 50%; border: 4rpx solid var(--ma); opacity: 0; transform: scale(.3); }
.cm__ringx::after { content: ""; position: absolute; inset: -4rpx; border-radius: 50%; border: 4rpx solid rgba(255, 255, 255, .2); } /* ds-ok 与白按 80/20 混色的叠层 */
.cm__core { position: absolute; left: 50%; top: 634.62rpx; width: 288.46rpx; height: 288.46rpx; margin: -144.23rpx; }
.cm__orb { position: absolute; inset: 0; border-radius: 84.62rpx; opacity: 0; transform: rotate(45deg) scale(.4); background: linear-gradient(145deg, rgba(var(--mb-rgb), .7), rgba(var(--ma-rgb), 1)), #fff; box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .5), 0 38.46rpx 115.38rpx rgba(var(--ma-rgb), .5); } /* ds-ok 原型光感 */
.cm__orb::after { content: ""; position: absolute; inset: 16%; border-radius: 57.69rpx; border: 4rpx solid rgba(255, 255, 255, .75); } /* ds-ok 原型光感 */
.cm__orb.is-hold { opacity: 1; transform: rotate(405deg) scale(1.1); }
.cm__orb.is-gone { opacity: 0; transform: rotate(405deg) scale(1.6); }
.cm__medal { position: absolute; left: 50%; top: 596.15rpx; width: 253.85rpx; height: 253.85rpx; margin: -126.92rpx; border-radius: 50%; opacity: 0; transform: translateY(76.92rpx) scale(.7);
  background: radial-gradient(circle at 35% 30%, #fff 0%, rgba(var(--mb-rgb), .8) 25%, rgba(var(--ma-rgb), 1) 70%, rgba(var(--ma-rgb), .6) 100%), radial-gradient(circle at 35% 30%, #fff 0%, #fff 25%, #000 100%);
  box-shadow: 0 0 0 11.54rpx rgba(255, 255, 255, .12), 0 46.15rpx 115.38rpx rgba(var(--ma-rgb), .45); } /* ds-ok 原型勋章光感 */
.cm__medal::after { content: ""; position: absolute; inset: 26%; border-radius: 50%; border: 5.77rpx solid rgba(255, 255, 255, .85); border-left-color: transparent; transform: rotate(-30deg); } /* ds-ok 原型勋章光感 */
.cm__medal.is-on { opacity: 1; transform: none; }
.cm__glow { position: absolute; inset: 0; border-radius: 50%; background: #fff; opacity: 0; } /* ds-ok 亮度呼吸叠层 */
.cm__fcol { position: absolute; left: 0; right: 0; top: 819.23rpx; display: flex; flex-direction: column; align-items: center; }
.cm__fkick { box-sizing: border-box; width: 100%; padding-left: .24em; text-align: center; font-size: 23.08rpx; line-height: 34.62rpx; letter-spacing: .24em; color: rgba(var(--mi-rgb), .6); }
.cm__ttl { box-sizing: border-box; width: 100%; margin-top: 15.38rpx; padding: 0 46.15rpx; text-align: center; font-size: 50rpx; line-height: 75rpx; font-weight: 700; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.cm__row { box-sizing: border-box; width: 100%; margin-top: 55.77rpx; padding: 0 46.15rpx; display: grid; gap: 19.23rpx; }
.cm__tile { text-align: center; border-radius: 34.62rpx; padding: 26.92rpx 0 23.08rpx; border: 3rpx solid rgba(var(--ma-rgb), .55); background: rgba(var(--ma-rgb), .1); }
.cm__tv { display: block; font-size: 42.31rpx; line-height: 63.46rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.cm__tk { display: block; font-size: 23.08rpx; line-height: 34.62rpx; color: rgba(var(--mi-rgb), .5); }
.cm__acts { position: absolute; left: 46.15rpx; right: 46.15rpx; bottom: 80.77rpx; display: grid; gap: 19.23rpx; }
.cm__two { display: grid; grid-template-columns: 1fr 1fr; gap: 19.23rpx; }
.cm__acts.cm__fade { pointer-events: none; }
.cm__acts.is-in { pointer-events: auto; }
@media (prefers-reduced-motion: reduce) { .cm__fade, .cm__rd, .cm__dg, .cm__w { transition: none; } }
