@import "/pages/play/style/play-surface.wxss";

/* cy-playkit-journey-check · R14 旅程检定(题面/结果/结算三态共用一屏)。
   2026-10-23 主人定稿(城瘾 D20 与盲品试玩原型):三维二十面骰、按住摇骰、难度线。
   皮肤与台面语言都来自 play-surface(--ink/--sub/--soft 由 stage 的 skin 传下来),
   这里只画检定自己那几块。 */
.jc { overflow-y: auto; }

.jc__tiers { margin-top: var(--cy-space-3); display: flex; justify-content: center; gap: var(--cy-space-2); }
.jc__tier {
  display: inline-block;                      /* text 默认 inline,入场的 transform 不生效 */
  padding: 10rpx 22rpx;                       /* ds-ok 原型 .tiers span 5px 11px */
  border-radius: var(--cy-radius-pill);
  background: var(--soft);
  color: var(--sub);
  font-size: var(--cy-type-label);
}
.jc__tier.is-on { color: var(--ink); font-weight: 700; box-shadow: inset 0 0 0 2rpx var(--ink); }
.jc__tags { margin-top: var(--cy-space-3); display: flex; justify-content: center; gap: var(--cy-space-2); }
.jc__tag {
  padding: var(--cy-space-1) var(--cy-space-3);
  box-sizing: border-box;
  border-radius: var(--cy-radius-pill);
  font-size: var(--cy-type-label);
  font-weight: 700;
}
.jc__tag--good { background: rgba(62, 207, 142, .18); color: var(--ok); } /* ds-ok 优势:成功色的软底,与 skin 的 --ok 同源 */
.jc__tag--bad { background: var(--cy-color-status-danger-soft); color: var(--accent); }

/* 难度线:1–20 一条,竖线是这一档的线,白条涨到点数那里;过线绿、差一点红 */
.jc__track { width: 100%; margin-top: var(--cy-space-6); }
.jc__bar { position: relative; height: 20rpx; border-radius: 10rpx; background: var(--soft); }
.jc__fill {
  position: absolute; left: 0; top: 0; bottom: 0; width: 100%;
  border-radius: 10rpx;
  background: var(--ink);
  transform-origin: 0 50%;
  transition: transform .9s cubic-bezier(.2, .8, .2, 1), background .3s ease;
}
.jc__fill.is-ok { background: var(--ok); }
.jc__fill.is-no { background: var(--accent); }
.jc__dc { position: absolute; top: -16rpx; bottom: -16rpx; width: 4rpx; margin-left: -2rpx; background: var(--ink); transition: background .3s ease; }
.jc__dc.is-ok { background: var(--ok); }
.jc__dc.is-no { background: var(--accent); }
.jc__dc-n {
  position: absolute; top: -48rpx; left: 50%; transform: translateX(-50%);
  font-family: var(--cy-font-numeric); font-size: var(--cy-type-body); font-weight: 800; color: var(--ink);
}
.jc__ticks { display: flex; justify-content: space-between; margin-top: var(--cy-space-2); font-family: var(--cy-font-numeric); font-size: var(--cy-type-caption); color: var(--sub); }

/* 骰子台:与「D20 加值」同一颗三维骰,画布由 d20-renderer 画;按住时骰子自己越转越快、发颤 */
.jc__stage { position: relative; width: 100%; height: 440rpx; flex: none; }
.jc__canvas { width: 100%; height: 100%; }
.jc__error { position: absolute; left: 0; right: 0; bottom: 0; font-size: var(--cy-type-caption); color: var(--sub); }

.jc__mods { margin-top: var(--cy-space-3); width: 100%; text-align: left; }
.jc__mods-k {
  font-size: var(--cy-type-caption);
  color: var(--sub);
  margin-bottom: var(--cy-space-1);
}
.jc__mod {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--cy-space-2);
  padding: var(--cy-space-2) 0;
  border-bottom: 2rpx solid var(--soft);
}
.jc__mod-l { font-size: var(--cy-type-body); color: var(--sub); }
.jc__mod-v { flex: none; font-size: var(--cy-type-label); color: var(--sub); }
.jc__mod.is-held .jc__mod-l { color: var(--ink); }
.jc__mod.is-held .jc__mod-v { color: var(--ok); font-weight: 700; }

.jc__total { min-height: 200rpx; display: flex; flex-direction: column; align-items: center; gap: var(--cy-space-1); }
.jc__total-n {
  font-family: var(--cy-font-numeric);
  font-size: var(--cy-type-display);
  font-style: italic;
  font-weight: 900;
  line-height: 1;
  color: var(--ink);
}
/* 点数落地。这一条是检定屏的专属动效 —— D20 的张力全在「掷→停→读数」,
   共用的 pk-in 表达不出「停下」。时长与缓动逐值取原型的
   popcard(.5s cubic-bezier(.2,1.2,.3,1)):带回弹的落定,不自创曲线。 */
.jc__die { animation: jc-die .5s cubic-bezier(.2, 1.2, .3, 1) both; }       /* ds-ok 逐值照原型 popcard */
.pk--reduced .jc__die { animation: none; }
.pk--reset .jc__die { animation: none; }
@keyframes jc-die {
  from { transform: translateY(-40rpx) scale(1.18); opacity: 0; }  /* ds-ok */
  to { transform: none; opacity: 1; }
}
.jc__nat { font-size: var(--cy-type-label); font-weight: 700; color: var(--sub); }
.jc__nat.is-gold { color: #F2C14E; }          /* ds-ok 天然 20 的金,与骰子镀金同色 */
.jc__total-s { font-size: var(--cy-type-label); color: var(--sub); }
.jc__verdict {
  margin-top: var(--cy-space-2);
  font-size: var(--cy-type-section-title);
  font-weight: 700;
}
.jc__verdict--big { margin-top: var(--cy-space-4); font-size: var(--cy-type-sheet-title); font-weight: 900; }
.jc__verdict--ok { color: var(--ok); }
.jc__verdict--no { color: var(--accent); }
.jc__applied { margin-top: var(--cy-space-4); width: 100%; text-align: left; }
.jc__hint { margin-top: var(--cy-space-3); font-size: var(--cy-type-caption); color: var(--sub); }
.jc__copy {
  margin-top: var(--cy-space-4);
  font-size: var(--cy-type-body);
  line-height: 1.8;
  color: var(--ink);
}
.jc__cost { margin-top: var(--cy-space-2); font-size: var(--cy-type-label); color: var(--accent); }
.jc__vitals {
  margin-top: var(--cy-space-3);
  display: flex;
  justify-content: center;
  gap: var(--cy-space-4);
  font-size: var(--cy-type-label);
  color: var(--sub);
}
.jc__exhaust { margin-top: var(--cy-space-2); font-size: var(--cy-type-caption); color: var(--accent); }

/* 按住摇骰:按钮里一条蓄力条从左往右填 */
.jc__roll { overflow: hidden; }
.jc__charge { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background: rgba(0, 0, 0, .14); transform-origin: 0 50%; } /* ds-ok 白按钮上的蓄力条 */
.jc__roll-t { position: relative; }

/* 结果屏底部两条:重掷是次级,结算是主键。整排跟 g-btn 同一套定位变量 ——
   整屏贴底、故事流里跟在内容后面(之前各自绝对定位,内嵌时结算被挤出屏幕) */
.jc__acts {
  position: var(--pk-btn-pos, absolute);
  left: var(--pk-btn-x, var(--cy-page-x));
  right: var(--pk-btn-x, var(--cy-page-x));
  bottom: var(--pk-btn-bottom, calc(env(safe-area-inset-bottom) + 60rpx));
  margin-top: var(--pk-btn-mt, 0);
  z-index: 5;
  display: flex;
  gap: var(--cy-space-3);
}
.jc__act {
  flex: 1;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--cy-radius-pill);
  font-size: var(--cy-type-button);
  font-weight: 800;
}
.jc__act--ghost { flex: none; width: 240rpx; background: var(--soft); color: var(--ink); }
.jc__act-main { background: #FFF; color: #111114; }   /* ds-ok 与 g-btn 同一颗白胶囊 */
