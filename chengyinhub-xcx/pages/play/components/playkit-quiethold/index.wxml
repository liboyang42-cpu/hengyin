<block wx:for="{{stageKeys}}" wx:key="*this" wx:for-item="stageKey">
<cy-play-stage id="cy-play-stage" data-stage-key="{{stageKey}}" show="{{show}}" back-label="退出"
               calibrate-label="先听一下这儿有多吵" calibrate-ms="2000"
               bind:back="onClose" bind:calibratetick="onSample" bind:calibrated="onCalibrated"
               bind:run="onRun" bind:verdict="onVerdict">
  <!-- 段条撤了。绿黄红没丢,挪到数字本身和整屏底色上 ——
       段条是「读数表」,而这一屏要人做的是闭嘴,不是读表。 -->
  <view class="qt qt--{{band}}">
    <view class="g-kicker qt__k pe pe--blur" style="--pe-d:.05s;--pe-dur:.2s">{{kicker}}</view>
    <view class="qt__n g-figure pe pe--up" style="--pe-d:.05s;--pe-dur:.2s">{{left}}</view>
    <view class="qt__s pe pe--up" style="--pe-d:.1s;--pe-dur:.2s" wx:if="{{sub}}">{{sub}}</view>
    <view class="qt__s pe pe--up" style="--pe-d:.1s;--pe-dur:.2s" wx:if="{{rewardNote}}">{{rewardNote}}</view>

    <view wx:if="{{micDenied && !skipped && !running}}" class="qt__s" aria-live="polite">需要授权麦克风才能开始</view>
    <view wx:if="{{skipped}}" class="qt__s">这一站已跳过</view>
    <view wx:elif="{{canSkip && !running && !preparing}}" class="qt__skip" bindtap="onSkip"
          aria-role="button" aria-label="跳过这一站" hover-class="qt__skip--press" hover-stay-time="80">跳过这一站</view>
  </view>
  <!-- 主按钮与其它玩法同一颗 .g-btn(2026-11-21 统一,原先是一颗浅绿胶囊) -->
  <view wx:if="{{!skipped}}" class="g-btn {{running || preparing ? 'g-btn--disabled' : ''}}" bindtap="onStart"
        aria-role="button" aria-label="开始安静挑战" hover-class="g-btn--press" hover-stay-time="80">
    {{running ? '安静中' : (preparing ? '准备中' : '开始')}}
  </view>
</cy-play-stage>

</block>
