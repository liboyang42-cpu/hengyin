@import "/pages/play/style/play-surface.wxss";

/* cy-playkit-hangman · 逐字猜词(UG-01)。沿用问答暗版皮肤与排序的行卡语言。 */
.hm { color: var(--ink); text-align: left; align-items: stretch; }
.hm__q { font-size: var(--cy-type-sheet-title); font-weight: 800; line-height: 1.4; }
/* 槽位行:等宽格,长词横向滚动,不折行断字 */
.hm__track { width: 100%; margin-top: var(--cy-space-5); white-space: nowrap; }
.hm__row { display: inline-flex; align-items: center; gap: 12rpx; padding: 8rpx 2rpx; }
.hm__cell {
  flex: none;
  width: 72rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--cy-radius-sm);
  background: var(--soft);
  font-family: var(--cy-font-numeric);
  font-size: var(--cy-type-section-title);
  font-weight: 800;
  color: var(--ink);
  box-shadow: inset 0 -4rpx 0 var(--sub);
  transition: box-shadow .2s ease, background .2s ease;
}
.hm__cell.is-given { background: transparent; box-shadow: none; color: var(--sub); }
.hm__cell.is-active { box-shadow: inset 0 0 0 4rpx var(--ink); }
.hm__cell.is-ok { box-shadow: inset 0 -4rpx 0 var(--ok); }
.hm__sep { flex: none; min-width: 20rpx; text-align: center; font-size: var(--cy-type-section-title); color: var(--sub); }
.hm__press { opacity: .88; }
.hm__cellin, .hm__word {
  width: 100%;
  height: 104rpx;
  margin-top: var(--cy-space-4);
  padding: 0 4rpx;
  box-sizing: border-box;
  background: transparent;
  border-bottom: 4rpx solid var(--soft);
  font-size: var(--cy-type-section-title);
  font-weight: 800;
  color: var(--ink);
}
.hm__word.is-wrong { border-bottom-color: var(--accent); }
.hm__ph { color: var(--sub); font-weight: 600; }
.hm__fb {
  margin-top: var(--cy-space-4);
  padding: var(--cy-space-3) var(--cy-space-4);
  border-radius: var(--cy-radius-md);
  font-size: var(--cy-type-body);
  font-weight: 700;
  word-break: break-all;
}
.hm__fb.is-ok { background: rgba(18, 160, 111, .16); color: var(--ok); }   /* ds-ok 成功色软底,与排序同源 */
.hm__fb.is-no { background: var(--cy-color-status-danger-soft); color: var(--accent); }
.hm--reduced .hm__cell { transition: none; }
.hm__q, .hm__track, .hm__cellin, .hm__word, .hm__fb { flex-shrink: 0; }
