@import "/pages/play/style/play-surface.wxss";

/* cy-playkit-hangman · 逐字猜词(UG-01,l-kits 2026-11-10 照 proto/game page.css .hang / .tiles / .tile / .hang__in,px × 2 = rpx)。
   问答暗版皮肤;整屏居中;格子 68×84rpx;圆角 / 切角 / 字体读主题外观 --lk-*,没有外观时落回皮肤色。 */
.hm { color: var(--ink); }
/* 整屏档:题面 + 格子 + 输入框作为一组,在按钮之上的区域里上下居中 */
.hm__stage {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 160rpx;                 /* ds-ok 让出底部按钮,视觉中心不压到按钮上 */
  box-sizing: border-box;
}
.hm--inline .hm__stage { padding-bottom: 0; }
.hm__q {
  font-family: var(--lk-fd, inherit);
  font-size: var(--cy-type-sheet-title);  /* ds-ok 原型 .hang__q 22px */
  font-weight: var(--lk-fw, 800);
  letter-spacing: var(--lk-ls, normal);
  line-height: 1.5;
  text-align: center;
}
/* 格子板:词组之间可换行,一个词里不换行 */
.hm__board {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 24rpx 28rpx;
  margin-top: var(--cy-space-6);           /* ds-ok 原型 .hang__q margin-bottom 26px */
  max-width: 100%;
}
.hm__word-row { display: flex; flex-wrap: nowrap; gap: 14rpx; }   /* ds-ok 原型 .tiles gap 7px */
.hm__cell {
  flex: none;
  width: 68rpx;                            /* ds-ok 原型 .tile 34×42px */
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(var(--lk-ink-rgb, 255, 255, 255), .2);   /* ds-ok 原型 --lk-line */
  border-radius: calc(var(--lk-r, 28rpx) / 2);
  clip-path: var(--lk-cut, none);
  background: var(--soft);
  font-family: var(--lk-fm, var(--cy-font-numeric));
  font-size: var(--cy-type-sheet-title);   /* ds-ok 原型 .tile 20px */
  font-weight: 700;
  color: var(--ink);
  transition: transform var(--cy-motion-standard) var(--cy-ease-spring-soft, cubic-bezier(.34, 1.3, .64, 1)), background-color var(--cy-motion-standard) ease, border-color var(--cy-motion-standard) ease, color var(--cy-motion-standard) ease;
}
.hm__cell.is-given { background: var(--lk-ctl, rgba(var(--lk-ink-rgb, 255, 255, 255), .14)); }   /* ds-ok 原型 .tile.pre 深一档 */
.hm__cell.is-active { border-color: var(--lk-a, var(--ink)); transform: translateY(-6rpx); }       /* ds-ok 原型 .tile.cur -3px */
/* 每填一格弹一下(原型 tilePop 50% scale 1.18):组件把 pop 指到那一格 220ms,过渡来回就是那一下,不用关键帧 */
.hm__cell.is-pop { transform: scale(1.18); }
/* 答对:格子依次变绿(原型每格隔 70ms) */
.hm__cell.is-ok { background: var(--ok); border-color: var(--ok); color: #fff; transition-delay: calc(var(--i, 0) * 70ms); }   /* ds-ok 成功绿上的白字 */
.hm__sep { font-size: var(--cy-type-body); font-weight: 800; color: var(--sub); }
.hm__press { opacity: .88; }
/* 输入框就在格子下面(原型 .hang__in 260px 宽) */
.hm__in {
  width: 520rpx;
  max-width: 100%;
  height: 92rpx;                           /* ds-ok 原型 12px 上下内边距 + 18px 字 */
  margin-top: var(--cy-space-5);           /* ds-ok 原型 18px */
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(var(--lk-ink-rgb, 255, 255, 255), .2);   /* ds-ok 原型 --lk-line */
  border-radius: var(--lk-r, var(--cy-radius-lg));
  clip-path: var(--lk-cut, none);
  background: var(--soft);
  text-align: center;
  font-family: var(--lk-fm, var(--cy-font-numeric));
  font-size: 36rpx;                        /* ds-ok 原型 18px */
  font-weight: 600;
  letter-spacing: .3em;
  color: var(--ink);
  transition: border-color var(--cy-motion-fast) ease;
}
.hm__in.is-wrong { border-color: var(--accent); }
.hm__ph { letter-spacing: 0; font-size: var(--cy-type-body); font-weight: 500; color: var(--sub); }
/* 答错:红字落在输入框下,升 16rpx 淡入(规则:红字,不弹窗) */
.hm__err {
  min-height: 36rpx;
  margin-top: var(--cy-space-2);
  font-size: var(--cy-type-label);
  font-weight: 600;
  color: var(--accent);
  opacity: 0;
  transform: translateY(16rpx);
  transition: opacity var(--cy-motion-slow) var(--cy-ease-out), transform var(--cy-motion-slow) var(--cy-ease-out);
}
.hm__err.is-show { opacity: 1; transform: none; }
.hm__fb {
  margin-top: var(--cy-space-5);
  font-family: var(--lk-fm, var(--cy-font-numeric));
  font-size: var(--cy-type-body);
  font-weight: 700;
  letter-spacing: .2em;
  color: var(--ok);
  text-align: center;
  word-break: break-all;
}
.hm--reduced .hm__cell, .hm--reduced .hm__err, .hm--reduced .hm__in { transition: none; }
.hm--reduced .hm__cell.is-pop, .hm--reduced .hm__cell.is-active { transform: none; }
.hm__q, .hm__board, .hm__in, .hm__err, .hm__fb { flex-shrink: 0; }
