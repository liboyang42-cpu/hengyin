:host { display: block; min-height: 100%; }
.ticket-scene { position: relative; min-height: calc(100vh - 180rpx); box-sizing: border-box; padding: var(--cy-space-3) 0 calc(var(--cy-space-5) + env(safe-area-inset-bottom)); }

/* a1-v3-17(2026-11-10 业主「不需要有白色的底 正常就是弹窗 直接放上二维码」):去掉外层白卡,标题与到期行直接写在弹层上(弹层 token 色);
   码本身仍是白底方块 —— 黑点码要白底才扫得出,这是码不是卡。 */
.voucher__card { display: flex; flex-direction: column; align-items: center; justify-content: center; margin: var(--cy-space-4) auto 0; }
.voucher__title { max-width: 100%; font-size: var(--cy-type-section-title); font-weight: 700; color: var(--cy-comp-sheet-player-text); }
.voucher__qr { position: relative; margin-top: 48rpx; width: 400rpx; height: 400rpx; border-radius: 28rpx; background: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 28rpx rgba(0,0,0,.08); } /* ds-ok 与票夹码块同值;码的白底(扫码需要) */
.voucher__qr-tip { font-size: var(--cy-type-label); color: rgba(17,17,17,.55); padding: 20rpx 30rpx; } /* ds-ok 白底码块上的读取中 */
.voucher__exp { margin-top: var(--cy-space-4); font-size: var(--cy-type-label); color: var(--cy-comp-sheet-player-text-secondary); }
.ep1 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.voucher__cta { flex: 1; height: var(--cy-btn-h); border-radius: var(--cy-radius-pill); background: var(--cy-text-title); color: var(--cy-bg-page); font-size: var(--cy-font-subtitle); font-weight: 700; display: flex; align-items: center; justify-content: center; }

/* isolated 组件内全局 .cy-pressed 进不来,必须本地定义一份。
   只减淡不位移:位移要配 .cy-motion-reduced 兜底,而那个类挂在组件外的祖先上,
   isolated 下同样够不着 —— 与其留个撤不掉的位移,不如按仓库既有组件按压类的做法只减淡。 */
.cy-pressed { opacity: .88; }

.seat-choice { display: flex; flex-direction: column; gap: var(--cy-space-4); padding: var(--cy-space-5); color: var(--cy-text-title); }
.seat-choice__title { font-size: var(--cy-font-subtitle); font-weight: 700; }
.seat-choice__input { height: var(--cy-btn-h); padding: 0 var(--cy-space-4); background: var(--cy-color-bg-glass); border-radius: var(--cy-radius-pill); }
.seat-choice__switch { text-align: center; padding: var(--cy-space-4); color: var(--cy-text-title); }

/* l-play 入场码翻面(来源:票夹 .wc / .wc__flip,proto .qrflip):600rpx × 920rpx 的票卡,正面是主题封面 + 标题,背面是白卡 + 600rpx 码块;翻面只用 transform 过渡,减少动态效果直接切 */
.voucher__flip { width: 600rpx; height: 920rpx; margin: var(--cy-space-3) auto 0; perspective: 2200rpx; }
.voucher__in { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .62s cubic-bezier(.2,.9,.25,1.08); } /* ds-ok 同票夹 .wc__flip */
.voucher__flip.is-back .voucher__in { transform: rotateY(180deg); }
.voucher__flip.is-reduced .voucher__in { transition: none; }
.voucher__face { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 52rpx; overflow: hidden; backface-visibility: hidden; -webkit-backface-visibility: hidden; box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.1), 0 46rpx 96rpx rgba(0,0,0,.55); } /* ds-ok 同票夹票面阴影 */
.voucher__front { background: linear-gradient(180deg, #1c1d1f, #0f1011); } /* ds-ok 同票夹正面底 */
.voucher__cover { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: .9; }
.voucher__front::after { content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,.72)); } /* ds-ok 票面压暗 */
.voucher__cap { position: absolute; left: 36rpx; right: 36rpx; bottom: 56rpx; z-index: 1; display: flex; flex-direction: column; gap: 10rpx; color: #fff; } /* ds-ok 票面字白 */
.voucher__cap-k { font-size: 22rpx; letter-spacing: .2em; color: rgba(255,255,255,.75); } /* ds-ok */
.voucher__cap-t { font-size: 48rpx; line-height: 1.2; font-weight: 600; } /* ds-ok 同票夹 .wc__b */
.voucher__cap-s { font-size: 24rpx; letter-spacing: .1em; color: rgba(255,255,255,.7); } /* ds-ok */
.voucher__rear { transform: rotateY(180deg); background: #f6f6f4; display: flex; align-items: center; justify-content: center; padding: 36rpx; box-sizing: border-box; } /* ds-ok 同票夹背面米白 */
.voucher__rear .voucher__card { margin: 0; }
.voucher__rear .voucher__title { color: #111; } /* ds-ok 米白卡上的字 */
.voucher__rear .voucher__qr { width: 600rpx; height: 600rpx; margin-top: 28rpx; } /* 码块比上一版大一圈(proto 300×300 → 600rpx);底色仍是白 */
.voucher__rear .voucher__exp { color: rgba(17,17,17,.55); } /* ds-ok 米白卡上的次级字 */
