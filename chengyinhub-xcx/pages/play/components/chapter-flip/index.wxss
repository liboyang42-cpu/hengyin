/* 章节翻转过场:业主 2026-10-28 定稿原型(claude.ai/artifact/KKQJxLNAL3JSb5pYDF1xtb)的定值,390 宽稿按 1.923rpx/px 移植。玩家侧固定深色。 */
.cf { position: fixed; inset: 0; z-index: 130; background: #1F1F21; color: #F5F5F2; opacity: 1; transition: opacity .32s ease; } /* ds-ok 原型定值 */
.cf.is-out { opacity: 0; }
.cf__fx { position: absolute; inset: 0; width: 100%; height: 100%; }
.cf__copy { position: absolute; left: 46rpx; right: 46rpx; top: calc(33.3vh + 45vw); display: flex; flex-direction: column; align-items: center; gap: 19rpx; text-align: center; transition: opacity .25s ease; }
.cf__copy.is-quiet { opacity: 0; }
.cf__k { min-height: 31rpx; font-size: 23rpx; letter-spacing: .32em; color: rgba(245,245,242,.3); } /* ds-ok 原型定值 */
.cf__t { min-height: 65rpx; font-size: 50rpx; font-weight: 700; letter-spacing: .04em; } /* ds-ok 原型定值 */
.cf__d { max-width: 577rpx; min-height: 42rpx; font-size: 27rpx; line-height: 1.6; color: rgba(245,245,242,.56); } /* ds-ok 原型定值 */
.cf__stats { display: flex; gap: 50rpx; margin-top: 19rpx; }
.cf__stat { display: flex; flex-direction: column; gap: 6rpx; min-width: 100rpx; }
.cf__v { font-size: 42rpx; font-weight: 700; font-variant-numeric: tabular-nums; } /* ds-ok 原型定值 */
.cf__sk { font-size: 23rpx; color: rgba(245,245,242,.3); } /* ds-ok 原型定值 */
.cf__c { white-space: pre; }
.cf__c.is-n { filter: blur(3rpx); opacity: .55; }
.cf__hint { position: absolute; left: 0; right: 0; bottom: calc(60rpx + env(safe-area-inset-bottom)); text-align: center; font-size: 24rpx; color: rgba(245,245,242,.4); } /* ds-ok 原型定值 */
.cf__btns { position: absolute; left: 31rpx; right: 31rpx; bottom: calc(58rpx + env(safe-area-inset-bottom)); display: flex; gap: 19rpx; opacity: 0; transform: translateY(24rpx); transition: opacity .4s ease, transform .4s ease; pointer-events: none; }
.cf__btns.is-on { opacity: 1; transform: none; pointer-events: auto; }
.cf__pill { flex: 1; height: 92rpx; border-radius: 46rpx; display: flex; align-items: center; justify-content: center; font-size: 29rpx; font-weight: 600; } /* ds-ok 原型定值 */
.cf__pill--s { background: #2C2C2E; color: #F5F5F2; } /* ds-ok 原型定值 */
.cf__pill--p { background: #E9C47C; color: #111111; } /* ds-ok 原型定值 */
.cf-pressed { opacity: .8; }
.cf--finale { z-index: 320; }   /* 盖在通关勋章页(300)之上,播完关掉才露出它 */
.cf-tap { opacity: .96; }
