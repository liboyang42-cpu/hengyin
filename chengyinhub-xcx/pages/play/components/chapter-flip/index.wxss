/* 章节翻转过场:业主 2026-10-28 定稿原型(claude.ai/artifact/KKQJxLNAL3JSb5pYDF1xtb)的定值,390 宽稿按 1.923rpx/px 移植。
   l-play 2026-11-10:章节门(开场 / 完成)跟主题外观 --lk-*(qx-base look-tokens.wxss),没有外观时回落原型深色;通关仍是原型深色。 */
.cf { position: fixed; inset: 0; z-index: 130; background: #1F1F21; color: #F5F5F2; opacity: 1; transition: opacity .32s ease; } /* ds-ok 原型定值 */
.cf--gate { background: var(--lk-bg, #1F1F21); color: var(--lk-ink, #F5F5F2); } /* ds-ok 回落原型定值 */
.cf--gate .cf__k, .cf--gate .cf__d, .cf--gate .cf__sk { color: var(--lk-mute, rgba(245,245,242,.56)); } /* ds-ok 回落原型定值 */
.cf--gate .cf__t { font-family: var(--lk-fd, inherit); letter-spacing: var(--lk-ls, .04em); }
.cf.is-out { opacity: 0; }
.cf__fx { position: absolute; inset: 0; width: 100%; height: 100%; }
.cf__copy { position: absolute; left: 46rpx; right: 46rpx; top: calc(33.3vh + 45vw); display: flex; flex-direction: column; align-items: center; gap: 19rpx; text-align: center; transition: opacity .25s ease; }
.cf__copy.is-quiet { opacity: 0; }
/* 章节开场:方块章节号占 150–400px(画布),文字从 430px 起;整块随 is-in 升起 */
.cf--gate .cf__copy { top: 830rpx; opacity: 0; transform: translateY(40rpx); transition: opacity .7s ease, transform .9s cubic-bezier(.16,1,.3,1); }
.cf--gate .cf__copy.is-in { opacity: 1; transform: none; }
.cf__k { min-height: 31rpx; font-size: 23rpx; letter-spacing: .32em; color: rgba(245,245,242,.56); } /* ds-ok 原型定值 */
.cf__t { min-height: 65rpx; font-size: 50rpx; font-weight: 700; letter-spacing: .04em; } /* ds-ok 原型定值 */
.cf__d { max-width: 577rpx; min-height: 42rpx; font-size: 27rpx; line-height: 1.6; color: rgba(245,245,242,.56); } /* ds-ok 原型定值 */
.cf__stats { display: flex; gap: 50rpx; margin-top: 19rpx; }
.cf__stat { display: flex; flex-direction: column; gap: 6rpx; min-width: 100rpx; }
.cf__v { font-size: 42rpx; font-weight: 700; font-variant-numeric: tabular-nums; } /* ds-ok 原型定值 */
.cf__sk { font-size: 23rpx; color: rgba(245,245,242,.56); } /* ds-ok 原型定值 */
.cf__c { white-space: pre; }
.cf__c.is-n { filter: blur(3rpx); opacity: .55; }
.cf__btns { position: absolute; left: 31rpx; right: 31rpx; bottom: calc(58rpx + env(safe-area-inset-bottom)); display: flex; gap: 19rpx; opacity: 0; transform: translateY(24rpx); transition: opacity .4s ease, transform .4s ease; pointer-events: none; }
.cf__btns.is-on { opacity: 1; transform: none; pointer-events: auto; }
.cf__pill { flex: 1; height: 92rpx; border-radius: 46rpx; display: flex; align-items: center; justify-content: center; font-size: 29rpx; font-weight: 600; } /* ds-ok 原型定值 */
.cf__pill--s { background: #2C2C2E; color: #F5F5F2; } /* ds-ok 原型定值 */
.cf__pill--p { background: #E9C47C; color: #111111; } /* ds-ok 原型定值 */
.cf-pressed { opacity: .8; }
.cf--finale { z-index: 320; background: var(--lk-bg, #1F1F21); color: var(--lk-ink, #F5F5F2); } /* ds-ok x-fix4 N-11:通关卡跟主题外观,不再是固定灰;回落原型定值 */
.cf--finale .cf__k, .cf--finale .cf__d, .cf--finale .cf__sk { color: var(--lk-mute, rgba(245,245,242,.56)); } /* ds-ok 回落原型定值 */
.cf--finale .cf__copy { top: calc(33.3vh + 45vw + 24rpx); max-width: calc(100vw - 92rpx); overflow: visible; } /* x-fix6 R4-5:原 overflow:hidden 把模糊乱码字切成卡边「字影」、把底部 里程/用时 标签切半,改不裁切;宽度靠折行约束 */
/* x-fix5 R3-9:不依赖 WebGL 的版面兜底 —— 标题/说明在容器内折行、数据行折行居中、不贴到卡边,文案区不压到底部按钮 */
.cf--finale .cf__copy { box-sizing: border-box; width: calc(100vw - 92rpx); padding: 0 16rpx; bottom: calc(190rpx + env(safe-area-inset-bottom)); } /* ds-ok */
.cf--finale .cf__t, .cf--finale .cf__d, .cf--finale .cf__k { max-width: 100%; white-space: normal; word-break: break-all; }
/* x-fix7 R4-5/N-11:根因是每个解码字 .cf__c 自带 white-space:pre,父级的 normal/break-all 管不到字间折行,长标题一行排到卡外,两端被屏幕边缘切成「纸…」「…字」字影;finale 里字可折行,并只裁横向(不裁底部标签) */
.cf--finale .cf__c { white-space: pre-wrap; }
.cf--finale .cf__copy { overflow-x: clip; }
.cf--finale .cf__stats { flex-wrap: wrap; justify-content: center; max-width: 100%; row-gap: 16rpx; }
.cf--finale .cf__sk, .cf--finale .cf__v { max-width: 100%; white-space: normal; text-align: center; } /* x-fix4 N-11:避开银色标志下沿;解码乱码字不漏到两侧 */
.cf--finale .cf__pill--s { background: rgba(var(--lk-ink-rgb, 245,245,242), .12); color: var(--lk-ink, #F5F5F2); } /* ds-ok 回落原型定值 */
.cf--finale .cf__pill--p { background: var(--lk-a, #E9C47C); color: var(--lk-bg, #111111); } /* ds-ok 回落原型定值 */   /* 盖在通关勋章页(300)之上,播完关掉才露出它 */
/* x-design1 D2:标志在上、文案在下留出明确间距;文案区铺满内容宽(与页面左右边距一致),不再比内容窄一圈;解码乱码字(is-n)在通关卡里不显示,避免标题后面叠出一层字影 */
.cf--finale .cf__copy { top: calc(33.3vh + 45vw + 64rpx); left: var(--cy-page-x); right: var(--cy-page-x); width: auto; max-width: none; padding: 0; }
.cf--finale .cf__c.is-n { opacity: 0; filter: none; }
.cf-tap { opacity: .96; }
/* ===== l-play 章节完成整屏(proto gp-chapter-end;没有卡片) =====
   顶部照片 330px 渐入底色,方块章节号在画布上压在照片上(96px 起),成功插图 + 文字 + 三格数据在 380px 起,底部「下一站」。
   吹散:照片当帧隐去(粉尘在画布上接着飞),文字往右上吹走(位移 + 模糊 + 淡出)。 */
.cf__end { position: absolute; inset: 0; opacity: 0; transition: opacity .45s ease; }
.cf__end.is-in { opacity: 1; }
.cf__cover { position: absolute; left: 0; right: 0; top: 0; width: 100%; height: 660rpx; opacity: .55; }
.cf__end.is-out .cf__cover { opacity: 0; transition: none; }
.cf__fade { position: absolute; left: 0; right: 0; top: 0; height: 680rpx; background: linear-gradient(180deg, rgba(var(--lk-bg-rgb, 31,31,33), .3), var(--lk-bg, #1F1F21)); } /* ds-ok 回落原型底色 */
.cf__body { position: absolute; left: 56rpx; right: 56rpx; top: 760rpx; display: flex; flex-direction: column; align-items: center; text-align: center; transition: opacity .9s ease, filter .9s ease, transform .9s ease; }
.cf__end.is-out .cf__body, .cf__end.is-out .cf__foot { opacity: 0; filter: blur(16rpx); transform: translate(80rpx, -60rpx); }
.cf__ok { position: relative; height: 240rpx; margin: -80rpx auto 20rpx; display: flex; justify-content: center; }
.cf__spk { position: absolute; }
.cf__spk--a { right: calc(50% - 220rpx); top: -16rpx; }
.cf__spk--b { left: calc(50% - 208rpx); top: 100rpx; }
.cf__ek { font-size: 23rpx; letter-spacing: .22em; color: var(--lk-mute, rgba(245,245,242,.56)); } /* ds-ok 回落原型定值 */
.cf__et { margin-top: 16rpx; font-size: 64rpx; line-height: 1.2; font-weight: var(--lk-fw, 700); font-family: var(--lk-fd, inherit); letter-spacing: var(--lk-ls, .04em); color: var(--lk-ink, #F5F5F2); } /* ds-ok 回落原型定值 */
.cf__stats2 { display: flex; justify-content: center; gap: 52rpx; margin-top: 36rpx; }
.cf__st { display: flex; flex-direction: column; align-items: center; gap: 6rpx; min-width: 120rpx; }
.cf__sv { font-size: 52rpx; font-weight: 700; font-family: var(--lk-fm, inherit); font-variant-numeric: tabular-nums; color: var(--lk-ink, #F5F5F2); } /* ds-ok 回落原型定值 */
.cf__sl { font-size: 23rpx; letter-spacing: .14em; color: var(--lk-mute, rgba(245,245,242,.56)); } /* ds-ok 回落原型定值 */
/* 底部按钮(开场「读下去」/ 完成「下一站」):外观按钮(--lk-ink 底 --lk-bg 字,圆角 / 切角随外观),按下微缩 */
.cf__foot { position: absolute; left: 40rpx; right: 40rpx; bottom: calc(68rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 20rpx; transition: opacity .5s ease, transform .5s ease, filter .9s ease; }
.cf__foot--start { opacity: 0; transform: translateY(24rpx); pointer-events: none; }
.cf__foot--start.is-on { opacity: 1; transform: none; pointer-events: auto; }
.cf__btn { min-height: 100rpx; padding: 0 40rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: var(--lk-rb, 50rpx); clip-path: var(--lk-cut, none); /* ds-ok 圆角随外观,回落原型药丸 */
  background: var(--lk-ink, #F5F5F2); color: var(--lk-bg, #1F1F21); font-size: 32rpx; font-weight: 600; letter-spacing: .04em; transition: transform 80ms ease; } /* ds-ok 回落原型定值 */
.cf-pressed .cf__btn, .cf__btn.cf-pressed { transform: scale(.97); opacity: 1; }
/* 减少动态效果:文字直接落位,吹散不做位移 */
.cf--reduced .cf__copy, .cf--reduced .cf__foot--start, .cf--reduced .cf__end { transition: none; opacity: 1; transform: none; }
.cf--reduced .cf__end.is-out .cf__body, .cf--reduced .cf__end.is-out .cf__foot { transform: none; filter: none; }
