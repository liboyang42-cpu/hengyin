/* 章节翻转过场:业主 2026-10-28 定稿原型(claude.ai/artifact/KKQJxLNAL3JSb5pYDF1xtb)的定值,390 宽稿按 1.923rpx/px 移植。
   l-play 2026-11-10:章节门(开场 / 完成)跟主题外观 --lk-*(qx-base look-tokens.wxss),没有外观时回落原型深色;通关 / 章节开始的动效在 chapter-moment。 */
.cf { position: fixed; inset: 0; z-index: 130; background: #1F1F21; color: #F5F5F2; opacity: 1; transition: opacity .32s ease; } /* ds-ok 原型定值 */
.cf--gate { background: var(--lk-bg, #1F1F21); color: var(--lk-ink, #F5F5F2); } /* ds-ok 回落原型定值 */
.cf.is-out { opacity: 0; }
.cf__fx { position: absolute; inset: 0; width: 100%; height: 100%; }
.cf-pressed { opacity: .8; }
.cf--finale { z-index: 320; background: var(--lk-bg, #1F1F21); color: var(--lk-ink, #F5F5F2); } /* ds-ok x-fix4 N-11:通关卡跟主题外观,不再是固定灰;回落原型定值 */
.cf-tap { opacity: .96; }
/* ===== l-play 章节完成整屏(proto gp-chapter-end;没有卡片) =====
   顶部照片 330px 渐入底色,方块章节号在画布上压在照片上(96px 起),成功插图 + 文字 + 三格数据在 380px 起,底部「下一站」。
   吹散:照片当帧隐去(粉尘在画布上接着飞),文字往右上吹走(位移 + 模糊 + 淡出)。 */
.cf__end { position: absolute; inset: 0; opacity: 0; transition: opacity .45s ease; }
.cf__end.is-in { opacity: 1; }
.cf__cover { position: absolute; left: 0; right: 0; top: 0; width: 100%; height: 660rpx; opacity: .55; }
.cf__end.is-out .cf__cover { opacity: 0; transition: none; }
.cf__fade { position: absolute; left: 0; right: 0; top: 0; height: 680rpx; background: linear-gradient(180deg, rgba(var(--lk-bg-rgb, 31,31,33), .3), var(--lk-bg, #1F1F21)); } /* ds-ok 回落原型底色 */
.cf__body { position: absolute; left: 56rpx; right: 56rpx; top: 760rpx; display: flex; flex-direction: column; align-items: center; text-align: center; transition: opacity .9s ease, filter .9s ease, transform .9s ease; }
.cf__end.is-out .cf__body, .cf__end.is-out .cf__foot { opacity: 0; filter: blur(16rpx); transform: translate(80rpx, -60rpx); }
.cf__ok { position: relative; height: 240rpx; margin: -80rpx auto 20rpx; display: flex; justify-content: center; }
.cf__spk { position: absolute; }
.cf__spk--a { right: calc(50% - 220rpx); top: -16rpx; }
.cf__spk--b { left: calc(50% - 208rpx); top: 100rpx; }
.cf__ek { font-size: 23rpx; letter-spacing: .22em; color: var(--lk-mute, rgba(245,245,242,.56)); } /* ds-ok 回落原型定值 */
.cf__et { margin-top: 16rpx; font-size: 64rpx; line-height: 1.2; font-weight: var(--lk-fw, 700); font-family: var(--lk-fd, inherit); letter-spacing: var(--lk-ls, .04em); color: var(--lk-ink, #F5F5F2); } /* ds-ok 回落原型定值 */
.cf__stats2 { display: flex; justify-content: center; gap: 52rpx; margin-top: 36rpx; }
.cf__st { display: flex; flex-direction: column; align-items: center; gap: 6rpx; min-width: 120rpx; }
.cf__sv { font-size: 52rpx; font-weight: 700; font-family: var(--lk-fm, inherit); font-variant-numeric: tabular-nums; color: var(--lk-ink, #F5F5F2); } /* ds-ok 回落原型定值 */
.cf__sl { font-size: 23rpx; letter-spacing: .14em; color: var(--lk-mute, rgba(245,245,242,.56)); } /* ds-ok 回落原型定值 */
/* 底部按钮(完成「下一站」):外观按钮(--lk-ink 底 --lk-bg 字,圆角 / 切角随外观),按下微缩 */
.cf__foot { position: absolute; left: 40rpx; right: 40rpx; bottom: calc(68rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 20rpx; transition: opacity .5s ease, transform .5s ease, filter .9s ease; }
.cf__btn { min-height: 100rpx; padding: 0 40rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: var(--lk-rb, 50rpx); clip-path: var(--lk-cut, none); /* ds-ok 圆角随外观,回落原型药丸 */
  background: var(--lk-ink, #F5F5F2); color: var(--lk-bg, #1F1F21); font-size: 32rpx; font-weight: 600; letter-spacing: .04em; transition: transform 80ms ease; } /* ds-ok 回落原型定值 */
.cf-pressed .cf__btn, .cf__btn.cf-pressed { transform: scale(.97); opacity: 1; }
/* 减少动态效果:文字直接落位,吹散不做位移 */
.cf--reduced .cf__end { transition: none; opacity: 1; transform: none; }
.cf--reduced .cf__end.is-out .cf__body, .cf--reduced .cf__end.is-out .cf__foot { transform: none; filter: none; }
