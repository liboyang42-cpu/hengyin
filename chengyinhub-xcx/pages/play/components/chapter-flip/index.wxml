<view class="cf cf--{{mode}} {{out ? 'is-out' : ''}} {{reducedMotion ? 'cf--reduced' : ''}}" catchtouchmove="noop" bindtap="onTap" hover-class="cf-tap" hover-stay-time="80" aria-role="{{mode === 'gate' ? 'button' : 'dialog'}}" aria-label="{{mode === 'gate' ? (endCard ? endCard.kicker : info.title) + '，轻点继续' : info.title}}">
  <canvas wx:if="{{mode === 'gate'}}" type="2d" id="cf" class="cf__fx" aria-hidden="true"></canvas>
  <!-- l-play 章节完成整屏(proto/game gp-chapter-end):本章照片渐入底色 → 圆点章节号(画布)→ 成功插图 → 第 N 章完成 · 章名 → 三格数据滚上来 → 下一站;
       点「下一站」照片与文字化成细粉尘吹散(画布),下一章开场浮现。没有卡片。 -->
  <view class="cf__end {{endIn ? 'is-in' : ''}} {{endOut ? 'is-out' : ''}}" wx:if="{{endCard}}">
    <image wx:if="{{endCard.cover}}" class="cf__cover" src="{{endCard.cover}}" mode="aspectFill" aria-hidden="true" />
    <view class="cf__fade" aria-hidden="true"></view>
    <view class="cf__body">
      <view class="cf__ok" aria-hidden="true">
        <cy-illus name="success" size="240" delay="{{400}}" reduced-motion="{{reducedMotion}}" />
        <view class="cf__spk cf__spk--a"><cy-illus name="sparkles" size="88" delay="{{900}}" bare="{{true}}" reduced-motion="{{reducedMotion}}" /></view>
        <view class="cf__spk cf__spk--b"><cy-illus name="sparkles" size="64" delay="{{1100}}" bare="{{true}}" reduced-motion="{{reducedMotion}}" /></view>
      </view>
      <view class="cf__ek">{{endCard.kicker}}</view>
      <view class="cf__et" wx:if="{{endCard.title}}">{{endCard.title}}</view>
      <view class="cf__stats2" wx:if="{{endStats.length}}">
        <view class="cf__st" wx:for="{{endStats}}" wx:key="k"><text class="cf__sv">{{item.shown}}</text><text class="cf__sl">{{item.k}}</text></view>
      </view>
    </view>
    <view class="cf__foot"><view class="cf__btn" catchtap="onTap" aria-role="button" aria-label="{{endCard.next ? '下一站:' + endCard.next : '继续'}}" hover-class="cf-pressed" hover-stay-time="80">{{endCard.next ? '下一站：' + endCard.next : '继续'}}</view></view>
  </view>
  <!-- 动效 v2:章节开始(时刻 1)/ 通关(时刻 3)整屏由 chapter-moment 播,没有画布、没有标志、没有残影 -->
  <cy-chapter-moment wx:if="{{mode === 'finale' || (mode === 'gate' && start)}}" mode="{{mode === 'finale' ? 'finale' : 'start'}}" info="{{info}}" reduced-motion="{{reducedMotion}}" bind:go="onMomentGo" bind:save="onSave" bind:continue="onClose" />
</view>
