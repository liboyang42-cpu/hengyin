<!-- 排序 · 2026-10-23 主人定稿(城瘾 排序连线分类试玩原型):每行一张深色卡,左边大号斜体序号;
     按住一行上下拖,那行抬起跟手、其它行让位;也可以先点一行再点另一行直接对调(读屏同样走得通)。 -->
<cy-play-stage id="cy-play-stage" skin="qadark" show="{{show}}" back-label="退出"
               bind:back="onClose">
  <view class="g-col so {{reducedMotion ? 'so--reduced' : ''}}">
    <view class="so__prompt pe pe--blur" style="--pe-d:.05s">{{prompt}}</view>
    <view class="so__hint pe pe--blur" style="--pe-d:.15s" wx:if="{{verdict !== 'ok'}}">按住一行上下拖，或者先点一行再点另一行换位置</view>

    <view class="so__list">
      <!-- 回执只有整体对错:判错时**不**逐行标红(服务端不给逐位置对错,
           整列红等于假装知道错在第几位),整列抖一下并给整体提示,让人继续排 -->
      <view class="so__row {{verdict === 'ok' ? 'is-right' : ''}} {{dragging === index ? 'is-dragging' : ''}} {{picked === index ? 'is-pick' : ''}} pe pe--up"
            style="--pe-d:.25s;--pe-i:{{index}};{{dragging === index ? 'transform:translateY(' + dragOffset + 'px) scale(1.03)' : ''}}"
            wx:for="{{rows}}" wx:key="id" data-i="{{index}}"
            bindtouchstart="onDragStart" bindtouchmove="onDragMove" bindtouchend="onDragEnd" bindtouchcancel="onDragEnd" bindtap="onTapRow"
            aria-role="button" aria-label="第 {{index + 1}} 位：{{item.label}}。点一下选中，再点另一条对调"
            hover-class="so__press" hover-stay-time="80">
        <view class="so__no">{{index + 1}}</view>
        <image class="so__img" wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFill" aria-role="img" aria-label="待排项配图" />
        <view class="so__label">{{item.label}}</view>
        <view class="so__grip" wx:if="{{verdict !== 'ok'}}" aria-hidden="true"><view class="so__grip-i"></view><view class="so__grip-i"></view><view class="so__grip-i"></view></view>
      </view>
    </view>

    <!-- 反馈条:判错也要说清楚「这一次不扣生命」,不然玩家不知道自己损失了什么 -->
    <view class="so__fb {{verdict === 'ok' ? 'is-ok' : 'is-no'}}" wx:if="{{verdict}}">
      {{verdict === 'ok' ? '排好了 · 这一题过了' : (finished ? '次数用完了 · 这次不扣生命' : '还没排对 · 挪一挪再交')}}
    </view>
  </view>

  <view class="g-btn {{rows.length && verdict !== 'ok' ? '' : 'g-btn--disabled'}} pe pe--up" style="--pe-d:.8s" bindtap="onSubmit"
        aria-role="button" aria-label="提交排好的顺序" hover-class="g-btn--press" hover-stay-time="80">
    就这个顺序
  </view>
</cy-play-stage>
