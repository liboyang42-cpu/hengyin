<view class="album" wx:if="{{show}}">
  <text class="album__title">{{title || '相册'}}</text>
  <cy-album-glass class="album__glass" images="{{images}}" cur="{{cur}}" bind:change="onChange" />
  <text class="album__line">{{images[cur].line}}</text>
  <text class="album__count" wx:if="{{images.length}}">{{cur + 1}} / {{images.length}}</text>
  <text class="album__line" wx:if="{{completionEnabled && done}}">相册已提交，以系统确认结果为准</text>
  <text class="album__line" wx:if="{{completionEnabled && !done && uploadError}}" aria-live="polite">{{uploadError}}</text>
  <view class="album__line" wx:if="{{completionEnabled && !done}}">
    <view bindtap="onCta" aria-role="button" aria-label="{{uploaded ? '重新提交照片' : (uploadRetryable ? '重试上传这张照片' : '拍照或选择照片')}}" style="transform: none" hover-class="album__back--press">{{uploaded ? '重新提交照片' : (uploadRetryable ? '重试上传' : '拍照或选择照片完成相册')}}</view>
    <view wx:if="{{uploaded || uploadRetryable}}" bindtap="choosePhoto" aria-role="button" aria-label="重新选择照片" style="transform: none" hover-class="album__back--press">重新选择照片</view>
  </view>
  <view class="album__back" bindtap="close" aria-role="button" aria-label="收起相册" hover-class="album__back--press" hover-stay-time="80">收起相册</view>
</view>
