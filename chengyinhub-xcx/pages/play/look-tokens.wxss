/* ===== 读者:主题内弹窗 / 卡片 / 按钮 / 标签(原型 page.css 的 .gm-pop .card / .gcard / .gb / .gch,px × 2 = rpx) ===== */
.lk-pop { position: relative; background: var(--lk-pop); color: var(--lk-ink); border: 1rpx solid rgba(var(--lk-ink-rgb), .2); border-radius: var(--lk-r); clip-path: var(--lk-cut); overflow: hidden; box-shadow: 0 48rpx 96rpx rgba(0,0,0,.45); } /* ds-ok 阴影黑 */
.lk-card { position: relative; background: var(--lk-card); color: var(--lk-ink); border: 1rpx solid rgba(var(--lk-ink-rgb), .2); border-radius: var(--lk-r); clip-path: var(--lk-cut); }
.lk-title { font-family: var(--lk-fd); font-weight: var(--lk-fw); letter-spacing: var(--lk-ls); color: var(--lk-ink); }
.lk-story { font-family: var(--lk-fs); color: var(--lk-ink); }
.lk-num { font-family: var(--lk-fm); font-variant-numeric: tabular-nums; }
.lk-mute { color: var(--lk-mute); }
.lk-dim { color: var(--lk-dim); }
.lk-line { border-color: rgba(var(--lk-ink-rgb), .2); }
.lk-btn { display: flex; align-items: center; justify-content: center; gap: 16rpx; min-height: 100rpx; padding: 0 40rpx; box-sizing: border-box; border-radius: var(--lk-rb); clip-path: var(--lk-cut); font-size: 32rpx; font-weight: 600; letter-spacing: .04em; transition: transform var(--cy-motion-press) ease, opacity var(--cy-motion-fast) ease; }
.lk-btn:active { transform: scale(.97); }
.lk-btn--primary { background: var(--lk-ink); color: var(--lk-bg); }
.lk-btn--accent { background: var(--lk-a); color: var(--lk-bg); }
.lk-btn--ghost { background: rgba(var(--lk-ink-rgb), .07); color: var(--lk-ink); border: 1rpx solid rgba(var(--lk-ink-rgb), .2); }
.lk-btn--text { background: transparent; color: var(--lk-mute); font-weight: 500; }
.lk-btn--ok { background: var(--lk-ok); color: #FFFFFF; } /* ds-ok 成功绿上的白字 */
.lk-chip { display: inline-flex; align-items: center; gap: 12rpx; min-height: 64rpx; padding: 0 26rpx; border-radius: var(--lk-rb); clip-path: var(--lk-cut); border: 1rpx solid rgba(var(--lk-ink-rgb), .2); background: rgba(var(--lk-ink-rgb), .07); color: var(--lk-ink); font-size: 26rpx; }
.lk-chip.is-on { background: var(--lk-ink); color: var(--lk-bg); border-color: var(--lk-ink); }
.look--paper .lk-btn { font-family: var(--lk-fd); font-weight: 700; }
.look--survival .lk-btn { font-family: var(--lk-fm); letter-spacing: .14em; }
.look--cyber .lk-btn--primary { background: var(--lk-a); font-family: var(--lk-fm); letter-spacing: .18em; font-weight: 700; }
.look--cyber .lk-title { color: var(--lk-a); text-shadow: 0 0 36rpx rgba(var(--lk-a-rgb), .4); }

/* ===== 星尘:果冻玻璃(半透明 + 模糊 + 高光边 + 斜向反光) ===== */
.look--stardust .lk-pop, .look--stardust .lk-card, .look--stardust .lk-btn--ghost, .look--stardust .lk-chip {
  background: linear-gradient(160deg, rgba(var(--lk-ink-rgb), .10), rgba(var(--lk-ink-rgb), .02) 40%, rgba(var(--lk-a-rgb), .06));
  -webkit-backdrop-filter: blur(14rpx) saturate(1.6) brightness(1.08); backdrop-filter: blur(14rpx) saturate(1.6) brightness(1.08);
  border: 1rpx solid rgba(var(--lk-ink-rgb), .34);
  box-shadow: inset 0 3rpx 0 rgba(var(--lk-ink-rgb), .85), inset 2rpx 0 0 rgba(var(--lk-ink-rgb), .3), inset 0 -2rpx 0 rgba(var(--lk-ink-rgb), .12), inset -2rpx 0 0 rgba(var(--lk-ink-rgb), .12), 0 40rpx 100rpx rgba(0,0,0,.35); } /* ds-ok 阴影黑 */
.look--stardust .lk-pop { box-shadow: inset 0 2rpx 0 rgba(var(--lk-ink-rgb), .85), inset 0 -2rpx 0 rgba(var(--lk-ink-rgb), .08), 0 60rpx 140rpx rgba(0,0,0,.55), 0 0 0 1rpx rgba(var(--lk-ink-rgb), .2); } /* ds-ok 阴影黑 */
.look--stardust .lk-pop::before, .look--stardust .lk-card::before { content: ""; position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; z-index: 1; border-radius: inherit; background: linear-gradient(118deg, rgba(var(--lk-ink-rgb), .26) 0%, transparent 22%, transparent 70%, rgba(var(--lk-ink-rgb), .12) 100%), radial-gradient(120% 60% at 50% -20%, rgba(var(--lk-ink-rgb), .18), transparent 60%); }
.look--stardust .lk-pop > view, .look--stardust .lk-card > view { position: relative; z-index: 2; }
.look--stardust .lk-btn--primary { box-shadow: inset 0 2rpx 0 rgba(255,255,255,.6), 0 20rpx 48rpx rgba(0,0,0,.25); } /* ds-ok 玻璃按钮顶边高光 */

/* ===== 末世:锈蚀(锈斑 + 左缘锈线 + 横纹 + 虚线分隔),正文压暗影保对比度 ===== */
.look--survival { --lk-rust-rgb: 138,74,34; --lk-rust2-rgb: 90,52,24; } /* ds-ok 锈色只在末世外观 */
