  background-color: var(--lk-card);
  background-image: radial-gradient(ellipse 26% 20% at 100% 0%, rgba(var(--lk-rust-rgb), .4), transparent 70%), radial-gradient(ellipse 22% 16% at 0% 100%, rgba(var(--lk-rust2-rgb), .4), transparent 70%), linear-gradient(90deg, rgba(var(--lk-rust-rgb), .3), transparent 6rpx), repeating-linear-gradient(0deg, transparent 0 10rpx, rgba(var(--lk-ink-rgb), .03) 10rpx 12rpx);
  border-color: rgba(var(--lk-ink-rgb), .26);
  box-shadow: inset 0 0 0 1rpx rgba(var(--lk-rust-rgb), .25), inset 0 -28rpx 48rpx rgba(0,0,0,.25), 0 36rpx 80rpx rgba(0,0,0,.5); } /* ds-ok 阴影黑 */
.look--survival .lk-pop { box-shadow: inset 0 0 0 1rpx rgba(var(--lk-rust-rgb), .3), inset 0 -40rpx 60rpx rgba(0,0,0,.3), 0 60rpx 140rpx rgba(0,0,0,.6); } /* ds-ok 阴影黑 */
.look--survival .lk-title { text-shadow: 2rpx 0 0 rgba(var(--lk-rust-rgb), .7), -2rpx 2rpx 0 rgba(0,0,0,.5); letter-spacing: .14em; } /* ds-ok */
.look--survival .lk-btn--primary { background: var(--lk-ink); box-shadow: inset 0 0 0 1rpx rgba(0,0,0,.35), inset 0 -6rpx 0 rgba(0,0,0,.25), inset 0 0 0 400rpx rgba(var(--lk-rust-rgb), .12); } /* ds-ok */
.look--survival .lk-btn--ghost, .look--survival .lk-chip { border-color: rgba(var(--lk-rust-rgb), .45); background: rgba(var(--lk-rust-rgb), .10); }
.look--survival .lk-story, .look--survival .lk-dim { text-shadow: 0 2rpx 4rpx rgba(var(--lk-shade-rgb), .7), 0 0 20rpx rgba(var(--lk-shade-rgb), .45); }

/* ===== 结算 / 平台:永远玩家黑(不跟主题外观) ===== */
.lk-plain { --lk-bg: var(--cy-color-bg-page); --lk-ink: var(--cy-color-text-primary); --lk-mute: var(--cy-color-text-tertiary); --lk-a: var(--cy-color-text-primary); --lk-b: var(--cy-color-text-tertiary); --lk-ink-rgb: 255,255,255; --lk-a-rgb: 255,255,255; --lk-b-rgb: 255,255,255; --lk-card: var(--cy-color-bg-surface); --lk-pop: var(--cy-color-bg-elevated); --lk-ctl: var(--cy-color-bg-elevated); --lk-dim: var(--cy-color-text-secondary); --lk-fd: inherit; --lk-fw: 600; --lk-ls: normal; --lk-fs: inherit; --lk-fm: inherit; --lk-r: 32rpx; --lk-rb: 999rpx; --lk-cut: none; } /* ds-ok 玩家黑 */
.lk-plain .lk-pop, .lk-plain .lk-card, .lk-plain .lk-btn--ghost, .lk-plain .lk-chip { -webkit-backdrop-filter: none; backdrop-filter: none; background-image: none; text-shadow: none; }
.lk-plain .lk-pop::before, .lk-plain .lk-card::before { display: none; }
