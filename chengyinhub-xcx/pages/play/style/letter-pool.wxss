/* F03 字母池 / 字符集输入:候选字网格 + 「清空」。逐字猜词(playkit-hangman)与打字题字符池(playkit-qa)共用。
   颜色全读所在玩法皮肤的 --ink / --sub / --soft(问答暗版 / 亮版),形状读主题外观 --lk-*,与答案格(.hm__cell)同一套;
   不新造颜色。候选字与按钮命中区都不小于 88rpx(44px)。 */
.lp__grid {
  width: 100%;
  max-width: 680rpx;                       /* ds-ok 7 × 88rpx + 6 × 10rpx 间距,一行 7 个刚好放下 */
  margin-top: var(--cy-space-5);
  display: flex;
  flex-direction: column;
  gap: 10rpx;                              /* ds-ok 与 .hm__word-row 的格距同一档 */
}
.lp__row { display: flex; justify-content: center; gap: 10rpx; }   /* ds-ok 同上 */
.lp__key {
  flex: none;
  width: 88rpx;                            /* ds-ok 命中区 44px */
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(var(--lk-ink-rgb, 255, 255, 255), .2);   /* ds-ok 与 .hm__cell 同一条描边 */
  border-radius: calc(var(--lk-r, 28rpx) / 2); /* ds-ok 与 .hm__cell 同一档圆角 */
  clip-path: var(--lk-cut, none);
  background: var(--lk-ctl, rgba(var(--lk-ink-rgb, 255, 255, 255), .14));   /* ds-ok 与 .hm__cell.is-given 同一档 */
  font-family: var(--lk-fm, var(--cy-font-numeric));
  font-size: var(--cy-type-sheet-title);
  font-weight: 700;
  color: var(--ink);
  transition: opacity var(--cy-motion-fast) ease, transform var(--cy-motion-fast) ease;
}
/* 用掉的字置灰:留在原位(位置不跳),淡到看得出「没了」 */
.lp__key.is-used { opacity: .28; background: var(--soft); }
.lp__press { opacity: .7; }
/* 清空:次要动作,描边胶囊,不抢底部「提交」 */
.lp__clear {
  min-width: 176rpx;                       /* ds-ok 两字按钮 + 左右留白 */
  min-height: 88rpx;                       /* ds-ok 命中区 44px */
  margin-top: var(--cy-space-3);
  padding: 0 var(--cy-space-5);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;                    /* ds-ok 正好是这个高度的胶囊 */
  box-shadow: inset 0 0 0 2rpx currentColor;
  font-size: var(--cy-type-body);
  font-weight: 700;
  color: var(--ink);
}
.lp__clear.is-off { color: var(--sub); }
/* 打字题字符池的答案格:与逐字猜词的 .hm__cell 同形同色 */
.lp__slots { display: flex; flex-wrap: wrap; justify-content: center; gap: 14rpx; margin-top: var(--cy-space-4); }   /* ds-ok 与 .hm__word-row 同距 */
.lp__slot {
  flex: none;
  width: 68rpx;                            /* ds-ok 与 .hm__cell 同尺寸 */
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(var(--lk-ink-rgb, 255, 255, 255), .2);   /* ds-ok 与 .hm__cell 同一条描边 */
  border-radius: calc(var(--lk-r, 28rpx) / 2); /* ds-ok 与 .hm__cell 同一档圆角 */
  clip-path: var(--lk-cut, none);
  background: var(--soft);
  font-family: var(--lk-fm, var(--cy-font-numeric));
  font-size: var(--cy-type-sheet-title);
  font-weight: 700;
  color: var(--ink);
}
.lp__slot.is-next { border-color: var(--lk-a, var(--ink)); }
.lp__slot.is-wrong { border-color: var(--accent); }
.lp__slot.is-ok { background: var(--ok); border-color: var(--ok); color: var(--bg); }
