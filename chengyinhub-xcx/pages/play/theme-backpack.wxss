.theme-story-hud{display:flex;gap:30rpx;flex:1;align-items:center;align-self:flex-start;padding-top:18rpx;color:var(--cy-comp-sheet-role-text-secondary);font-size:var(--cy-type-body)}
.theme-hp,.theme-bag-entry{display:flex;align-items:center;gap:14rpx;min-height:72rpx}
.theme-bag-entry{min-width:88rpx}
.theme-heart{color:var(--cy-color-status-danger);font-size:var(--cy-type-section-title);line-height:1}
.theme-bag-icon{width:25rpx;height:30rpx;border:3rpx solid var(--cy-color-text-secondary);border-radius:7rpx;position:relative;margin:10rpx} /* ds-ok: 图标轮廓的小圆角 */
.theme-bag-icon:before{content:"";width:9rpx;height:8rpx;border:3rpx solid var(--cy-color-text-secondary);border-bottom:0;border-radius:5rpx 5rpx 0 0;position:absolute;top:-11rpx;left:5rpx} /* ds-ok: 图标轮廓的小圆角 */
.theme-bag-icon:after{content:"";left:4rpx;right:4rpx;bottom:4rpx;height:9rpx;position:absolute;border:2rpx solid var(--cy-color-text-secondary);border-radius:3rpx} /* ds-ok: 图标轮廓的小圆角 */
.chfull .fx-story__t.theme-chapter-nav{position:absolute;left:var(--cy-page-x);text-align:left;right:210rpx;font-size:var(--cy-type-body);line-height:40px}
.chfull .fx-story__t.theme-chapter-nav--preview{left:calc(var(--cy-page-x) + var(--cy-btn-h) + 16rpx)}
.tb-sheet{background:var(--cy-comp-sheet-role-glass);min-height:64vh;padding-top:28rpx;color:var(--cy-comp-sheet-role-text)}
.tb-slots{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12rpx;margin-bottom:36rpx}
.tb-slot{height:72rpx;border-radius:var(--cy-radius-sm);background:var(--cy-comp-sheet-role-surface)}
.tb-slot.is-filled{background:var(--cy-color-text-secondary)}
.tb-empty{padding:64rpx 0;color:var(--cy-comp-sheet-role-muted);text-align:center;font-size:var(--cy-type-body)}
.tb-item{display:flex;gap:24rpx;padding:28rpx 0;border-bottom:1rpx solid var(--cy-comp-sheet-role-divider)}
.tb-image{width:120rpx;height:120rpx;flex:none;border-radius:var(--cy-radius-md);background:var(--cy-comp-sheet-role-surface)}
.tb-copy{flex:1;min-width:0}
.tb-name{display:block;font-size:var(--cy-type-body);font-weight:600}
.tb-purpose{display:block;font-size:var(--cy-type-label);line-height:1.6;color:var(--cy-comp-sheet-role-muted);margin-top:10rpx}
.tb-actions{display:flex;gap:16rpx;margin-top:18rpx}
.tb-button{display:flex;align-items:center;justify-content:center;min-height:72rpx;padding:0 28rpx;border-radius:var(--cy-radius-pill);color:var(--cy-color-action-primary-fg);background:var(--cy-comp-sheet-role-text);font-size:var(--cy-type-label)}
.tb-button--muted{background:var(--cy-color-bg-elevated);color:var(--cy-comp-sheet-role-text-secondary)}
.tb-button.is-busy{opacity:.4;pointer-events:none}
.tb-clue{margin-bottom:36rpx}
.tb-clue image{width:100%;border-radius:var(--cy-radius-md);margin-top:22rpx}
.tb-clue-copy{display:block;margin:20rpx 0;font-size:var(--cy-type-body);line-height:1.8;color:var(--cy-comp-sheet-role-text-secondary)}
.tb-pending{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;color:var(--cy-comp-sheet-role-muted);font-size:var(--cy-type-label)}
.tb-error{color:var(--cy-comp-sheet-role-text-secondary);padding:20rpx 0;font-size:var(--cy-type-label);min-height:72rpx}

.tb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}
.tb-grid .tb-item{display:block;padding:26rpx;background:var(--cy-comp-sheet-role-surface);border:0;border-radius:var(--cy-radius-lg)}
.tb-grid .tb-image{width:72rpx;height:72rpx;margin-bottom:22rpx}
.tb-grid .tb-button{padding:0 18rpx;min-height:64rpx}
.tb-grid .tb-name{font-size:var(--cy-type-body)}
.tb-grid .tb-purpose{min-height:72rpx}
.tb-grid .tb-actions{flex-wrap:wrap}
.tb-switcher{margin-bottom:36rpx;--cy-text-title:var(--cy-comp-sheet-role-text);--cy-text-secondary:var(--cy-comp-sheet-role-muted)}
