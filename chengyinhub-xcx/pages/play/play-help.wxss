@import "/style/morph-mark.wxss";
@import "/style/motion-entry.wxss";
/* UG-05..09 提示阶梯:在案件册行样式上只补状态色与内容块。 */
.phl__left{display:block;font-size:var(--cy-type-body);color:var(--cy-comp-sheet-player-muted);margin:calc(-1 * var(--cy-space-3)) 0 var(--cy-space-4)}
.phl__row{min-height:88rpx;box-sizing:border-box}
.phl__row.is-off .tb-name{color:var(--cy-comp-sheet-player-muted)}
.phl__content{display:block;margin-top:var(--cy-space-2);font-size:var(--cy-type-body);line-height:1.6;overflow-wrap:anywhere}
.phl__img{display:block;width:100%;margin-top:var(--cy-space-2);border-radius:var(--cy-radius-md)}
.phl__err{display:block;margin-top:var(--cy-space-1);font-size:var(--cy-type-label);color:var(--cy-color-status-danger)}
.phl__act--free,.phl__act--review{color:var(--cy-comp-sheet-player-text)}
.phl__danger{color:var(--cy-color-status-danger)}
.phl__chev{flex:none;width:16rpx;height:16rpx;border-right:3rpx solid var(--cy-comp-sheet-player-muted);border-bottom:3rpx solid var(--cy-comp-sheet-player-muted);transform:rotate(45deg);transition:transform .2s ease}
.phl__chev.is-open{transform:rotate(-135deg)}
@media (prefers-reduced-motion: reduce){.phl__chev{transition:none}}
/* qx-u3 morph:行尾动作原位收成转圈 → 勾;转圈复用本页已有的 spin。 */
.phl__act-box{position:relative;flex:none;display:flex;align-items:center;justify-content:flex-end;min-width:88rpx;min-height:88rpx}
.phl__act{transition:opacity var(--cy-motion-fast) var(--cy-ease-out)}
.phl__act.is-morph{opacity:0}
.phl .cy-mm{--cy-mm-fg:var(--cy-comp-sheet-player-text);left:auto;right:24rpx;margin-left:0}
.phl .cy-mm__spin{animation:spin var(--cy-motion-spinner-cycle) linear infinite}
@media (prefers-reduced-motion: reduce){.phl__act{transition:none}.phl .cy-mm__spin{animation:none}}
/* a1-v3-21 提示 = 居中弹窗:压暗 + 居中卡片(玩家弹层 token 面 + 发丝描边),最高 80% 屏高,内容多时卡内滚动 */
.phl-pop{position:fixed;left:0;top:0;right:0;bottom:0;z-index:var(--cy-z-modal);display:flex;align-items:center;justify-content:center;animation:fade var(--cy-motion-sheet-in) var(--cy-ease-standard)}
.phl-pop-mask{position:absolute;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.62)} /* ds-ok 与站点卡压暗同值 */
.phl-pop__card{position:relative;width:calc(100% - 2 * var(--cy-page-x));max-height:80vh;box-sizing:border-box;padding:0 var(--cy-space-4);border-radius:var(--cy-radius-xl);background:var(--cy-comp-sheet-player-glass);box-shadow:0 0 0 1rpx var(--cy-comp-sheet-player-border-strong)}
.phl-pop .tb-sheet{min-height:0;padding-bottom:var(--cy-space-4)}
@media (prefers-reduced-motion: reduce){.phl-pop{animation:none}}

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.phl__row { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
