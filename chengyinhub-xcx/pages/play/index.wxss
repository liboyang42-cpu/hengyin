.fx-hero__hdr-c{ flex:1; min-width:0; }
.fx-hero__hdr-n{ font-size:var(--cy-type-label); font-weight:700; color:var(--cy-color-text-primary); }
.fx-hero__hdr-m{ font-size:var(--cy-type-micro); color:var(--cy-color-text-tertiary); }
.fx-hero__hold{ width:100%; }   /* 正文顶部占位:高度 = 卡片占的那一段,由 JS 给 */
.fx-hero__back{ position:absolute; left:var(--cy-page-x); z-index:3; width:var(--cy-btn-h); height:var(--cy-btn-h);
  border-radius:var(--cy-radius-pill); display:flex; align-items:center; justify-content:center;
  background:rgba(0,0,0,.42); color:var(--cy-color-text-primary); /* ds-ok 压在图上的玻璃面,同商家页 mp-back */
  opacity:0; transition:opacity .2s ease-in; }
.fx-hero.is-open .fx-hero__back{ opacity:1; transition:opacity .3s ease-out .2s; }
/* ⚠️ 卡片本体不能有 overflow:hidden —— 它会把 3D 子层拍平成一张平面,侧脊和背面就没了。
   圆角与裁切下沉到每一个面上。 */
/* z-index 要高过正文滚动区:正文现在从顶栏下面就开始铺,盖住卡片就点不到也拖不动了 */
.fx-hero__card{ position:absolute; z-index:4; perspective:1100rpx;
