@import "./theme-backpack.wxss";
@import "./theme-player-ops.wxss";
@import "./play-overlays.wxss";
@import "/style/proto-icons.wxss";
@import "/style/proto-sheet.wxss";
@import "/style/proto-shopstrip.wxss";
/* 城瘾 · 游玩页(深色地图沉浸版) —— 视觉真值见 docs/游玩页-深色地图沉浸版-对接说明.md
 *
 * DS v2 迁移(Batch 2 · Immersive · 模板库 §7):
 * · 地图/chrome 层(章节条/下一站卡/Sheet/通关/空态/错误/权限/退出)一律读 --cy-color-* 语义 token;
 * · 叙事沉浸层(章节过场/游戏启动·进行/徽章/终章/手记)统一为中性黑白阅读系 —— 见下方 .play 内的
 *   --play-narr-* 集中定义。
 */
page { background: var(--cy-color-bg-page); }
.play-scene-host { position:relative; z-index:130; } /* ds-ok 场景弹层须盖住故事与玩法层 */
.play { position:relative; width:100vw; height:100vh; overflow:hidden; /* ds-ok Figma 实测(用户裁决字面值) */
  background:var(--cy-color-play-page); color:var(--cy-color-text-primary); /* ds-ok Figma 实测(用户裁决字面值) */
  --cy-color-bg-page:var(--cy-color-play-page); --cy-color-bg-surface:var(--cy-color-play-surface-base); --cy-color-bg-surface-subtle:var(--cy-color-play-surface-subtle); /* ds-ok Figma 实测(用户裁决字面值) */
  --cy-color-bg-elevated:var(--cy-color-play-elevated); --cy-color-bg-glass:var(--cy-color-play-surface); --cy-color-text-inverse:var(--cy-color-play-ink); /* ds-ok Figma 实测(用户裁决字面值) */
  font-family:-apple-system,"PingFang SC","Noto Sans SC",sans-serif; /* ds-ok Figma 实测(用户裁决字面值) */
  /* Scale+Dim 的 Scale 半边:剧情全屏叙事页打开时整页缩到 0.94 并带上圆角,
     露出四周页底色,让前景看起来是「叠」在背景上(见 13_剧情弹窗.mp4 推荐档)。
     时长/曲线与 cy-story-sheet 内的前景动画一致,两边必须同步改。 */
  transition:transform 360ms cubic-bezier(0.32, 0.72, 0, 1), border-radius 360ms cubic-bezier(0.32, 0.72, 0, 1); /* ds-ok Figma 实测(用户裁决字面值) */

  /* ===== 沉浸叙事层专用色板(页面级特化,迁移矩阵 §2.3「沉浸表面」)=====
   * 章节过场/游戏/徽章/终章/手记统一使用中性灰阶,与三模式的黑白 chrome 保持一致。
   * 手记沉降色阶在 index.js 的 SINK 中与这里逐值对应。
   * ⚠ 集中定义于此,页面内不再散落字面值;真源若改版只改这一处。
   * ⚠ 逃生口只给刻意装饰值:原「材料/选项键/步骤标」用的更暗一档灰实测仅 2.77–3.13:1,
   *   且不在真源色板内 = 设计错误,已并入 --play-narr-text-dim(6.29:1),不豁免。 */
  --play-narr-bg:          #080808;  /* ds-ok 真源§0 深色底 */
  --play-narr-surface:     #1A1A1A;  /* ds-ok 真源§0 深色面 */
  --play-narr-surface-2:   #242424;  /* ds-ok 真源§0 深色面2 */
  --play-narr-well:        #121212;  /* ds-ok 扫码/拍照凹槽,较面更沉 */
  --play-narr-text:        #C4C4C4;  /* ds-ok 真源§0 正文 */
  --play-narr-text-strong: #D9D9D9;  /* ds-ok 真源§0 手记正文 */
  --play-narr-text-dim:    #999999;  /* ds-ok 真源§0 次要/轻标签 */
  --play-narr-text-faint:  #858585;  /* ds-ok 真源§0 沉降起点 */
  --play-narr-fog:         #555555;  /* ds-ok 手记「雾中的前路」,低对比为防剧透的设计意图 */

} /* ds-ok Figma 实测(用户裁决字面值) */
.play--reduced-motion, /* ds-ok Figma 实测(用户裁决字面值) */
.play--reduced-motion view, /* ds-ok Figma 实测(用户裁决字面值) */
.play--reduced-motion text,
.play--reduced-motion image, /* ds-ok Figma 实测(用户裁决字面值) */
.play--reduced-motion button,
.play--reduced-motion scroll-view,
.play--reduced-motion swiper,
.play--reduced-motion swiper-item,
.play--reduced-motion canvas {
  animation: none !important;
  transition: none !important;
}
/* 剧情叙事页打开时的背景缩放态。数值取自 13_剧情弹窗.mp4 的 Scale+Dim 档(约 0.94)。
   注:.play--reduced-motion 已经把 transition 全局关掉,所以减弱动态效果时是直接跳到缩放态,
   不需要在这里再写一遍豁免。 */
.play--scaled { transform:scale(0.94); border-radius:var(--cy-radius-lg); }

.serif { font-family:Georgia,"Songti SC","Noto Serif SC",serif; }

/* ===== keyframes ===== */
@keyframes floatUp{0%{opacity:0;transform:translateY(36rpx)}100%{opacity:1;transform:translateY(0)}} /* ds-ok Figma 实测(用户裁决字面值) */
@keyframes stamp{0%{transform:scale(2.3) rotate(-14deg);opacity:0}55%{transform:scale(.88) rotate(4deg);opacity:1}100%{transform:scale(1) rotate(0)}} /* ds-ok Figma 实测(用户裁决字面值) */
@keyframes fly{0%{opacity:0;transform:translate(-50%,16rpx) scale(.8)}18%{opacity:1;transform:translate(-50%,0) scale(1.12)}100%{opacity:0;transform:translate(-50%,-340rpx) scale(1)}} /* ds-ok Figma 实测(用户裁决字面值) */
@keyframes sheetUp{0%{transform:translateY(105%)}100%{transform:translateY(0)}} /* ds-ok Figma 实测(用户裁决字面值) */
@keyframes fade{0%{opacity:0}100%{opacity:1}} /* ds-ok Figma 实测(用户裁决字面值) */
@keyframes confetti{0%{transform:translateY(-60rpx) rotate(0);opacity:1}100%{transform:translateY(1280rpx) rotate(560deg);opacity:0}} /* ds-ok Figma 实测(用户裁决字面值) */
@keyframes writeIn{0%{opacity:0;filter:blur(7px);transform:translateY(36rpx)}100%{opacity:1;filter:blur(0);transform:translateY(0)}} /* ds-ok Figma 实测(用户裁决字面值) */
@keyframes kb{0%{transform:scale(1.05)}100%{transform:scale(1.2) translate(-1.5%,-2.5%)}}
@keyframes spin{100%{transform:rotate(360deg)}}
/* ===== glass chrome ===== */
.glass{ background: var(--cy-color-play-surface); border:1rpx solid var(--cy-color-play-line);
  box-shadow:inset 0 1rpx 0 rgba(255,255,255,.08); /* ds-ok 刻意:玻璃顶边高光,inset 描边非表面色,token 层无对应 */ }
.preview-back {
  position: fixed;
  left: var(--cy-space-3-5);
  z-index: var(--cy-z-modal);
  border-radius: var(--cy-radius-pill);
  width: var(--cy-btn-h);
  height: var(--cy-btn-h);
  display:flex;
  align-items:center;
  justify-content:center;
  color: var(--cy-color-text-primary);
}



/* 顶部栈:唯一一处定位。状态条与 topBanner 槽纵向排队,起点 = 微信胶囊底缘(内联 chrome.contentTop)。
   pointer-events 只在子层打开,不然这块透明区会吃掉地图手势。 */
.play-topstack{ position:absolute; left:var(--cy-space-3-5); right:var(--cy-space-3-5); z-index:40;
  display:flex; flex-direction:column; gap:var(--cy-space-2); pointer-events:none; }
.play-topstack > view{ pointer-events:auto; }

/* 地图右侧常驻核销钮:两个模式都需要,所以不进底栏那排跟模式相关的动作挤 */
.pscan{ position:absolute; right:var(--cy-page-x); z-index:41; /* ds-ok Figma 实测(用户裁决字面值) */
  bottom:calc(240rpx + var(--cy-space-3) + 246rpx + var(--cy-space-2) + env(safe-area-inset-bottom)); /* ds-ok Figma 实测(用户裁决字面值) */
  width:134rpx; height:134rpx; border-radius:var(--cy-radius-pill); /* ds-ok Figma 实测(用户裁决字面值) */
  background:var(--cy-color-play-surface-solid); border:1rpx solid var(--cy-color-play-line); /* ds-ok Figma 实测(用户裁决字面值) */
  display:flex; align-items:center; justify-content:center; color:var(--cy-color-text-primary); /* ds-ok Figma 实测(用户裁决字面值) */
  box-shadow:0 4rpx 24rpx rgba(0,0,0,.5); } /* ds-ok 压地图的浮钮投影 */

/* 原型 .trio 是**浮在地图上**的:position:absolute;bottom:20px;height:100px,没有底色也没有上边线。
   现码原来是一条 #0D0E12 的实心条 + 上边线(旧 Figma 稿),照原型去掉 ——
   漫游那边上一批已经这么改过,这里补上城市定向与自由探索。 */
.pbar{ position:absolute; left:0; right:0; z-index:40;
  bottom:calc(38rpx + env(safe-area-inset-bottom)); /* ds-ok 原型 .trio bottom:20px */
  background:transparent; border-top:0; pointer-events:none; }
.pbar > view{ pointer-events:auto; }
/* 这条横杠是「上滑出更多」的语义(设计稿 3959:12987 就是它展开后的工具抽屉),点它开游玩工具。
   顶部那张 cy-play-header 删掉后,玩法说明/动态效果/队长工具的唯一入口就在这里。 */
/* ★ 三键上方那根横条逐条照原型 .grabhit / .grabhit span 抄:
   44×4 · radius 2 · 白 32%(现码是 76×12 的 #4A5565,又粗又实)。
   命中区 26px = 50rpx 高,居中。 */
.pbar__grab{ width:85rpx; height:8rpx; border-radius:4rpx; /* ds-ok 原型 44×4 / radius 2 */
  background:rgba(255,255,255,.32); } /* ds-ok 原型 .grabhit span */
.pbar__grabhit{ height:50rpx; display:flex; align-items:center; justify-content:center; } /* ds-ok 原型 .grabhit 26px */
/* 稿上三个圆的圆心在同一条水平线上(中键 64/top4、侧键 56/top8),不是顶端对齐 ——
   顶端对齐会让大一号的中键整体下沉,文字基线跟着错开。 */
/* ★ 三键逐条照原型 .trio/.tbtn 抄(2026-09-09 用户裁决:所有页面与 HTML 一模一样)。
   原型 390px 机身 → 750rpx,1px = 1.923rpx。与 roam 页同一份口径,两页必须一致。
   ⚠️ 这里推翻了几个原先标着「Figma 实测」的值 —— Figma 板与 HTML 原型对不上时,以 HTML 为准:
     排布   居中 + gap 64px = 123rpx(原来是 space-around,间距跟着屏宽跑)
     主键绿 #22C55E(原 #00B503)   主键字 #4ADE80 700(原 #00B503 600)
     暂停橙 #F97316(原 #F75707)   暂停字 #F97316 700(原 #F75707 600)
     侧键   一律白底深字(原来未开始态是 #999999 灰底,原型没有这一态)
     标签   11px = 21rpx           ic↔lb 间距 7px = 13rpx */
.pbar__trio{ display:flex; align-items:center; justify-content:center; gap:123rpx; padding:var(--cy-space-2) var(--cy-page-x) 0; }
.pact{ display:flex; flex-direction:column; align-items:center; gap:13rpx; } /* ds-ok 原型 .tbtn gap:7px */
.pact__glyph{ width:46rpx; height:46rpx; } /* ds-ok 原型 IC 的 24px */
.pact__glyph--main{ width:46rpx; height:46rpx; }
.pact__ic{ width:108rpx; height:108rpx; border-radius:var(--cy-radius-pill); /* ds-ok 原型 56px */
  display:flex; align-items:center; justify-content:center;
  background:#FFFFFF; color:#1A1A1A; transition:transform .1s; } /* ds-ok 原型 .tbtn .ic */
.pact__ic--main{ width:123rpx; height:123rpx; } /* ds-ok 原型 .tbtn.main .ic 64px */
.pact__ic.is-go{ background:#22C55E; color:#FFFFFF; } /* ds-ok 原型 var(--green) */
.pact__ic.is-pause{ background:#F97316; color:#FFFFFF; } /* ds-ok 原型 var(--orange) */
/* 原型 .tbtn.main.pause:active .ic{background:var(--green)} —— 按下去先给「继续」的颜色 */
.pact--main:active .pact__ic.is-pause{ background:#22C55E; } /* ds-ok 原型同款 */
.pact__l{ font-size:21rpx; color:#99A1AF; } /* ds-ok 原型 .tbtn .lb 11px */
.pact__l.is-go-t{ color:#4ADE80; font-weight:700; } /* ds-ok 原型 var(--green-l) */
.pact__l.is-pause-t{ color:#F97316; font-weight:700; } /* ds-ok 原型 var(--orange) */
/* 长按 3 秒结束:两个半圆各扫 180° 拼成一整圈描边。
   进度由 JS 的 runHoldPct 直接驱动 rotate,不走 CSS 动画 —— 松手要能停在半路,
   动画一旦跑起来就停不到准确角度上。 */
.pact__ic--main{ position:relative; }
/* 原型 .tbtn .hold:74px 见方(比 64px 的主键每边多 5px),白色 4px 描边的弧,
   满了整枚转红。环体是 border 不是填充块 —— 那才是原型那道细描边,不是一整片白。 */
.hold{ position:absolute; left:-10rpx; top:-10rpx; width:142rpx; height:142rpx; pointer-events:none; }
.hold__h{ position:absolute; top:0; width:71rpx; height:142rpx; overflow:hidden; }
.hold__h--r{ right:0; }
.hold__h--l{ left:0; }
.hold__f{ position:absolute; top:0; width:142rpx; height:142rpx; box-sizing:border-box;
  border:8rpx solid #FFFFFF; border-radius:var(--cy-radius-pill); } /* ds-ok 原型 stroke:#fff stroke-width:4 */
.hold__h--r .hold__f{ left:0; transform-origin:71rpx 71rpx; }
.hold__h--l .hold__f{ right:0; transform-origin:71rpx 71rpx; }
/* 满圈变红 = 已经结束,松手也拦不住。原型 .tbtn.holdfull:环转 var(--red),整枚也转红。 */
.pact__ic--main.is-holdfull{ background:#EF4444 !important; } /* ds-ok 原型 var(--red) */
.pact__ic--main.is-holdfull .hold__f{ border-color:#EF4444; } /* ds-ok 同上 */

/* 正式图标库没有暂停图标时直接写明「暂停」，避免用 CSS 伪造双竖条。 */
.gp2__audio-pause{ font-size:var(--cy-type-micro); font-weight:700; }

.banner{ position:absolute; left:var(--cy-space-3-5); right:var(--cy-space-3-5); bottom:calc(var(--cy-space-4) + env(safe-area-inset-bottom)); z-index:40; background: var(--cy-color-bg-glass); /* ds-ok Figma 实测(用户裁决字面值) */
  border:1rpx solid var(--cy-color-border-subtle); border-radius:44rpx; /* ds-ok Figma 实测(用户裁决字面值) */
  padding:34rpx; text-align:center; box-shadow:0 36rpx 80rpx rgba(0,0,0,.5); /* ds-ok 刻意:浮卡压地图需要投影,--cy-shadow-card 暗端为 none */ }
.banner .b1{ font-size: var(--cy-type-caption); letter-spacing:3rpx; color: var(--cy-color-text-tertiary); } /* ds-ok Figma 实测(用户裁决字面值) */
.banner .b2{ font-size: var(--cy-type-section-title); font-weight:500; margin-top:var(--cy-legacy-6); color: var(--cy-color-text-primary); } /* ds-ok Figma 实测(用户裁决字面值) */

.flyscore{ position:absolute; left:50%; top:600rpx; z-index:60; color: var(--cy-color-play-accent); font-size:68rpx; font-weight:500; /* ds-ok 飞分数字为瞬时展示字号 */
  animation:fly 1.1s ease-out forwards; pointer-events:none; text-shadow:0 4rpx 32rpx rgba(255,255,255,.5); /* ds-ok 刻意:飞分辉光,text-shadow 需带 alpha 的字面值 */ }
.lockhint{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); z-index:65; max-width:520rpx; text-align:center; /* ds-ok Figma 实测(用户裁决字面值) */
  background: var(--cy-color-bg-elevated); border:1rpx solid var(--cy-color-border-strong); border-radius: var(--cy-radius-lg); padding:var(--cy-space-4) var(--cy-space-4); /* ds-ok Figma 实测(用户裁决字面值) */
  animation:fade .25s ease; pointer-events:none; } /* ds-ok Figma 实测(用户裁决字面值) */
.lockhint text{ font-size: var(--cy-type-body); line-height:1.7; color: var(--cy-color-text-secondary); } /* ds-ok Figma 实测(用户裁决字面值) */
/* M2 夜间提示(自玩 22:00–06:00):落在飞分下方,与 lockhint 同款瞬时层 —— 纯展示、不吃点击 */
.nighthint{ position:absolute; left:50%; top:760rpx; transform:translateX(-50%); z-index:60; max-width:600rpx; text-align:center;
  background: var(--cy-color-bg-elevated); border:1rpx solid var(--cy-color-border-strong); border-radius: var(--cy-radius-pill);
  padding:var(--cy-space-2) var(--cy-space-4); font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary);
  pointer-events:none; animation:fade .25s ease; }

/* ===== node sheet ===== */
/* ★ 半屏与压暗层逐条照原型 .sheet / .dim 抄
 * (2026-09-09 用户裁决:所有页面与 HTML 一模一样)。1px = 1.923rpx。
 * 推翻的值:
 *   压暗 62% 黑(原型 .dim rgba(0,0,0,.62));原来读的是 --cy-color-overlay
 *   面底 纯黑 #000(原型 .sheet background:#000);原来读的是 --cy-color-bg-surface
 *   圆角 52rpx → 54rpx(原型 28px)· 去掉顶部那条 1px 描边(原型没有)
 *   左右 24px = 46rpx、底 22px = 42rpx 的内边距由 .sheet-body 承担(原型 .sheet 自带) */
.mask.mask--story{z-index:108;} /* ds-ok 地点详情覆盖故事层106 */
.sheet.sheet--story{z-index:109;} /* ds-ok 地点详情位于遮罩上 */
.mask{ position:absolute; left:0; top:0; right:0; bottom:0; z-index:108;
  background:rgba(0,0,0,.62); animation:fade var(--cy-motion-sheet-full-in) var(--cy-ease-standard); } /* ds-ok 原型 .dim;2026-10-23 与面板同档同曲线(原 .25s) */
.sheet{ position:absolute; left:0; right:0; bottom:0; z-index:109; background:#000000; /* ds-ok 原型 .sheet */
  border-radius:var(--cy-comp-sheet-radius) var(--cy-comp-sheet-radius) 0 0; /* ds-ok 原型 28px */
  /* 88% 在刘海机上顶边会落进胶囊行(12% 高≈101px vs 胶囊底≈103px)——与 .psheet 同法,页面根给实测值,取两者较小 */
  height:min(var(--cy-comp-sheet-full), var(--cy-psheet-max-h, var(--cy-comp-sheet-max-height))); max-height:min(var(--cy-comp-sheet-full), var(--cy-psheet-max-h, var(--cy-comp-sheet-max-height))); overflow-y:auto; animation:sheetUp var(--cy-motion-sheet-full-in) var(--cy-ease-standard); }
/* 2026-10-23 弹层动效:手动关闭先播退场再卸载(index.js 的 _outThen);面板 full 档 280ms,遮罩同档 */
.mask.is-out{ animation:none; opacity:0; transition:opacity var(--cy-motion-sheet-full-out) var(--cy-ease-standard); pointer-events:none; }
.sheet.is-out{ animation:none; transform:translateY(105%); transition:transform var(--cy-motion-sheet-full-out) var(--cy-ease-standard); pointer-events:none; }
.play--reduced-motion .mask, .play--reduced-motion .sheet{ animation:none; }
.sheet-cover{ position:relative; height:364rpx; background: var(--cy-color-bg-elevated); display:flex; align-items:center; justify-content:center; }
.sheet-cover image{ width:100%; height:100%; position:absolute; inset:0; } /* ds-ok Figma 实测(用户裁决字面值) */
/* 原占位字在封面底上实测 3.68:1,不达 4.5 ⇒ 收编 text-tertiary(4.72:1) */
.cover-tip{ font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); } /* ds-ok Figma 实测(用户裁决字面值) */
.cover-tag{ position:absolute; top:var(--cy-space-3-5); left:var(--cy-space-4); background: var(--cy-color-bg-glass); border:1rpx solid var(--cy-color-border-subtle);
  border-radius:26rpx; padding:var(--cy-legacy-10) var(--cy-space-3); font-size: var(--cy-type-label); letter-spacing:2rpx; } /* ds-ok: border-radius 26rpx 无精确匹配圆角 token */
.cover-photos{ position:absolute; right:var(--cy-space-3); bottom:var(--cy-space-3); background: var(--cy-color-bg-glass); border:1rpx solid var(--cy-color-border-strong); /* ds-ok Figma 实测(用户裁决字面值) */
  border-radius:var(--cy-radius-pill); padding:var(--cy-space-1) var(--cy-space-2-5); font-size: var(--cy-type-caption); color: var(--cy-color-text-primary); display:flex; align-items:center; gap:var(--cy-space-1); }
