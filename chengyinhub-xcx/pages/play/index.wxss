.fx-hero.is-open .fx-hero__card{
  transform:translate(var(--hx,0px), var(--hy,0px)) scale(calc(var(--hs,1) * var(--ss,1)));
  transform-origin:0 0; }
/* 落位之后把过渡收短:.42s 是给飞入用的,滚动驱动的变化挂上它会拖影 */
.fx-hero__card.is-landed{ transition:transform .1s linear, opacity .18s ease; }
.fx-hero__card.is-faded{ opacity:0; pointer-events:none; }
.fx-hero__card.is-done{ filter:grayscale(1) brightness(.72); }  /* 同 fx-tile.is-done */
/* 卡盒:--T 是厚度,左右两条侧脊按它立起来 */
.fx-card3d{ position:absolute; left:0; top:0; width:100%; height:100%; --T:12rpx;   /* 侧脊上已经不写字了,厚度只需要「看得出这是一张有厚度的卡」,不必再留 22rpx */
  transform-style:preserve-3d; transform:rotateY(var(--ry,0deg)); }
/* 浮动**不碰 rotateY**:它和 --ry 写在同一个 transform 里就会打架 ——
   跟手拖动时 --ry 在变,而动画是从自己的起始值跑的,画面会顿。
   所以浮动放在外面这层,只做上下起伏与极小的俯仰。 */
.fx-card3d__float{ position:absolute; left:0; top:0; width:100%; height:100%; transform-style:preserve-3d; }
.fx-card3d__float.is-settled{ animation:fxCardFloat 5.6s ease-in-out infinite; }
@keyframes fxCardFloat{ 0%,100%{ transform:translateY(0) rotateX(2deg); }
  50%{ transform:translateY(-10rpx) rotateX(-2deg); } }
.play--reduced-motion .fx-card3d__float{ animation:none; }
.fx-card3d__face{ position:absolute; left:0; top:0; width:100%; height:100%; overflow:hidden;
  border-radius:var(--cy-radius-lg); backface-visibility:hidden;
  background:var(--cy-color-play-surface-solid);
  box-shadow:0 30rpx 80rpx rgba(0,0,0,.55); } /* ds-ok 浮起后投影加深 */
.fx-card3d__front{ transform:translateZ(calc(var(--T) / 2)); }
.fx-card3d__back{ transform:rotateY(180deg) translateZ(calc(var(--T) / 2));
  padding:var(--cy-space-4); display:flex; flex-direction:column; gap:var(--cy-space-3); }
.fx-card3d__bh{ font-size:var(--cy-type-micro); font-weight:700; letter-spacing:2rpx;
  color:var(--cy-color-text-tertiary); }
/* ⚠️ 背面不能用正文字号:这张卡只有屏幕一半宽,28rpx 铺上去一行没几个字、
   三段就把卡撑爆。样机是 13px 配 240px 宽的卡,按同一比例落到 22rpx。 */
.fx-card3d__bp{ font-size:var(--cy-type-caption); line-height:1.8; color:var(--cy-color-text-secondary); }
/* 侧脊:立在卡片两边,竖排店名与章节 —— 这是「有厚度」唯一看得见的地方 */
/* 侧脊压暗:用提亮色时,卡片正对镜头那一刻它会从边缘漏出一条亮边,看着像给卡片描了边。
   上下按圆角内缩:卡面是 32rpx 圆角,侧脊铺满全高会从圆角外面探出两个尖。 */
.fx-card3d__side{ position:absolute; top:var(--cy-radius-lg); bottom:var(--cy-radius-lg); width:var(--T);
  background:var(--cy-color-bg-surface); }
.fx-card3d__side--l{ left:calc(var(--T) / 2); transform-origin:left center; transform:rotateY(-90deg) translateZ(calc(var(--T) / 2)); }
.fx-card3d__side--r{ right:calc(var(--T) / 2); transform-origin:right center; transform:rotateY(90deg) translateZ(calc(var(--T) / 2)); }
/* 卡面只放照片,不写字(用户 2026-09-08:卡片上的字小到看不清,章节名与介绍都归背面) */
.fx-hero__im{ position:absolute; left:0; top:0; width:100%; height:100%; }
.fx-hero__ph{ position:absolute; left:0; right:0; top:0; bottom:0; display:flex;
  align-items:center; justify-content:center; color:var(--cy-color-text-tertiary); }
/* 正文:absolute 从卡片底边(JS 算好的 bodyTop)排到 CTA 之上,自己滚 */
.fx-hero__body{ position:absolute; left:0; right:0; z-index:2;
  bottom:calc(var(--cy-btn-h) + 104rpx + env(safe-area-inset-bottom));
  padding:0 var(--cy-page-x); box-sizing:border-box; }
/* ⚠️ 上下都要淡出。只在下边淡出时,它的**上边**是一条 .92 的硬边,
   而卡片比屏幕窄,那条硬边会从卡片两侧露出来,看着就是一条横向分界线(实拍抓到)。 */
.fx-hero__chips{ display:flex; flex-wrap:wrap; align-items:center; gap:10rpx; }
.fx-hero__stt{ padding:6rpx 16rpx; border-radius:var(--cy-radius-pill); font-size:19rpx; font-weight:700; /* ds-ok 同 fx-tile__st 角标字号 */
  background:rgba(255,255,255,.92); color:#101828; } /* ds-ok 同 fx-tile__st:白底深字 */
.fx-hero__name{ margin-top:var(--cy-space-3); font-size:44rpx; font-weight:700; line-height:1.25; /* ds-ok 与 fx-claim 同级:这一屏的主角 */
  color:var(--cy-color-text-primary); }
.fx-hero__play{ margin-top:var(--cy-space-1); font-size:var(--cy-type-body); color:var(--cy-color-text-secondary); }
.fx-hero__desc{ margin-top:var(--cy-space-3); font-size:var(--cy-type-body); line-height:1.6;
  color:var(--cy-color-text-secondary); }
.fx-hero__addr{ margin-top:var(--cy-space-3); display:flex; align-items:center; gap:10rpx;
  font-size:var(--cy-type-caption); color:var(--cy-color-text-tertiary); }
/* 卡片详情三段(章节 / 店铺 / 游戏)。正文直接写在背景上,不套面板 ——
   只有店铺那一块是卡片,因为它可点进分身对话,得看得出来是个可点的对象。 */
.fx-hero__ey{ margin-top:var(--cy-space-2); font-size:var(--cy-type-caption); font-weight:700;
  letter-spacing:4rpx; color:var(--cy-color-text-tertiary); }
.fx-hero__ey--gap{ margin-top:var(--cy-space-6); }
.fx-hero__hook{ margin-top:var(--cy-space-3); font-size:var(--cy-type-caption); line-height:1.7;
  color:var(--cy-color-text-secondary); }
.fx-hero__hook-k{ margin-right:12rpx; font-size:var(--cy-type-micro); font-weight:700;
  letter-spacing:2rpx; color:var(--cy-color-text-primary); }   /* 样机这里是暖金,玩家端单色契约不许品牌色,只靠字重与字号分层 */
.fx-hero__gm{ margin-top:var(--cy-space-3); display:flex; flex-wrap:wrap; gap:12rpx 32rpx; }
.fx-hero__gm-i{ display:flex; align-items:center; gap:10rpx;
  font-size:var(--cy-type-caption); color:var(--cy-color-text-secondary); }
.fx-hero__k{ margin-top:var(--cy-space-4); font-size:var(--cy-type-caption); font-weight:700;
  color:var(--cy-color-text-tertiary); }
/* 列表按样机带记号:怎么玩是序号、需要准备是圆点 —— 裸行读不出「这是几条」 */
.fx-hero__li{ margin-top:var(--cy-space-2); display:flex; gap:12rpx;
  font-size:var(--cy-type-body); line-height:1.7; color:var(--cy-color-text-secondary); }
.fx-hero__li-n{ flex:none; width:36rpx; color:var(--cy-color-text-tertiary); }
.fx-hero__li-t{ flex:1; min-width:0; }
/* 「小瘾说」那一句:样机里是独立一档,比正文再淡一点、标签更小 */
.fx-hero__hook{ font-size:var(--cy-type-caption); }
/* 店铺卡 */
.fx-shop{ margin-top:var(--cy-space-3); border-radius:var(--cy-radius-lg);
  background:rgba(255,255,255,.06); overflow:hidden; }  /* ds-ok 玻璃层上的一层浅提亮,不是实色面板 */
.fx-shop__top{ display:flex; align-items:center; gap:var(--cy-space-3); padding:var(--cy-space-3); }
.fx-shop__th{ flex:none; width:96rpx; height:96rpx; border-radius:var(--cy-radius-md); }
.fx-shop__c{ flex:1; min-width:0; }
.fx-shop__n{ font-size:var(--cy-type-body); font-weight:700; color:var(--cy-color-text-primary); }
.fx-shop__m{ margin-top:6rpx; display:flex; align-items:center; gap:8rpx;
  font-size:var(--cy-type-caption); color:var(--cy-color-text-tertiary); }
.fx-shop__off{ color:var(--cy-color-text-tertiary); }
.fx-shop__npc{ margin-top:6rpx; display:flex; align-items:center; gap:8rpx;
  font-size:var(--cy-type-caption); color:var(--cy-color-text-secondary); }
.fx-shop__ndot{ width:12rpx; height:12rpx; border-radius:50%; background:var(--cy-color-text-tertiary); }
.fx-shop__nav{ display:flex; align-items:center; gap:10rpx;
  margin:0 var(--cy-space-3); padding:var(--cy-space-3) 0;
  border-top:1rpx solid var(--cy-color-border-subtle); font-size:var(--cy-type-caption); }
.fx-shop__addr{ flex:1; min-width:0; color:var(--cy-color-text-secondary); }
.fx-shop__go{ font-weight:700; color:var(--cy-color-text-primary); }
/* 到店三步 */
.fx-step3{ margin-top:var(--cy-space-3); display:flex; flex-direction:column; gap:var(--cy-space-4); }
.fx-step{ display:flex; align-items:flex-start; gap:var(--cy-space-3); }
.fx-step__n{ flex:none; width:42rpx; height:42rpx; border-radius:50%;
  background:var(--cy-color-border-strong); color:var(--cy-color-text-secondary);
  font-size:var(--cy-type-caption); text-align:center; line-height:42rpx; }
.fx-step.is-ok .fx-step__n{ background:#00B503; color:var(--cy-color-text-inverse); } /* ds-ok 与分段环的已核销同色,同属 PLAY_STATE_COLORS */
.fx-step__t{ flex:1; font-size:var(--cy-type-body); line-height:1.6; color:var(--cy-color-text-secondary); }
/* 本店权益 */
.fx-perk{ margin-top:var(--cy-space-3); display:flex; align-items:flex-start; gap:var(--cy-space-3); }
.fx-perk__ic{ flex:none; width:80rpx; height:80rpx; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:var(--cy-color-bg-elevated); color:#F75707; }  /* ds-ok 权益橙,与到店三步的开始绿同属 PLAY_STATE_COLORS;
     底色保持中性 —— 单色契约的白名单只收十六进制状态色,染色的 rgba 底会被判红 */
.fx-perk__c{ flex:1; min-width:0; }
.fx-perk__n{ font-size:40rpx; font-weight:700; line-height:1.3; /* ds-ok 与 fx-hero__name 同级:这一段的主角 */
  color:var(--cy-color-text-primary); }
.fx-perk__m{ margin-top:var(--cy-space-2); display:flex; flex-wrap:wrap; gap:10rpx 32rpx; }
.fx-perk__m-i{ display:flex; align-items:center; gap:8rpx;
  font-size:var(--cy-type-caption); color:var(--cy-color-text-tertiary); }
/* 尾部留白只需盖住 CTA 渐隐压过来的那一点点。
   ⚠️ 别再按「要高过底栏本身」来给:.fx-hero__body 的 bottom 已经把容器底抬到按钮上方
   (btn-h + 104rpx),再垫一个 260rpx 就是**重复计一次**——实拍量到末行离按钮 168px,
   而样机(.body padding-bottom:140px,容器直落到屏底)只有 56px。
   CTA 盒顶 = btn-h + 124rpx,容器底 = btn-h + 104rpx,只有 20rpx 被压住,48rpx 足够。 */
.fx-hero__pad{ height:48rpx; }
/* 和故事流底栏同一条:上面 88rpx 渐隐、其下纯色。
   只用一条渐变「差不多压住」时,正文会从按钮底下透出来(故事流那边实拍抓到过)。 */
/* 只用渐隐,**不要实心黑块** —— 实心会在按钮下方糊出一整条,把正文挡掉一截。
   这一屏底部只有一颗不透明的主按钮,不存在「字从半透明按钮里透出来」那个问题
   (那是故事流的次按钮才有的,所以只有那边留了实心)。 */
.fx-hero__cta{ position:absolute; left:0; right:0; bottom:0; z-index:3; box-sizing:border-box;
  padding:96rpx var(--cy-page-x) calc(28rpx + env(safe-area-inset-bottom));
  background:linear-gradient(180deg, rgba(10,13,19,0) 0%, rgba(10,13,19,.86) 46%, rgba(10,13,19,.97) 100%); } /* ds-ok 渐隐到底色 */
/* 正文与 CTA 的入场:卡片飞到六成时开始,按 --i 每条错 70ms;收起时不排队,一起淡出 */
.fx-hero__in{ opacity:0; transform:translateY(24rpx); transition:opacity .16s ease-in, transform .16s ease-in; }
.fx-hero.is-open .fx-hero__in{ opacity:1; transform:translateY(0);
  transition:opacity .32s ease-out, transform .38s var(--cy-ease-out);
  transition-delay:calc(250ms + var(--i, 0) * 70ms); }
.play--reduced-motion .fx-hero__card, .play--reduced-motion .fx-hero__bg, .play--reduced-motion .fx-hero__in{ transition:none; }

/* ③ 章节剧情全屏故事流 ——————————————————————————————————————
   手感三条,缺一条就不是那个东西:①滚动中不显形,停下来那一刻才逐行浮起
   ②由虚到实、由小到大、上浮一行,带一点回弹 ③出屏复位,滚回来能重演。 */
.fx-story{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:106;
  background:var(--cy-color-bg-page); opacity:0; transition:opacity .26s ease; }
.fx-story.is-open{ opacity:1; }
.fx-story__dust{ position:absolute; left:0; right:0; top:0; bottom:0; width:100%; height:100%; }
.fx-story__dust--front{ z-index:3; pointer-events:none; }   /* 近景粒子压在字上,遮挡出景深 */
/* 顶栏要有自己的渐隐:正文是从它底下滚过去的,不压住就会把章节名和返回钮糊掉(实拍抓到) */
.fx-story__hd{ position:absolute; left:0; right:0; top:0; z-index:4; box-sizing:border-box;
  display:flex; align-items:center; gap:var(--cy-space-3);
  padding-left:var(--cy-page-x); padding-right:var(--cy-page-x); padding-bottom:88rpx; /* ds-ok 2026-09-24 渐隐尾巴拉长,正文不再从标题底下透出来 */
  background:linear-gradient(180deg, rgba(0,0,0,.97) 0%, rgba(0,0,0,.94) 64%, rgba(0,0,0,0) 100%); } /* ds-ok 顶部渐隐,与底栏成对 */
.fx-story__back{ flex:none; width:var(--cy-btn-h); height:var(--cy-btn-h); border-radius:50%;
  background:var(--cy-color-bg-elevated); display:flex; align-items:center; justify-content:center; }
/* 章节名居中:两侧各留一个和返回钮等宽的占位,标题才真在正中(样机同款) */
.fx-story__t{ flex:1; text-align:center; font-size:var(--cy-type-body); font-weight:700;
  color:var(--cy-color-text-primary); }
.fx-story__pad-r{ flex:none; width:var(--cy-btn-h); }
/* 图片块:和文字共用 .st-line 的入场动效,只是多一个尺寸与圆角 */
/* 故事流首块:章节标题。顶部那一大段留白原来是纯黑,把标题立在那儿 */
.st-line--ttl{ margin-bottom:260rpx; }   /* 标题到第一段比段间距近一档:它是这一段的抬头,不是独立一段 */
.st-line__meta{ font-size:var(--cy-type-caption); letter-spacing:3rpx; color:var(--cy-color-text-tertiary); }
.st-line__ttl{ margin-top:var(--cy-space-2); font-size:var(--cy-type-page-title); font-weight:700; line-height:1.35;
  color:var(--cy-color-text-primary); } /* ds-ok 故事流的章节大标题,比正文再高一档 */
/* 图片比正文更宽一点,和样机一样;高度按横构图给,不要撑成一整屏 */
.st-line--img{ display:block; width:auto; height:400rpx; margin:0 40rpx var(--cy-space-5);
  border-radius:var(--cy-radius-lg); }
.st-scroll{ position:absolute; left:0; right:0; top:0; bottom:0; z-index:2; }
/* 上下留白:样机 .stream 是 padding:40% 30px 86%,**它没有大标题**,第一段就落在 40%。
   我们按 9-07 口径在流首加了章节标题块,若仍留 44vh,标题 + 400rpx 段距会把第一段推到
   74%——一屏标题、底边挂半句话。收到 22vh 后:22vh + 标题 + 260rpx ≈ 44%,与样机同位,
   标题仍在第一段上方。 */
.fx-story__pad{ height:22vh; }
/* 段距与行距逐字对齐样机:当前原型 .st{ margin:0 48px 180px; line-height:1.95 }(2026-09-23 对齐,原为 200px)。
   180px = 360rpx —— 之所以这么大,是为了让屏幕上**同时只有一段**,
   这也是右下角那颗音乐键不会被正文压住的原因。我先只做到 72rpx,读起来就成了一片字。
   边距给行不给滚动容器:scroll-view 加 padding 会把内容框撑出屏幕。 */
/* 左右各留 96rpx:右侧那条是音乐键的通道(键宽 88rpx + 右边距 28rpx)。
   居中排版不能只加右边距 —— 那会把整段推偏,所以两边一起收。 */
.st-line{ margin:0 96rpx 360rpx; text-align:center;
  font-size:34rpx; line-height:1.95; color:var(--cy-color-text-primary); /* ds-ok 故事流正文比常规正文大一档 */
  opacity:0; transform:translateY(1.95em) scale(.78); filter:blur(22rpx);   /* ds-ok 样机 blur(11px);rpx→px 折半,22rpx≈11px */
  transition:opacity .5s ease, transform .5s cubic-bezier(.34,1.46,.5,1), filter .5s ease;
  transition-delay:var(--d, 0s); }   /* 同一批错开 50ms:一起亮就成了整块淡入 */
.st-line.from-top{ transform:translateY(-1.95em) scale(.78); }   /* 向上滚:从上方落下来 */
.st-line.is-in{ opacity:1; transform:translateY(0) scale(1); filter:blur(0); }
/* 这一章的音频:常驻右侧,不随正文滚动 */
/* 音乐键钉在右下(样机 .tmus:right:14px; bottom:150px)。
   之前它压住正文是因为段距只有 72rpx、屏幕上同时挤着好几段;
   段距回到样机的 400rpx 之后,这个角落基本恒空。随底栏一起收起/弹回。 */
/* 外壳只负责命中区(88rpx = 44px,无障碍下限),背景透明所以看不见;
   可见的圆是里面那层 72rpx。这样热区达标、视觉又不会重新压到正文上:
   文本列左右各 96rpx(=48px)⇒ 右边缘 327,可见圆左边缘 329,刚好让开。 */
.fx-story__aud{ position:absolute; right:12rpx; bottom:272rpx; z-index:5;
  width:88rpx; height:88rpx; display:flex; align-items:center; justify-content:center;
  transition:transform .26s var(--cy-ease-out), opacity .2s ease; }
.fx-story__aud-d{ width:72rpx; height:72rpx; border-radius:50%;
  background:var(--cy-color-bg-elevated); color:var(--cy-color-text-primary);
  display:flex; align-items:center; justify-content:center; }
.fx-story__aud.is-on .fx-story__aud-d{ background:var(--cy-color-text-primary); color:var(--cy-color-text-inverse); }
.fx-story__aud.is-away{ transform:translateY(40rpx); opacity:0; pointer-events:none; }
.fx-story__aud.is-on{ background:var(--cy-color-text-primary); color:var(--cy-color-text-inverse); }
.fx-story__cta{ position:absolute; left:0; right:0; bottom:0; z-index:4; box-sizing:border-box;
  display:flex; gap:var(--cy-space-3);
  padding:88rpx var(--cy-page-x) calc(var(--cy-space-5) + env(safe-area-inset-bottom));
  /* 只用渐隐,不铺纯色 —— 纯色在按钮下方是一整块黑框,很显眼。
     滚动时整条收下去(见 .is-away),停下来再弹回来,所以「正文从半透明次按钮里透出来」
     那件事只在静止时可能发生,而静止时渐变已经压到 .95。 */
  background:linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.72) 42%, rgba(0,0,0,.95) 100%); /* ds-ok 渐隐到底色 */
  transition:transform .26s var(--cy-ease-out), opacity .2s ease; }
/* 滑动时收下去,停下来再弹回:正文往上走的时候不该有东西压在下面挡路 */
.fx-story__cta.is-away{ transform:translateY(105%); opacity:0; pointer-events:none; }
.play--reduced-motion .fx-story__cta{ transition:none; }
.play--reduced-motion .fx-story__cta.is-away{ transform:none; opacity:1; pointer-events:auto; }
.play--reduced-motion .st-line{ transition:none; opacity:1; transform:none; filter:none; }

/* ④ 店铺分身对话 —————————————————————————————————————————— */
.fx-npc{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:106;  /* 压在 hero(105)之上:它是从卡片详情里再进一层 */
  background:var(--cy-color-bg-page); opacity:0; transition:opacity .26s ease; }
.fx-npc.is-open{ opacity:1; }
.fx-npc__back{ position:absolute; left:var(--cy-page-x); z-index:3; width:var(--cy-btn-h); height:var(--cy-btn-h);
  border-radius:50%; background:var(--cy-color-bg-elevated); display:flex; align-items:center; justify-content:center; }
/* 形象:圆形舞台居中,真机接 3D 模型前先按人的比例留白 */
/* perspective 只作用于有 3D 变换的子元素(下面两圈地环);canvas 自身不带变换,不受影响 */
.fx-npc__stage{ position:absolute; left:0; right:0; top:190rpx; text-align:center; perspective:1600rpx; }
.fx-npc__fig3d{ position:absolute; left:0; top:0; width:100%; height:100%; }
.fx-npc__fig{ position:relative; width:400rpx; height:440rpx; margin:0 auto; }
.fx-npc__halo{ position:absolute; left:50%; top:46%; width:460rpx; height:460rpx; margin:-230rpx 0 0 -230rpx;
  border-radius:50%; background:radial-gradient(circle, rgba(255,255,255,.10), rgba(255,255,255,0) 62%); } /* ds-ok 形象后的体积光,不是色板色 */
/* 脚下两圈地环(样机 .npc__ring / .r2):rotateX(74deg) 把圆压成地面椭圆,不是画面里的同心圆。
   内圈静止定位、外圈匀速转一圈 14s —— 这是「分身在待机」的呼吸感来源,光晕替代不了。
   ⚠️ 颜色只能中性:样机用的是金色 rgba(232,194,122,…),而玩家端整页单色有契约扫描。 */
.fx-npc__ring{ position:absolute; left:50%; top:50%; width:380rpx; height:380rpx; margin:-190rpx 0 0 -190rpx;
  border-radius:50%; border:2rpx solid rgba(255,255,255,.22);  /* ds-ok 地环描边,中性白透明度不是色板色 */
  transform:rotateX(74deg) translateZ(-92rpx); pointer-events:none; }
.fx-npc__ring--o{ width:460rpx; height:460rpx; margin:-230rpx 0 0 -230rpx;
  border-color:rgba(255,255,255,.12);  /* ds-ok 外圈更淡,同上 */
  animation:npcRingSpin 14s linear infinite; }
@keyframes npcRingSpin{ to{ transform:rotateX(74deg) translateZ(-92rpx) rotateZ(360deg); } }
.fx-npc__name{ margin-top:var(--cy-space-3); font-size:32rpx; font-weight:700; color:var(--cy-color-text-primary); } /* ds-ok 形象名牌,比正文大一档 */
.fx-npc__role{ margin-top:6rpx; font-size:var(--cy-type-caption); color:var(--cy-color-text-tertiary); }
/* 开场问候:居中大字占住对话区,开口之后淡出上移 */
.fx-npc__hello{ position:absolute; left:0; right:0; top:760rpx; bottom:300rpx; z-index:2; box-sizing:border-box;
  padding:0 72rpx; display:flex; align-items:center; justify-content:center; text-align:center;
  font-size:46rpx; font-weight:700; line-height:1.5; color:var(--cy-color-text-primary); /* ds-ok 这一屏唯一的大字,比 fx-hero__name 再大一档 */
  transition:opacity .3s ease, transform .3s ease; }
.fx-npc.is-started .fx-npc__hello{ opacity:0; transform:translateY(-20rpx); pointer-events:none; }
.fx-npc__log{ position:absolute; left:0; right:0; top:760rpx; bottom:300rpx; box-sizing:border-box; padding:0 var(--cy-page-x); }
/* 对方消息不套气泡:裸正文。我方才是右侧胶囊 */
.fx-msg{ margin-bottom:var(--cy-space-4); }
.fx-msg--ai .fx-msg__t{ font-size:var(--cy-type-body); line-height:1.72; color:var(--cy-color-text-primary); }
.fx-msg__who{ font-size:var(--cy-type-caption); color:var(--cy-color-text-tertiary); }
/* 回答下面那行操作。命中区按 X12 撑到 88rpx(=44px):文字只有两个字,
   靠外扩的透明内边距去够,不是把字号撑大。 */
.fx-msg__ops{ display:flex; gap:var(--cy-space-3); margin-top:4rpx; }
.fx-msg__op{ box-sizing:border-box; min-height:88rpx; padding:22rpx 20rpx 22rpx 0;
  display:flex; align-items:center; font-size:var(--cy-type-caption);
  color:var(--cy-color-text-tertiary); }
.fx-msg--me{ display:flex; justify-content:flex-end; }
.fx-msg--me .fx-msg__t{ max-width:78%; padding:18rpx 28rpx; border-radius:var(--cy-radius-lg);
  background:var(--cy-color-bg-elevated); font-size:var(--cy-type-body); line-height:1.6;
  color:var(--cy-color-text-primary); }
.fx-npc__bar{ position:absolute; left:0; right:0; bottom:0; z-index:3; box-sizing:border-box;
  padding:var(--cy-space-4) var(--cy-page-x) calc(var(--cy-space-4) + env(safe-area-inset-bottom));
  display:flex; align-items:center; gap:var(--cy-space-3); }
.fx-npc__inp{ flex:1; min-width:0; box-sizing:border-box; height:var(--cy-btn-h); padding:0 var(--cy-space-4);
  border-radius:var(--cy-radius-pill); background:var(--cy-color-bg-elevated); display:flex; align-items:center; }
.fx-npc__input{ flex:1; min-width:0; font-size:var(--cy-type-body); color:var(--cy-color-text-primary); }
.fx-npc__ph-t{ color:var(--cy-color-text-tertiary); }
.fx-npc__mic{ flex:none; width:56rpx; height:56rpx; margin-left:var(--cy-space-2);
  border-radius:50%; display:flex; align-items:center; justify-content:center;
  color:var(--cy-color-text-tertiary); }
.fx-npc__mic.is-rec{ background:var(--cy-color-text-primary); color:var(--cy-color-text-inverse); }
.fx-npc__inp.is-rec{ background:var(--cy-color-bg-surface-strong); }
.fx-npc__send{ flex:none; width:var(--cy-btn-h); height:var(--cy-btn-h); border-radius:50%;
  background:var(--cy-color-text-primary); color:var(--cy-color-text-inverse);
  display:flex; align-items:center; justify-content:center; }
.fx-npc__send.is-off{ opacity:.35; }

/* 用户指定故事流原型：复用探店日 st-line 显形及双层粒子，章节正文铺满视口。 */

.chfull .st-line{margin-bottom:360rpx;} /* ds-ok 用户指定原型段间 180px */

.chfull__para--wide{margin-left:40rpx;margin-right:40rpx;} /* ds-ok 原型游戏与图片块左右 20px */
.chfull__img,.chfull__cover{width:100%;border-radius:var(--cy-radius-lg);}

/* 故事流顶栏(2026-09-22 按预制人生排版):左罗盘切地图 / 中标题 / 右两颗圆钮。
   罗盘与圆钮的尺寸沿用 --cy-btn-h,与既有返回钮同一命中区,不另起一套。 */
.fx-story__compass{ flex:none; display:flex; flex-direction:column; align-items:center; gap:4rpx; }
.compass__dial{ position:relative; width:var(--cy-btn-h); height:var(--cy-btn-h); border-radius:50%;
  background:var(--cy-color-bg-elevated); display:flex; align-items:center; justify-content:center; }
.compass__n{ font-size:var(--cy-type-caption); font-weight:700; color:var(--cy-color-text-secondary); }
/* 指北的那一点:右上角,与样机同方位 */
.compass__dot{ position:absolute; top:12rpx; right:14rpx; width:10rpx; height:10rpx; border-radius:50%;
  background:var(--cy-color-text-primary); }
.compass__dist{ font-size:var(--cy-type-caption); color:var(--cy-color-text-tertiary); }
/* 左上角雷达小地图(2026-09-23 用户:「类似 GTA 那种游戏地图」):圆形、描边、压在顶栏上,点它切大地图。
   原生地图吃掉点击,上面再铺一层透明 radar__hit 接住。顶栏为它留出高度,标题仍按行居中。 */
.fx-story__radar{ align-self:center; }
.radar__disc{ position:relative; width:88rpx; height:88rpx; border-radius:50%; overflow:hidden; /* ds-ok 2026-09-24 用户:左上角缩小一点 */
  background:#EEEEEC; box-shadow:0 0 0 4rpx rgba(255,255,255,.85), 0 8rpx 32rpx rgba(0,0,0,.5); /* ds-ok 故事流装饰值;底色 = 腾讯底图浅灰,地图没铺出来前不再是一个黑圆(2026-10-27) */
  display:flex; align-items:center; justify-content:center; } /* ds-ok GTA 雷达的白描边 */
/* 地图本体做成圆的三倍大、居中:可见的仍是正中那一块(比例尺不变),「腾讯地图」角标落在圆外被裁掉 */
.fx-story__radar-map{ position:absolute; left:-100%; top:-100%; width:300%; height:300%; }
.radar__hit{ position:absolute; left:0; top:0; right:0; bottom:0; z-index:2; }

.fx-story__acts{ flex:none; display:flex; align-items:center; gap:var(--cy-space-2); }
.fx-story__act{ width:88rpx; height:88rpx; border-radius:50%;
  background:var(--cy-color-bg-elevated); display:flex; align-items:center; justify-content:center; }

/* 工具抽屉转移到右上角(2026-09-22):行样式 .drow/.dic/.dcopy 原样复用,只改容器定位。 */
.tools-mask{ position:absolute; inset:0; z-index:40; }
.tools--corner{ position:absolute; top:calc(var(--cy-btn-h) + var(--cy-space-6)); right:var(--cy-page-x);
  z-index:41; width:560rpx; max-height:60vh; border-radius:var(--cy-radius-lg);
  background:var(--cy-color-bg-elevated); box-shadow:var(--cy-shadow-card);
  /* 2026-10-23 弹层动效:菜单原来一帧出现 / 消失。出现淡入 standard 220(全局 cy-fade-in,不新增关键帧),
     收起淡出 fast 140(index.js 的 _toolsClose) */
  animation:cy-fade-in var(--cy-motion-standard) var(--cy-ease-out); }
.tools--corner.is-out{ animation:none; opacity:0; transition:opacity var(--cy-motion-fast) var(--cy-ease-standard); pointer-events:none; }
.tools-mask.is-out{ pointer-events:none; }
.play--reduced-motion .tools--corner{ animation:none; }

/* 菜单里的只读行(思维阁进度):没有箭头、不可点,与可点的 .drow 区分开。 */
.drow--static { opacity: 1; }
/* 长按结束的进度反馈。底栏那枚 142rpx 圆环(.hold)是给 122rpx 圆钮做的,塞不进 112rpx 高的菜单行;
   这里改用一条从左推进的底色,语义不变:涨满 = 这一局结束。
   ⚠️ .drow 本体在 style/proto-sheet.wxss,与漫游抽屉共用 —— 不去那边加 position,只在 play 这层挂。 */
.drow--hold { position: relative; }
.drow__hold { position: absolute; left: 0; top: 0; bottom: 0;
  background: rgba(255, 255, 255, .10); pointer-events: none; } /* ds-ok 长按进度底色,同 proto-sheet 分隔线的裸 rgba 口径 */

/* W-15 试玩结局卡:黑底整屏,文字左对齐;chip 选中 = 反色中性(游玩页单色契约)。 */
.pv-ending{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:110; /* ds-ok 压过故事流 .chfull(106),低于预览顶条(--cy-z-modal) */ box-sizing:border-box;
  padding-left:46rpx; padding-right:46rpx; background:#000000; display:flex; flex-direction:column; } /* ds-ok 故事流同一张黑底 */
/* 结局 + 这一生的档案(2026-09-24):整屏可滚,真玩家底部一颗「继续」进完成页 */
.pv-ending__scroll{ flex:1; min-height:0; }
.pv-ending__k, .pv-ending__title, .pv-ending__copy, .pv-ending__cond{ display:block; }
.pv-ending__go{ margin:64rpx 0 calc(env(safe-area-inset-bottom) + 48rpx); height:104rpx; border-radius:999rpx; display:flex; align-items:center; justify-content:center; /* ds-ok 胶囊按钮 */
  background:#FFFFFF; color:#0A0A0A; font-size:32rpx; font-weight:700; } /* ds-ok 白药丸墨字 */
.life-arc{ margin-top:72rpx; padding-top:40rpx; border-top:1rpx solid rgba(255,255,255,.16); } /* ds-ok 档案与结局之间一道发丝 */
.life-arc__h{ display:block; font-size:22rpx; letter-spacing:6rpx; color:rgba(255,255,255,.55); } /* ds-ok 眉标 */
.life-arc__id{ display:flex; align-items:center; gap:28rpx; margin-top:28rpx; }
.life-arc__ava{ flex:none; width:112rpx; height:112rpx; border-radius:50%; }
.life-arc__rows{ flex:1; min-width:0; }
.life-arc__row{ display:flex; justify-content:space-between; gap:24rpx; padding:14rpx 0; border-bottom:1rpx solid rgba(255,255,255,.08); } /* ds-ok 表格发丝 */
.life-arc__l{ color:rgba(255,255,255,.55); font-size:26rpx; } /* ds-ok */
.life-arc__v{ color:#FFFFFF; font-size:28rpx; font-weight:600; text-align:right; } /* ds-ok */
.life-arc__photos{ display:flex; gap:16rpx; margin-top:32rpx; overflow-x:auto; }
.life-arc__photo{ flex:none; width:220rpx; }
.life-arc__img{ display:block; width:220rpx; height:290rpx; border-radius:16rpx; background:#1C1C1E; } /* ds-ok 照片占位底 */
.life-arc__cap{ display:block; margin-top:10rpx; font-size:22rpx; color:rgba(255,255,255,.5); } /* ds-ok */
.life-arc__note{ margin-top:32rpx; }
.life-arc__quote{ display:block; font-size:32rpx; line-height:1.7; color:#FFFFFF; } /* ds-ok 留言原话 */
.life-arc__walk{ display:block; margin-top:36rpx; font-size:24rpx; line-height:1.7; color:rgba(255,255,255,.6); } /* ds-ok */
.pv-ending__k{ font-size:21rpx; letter-spacing:4rpx; color:rgba(255,255,255,.6); } /* ds-ok 同伏笔卡 .k */
.pv-ending__title{ margin-top:19rpx; font-size:56rpx; font-weight:800; color:#FFFFFF; line-height:1.28; } /* ds-ok 原型 chapter-gate h2 29px */
.pv-ending__copy{ margin-top:19rpx; font-size:29rpx; line-height:1.7; color:rgba(255,255,255,.72); } /* ds-ok 正文 15px */
.pv-ending__cond{ margin-top:31rpx; font-size:23rpx; color:rgba(255,255,255,.5); } /* ds-ok 12px 说明 */
.pv-ending__chips{ display:flex; flex-wrap:wrap; gap:15rpx; margin-top:46rpx; }
.pv-ending__chip{ min-height:var(--cy-btn-h); display:flex; align-items:center; padding:0 27rpx; border-radius:999rpx; /* ds-ok 胶囊 */
  background:rgba(255,255,255,.12); color:#FFFFFF; font-size:25rpx; } /* ds-ok 同菜单行底 */
.pv-ending__chip.is-on{ background:#FFFFFF; color:#000000; } /* ds-ok 反色中性 */

/* 罗盘小地图(2026-09-23):盖在故事流之上、预览顶条之下;地图原生层整屏铺满,返回钮与下一站卡浮在上面。 */
.story-map{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:108; background:#000000; } /* ds-ok 压过 .chfull(106),低于结局卡(110) */
.story-map__map{ position:absolute; left:0; right:0; top:0; bottom:0; }
.story-map__back{ position:absolute; left:var(--cy-page-x); z-index:2; height:var(--cy-btn-h); padding:0 var(--cy-space-4);
  display:flex; align-items:center; gap:var(--cy-space-1); border-radius:999rpx; background:rgba(0,0,0,.72); color:#FFFFFF; font-size:26rpx; } /* ds-ok 浮在地图上的深色胶囊 */
.story-map__card{ position:absolute; left:var(--cy-page-x); right:var(--cy-page-x); bottom:calc(var(--cy-space-6) + env(safe-area-inset-bottom)); z-index:2;
  display:flex; align-items:center; gap:var(--cy-space-3); padding:var(--cy-space-4); border-radius:38rpx; background:#111111; } /* ds-ok 与故事玩法入口卡同底 */
.story-map__copy{ flex:1; min-width:0; display:flex; flex-direction:column; }
.story-map__k{ font-size:21rpx; letter-spacing:3rpx; color:rgba(255,255,255,.6); } /* ds-ok 同入口卡小标签 */
.story-map__t{ margin-top:8rpx; font-size:33rpx; font-weight:800; color:#FFFFFF; } /* ds-ok */
.story-map__go{ flex:none; height:var(--cy-btn-h); padding:0 var(--cy-space-4); display:flex; align-items:center;
  border-radius:999rpx; background:#FFFFFF; color:#000000; font-size:27rpx; font-weight:700; } /* ds-ok 反色中性主按钮 */

/* 开始与结束(2026-09-24 用户:开始和结束要有一些动画)。照原型「开机」一组:flashl 白线 + warm 亮光(游玩页单色,改白);
   结束反过来「关机」bootout:压成一条亮线再收掉。只用 transition,不加新 keyframes。 */
.st-boot{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:120; background:#000000; pointer-events:none; transition:opacity .9s ease; } /* ds-ok 开机黑场,压过开场门(chapter-gate) */
.st-boot__line{ position:absolute; left:0; right:0; top:50%; height:4rpx; margin-top:-2rpx; background:#FFFFFF; transform:scaleX(0); opacity:1; transition:transform .42s cubic-bezier(.2,.8,.2,1), opacity .5s ease; } /* ds-ok 原型 flashl 白线 */
.st-boot--line .st-boot__line{ transform:scaleX(1); }
.st-boot--open .st-boot__line, .st-boot--fade .st-boot__line{ transform:scaleX(1) scaleY(.2); opacity:0; }
.st-boot__warm{ position:absolute; left:-30%; right:-30%; top:15%; bottom:15%; background:radial-gradient(closest-side, rgba(255,255,255,.32), rgba(255,255,255,0)); opacity:0; transition:opacity .7s ease; } /* ds-ok 原型 warm 那一下亮光;游玩页单色契约,用白不用橙 */
.st-boot--open .st-boot__warm{ opacity:1; }
.st-boot--fade{ opacity:0; }
.pv-ending{ opacity:0; transition:opacity .4s ease; }
.pv-ending--in{ opacity:1; }
.pv-ending__k, .pv-ending__title, .pv-ending__copy, .life-arc, .pv-ending__go{ opacity:0; transform:translateY(24rpx); transition:opacity .6s ease, transform .6s cubic-bezier(.2,.8,.2,1); }
.pv-ending__title{ transition-delay:.1s; }
.pv-ending__copy{ transition-delay:.2s; }
.life-arc{ transition-delay:.35s; }
.pv-ending__go{ transition-delay:.5s; }
.pv-ending--in .pv-ending__k, .pv-ending--in .pv-ending__title, .pv-ending--in .pv-ending__copy, .pv-ending--in .life-arc, .pv-ending--in .pv-ending__go{ opacity:1; transform:none; }
.pv-ending--off{ transform:scaleY(.004); filter:brightness(3); transition:transform .45s steps(6), filter .45s ease; }
.pv-ending--gone{ transform:scaleX(0) scaleY(.004); opacity:0; transition:transform .3s ease, opacity .3s ease; }
.pv-ending--reduced, .pv-ending--reduced .pv-ending__k, .pv-ending--reduced .pv-ending__title, .pv-ending--reduced .pv-ending__copy, .pv-ending--reduced .life-arc, .pv-ending--reduced .pv-ending__go{ opacity:1; transform:none; transition:none; }

/* 开场页(原型 game-intro,2026-09-24):黑底,主题名大字,读/玩/梦三行,底部白色主按钮;点下整页 .4s 淡出 */
.st-intro{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:121; box-sizing:border-box; /* ds-ok 压过开机层 */
  padding:0 46rpx calc(env(safe-area-inset-bottom) + 48rpx); display:flex; flex-direction:column;
  background:#000000; opacity:1; transition:opacity .4s ease; } /* ds-ok 故事流同一张黑底 */
.st-intro--out{ opacity:0; }
.st-intro__body{ flex:1; display:flex; flex-direction:column; justify-content:center; }
.st-intro__k{ font-size:21rpx; letter-spacing:4rpx; color:rgba(255,255,255,.6); } /* ds-ok 同 .pv-ending__k */
.st-intro__t{ margin-top:23rpx; font-size:80rpx; font-weight:800; line-height:1.15; color:#FFFFFF; } /* ds-ok 原型开场大标题 */
.st-intro__line{ margin-top:23rpx; font-size:29rpx; line-height:1.7; color:rgba(255,255,255,.72); } /* ds-ok 同 .pv-ending__copy */
.st-intro__steps{ margin-top:64rpx; display:flex; flex-direction:column; gap:27rpx; }
.st-intro__step{ display:flex; align-items:baseline; gap:23rpx; }
.st-intro__n{ font-size:29rpx; font-weight:800; color:#FFFFFF; } /* ds-ok 深底白字 */
.st-intro__s{ font-size:25rpx; color:rgba(255,255,255,.6); } /* ds-ok 深底说明字 */
.st-intro__go{ height:104rpx; border-radius:999rpx; display:flex; align-items:center; justify-content:center; /* ds-ok 胶囊按钮,同 .pv-ending__go */
  background:#FFFFFF; color:#000000; font-size:31rpx; font-weight:700; } /* ds-ok 玩家主按钮=反色中性 */
.st-intro__tip{ margin-top:23rpx; text-align:center; font-size:21rpx; color:rgba(255,255,255,.45); } /* ds-ok 深底小字 */

/* 初始状态(原型 statsIntro,2026-09-24):与开场页同一张黑底,一行一个数值,底部同一颗白色主按钮 */
.st-stats{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:117; box-sizing:border-box; /* ds-ok 压过故事流,低于梦层 */
  padding:0 46rpx calc(env(safe-area-inset-bottom) + 48rpx); display:flex; flex-direction:column;
  background:#000000; opacity:1; transition:opacity .4s ease; } /* ds-ok 故事流同一张黑底 */
.st-stats--out{ opacity:0; }
.st-stats__body{ flex:1; display:flex; flex-direction:column; justify-content:center; gap:27rpx; }
.st-stats__k{ font-size:21rpx; letter-spacing:4rpx; color:rgba(255,255,255,.6); } /* ds-ok 同 .st-intro__k */
.st-stats__row{ display:flex; align-items:baseline; justify-content:space-between; padding-bottom:23rpx;
  border-bottom:1rpx solid rgba(255,255,255,.12); } /* ds-ok 深底分隔线 */
.st-stats__l{ font-size:31rpx; color:rgba(255,255,255,.72); } /* ds-ok 深底标签 */
.st-stats__v{ font-size:56rpx; font-weight:800; color:#FFFFFF; } /* ds-ok 同 .pv-ending__title 字重 */

/* 相册全屏(2026-09-24,效果照 X 上 @insporadesign「3D gradient cards」):白底,当前那张正对人,
   两侧沿 Y 轴向后弯;每张背后一团用它自己糊开的彩光,下面一份渐隐的倒影。只用 transition。 */
.album{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:118; overflow:hidden; background:#F4F4F6; } /* ds-ok 用户点名白底 */
.album__glass{ position:absolute; left:0; right:0; top:12vh; }
.album__line{ position:absolute; left:64rpx; right:64rpx; bottom:calc(env(safe-area-inset-bottom) + 230rpx); text-align:center;
  font-size:29rpx; line-height:1.7; color:#1C1C1E; } /* ds-ok 白底上的深字 */
.album__count{ position:absolute; left:0; right:0; bottom:calc(env(safe-area-inset-bottom) + 190rpx); text-align:center;
  font-size:21rpx; letter-spacing:4rpx; color:rgba(28,28,30,.45); } /* ds-ok 白底页码 */
.album__back{ position:absolute; left:50%; bottom:calc(env(safe-area-inset-bottom) + 64rpx); transform:translateX(-50%);
  height:var(--cy-btn-h); padding:0 46rpx; border-radius:999rpx; display:flex; align-items:center; /* ds-ok 胶囊按钮 */
  background:#1C1C1E; color:#FFFFFF; font-size:27rpx; font-weight:600; } /* ds-ok 白底上的深色主按钮(反色中性) */

.finsheet__records{display:flex;flex-direction:column;gap:var(--cy-space-3);padding:var(--cy-space-4);margin:var(--cy-space-4) 0;background:var(--cy-comp-sheet-player-surface);border-radius:var(--cy-radius-xl);font-size:var(--cy-type-body)}

/* 2026-10-22 业主:完成页统计用字形图标(不用圆章) */
.fst__ic { color: var(--cy-color-play-story-muted); }

/* P-60(2026-10-27):故事流正文与对白用手写体(pages/play/utils/story-font.js 在线加载 CyStoryHand);
   没配置或加载失败时认不出这个字族,自动落到后面的系统字体 —— 与 app.wxss 默认字族同值。 */
.cy-story-hand { font-family: 'CyStoryHand', -apple-system, "PingFang SC", "Noto Sans SC", sans-serif; } /* ds-ok 字族名同 story-font.js STORY_FONT_FAMILY */
/* ===== 2026-10-28 完成页改版(业主定稿 claude.ai/artifact/DF1tPhSNWFrzQhDu8hoUAy):整屏深色,NRC 跑步总结 + Revolut 分组卡 =====
   做法:在 .finsheet 作用域里把它本来就在用的 play-story 色值换成深色,版式只改布局;390 宽稿按 1.923rpx/px 移植。 */
.finmask{ display:none; }
.finsheet{ position:fixed; inset:0; height:auto; max-height:none; border-radius:0; padding:0 0 calc(230rpx + env(safe-area-inset-bottom));
  --cy-color-play-story-page:#000000; --cy-color-play-story-text:#FFFFFF; --cy-color-play-story-muted:rgba(235,235,245,.6); /* ds-ok 定稿深色 */
  --cy-color-play-story-line:rgba(255,255,255,.08); --cy-color-play-story-surface:#1C1C1E; --cy-color-play-story-accent:#FFFFFF; /* ds-ok 定稿深色 */
  --cy-color-play-story-accent-soft:rgba(255,255,255,.16); --cy-color-play-story-cta-fg:#000000; --cy-color-play-ink-muted:rgba(235,235,245,.6); /* ds-ok 定稿深色 */
  --cy-color-play-surface-subtle:#1C1C1E; --cy-comp-sheet-player-surface:#1C1C1E; } /* ds-ok 定稿深色 */
.finsheet__map{ margin:0; height:635rpx; border-radius:0; }
.finsheet__map::after{ content:''; position:absolute; inset:0; z-index:2; pointer-events:none; background:linear-gradient(180deg,rgba(0,0,0,.55) 0,rgba(0,0,0,0) 22%,rgba(0,0,0,0) 62%,#000 100%); } /* ds-ok 地图压进黑底 */
.finsheet__map-error{ z-index:3; }
.finsheet__head{ position:relative; z-index:3; margin-top:-35rpx; padding:0 38rpx; display:flex; flex-direction:column; align-items:flex-start; gap:12rpx; }
.finsheet__eyebrow{ font-size:25rpx; color:var(--cy-color-play-story-muted); } /* ds-ok 定稿字号 */
.finsheet .finsheet__title{ margin:0; text-align:left; font-size:58rpx; line-height:1.15; } /* ds-ok 定稿字号 */
.finsheet .finsheet__result{ margin:8rpx 0 0; padding:8rpx 19rpx; font-size:23rpx; font-weight:600; background:#2C2C2E; color:#FFFFFF; } /* ds-ok 定稿 */
.finsheet .finsheet__result.is-win{ background:#FFFFFF; color:#000000; } /* ds-ok 定稿 */
.finsheet .finsheet__grid{ display:grid; grid-template-columns:repeat(3,1fr); column-gap:15rpx; margin:54rpx 38rpx 0; }
.finsheet .fst{ align-items:flex-start; gap:4rpx; min-width:0; }
.finsheet .fst:first-child{ grid-column:1 / -1; margin-bottom:46rpx; }
.finsheet .fst:first-child .fst__ic{ display:none; }
.finsheet .fst__v{ font-family:"DIN Alternate","DIN Condensed",-apple-system,sans-serif; font-style:italic; font-weight:800; font-variant-numeric:tabular-nums; }
.finsheet .fst:first-child .fst__v{ font-size:216rpx; line-height:.86; } /* ds-ok 定稿 NRC 大数字 */
.finsheet .fst:first-child .fst__l{ font-size:29rpx; margin-top:12rpx; } /* ds-ok 定稿字号 */
.finsheet .fst--s .fst__v{ font-size:58rpx; line-height:1; } /* ds-ok 定稿字号 */
.finsheet .fst--s .fst__l{ font-size:25rpx; } /* ds-ok 定稿字号 */
.finsheet .finsheet__game-ending{ margin:54rpx 38rpx 0; padding:31rpx; border-left:0; border-radius:31rpx; background:#1C1C1E; } /* ds-ok 定稿分组卡 */
.fsec{ margin:54rpx 38rpx 0; display:flex; flex-direction:column; gap:19rpx; }
.fsec__h{ font-size:38rpx; font-weight:700; color:#FFFFFF; } /* ds-ok 定稿字号 */
.fgroup{ border-radius:31rpx; overflow:hidden; background:#1C1C1E; } /* ds-ok 定稿分组卡 */
.frow{ position:relative; display:flex; align-items:center; gap:27rpx; min-height:54rpx; padding:27rpx 31rpx; }
.frow + .frow::before, .frow + .finish-milestone::before{ content:''; position:absolute; top:0; left:31rpx; right:0; height:1rpx; background:rgba(255,255,255,.08); } /* ds-ok 分隔线 */
.frow__t{ flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.frow__b{ font-size:31rpx; font-weight:500; color:#FFFFFF; } /* ds-ok 定稿字号 */
.frow__s{ font-size:25rpx; color:rgba(235,235,245,.6); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; } /* ds-ok 定稿字号 */
.frow__v{ flex:none; font-size:31rpx; color:rgba(235,235,245,.6); font-variant-numeric:tabular-nums; } /* ds-ok 定稿字号 */
.fhex{ flex:none; width:77rpx; height:85rpx; display:flex; align-items:center; justify-content:center; clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%); font-size:29rpx; font-weight:800; color:#000000; } /* ds-ok NRC 六边形奖章 */
.fhex--metal{ background:linear-gradient(160deg,#E5E5EA,#8E8E93); } /* ds-ok NRC 六边形奖章,游玩路径保持中性色 */
.fhex--ink{ background:linear-gradient(160deg,#FFFFFF,#BDBDC2); } /* ds-ok NRC 六边形奖章 */
.fgroup .finish-milestone{ position:relative; margin:0; padding:31rpx; border:0; border-radius:0; background:transparent; }
.finsheet .branchpath, .finsheet .newos, .finsheet .finsheet__records, .finsheet .finish-route-recommendation{ margin:54rpx 38rpx 0; border:0; border-radius:31rpx; background:#1C1C1E; } /* ds-ok 定稿分组卡 */
.finsheet .finsheet__stamplist{ margin:19rpx 38rpx 0; }
.finsheet .finish-photos-title{ margin:54rpx 38rpx 19rpx; font-size:38rpx; font-weight:700; color:#FFFFFF; } /* ds-ok 定稿字号 */
.finsheet .finish-stamps{ padding:0 38rpx; }
.finsheet .finish-journal-entry{ margin:19rpx 38rpx 0; padding:31rpx; border:0; border-radius:31rpx; background:#1C1C1E; } /* ds-ok 定稿分组卡 */
.finsheet .finsheet__records + .finish-journal-entry{ margin-top:19rpx; }
.finsheet .finsheet__retry{ margin:31rpx 38rpx 0; }
.finsheet .finsheet__cta{ position:fixed; z-index:5; left:38rpx; right:38rpx; bottom:calc(65rpx + env(safe-area-inset-bottom)); margin:0; height:104rpx; background:#FFFFFF; color:#000000; box-shadow:0 0 80rpx 70rpx #000000; } /* ds-ok 白色主按钮,黑色渐隐托底 */
