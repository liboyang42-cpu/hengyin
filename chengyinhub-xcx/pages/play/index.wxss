/* ===================== 章节剧情 / 主题介绍 全屏态 =====================
 * 2026-09-10 用户裁决:漫游四模式脱离小程序 DS、逐条照原型 HTML。
 * ⚠️ 这一屏此前是「浅色城瘾舞台」(白纸 + 衬线体,Figma 3963:14970)——那条偏好被
 *    这一次裁决推翻了:原型 c-chfull / x-intro 是 `.settle` 的近黑面 #08090B。
 *    结构(滚动衰减的块流、近焦正文、三格读数、底部 CTA)不动,换的是颜色与几何。
 * 原型逐条:眉标 11px #E2C489 800 · 标题 .h2 26px/700 白 · 图 180px r20 ·
 *          正文 15px #D5DAE1 行高 1.85 · 三格 .g3(#101418 r18) · CTA .btn.w。
 * 1px = 1.923rpx。 */
.chfull{position:fixed;inset:0;z-index:106;padding:0;background:#000;} /* ds-ok 玩家指定纯黑故事背景 */
.chfull__game-cue { text-align:center; padding:var(--cy-space-4); }
.chfull__head{ padding:0 46rpx 15rpx; text-align:center; } /* ds-ok 原型 .settle padding 0 24px */
.chfull__eyebrow{display:block;margin-top:var(--cy-space-1);font-size:var(--cy-type-caption);color:var(--cy-color-text-tertiary);font-weight:400;} /* ds-ok 原型 11px #E2C489 800 */
.chfull__title{ display:block; margin-top:12rpx; font-size:50rpx; font-weight:700; line-height:var(--cy-leading-tight); color:#FFFFFF; } /* ds-ok 原型 .h2 26px/700 / 上 6px */
.chfull__stage{position:absolute;inset:0;}
.chfull__scroll{ height:100%;
  /* 顶栏(标题/罗盘/…)透明压在正文上:上沿渐隐,滚上去的字和图在顶栏下方淡出,不与按钮叠字(实走 A26) */
  -webkit-mask-image:linear-gradient(to bottom, transparent 0, transparent 220rpx, #000 340rpx); /* ds-ok 遮罩只取 alpha,与颜色主题无关 */
  mask-image:linear-gradient(to bottom, transparent 0, transparent 220rpx, #000 340rpx); } /* ds-ok 同上 */
.chfull__pad{height:440rpx;}
.chfull__cover{ display:block; width:100%; height:346rpx; border-radius:38rpx; background:#101418; } /* ds-ok 原型 图 180px / r20 / 底 #101418 */
.chfull__para{display:block;min-height:0;padding:0;font-size:34rpx;line-height:1.95;color:var(--cy-color-text-primary);} /* ds-ok 用户指定原型正文 17px/1.95 */
/* ★ 内嵌玩法(契约 §1.5):故事流里的这一块。三个变量把 cy-play-stage 从「四边贴死」
   切成「在流里」—— 变量能穿组件边界(与 --pk-top 同一条路),所以 24 个 kit 一个都不用改。
   ⚠️ 变量名与 pages/play/components/play-stage/index.wxss 逐字对应;写错**不报错**,
   表现是「配了内嵌但整屏糊住页面」或「块高 0,内容看不见」。
   ⚠️ z-index 不在这里写:台面自己走 --cy-z-sheet token —— 这页地图与角色卡在 80–90 档,
   手写数字压不住会渲染到它们底下,表现是「注入成功但画面没变」。
   ⚠️ 外层仍是 `.chfull__para`(measureChapter 按它对齐下标),所以这一块是内层 wrapper。 */
/* 内嵌 = 原型 card():标题在外、选项一块分组列表、按钮跟在内容后,没有台面自己的底色。
   ⚠️ 这组变量与 pages/publish/temp/index.wxss 的 .cg-pv-inline-kit 逐条一致(契约测试钉着),
      改一处必须改两处 —— 不一致就是作者预览看到的和玩家看到的不是一个东西。 */
.chfull__kit{ width:100%; --pe-unfold:1; --pk-stage-pos:relative; --pk-stage-height:auto; --pk-stage-body-pos:relative; --pk-stage-bg:transparent; --pk-stage-overflow:visible; --pk-back-display:none; --pk-col-pos:relative; --pk-col-pad:0; --pk-col-align:stretch; --pk-col-text:left; --pk-btn-pos:relative; --pk-btn-x:0; --pk-btn-bottom:0; --pk-btn-mt:var(--cy-space-5); --cy-play-question-size:44rpx; --pk-q-weight:600; --pk-row-justify:flex-start; --pk-qt-radius:32rpx; } /* ds-ok 44rpx = 原型 .card .ct 22px;32rpx 安静挑战内嵌成卡 */
/* 2026-09-23 用户:内嵌玩法的题目和作答放到屏幕中间 —— 这一块撑满一屏,内容竖向居中(滚到它时锚点对准块顶) */
.chfull__kit{ min-height:100vh; box-sizing:border-box; display:flex; flex-direction:column; justify-content:center; padding-bottom:var(--cy-space-6); }
.chfull__collapse{ position:absolute; right:13rpx; bottom:13rpx; color:#8A93A0; /* ds-ok 原型 --t2 */
  width:88rpx; height:88rpx; display:flex; align-items:center; justify-content:center; }
.chfull__stats{ flex:none; display:flex; gap:19rpx; margin:31rpx 46rpx 0; padding:31rpx 35rpx;
  background:#101418; border-radius:35rpx; } /* ds-ok 原型 .g3 gap10 / #101418 / r18 / padding 16 18 */
.chstat{ flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; }
.chstat__v{ font-size:50rpx; font-weight:800; color:#FFFFFF; line-height:1; font-variant-numeric:tabular-nums; } /* ds-ok 原型 .g3 .v 26px/800 */
.chstat__l{ margin-top:13rpx; font-size:21rpx; color:#6A7282; } /* ds-ok 原型 .g3 .l 11px #6A7282 / 上 7px */
.chfull__end{ padding:42rpx 46rpx 0; } /* ds-ok 原型 CTA 上 22px */
/* 终章反转:整章翻成对话框。正文段 = 「我」发出去的消息(右侧气泡),反转块 = 对面的回话(左侧)。
   不做过渡:一下子「塌」成聊天记录本身就是那个反转。 */
.chfull.is-chat .chfull__para.st-line{ margin-bottom:24rpx; opacity:1; transform:none; filter:none; }
.chfull.is-chat .chfull__para:not(.chfull__para--wide){ display:table; max-width:76%; margin-left:auto; margin-right:40rpx;
  padding:20rpx 28rpx; border-radius:36rpx 36rpx 8rpx 36rpx; background:var(--cy-color-bg-surface-strong); /* ds-ok 聊天气泡带尾角 */
  font-size:var(--cy-font-body); line-height:1.6; text-align:left; }
.chfull__reveal{ margin:48rpx 0 0; text-align:left; }
.chfull__reveal-who{ margin-bottom:16rpx; font-size:var(--cy-font-caption); color:var(--cy-color-text-tertiary); text-align:center; }
.chfull__reveal-b{ display:table; max-width:76%; margin:0 0 16rpx; padding:20rpx 28rpx; border-radius:36rpx 36rpx 36rpx 8rpx; /* ds-ok 聊天气泡带尾角 */
  background:var(--cy-color-bg-elevated); font-size:var(--cy-font-body); line-height:1.6; color:var(--cy-color-text-primary); }
/* 越往后越不正常(原型 .screen.odd1/2/3,改成逐段:从异常块那一段起才生效)。
   闪一下由 JS 挑段(oddFlick),不新增 keyframes。 */
.chfull__para.st-line.is-flick{ opacity:.2; transition:none; }
.chfull__para.odd1 .chfull__img, .chfull__para.odd1 .chfull__album-img{ filter:saturate(.75); }
.chfull__para.odd2{ letter-spacing:.06em; }
.chfull__para.odd2 .chfull__img, .chfull__para.odd2 .chfull__album-img{ filter:saturate(.35) contrast(1.1); box-shadow:-6rpx 0 0 rgba(255,0,60,.35), 6rpx 0 0 rgba(0,200,255,.35); } /* ds-ok 原型 odd2 色差错位 */
.chfull__para.odd2.is-flick .chfull__voice-t{ opacity:1; transform:translateX(4rpx); }
.chfull__para.odd3 .chfull__img, .chfull__para.odd3 .chfull__album-img{ filter:grayscale(1) contrast(1.2); }
.chfull__para.odd3:not(.chfull__para--wide){ font-family:ui-monospace, Menlo, monospace; letter-spacing:.02em; }
/* 试玩里条件正文头上的小字「选过 X 才看到」(真玩家看不到这一行) */
.chfull__cond{ display:block; margin-bottom:8rpx; font-size:var(--cy-font-caption); color:var(--cy-color-text-tertiary); letter-spacing:2rpx; }
.chfull__voice{ margin:0 24rpx; text-align:left; }   /* 宽段 40rpx + 24rpx = 原型 .voice 左右 32px */
