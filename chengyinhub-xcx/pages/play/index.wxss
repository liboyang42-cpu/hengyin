/* ═══════════ 自由探索(mode2)首屏:通行证头 + 卡包 + 六宫格 ═══════════
   自由探索没有地图、没有章节卡、没有「下一站」,所以不复用 .pcard/.pbar 的几何,
   另起 .fx-* 一族。mode1 的既有类一行不动。 */
.fx{ position:absolute; left:0; right:0; top:0; bottom:0; z-index:30; box-sizing:border-box; }

.fx-pass{ padding:var(--cy-space-4) var(--cy-page-x) var(--cy-space-3); }
.fx-claim{ margin-top:var(--cy-space-2); font-size:44rpx; font-weight:700; line-height:1.3; /* ds-ok 生活主张是这一屏的主角,刻意高于既有标题层级 */
  color:var(--cy-color-text-primary); }
.fx-sub{ margin-top:var(--cy-space-2); font-size:var(--cy-type-caption); line-height:1.6;
  color:var(--cy-color-text-secondary); }   /* 三级色压在封面上偏灰,这一段是要读的正文,提一档 */
.fx-prow{ margin-top:var(--cy-space-4); display:flex; align-items:center; gap:var(--cy-space-3); }

/* 品类环:等分弧、无起点无终点 —— 形式本身就在说「这里没有顺序」。
   段数=商家数,每段的角度由 JS 的 ringDeg 给(WXML 不能算)。 */
/* 页面底:主题封面模糊后压暗。fixed 让它不跟着 scroll-view 滚,始终是一层底。 */
.fx-bg{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:0; pointer-events:none; overflow:hidden; }
.fx-bg__im{ position:absolute; left:-10%; top:-10%; width:120%; height:120%;
  filter:blur(60rpx); }   /* 放大 120%:blur 会把边缘糊出透明,不撑开就露一圈亮边 */
/* 玻璃蒙版,不是压暗板:
   ① 顶部留一道极浅的高光 —— 玻璃的辨识度大半在这条边;
   ② 整体压暗收到能看清封面的程度(原来 .52→.86 太黑,封面基本被吃掉);
   ③ 底部仍要压住 —— 卡片区在下面,白字压在亮封面上会糊。 */
.fx-bg__veil{ position:absolute; left:0; right:0; top:0; bottom:0;
  background:
    /* ⚠️ 压多少不能只按「深色封面好看」调:商家上传的封面可能很亮,.34 那一档在浅色图上
       根本压不住,标题下面那段小字直接糊掉(实拍抓到)。上半屏统一压到 .62 起步,
       白字在任何封面上都有对比度。 */
    linear-gradient(180deg, rgba(255,255,255,.08) 0%, rgba(255,255,255,.02) 10%, rgba(255,255,255,0) 22%), /* ds-ok 玻璃顶边高光 */
    linear-gradient(180deg, rgba(10,13,19,.62) 0%, rgba(10,13,19,.70) 30%, rgba(10,13,19,.80) 60%, rgba(10,13,19,.88) 100%); /* ds-ok 封面之上的玻璃蒙版 */
  transition:opacity .6s ease-out; }
/* 卡包还没撕开:屏上只有一个包,没有要读的白字 —— 蒙版减淡,让主题封面的虚化透出来(9-24 用户)。
   ★ 摘档判据是 headIn || packOpen,不是只判 packOpen —— 与 wxml 里通行证头/小标题自己的 is-in 判据逐字相同。
     headIn 是白字露脸那一拍,packOpen 要等发牌全部落地(js:943 → :949,约 2.4s 的窗)。只判 packOpen,
     这 2.4s 的白字就压在 .45 浅蒙版上(顶部梯度 .62 实际只剩≈.28,低于本文件上面实拍记下「压不住」的 .34),
     而这一版底图换成商家自传的主题长图,亮图更容易命中。契约测试负控钉住这条,改回只判 packOpen 必红。 */
.fx-bg--pack .fx-bg__veil{ opacity:.45; }
/* 内容都要浮在底图之上 */
.fx-pass, .fx-lhd, .fx-grid{ position:relative; z-index:1; }

.fx-ring{ position:relative; flex:none; width:148rpx; height:148rpx; }
/* 分段圆弧(2026-09-05):一家一段、段间留隙、核销一家亮一段,由 ring.wxs 按 ringSegs 拼成 SVG data URL。
   不用 conic-gradient —— 小程序渲染层不认,渲成实心灰盘(前一版实测);不画连续弧 ——
   连续弧读起来是百分比,而这里要说的是「四家里点亮了几家」。 */
.fx-ring__arc{ position:absolute; left:0; top:0; width:100%; height:100%; }
.fx-ring__c{ position:absolute; left:0; right:0; top:50%; transform:translateY(-50%);
  display:flex; flex-direction:column; align-items:center; }
.fx-ring__n{ font-size:34rpx; font-weight:700; color:var(--cy-color-text-primary); line-height:1; } /* ds-ok 环心读数,介于 caption 与 body 之间没有对应 token */
.fx-ring__l{ margin-top:5rpx; font-size:18rpx; color:var(--cy-color-text-tertiary); } /* ds-ok 环心副标,比 caption 更小 */
.fx-meta{ flex:1; min-width:0; display:flex; flex-direction:column; gap:10rpx; }
.fx-meta__l{ font-size:var(--cy-type-caption); line-height:1.4; color:var(--cy-color-text-tertiary); }
/* 「N 家商户」那行右边那枚地图钮:换到地图模式(原型 x-run)。视觉 30rpx,热区撑到 88。 */
.fx-meta__row{ display:flex; align-items:center; gap:var(--cy-space-2); }
.fx-meta__row .fx-meta__l{ flex:1; min-width:0; }
.fx-meta__map{ position:relative; flex:none; width:50rpx; height:50rpx; display:flex; align-items:center; justify-content:center; }
.fx-meta__map::after{ content:''; position:absolute; left:50%; top:50%; width:88rpx; height:88rpx; transform:translate(-50%,-50%); }
.fx-meta__map-i{ width:40rpx; height:40rpx; }

.fx-lhd{ display:flex; align-items:baseline; gap:var(--cy-space-2); padding:0 var(--cy-page-x) var(--cy-space-2); }
.fx-lhd__t{ font-size:27rpx; font-weight:700; color:var(--cy-color-text-primary); } /* ds-ok 分区小标题,body 与 caption 之间没有对应 token */
.fx-lhd__s{ font-size:21rpx; color:var(--cy-color-text-tertiary); } /* ds-ok 同上,比 caption 再小一档 */

/* 六宫格:六家同尺寸同时落在首屏,「谁排第一」的价值被摊平到接近零 */
/* 开包前只该看见包:通行证头和小标题藏起来,跟第一张卡一起出来 */
.fx-veil{ opacity:0; transform:translateY(-16rpx); pointer-events:none; }
.fx-veil.is-in{ opacity:1; transform:translateY(0); pointer-events:auto;
  transition:opacity .38s ease-out, transform .38s cubic-bezier(.2,.8,.3,1); }
.play--reduced-motion .fx-veil{ transition:none; }

/* 行高由 _measureDeal() 按剩余高度等分后**内联**回填(内联优先级高于这里的 268rpx),
   4 家是竖版大卡、6 家近方卡。⚠️ 这里的 268rpx 是兜底不是摆设:卡内元素全是 absolute,
   一旦 SelectorQuery 量不到(tileH=0、内联不写 height),没有它整屏卡片会塌成零高。 */
.fx-grid{ padding:0 var(--cy-page-x) 36rpx; display:flex; flex-wrap:wrap; gap:22rpx; }
.fx-tile{ position:relative; width:calc((100% - 22rpx) / 2); height:268rpx; overflow:hidden;
  border-radius:var(--cy-radius-lg); background:var(--cy-color-play-surface-solid);
  box-shadow:0 20rpx 44rpx rgba(0,0,0,.30); /* ds-ok 压在深色底上的卡片投影 */
  opacity:0;
  transform:translate(var(--tx0,0px), var(--ty0,0px)) scale(.30) rotate(var(--rot,0deg)); }
/* 发牌两段:一条 transition 画不出弧,所以中间必须真的落一帧在弧顶。
   两段时长之和 = DEAL_FLIGHT(1240ms),分界 = DEAL_ARC(52%),改了要同步 index.js。 */
.fx-tile.is-flying{ opacity:1;
  transform:translate(var(--tx1,0px), var(--ty1,0px)) scale(.78) rotate(calc(var(--rot,0deg) * .4));
  transition:transform .832s cubic-bezier(.18,.82,.26,1), opacity .12s ease-out; }
.fx-tile.is-dealt{ opacity:1; transform:translate(0,0) scale(1) rotate(0deg);
  transition:transform .768s cubic-bezier(.33,0,.2,1), opacity .12s ease-out; }
.play--reduced-motion .fx-tile{ transition:none; opacity:1; transform:none; }
/* 量尺寸的那一帧把变换整个关掉:待机态同时挂着 scale 和 rotate,
   从变换后的外框反推布局尺寸必然带误差(实测 4 家差 11px、6 家差 16px)。
   仍是 opacity:0,用户看不见这一帧。 */
.fx-tile.is-measuring{ transform:none; transition:none; }

/* 章节名和营业态竖排,不抢同一个角 */
/* 章节名/营业态排在**右上角徽标之下**:.fx-tile__st 是无条件渲染的(永远占着右上角),
   同一行放不下「第 N 章 · 章节名」+「现场状态待同步」——实拍就是徽标把章节名盖掉一半。
   下移一行比压窄宽度好:章节名不用截断。 */
.fx-tile__tags{ position:absolute; left:22rpx; top:22rpx; right:22rpx;   /* 样机 11px;原来的 74rpx 是给「已核销」角标让位,那枚角标已删 */
  display:flex; flex-direction:column; align-items:flex-start; gap:8rpx; }
.fx-tile__chap{ max-width:100%; padding:6rpx 16rpx; border-radius:var(--cy-radius-pill);
  font-size:19rpx; font-weight:600; /* ds-ok 压在图上的玻璃小标,比 caption 小 */
  background:rgba(0,0,0,.46); color:rgba(255,255,255,.90); /* ds-ok 同上 */
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.fx-tile__im{ position:absolute; left:0; top:0; width:100%; height:100%; }
.fx-tile__shade{ position:absolute; left:0; right:0; top:0; bottom:0;
  background:linear-gradient(180deg, rgba(0,0,0,.10) 0%, rgba(0,0,0,.30) 40%, rgba(10,8,6,.90) 100%); } /* ds-ok 保证卡面文字可读的压暗 */
.fx-tile__biz{ display:flex; align-items:center; gap:10rpx; max-width:100%;
  padding:6rpx 16rpx; border-radius:var(--cy-radius-pill); font-size:19rpx; /* ds-ok 压在图上的玻璃小标,比 caption 小 */
  background:rgba(0,0,0,.40); color:rgba(255,255,255,.84); } /* ds-ok 压在图上的玻璃小标 */
.fx-tile__dot{ width:10rpx; height:10rpx; border-radius:var(--cy-radius-pill); flex:none; }
.fx-tile__st{ position:absolute; right:18rpx; top:18rpx; padding:6rpx 16rpx;
  border-radius:var(--cy-radius-pill); font-size:18rpx; font-weight:700; /* ds-ok 角标字号,无对应 token */
  background:rgba(255,255,255,.92); color:#101828; } /* ds-ok 已体验角标:白底深字,不借用开始绿 */
.fx-tile__c{ position:absolute; left:0; right:0; bottom:0; padding:22rpx; }
.fx-tile__n{ display:block; font-size:27rpx; font-weight:700; color:#FFFFFF; /* ds-ok 图上文字恒白 */
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.fx-tile__p{ display:block; margin-top:8rpx; font-size:20rpx; color:rgba(255,255,255,.64); /* ds-ok 压在图上的文字恒白,不进夜端语义层 */
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; } /* ds-ok 同上 */
.fx-tile__perk{ margin-top:14rpx; display:flex; align-items:baseline; gap:10rpx; }
.fx-tile__cn{ flex:1; min-width:0; font-size:19rpx; color:rgba(255,255,255,.5); /* ds-ok 同上 */
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; } /* ds-ok 同上 */
.fx-tile__ph{ position:absolute; left:0; right:0; top:0; bottom:0; display:flex;
  align-items:center; justify-content:center;   /* 卡片按剩余高度等分后变高,贴顶会和章节小标撞上 */
  color:rgba(255,255,255,.13); } /* ds-ok 无封面时的占位,弱到不抢文字 */
.fx-tile.is-done{ filter:grayscale(1) brightness(.72); }  /* 整卡压暗:灰化只挂 img 时,无图的卡看不出已体验 */
.fx-tile.is-done .fx-tile__im{ opacity:.5; }
.fx-tile.is-done .fx-tile__n{ color:#B7BBC2; } /* ds-ok 已体验转灰 */
.fx-tail{ padding:var(--cy-space-5) var(--cy-page-x) var(--cy-space-6); text-align:center;
  font-size:21rpx; color:var(--cy-color-text-tertiary); } /* ds-ok 页尾说明,比 caption 小一档 */

/* ── 镭射卡包:全静态叠加,没有任何循环动画 ──
   真镭射膜的辨识度在「褶皱造成的高对比断裂」,不在均匀彩虹 ⇒ 色段宽窄刻意不均、
   亮脊紧挨暗谷。⚠️ 上线前建议把这层离线合成一张 PNG:静态图更省、也免掉多重渐变的真机开销。 */
.fx-packwrap{ position:absolute; left:0; right:0; top:0; bottom:0; z-index:40;
  display:flex; align-items:center; justify-content:center; }
/* ⚠️ position + z-index 都是必需的,别当冗余删掉:
     ① 撕口/袋口片/顶部封口条是 .fx-pack 的直接子元素(封口条要扯出包外,不能放进
        overflow:hidden 的 __body),它们 position:absolute 需要这里有定位祖先;
     ② 有 transform 的元素等价于 z-index:0,不显式抬到 40 的话,爆炸的光效层
        (31~34)会全部盖在包**表面**上 —— 那就成了「屏幕闪了一下」。 */
.fx-pack{ position:relative; z-index:40; width:424rpx; height:741rpx;
  transform:rotate(-3.4deg); transform-origin:50% 62%; }
/* 高度由包装图的原始比例定(pages/play/assets/pack-foil.png 330×577):424 × 577/330 ≈ 741rpx。
   按别的比例拉伸,膜面的褶皱会跟着变形,一眼假。换图时这三个数要一起改:
   包高、上封口 12%、下封口 5%。 */
.fx-pack__body{ position:relative; width:100%; height:100%; overflow:hidden;   /* 不设圆角:真图自带边形 */
  box-shadow:0 52rpx 80rpx rgba(0,0,0,.62); } /* ds-ok 实物投影 */
/* 膜面/封口都是**图片切片**,不是背景 —— WXSS 的 background-image 不吃本地图片。
   袋身铺整幅;上下封口用同一张图,靠父级 overflow:hidden 各露出一条。
   (2026-08-12 那轮「用 CSS 画镭射」的兜底到此作废:真图一上,渐变全是多余的。) */
.fx-pack__foil{ position:absolute; left:0; top:0; width:100%; height:100%; }
/* 封口压边:细齿纹 —— 塑料袋的辨识度大半在这两条 */
.fx-pack__seal{ position:absolute; left:0; right:0; overflow:hidden; }
/* 封口占比按实物定稿:上 12%、下 5%。撕口/袋口片跟着上封口走。 */
.fx-pack__seal--t{ top:0; height:89rpx; }              /* 741 × 12% */
.fx-pack__seal--b{ bottom:0; height:37rpx; }           /* 741 × 5%  */
/* 内层是整幅图,靠父级 overflow:hidden 只露出该露的那一条 */
.fx-pack__sealim{ position:absolute; left:0; top:0; width:424rpx; height:741rpx; }
.fx-pack__sealim--b{ top:-704rpx; }                    /* -(741 - 37):把底边对齐到下封口 */
/* 印刷:参考图的比例 —— 主标从包高 26.5% 起,副标隔一整行空档。
   ⚠️ 膜是浅色的 ⇒ 字必须是黑的(原来是深色包装上的浅字,换图后要整个反过来)。 */
.fx-pack__print{ position:absolute; left:52rpx; right:40rpx; top:196rpx; }
.fx-pack__t{ display:block; font-size:74rpx; font-weight:800; line-height:.98; letter-spacing:-2rpx; /* ds-ok 包装印刷:实物尺度,不属于页面字阶 */
  color:#0A0A0A; } /* ds-ok 浅色镭射膜上的黑色印刷 */
.fx-pack__s{ display:block; margin-top:62rpx; font-size:26rpx; font-weight:700; color:#0A0A0A; } /* ds-ok 同上 */

/* ② 蓄力 1000ms:摇 + 四周压暗。没有这层压暗,后面的闪光炸不出反差。 */
.fx-pack.is-shake{ animation:fxShake 1s cubic-bezier(.36,.07,.19,.97) both; }
@keyframes fxShake{
  0%{ transform:rotate(-3.4deg) translate(0,0) scale(1); }
  26%{ transform:rotate(-6deg) translate(10rpx,-6rpx) scale(1.02); }
  54%{ transform:rotate(-7deg) translate(16rpx,-8rpx) scale(1.045); }
  84%{ transform:rotate(-5deg) translate(14rpx,-6rpx) scale(1.07); }
  100%{ transform:rotate(-1.5deg) translate(0,0) scale(1.08); }
}
.fx-dim{ position:absolute; left:0; right:0; top:0; bottom:0; z-index:30; pointer-events:none;
  background:#000; opacity:0; } /* ds-ok 蓄力压暗:纯黑降透明度,不是配色层 */
.fx-dim.is-on{ opacity:.42; transition:opacity 1s ease-in; }

/* ③ 横撕 640ms:顶部封口条整条向右扯走,撕口自左向右露出。真袋子就是这么开的,
      不是从中缝裂开。封口条在 __body 之外,否则会被 overflow:hidden 裁掉。 */
.fx-pack.is-tear{ transform:rotate(-1.5deg) scale(1.08); }
.fx-pack.is-tear .fx-pack__seal--t{ animation:fxRip .64s cubic-bezier(.42,.02,.30,1) forwards; }

/* ③′ 拖拽撕开三态。撕口进度本体是内联 style(JS _applyTear 算),这里只管:
   is-grab 咬住封口的抓握反馈;is-snap 松手后补完/弹回的过渡(.18s = JS TEAR_SNAP);
   is-torn 拖到位的终态 —— transform 必须等于 fxSink 的 0% 帧,否则下坠起步会跳一下。 */
.fx-pack.is-grab{ transform:rotate(-1deg) scale(1.03); transition:transform .2s ease-out; }
.fx-pack.is-snap{ transition:transform .18s ease-out; }
.fx-pack.is-snap .fx-pack__seal--t{ transition:transform .18s ease-out, opacity .18s ease-out; }
.fx-pack.is-snap .fx-pack__mouth{ transition:width .18s ease-out; }
.fx-pack.is-torn{ transform:rotate(-1.5deg) scale(1.08); }
.fx-pack.is-torn .fx-pack__flap--l{ animation:fxFlapL .18s cubic-bezier(.2,.7,.3,1) forwards; }
.fx-pack.is-torn .fx-pack__flap--r{ animation:fxFlapR .18s cubic-bezier(.2,.7,.3,1) forwards; }
@keyframes fxRip{
  0%{ transform:translate(0,0) rotate(0deg); opacity:1; }
  22%{ transform:translate(20rpx,-2rpx) rotate(.6deg); opacity:1; }
  100%{ transform:translate(500rpx,-18rpx) rotate(5deg); opacity:0; }
}
.fx-pack__mouth{ position:absolute; left:0; right:0; top:0; height:48rpx; z-index:3;
  overflow:hidden; width:0; }
.fx-pack.is-tear .fx-pack__mouth{ animation:fxMouth .64s cubic-bezier(.42,.02,.30,1) forwards; }
@keyframes fxMouth{ 0%{ width:0; } 100%{ width:100%; } }
/* 锯齿边:齿高不齐才像撕的。用 background 画,比 clip-path 兼容面稳。 */
/* 撕口 = 一条**窄**的暗缝 + 不规则的齿边。两处要点:
   ① 底色那层必须空出底部留给齿 —— 铺满的话齿画在它上面等于没生效(实拍是条直边黑方块);
   ② 齿要用两种周期叠(23/31rpx),单一周期读起来是锯条,不是撕开的塑料。 */
.fx-pack__teeth{ position:absolute; left:0; top:0; width:424rpx; height:100%;
  background:
    linear-gradient(-52deg, transparent 0 5rpx, #141920 5rpx) bottom left / 23rpx 13rpx repeat-x, /* ds-ok 撕口齿:袋内的暗,不是页面表面 */
    linear-gradient(-38deg, transparent 0 7rpx, #10151B 7rpx) bottom left / 31rpx 10rpx repeat-x, /* ds-ok 同上,错开周期打破规律 */
    linear-gradient(180deg, #0A0D11 0%, #161C24 100%) top left / 100% calc(100% - 13rpx) no-repeat; } /* ds-ok 袋内的暗,不是页面表面 */
.fx-pack__flap{ position:absolute; top:89rpx; height:44rpx; width:46%; z-index:2; opacity:0;
  background:linear-gradient(180deg, rgba(226,236,238,.92) 0%, rgba(150,172,180,.5) 100%); } /* ds-ok 袋口内侧 */
.fx-pack__flap--l{ left:2%; transform-origin:0% 0%; }
.fx-pack__flap--r{ right:2%; transform-origin:100% 0%; }
.fx-pack.is-tear .fx-pack__flap--l{ animation:fxFlapL .64s cubic-bezier(.2,.7,.3,1) forwards; }
.fx-pack.is-tear .fx-pack__flap--r{ animation:fxFlapR .64s cubic-bezier(.2,.7,.3,1) forwards; }
@keyframes fxFlapL{ 0%{ opacity:0; transform:rotate(0); } 45%{ opacity:.9; } 100%{ opacity:.9; transform:rotate(-11deg); } }
@keyframes fxFlapR{ 0%{ opacity:0; transform:rotate(0); } 45%{ opacity:.9; } 100%{ opacity:.9; transform:rotate(11deg); } }

/* ④ 空袋自由落体:爆完就往下坠出画面,把屏幕正中让给卡片。
      缓动必须是加速的 —— 匀速或 ease-in-out 读起来像「被谁拖走」,不像掉下去。 */
.fx-pack.is-sink{ animation:fxSink .72s cubic-bezier(.45,0,.75,.55) forwards; }
@keyframes fxSink{
  0%{ transform:rotate(-1.5deg) scale(1.08) translateY(0); opacity:1; }
  55%{ opacity:1; }
  100%{ transform:rotate(13deg) scale(1) translateY(620rpx); opacity:0; }
}

/* ── 爆炸六层。★ 光效 z-index 全部低于卡包(40),碎片高于卡包。
      光跑到包表面上就成了「屏幕闪了一下」,不是「从袋子里炸出来」。
      爆心 = 卡包正中:卡包是 flex 居中的,所以这些层用 50%/50% 就与之重合。 ── */
/* 爆炸的核心光:★ 只做「根」,不做「环」。
   原来它从 scale(.14) 涨到 2.4,软边一路铺开就读成一圈扩散的圆环 ——
   用户要的是四射的光,不是圆环。所以尺寸砍半、几乎不涨,亮度交给放射光条。 */
.fx-bloom{ position:absolute; left:50%; top:50%; z-index:31; width:560rpx; height:560rpx;
  margin:-280rpx 0 0 -280rpx; border-radius:var(--cy-radius-pill); pointer-events:none;
  background:radial-gradient(circle, rgba(255,255,255,.92) 0%, rgba(242,227,184,.72) 22%, /* ds-ok 开包核心光 */
    rgba(245,214,200,.40) 44%, rgba(216,200,232,.16) 66%, rgba(191,232,224,0) 84%); /* ds-ok 同上 */
  animation:fxBloom 1.24s cubic-bezier(.1,.7,.3,1) forwards; }
@keyframes fxBloom{ 0%{ opacity:0; transform:scale(.5); } 14%{ opacity:1; }
  100%{ opacity:0; transform:scale(1.15); } }

/* 放射光条:爆心在包正中 ⇒ 全向等分。角度/长度/颜色由 blastRays 内联给。
   外层只吃角度(宽高为 0,原点即爆心),内层做伸长 —— 见 WXML 里的说明。 */
.fx-ray{ position:absolute; left:50%; top:50%; z-index:33; width:0; height:0;
  pointer-events:none; transform-origin:0 0; }
.fx-ray__b{ position:absolute; left:0; bottom:0; opacity:0; transform-origin:50% 100%;
  filter:blur(1rpx);   /* 圆环删掉后,四射的光是唯一的方向感来源 —— 让它更实 */
  animation:fxRay 1s cubic-bezier(.08,.76,.28,1) forwards; }
@keyframes fxRay{
  0%{ opacity:0; transform:scaleY(.06) scaleX(1); }
  16%{ opacity:.92; }
  100%{ opacity:0; transform:scaleY(1) scaleX(.28); }
}

/* 碎片:三成大块碎膜七成细屑,尺寸一致就读成彩纸。在包**前面**飞 —— 它们是实体不是光。 */
.fx-shard{ position:absolute; left:50%; top:50%; z-index:45; pointer-events:none;
  border-radius:2rpx; /* ds-ok 碎屑的实物圆角,比任何 radius token 都小 */
  animation:fxShard 2s cubic-bezier(.14,.72,.34,1) forwards; }
@keyframes fxShard{
  0%{ transform:translate(-50%,-50%) rotate(0deg) scale(.5); opacity:0; }
  12%{ opacity:1; }
  100%{ transform:translate(calc(-50% + var(--dx,0px)), calc(-50% + var(--dy,0px)))
        rotate(var(--srot,0deg)) scale(1); opacity:0; }
}

.play--reduced-motion .fx-pack.is-shake,
.play--reduced-motion .fx-pack.is-tear .fx-pack__seal--t,
.play--reduced-motion .fx-pack.is-tear .fx-pack__mouth,
.play--reduced-motion .fx-pack.is-tear .fx-pack__flap,
.play--reduced-motion .fx-pack.is-sink{ animation:none; }
.play--reduced-motion .fx-dim,
.play--reduced-motion .fx-bloom,
.play--reduced-motion .fx-ray,
.play--reduced-motion .fx-ray__b,
.play--reduced-motion .fx-shard{ display:none; }

/* 到店那一步的核销入口:比其他 sheet-nav 重一档,但仍是中性色 */
.sheet-nav--verify{ background:rgba(255,255,255,.10); } /* ds-ok 半屏内的次级强调面 */

/* 章节块流里的图片 / 音频块。外层仍是 .chfull__para(measureChapter 按它对齐下标),
   这里只管块内长相:图片撑满可读宽度,音频是一枚可点的浅色域胶囊。
   ⚠️ 2026-09-06 起**两种音频并存**:这枚是故事流里带位置的片段(读到这儿才响);
      整章的背景旁白走 chapter.audioUrl,进本章自动播放,没有对应的可点块。 */
.chfull__img{ width:100%; border-radius:23rpx; } /* ds-ok 与 .chstat__v 同一只圆角(Figma 实测) */
/* 相册(块类型 dream;2026-09-24 用户):故事流里一条圆角照片带,一直匀速滚动,下面带镜面倒影;点开看全屏(.album)。
   ⚠️ 外层仍是一个 .chfull__para —— measureChapter 按它对齐,这里只画块内。 */
.chfull__album{ width:100%; display:flex; flex-direction:column; align-items:center; gap:20rpx; padding:24rpx 0; }
.chfull__album-strip{ width:100%; height:520rpx; }
.chfull__album-tile{ height:100%; padding:0 12rpx; box-sizing:border-box; }
.chfull__album-img{ width:100%; height:340rpx; border-radius:28rpx; } /* ds-ok 圆角照片 */
.chfull__album-mirror{ position:relative; height:150rpx; margin-top:10rpx; overflow:hidden; border-radius:28rpx 28rpx 0 0; opacity:.35; filter:blur(2px); } /* ds-ok 镜面倒影 */
.chfull__album-mirror::after{ content:''; position:absolute; left:0; right:0; top:0; bottom:0;
  background:linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 100%); } /* ds-ok 倒影渐隐进故事底 */
.chfull__album-mirror-img{ width:100%; height:340rpx; transform:scaleY(-1); } /* ds-ok 翻转后原图底边在最上,容器只露这一截 */
.chfull__album-k{ font-size:21rpx; letter-spacing:4rpx; color:rgba(255,255,255,.55); } /* ds-ok 同 .pv-ending__k */
.chfull__audio{ min-height:var(--cy-btn-h); box-sizing:border-box; display:flex; align-items:center; gap:15rpx; padding:23rpx 38rpx;
  border-radius:var(--cy-radius-pill); background:var(--cy-color-play-story-accent); color:var(--cy-color-play-story-cta-fg); }
.chfull__audio-label{ font-size:31rpx; } /* ds-ok 与 .chstat__v 同一档字号(Figma 实测) */
.chfull__audio-transcript{ display:block; margin-top:var(--cy-space-2); font-size:var(--cy-font-caption); line-height:1.6;
  color:var(--cy-color-text-secondary); white-space:pre-wrap; }

/* 站末分支图(契约 §3.3):一行一步,只列本次真实走过的走向。
   颜色走 .finsheet 内已重映射的 play-story 语义 token,不引第二套皮肤。 */
.branchpath{ margin-top:31rpx; padding:var(--cy-space-3); border-radius:var(--cy-radius-lg);
  background:var(--cy-color-bg-surface-subtle); }
.branchpath__k{ font-size:var(--cy-type-label); font-weight:700; color:var(--cy-color-text-primary); }
.branchpath__row{ display:flex; align-items:flex-start; gap:var(--cy-space-2); margin-top:var(--cy-space-2); }
.branchpath__dot{ flex:none; margin-top:9rpx; width:16rpx; height:16rpx; box-sizing:border-box;
  border:4rpx solid var(--cy-color-action-primary-bg); border-radius:var(--cy-radius-pill);
  background:var(--cy-color-text-primary); }
.branchpath__copy{ flex:1; min-width:0; display:flex; align-items:baseline; justify-content:space-between; gap:var(--cy-space-2); }
.branchpath__step{ display:flex; align-items:center; gap:var(--cy-space-1); font-size:var(--cy-type-body); color:var(--cy-color-text-primary); }
.branchpath__arrow{ flex:none; color:var(--cy-color-text-tertiary); }
.branchpath__meta{ flex:none; font-size:var(--cy-type-caption); color:var(--cy-color-text-tertiary); }

/* ── 探店日结算:集章列表与奖励行沿用共用字阶与故事主题 ── */
.finsheet__stamplist{ margin:16rpx 40rpx 0; }
.finsheet__stampline{ display:flex; align-items:center; gap:12rpx; padding:10rpx 0; font-size:var(--cy-type-label); color:var(--cy-color-play-story-muted); }
.finsheet__reward{ margin:20rpx 40rpx 0; text-align:center; font-size:var(--cy-type-label); color:var(--cy-color-play-story-muted); }

/* ===== 升级4:节点级前置解锁(前路未知)———硬闸在服务端,这里只做视觉置灰 ===== */
.fx-tile.is-locked { opacity: 0.55; }
.fx-tile.is-locked .fx-tile__im { filter: blur(4rpx) grayscale(0.6); }
.fx-tile__lock {
  position: absolute; left: 0; right: 0; top: 42%; text-align: center;
  color:var(--cy-text-title); font-size:var(--cy-font-label); font-weight:600; display:flex; align-items:center; justify-content:center; gap:var(--cy-space-1);
  letter-spacing: 8rpx; text-shadow: 0 2rpx 12rpx rgba(0,0,0,.6); /* ds-ok 锁标压图可读性投影 */
}

/* ===== 升级2:角色卡(v5 语言:scrim + 深玻璃 + 紫描边 + 翻入) ===== */
/* 2026-09-02:原 960/961 —— 夹在 toast(950)与 celebrate(990)之间,等于身份卡会压住 toast、
   又被庆祝层压住,两头都不是有意设计。居中卡 = modal 档;本页其它浮层最高 210,顺序不变。 */
.rolemask { position: fixed; inset: 0; z-index: var(--cy-z-modal); background: rgba(0,0,0,.55); /* ds-ok 弹窗 scrim */ }
.rolecard {
  position: fixed; left: 50%; top: 50%; z-index: calc(var(--cy-z-modal) + 1); width: 600rpx;
  transform: translate(-50%, -50%);
  padding: 64rpx 48rpx 48rpx; box-sizing: border-box; text-align: center;
  background: rgba(10,10,11,.92); border: 2rpx solid rgba(255,255,255,.35); /* ds-ok 玻璃卡材质(cy-sheet 同规) */
  border-radius: var(--cy-radius-xl);
  box-shadow: 0 36rpx 72rpx rgba(0,0,0,.65); /* ds-ok 弹窗层投影 */
  animation: rolecard-in .45s cubic-bezier(.2,.9,.3,1.15) both;
}
@keyframes rolecard-in {
  from { transform: translate(-50%, -50%) rotateY(90deg); opacity: 0; }
  to   { transform: translate(-50%, -50%) rotateY(0deg);  opacity: 1; }
}
.rolecard__tag { font-size: var(--cy-font-caption); color: var(--cy-text-secondary); letter-spacing: 6rpx; }
.rolecard__emb {
  width: 168rpx; height: 168rpx; margin: 28rpx auto 20rpx; border-radius: 50%;
  display:flex; align-items:center; justify-content:center; color:var(--cy-text-title);
  background: rgba(255,255,255,.08); border: 4rpx solid rgba(255,255,255,.9); /* ds-ok 徽记环玻璃材质 */
  box-shadow: 0 0 44rpx rgba(255,255,255,.22); /* ds-ok 徽记辉光 */
}
.rolecard__name { font-size: 60rpx; /* ds-ok 角色名仪式感大字 */ font-weight: 800; color: var(--cy-text-title); letter-spacing: 8rpx; }
.rolecard__desc { margin-top: 20rpx; font-size: var(--cy-font-body); color: var(--cy-text-body); line-height: 1.7; }
.rolecard__skill {
  margin-top: 28rpx; padding: 18rpx 24rpx; border-radius: var(--cy-radius-md);
  background:rgba(255,255,255,.06); color:var(--cy-text-body); font-size:var(--cy-font-label); text-align:left; display:flex; align-items:flex-start; gap:var(--cy-space-2); /* ds-ok 玻璃材质层次(cy-sheet 同规) */
}
.rolecard__cta {
  margin-top: 36rpx; padding: 26rpx 0; border-radius: var(--cy-radius-pill);
  background: var(--cy-brand); color: var(--cy-bg-page); font-size: var(--cy-font-subtitle); font-weight: 800; letter-spacing: 4rpx;
}
.rolecard__retry {
  margin-top: var(--cy-space-2);
  padding: var(--cy-space-3) 0;
  border: 1rpx solid var(--cy-text-body);
  border-radius: var(--cy-radius-pill);
  color: var(--cy-text-body);
  font-size: var(--cy-font-label);
  text-align: center;
}

/* ===== 升级3:同行者榜 ===== */
.board { padding: 8rpx 8rpx 24rpx; }
.board__loading, .board__empty { padding: 64rpx 0; text-align: center; color: var(--cy-text-secondary); font-size: var(--cy-font-body); }
.board__row { display: flex; align-items: center; gap: 24rpx; padding: 26rpx 8rpx; border-bottom: 1rpx solid rgba(255,255,255,.08); } /* ds-ok 玻璃材质层次(cy-sheet 同规) */
.board__row.is-first { padding: 32rpx 8rpx; }
.board__rank { width: 56rpx; font-weight: 800; font-style: italic; color: var(--cy-text-secondary); font-size: var(--cy-font-subtitle); }
.board__rank.is-first { color: var(--cy-gold); font-size: 48rpx; /* ds-ok 榜首名次展示号 */ }
.board__avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--cy-bg-elevated); }
.board__avatar--ph { border: 1rpx solid rgba(255,255,255,.14); } /* ds-ok 玻璃材质层次(cy-sheet 同规) */
.board__nick { flex: 1; font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-text-title); }
.board__score { font-size: var(--cy-font-label); color: var(--cy-text-body); }
.board__crown { display:flex; align-items:center; color:var(--cy-gold); }
.board__me {
  display: flex; align-items: center; gap: 24rpx; margin-top: 28rpx; padding: 28rpx 28rpx;
  border-radius: var(--cy-radius-pill); background: var(--cy-brand); color: var(--cy-bg-page);
}
.board__me-rank { font-weight: 800; font-style: italic; font-size: var(--cy-font-subtitle); }
.board__me-nick { font-weight: 800; }
.board__me-score { margin-left: auto; font-size: var(--cy-font-label); font-weight: 600; }
.fx-meta__role { color: var(--cy-text-title); }

/* 三身份游戏模组·玩家投影：继续使用玩家页现有深色 sheet 与黑白状态，不新造皮肤。 */
.gmod { padding: var(--cy-space-2) 0 var(--cy-space-4); }
.gmod__role, .gmod__ending {
  padding: var(--cy-space-4);
  border: 1rpx solid var(--cy-color-play-line);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-play-surface-subtle);
}
.gmod__eyebrow, .gmod__sync {
  display: block;
  color: var(--cy-color-play-ink-muted);
  font-size: var(--cy-type-caption);
}
.gmod__role-name, .gmod__ending-title {
  display: block;
  margin-top: var(--cy-space-1);
  color: var(--cy-color-play-accent);
  font-size: var(--cy-type-section-title);
  font-weight: 700;
}
.gmod__sync { margin-top: var(--cy-space-2); }
.gmod__error, .gmod__stale, .gmod__write {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2);
  margin-bottom: var(--cy-space-3);
  padding: var(--cy-space-3);
  border: 1rpx solid var(--cy-color-play-line);
  border-radius: var(--cy-radius-md);
  color: var(--cy-color-play-accent);
  font-size: var(--cy-type-label);
}
.gmod__error text, .gmod__stale text, .gmod__write text { flex: 1; }
.gmod__write-actions { display: flex; flex: none; flex-direction: row; gap: var(--cy-space-2); }
.gmod__retry, .gmod__reconcile {
  min-width: 136rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-play-accent);
  color: var(--cy-color-play-ink);
  font-weight: 700;
}
.gmod__node { padding: var(--cy-space-4) 0; border-bottom: 1rpx solid var(--cy-color-play-line); }
.gmod__node-head { display: flex; justify-content: space-between; color: var(--cy-color-play-ink-muted); font-size: var(--cy-type-caption); }
.gmod__status { font-family: var(--cy-font-numeric); }
.gmod__clue, .gmod__empty, .gmod__ending-copy {
  display: block;
  margin-top: var(--cy-space-3);
  color: var(--cy-color-play-accent);
  font-size: var(--cy-type-body);
  line-height: 1.65;
}
.gmod__empty { color: var(--cy-color-play-ink-muted); }
.gmod__task { margin-top: var(--cy-space-3); padding: var(--cy-space-3); border: 1rpx solid var(--cy-color-play-line); border-radius: var(--cy-radius-md); background: var(--cy-color-play-surface-subtle); }
.gmod__task-title, .gmod__task-prompt, .gmod__submission text { display: block; }
.gmod__task-title { color: var(--cy-color-play-ink-muted); font-size: var(--cy-type-caption); }
.gmod__task-prompt { margin-top: var(--cy-space-1); color: var(--cy-color-play-accent); font-size: var(--cy-type-body); line-height: 1.55; }
.gmod__task-evidence { margin-top: var(--cy-space-3); }
.gmod__task-evidence-label,
.gmod__task-evidence-status,
.gmod__task-evidence-error {
  display: block;
  color: var(--cy-color-play-ink-muted);
  font-size: var(--cy-type-caption);
}
.gmod__task-text {
  width: 100%;
  min-height: 144rpx;
  box-sizing: border-box;
  margin-top: var(--cy-space-2);
  padding: var(--cy-space-3);
  border: 1rpx solid var(--cy-color-play-line);
  border-radius: var(--cy-radius-md);
  color: var(--cy-color-play-accent);
  background: transparent;
  font-size: var(--cy-type-body);
}
.gmod__task-capture {
  min-height: 88rpx;
  margin-top: var(--cy-space-2);
  padding: 0 var(--cy-space-3);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--cy-color-play-line);
  border-radius: var(--cy-radius-pill);
  color: var(--cy-color-play-accent);
  font-weight: 700;
}
.gmod__task-evidence-status { margin-top: var(--cy-space-2); color: var(--cy-color-play-accent); }
.gmod__task-evidence-error { margin-top: var(--cy-space-3); }
.gmod__submission { margin-top: var(--cy-space-2); color: var(--cy-color-play-ink-muted); font-size: var(--cy-type-caption); }
.gmod__task-submit { min-height: 88rpx; margin-top: var(--cy-space-3); display: flex; align-items: center; justify-content: center; border-radius: var(--cy-radius-pill); color: var(--cy-color-play-ink); background: var(--cy-color-play-accent); font-weight: 700; }
.gmod__task-submit.is-disabled { opacity: .45; }
.gmod__choices { display: flex; flex-direction: column; gap: var(--cy-space-2); margin-top: var(--cy-space-3); }
.gmod__choice {
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 var(--cy-space-3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--cy-color-play-line);
  border-radius: var(--cy-radius-md);
  color: var(--cy-color-play-accent);
  background: var(--cy-color-play-surface-subtle);
}
.gmod__choice text { flex: 1; padding-right: var(--cy-space-2); }
.gmod__choice.is-disabled { opacity: .45; }
.gmod__ending { margin-top: var(--cy-space-4); }
.gmod__team { margin-top: var(--cy-space-4); padding: var(--cy-space-3); border: 1rpx solid var(--cy-color-play-line); border-radius: var(--cy-radius-lg); }
.gmod__team-row { min-height: 72rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--cy-color-play-line); }
.gmod__team-copy { display: flex; align-items: center; gap: var(--cy-space-2); color: var(--cy-color-play-accent); font-size: var(--cy-type-label); }
.gmod__team-role, .gmod__team-status, .gmod__privacy { color: var(--cy-color-play-ink-muted); font-size: var(--cy-type-caption); }
.gmod__privacy { display: block; margin-top: var(--cy-space-2); }
.gmod__leaderboard { margin-top: var(--cy-space-4); padding: var(--cy-space-3); border: 1rpx solid var(--cy-color-play-line); border-radius: var(--cy-radius-lg); }
.gmod__leaderboard-row { min-height: 72rpx; display: flex; align-items: center; gap: var(--cy-space-2); border-bottom: 1rpx solid var(--cy-color-play-line); }
.gmod__leaderboard-rank { width: 44rpx; color: var(--cy-color-play-ink-muted); font-family: var(--cy-font-numeric); }
.gmod__leaderboard-name { flex: 1; color: var(--cy-color-play-accent); font-size: var(--cy-type-label); }
.gmod__leaderboard-score { color: var(--cy-color-play-ink-muted); font-size: var(--cy-type-caption); }
.finsheet__game-ending {
  margin-top: var(--cy-space-3);
  padding: var(--cy-space-3);
  border-left: 4rpx solid var(--cy-color-play-accent);
  background: var(--cy-color-play-surface-subtle);
}
.finsheet__game-ending-k { display: block; color: var(--cy-color-play-ink-muted); font-size: var(--cy-type-caption); }
.finsheet__game-ending-title { display: block; margin-top: var(--cy-space-1); color: var(--cy-color-play-accent); font-size: var(--cy-type-section-title); font-weight: 700; }
.finsheet__game-ending-copy { display: block; margin-top: var(--cy-space-2); color: var(--cy-color-play-ink-muted); font-size: var(--cy-type-label); line-height: 1.6; }

/* 装机计划偏好题：像一张现场校准单，沿用游玩页黑白材料，不另造一套亮色表单。 */
.pref-load,.pref-error{ padding:var(--cy-space-6) var(--cy-space-3); text-align:center; color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-body); }
.pref-error{ color:var(--cy-color-play-accent); text-decoration:underline; }
.pref-step__meta,.pref-result__stamp,.pref-inherit__eyebrow{ margin-bottom:var(--cy-space-2); color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-micro); letter-spacing:4rpx; text-transform:uppercase; }
.pref-options{ display:flex; flex-direction:column; gap:var(--cy-space-2); margin-top:var(--cy-space-4); }
.pref-option{ min-height:88rpx; padding:0 var(--cy-space-3); display:flex; align-items:center; gap:var(--cy-space-2-5); border:1rpx solid var(--cy-color-play-line); border-radius:var(--cy-radius-md); color:var(--cy-color-play-accent); background:var(--cy-color-play-surface-subtle); }
.pref-option.is-on{ border-color:var(--cy-color-play-accent); background:var(--cy-color-play-accent-soft); }
.pref-option__text{ flex:1; font-size:var(--cy-type-body); }
.pref-option__check{ width:32rpx; text-align:right; }
.pref-inherit{ padding:var(--cy-space-4); border:1rpx solid var(--cy-color-play-line); border-radius:var(--cy-radius-lg); background:var(--cy-color-play-surface-subtle); }
.pref-inherit__title,.pref-result__title{ display:block; color:var(--cy-color-play-accent); font-size:var(--cy-type-section-title); font-weight:700; line-height:1.25; }
.pref-inherit__tag{ margin-top:var(--cy-space-4); display:flex; justify-content:space-between; padding:var(--cy-space-2-5) 0; border-bottom:1rpx dashed var(--cy-color-play-line); color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-label); }
.pref-inherit__value{ color:var(--cy-color-play-accent); font-family:monospace; }
.pref-inherit__use{ margin-top:var(--cy-space-4); padding:var(--cy-space-3); border-radius:var(--cy-radius-pill); text-align:center; background:var(--cy-color-play-accent); color:var(--cy-color-play-ink); font-weight:700; }
.pref-inherit__again{ display:block; margin-top:var(--cy-space-3); text-align:center; color:var(--cy-color-play-ink-muted); text-decoration:underline; font-size:var(--cy-type-label); }
.pref-result{ padding:var(--cy-space-4); border:1rpx solid var(--cy-color-play-line); border-radius:var(--cy-radius-lg); background:linear-gradient(145deg,var(--cy-color-play-elevated),var(--cy-color-play-surface-base)); }
.pref-result__body{ display:block; margin-top:var(--cy-space-3); color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-body); line-height:1.7; }
.pref-result__next{ margin-top:var(--cy-space-4); padding:var(--cy-space-3); border-left:5rpx solid var(--cy-color-play-accent); background:var(--cy-color-play-accent-soft); color:var(--cy-color-play-accent); font-size:var(--cy-type-body); line-height:1.6; }
.pref-result__next-k{ display:block; margin-bottom:var(--cy-space-1); color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-micro); letter-spacing:3rpx; }
.pref-consent{ margin-top:var(--cy-space-4); padding-top:var(--cy-space-4); border-top:1rpx dashed var(--cy-color-play-line); }
.pref-consent__head{ color:var(--cy-color-play-accent); font-size:var(--cy-type-body); font-weight:700; }
.pref-consent__value{ margin-top:var(--cy-space-2); font-family:monospace; color:var(--cy-color-play-accent); }
.pref-consent__copy{ margin-top:var(--cy-space-1); color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-caption); line-height:1.5; }
.pref-consent__correct{ display:block; margin-top:var(--cy-space-2); color:var(--cy-color-play-accent); font-size:var(--cy-type-label); font-weight:600; text-decoration:underline; }
.pref-consent__acts{ margin-top:var(--cy-space-3); display:flex; justify-content:flex-end; gap:var(--cy-space-4); color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-label); }
.pref-consent__acts .is-primary{ color:var(--cy-color-play-accent); font-weight:700; }

/* 完局 OS：结构像一份私人装机清单；唯一视觉签名是 PRIVATE BUILD 编号戳。 */
.os-map-label{ position:absolute; left:var(--cy-space-3); top:var(--cy-space-3); z-index:3; padding:var(--cy-space-1) var(--cy-space-2); border:1rpx solid var(--cy-color-play-line); border-radius:var(--cy-radius-pill); background:var(--cy-color-play-surface); color:var(--cy-color-play-accent); font-size:var(--cy-type-caption); }
.newos{ margin-top:var(--cy-space-5); padding:var(--cy-space-4); border:1rpx solid var(--cy-color-play-line); border-radius:var(--cy-radius-lg); background:var(--cy-color-play-surface-subtle); }
.newos__eyebrow{ color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-micro); letter-spacing:4rpx; font-family:var(--cy-font-numeric); }
.newos__title{ margin-top:var(--cy-space-2); color:var(--cy-color-play-accent); font-size:var(--cy-type-section-title); font-weight:700; }
.newos__tags,.newos__cards{ margin-top:var(--cy-space-4); display:flex; flex-direction:column; gap:var(--cy-space-2); }
.newos__tag{ display:flex; align-items:center; justify-content:space-between; padding:var(--cy-space-2-5) var(--cy-space-3); border:1rpx solid var(--cy-color-play-line); border-radius:var(--cy-radius-md); color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-caption); }
.newos__tag-value{ margin-left:var(--cy-space-2); color:var(--cy-color-play-accent); font-family:monospace; }
.newos__revoke{ color:var(--cy-color-play-ink-muted); text-decoration:underline; }
.newos__card{ padding:var(--cy-space-3); border-left:4rpx solid var(--cy-color-play-accent); background:var(--cy-color-play-surface-base); }
.newos__card-k,.newos__plan-k{ color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-micro); letter-spacing:3rpx; }
.newos__card-title{ display:block; margin-top:var(--cy-space-1); color:var(--cy-color-play-accent); font-size:var(--cy-type-body); font-weight:700; }
.newos__card-body{ display:block; margin-top:var(--cy-space-1); color:var(--cy-color-play-ink-muted); font-size:var(--cy-type-label); line-height:1.55; }
.newos__plan{ margin-top:var(--cy-space-4); display:grid; grid-template-columns:1fr 1fr; gap:var(--cy-space-2); }
.newos__plan-col{ padding:var(--cy-space-3); border:1rpx dashed var(--cy-color-play-line); border-radius:var(--cy-radius-md); }
.newos__action{ display:block; margin-top:var(--cy-space-2); color:var(--cy-color-play-accent); font-size:var(--cy-type-caption); line-height:1.45; }

/* ── 奖励掉落卡 ──────────────────────────────────────────
   不是 toast:玩家没处理掉之前它一直在,回读入口不会一闪而过。
   两个动作**不等权**——「查看收藏」是实心主按钮,「继续」是无框次级,
   一眼能看出该往哪走;并排两个同款胶囊只会让人多做一次选择。
   入场用 ease-out 的短位移,不用弹跳:这是状态变化,不是庆祝。 */
.rdrop{
  position:fixed; left:var(--cy-space-4); right:var(--cy-space-4); bottom:220rpx; z-index:60;
  padding:var(--cy-space-3-5); border-radius:var(--cy-radius-lg);
  background:var(--cy-bg-card-2); border:1rpx solid var(--cy-border-card);
  animation:rdrop-in var(--cy-motion-slow) var(--cy-ease-out) both;
}
.rdrop__head{ display:flex; align-items:flex-start; gap:var(--cy-space-2-5); }
.rdrop__dot{
  flex:none; width:12rpx; height:12rpx; margin-top:14rpx; border-radius:50%;
  background:var(--cy-color-text-primary);
}
.rdrop__copy{ flex:1; min-width:0; }
.rdrop__t{ display:block; font-size:var(--cy-font-subtitle); line-height:1.4; color:var(--cy-color-text-primary); }
.rdrop__s{ display:block; margin-top:var(--cy-space-1); font-size:var(--cy-font-caption); line-height:1.4; color:var(--cy-color-text-secondary); }
.rdrop__row{ display:flex; align-items:center; gap:var(--cy-space-2); margin-top:var(--cy-space-3); }
.rdrop__go{
  flex:1; text-align:center; padding:20rpx 0; border-radius:var(--cy-radius-pill);
  background:var(--cy-color-text-primary); color:var(--cy-bg-card-2);
  font-size:var(--cy-font-label);
}
.rdrop__next{
  flex:none; padding:20rpx var(--cy-space-4);
  color:var(--cy-color-text-secondary); font-size:var(--cy-font-label);
}
@keyframes rdrop-in{ from{ opacity:0; transform:translateY(16rpx); } to{ opacity:1; transform:none; } }

/* ═══════ 点卡 → hero 展开层(2026-09-05,参考 cibby · shelf)═══════
   卡片克隆 absolute 落在被点瓦片的视口矩形上(left/top/width/height 由 JS 内联),
   is-open 后 transform 到 --hx/--hy/--hs:等比放大 + 平移,只动 transform 走合成层。
   transform 时长 = index.js HERO_DUR(play-seat-hero-contract 锁)。 */
.fx-hero{ position:fixed; left:0; right:0; top:0; bottom:0; z-index:105; } /* 高于预览态返回钮(100):创作者预览里点卡也要能收回,不能被「返回编辑器」盖住 */
.fx-hero__bg{ position:absolute; left:0; right:0; top:0; bottom:0; overflow:hidden;
  background:#0A0D13; /* ds-ok 模糊图之下的兜底底色,与 fx-bg__veil 同族 */
  opacity:0; transition:opacity .42s ease-out; }
.fx-hero.is-open .fx-hero__bg{ opacity:1; }
.fx-hero__bgim{ position:absolute; left:-10%; top:-10%; width:120%; height:120%;
  filter:blur(60rpx); }   /* 同 fx-bg__im:放大 120% 遮住 blur 糊出的透明边 */
.fx-hero__veil{ position:absolute; left:0; right:0; top:0; bottom:0;
  background:linear-gradient(180deg, rgba(10,13,19,.46) 0%, rgba(10,13,19,.66) 40%, rgba(10,13,19,.90) 100%); } /* ds-ok 模糊封面之上的压暗,正文要能读 */
/* 卡片缩走之后接管顶栏的紧凑条:缩略图 + 店名 + 章节 */
.fx-hero__hdr{ position:absolute; left:calc(var(--cy-page-x) + var(--cy-btn-h) + var(--cy-space-3));
  right:200rpx; z-index:3; height:var(--cy-btn-h); display:flex; align-items:center; gap:var(--cy-space-3);
  opacity:0; pointer-events:none; transition:opacity .18s ease; }
.fx-hero__hdr.is-on{ opacity:1; }
