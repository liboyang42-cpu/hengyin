/* l-play(2026-11-10,业主批准 proto/game 第二组「游玩与阶段弹窗」):主题内阶段弹窗 / 整屏的样式。
   只读 --lk-* 外观变量与 .lk-* 读者类(qx-base look-tokens.wxss),尺寸按原型 390 宽 px × 2 = rpx。只用过渡,不新增 keyframes。
   本文件由 index.wxss 在「故事文字动效」段之前引入,所以这里不能出现 animation。 */

/* ===== 居中弹窗壳(proto .gm-pop):压暗 + 居中外观卡,最高 80% 屏高 ===== */
.lk-popwrap { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: var(--cy-z-modal); display: flex; align-items: center; justify-content: center; padding: 0 40rpx; box-sizing: border-box; }
.lk-pop-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); } /* ds-ok 原型 .gm-pop .mask */
.look--stardust .lk-pop-mask { background: rgba(0,0,0,.4); } /* ds-ok 原型是 .18;这里压到 .4 —— 故事流底部的白色「继续探索」会透过果冻玻璃糊成一道白光,压暗一点仍看得见星野 */
.lk-popwrap .lk-pop { width: 100%; max-height: 80vh; display: flex; flex-direction: column; }

/* ===== 玩法开始弹窗(proto pop-kitstart / .kstart) ===== */
.ks__h { display: flex; align-items: center; justify-content: space-between; padding: 36rpx 36rpx 0; flex: none; }
.ks__t { font-size: 40rpx; } /* ds-ok 原型 px×2;圆角随外观 --lk-r */
.ks__x { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--lk-ctl); color: var(--lk-ink); display: flex; align-items: center; justify-content: center; }
.look--stardust .ks__x { background: rgba(var(--lk-ink-rgb), .16); }
.ks__b { flex: 1; min-height: 0; padding: 28rpx 36rpx 12rpx; box-sizing: border-box; }
.ks__cov { display: block; width: 100%; height: 300rpx; border-radius: calc(var(--lk-r) - 4rpx); background: var(--lk-ctl); } /* ds-ok 原型 px×2;圆角随外观 --lk-r */
.ks__cov--illus { display: flex; align-items: center; justify-content: center; }
.look--stardust .ks__cov { -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); } /* ds-ok 原型:星尘封面下沿融进玻璃 */
.ks__meta { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 24rpx 0 8rpx; }
.ks__meta .lk-chip { min-height: 56rpx; padding: 0 20rpx; font-size: 24rpx; white-space: nowrap; } /* ds-ok 原型 px×2;圆角随外观 --lk-r */
.ks__name { font-size: 48rpx; line-height: 1.3; margin: 20rpx 0 8rpx; } /* ds-ok 原型 px×2;圆角随外观 --lk-r */
.ks__lede { font-size: 30rpx; line-height: 1.8; } /* ds-ok 原型 px×2 */
.ks__row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 92rpx; margin-top: 16rpx; border-top: 1rpx solid; font-size: 30rpx; color: var(--lk-ink); } /* ds-ok 原型 px×2 */
.ks__v { font-family: var(--lk-fm); font-weight: 700; }
.ks__seg { display: flex; padding: 6rpx; margin: 24rpx 0 8rpx; border-radius: var(--lk-rb); background: var(--lk-ctl); gap: 4rpx; clip-path: var(--lk-cut); }
.look--stardust .ks__seg { background: rgba(var(--lk-ink-rgb), .10); }
.ks__m { flex: 1; min-height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--lk-rb); clip-path: var(--lk-cut); font-size: var(--cy-type-body); font-weight: 600; color: var(--lk-mute); transition: background var(--cy-motion-fast) ease, color var(--cy-motion-fast) ease; }
.ks__m.is-on { background: var(--lk-ink); color: var(--lk-bg); }
.ks__f { flex: none; padding: 20rpx 36rpx 36rpx; }

/* ===== 城市定向地点卡(proto gp-place):整屏照片 + 玻璃面板,返回在左上,站序药丸在顶上,没有分享 ===== */
.sheet.sheet--game .sheet-cover { position: absolute; left: 0; top: 0; right: 0; bottom: 0; height: auto; }
.sheet.sheet--game .sheet-cover--bare { background: var(--lk-card, var(--cy-comp-sheet-player-elevated)); }
.sheet--game .sheet-cover image { object-fit: cover; }
.sheet.sheet--game .cover-fade { height: 100%; background: linear-gradient(180deg, rgba(0,0,0,.3), transparent 30%, transparent 55%, rgba(0,0,0,.35)); } /* ds-ok 原型 .place--v2 .photo::after */
.sheet.sheet--game .cover-tag { top: calc(var(--sheet-top, 0px) + 112rpx); bottom: auto; left: 40rpx; height: 56rpx; padding: 0 24rpx; display: inline-flex; align-items: center; gap: 12rpx; border: 0; border-radius: var(--lk-rb, var(--cy-radius-pill)); clip-path: var(--lk-cut); background: var(--lk-ink, #FFFFFF); color: var(--lk-bg, #000000); font-family: var(--lk-fm); font-weight: 700; letter-spacing: .04em; } /* ds-ok 回落玩家黑白 */
.sheet.sheet--game .cover-open { top: calc(var(--sheet-top, 0px) + 200rpx); bottom: auto; right: 40rpx; left: auto; } /* 营业态在胶囊下方右侧(左侧是返回钮) */
.sheet.sheet--game .cover-photos { bottom: auto; top: calc(var(--sheet-top, 0px) + 112rpx); }
.sheet.sheet--game .cover-stamp { bottom: auto; top: calc(var(--sheet-top, 0px) + 184rpx); right: 40rpx; }
.sheet.sheet--game .sheet-x { left: 24rpx; right: auto; background: rgba(var(--lk-ink-rgb, 255,255,255), .12); color: var(--lk-ink, #FFFFFF); } /* ds-ok 回落白 */
.sheet.sheet--game .sheet-body { position: relative; z-index: 2; flex: none; margin: auto 28rpx calc(36rpx + env(safe-area-inset-bottom)); padding: 36rpx 36rpx 40rpx; max-height: calc(100vh - var(--sheet-top, 0px) - 220rpx); overflow-y: auto; box-sizing: border-box; }
.sheet.sheet--game .sheet-body.lk-pop { border-radius: var(--lk-r, var(--cy-radius-xl)); }
.sheet.sheet--game .sheet-name { margin-top: 8rpx; font-size: 60rpx; line-height: 1.2; font-family: var(--lk-fd); font-weight: var(--lk-fw, 700); letter-spacing: var(--lk-ls); color: var(--lk-ink, #FFFFFF); } /* ds-ok 回落白 */
.sheet--game .sheet-meta { color: var(--lk-mute, #8A93A0); font-family: var(--lk-fm); font-size: 26rpx; } /* ds-ok 回落原值 */
.sheet--game .sheet-desc { margin-top: 20rpx; font-size: 28rpx; line-height: 1.65; color: var(--lk-dim, #8A93A0); } /* ds-ok 回落原值 */
.look--stardust .sheet.sheet--game .sheet-body.lk-pop { color: #FFFFFF; } /* ds-ok 原型:照片上的玻璃字永远白 */
.look--stardust .sheet--game .sheet-desc, .look--stardust .sheet--game .sheet-meta, .look--stardust .sheet--game .sheet-dist__k { color: rgba(255,255,255,.8); } /* ds-ok 原型 */
.look--stardust .sheet--game .sheet-name, .look--stardust .sheet--game .sheet-dist__n { color: #FFFFFF; } /* ds-ok 原型 */
.sheet-dist { display: flex; gap: 36rpx; margin: 24rpx 0 8rpx; }
.sheet-dist__n { display: block; font-size: 44rpx; font-weight: 700; color: var(--lk-ink, #FFFFFF); } /* ds-ok 回落白 */
.sheet-dist__k { display: block; margin-top: 2rpx; font-size: 22rpx; letter-spacing: .1em; color: var(--lk-mute, #8A93A0); } /* ds-ok 回落原值 */
.sheet-kit { display: flex; align-items: center; gap: 24rpx; margin: 16rpx 0 24rpx; padding: 20rpx; transition: transform var(--cy-motion-press) ease; }
.sheet-kit--press { transform: scale(.98); }
.look--stardust .sheet-kit { background: rgba(255,255,255,.08); } /* ds-ok 原型 .glass-panel .kitc */
.sheet-kit__img { flex: none; width: 168rpx; height: 128rpx; border-radius: calc(var(--lk-r) - 8rpx); background: var(--lk-ctl); } /* ds-ok 原型 px×2;圆角随外观 --lk-r */
.sheet-kit__img--illus { display: flex; align-items: center; justify-content: center; }
.sheet-kit__copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.sheet-kit__t { font-size: 30rpx; font-weight: 600; font-family: var(--lk-fd); color: var(--lk-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } /* ds-ok: 上线波次原型逐值(装饰 / 品牌色块) */
.sheet-kit__s { font-size: var(--cy-type-label); color: var(--lk-mute); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.sheet-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.sheet-row > .lk-btn, .sheet-row > .cy-btn, .sheet-row > cy-btn { flex: 1; min-width: 0; }
.sheet-row .lk-btn--ghost { flex: 0 0 200rpx; }
.sheet--game .sheet-row cy-btn { margin-top: 0 !important; }

/* ===== 延伸任务翻页卡(proto pop-ext / .flipdeck):一次一张,绕竖轴翻到下一张;圆点 + 右下箭头;「去做」 ===== */
.xd { height: 820rpx; position: relative; } /* 透视写在每张卡自己的 transform 里:父级一开 3D 渲染上下文,外层玻璃的 backdrop-filter 会把卡上的白按钮糊成一道光(Chrome) */
.xd__c { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; flex-direction: column; overflow: hidden; transform-origin: 50% 50%; transform: perspective(2200rpx) rotateY(90deg) translateX(80rpx); opacity: 0; pointer-events: none; transition: transform .52s cubic-bezier(.45,0,.2,1), opacity .4s ease; }
.xd__c.is-on { transform: perspective(2200rpx) rotateY(0deg); opacity: 1; pointer-events: auto; z-index: 2; }
/* 没在台上的卡整张不画(只靠 opacity:0 时,正好侧立 90° 的卡在 Chrome 里会糊成一道白光) */
.xd__c { visibility: hidden; }
.xd__c.is-on, .xd__c.is-in, .xd__c.is-out { visibility: visible; }
.xd__c.is-out { transform: perspective(2200rpx) rotateY(-90deg) translateX(-80rpx); opacity: 0; }
.xd__c.is-in { transform: perspective(2200rpx) rotateY(0deg); opacity: 1; z-index: 3; }
/* 翻页卡会转(transform),MOTION.md:动的元素上不放 backdrop-filter;外层弹窗已是玻璃,卡面用半透明实底 */
.look--stardust .xd__c { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(var(--lk-ink-rgb), .08); }
.play--reduced-motion .xd__c { transition: none; }
.xd__cov { flex: none; position: relative; width: 100%; height: 300rpx; background: var(--lk-ctl); display: flex; align-items: center; justify-content: center; }
.xd__img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.xd__no { font-size: 56rpx; font-weight: 800; font-family: var(--lk-fm); color: var(--lk-ink); } /* ds-ok: 上线波次原型逐值(装饰 / 品牌色块) */
.xd__b { flex: 1; min-height: 0; padding: 24rpx 28rpx 0; display: flex; flex-direction: column; gap: 8rpx; }
.xd__k { font-size: var(--cy-type-caption); letter-spacing: .22em; font-family: var(--lk-fm); color: var(--lk-mute); }
.xd__t { font-size: var(--cy-type-section-title); line-height: 1.3; font-weight: 600; font-family: var(--lk-fd); letter-spacing: var(--lk-ls); color: var(--lk-ink); }
.xd__p { font-size: 26rpx; line-height: 1.6; color: var(--lk-dim); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; } /* ds-ok: 上线波次原型逐值(装饰 / 品牌色块) */
.xd__i { display: flex; gap: 28rpx; margin-top: auto; font-size: var(--cy-type-label); font-family: var(--lk-fm); color: var(--lk-mute); }
.xd__i text { color: var(--lk-ink); font-weight: 700; margin-left: 6rpx; }
.xd__go { margin: 20rpx 28rpx 28rpx; min-height: 84rpx; font-size: var(--cy-type-body); }
.xd__ctl { display: flex; align-items: center; justify-content: space-between; margin: 24rpx 4rpx 0; }
.xd__dots { display: flex; gap: 12rpx; }
.xd__dot { width: 32rpx; height: 12rpx; border-radius: 6rpx; background: rgba(var(--lk-ink-rgb), .2); transform: scaleX(.375); transition: transform var(--cy-motion-standard) ease, background var(--cy-motion-standard) ease; } /* ds-ok 原型圆点;当前那颗拉长只动 transform,不动宽度 */
.xd__dot.is-on { transform: none; background: var(--lk-ink); }
.xd__arrow { width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--lk-ink); color: var(--lk-bg); display: flex; align-items: center; justify-content: center; clip-path: var(--lk-cut); }

/* ===== 本局完成(proto gp-run-end):整屏泛绿,勋章插图落下 + 光环外扩 + 闪光,「本局完成 · 获得勋章」,底部按钮 ===== */
.pv-ending--run { background: linear-gradient(180deg, rgba(var(--lk-ok-rgb, 34,197,94), .22), rgba(var(--lk-ok-rgb, 34,197,94), .22)), #000000; } /* ds-ok 原型 .runend:成功绿 22% 叠在玩家黑上 */
.pv-ending__hero { position: relative; width: 420rpx; height: 400rpx; margin: 0 auto 24rpx; display: flex; align-items: center; justify-content: center; }
.pv-ending__glow { position: absolute; left: 50%; top: 50%; width: 840rpx; height: 840rpx; margin: -420rpx 0 0 -420rpx; border-radius: 50%; pointer-events: none;
  background: radial-gradient(closest-side, rgba(var(--lk-ok-rgb, 34,197,94), .55), transparent 70%); opacity: 0; transform: scale(.3); transition: opacity 1.6s ease, transform 1.6s ease; } /* ds-ok 原型 .runend .glow */
.pv-ending--in .pv-ending__glow { opacity: 1; transform: none; }
.pv-ending__illus { position: relative; z-index: 1; }
.pv-ending__spk { position: absolute; }
.pv-ending__spk--a { right: -20rpx; top: 0; }
.pv-ending__spk--b { left: -12rpx; top: 180rpx; }
.pv-ending__ring { position: absolute; left: 50%; top: 50%; width: 280rpx; height: 280rpx; margin: -140rpx 0 0 -140rpx; border-radius: 50%; border: 4rpx solid var(--lk-ok, #22C55E); opacity: .9; transform: scale(.6); pointer-events: none; transition: transform 1.4s ease-out .9s, opacity 1.4s ease-out .9s; } /* ds-ok 回落成功绿 */
.pv-ending--in .pv-ending__ring { opacity: 0; transform: scale(2.2); }
.pv-ending--run .pv-ending__k, .pv-ending--run .pv-ending__title, .pv-ending--run .pv-ending__copy { opacity: 0; transform: translateY(36rpx); transition: opacity .6s ease, transform .6s cubic-bezier(.16,1,.3,1); }
.pv-ending--run .pv-ending__k { transition-delay: 1.1s; } .pv-ending--run .pv-ending__title { transition-delay: 1.3s; } .pv-ending--run .pv-ending__copy { transition-delay: 1.5s; }
.pv-ending--in .pv-ending__k, .pv-ending--in .pv-ending__title, .pv-ending--in .pv-ending__copy { opacity: 1; transform: none; }
.pv-ending__rpts { display: inline-flex; align-items: center; gap: 12rpx; margin-top: 28rpx; padding: 12rpx 28rpx; border-radius: var(--cy-radius-pill); background: var(--lk-ok, #22C55E); color: #FFFFFF; font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; opacity: 0; transform: scale(.8); transition: opacity .5s ease 1.9s, transform .5s cubic-bezier(.2,1.4,.5,1) 1.9s; } /* ds-ok 成功绿上的白字 */
.pv-ending--in .pv-ending__rpts { opacity: 1; transform: none; }
.pv-ending--run .pv-ending__go { background: var(--lk-ink, #FFFFFF); color: #072B15; } /* ds-ok 原型 .runend .gb--primary:白药丸上的字取泛绿底色 */
.pv-ending--run .pv-ending__secondary { margin: -16rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); min-height: 80rpx; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.6); font-size: 28rpx; } /* ds-ok 文字按钮 */
.pv-ending--reduced .pv-ending__glow, .pv-ending--reduced .pv-ending__k, .pv-ending--reduced .pv-ending__title, .pv-ending--reduced .pv-ending__copy, .pv-ending--reduced .pv-ending__rpts { transition: none; opacity: 1; transform: none; }
.pv-ending--reduced .pv-ending__ring { display: none; }

/* ===== 岔路弹窗(proto pop-branch):分支剧情在故事流里是一张入口卡(钥匙插图),点开是居中弹窗,玩法本身仍是 cy-playkit(分支) ===== */
.lk-popwrap--branch .lk-pop { max-height: 86vh; }
.bp__h { display: flex; align-items: center; justify-content: space-between; padding: 36rpx 36rpx 0; flex: none; }
.bp__b { flex: 1; min-height: 0; overflow-y: auto; padding: 8rpx 36rpx 28rpx; box-sizing: border-box; }
/* 岔路弹窗里的分支玩法读外观变量(.chfull__kit 在 index.wxss 里给的是章节配色,这里要压过它) */
.lk-popwrap--branch .bp__b.chfull__kit { --pk-embed-bg: var(--lk-pop); --pk-embed-ink: var(--lk-ink); --pk-embed-sub: var(--lk-mute); --pk-embed-soft: rgba(var(--lk-ink-rgb), .1); --pk-embed-accent: var(--lk-a); --pk-embed-ok: var(--lk-ok); }
.chfull__kitcard-illus { flex: none; width: 136rpx; height: 136rpx; display: flex; align-items: center; justify-content: center; }

/* ===== 顶栏进度药丸(proto hud .gpill):N/M 站,底边一条随进度长 ===== */
.theme-story-hud .theme-hp, .theme-story-hud .theme-bag-entry { white-space: nowrap; flex: none; }
.theme-gpill { position: relative; flex: none; height: 48rpx; padding: 0 18rpx; display: inline-flex; align-items: center; border-radius: var(--lk-rb, var(--cy-radius-pill)); clip-path: var(--lk-cut); overflow: hidden; background: var(--lk-ink, #FFFFFF); color: var(--lk-bg, #000000); font-size: 22rpx; font-weight: 700; font-family: var(--lk-fm); } /* ds-ok 回落玩家黑白 */
.theme-gpill__i { position: absolute; left: 0; right: 0; bottom: 0; height: 6rpx; background: var(--lk-bg, #000000); transform-origin: left; transition: transform .9s cubic-bezier(.16,1,.3,1); } /* ds-ok 回落黑 */
/* f-play V3-05:进度游标改用药丸自己的字色(--lk-bg,与「1/2」同一对比度)。原来用强调色 --lk-a:星尘默认 #E9E2D0 压在 #F2F2F0 的药丸上对比 1.15,
   25 套外观里 20 套低于 2:1,游标基本看不见;加粗到 6rpx(原型 2px)让走一站就能看出长了一截。 */
.play--reduced-motion .theme-gpill__i { transition: none; }

/* ===== 背包:没有配图的物品 / 线索 / 待领奖励用插图(原型「图标换成统一一套」) ===== */
.tb-item__illus { position: absolute; left: 0; right: 0; top: 14%; display: flex; justify-content: center; }
.tb-clue__illus { float: right; margin: 0 0 8rpx 16rpx; }
.tb-avatar--illus { background: transparent; box-shadow: none; display: flex; align-items: center; justify-content: center; }

/* ===== 细节打磨 2026-11-12 · S1 地点卡:顶边高光 + 外观色柔光 + 读数等宽(版式、文案、配色不动) ===== */
.sheet.sheet--game .sheet-body.lk-pop { isolation: isolate; }
.sheet.sheet--game .sheet-body.lk-pop::after { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 220rpx; z-index: -1; pointer-events: none; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.22), rgba(255,255,255,0)) top / 100% 2rpx no-repeat, radial-gradient(ellipse 70% 100% at 50% 0%, rgba(var(--lk-a-rgb, 255,255,255), .24), rgba(var(--lk-a-rgb, 255,255,255), 0)); } /* ds-ok G1 顶边 1px 内高光 + 外观强调色 24% 顶边柔光;::before 留给星尘玻璃的原有高光 */
.sheet-dist__n { font-variant-numeric: tabular-nums; }
.sheet-row .lk-btn { transition: var(--cy-tr-press); }
