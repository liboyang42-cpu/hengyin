<cy-sheet show="{{playerOperationsOpen}}" title="" closable="{{false}}" handle="{{true}}" footer="{{!!playerOperationForm || playerOperationUnknown}}" bind:close="closePlayerOperations" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop}}px);--cy-comp-sheet-blur:0px;--cy-comp-sheet-role-glass:var(--cy-comp-sheet-player-page);--cy-comp-sheet-role-text:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-text-secondary:var(--cy-comp-sheet-player-text-secondary);--cy-comp-sheet-role-muted:var(--cy-comp-sheet-player-muted);--cy-comp-sheet-role-surface:var(--cy-comp-sheet-player-surface);--cy-comp-sheet-role-divider:var(--cy-comp-sheet-player-divider);--cy-comp-sheet-role-btn-bg:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-btn-fg:var(--cy-comp-sheet-player-page)">
<view class="tb-sheet">
  <view class="tb-close" bindtap="closePlayerOperations" aria-role="button" aria-label="收起站点操作" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="32" /></view>
  <text class="tb-title">{{playerOperationForm ? playerOperationForm.title : '站点与本队'}}</text>
  <cy-inline-error class="tb-purpose tb-warning" wx:if="{{playerOperationError}}" aria-live="polite" kind="error" title="{{playerOperationError}}" />
  <text class="tb-purpose" wx:if="{{playerRunText}}" aria-live="polite">{{playerRunText}}</text>
  <text class="tb-purpose" wx:if="{{playerExitText}}">{{playerExitText}}</text>
  <block wx:if="{{!playerOperationForm}}">
    <view class="tb-group"><view class="tb-row" wx:for="{{playerOperationRows}}" wx:key="action" data-action="{{item.action}}" bindtap="openPlayerOperation" aria-role="button" aria-label="{{item.title}}" hover-class="cy-pressed" hover-stay-time="80"><view class="tb-avatar"><cy-icon name="{{item.icon}}" size="48" /></view><view class="tb-copy"><text class="tb-name">{{item.title}}</text><text class="tb-purpose">{{item.summary}}</text></view><cy-icon name="chevron-right" size="32" /></view></view>
    <text class="tb-purpose" wx:if="{{!playerOperationRows.length && !playerExitText && !playerRunText}}">暂无可用操作，请核对队长身份与本站状态</text>
    <view class="tb-group tb-details" wx:if="{{playerArrivalProof}}"><text class="tb-heading">{{playerArrivalProof.stationName}} · 到场凭证</text><text class="tb-purpose">交给本站工作人员核验，仅本次到场有效。</text><text class="po-proof" selectable="{{true}}">{{playerArrivalProof.nonce}}</text><view class="tb-detail-row"><text>有效至</text><text>{{playerArrivalProof.expiresText}}</text></view><view class="tb-button tb-button--muted" bindtap="copyPlayerArrivalProof" aria-role="button" aria-label="复制到场凭证" hover-class="cy-pressed" hover-stay-time="80">复制给本站工作人员</view></view>
    <text class="tb-section" wx:if="{{playerManualRows.length}}">本人现场记录</text><view class="tb-group"><view class="tb-row" wx:for="{{playerManualRows}}" wx:key="signatureId"><view class="tb-avatar"><cy-icon name="check" size="48" /></view><view class="tb-copy"><text class="tb-name">{{item.title}}</text><text class="tb-purpose" wx:if="{{item.reason}}">{{item.reason}}</text></view><text class="tb-value">{{item.statusText}}</text></view></view>
  </block>
  <block wx:else>
    <text class="tb-purpose">{{playerOperationForm.summary}}</text>
    <text class="tb-purpose tb-warning" wx:if="{{!playerOperationAvailable}}">状态已更新，当前操作不可用，请返回核对</text>
    <block wx:if="{{playerOperationForm.action !== 'TEAM_EXIT'}}"><text class="tb-section">{{playerOperationForm.action === 'MANUAL_SIGN' ? '实际发生的操作' : '本站任务'}}</text><cy-dropdown range="{{playerOperationForm.targets}}" range-key="label" value="{{playerOperationForm.index}}" bind:change="choosePlayerOperationTarget" disabled="{{themeBagBusy || playerOperationUnknown}}" aria-label="选择本站实际操作"><view class="tb-group tb-row"><text class="tb-copy tb-name">{{playerOperationForm.targets[playerOperationForm.index].label || '本站资料尚未加载'}}</text><cy-icon name="chevron-right" size="32" /></view></cy-dropdown></block>
    <view class="tb-group tb-details" wx:if="{{playerOperationForm.action === 'MANUAL_SIGN'}}"><text class="tb-name">实际发生时间</text><input class="po-input" value="{{playerOperationForm.occurredAt}}" placeholder="2026-10-09 14:00:00" bindinput="inputPlayerOperationTime" disabled="{{themeBagBusy || playerOperationUnknown}}" aria-label="实际发生时间，年-月-日 时:分:秒" /><text class="tb-purpose">请按现场记录填写；提交签署后需由工作人员核验，核验前不会改变任务与物品。</text></view>
    <view class="tb-group tb-details" wx:if="{{playerOperationForm.action === 'TEAM_EXIT'}}"><text class="tb-heading">退出后会怎样</text><text class="tb-purpose">退出后不能撤销，已持有的物品会保留。</text><text class="tb-section">退出原因</text><textarea class="po-reason" value="{{playerOperationForm.reason}}" maxlength="200" bindinput="inputPlayerOperationReason" disabled="{{themeBagBusy || playerOperationUnknown || playerExitConfirm}}" aria-label="本队退出原因" placeholder="请填写本队退出原因" /><text class="tb-purpose tb-warning" wx:if="{{playerExitConfirm}}">请与队友确认已了解上述后果，再确认退出。</text></view>
    <view class="tb-button tb-button--muted" wx:if="{{!playerExitConfirm && !playerOperationUnknown}}" bindtap="closePlayerOperation" aria-role="button" aria-label="返回站点操作" hover-class="cy-pressed" hover-stay-time="80">返回</view>
  </block>
</view>
<view slot="footer" class="tb-footer"><view class="tb-button tb-button--primary {{themeBagBusy ? 'is-busy' : ''}}" wx:if="{{playerOperationUnknown}}" bindtap="checkPlayerOperationReceipt" aria-role="button" aria-label="核对原操作结果" hover-class="cy-pressed" hover-stay-time="80">核对原操作结果</view><block wx:elif="{{playerExitConfirm}}"><view class="tb-actions"><view class="tb-button tb-button--flex tb-button--muted" bindtap="cancelPlayerExit" aria-role="button" aria-label="取消退出本局" hover-class="cy-pressed" hover-stay-time="80">继续本局</view><view class="tb-button tb-button--flex {{themeBagBusy || !playerOperationAvailable ? 'is-busy' : ''}}" bindtap="confirmPlayerExit" aria-role="button" aria-label="确认本队退出本局" hover-class="cy-pressed" hover-stay-time="80">确认退出本局</view></view></block><view wx:elif="{{playerOperationForm && playerOperationAvailable}}" class="tb-button tb-button--primary {{themeBagBusy ? 'is-busy' : ''}}" bindtap="submitPlayerOperation" aria-role="button" aria-label="{{playerOperationForm.action === 'TEAM_EXIT' ? '核对退出后果' : playerOperationForm.action === 'MANUAL_SIGN' ? '签署实际现场记录' : '领取到场凭证'}}" hover-class="cy-pressed" hover-stay-time="80">{{playerOperationForm.action === 'TEAM_EXIT' ? '核对退出后果' : playerOperationForm.action === 'MANUAL_SIGN' ? '签署现场记录' : '领取到场凭证'}}</view></view>
</cy-sheet>
