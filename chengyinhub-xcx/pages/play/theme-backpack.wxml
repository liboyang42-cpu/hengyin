<cy-sheet show="{{themeBackpackOpen && !themePlanKey && !themeItemDetail && !themeCostChoice && !themeQuestChoice && !themeRewardPreview && !themePendingClaim && !themeTradeForm}}" title="" closable="{{false}}" handle="{{true}}" footer="{{false}}" fixed="full" bind:close="closeThemeBackpack" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop}}px);--cy-comp-sheet-blur:0px;--cy-comp-sheet-role-glass:var(--cy-comp-sheet-player-page);--cy-comp-sheet-role-text:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-text-secondary:var(--cy-comp-sheet-player-text-secondary);--cy-comp-sheet-role-muted:var(--cy-comp-sheet-player-muted);--cy-comp-sheet-role-surface:var(--cy-comp-sheet-player-surface);--cy-comp-sheet-role-divider:var(--cy-comp-sheet-player-divider);--cy-comp-sheet-role-btn-bg:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-btn-fg:var(--cy-comp-sheet-player-page)">
<view class="tb-sheet"><view class="tb-close" bindtap="closeThemeBackpack" aria-label="关闭面板" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><cy-icon name="close-sm" size="32" /></view>
<text class="tb-title">背包</text>
<view class="tb-summary tb-group">
 <text class="tb-purpose">背包装载</text><text class="tb-total {{themeBag.used >= themeBag.capacity ? 'tb-warning' : ''}}">{{themeBag.used}} <text class="tb-total-unit">/ {{themeBag.capacity}} 格</text></text>
 <view class="tb-meter" wx:if="{{themeBag.capacity > 0}}"><view class="tb-meter-fill {{themeBag.used >= themeBag.capacity ? 'tb-meter-fill--warning' : ''}}" style="width:calc(100% * {{themeBag.used}} / {{themeBag.capacity}})"></view></view>
 <block wx:for="{{themeBag.valueRows}}" wx:key="key"><view class="tb-row" wx:if="{{hudTypes[item.key] === 'stars' && item.max > 0 && item.max <= 10}}"><view class="tb-avatar tb-avatar--stat">{{item.name[0]}}</view><view class="tb-copy"><text class="tb-name">{{item.name}}</text></view><view class="tb-value hud2-stars" aria-label="{{item.name}} {{item.value}} / {{item.max}}"><cy-icon wx:for="{{tbAttr.stars(item.value, item.max)}}" wx:for-item="on" wx:for-index="si" wx:key="si" class="{{on ? '' : 'off'}}" name="star-filled" size="26" /></view></view><view class="tb-row" wx:elif="{{hudTypes[item.key] === 'bar'}}"><view class="tb-avatar tb-avatar--stat">{{item.name[0]}}</view><view class="tb-copy"><text class="tb-name">{{item.name}}</text><view class="tb-meter"><view class="tb-meter-fill" style="width:{{tbAttr.pct(item.value, item.max)}}%"></view></view></view><text class="tb-value">{{item.value}}<text wx:if="{{item.max !== undefined}}" class="tb-purpose tb-value-max"> / {{item.max}}</text></text></view><view class="tb-row" wx:else><view class="tb-avatar tb-avatar--stat">{{item.name[0]}}</view><view class="tb-copy"><text class="tb-name">{{item.name}}</text><text wx:if="{{item.zero}}" class="tb-purpose tb-warning">已归零</text></view><text class="tb-value">{{item.value}}<text wx:if="{{item.max !== undefined}}" class="tb-purpose tb-value-max"> / {{item.max}}</text></text></view></block>
</view>
<view class="tb-pills"><view wx:for="{{themeBagTabs}}" wx:key="key" class="tb-pill {{themeBackpackTab === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="changeThemeBackpackTab" aria-label="{{item.label}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">{{item.label}}</view></view>
<text class="tb-purpose" wx:if="{{themeBag.claimOnly}}">本局已结束，仅可领取待领奖励</text>
<view class="tb-group" wx:if="{{r5OutcomeReply}}" aria-live="polite"><text class="tb-heading">{{r5OutcomeReply.statusText}}</text></view>
<cy-inline-error wx:if="{{themeBagError}}" title="{{themeBagError}}" action="确认重试" bind:action="retryThemeBagAction" />
<view class="tb-group tb-challenge" wx:if="{{zeroHpView}}">
 <text class="tb-section">{{zeroHpView.title}}</text><text class="tb-heading">{{themeBag.names.hp}}已归零</text>
 <text class="tb-clue-copy" wx:if="{{zeroHpView.message}}">{{zeroHpView.message}}</text>
 <block wx:if="{{zeroHpView.progressText}}"><view class="tb-detail-row"><text>{{zeroHpView.policy === 'CHALLENGE' ? '完整挑战次数' : '恢复步数'}}</text><text>{{zeroHpView.progressText}}</text></view><view class="tb-meter"><view class="tb-meter-fill" style="width:calc(100% * {{zeroHpView.progress}} / {{zeroHpView.required}})"></view></view></block>
 <text class="tb-name" wx:if="{{zeroHpCountdown}}" aria-live="polite">{{zeroHpCountdown}}</text>
 <text class="tb-purpose" wx:if="{{zeroHpView.phase === 'AWAITING_BASELINE'}}">先同步微信运动，再开始走</text><text class="tb-purpose" wx:elif="{{zeroHpView.policy === 'STEPS' && zeroHpView.memberText}}">由{{zeroHpView.memberText}}同步微信运动{{zeroHpView.canSteps ? '' : '，等待同步'}}</text><text class="tb-purpose" wx:elif="{{zeroHpView.effectivePolicy === 'BLOCK_HP_COST' || zeroHpView.phase === 'RECOVERING'}}">需要消耗{{themeBag.names.hp}}的任务暂停，其余任务照常参与</text>
 <text class="tb-purpose" wx:if="{{zeroHpView.metaText}}">{{zeroHpView.metaText}}</text>
 <text class="tb-purpose tb-warning" wx:if="{{zeroHpView.disabledReason}}">{{zeroHpView.disabledReason}}</text>
 <cy-inline-error class="tb-purpose tb-warning" wx:if="{{zeroHpError}}" aria-live="polite" kind="error" title="{{zeroHpError}}" />
 <view class="tb-actions">
  <block wx:if="{{zeroHpView.policy === 'CHALLENGE' && zeroHpView.required > 0 && zeroHpView.phase === 'RECOVERING' && !themeBag.challenge.disabledReason}}"><view class="tb-button tb-button--flex" wx:for="{{themeBag.challengeNodes}}" wx:key="id" data-id="{{item.id}}" bindtap="openThemeChallenge" aria-label="打开{{item.name}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">{{item.name}}</view></block>
  <view wx:if="{{zeroHpView.canSteps}}" class="tb-button tb-button--flex {{zeroHpBusy || themeBagBusy ? 'is-busy' : ''}}" bindtap="syncZeroHpSteps" aria-role="button" aria-disabled="{{zeroHpBusy || themeBagBusy}}" aria-label="同步微信运动恢复进度" hover-class="cy-pressed" hover-stay-time="80">{{zeroHpBusy ? '正在同步' : themeBagUnknown ? '确认原同步' : '同步微信运动'}}</view>
  <view wx:if="{{zeroHpPermissionDenied && zeroHpView.canSteps}}" class="tb-button tb-button--muted tb-button--flex" bindtap="openZeroHpWeRunSettings" aria-role="button" aria-label="开启微信运动权限" hover-class="cy-pressed" hover-stay-time="80">开启微信运动权限</view>
  <view wx:if="{{zeroHpView.canSync}}" class="tb-button tb-button--muted tb-button--flex {{themeBagBusy ? 'is-busy' : ''}}" bindtap="syncZeroHpState" aria-role="button" aria-disabled="{{themeBagBusy}}" aria-label="同步恢复状态" hover-class="cy-pressed" hover-stay-time="80">同步恢复状态</view>
  <view wx:elif="{{!zeroHpView.canSteps && !themeBag.result}}" class="tb-button tb-button--muted tb-button--flex" bindtap="refreshThemeBackpack" aria-role="button" aria-label="刷新恢复状态" hover-class="cy-pressed" hover-stay-time="80">刷新 / 等待同步</view>
  <view wx:if="{{themeBag.result}}" class="tb-button tb-button--flex" bindtap="openThemeResultCard" aria-role="button" aria-label="查看本局结果" hover-class="cy-pressed" hover-stay-time="80">查看本局结果</view>
 </view>
</view>
<block wx:if="{{themeBackpackTab === 'items'}}">
 <text class="tb-section" wx:if="{{themeBag.pendingRows.length}}">待领取</text>
 <view class="tb-group" wx:if="{{themeBag.pendingRows.length}}"><view class="tb-row" wx:for="{{themeBag.pendingRows}}" wx:key="id"><view class="tb-avatar">礼</view><view class="tb-copy"><text class="tb-name">{{item.name || '待领奖励'}}</text><text class="tb-purpose">×{{item.quantity}}<text wx:if="{{item.slots !== undefined}}"> · 占 {{item.slots}} 格</text></text></view><view class="tb-button tb-button--small {{!item.canClaim || themeBagBusy ? 'is-busy' : ''}}" data-operation="RECEIVE" data-id="{{item.id}}" bindtap="onThemeBagAction" aria-label="领取{{item.name || '待领奖励'}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">领取</view></view></view>
 <text class="tb-section" wx:if="{{themeBag.items.length}}">随身物品</text>
 <view class="tb-group"><view class="tb-row" wx:for="{{themeBag.items}}" wx:key="id" data-id="{{item.id}}" bindtap="openThemeItem" aria-label="查看{{item.name}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><image wx:if="{{item.image}}" class="tb-avatar" src="{{item.image}}" mode="aspectFill" /><view wx:else class="tb-avatar">{{item.initial}}</view><view class="tb-copy"><text class="tb-name">{{item.name}}</text><text class="tb-purpose">{{item.effectText}}</text></view><view class="tb-value"><text>×{{item.quantity}}</text><text class="tb-purpose" wx:if="{{item.slotCost !== undefined}}">每件 {{item.slotCost}} 格</text></view><cy-icon class="tb-chevron" name="chevron-right" size="32" /></view></view>
 <view class="tb-empty" wx:if="{{!themeBag.items.length && !themeBag.pendingRows.length}}">还没有物品</view>
</block>
<block wx:elif="{{themeBackpackTab === 'clues'}}"><view class="tb-empty" wx:if="{{!themeBag.clues.length}}">还没有线索</view><view class="tb-group tb-clue" wx:for="{{themeBag.clues}}" wx:key="id"><text class="tb-name">{{item.name}}</text><text wx:if="{{item.scopeText}}" class="tb-purpose">{{item.scopeText}}</text><image wx:if="{{item.image}}" src="{{item.image}}" mode="widthFix" /><text wx:if="{{item.content}}" class="tb-clue-copy">{{item.content}}</text><text wx:if="{{item.emptyText}}" class="tb-purpose">{{item.emptyText}}</text><block wx:for="{{item.blocks}}" wx:key="index" wx:for-item="block"><text wx:if="{{block.source}}" class="tb-purpose">{{block.source}}</text><text wx:if="{{block.text}}" class="tb-clue-copy" user-select>{{block.text}}</text><image wx:for="{{block.images}}" wx:key="*this" wx:for-item="url" src="{{url}}" mode="widthFix" data-url="{{url}}" data-urls="{{block.images}}" bindtap="previewThemeClueImage" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="查看{{item.name}}图片" /></block></view></block>
<block wx:else>
 <include src="theme-plan-list.wxml" />
 <text class="tb-purpose" wx:if="{{themeRecoveryText}}" aria-live="polite">{{themeRecoveryText}}</text>
 <text class="tb-purpose" wx:if="{{themeQuestReceiptText}}" aria-live="polite">{{themeQuestReceiptText}}</text>
 <view class="tb-group tb-challenge" wx:if="{{themeBag.awaitingChallenge && !themeBag.claimOnly && (!zeroHpView || zeroHpView.policy === 'CHALLENGE' && !zeroHpView.required)}}"><text class="tb-section">归零挑战</text><text class="tb-heading">{{themeBag.names.hp}}已归零</text><text class="tb-purpose">完成挑战可{{themeBag.challengeRestoreText}}</text><text class="tb-name" wx:if="{{themeBag.challengeProgressText}}">{{themeBag.challengeProgressLabel}} {{themeBag.challengeProgressText}}</text><view class="tb-meter" wx:if="{{themeBag.challenge.goal > 0}}"><view class="tb-meter-fill" style="width:calc(100% * {{themeBag.challenge.progress}} / {{themeBag.challenge.goal}})"></view></view><view class="tb-actions" wx:if="{{!themeBag.challenge.disabledReason}}"><view class="tb-button tb-button--flex" wx:for="{{themeBag.challengeNodes}}" wx:key="id" data-id="{{item.id}}" bindtap="openThemeChallenge" aria-label="打开{{item.name}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">{{item.name}}</view></view><text class="tb-purpose">{{themeBag.challengeRetryText}}</text></view>
 <view class="tb-group"><view class="tb-row {{item.enabled || item.openable ? '' : 'is-disabled'}}" wx:for="{{themeBag.actionRows}}" wx:key="rowKey"><view class="tb-avatar"><cy-icon name="list" size="48" /></view><view class="tb-copy"><text class="tb-name">{{item.title}}</text><text class="tb-purpose" wx:if="{{item.kind === 'RECOVERY' && item.costText}}">{{item.costText}}</text><text class="tb-purpose" wx:if="{{item.proofText}}">{{item.proofText}}</text><text class="tb-purpose" wx:if="{{item.frozenText}}">已选费用：{{item.frozenText}}</text><text class="tb-purpose" wx:if="{{item.chargeNote}}">{{item.chargeNote}}</text><text class="tb-purpose" wx:if="{{item.blocked}}">{{themeBag.names.hp}}归零期间不能支付任务费用</text><text class="tb-purpose" wx:elif="{{!item.enabled && item.disabledText}}">{{item.disabledText}}</text><view class="tb-status"><text wx:if="{{item.enabled}}">可用</text><text wx:if="{{item.remainingText}}">{{item.remainingText}}</text><view class="tb-pass" wx:if="{{item.trustedPass}}"><cy-icon name="check" size="24" /><text>已核验</text></view></view><view class="tb-actions"><view class="tb-button tb-button--small {{!item.enabled || themeBagBusy ? 'is-busy' : ''}}" data-index="{{index}}" bindtap="onThemeGameplayAction" aria-disabled="{{!item.enabled || themeBagBusy}}" aria-label="{{item.actionText}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">{{item.actionText}}</view><view class="tb-button tb-button--small tb-button--muted" wx:if="{{item.openable}}" data-index="{{index}}" data-open="true" bindtap="onThemeGameplayAction" aria-label="打开原验证任务" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">打开原任务</view><view class="tb-button tb-button--small tb-button--muted" wx:if="{{item.cancelable}}" data-index="{{index}}" bindtap="onThemeCancelGameplayAction" aria-label="取消{{item.title}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">取消</view></view></view></view></view>
 <view class="tb-empty" wx:if="{{!themeBag.planRows.length && !themePlanUnknown && !themePlanResult && !themeBag.actionRows.length && !themeBag.awaitingChallenge && !themeBag.tradeTargets.length && !themeBag.tradeRows.length && !themeTradeForm && !themeTradeUnknown}}">当前没有可用任务</view>
 <block wx:if="{{themeBag.tradeTargets.length || themeBag.tradeRows.length || themeTradeUnknown}}">
  <text class="tb-section">队间物资交换</text>
  <view class="tb-group tb-details"><view class="tb-detail-row"><text>本队已锁定</text><text>{{themeBag.tradeLockedText}}</text></view><cy-inline-error class="tb-purpose tb-warning" wx:if="{{themeTradeError}}" aria-live="polite" kind="error" title="{{themeTradeError}}" /><view wx:if="{{themeTradeUnknown}}" class="tb-button {{themeBagBusy ? 'is-busy' : ''}}" bindtap="checkThemeTradeReceipt" aria-role="button" aria-label="确认交易结果" hover-class="cy-pressed" hover-stay-time="80">确认交易结果</view></view>
  <view class="tb-group" wx:if="{{themeBag.tradeTargets.length}}"><view class="tb-row {{item.enabled ? '' : 'is-disabled'}}" wx:for="{{themeBag.tradeTargets}}" wx:key="teamId"><view class="tb-avatar">队</view><view class="tb-copy"><text class="tb-name">队伍 {{item.teamId}}{{item.completed ? ' · 已完成' : ''}}</text><text class="tb-purpose" wx:if="{{item.stationName}}">可交易节点：{{item.stationName}}</text><text class="tb-purpose" wx:if="{{item.reason}}">{{item.reason}}</text></view><view class="tb-button tb-button--small {{!item.enabled || themeBagBusy || themeTradeUnknown ? 'is-busy' : ''}}" data-id="{{item.teamId}}" bindtap="selectThemeTradeTarget" aria-role="button" aria-label="选择与队伍{{item.teamId}}交换" aria-disabled="{{!item.enabled || themeBagBusy || themeTradeUnknown}}" hover-class="cy-pressed" hover-stay-time="80">选择交换</view></view></view>
  <view class="tb-group tb-details" wx:for="{{themeBag.tradeRows}}" wx:key="tradeKey"><text class="tb-heading">队伍 {{item.fromTeamId}} 与队伍 {{item.toTeamId}}</text><text class="tb-purpose">{{item.statusText}} · 第 {{item.version}} 版交换清单</text><view class="tb-detail-row" wx:if="{{item.stationName}}"><text>可交易节点</text><text>{{item.stationName}}</text></view><view class="tb-detail-row"><text>发起方给出</text><text>{{item.giveText}}</text></view><view class="tb-detail-row"><text>接收方给出</text><text>{{item.takeText}}</text></view><text class="tb-purpose tb-warning" wx:if="{{item.disabledReason && item.status === 'OPEN'}}">{{item.disabledReason}}</text><text class="tb-purpose" wx:if="{{item.confirmed && item.status === 'OPEN'}}">本队队长已确认，等待对方</text><view class="tb-actions"><view wx:if="{{item.status === 'OPEN' && !item.confirmed}}" class="tb-button tb-button--flex {{!item.canConfirm || themeBagBusy || themeTradeUnknown ? 'is-busy' : ''}}" data-key="{{item.tradeKey}}" data-version="{{item.version}}" data-action="TRADE_CONFIRM" bindtap="onThemeTradeAction" aria-role="button" aria-label="确认第{{item.version}}版交换清单" aria-disabled="{{!item.canConfirm || themeBagBusy || themeTradeUnknown}}" hover-class="cy-pressed" hover-stay-time="80">确认本版本交换</view><view wx:if="{{item.canCancel}}" class="tb-button tb-button--flex tb-button--muted {{themeBagBusy || themeTradeUnknown ? 'is-busy' : ''}}" data-key="{{item.tradeKey}}" data-version="{{item.version}}" data-action="TRADE_CANCEL" bindtap="onThemeTradeAction" aria-role="button" aria-label="取消交换" hover-class="cy-pressed" hover-stay-time="80">取消交换</view></view></view>
 </block>

</block>
</view>
</cy-sheet>
<cy-sheet show="{{!!themeItemDetail}}" title="" closable="{{false}}" handle="{{true}}" footer="{{false}}" bind:close="closeThemeItem" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop}}px);--cy-comp-sheet-blur:0px;--cy-comp-sheet-role-glass:var(--cy-comp-sheet-player-page);--cy-comp-sheet-role-text:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-text-secondary:var(--cy-comp-sheet-player-text-secondary);--cy-comp-sheet-role-muted:var(--cy-comp-sheet-player-muted);--cy-comp-sheet-role-surface:var(--cy-comp-sheet-player-surface);--cy-comp-sheet-role-divider:var(--cy-comp-sheet-player-divider);--cy-comp-sheet-role-btn-bg:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-btn-fg:var(--cy-comp-sheet-player-page)">
<view class="tb-sheet"><view class="tb-close" bindtap="closeThemeItem" aria-label="关闭面板" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><cy-icon name="close-sm" size="32" /></view>
<block wx:if="{{themeItemDetail}}"><view class="tb-item-hero"><image wx:if="{{themeItemDetail.image}}" class="tb-avatar tb-avatar--hero" src="{{themeItemDetail.image}}" mode="aspectFill" /><view wx:else class="tb-avatar tb-avatar--hero">{{themeItemDetail.initial}}</view><text class="tb-title">{{themeItemDetail.name}}</text></view>
<view class="tb-actions tb-round-actions"><view class="tb-round-action {{themeItemDetail.canUse ? '' : 'is-disabled'}}" data-operation="USE" data-id="{{themeItemDetail.id}}" bindtap="onThemeBagAction" aria-label="使用{{themeItemDetail.name}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><view class="tb-avatar"><cy-icon name="play" size="32" /></view><text>使用</text></view><view class="tb-round-action {{themeItemDetail.canDiscard ? '' : 'is-disabled'}}" data-operation="DISCARD" data-id="{{themeItemDetail.id}}" bindtap="onThemeBagAction" aria-label="丢弃{{themeItemDetail.name}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><view class="tb-avatar"><cy-icon name="trash" size="32" /></view><text>丢弃</text></view><view class="tb-round-action" bindtap="showThemeItemInfo" aria-label="物品详情" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><view class="tb-avatar"><cy-icon name="info" size="32" /></view><text>详情</text></view></view>
<text class="tb-purpose" wx:if="{{themeBag.claimOnly}}">本局已结束，物品不能再使用或单独丢弃；补领时可选择丢弃持有物品</text><text class="tb-purpose" wx:elif="{{themeItemDetail.disabledReason}}">{{themeItemDetail.disabledReason}}</text>
<view class="tb-group tb-details"><view class="tb-detail-row"><text>占格</text><text>{{themeItemDetail.slotCost !== undefined ? themeItemDetail.slotCost + ' 格 / 件' : '—'}}</text></view><view class="tb-detail-row"><text>效果</text><text>{{themeItemDetail.effectText}}</text></view><view class="tb-detail-row"><text>持有数量</text><text>×{{themeItemDetail.quantity}}</text></view><view class="tb-detail-row"><text>消耗方式</text><text>{{themeItemDetail.mode === 'USE' ? '使用时消耗' : themeItemDetail.mode === 'REDUCE' ? '持有减耗' : themeItemDetail.mode === 'HELD' ? '持有期间生效' : themeItemDetail.mode === 'WEAR' ? '装备生效' : '见物品说明'}}</text></view></view><text wx:if="{{themeItemDetail.showInfo}}" class="tb-clue-copy">{{themeItemDetail.content || themeItemDetail.effectText}}</text></block>
</view>
</cy-sheet>
<cy-sheet show="{{!!themeCostChoice}}" title="" closable="{{false}}" handle="{{true}}" footer="{{true}}" bind:close="closeThemeCostChoice" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop}}px);--cy-comp-sheet-blur:0px;--cy-comp-sheet-role-glass:var(--cy-comp-sheet-player-page);--cy-comp-sheet-role-text:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-text-secondary:var(--cy-comp-sheet-player-text-secondary);--cy-comp-sheet-role-muted:var(--cy-comp-sheet-player-muted);--cy-comp-sheet-role-surface:var(--cy-comp-sheet-player-surface);--cy-comp-sheet-role-divider:var(--cy-comp-sheet-player-divider);--cy-comp-sheet-role-btn-bg:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-btn-fg:var(--cy-comp-sheet-player-page)">
<view class="tb-sheet"><view class="tb-close" bindtap="closeThemeCostChoice" aria-label="关闭面板" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><cy-icon name="close-sm" size="32" /></view>
<text class="tb-title">选择费用</text><text class="tb-purpose">{{themeCostChoice.row.title}}</text><view class="tb-group" wx:if="{{themeCostChoice}}"><view class="tb-row {{item.affordable ? '' : 'is-disabled'}}" wx:for="{{themeCostChoice.row.costOptions}}" wx:key="index" data-index="{{index}}" bindtap="selectThemeCostOption" aria-label="{{item.label}} {{item.amountText}} {{item.affordable ? '' : item.shortfallText}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><view class="tb-avatar tb-select-icon">费<view class="tb-check" wx:if="{{themeCostChoice.selected === index}}"><cy-icon name="check" size="24" /></view></view><view class="tb-copy"><text class="tb-name">{{item.label}}</text><text class="tb-purpose">{{item.amountText}}</text><text class="tb-purpose tb-warning" wx:if="{{!item.affordable}}">{{item.shortfallText}}</text></view></view></view>
</view>
<view slot="footer" class="tb-footer"><view class="tb-button tb-button--primary {{themeCostChoice.selected < 0 || themeBagBusy ? 'is-busy' : ''}}" bindtap="confirmThemeCostChoice" aria-label="确认选择费用" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">确认</view></view>
</cy-sheet>
<cy-sheet show="{{!!themeQuestChoice}}" title="" closable="{{false}}" handle="{{true}}" footer="{{false}}" bind:close="closeThemeQuestChoice" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop}}px);--cy-comp-sheet-blur:0px;--cy-comp-sheet-role-glass:var(--cy-comp-sheet-player-page);--cy-comp-sheet-role-text:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-text-secondary:var(--cy-comp-sheet-player-text-secondary);--cy-comp-sheet-role-muted:var(--cy-comp-sheet-player-muted);--cy-comp-sheet-role-surface:var(--cy-comp-sheet-player-surface);--cy-comp-sheet-role-divider:var(--cy-comp-sheet-player-divider);--cy-comp-sheet-role-btn-bg:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-btn-fg:var(--cy-comp-sheet-player-page)">
<view class="tb-sheet"><view class="tb-close" bindtap="closeThemeQuestChoice" aria-label="关闭面板" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><cy-icon name="close-sm" size="32" /></view>
<text class="tb-title">选择奖励方案</text><view class="tb-group"><view class="tb-row" wx:for="{{themeQuestChoice.choices}}" wx:key="choiceKey" data-index="{{index}}" bindtap="selectThemeQuestChoice" aria-label="预览{{item.label}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><view class="tb-avatar">礼</view><text class="tb-name tb-copy">{{item.label}}</text><cy-icon class="tb-chevron" name="chevron-right" size="32" /></view></view>
</view>
</cy-sheet>
<cy-sheet show="{{!!themeRewardPreview}}" title="" closable="{{false}}" handle="{{true}}" footer="{{true}}" bind:close="closeThemeRewardPreview" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop}}px);--cy-comp-sheet-blur:0px;--cy-comp-sheet-role-glass:var(--cy-comp-sheet-player-page);--cy-comp-sheet-role-text:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-text-secondary:var(--cy-comp-sheet-player-text-secondary);--cy-comp-sheet-role-muted:var(--cy-comp-sheet-player-muted);--cy-comp-sheet-role-surface:var(--cy-comp-sheet-player-surface);--cy-comp-sheet-role-divider:var(--cy-comp-sheet-player-divider);--cy-comp-sheet-role-btn-bg:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-btn-fg:var(--cy-comp-sheet-player-page)">
<view class="tb-sheet"><view class="tb-close" bindtap="closeThemeRewardPreview" aria-label="关闭面板" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><cy-icon name="close-sm" size="32" /></view>
<text class="tb-title">奖励预览</text><text class="tb-purpose">本次动作的全部奖励；可明确放弃本人或本队的部分新奖励。</text><text class="tb-purpose" wx:if="{{themeRewardPreview.loading}}">正在读取最新装载预览…</text><text class="tb-purpose" wx:if="{{themeRewardPreview.notice}}">{{themeRewardPreview.notice}}</text><cy-inline-error wx:if="{{themeRewardPreview.error}}" title="{{themeRewardPreview.error}}" action="重新读取" bind:action="rereadThemeRewardPreview" />
<block wx:if="{{themeRewardPreview.participantRows}}"><text class="tb-section">参与队伍</text><text class="tb-purpose">本队必须参与，其他队伍请逐项选择。选择改变后会更新预览。</text><view class="tb-group"><view class="tb-row {{item.eligible ? '' : 'is-disabled'}}" wx:for="{{themeRewardPreview.participantRows}}" wx:key="teamId" data-id="{{item.teamId}}" bindtap="selectThemeParticipant" aria-role="button" aria-label="{{item.label}} {{item.selected ? '已选择' : '未选择'}} {{item.reason}}" aria-disabled="{{!item.eligible || item.required || themeBagBusy}}" hover-class="cy-pressed" hover-stay-time="80"><view class="tb-avatar tb-select-icon"><cy-icon name="tab-club" size="32" /><view class="tb-check" wx:if="{{item.selected}}"><cy-icon name="check" size="24" /></view></view><view class="tb-copy"><text class="tb-name">{{item.label}}</text><text class="tb-purpose" wx:if="{{!item.eligible}}">{{item.reason || '当前不可参与'}}</text></view><text class="tb-purpose">{{item.required ? '本队必须参与' : item.selected ? '已选择' : '选择'}}</text></view></view></block>
<view class="tb-group tb-owner" wx:for="{{themeRewardPreview.pack.owners}}" wx:for-item="owner" wx:key="ownerId"><text class="tb-heading">{{owner.label}}</text><view class="tb-detail-row"><text>领取后的装载</text><text class="{{owner.overflow ? 'tb-warning' : ''}}">{{owner.finalUsed !== undefined ? owner.finalUsed : '—'}} / {{owner.capacity !== undefined ? owner.capacity : '—'}} 格</text></view><text class="tb-purpose tb-warning" wx:if="{{owner.overflow}}">容量不足，需调整本次奖励；其他队伍的奖励由其归属处理</text><view class="tb-detail-row" wx:for="{{owner.sources}}" wx:key="index"><view class="tb-copy"><text class="tb-name">{{item.name}}</text><text class="tb-purpose">{{item.sourceLabel}}</text></view><view class="tb-value"><text>×{{item.quantity}}</text><text class="tb-purpose" wx:if="{{item.discarded}}">已放弃 {{item.discarded}}</text></view></view><text class="tb-purpose" wx:if="{{!owner.sources.length && !owner.rewards.length}}">本次没有物品奖励</text><block wx:if="{{owner.own}}"><view class="tb-detail-row" wx:for="{{owner.rewards}}" wx:key="itemId"><text class="tb-copy">放弃 {{item.name}}<text class="tb-purpose">本次共 {{item.quantity}} 件</text></text><input class="tb-number" type="number" value="{{item.discard}}" disabled="{{themeRewardPreview.loading || themeBagBusy}}" data-id="{{item.itemId}}" bindblur="changeThemeRewardDiscard" aria-label="放弃{{item.name}}的数量" /></view></block></view>
</view>
<view slot="footer" class="tb-footer"><view class="tb-button tb-button--primary {{!themeRewardPreview.pack || themeRewardPreview.pack.overflow || themeRewardPreview.loading || themeRewardPreview.error || themeBagBusy ? 'is-busy' : ''}}" bindtap="confirmThemeRewardPreview" aria-label="确认奖励装载并完成动作" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">确认装载</view></view>
</cy-sheet>
<cy-sheet show="{{!!themePendingClaim}}" title="" closable="{{false}}" handle="{{true}}" footer="{{true}}" bind:close="closeThemePendingClaim" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop}}px);--cy-comp-sheet-blur:0px;--cy-comp-sheet-role-glass:var(--cy-comp-sheet-player-page);--cy-comp-sheet-role-text:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-text-secondary:var(--cy-comp-sheet-player-text-secondary);--cy-comp-sheet-role-muted:var(--cy-comp-sheet-player-muted);--cy-comp-sheet-role-surface:var(--cy-comp-sheet-player-surface);--cy-comp-sheet-role-divider:var(--cy-comp-sheet-player-divider);--cy-comp-sheet-role-btn-bg:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-btn-fg:var(--cy-comp-sheet-player-page)">
<view class="tb-sheet"><view class="tb-close" bindtap="closeThemePendingClaim" aria-label="关闭面板" hover-class="cy-pressed" hover-stay-time="80" aria-role="button"><cy-icon name="close-sm" size="32" /></view>
<text class="tb-title">领取待领奖励</text><text class="tb-purpose">本局已结束，只能补领待领奖励或丢弃物品。</text><view class="tb-group tb-details"><view class="tb-detail-row"><text>待领奖励</text><text>{{themePendingClaim.reward.name || '物资'}} ×{{themePendingClaim.reward.quantity}}</text></view><view class="tb-detail-row"><text>当前装载</text><text>{{themeBag.used}} / {{themeBag.capacity}} 格</text></view><view class="tb-detail-row" wx:if="{{themePendingClaim.reward.slots !== undefined}}"><text>奖励占格</text><text>{{themePendingClaim.reward.slots}} 格</text></view></view><text class="tb-section">选择丢弃持有物品</text><text class="tb-purpose" wx:if="{{!themeBag.allowDiscard}}">本主题不允许丢弃持有物品</text><view class="tb-group" wx:if="{{themeBag.allowDiscard}}"><view class="tb-row" wx:for="{{themePendingClaim.owned}}" wx:key="id"><view class="tb-copy"><text class="tb-name">{{item.name}}</text><text class="tb-purpose">持有 ×{{item.quantity}} · 每件 {{item.slotCost}} 格</text></view><input class="tb-number" type="number" value="{{item.discard}}" disabled="{{themeBagBusy || themeBagUnknown}}" data-id="{{item.id}}" bindinput="changeThemeOwnedDiscard" aria-label="丢弃持有{{item.name}}的数量" /></view></view><text class="tb-purpose">领取时会再次确认容量与锁定物品；领取失败不会丢弃已有物品。</text><text class="tb-purpose tb-warning" wx:if="{{themePendingClaim.error}}">{{themePendingClaim.error}}</text><cy-inline-error wx:if="{{themeBagUnknown}}" title="操作结果未确认" action="确认重试" bind:action="retryThemeBagAction" />
</view>
<view slot="footer" class="tb-footer"><view class="tb-button tb-button--primary {{themePendingClaim.invalid || themeBagBusy || themeBagUnknown ? 'is-busy' : ''}}" bindtap="confirmThemePendingClaim" aria-label="确认丢弃选择并领取待领奖励" hover-class="cy-pressed" hover-stay-time="80" aria-role="button">确认领取</view></view>
</cy-sheet>

<cy-sheet show="{{!!themeTradeForm}}" title="" closable="{{false}}" handle="{{true}}" footer="{{true}}" bind:close="closeThemeTradeForm" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop}}px);--cy-comp-sheet-blur:0px;--cy-comp-sheet-role-glass:var(--cy-comp-sheet-player-page);--cy-comp-sheet-role-text:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-text-secondary:var(--cy-comp-sheet-player-text-secondary);--cy-comp-sheet-role-muted:var(--cy-comp-sheet-player-muted);--cy-comp-sheet-role-surface:var(--cy-comp-sheet-player-surface);--cy-comp-sheet-role-divider:var(--cy-comp-sheet-player-divider);--cy-comp-sheet-role-btn-bg:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-btn-fg:var(--cy-comp-sheet-player-page)">
<view class="tb-sheet"><view class="tb-close" bindtap="closeThemeTradeForm" aria-label="收起交换清单" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="32" /></view><text class="tb-title">物资交换</text><text class="tb-heading">与队伍 {{themeTradeForm.toTeamId}} 交换</text><text class="tb-purpose">数量填 0 表示不交换；预览会核验库存和负重</text>
<cy-inline-error class="tb-purpose tb-warning" wx:if="{{themeTradeError}}" aria-live="polite" kind="error" title="{{themeTradeError}}" />
<view class="tb-group tb-details" wx:for="{{themeTradeForm.items}}" wx:key="id"><text class="tb-heading">{{item.name}}</text><view class="tb-detail-row"><text>我方给出</text><input class="tb-number" type="number" value="{{item.give}}" data-index="{{index}}" data-side="give" bindinput="inputThemeTradeQuantity" disabled="{{themeBagBusy || themeTradeUnknown}}" aria-label="我方给出{{item.name}}的数量" /></view><view class="tb-detail-row"><text>对方给出</text><input class="tb-number" type="number" value="{{item.take}}" data-index="{{index}}" data-side="take" bindinput="inputThemeTradeQuantity" disabled="{{themeBagBusy || themeTradeUnknown}}" aria-label="对方给出{{item.name}}的数量" /></view></view>
<view class="tb-group tb-details" wx:if="{{themeTradePreview}}"><text class="tb-heading">交换预览</text><view class="tb-detail-row"><text>我方给出</text><text>{{themeTradePreview.giveText}}</text></view><view class="tb-detail-row"><text>对方给出</text><text>{{themeTradePreview.takeText}}</text></view><view class="tb-detail-row"><text>本队交换后负重</text><text>{{themeTradePreview.fromUsed}} / {{themeTradePreview.capacity}}</text></view><view class="tb-detail-row"><text>对方交换后负重</text><text>{{themeTradePreview.toUsed}} / {{themeTradePreview.capacity}}</text></view></view>
</view>
<view slot="footer" class="tb-footer"><view wx:if="{{themeTradeUnknown}}" class="tb-button tb-button--primary {{themeBagBusy ? 'is-busy' : ''}}" bindtap="checkThemeTradeReceipt" aria-role="button" aria-label="确认交易结果" hover-class="cy-pressed" hover-stay-time="80">确认交易结果</view><view wx:elif="{{themeTradePreview}}" class="tb-button tb-button--primary {{themeBagBusy ? 'is-busy' : ''}}" bindtap="submitThemeTrade" aria-role="button" aria-label="发起预览中的交换" hover-class="cy-pressed" hover-stay-time="80">发起交换</view><view wx:else class="tb-button tb-button--primary {{themeBagBusy ? 'is-busy' : ''}}" bindtap="previewThemeTrade" aria-role="button" aria-label="预览交换后的物资和负重" hover-class="cy-pressed" hover-stay-time="80">预览交换</view></view>
</cy-sheet>

