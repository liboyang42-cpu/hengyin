<view wx:if="{{playerRunNotice || playerOperationRows.length || playerManualRows.length || playerExitText || playerOperationUnknown || playerArrivalProof}}" class="drow" bindtap="openPlayerOperations" aria-role="button" aria-label="站点与本队操作" hover-class="cy-pressed" hover-stay-time="80"><view class="dcopy"><text class="dt">站点与本队</text><text class="ds" aria-live="polite">{{playerRunNotice || playerExitText || '到场核验 · 现场记录'}}</text></view><cy-icon name="chevron-right" size="32" /></view>
<view class="drow drow--static" wx:if="{{playerExitGuide}}" aria-role="text" aria-label="离开页面与退出本局的区别"><view class="dcopy"><text class="dt">离开与退出</text><text class="ds">{{playerExitGuide.leave.title}}：<block wx:for="{{playerExitGuide.leave.lines}}" wx:key="*this">{{index ? '；' : ''}}{{item}}</block></text><text class="ds">{{playerExitGuide.exit.title}}：<block wx:for="{{playerExitGuide.exit.lines}}" wx:key="*this">{{index ? '；' : ''}}{{item}}</block></text></view></view>
