/* 角色 Cast v1 玩家侧(契约 docs/design/cast-contract-1119.md · Hard UI rules / C / E1–E6)。
   页边名字、配音行、记住这件事都用 currentColor + 透明度:跟着各外观的正文色走,深色底上即 rgba(255,255,255,.46)。
   动效只用过渡(token 时长),减弱动态时整层直接落定;不新增 @keyframes。 */

/* —— 正文段:说话人在左侧页边,与首行齐平;所有正文段同一条左边线,名字落在阅读栏左边的页边里(左 24rpx 起、64rpx 宽),永远不压字 —— */
.chfull__para--who{ position:relative; }
.chfull__who{ position:absolute; top:0; left:calc(var(--cy-space-3) - var(--cy-space-8)); width:calc(var(--cy-space-8) - var(--cy-space-3) - var(--cy-space-1)); font-size:20rpx; font-weight:400; line-height:66rpx; text-align:left; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; opacity:.46; letter-spacing:.04em; font-family:-apple-system, "PingFang SC", "Noto Sans SC", sans-serif; } /* ds-ok 契约 10px/400/浅灰;66rpx = 正文 34rpx × 1.95 首行行高 */
.chfull__vrow{ display:flex; align-items:center; justify-content:flex-start; gap:var(--cy-space-1); margin:var(--cy-space-2) 0 0; padding:var(--cy-space-2) 0; font-size:22rpx; line-height:1.4; letter-spacing:.08em; text-align:left; opacity:.46; font-family:-apple-system, "PingFang SC", sans-serif; } /* ds-ok 契约 D1「▶︎ 0:08」小、浅灰;跟正文同一条左边线 */
.chfull__remember{ display:block; margin-top:var(--cy-space-3); font-size:24rpx; line-height:1.5; text-align:left; opacity:.46; font-family:-apple-system, "PingFang SC", sans-serif; } /* ds-ok 契约 E3 12px 浅灰,左对齐 */

/* —— E2 首段首字下沉:约三行高,左浮;这一段改左对齐,首字才贴得住 —— */
.chfull__para--drop{ text-align:left; }
.chfull__drop{ float:left; margin:14rpx 18rpx 0 0; font-size:168rpx; line-height:.86; font-weight:600; } /* ds-ok 三行 ≈ 3 × 66rpx */

/* —— E2 页脚:章名 · 第x站 / 共y站,11px,淡。2026-11-21 业主:原来钉在屏底、压在最后一段上;改成跟在章末流里,永远不叠正文 —— */
.chfull__runfoot{ display:block; margin:var(--cy-space-5) var(--cy-space-6) 0; font-size:22rpx; line-height:1.4; letter-spacing:.06em; text-align:center; color:var(--atmo-muted, var(--cy-color-text-tertiary)); opacity:.6; pointer-events:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; } /* ds-ok 契约 11px 淡 */

/* —— E3 行内选项:阅读栏里,编号 1–3,发丝线分隔,16px —— */
.chfull__choice{ text-align:left; }
.chfull__choice-q{ margin-bottom:var(--cy-space-4); font-size:34rpx; line-height:1.95; text-align:left; } /* ds-ok 同正文 17px/1.95 */
.chfull__choice-o{ display:flex; align-items:baseline; gap:var(--cy-space-3); padding:var(--cy-space-4) var(--cy-space-1); border-top:1px solid var(--cy-color-border-strong); transition:opacity var(--cy-motion-fast, 150ms) var(--cy-ease-out, ease-out); }
.chfull__choice-o:last-child{ border-bottom:1px solid var(--cy-color-border-strong); }
.chfull__choice-n{ flex:none; min-width:32rpx; font-size:26rpx; opacity:.46; font-variant-numeric:tabular-nums; font-family:-apple-system, "PingFang SC", sans-serif; } /* ds-ok 选项序号比选项字小一档(13px) */
.chfull__choice-t{ flex:1; min-width:0; font-size:32rpx; line-height:1.6; } /* ds-ok 契约 E3 选项 16px */
.chfull__choice-o.is-off{ opacity:.3; }
.play--reduced-motion .chfull__choice-o{ transition:none; }

/* —— 共用:五格信任勾(角色卡 / 完成页) —— */
.castend__tick{ width:36rpx; height:8rpx; border-radius:4rpx; background:var(--cy-color-border-strong); } /* ds-ok 信任勾 18×4px 细条 */

/* —— C 起名 / E1 登场人物:整屏深色,一屏一件事 —— */
.cstart, .cbill{ position:fixed; inset:0; z-index:var(--cy-z-modal); display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box; padding:calc(var(--cy-space-8) * 2) var(--cy-space-6) calc(env(safe-area-inset-bottom) + var(--cy-space-6)); background:var(--cy-color-bg-page); color:var(--cy-color-text-primary); opacity:0; transition:opacity var(--cy-motion-read-rise, 180ms) var(--cy-ease-out, ease-out); }
.cstart.is-in, .cbill.is-in{ opacity:1; }
.play--reduced-motion .cstart, .play--reduced-motion .cbill{ transition:none; opacity:1; }
.cstart__q{ font-size:var(--cy-type-page-title); font-weight:600; line-height:1.35; }
.cstart__in{ margin-top:var(--cy-space-6); padding:var(--cy-space-3) 0; min-height:96rpx; font-size:56rpx; border-bottom:1px solid var(--cy-color-border-strong); color:var(--cy-color-text-primary); } /* ds-ok 起名大输入框 28px(契约 C「large input」) */
.cstart__ph{ color:var(--cy-color-text-disabled); }
.cstart__ids{ margin-top:var(--cy-space-6); display:flex; flex-direction:column; gap:var(--cy-space-3); }
.cstart__id{ display:flex; flex-direction:column; gap:var(--cy-space-1); padding:var(--cy-space-4); border-radius:var(--cy-radius-lg); background:var(--cy-color-bg-elevated); border:1px solid transparent; transition:border-color var(--cy-motion-fast, 150ms) var(--cy-ease-out, ease-out); }
.cstart__id.is-on{ border-color:var(--cy-color-text-primary); }
.cstart__id-t{ font-size:var(--cy-type-card-title); font-weight:600; }
.cstart__id-s{ font-size:var(--cy-type-body); color:var(--cy-color-text-tertiary); }
.cstart__go{ display:flex; align-items:center; justify-content:center; min-height:var(--cy-btn-h); border-radius:var(--cy-radius-pill); background:var(--cy-color-text-primary); color:var(--cy-color-text-inverse); font-size:var(--cy-type-button); font-weight:600; }
.cstart__go.is-busy{ opacity:.5; }
.cbill__route{ font-size:var(--cy-type-caption); letter-spacing:.2em; color:var(--cy-color-text-tertiary); }
.cbill__t{ margin:var(--cy-space-2) 0 var(--cy-space-6); font-size:var(--cy-type-page-title); font-weight:600; letter-spacing:.12em; }
.cbill__row{ display:flex; align-items:baseline; gap:var(--cy-space-2); padding:var(--cy-space-3) 0; }
.cbill__n{ flex:none; font-size:var(--cy-type-card-title); font-weight:600; }
.cbill__dots{ flex:1; min-width:var(--cy-space-4); border-bottom:2rpx dotted var(--cy-color-border-strong); transform:translateY(-8rpx); }
.cbill__i{ flex:none; max-width:74%; font-size:var(--cy-type-caption); line-height:1.5; color:var(--cy-color-text-secondary); text-align:right; }
.cbill__rule{ margin:var(--cy-space-3) 0; height:1px; background:var(--cy-color-border-strong); }

/* —— E4 角色卡:深色半屏 —— */
.ccard-mask{ position:fixed; inset:0; z-index:var(--cy-z-sheet); background:rgba(0,0,0,.5); opacity:0; transition:opacity var(--cy-motion-read-rise, 180ms) var(--cy-ease-out, ease-out); } /* ds-ok 遮罩 */
.ccard{ position:fixed; left:0; right:0; bottom:0; z-index:var(--cy-z-sheet); box-sizing:border-box; max-height:80vh; overflow-y:auto; padding:var(--cy-space-6) var(--cy-space-5) calc(env(safe-area-inset-bottom) + var(--cy-space-6)); border-radius:var(--cy-radius-xl) var(--cy-radius-xl) 0 0; background:var(--cy-color-bg-elevated); color:var(--cy-color-text-primary); transform:translateY(100%); transition:transform var(--cy-motion-read-transition, 320ms) var(--cy-ease-out, ease-out); }
.ccard-mask.is-in{ opacity:1; }
.ccard.is-in{ transform:none; }
.play--reduced-motion .ccard, .play--reduced-motion .ccard-mask{ transition:none; }
.ccard__head{ display:flex; align-items:center; gap:var(--cy-space-3); }
.ccard__face{ flex:none; width:112rpx; height:112rpx; border-radius:50%; overflow:hidden; }
.ccard__face--i{ display:flex; align-items:center; justify-content:center; font-size:44rpx; font-weight:600; color:#FFFFFF; } /* ds-ok 角色色底上的白字首字 */
.ccard__copy{ flex:1; min-width:0; display:flex; flex-direction:column; gap:var(--cy-space-1); }
.ccard__name{ font-size:var(--cy-type-sheet-title); font-weight:600; }
.ccard__id{ font-size:var(--cy-type-body); color:var(--cy-color-text-secondary); }
.ccard__play{ flex:none; display:flex; align-items:center; justify-content:center; min-width:88rpx; min-height:88rpx; border-radius:50%; background:var(--cy-color-bg-raised); font-size:var(--cy-type-body); }
.ccard__k{ margin:var(--cy-space-5) 0 var(--cy-space-2); font-size:var(--cy-type-caption); letter-spacing:.12em; color:var(--cy-color-text-tertiary); }
.ccard__ticks{ display:flex; gap:var(--cy-space-1); }
.ccard__clue{ padding:var(--cy-space-2) 0; font-size:var(--cy-type-card-title); line-height:1.7; border-bottom:1px solid var(--cy-color-border-subtle); }
.ccard__lock{ padding-top:var(--cy-space-2); font-size:var(--cy-type-body); color:var(--cy-color-text-tertiary); }

/* —— E6 完成页「他们怎么看你」:书页式,名字在页边 —— */
.castend{ margin:var(--cy-space-5) var(--cy-space-5) 0; padding:var(--cy-space-5) 0 0; }
.castend__h{ margin-bottom:var(--cy-space-4); font-size:var(--cy-type-section-title); font-weight:600; text-align:center; letter-spacing:.12em; }
.castend__row{ position:relative; padding:0 52rpx var(--cy-space-5); }
.castend__who{ position:absolute; left:-12rpx; top:0; width:64rpx; font-size:20rpx; line-height:58rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; opacity:.46; } /* ds-ok 同正文页边名字 */
.castend__line{ font-size:var(--cy-type-card-title); line-height:1.95; text-align:center; }
.castend__row .castend__ticks{ display:flex; justify-content:center; gap:var(--cy-space-1); margin-top:var(--cy-space-2); min-height:58rpx; align-items:center; }
.castend__foot{ padding:var(--cy-space-3) 0 var(--cy-space-2); font-size:var(--cy-type-label); line-height:1.6; text-align:center; color:var(--cy-color-text-tertiary); }
