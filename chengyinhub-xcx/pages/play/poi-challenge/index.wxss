page { background: #000; } /* ds-ok 玩家侧深色,与游玩页同底 */
.pc-page { min-height: 100vh; }
.pc-page__state { padding: 240rpx var(--cy-space-4) 0; }
.pc-page__exit { margin-top: var(--cy-space-4); min-height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--cy-color-text-secondary); font-size: var(--cy-type-label); }

/* 细节打磨二期 L1/L5/L7 */
.pc-page__exit { transition: var(--cy-tr-press); }

/* A3.6 还没走到:还差多少米 + 导航 */
.pc-page__gap { position: fixed; left: 50%; bottom: calc(var(--cy-space-4) + env(safe-area-inset-bottom)); z-index: var(--cy-z-sheet); transform: translateX(-50%); min-height: 88rpx; padding: 0 var(--cy-space-4); display: flex; align-items: center; gap: var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--cy-color-play-elevated); color: var(--cy-color-text-primary); font-size: var(--cy-type-label); font-weight: 700; }
.pc-page__gap text:last-child { color: var(--cy-color-play-accent); }
