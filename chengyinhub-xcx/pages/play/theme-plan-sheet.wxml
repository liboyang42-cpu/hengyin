<cy-sheet show="{{!!themePlanKey}}" title="" closable="{{false}}" handle="{{true}}" footer="{{false}}" bind:close="closeThemePlan" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop}}px);--cy-comp-sheet-blur:0px;--cy-comp-sheet-role-glass:var(--cy-comp-sheet-player-page);--cy-comp-sheet-role-text:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-text-secondary:var(--cy-comp-sheet-player-text-secondary);--cy-comp-sheet-role-muted:var(--cy-comp-sheet-player-muted);--cy-comp-sheet-role-surface:var(--cy-comp-sheet-player-surface);--cy-comp-sheet-role-divider:var(--cy-comp-sheet-player-divider);--cy-comp-sheet-role-btn-bg:var(--cy-comp-sheet-player-text);--cy-comp-sheet-role-btn-fg:var(--cy-comp-sheet-player-page)">
  <view class="tb-sheet"><view class="tb-close" bindtap="closeThemePlan" aria-role="button" aria-label="关闭方案" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="32" /></view>
    <block wx:for="{{themeBag.planRows}}" wx:key="uiKey" wx:if="{{item.uiKey === themePlanKey}}">
      <text class="tb-title">{{item.title}}</text><text class="tb-purpose">{{item.summary}}</text>
      <view class="tb-group tb-details"><view class="tb-detail-row"><text>需求物资</text><text>{{item.requirementText}}</text></view><view class="tb-detail-row"><text>已确认托管</text><text>{{item.confirmedText}}</text></view><view class="tb-detail-row"><text>本队私有意向</text><text>{{item.intentText}}</text></view><text class="tb-purpose">{{item.conditionText}}</text><text class="tb-purpose tb-warning" wx:if="{{item.signatureText}}">{{item.signatureText}}</text></view>
      <text class="tb-purpose" wx:if="{{themeBag.planBallotText}}">{{themeBag.planBallotText}}</text>
      <text class="tb-purpose">投入意向不扣物资。获选后各出资队长签署托管，操作通过并执行后才消耗。</text>
      <text class="tb-purpose" wx:if="{{item.selected && item.operationNodeId}}">操作站点：{{item.operationNodeName}} · {{item.trustedPass ? '操作任务已通过' : '等待操作任务通过'}}</text>
      <text class="tb-purpose" wx:if="{{item.reason}}">{{item.reason}}</text>
      <view class="tb-actions"><view class="tb-button {{themeBagBusy || themePlanUnknown ? 'is-busy' : ''}}" wx:for="{{item.commandButtons}}" wx:for-item="button" wx:key="action" data-action="{{button.action}}" bindtap="onThemePlanCommand" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">{{button.label}}</view>
        <view wx:if="{{item.canEditFunding}}" class="tb-button tb-button--muted {{themeBagBusy || themePlanUnknown ? 'is-busy' : ''}}" bindtap="editThemePlanFunding" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">编辑本队投入意向</view>
        <view wx:if="{{item.selected && item.operationStarted}}" class="tb-button tb-button--muted" bindtap="openThemePlanOperation" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">进入操作站点</view>
      </view>
    </block>
    <view class="tb-group tb-details" wx:if="{{themePlanForm}}"><text class="tb-heading">本队投入意向</text><text class="tb-purpose">仅本队可见，填 0 取消该物资意向。修改成功后以最新回读为准。</text><view class="tb-detail-row" wx:for="{{themePlanForm.items}}" wx:key="itemId"><text>{{item.name}}</text><input class="tb-number" type="number" value="{{item.quantity}}" data-index="{{index}}" bindinput="inputThemePlanFunding" disabled="{{themeBagBusy || themePlanUnknown}}" aria-label="{{item.name}}的本队投入数量" /></view><view class="tb-actions"><view class="tb-button tb-button--primary {{themeBagBusy || themePlanUnknown ? 'is-busy' : ''}}" bindtap="saveThemePlanFunding" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">签署本队投入意向</view><view class="tb-button tb-button--muted {{themeBagBusy || themePlanUnknown ? 'is-busy' : ''}}" bindtap="cancelThemePlanFunding" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">取消编辑</view></view></view>
    <text class="tb-purpose tb-warning" wx:if="{{themePlanError}}" aria-live="polite">{{themePlanError}}</text><view class="tb-button {{themeBagBusy ? 'is-busy' : ''}}" wx:if="{{themePlanUnknown}}" bindtap="checkThemePlanReceipt" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">核对原请求结果</view>
  </view>
</cy-sheet>
