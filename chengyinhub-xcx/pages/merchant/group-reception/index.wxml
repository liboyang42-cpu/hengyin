<!-- X034 商家「已接待团」:扫团码登记过的接待记录回读;结算开始前可撤销误扫。 -->
<view class="gr-page theme-merchant">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-nav-bar custom-back bind:back="onNavBack" />
  <view class="gr-nav-spacer" style="height: {{statusBarHeight + navBarHeight}}px;"></view>
  <cy-page-title title="已接待团" subtitle="本店扫团码登记的接待记录" safe-top="{{false}}" />

  <cy-skeleton type="list" count="{{3}}" wx:if="{{accessState === 'loading' || (accessState === 'ready' && listState === 'loading')}}" />
  <cy-error wx:elif="{{accessState === 'error' || (accessState === 'ready' && listState === 'error')}}" fill
    title="{{accessState === 'error' ? '商家权限加载失败' : '接待记录加载失败'}}"
    sub="{{accessState === 'error' ? accessErrorText : listErrorText}}" retry="重试" bind:retry="retry" />
  <cy-error wx:elif="{{accessState === 'no-permission'}}" fill retry=""
    title="当前岗位不能查看接待记录" sub="扫码核销岗位才能查看和撤销团码接待记录，请联系店主调整岗位。" />
  <cy-empty wx:elif="{{items.length === 0}}" fill kind="empty"
    title="还没有接待过团" sub="领队出示团码后，在工作台点「扫码」即可登记接待" />
  <block wx:else>
    <view class="gr-hint">撤销仅限主题结算开始前，撤销后该团不计入本店分账，并留存操作记录。</view>
    <view wx:for="{{items}}" wx:key="id" class="gr-card">
      <view class="gr-card__head">
        <text class="gr-card__title">{{item.topicName}}</text>
        <text class="gr-card__status {{item.settled ? 'is-settled' : ''}}">{{item.statusText}}</text>
      </view>
      <text class="gr-card__line">场次：{{item.activityText}}</text>
      <text class="gr-card__line">领队：{{item.leaderName}}</text>
      <text class="gr-card__line">接待时间：{{item.verifyTimeText || '—'}}</text>
      <view wx:if="{{item.canRevoke}}" class="gr-card__action {{revokingId === item.id ? 'is-busy' : ''}}"
            bindtap="onRevoke" data-id="{{item.id}}"
            aria-role="button" aria-label="撤销{{item.topicName}}的接待记录"
            hover-class="cy-pressed" hover-stay-time="80">{{revokingId === item.id ? '撤销中…' : '撤销接待'}}</view>
    </view>
  </block>
</view>
