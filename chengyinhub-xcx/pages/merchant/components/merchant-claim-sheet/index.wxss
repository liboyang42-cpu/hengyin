.mcs { display: flex; flex-direction: column; gap: var(--cy-space-3); padding: var(--cy-space-2) var(--cy-space-4) var(--cy-space-6); }
.mcs__block { display: flex; flex-direction: column; gap: var(--cy-space-2); }
.mcs__note { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); line-height: 1.5; }
.mcs__status { display: flex; flex-direction: column; gap: var(--cy-space-2); padding: var(--cy-space-3); border-radius: var(--cy-radius-md); background: var(--cy-color-bg-raised); }
.mcs__status-title { font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-text-title); }
.mcs__reason { font-size: var(--cy-type-caption); color: var(--cy-color-text-primary, var(--cy-text-title)); word-break: break-all; }
.mcs__search { display: flex; gap: var(--cy-space-2); align-items: center; }
.mcs__input, .mcs__area {
  box-sizing: border-box; width: 100%; padding: var(--cy-space-2) var(--cy-space-3);
  border: 1rpx solid var(--cy-color-border-strong); border-radius: var(--cy-radius-md);
  font-size: var(--cy-font-body); background: var(--cy-color-bg-surface);
}
.mcs__search .mcs__input { flex: 1; }
.mcs__area { height: 180rpx; }
.mcs__cand { padding: var(--cy-space-3); border-bottom: 1rpx solid var(--cy-color-border-strong); font-size: var(--cy-font-body); }
.mcs__picked { display: flex; justify-content: space-between; font-size: var(--cy-font-body); }
.mcs__link { color: var(--cy-color-text-secondary); text-decoration: underline; }
.mcs__proofs { display: flex; flex-wrap: wrap; gap: var(--cy-space-2); }
.mcs__proof { position: relative; width: 160rpx; height: 160rpx; border-radius: var(--cy-radius-md); overflow: hidden; background: var(--cy-color-bg-raised); }
.mcs__proof--add { display: flex; align-items: center; justify-content: center; }
.mcs__proof-img { width: 100%; height: 100%; }
.mcs__proof-x { position: absolute; top: 0; right: 0; width: 88rpx; height: 88rpx; display: flex; align-items: flex-start; justify-content: flex-end; padding: var(--cy-space-1); box-sizing: border-box; color: var(--cy-color-text-inverse); }

/* isolated 组件内全局 .cy-pressed 进不来,本地定义一份 */
.cy-pressed { opacity: .88; }
.mcs__proof-dot { display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--cy-color-overlay); }
