@import '../../../style/merchant-light.wxss';

.page { min-height: 100vh; background: var(--cy-bg-page); }
.body { padding: var(--cy-space-3) var(--cy-page-x) var(--cy-tabbar-h); }
.rel-tabs { display: block; padding: 0 var(--cy-page-x); }
.scope-note {
  padding: var(--cy-space-2-5) var(--cy-space-3);
  border-radius: var(--cy-radius-md);
  color: var(--cy-text-secondary);
  font-size: var(--cy-font-label);
  line-height: var(--cy-leading-normal);
}
.rel-inline-error { display: block; margin-bottom: var(--cy-space-3); }
.refresh-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--cy-space-1-5);
  min-height: 56rpx;
  color: var(--cy-text-secondary);
  font-size: var(--cy-font-label);
}
/* 2026-08-20 卡片重设计:行换成卡后外层白面板退场,卡直接落页面底 */
.rel-list { display: flex; flex-direction: column; gap: var(--cy-space-3); margin-top: var(--cy-space-3); }
.rel-item { overflow: hidden; border-radius: var(--cy-radius-lg); }
.fill-slot { display: flex !important; flex-direction: column !important; min-height: 60vh !important; }

/* 2026-10-23 页面动效(utils/page-motion.js):容器 --pm-* 置 1 时先隐着,再依次浮上来;静止时无过渡,按压反馈不受影响;减少动态效果时从不触发 */
.rel-item { filter: opacity(calc(1 - var(--pm-q, 0))); translate: 0 calc(var(--pm-q, 0) * 31rpx); transition: filter var(--pm-q-d, 0s) ease, translate var(--pm-q-d, 0s) cubic-bezier(.2,.82,.2,1), transform var(--cy-motion-press) var(--cy-ease-out), opacity var(--cy-motion-press) var(--cy-ease-out); transition-delay: calc(var(--pm-q-s, 0) * 0ms), calc(var(--pm-q-s, 0) * 0ms), 0s, 0s; }
.rel-item:nth-child(2) { transition-delay: calc(var(--pm-q-s, 0) * 45ms), calc(var(--pm-q-s, 0) * 45ms), 0s, 0s; }
.rel-item:nth-child(3) { transition-delay: calc(var(--pm-q-s, 0) * 90ms), calc(var(--pm-q-s, 0) * 90ms), 0s, 0s; }
.rel-item:nth-child(4) { transition-delay: calc(var(--pm-q-s, 0) * 135ms), calc(var(--pm-q-s, 0) * 135ms), 0s, 0s; }
.rel-item:nth-child(5) { transition-delay: calc(var(--pm-q-s, 0) * 180ms), calc(var(--pm-q-s, 0) * 180ms), 0s, 0s; }
.rel-item:nth-child(6) { transition-delay: calc(var(--pm-q-s, 0) * 225ms), calc(var(--pm-q-s, 0) * 225ms), 0s, 0s; }
.rel-item:nth-child(7) { transition-delay: calc(var(--pm-q-s, 0) * 270ms), calc(var(--pm-q-s, 0) * 270ms), 0s, 0s; }
.rel-item:nth-child(8) { transition-delay: calc(var(--pm-q-s, 0) * 315ms), calc(var(--pm-q-s, 0) * 315ms), 0s, 0s; }
.rel-item:nth-child(n+9) { transition-delay: calc(var(--pm-q-s, 0) * 360ms), calc(var(--pm-q-s, 0) * 360ms), 0s, 0s; }
