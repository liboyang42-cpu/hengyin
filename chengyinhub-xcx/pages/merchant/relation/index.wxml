<wxs module="relation">
function valid(items) {
  var result = [];
  if (!items || !items.length) return result;
  for (var i = 0; i < items.length; i++) {
    if (items[i] && typeof items[i].displayName === 'string' && items[i].displayName) result.push(items[i]);
  }
  return result;
}
module.exports = { valid: valid };
</wxs>
<view class="page theme-merchant m-flush-nav" style="padding-top:{{statusBarHeight + navBarHeight}}px">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-access-gate id="cy-access-gate" kind="merchant" need="canManageCoop" />
  <!-- tab 页无返回箭头,标题居中(与商家其余页 / 「我的」同一形态) -->
  <cy-nav-bar title="合作" back="{{false}}" />

  <!-- 2026-08-09:删掉「我的合作」与三格跨项目统计。合作在业务上是跟着项目走的
       (coop_invite 每条都绑 topicId),已谈成的合作方在对应主题工作台按俱乐部/商家/客户
       分好了;这里再摊平一份跨项目名册,既丢了项目上下文,又让人误以为存在长期关系。
       本页职责:帖子 / 俱乐部两个 tab(2026-10-22 起不再列商家)。 -->
  <cy-tabs class="rel-tabs" variant="fill" wide="{{true}}" tabs="{{tabs}}" active="{{activeTab}}" bind:change="onTabChange" />

  <view class="body" style="{{pmList === 1 ? '--pm-q:1;' : (pmList === 2 ? '--pm-q-d:.32s;--pm-q-s:1;' : '')}}">
    <!-- 帖子(默认):2026-10-22 owner —— 合作 tab 看帖子,商家不再看到其他商家。
         与 pages/talent/list 的帖文同源 /api/club/post/feed;骨架超过 400ms 才出,回到本页保留旧内容。 -->
    <block wx:if="{{activeTab === 'feed'}}">
      <cy-skeleton wx:if="{{feedState === 'loading' && feedSlow}}" type="card" count="{{3}}" loading-label="帖子加载中" />
      <cy-error load-failure class="cy-fade-in" wx:elif="{{feedState === 'error'}}" title="帖子加载失败" sub="{{feedError}}" retry="重试" bind:retry="loadFeed" />
      <block wx:elif="{{feed.length}}">
        <cy-post-card class="cy-fade-in" wx:for="{{feed}}" wx:key="feedKey" post="{{item}}" index="{{index}}" light="{{true}}" interactive-club
          accessibility-label="查看{{item.memberNickname || '城瘾玩家'}}的动态"
          bind:detail="onPostTap" bind:club="onPostClub"
          bind:playdetail="onPostReference" bind:play="onPostReference" />
      </block>
      <cy-empty wx:elif="{{feedState === 'empty'}}" kind="empty" title="{{feedEmptyTitle}}" sub="{{feedEmptySub}}" />
    </block>

    <block wx:else>
      <cy-skeleton wx:if="{{pageState === 'loading'}}" type="card" count="{{3}}" loading-label="合作对象加载中" />
      <!-- 未登录不再整屏拦:静默登录后自动加载;登录失败只留这条内联错误 + 重试。 -->
      <cy-inline-error load-failure class="rel-inline-error" wx:elif="{{pageState === 'error'}}" kind="data"
        title="合作数据加载失败" sub="{{error}}" action="重新加载" bind:action="retryRelation" />
      <block wx:else>
        <view wx:if="{{refreshing}}" class="refresh-note" aria-role="status" aria-live="polite">
          <text>正在更新合作对象</text>
        </view>
        <cy-inline-error load-failure class="rel-inline-error" wx:if="{{clubError}}" kind="data"
          title="部分俱乐部资料暂不可用" sub="{{clubError}}" action="重新加载" bind:action="loadRelationHome" />
        <!-- 俱乐部换新版俱乐部卡；整卡进主页看资料，按钮「发起合作」直达 type=1 邀约表单 -->
        <view class="rel-list" wx:if="{{relation.valid(clubs).length}}">
          <view class="rel-item" wx:for="{{relation.valid(clubs)}}" wx:key="id" wx:if="{{item.displayName}}">
            <cy-club-card club="{{item}}" audience="merchant" interactive="{{true}}"
              data-id="{{item.id}}" aria-label="查看{{item.displayName}}俱乐部档案" bind:tap="goClub" bind:action="goClub"  hover-class="cy-pressed" hover-stay-time="80"/>
          </view>
        </view>
        <cy-empty wx:elif="{{!clubError}}" kind="empty" title="暂无可合作俱乐部" />
      </block>
    </block>
  </view>

  <tabBar mode="merchant" activeKey="relation" />
</view>
