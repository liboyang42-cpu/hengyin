@import '../../../../style/merchant-light.wxss';
@import '../design.wxss';
@import '../../../../style/threads-menu.wxss';
.npc-hero {
  display: flex;
  align-items: center;
  text-align: center;
  flex-direction: column;
  gap: 23rpx;
  margin-bottom: 8rpx;
}
.npc-persona-note {
  margin-top: 15rpx;
  padding: 0 8rpx;
}
.npc-preview {
  width: 277rpx;
  height: 277rpx;
  border-radius: 46rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  overflow: hidden;
}
.npc-preview--large {
  width: 338rpx;
  height: 338rpx;
}
.npc-preview image,
.npc-canvas {
  width: 100%;
  height: 100%;
}
.npc-stage {
  padding: 46rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 23rpx;
  background: var(--cy-color-bg-surface-subtle);
  border-radius: 46rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
}
.npc-sources {
  display: flex;
  gap: 19rpx;
  width: 100%;
}
.npc-sources > view {
  flex: 1;
  height: 85rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cy-color-bg-surface);
  border-radius: 43rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  font-size: 25rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
}
.npc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
}
.npc-tile {
  aspect-ratio: 1;
  border-radius: 23rpx; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
  overflow: hidden;
  box-sizing: border-box;
  border: 4rpx solid transparent;
}
.npc-tile--selected {
  border-color: var(--cy-color-action-primary-bg);
}
.npc-tile-canvas {
  width: 100%;
  height: 148rpx;
}
.npc-work {
  position: fixed;
  left: -1000px;
  top: -1000px;
  width: 384px;
  height: 384px;
}
.npc-voice {
  min-height: 680rpx;
}
.npc-voice-mode {
  position: relative;
  padding: var(--cy-space-3);
  box-sizing: border-box;
  border-radius: 28rpx; /* ds-ok: reference Voice Mode 大圆角卡片 */
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-primary);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.npc-voice-mode__title {
  display: block;
  font-size: var(--cy-type-card-title);
  font-weight: 700;
}
.npc-voice-progress {
  display: flex;
  gap: var(--cy-space-1);
  margin: var(--cy-space-2) 0;
}
.npc-voice-progress__step {
  height: 6rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-border-subtle);
  flex: 1;
}
.npc-voice-progress__step--active { background: var(--cy-color-status-info); }
.npc-voice-progress__step--done { background: var(--cy-color-status-success); }
.npc-voice-stage {
  position: relative;
  height: 520rpx; /* ds-ok: reference Voice Mode 文字在圆圈上方的纵向比例 */
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-bg-surface);
  overflow: hidden;
}
.npc-voice-prompt {
  position: absolute;
  z-index: 3;
  top: var(--cy-space-3);
  left: var(--cy-space-3);
  right: var(--cy-space-3);
  min-height: 150rpx;
  color: var(--cy-color-text-primary);
  font-size: 34rpx; /* ds-ok: 用户确认需要更大的居中逐句提示 */
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
}
.npc-voice-ring,
.npc-voice-orb {
  position: absolute;
  left: 50%;
  top: 70%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.npc-voice-ring {
  border: 2rpx solid var(--cy-color-border-default);
  box-sizing: border-box;
  opacity: .45;
}
.npc-voice-ring--outer { width: 430rpx; height: 430rpx; opacity: .2; } /* ds-ok: reference Voice Mode 双层圆环比例 */
.npc-voice-ring--inner { width: 300rpx; height: 300rpx; }
.npc-voice-orb {
  width: 196rpx; /* ds-ok: reference Voice Mode 中央声纹比例 */
  height: 196rpx;
  background: var(--cy-color-bg-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--cy-color-text-tertiary);
  z-index: 2;
}
.npc-wave {
  height: 64rpx; /* ds-ok: reference Voice UI 声纹几何 */
  display: flex;
  align-items: center;
  gap: 5rpx; /* ds-ok: reference Voice UI 紧密声纹间距 */
}
.npc-wave view {
  width: 5rpx; /* ds-ok: reference Voice UI 细声纹 */
  height: 22rpx; /* ds-ok: reference Voice UI 声纹基线 */
  border-radius: var(--cy-radius-pill);
  background: currentColor;
  transform-origin: center;
  transition: transform var(--cy-motion-standard) var(--cy-ease-standard);
}
.npc-wave view:nth-child(2),
.npc-wave view:nth-child(10) { height: 32rpx; }
.npc-wave view:nth-child(3),
.npc-wave view:nth-child(9) { height: 42rpx; }
.npc-wave view:nth-child(4),
.npc-wave view:nth-child(8) { height: 54rpx; }
.npc-wave view:nth-child(5),
.npc-wave view:nth-child(7) { height: 46rpx; }
.npc-wave view:nth-child(6) { height: 62rpx; }
.npc-voice-mode--listening .npc-wave view:nth-child(2n) { transform: scaleY(.52); }
.npc-voice-mode--listening .npc-wave view:nth-child(3n) { transform: scaleY(.72); }
.npc-voice-hold {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-width: 100%;
  max-width: none;
  align-self: stretch;
  height: 104rpx; /* ds-ok: reference Voice Mode 底部大按钮高度 */
  margin-top: var(--cy-space-2);
  padding: 0;
  border: 0;
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-text-primary);
  color: var(--cy-color-text-inverse);
  font-size: var(--cy-type-body);
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}
.npc-voice-hold::after { border: 0; }
.npc-voice-hold--active { transform: scale(.98); }
.npc-voice-hold[disabled] { opacity: .58; color: var(--cy-color-text-inverse); }
/* 录完确认是录音卡里的一段(L09 统一版式),不再自带第二层卡片底 */
.npc-voice-complete {
  padding: var(--cy-space-4) 0;
  text-align: center;
}
.npc-voice-complete__title {
  display: block;
  margin-bottom: var(--cy-space-1);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-card-title);
  font-weight: 700;
}
/* ds-ok: native canvas needs a radius on its own surface. */
.npc-canvas,.npc-preview image { border-radius:46rpx; } /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
.npc-tile-canvas { border-radius:23rpx; display:block; height:148rpx; } /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
.npc-option { display:flex; flex-direction:column; gap:6rpx; min-width:0; text-align:center; }
.npc-tile { width:100%; height:156rpx; flex-shrink:0; }
.npc-tile-name { font-size:21rpx;line-height:31rpx;color:var(--cy-color-text-tertiary); } /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
.npc-voice { min-height:680rpx; }

/* 2026-10-27 业主 M-28:首次进入的说明卡 + 性格三选一 chip */
.npc-intro { display: flex; flex-direction: column; gap: 12rpx; padding: 31rpx; } /* ds-ok: 沿用 design.wxss 卡内距口径 */
.npc-intro__title { font-size: var(--cy-type-body); font-weight: 700; color: var(--cy-color-text-primary); }
.npc-intro__text { font-size: var(--cy-type-label); line-height: 1.6; color: var(--cy-color-text-secondary); }
.npc-intro__ok { align-self: flex-end; min-width: 44px; min-height: 44px; display: flex; align-items: center; justify-content: flex-end; font-size: var(--cy-type-label); font-weight: 600; color: var(--cy-color-text-primary); }

/* 走查 v2 R12:首次四步介绍 */
.ni { display: flex; flex-direction: column; align-items: center; padding: var(--cy-space-4) var(--cy-space-5) var(--cy-space-5); }
.ni-stage { position: relative; width: 100%; height: 360rpx; }
.ni-glow { position: absolute; left: 50%; top: 50%; width: 360rpx; height: 360rpx; margin: -180rpx 0 0 -180rpx; border-radius: 50%; transition: background 0.5s; }
.ni-glow--0 { background: radial-gradient(circle, rgba(165, 166, 232, 0.5), rgba(255, 255, 255, 0) 65%); } /* ds-ok: 光晕按定稿原型 */
/* W2-16:六块积木叠在同一个 logo 框里,按步换 transform(数值 = 原型 176px 的 px ×2 rpx);第 3、4 步归位 */
.ni-logo { position: absolute; left: 50%; top: 50%; width: 352rpx; height: 352rpx; margin: -176rpx 0 0 -176rpx; }
.ni-lp { position: absolute; left: 0; top: 0; width: 352rpx; height: 352rpx; transition: transform 0.55s cubic-bezier(0.3, 1.3, 0.45, 1); }
.ni-stage--s0 .ni-lp--l { transform: translate(-52rpx, 28rpx) rotate(-24deg); }
.ni-stage--s0 .ni-lp--t { transform: translate(44rpx, -60rpx) rotate(16deg); }
.ni-stage--s0 .ni-lp--b { transform: translate(56rpx, 60rpx) rotate(-14deg); }
.ni-stage--s0 .ni-lp--i1 { transform: translate(36rpx, -92rpx) rotate(38deg); }
.ni-stage--s0 .ni-lp--i2 { transform: translate(-76rpx, -60rpx) rotate(-30deg); }
.ni-stage--s0 .ni-lp--i3 { transform: translate(80rpx, -12rpx) rotate(26deg); }
.ni-stage--s1 .ni-lp--l { transform: translate(-20rpx, 8rpx) rotate(-8deg); }
.ni-stage--s1 .ni-lp--t { transform: translate(16rpx, -24rpx) rotate(6deg); }
.ni-stage--s1 .ni-lp--b { transform: translate(20rpx, 24rpx) rotate(-5deg); }
.ni-stage--s1 .ni-lp--i1 { transform: translate(12rpx, -32rpx) rotate(12deg); }
.ni-stage--s1 .ni-lp--i2 { transform: translate(-28rpx, -16rpx) rotate(-10deg); }
.ni-stage--s1 .ni-lp--i3 { transform: translate(28rpx, 4rpx) rotate(8deg); }
.ni-hi { position: absolute; right: 24rpx; top: 36rpx; min-width: 88rpx; height: 56rpx; padding: 0 20rpx; border-radius: var(--cy-radius-pill); background: var(--cy-btn-solid-bg); color: var(--cy-btn-solid-fg); font-size: var(--cy-font-label); font-weight: 700; display: flex; align-items: center; justify-content: center; opacity: 0; transform: scale(0.2); transform-origin: left bottom; transition: transform 0.4s cubic-bezier(0.3, 1.5, 0.45, 1), opacity 0.25s; }
.ni-stage--s3 .ni-hi { opacity: 1; transform: scale(1); }
@media (prefers-reduced-motion: reduce) { .ni-lp, .ni-hi { transition: none; } }
.ni-t { margin-top: var(--cy-space-3); font-size: var(--cy-type-sheet-title); font-weight: 700; color: var(--cy-text-title); text-align: center; }
.ni-s { margin-top: var(--cy-space-2); font-size: var(--cy-font-label); color: var(--cy-text-secondary); text-align: center; line-height: 1.5; }
.ni-dots { display: flex; gap: 12rpx; margin: var(--cy-space-5) 0; }
.ni-dot { width: 36rpx; height: 12rpx; border-radius: var(--cy-radius-pill); background: var(--cy-bg-card-2); transform: scaleX(0.34); transition: transform 0.3s; }
.ni-dot--on { transform: scaleX(1); background: var(--cy-text-title); }
.ni-btn { width: 100%; height: var(--cy-btn-h); line-height: var(--cy-btn-h); border-radius: var(--cy-radius-pill); background: var(--cy-btn-solid-bg); color: var(--cy-btn-solid-fg); text-align: center; font-size: var(--cy-font-body); font-weight: 700; }
