<!-- owner 2026-10-22:经营时间改为底部 cy-sheet(原 cy-dropdown 往下展开会冲出屏幕、裁掉时间轮)。
     组件挂在页面根(scroll-view 外),由页面的「经营时间」行调用 open()。 -->
<cy-sheet
  show="{{visible}}"
  title="经营时间"
  bind:close="close"
  mask-closable="{{!saving}}"
  closable="{{!saving}}"
>
  <view class="hours-panel">
    <text class="hours-label">营业日</text>
    <view class="hours-days">
      <view
        wx:for="{{draft.days}}"
        wx:key="label"
        data-index="{{index}}"
        class="hours-day"
        bindtap="toggleDay"
        aria-role="checkbox"
        aria-checked="{{item.on}}"
        aria-label="周{{item.label}}"
        hover-class="cy-pressed"
      >
        <text class="hours-day-dot {{item.on ? 'hours-on' : ''}}">{{item.label}}</text>
      </view>
    </view>
    <view class="hours-pair">
      <view class="hours-half">
        <text class="hours-label">开始时间</text>
        <view
          class="hours-value {{timePart === 'start' ? 'hours-value--active' : ''}}"
          bindtap="openStart"
          aria-role="button"
          aria-label="开始时间 {{draft.start}}"
          hover-class="cy-pressed"
        >{{draft.start}}</view>
      </view>
      <view class="hours-half">
        <text class="hours-label">结束时间</text>
        <view
          class="hours-value {{timePart === 'end' ? 'hours-value--active' : ''}}"
          bindtap="openEnd"
          aria-role="button"
          aria-label="结束时间 {{draft.end}}"
          hover-class="cy-pressed"
        >{{draft.end}}</view>
      </view>
    </view>
    <!-- 时间轮就地展开在 sheet 内(不再叠第二层下拉),选完分钟自动收起 -->
    <view wx:if="{{timePart}}" class="hours-columns">
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="hours-column" scroll-top="{{hourIndex * 44}}">
        <view
          wx:for="{{hours}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="pickHour"
          class="hours-option {{index === hourIndex ? 'hours-on' : ''}}"
          aria-role="button"
          aria-label="{{item}}时"
          hover-class="cy-pressed"
        >
          {{item}}
        </view>
      </scroll-view>
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="hours-column" scroll-top="{{minuteIndex * 44}}">
        <view
          wx:for="{{minutes}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="pickMinute"
          class="hours-option {{index === minuteIndex ? 'hours-on' : ''}}"
          aria-role="button"
          aria-label="{{item}}分"
          hover-class="cy-pressed"
        >
          {{item}}
        </view>
      </scroll-view>
    </view>
    <text class="hours-label">
      {{draft.end < draft.start ? '结束时间为次日，按选中的营业日生效' : '时间按上方选中的营业日生效'}}
    </text>
    <cy-inline-error kind="error" wx:if="{{localError || error}}" title="暂未完成" sub="{{localError || error}}" />
    <cy-btn bindtap="save" loading="{{saving}}">保存</cy-btn>
  </view>
</cy-sheet>
