@import '../../../../style/merchant-light.wxss';

/* 2026-10-22 owner 改版(原型 claude.ai/artifact/62EvqfcPMKAb4bas73MfNi v5):
   页头改工作台同款问候区;主卡 = 大数字 + 环比 + 7/30/90 天逐日格 + 三指标 + 淡紫核销进度;
   新增到店时段柱、客源主题排行;推荐主题横滑卡 → 形变详情弹层。
   配色:灰底白卡、近黑强调;淡紫只留在主卡分段进度与回头客段(owner:紫色多了像 AI 生成)。
   不放声音、不震动,反馈只靠画面动效。 */
.page {
  min-height: 100vh;
  background: var(--cy-bg-page);

  --mi-ink:       #1C1C1E; /* ds-ok 近黑强调:进度、最高柱、新客段、主题按钮 */
  --mi-ink-2:     #3A3A3C; /* ds-ok 最高柱斜纹第二色 */
  --mi-lavender:  #A5A6E8; /* ds-ok 稿 淡紫:主卡分段进度 / 回头客段(唯一彩色) */
  --mi-grey-1:    #DCDDE2; /* ds-ok 逐日格 1 档 / 普通柱 */
  --mi-grey-2:    #A8A9B0; /* ds-ok 逐日格 2 档 */
  --mi-off:       #EDEDF2; /* ds-ok 稿 1:36 空格 / 空进度 */
  --mi-on-ink:    #FFFFFF; /* ds-ok 近黑底白字 */
  --mi-scrim:     rgba(17, 17, 17, .28); /* ds-ok 弹层遮罩 */
  --mi-scrim-press: rgba(17, 17, 17, .34); /* ds-ok 点遮罩关闭时的按压回应 */
  --mi-tag-bg:    rgba(255, 255, 255, .92); /* ds-ok 封面上的「招商中」 */
  --mi-shade:     linear-gradient(180deg, rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, .28) 62%, rgba(0, 0, 0, .74) 100%); /* ds-ok 主题卡底部渐暗 */
  --mi-cover-empty: linear-gradient(180deg, #C9CAD0 0%, #8E8F96 100%); /* ds-ok 无封面主题卡底色,保证白字可读 */
  --mi-on-cover-2: rgba(255, 255, 255, .78); /* ds-ok 封面渐变上的次要白字 */
  --mi-on-cover-3: rgba(255, 255, 255, .32); /* ds-ok 封面渐变上的分隔线 */
  --mi-down:      #C2553F; /* ds-ok 环比下降 */
  --mi-hero-num:  80rpx;   /* 稿 40px */
  --mi-metric-num: 52rpx;  /* 稿 26px */
  --mi-ease:   cubic-bezier(.2, .8, .2, 1);
  --mi-spring: cubic-bezier(.34, 1.45, .64, 1);
}

/* ===== 入场:区块从模糊依次清晰(参考视频 0:02) =====
   类切换 + transition,不新增关键帧(motion 棘轮只减不增);opacity/filter + 上浮 transform(不动 width/left/top),
   「减少动态效果」下也保留这层淡入。逐日格的弹出复用全仓 .cy-rise-in(已有 .cy-motion-reduced 兜底)。 */
.mi-in {
  opacity: 0; filter: blur(10px); transform: translateY(32rpx);
  transition: opacity 550ms var(--mi-ease), filter 550ms var(--mi-ease), transform 650ms var(--mi-spring);
}
.mi-shown .mi-in { opacity: 1; filter: none; transform: none; }
/* owner 2026-10-23:每次打开卡片都飞入。推荐主题卡从右侧依次滑入,联动商家卡自下而上。
   只在入场期(.mi-landing)带过渡和延迟;入场结束后卡片的 cy-pressed 按压回到自身节奏。
   隐藏态挂在 .mi-pre(未入场)上,入场后不再覆盖 transform,按压缩放照常生效。 */
.mi-pre .tcard { opacity: 0; transform: translateX(160rpx) scale(.96); }
.mi-pre .pcard, .mi-pre .ai-card { opacity: 0; transform: translateY(40rpx); }
.mi-landing .tcard, .mi-landing .pcard, .mi-landing .ai-card { transition: opacity 450ms var(--mi-ease), transform 750ms var(--mi-spring); }
.mi-landing .tcard:nth-child(1) { transition-delay: 360ms; }
.mi-landing .tcard:nth-child(2) { transition-delay: 440ms; }
.mi-landing .tcard:nth-child(3) { transition-delay: 520ms; }
.mi-landing .tcard:nth-child(4) { transition-delay: 600ms; }
.mi-landing .pcard { transition-delay: 480ms; }
.mi-landing .ai-card { transition-delay: 540ms; }
/* 重播复位帧:无过渡直接回到隐藏态,下一拍再整套入场 */
.mi-replay .mi-in, .mi-replay .tcard, .mi-replay .pcard, .mi-replay .ai-card, .mi-replay .bar-c, .mi-replay .bar-v,
.mi-replay .track-fill, .mi-replay .split-seg--new { transition: none; }
/* 减少动态效果:不位移,只保留淡入 */
.cy-motion-reduced .mi-in, .cy-motion-reduced.mi-pre .tcard, .cy-motion-reduced.mi-pre .pcard,
.cy-motion-reduced.mi-pre .ai-card { transform: none; }
/* 柱子/进度条只做 transform 过渡;减少动态效果时直接到位 */
.cy-motion-reduced .bar-c, .cy-motion-reduced .track-fill, .cy-motion-reduced .split-seg--new,
.cy-motion-reduced .seg-thumb, .cy-motion-reduced .ts-ghost { transition: none; }

.body {
  display: flex;
  flex-direction: column;
  gap: var(--cy-space-3);
  padding: var(--cy-space-2) var(--cy-space-4) var(--cy-space-8);
}
.card {
  padding: var(--cy-space-4);
  border-radius: var(--cy-radius-xl);
  background: var(--cy-bg-card);
}

/* ===== 问候区:同 pages/merchant/index .rv-hero-top ===== */
.greet {
  display: flex;
  align-items: center; /* M-21:问候行与头像垂直居中对齐 */
  justify-content: space-between;
  gap: var(--cy-space-3);
  padding: var(--cy-space-1) 4rpx var(--cy-space-2);
}
.greet-b { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--cy-space-1); }
.greet-line {
  font-size: 48rpx; /* ds-ok: 2026-10-30 业主 D05「招呼语字体大一点」24px */
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -1rpx;
  color: var(--cy-text-title);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.greet-tip { font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }
.gen-at { font-size: var(--cy-font-micro); color: var(--cy-text-secondary); }
.greet-avatar { flex: none; width: 112rpx; height: 112rpx; }

/* ===== 主卡 ===== */
.hero {
  display: flex;
  flex-direction: column;
  padding: var(--cy-space-4);
  border-radius: var(--cy-radius-xl);
  background: var(--cy-bg-card);
}
.hero-top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--cy-space-2); }
.hero-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.hero-k { font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }
.hero-big { display: flex; align-items: baseline; gap: var(--cy-space-1); margin-top: 8rpx; }
.hero-num {
  font-size: var(--mi-hero-num);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1rpx;
  color: var(--cy-text-title);
  font-variant-numeric: tabular-nums;
}
.hero-unit { font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-text-title); }
.hero-side { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: var(--cy-space-1); }
.delta {
  padding: 6rpx 18rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--mi-off);
  font-size: var(--cy-font-caption);
  font-weight: 600;
  color: var(--cy-text-title);
}
.delta--down { color: var(--mi-down); }
.hero-prev { font-size: var(--cy-font-micro); color: var(--cy-text-secondary); }

/* 时间窗分段:白色滑块跟随(参考 Week/Month/Year) */
.seg {
  position: relative;
  display: flex;
  margin: var(--cy-space-3-5) 0 var(--cy-space-3);
  padding: 6rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-bg-page);
}
.seg-thumb {
  position: absolute;
  top: 6rpx; bottom: 6rpx; left: 6rpx;
  width: calc((100% - 12rpx) / 3);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-bg-card);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .08); /* ds-ok 滑块浮起 */
  transition: transform 380ms var(--mi-spring);
}
.seg-btn {
  position: relative;
  flex: 1;
  min-height: 60rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
  transition: color 250ms;
}
.seg-btn--on { font-weight: 600; color: var(--cy-text-title); }

/* 逐日格:切窗口/指标时整格重建,逐列波纹弹出(参考 0:12) */
.heat { display: grid; gap: 8rpx; }
.heat-cell {
  aspect-ratio: 1;
  border-radius: var(--cy-radius-sm);
  background: var(--mi-off);
}
/* 7 天只有一排:格子与 30/90 天同大(15 列的格宽),两端对齐轴上的起止日期 */
.heat--week { display: flex; justify-content: space-between; }
.heat--week .heat-cell { width: calc((100% - 112rpx) / 15); }
.heat-cell--l1 { background: var(--mi-grey-1); }
.heat-cell--l2 { background: var(--mi-grey-2); }
.heat-cell--l3 { background: var(--mi-ink); }
.heat-ax {
  display: flex; justify-content: space-between;
  margin-top: var(--cy-space-1-5);
  font-size: var(--cy-font-micro);
  color: var(--cy-text-secondary);
}

.trio { display: flex; gap: var(--cy-space-2); margin-top: var(--cy-space-3-5); }
.trio-cell {
  flex: 1;
  min-width: 0;
  display: flex; flex-direction: column; gap: 4rpx;
  padding: var(--cy-space-2) var(--cy-space-2-5);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-page);
  transition: box-shadow 200ms;
}
.trio-cell--on { box-shadow: inset 0 0 0 3rpx var(--mi-ink); }
.trio-k { font-size: var(--cy-font-micro); color: var(--cy-text-secondary); }
.trio-v { font-size: 40rpx; /* ds-ok 稿 20px */ font-weight: 700; color: var(--cy-text-title); font-variant-numeric: tabular-nums; }

/* 淡紫分段进度(稿 1:27,保留为本页唯一彩色) */
.seg-row { display: flex; }
.seg-row--value { gap: 10rpx; margin-top: var(--cy-space-3-5); }
.seg-pip { flex: 1; height: 32rpx; border-radius: var(--cy-radius-sm); background: var(--mi-off); }
.seg-pip { transition: background-color 300ms var(--mi-ease); }
.mi-shown .seg-pip--on { background: var(--mi-lavender); }
.value-delta {
  margin-top: var(--cy-space-2);
  text-align: center;
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}

/* ===== 区头 ===== */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--cy-space-2);
}
.sec-title { font-size: var(--cy-font-body); font-weight: 700; color: var(--cy-text-title); }
.sec-note { font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }
.sec-link { display: flex; align-items: center; gap: 4rpx; min-height: 88rpx; margin: -22rpx 0; /* 88 命中区,负边距不撑高区头 */ font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }

/* ===== 到店时段柱:从底部弹起(参考 0:08) ===== */
.bars { display: flex; align-items: flex-end; gap: var(--cy-space-3); height: 300rpx; padding-top: 44rpx; }
.bar { flex: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.bar-v {
  margin-bottom: 10rpx;
  font-size: var(--cy-font-micro);
  color: var(--cy-text-secondary);
  opacity: 0;
  transition: opacity 300ms 350ms;
}
.bar-c {
  width: 100%;
  max-width: 112rpx;
  border-radius: var(--cy-radius-lg);
  background: var(--mi-grey-1);
  transform-origin: bottom;
  transform: scaleY(0);
  transition: transform 700ms var(--mi-spring);
}
.bar--max .bar-c { background: repeating-linear-gradient(135deg, var(--mi-ink) 0 10rpx, var(--mi-ink-2) 10rpx 20rpx); }
.bar--max .bar-v { font-weight: 700; color: var(--cy-text-title); }
.grown .bar-c { transform: scaleY(1); }
.grown .bar-v { opacity: 1; }
.bar:nth-child(2) .bar-c { transition-delay: 40ms; }
.bar:nth-child(3) .bar-c { transition-delay: 80ms; }
.bar:nth-child(4) .bar-c { transition-delay: 120ms; }
.bar-ax { display: flex; gap: var(--cy-space-3); margin-top: var(--cy-space-2); }
.bar-ax text { flex: 1; text-align: center; font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }
.card-foot {
  display: flex; justify-content: space-between;
  margin-top: var(--cy-space-3);
  padding-top: var(--cy-space-3);
  border-top: 2rpx solid var(--mi-off);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}

/* ===== 核销率 / 复购率 ===== */
.metric-row { display: flex; gap: var(--cy-space-3); }
.metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--cy-space-2);
  padding: var(--cy-space-3-5);
  border-radius: var(--cy-radius-xl);
  background: var(--cy-bg-card);
}
.metric-name { font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }
.metric-num { font-size: var(--mi-metric-num); font-weight: 700; line-height: 1.15; color: var(--cy-text-title); font-variant-numeric: tabular-nums; }
.metric-sub { font-size: var(--cy-font-micro); color: var(--cy-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* CU-M-46/M-84:口径行 —— 不截断(截掉的正是分子分母那句),允许折两行。 */
.metric-scope { font-size: var(--cy-font-micro); line-height: 1.4; color: var(--cy-text-secondary); }

.track { height: 12rpx; border-radius: var(--cy-radius-pill); background: var(--mi-off); overflow: hidden; }
.track--thin { height: 8rpx; margin-top: var(--cy-space-2); }
.track-fill {
  height: 100%;
  border-radius: var(--cy-radius-pill);
  background: var(--mi-ink);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 900ms var(--mi-ease) 200ms;
}
.grown .track-fill { transform: scaleX(1); }

/* ===== 新客 vs 回头客 ===== */
.split-head { display: flex; justify-content: space-between; }
.split-k { font-size: var(--cy-font-caption); font-weight: 600; color: var(--cy-text-title); }
.split-k--ret { color: var(--cy-text-secondary); }
.split-bar {
  display: flex;
  margin-top: var(--cy-space-2);
  height: 20rpx;
  border-radius: var(--cy-radius-pill);
  overflow: hidden;
  background: var(--mi-lavender);
}
.split-seg--new {
  background: var(--mi-ink);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 900ms var(--mi-ease) 150ms;
}
.grown .split-seg--new { transform: scaleX(1); }
.split-scope { display: block; margin-top: var(--cy-space-2); font-size: var(--cy-font-micro); line-height: 1.4; color: var(--cy-text-secondary); }

/* ===== 客源主题 ===== */
.rows { display: flex; flex-direction: column; padding-top: var(--cy-space-1); padding-bottom: var(--cy-space-1); }
.src-row { display: flex; align-items: center; gap: var(--cy-space-3); padding: var(--cy-space-2-5) 0; }
.src-row + .src-row { border-top: 2rpx solid var(--mi-off); }
.src-ico {
  flex: none;
  width: 80rpx; height: 80rpx;
  border-radius: var(--cy-radius-lg);
  display: flex; align-items: center; justify-content: center;
  background: var(--cy-bg-page);
  font-size: var(--cy-font-label);
  font-weight: 700;
  color: var(--cy-text-title);
}
.src-body { flex: 1; min-width: 0; }
.src-top { display: flex; justify-content: space-between; gap: var(--cy-space-2); }
.src-name { flex: 1; min-width: 0; font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-text-title); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.src-count { flex: none; font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }
.src-pct { display: block; margin-top: 6rpx; text-align: right; font-size: var(--cy-font-micro); color: var(--cy-text-secondary); }

/* ===== 最近到店玩家:一人一张白卡,无竖线 ===== */
.visitor {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2-5);
  padding: var(--cy-space-3) var(--cy-space-3-5);
  border-radius: var(--cy-radius-xl);
  background: var(--cy-bg-card);
}
.visitor-avatar { width: 72rpx; height: 72rpx; border-radius: var(--cy-radius-pill); background: var(--cy-bg-page); flex: none; }
.visitor-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.visitor-name { font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-text-title); }
.visitor-meta { font-size: var(--cy-font-caption); color: var(--cy-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.visitor-time { flex: none; align-self: flex-end; font-size: var(--cy-font-micro); color: var(--cy-text-secondary); }

/* ===== 推荐主题横滑卡(参考 Projects) ===== */
.tscroll { margin: 0 calc(-1 * var(--cy-space-4)); width: auto; white-space: nowrap; }
.trow { display: inline-flex; gap: var(--cy-space-3); padding: 0 var(--cy-space-4) 8rpx; }
/* 主题卡:封面铺满,底部渐暗,标题/理由/日期主办/按钮压在渐变上(owner 参考人物卡)。
   2026-10-23 业主复审:太高、不要白边 ⇒ 改横版(约 16:9,620×340rpx),去掉白色外框,封面自己带圆角与投影;
   横滑时右侧仍露出下一张一截。 */
.tcard {
  flex: none;
  width: 620rpx;
  display: inline-flex;
  flex-direction: column;
  border-radius: var(--cy-radius-xl);
  box-shadow: var(--cy-shadow-card);
  white-space: normal;
  vertical-align: top;
}
.tcard-cover {
  position: relative; height: 340rpx;
  border-radius: var(--cy-radius-xl); overflow: hidden;
  background: var(--mi-cover-empty);
}
.tcard-img { width: 100%; height: 100%; display: block; }
.tcard-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: var(--mi-shade); }
/* 2026-10-23 业主:卡面只剩标题+描述后,「看看」独占一行会在文字下方留出一截空白。
   改为两列:左列标题 / 描述贴底,右列「看看」与描述行底对齐,文字整体落到卡底。 */
.tcard-over {
  position: absolute; left: 0; right: 0; bottom: 0;
  display: grid; grid-template-columns: minmax(0, 1fr) auto;
  column-gap: var(--cy-space-3); row-gap: var(--cy-space-1);
  align-items: end;
  padding: var(--cy-space-3);
}
.tcard-title { grid-column: 1; grid-row: 1; display: flex; align-items: center; gap: var(--cy-space-2); min-width: 0; }
.tcard-name {
  flex: 0 1 auto; min-width: 0;
  font-size: var(--cy-font-subtitle); font-weight: 700; color: var(--mi-on-ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tcard-tag {
  flex: none;
  padding: 4rpx var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--mi-tag-bg);
  font-size: var(--cy-font-micro); font-weight: 600; color: var(--cy-text-title);
}
.tcard-reason {
  grid-column: 1; grid-row: 2;
  font-size: var(--cy-font-caption); line-height: 1.45; color: var(--mi-on-cover-2);
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; /* 横版只留一行 */
}
.tcard-foot { grid-column: 2; grid-row: 1 / span 2; display: flex; align-items: flex-end; }
.tcard-cta {
  flex: none;
  padding: 16rpx var(--cy-space-4);
  border-radius: var(--cy-radius-pill);
  background: var(--mi-ink);
  font-size: var(--cy-font-caption); font-weight: 600; color: var(--mi-on-ink);
}

/* ===== 推荐联动商家 ===== */
.pcard {
  display: flex;
  align-items: center;
  gap: var(--cy-space-3);
  padding: var(--cy-space-3-5);
  border-radius: var(--cy-radius-xl);
  background: var(--cy-bg-card);
}
.pcard-logo { flex: none; width: 96rpx; height: 96rpx; border-radius: var(--cy-radius-pill); background: var(--mi-ink); }
.pcard-logo--text { display: flex; align-items: center; justify-content: center; font-size: var(--cy-font-subtitle); font-weight: 700; color: var(--mi-on-ink); }
.pcard-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.pcard-head { display: flex; align-items: center; gap: var(--cy-space-2); }
.pcard-name { flex: 1; min-width: 0; font-size: var(--cy-font-label); font-weight: 700; color: var(--cy-text-title); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pcard-meta { flex: none; font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }
.pcard-reason { font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }
.pcard-link { display: flex; align-items: center; gap: 4rpx; font-size: var(--cy-font-caption); font-weight: 600; color: var(--cy-text-title); }

/* ===== 经营解读 ===== */
.ai-card {
  display: flex;
  flex-direction: column;
  padding: var(--cy-space-4);
  border-radius: var(--cy-radius-xl);
  background: var(--cy-bg-card);
}
.ai-lowsample {
  align-self: flex-start;
  display: inline-block;
  margin-bottom: var(--cy-space-2);
  padding: 6rpx var(--cy-space-2-5);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-bg-page);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}
.ai-summary { display: block; font-size: var(--cy-font-label); line-height: 1.65; color: var(--cy-text-title); }
.ai-op {
  display: flex;
  gap: var(--cy-space-2);
  margin-top: var(--cy-space-2-5);
  padding: var(--cy-space-2-5) var(--cy-space-3);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-page);
}
.ai-op-k { flex: none; font-size: var(--cy-font-caption); font-weight: 700; color: var(--cy-text-title); }
.ai-op-txt { flex: 1; font-size: var(--cy-font-caption); line-height: 1.6; color: var(--cy-text-secondary); }
.ai-source { display: block; margin-top: var(--cy-space-2-5); font-size: var(--cy-font-caption); line-height: 1.5; color: var(--cy-text-secondary); }
.ai-card--down { text-align: center; }
.ai-down-title { display: block; font-size: var(--cy-font-body); font-weight: 700; color: var(--cy-text-title); }
.ai-down-txt { font-size: var(--cy-font-label); color: var(--cy-text-secondary); }
.ai-down-action {
  min-height: var(--cy-btn-h);
  margin-top: var(--cy-space-3);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-btn-solid-bg);
  color: var(--cy-btn-solid-fg);
  font-size: var(--cy-font-label);
  font-weight: 600;
}

/* ===== 推荐主题详情弹层:卡片原位形变(参考 0:33 + 按钮变弹层) ===== */
.ts-scrim {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 900;
  background: var(--mi-scrim);
  opacity: 0;
  transition: opacity 300ms ease;
}
.ts-scrim--on { opacity: 1; }
.ts-scrim--press { background: var(--mi-scrim-press); }
/* FLIP:位置尺寸固定在弹层终点,只过渡 transform(合成层),不动 left/top/width/height */
.ts-ghost {
  position: fixed;
  z-index: 901;
  background: var(--cy-bg-card);
  transform-origin: 0 0;
  transition: transform 430ms var(--mi-spring), border-radius 430ms var(--mi-ease);
}
.ts-sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  z-index: 902;
  padding: var(--cy-space-2) var(--cy-space-4) calc(var(--cy-space-6) + env(safe-area-inset-bottom));
  border-radius: var(--cy-radius-2xl) var(--cy-radius-2xl) 0 0;
  background: var(--cy-bg-card);
  box-sizing: border-box;
  /* 2026-10-23 弹层三档:贴内容高,上限 full(80%)且不越过胶囊 */
  max-height: min(var(--cy-comp-sheet-full), var(--cy-comp-sheet-max-height)); overflow-y: auto;
}
/* measure:先按最终尺寸排版但不可见,量完位置交给 ghost 形变;open 后内容由模糊转清晰 */
.ts-sheet--measure { visibility: hidden; }
.ts-sheet > view, .ts-sheet > text { opacity: 0; filter: blur(8px); transition: opacity 420ms var(--mi-ease), filter 420ms var(--mi-ease); }
.ts-sheet--open > view, .ts-sheet--open > text { opacity: 1; filter: none; }
.ts-sheet { transition: opacity 220ms ease-in, filter 220ms ease-in; }
.ts-sheet--closing { opacity: 0; filter: blur(8px); }
.ts-grab { width: 72rpx; height: 10rpx; margin: 0 auto var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--mi-grey-1); }
.ts-head { display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-2); }
.ts-title { flex: 1; min-width: 0; font-size: var(--cy-font-subtitle); font-weight: 700; color: var(--cy-text-title); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ts-close {
  position: relative;
  flex: none;
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-bg-page);
  color: var(--cy-text-title);
}
/* 64rpx 圆钮,透明 ::after 把命中区撑到 88rpx(44px) */
.ts-close::after { content: ''; position: absolute; left: -12rpx; top: -12rpx; width: 88rpx; height: 88rpx; }
.ts-cover { position: relative; height: 300rpx; margin: var(--cy-space-3) 0; border-radius: var(--cy-radius-lg); overflow: hidden; background: var(--mi-grey-1); }
.ts-img { position: absolute; left: 0; top: 0; }
.ts-cover .tcard-tag { position: absolute; left: var(--cy-space-2); top: var(--cy-space-2); }
.ts-reason { display: block; font-size: var(--cy-font-label); line-height: 1.55; color: var(--cy-text-title); }
.ts-kv {
  display: flex; justify-content: space-between; gap: var(--cy-space-3);
  margin-top: var(--cy-space-3);
  padding: var(--cy-space-3);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-page);
  font-size: var(--cy-font-caption);
}
.ts-k { flex: none; color: var(--cy-text-secondary); }
.ts-v { flex: 1; min-width: 0; text-align: right; font-weight: 600; color: var(--cy-text-title); }
.ts-btns { display: flex; gap: var(--cy-space-2-5); margin-top: var(--cy-space-4); }
.ts-btn {
  flex: 1;
  min-height: var(--cy-btn-h);
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-btn-solid-bg);
  color: var(--cy-btn-solid-fg);
  font-size: var(--cy-font-label);
  font-weight: 600;
}
.ts-btn--ghost { flex: 0 0 38%; background: var(--cy-bg-page); color: var(--cy-text-title); }


/* 走查 v2 R11:经营解读横滑卡(机会绿、问题橙),点阵装饰用 radial-gradient 平铺 */
.ai-row { margin: 0 calc(-1 * var(--cy-page-x)); width: auto; white-space: nowrap; }
.ai-track { display: flex; gap: var(--cy-space-3); padding: 0 var(--cy-page-x) var(--cy-space-3); }
.ai-pc { flex: none; width: 496rpx; border-radius: var(--cy-radius-2xl); overflow: hidden; white-space: normal; display: flex; flex-direction: column; padding-bottom: var(--cy-space-5); }
.ai-pc--op { background: #DDF3E6; color: #14532D; } /* ds-ok: 机会卡配色,按业主定稿原型 */
.ai-pc--pb { background: #FFE9D6; color: #6B2F05; } /* ds-ok: 问题卡配色,按业主定稿原型 */
.ai-pc-art { height: 200rpx; background-size: 22rpx 22rpx; } /* ds-ok: 点阵装饰 */
.ai-pc--op .ai-pc-art { background-image: radial-gradient(circle, rgba(34, 165, 91, 0.55) 4rpx, transparent 5rpx); } /* ds-ok: 同上 */
.ai-pc--pb .ai-pc-art { background-image: radial-gradient(circle, rgba(240, 122, 26, 0.55) 4rpx, transparent 5rpx); } /* ds-ok: 同上 */
.ai-pc-tag { align-self: flex-start; margin: var(--cy-space-4) var(--cy-space-5) 0; padding: 4rpx 18rpx; border-radius: var(--cy-radius-pill); font-size: var(--cy-font-caption); font-weight: 700; color: #fff; } /* ds-ok: 同上 */
.ai-pc--op .ai-pc-tag { background: #14532D; } /* ds-ok: 同上 */
.ai-pc--pb .ai-pc-tag { background: #6B2F05; } /* ds-ok: 同上 */
.ai-pc-txt { margin: var(--cy-space-3) var(--cy-space-5) 0; font-size: var(--cy-font-body); line-height: 1.55; font-weight: 600; }
.ai-note { display: block; }
