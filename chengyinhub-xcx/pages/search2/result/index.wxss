@charset "UTF-8";
/* 2026-07-31:根链改 flex column + min-height:100vh,让空态/错误态 fill 变体能在
   "标题下方到屏幕底部"这段剩余空间里居中(不是整屏居中,也不是 min-height:60vh 拍脑袋值)。 */
page { display: flex; flex-direction: column; min-height: 100vh; }
.search2-result { display: flex; flex-direction: column; flex: 1; }
.result-nav-spacer { flex: none; }
.result-search { display: block; margin: 0 var(--cy-page-x); }
.search2-result .main { padding: 0 var(--cy-page-x); display: flex; flex-direction: column; flex: 1; }
.search2-result .wp { display: flex; flex-direction: column; flex: 1; }
/* cy-empty/cy-error 是 styleIsolation:isolated 组件,宿主标签默认 display:block,
   组件内部的 flex:1 要宿主自己也是 flex 容器才生效,从页面外部补一层。 */
.fill-slot{ display: flex !important; flex-direction: column !important; flex: 1 !important; min-height: 0 !important; }

.result-tabs { width: 100%; margin-top: var(--cy-space-3); }
.result-list { display: flex; flex-direction: column; gap: var(--cy-space-3); margin-top: var(--cy-space-3); padding-bottom: var(--cy-space-8); }
.result-card {
  min-height: 152rpx;
  display: flex;
  align-items: center;
  gap: var(--cy-space-3);
  padding: var(--cy-space-3);
  border: 1rpx solid var(--cy-color-border-strong);
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface);
  box-sizing: border-box;
}
.result-card__cover { flex: none; width: 120rpx; height: 120rpx; border-radius: var(--cy-radius-sm); background: var(--cy-color-bg-surface-subtle); }
.result-card__cover--fallback { display: flex; align-items: center; justify-content: center; color: var(--cy-color-text-tertiary); }
.result-card__body { flex: 1; min-width: 0; }
.result-card__type { color: var(--cy-color-text-secondary); font-size: var(--cy-type-micro); line-height: 1.2; }
.result-card__title { margin-top: var(--cy-legacy-4); color: var(--cy-color-text-primary); font-size: var(--cy-type-card-title); font-weight: 600; }
.result-card__detail { margin-top: var(--cy-legacy-6); color: var(--cy-color-text-tertiary); font-size: var(--cy-type-caption); }
.result-card__tags { display: flex; gap: var(--cy-space-1); margin-top: var(--cy-space-2); overflow: hidden; }
.result-card__tag { flex: none; max-width: 150rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 2rpx var(--cy-space-2); /* ds-ok: 2rpx 是像素级微调,让 micro 字号在药丸标签里视觉居中,不是布局间距 */ border-radius: var(--cy-radius-pill); background: var(--cy-color-bg-surface-subtle); color: var(--cy-color-text-secondary); font-size: var(--cy-type-micro); }
.result-card__arrow { flex: none; color: var(--cy-color-text-tertiary); }

/* 主题沿用主题流的海报信息层级；字段仍只取搜索接口已有的封面、标题、地点与分类。 */
.topic-result-card { overflow: hidden; border: 1rpx solid var(--cy-color-border-strong); border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-surface); }
.topic-result-card__media { position: relative; height: 360rpx; overflow: hidden; background: var(--cy-color-bg-surface-subtle); }
.topic-result-card__cover { width: 100%; height: 100%; }
.topic-result-card__fallback { display: flex; align-items: center; justify-content: center; color: var(--cy-color-text-tertiary); }
.topic-result-card__shade { position: absolute; inset: 0; background: var(--cy-comp-cover-scrim); }
.topic-result-card__kind { position: absolute; left: var(--cy-space-3); bottom: var(--cy-space-3); min-height: 48rpx; display: flex; align-items: center; padding: 0 var(--cy-space-2); border-radius: var(--cy-radius-pill); background: var(--cy-color-overlay); color: var(--cy-color-text-inverse); font-size: var(--cy-type-micro); }
.topic-result-card__body { padding: var(--cy-space-3); }
.topic-result-card__title { color: var(--cy-color-text-primary); font-size: var(--cy-type-card-title); line-height: var(--cy-leading-tight); font-weight: 700; }
.topic-result-card__detail { margin-top: var(--cy-space-1); color: var(--cy-color-text-tertiary); font-size: var(--cy-type-caption); }

/* pm20 */
/* 2026-10-23 页面动效(utils/page-motion.js):容器 --pm-* 置 1 时先隐着,再依次浮上来;静止时无过渡,按压反馈不受影响;减少动态效果时从不触发 */
.result-list > view { filter: opacity(calc(1 - var(--pm-l, 0))); translate: 0 calc(var(--pm-l, 0) * 31rpx); transition: filter var(--pm-l-d, 0s) ease, translate var(--pm-l-d, 0s) cubic-bezier(.2,.82,.2,1), transform var(--cy-motion-press) var(--cy-ease-out), opacity var(--cy-motion-press) var(--cy-ease-out); transition-delay: calc(var(--pm-l-s, 0) * 0ms), calc(var(--pm-l-s, 0) * 0ms), 0s, 0s; }
.result-list > view:nth-child(2) { transition-delay: calc(var(--pm-l-s, 0) * 30ms), calc(var(--pm-l-s, 0) * 30ms), 0s, 0s; }
.result-list > view:nth-child(3) { transition-delay: calc(var(--pm-l-s, 0) * 60ms), calc(var(--pm-l-s, 0) * 60ms), 0s, 0s; }
.result-list > view:nth-child(4) { transition-delay: calc(var(--pm-l-s, 0) * 90ms), calc(var(--pm-l-s, 0) * 90ms), 0s, 0s; }
.result-list > view:nth-child(5) { transition-delay: calc(var(--pm-l-s, 0) * 120ms), calc(var(--pm-l-s, 0) * 120ms), 0s, 0s; }
.result-list > view:nth-child(6) { transition-delay: calc(var(--pm-l-s, 0) * 150ms), calc(var(--pm-l-s, 0) * 150ms), 0s, 0s; }
.result-list > view:nth-child(7) { transition-delay: calc(var(--pm-l-s, 0) * 180ms), calc(var(--pm-l-s, 0) * 180ms), 0s, 0s; }
.result-list > view:nth-child(8) { transition-delay: calc(var(--pm-l-s, 0) * 210ms), calc(var(--pm-l-s, 0) * 210ms), 0s, 0s; }
.result-list > view:nth-child(n+9) { transition-delay: calc(var(--pm-l-s, 0) * 240ms), calc(var(--pm-l-s, 0) * 240ms), 0s, 0s; }
/* 2026-10-22 owner:搜索里的主题/玩法模板是大卡,照抄「我的订单」卡
   (subpackageMember/components/cy/profile 的 .pc-ord-*:400rpx 高、40rpx 圆角、深灰渐变、白字、黑色胶囊),改那边要同步这里。
   卡面内是照片语境,字色固定白、按钮固定黑,不随主题翻转。 */
.tpl-big {
  position: relative; display: block; width: 100%; height: 400rpx; box-sizing: border-box; /* ds-ok: 同订单卡高度 */
  overflow: hidden; border-radius: 40rpx; /* ds-ok: 同订单卡大圆角 */
  background: linear-gradient(160deg, #5B6670 0%, #2A2F35 100%); /* ds-ok: 同订单卡无封面时的照片感底色 */
}
.tpl-big__img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; }
.tpl-big__art { position: absolute; left: 50%; top: 40%; width: 200rpx; height: 200rpx; transform: translate(-50%, -50%); } /* ds-ok: 无封面时居中放玩法具象图标 */
.tpl-big__shade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 88%;
  background: linear-gradient(180deg, rgba(48,48,48,0) 0%, rgba(48,48,48,.5) 45%, rgba(58,58,58,.85) 100%); /* ds-ok: 同订单卡下半段深灰渐变 */
}
.tpl-big__tag {
  position: absolute; left: var(--cy-space-3); top: var(--cy-space-3);
  padding: 6rpx var(--cy-space-2); border-radius: var(--cy-radius-pill);
  font-size: var(--cy-type-caption); font-weight: 700; line-height: 1.5;
  background: rgba(255,255,255,.92); color: #141414; /* ds-ok: 同订单卡浅色状态章 */
}
.tpl-big__body {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 0 var(--cy-space-4) var(--cy-space-4);
  display: flex; flex-direction: column; gap: 6rpx;
}
.tpl-big__title {
  font-size: 40rpx; font-weight: 800; color: #FFFFFF; line-height: 1.25; letter-spacing: -0.5rpx; /* ds-ok: 同订单卡白色标题 */
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tpl-big__foot { margin-top: var(--cy-space-2); display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-2); }
.tpl-big__meta { flex: 1; min-width: 0; font-size: var(--cy-type-caption); color: rgba(255,255,255,.72); line-height: 1.45; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } /* ds-ok: 同订单卡次级白 */
.tpl-big__btn {
  flex: none; height: 76rpx; line-height: 76rpx; padding: 0 var(--cy-space-4); /* ds-ok: 同订单卡胶囊按钮 */
  border-radius: var(--cy-radius-pill); font-size: var(--cy-type-body); font-weight: 700; text-align: center;
  background: #141414; color: #FFFFFF; /* ds-ok: 同订单卡黑色胶囊按钮 */
}

.content-pagination { display: flex; flex-direction: column; gap: var(--cy-space-3); padding: var(--cy-space-4) 0; color: var(--cy-color-text-secondary); }
.content-pagination button { width: 100%; color: var(--cy-color-text-primary); background: var(--cy-color-bg-surface); border: 1rpx solid var(--cy-color-border-strong); border-radius: var(--cy-radius-md); }
