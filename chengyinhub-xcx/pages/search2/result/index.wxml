<view class="theme-dark">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
<view class="search2-result" style="{{pmList === 1 ? '--pm-l:1;' : (pmList === 2 ? '--pm-l-d:.32s;--pm-l-s:1;' : '')}}">
  <cy-nav-bar />
  <view class="result-nav-spacer" style="height: {{statusBarHeight + navBarHeight}}px;"></view>
  <view class="result-search">
    <cy-search value="{{keyword}}" placeholder="搜索主题、活动、帖文、俱乐部、商家"
      loading="{{searchLoading}}" bind:input="onKeywordInput" bind:confirm="onSearchConfirm" />
  </view>

  <view class="main">
    <view class="wp">
      <cy-tabs class="result-tabs" tabs="{{resultTabs}}" active="{{activeResultType}}"
        variant="chip" bind:change="onResultTab" />

      <cy-inline-error wx:if="{{clubLoginRequired}}" title="登录后搜索内容和俱乐部" action="登录" bind:action="loginForClubs" />
      <cy-inline-error wx:elif="{{clubSearchDenied}}" title="{{clubSearchDenied}}" />

      <view wx:if="{{showSearchSkeleton && !visibleResults.length}}">
        <cy-skeleton type="feed-card" count="3" />
      </view>
      <cy-error load-failure class="fill-slot cy-fade-in" wx:elif="{{searchError && !visibleResults.length}}" fill="{{true}}" size="lg" title="没能完成搜索" sub="{{searchError}}" bind:retry="runSearch" auto-back="{{!everLoaded}}" />
      <cy-empty class="fill-slot" wx:if="{{!searchLoading && !contentLoading && !contentError && !searchError && !visibleResults.length}}" fill="{{true}}" size="lg" kind="empty" title="没有找到" sub="" />
      <view wx:if="{{contentFilterNotice}}" class="content-pagination">{{contentFilterNotice}}</view>
      <cy-inline-error wx:if="{{contentError}}" title="{{contentError}}" action="重试本页" bind:action="loadMoreContent" />
      <view class="result-list" wx:if="{{visibleResults.length}}">
        <!-- owner 10-22:每次打开都让卡片逐张飞进来(回到本页会重搜、结果重挂,自然重播) -->
        <view class="cy-fly-in" style="animation-delay: {{index < 5 ? index * 40 : 200}}ms" wx:for="{{visibleResults}}" wx:key="key">
          <view wx:if="{{item.type === 'topic'}}" class="topic-result-card" data-id="{{item.id}}" data-scene-id="{{item.sceneId}}" data-path="{{item.path}}" bindtap="goResult" aria-role="button" aria-label="查看主题：{{item.title}}" hover-class="cy-pressed" hover-stay-time="80">
            <view class="topic-result-card__media">
              <image wx:if="{{item.cover}}" class="topic-result-card__cover" src="{{item.cover}}" mode="aspectFill" />
              <view wx:else class="topic-result-card__cover topic-result-card__fallback"><cy-icon name="route" size="52" /></view>
              <view class="topic-result-card__shade"></view>
              <view class="topic-result-card__kind">主题</view>
            </view>
            <view class="topic-result-card__body">
              <view class="topic-result-card__title">{{item.title}}</view>
              <view class="topic-result-card__detail ep1">{{item.detail}}</view>
              <view class="result-card__tags" wx:if="{{item.tags.length}}">
                <text wx:for="{{item.tags}}" wx:key="index" class="result-card__tag">{{item}}</text>
              </view>
            </view>
          </view>
          <cy-merchant-card wx:elif="{{item.type === 'merchant'}}" interactive="{{true}}" aria-label="查看商家：{{item.title}}"
            data-id="{{item.id}}" data-path="{{item.path}}" bind:tap="goResult" bind:action="goResult" bind:service="goResult" service-tag="{{item.cardServiceTag}}" service-text="{{item.cardServiceText}}"
            address="{{item.cardAddress}}" available-time="{{item.cardHours}}" cover="{{item.cardCover}}" logo="{{item.cardLogo}}" name="{{item.title}}"
            city-role="{{item.cardCityRole}}" desc="{{item.cardDescription}}" status="{{item.cardStatus}}"
            tags="{{item.tags}}" category-name="{{item.cardCategoryName}}" />
          <cy-club-card wx:elif="{{item.type === 'club'}}" interactive="{{true}}" club="{{item.clubCard}}" cta="查看" aria-label="查看俱乐部：{{item.title}}"
            data-id="{{item.id}}" data-path="{{item.path}}" bind:tap="goResult" bind:action="goResult" />
          <!-- 2026-10-22 owner:搜索里的模板是大卡,和「我的订单」卡同一套(封面铺满 + 底部渐变 + 白字 + 黑色胶囊) -->
          <view wx:elif="{{item.tplRow}}" class="tpl-big" data-id="{{item.id}}" data-path="{{item.path}}" bindtap="goResult"
            hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="查看{{item.typeLabel}}：{{item.title}}">
            <image wx:if="{{item.cover}}" class="tpl-big__img" src="{{item.cover}}" mode="aspectFill" lazy-load="true" />
            <image wx:elif="{{item.art}}" class="tpl-big__art" src="{{item.art}}" mode="aspectFit" aria-hidden="true" />
            <view class="tpl-big__shade"></view>
            <view class="tpl-big__tag">{{item.typeLabel}}</view>
            <view class="tpl-big__body">
              <view class="tpl-big__title">{{item.title}}</view>
              <view class="tpl-big__foot">
                <view class="tpl-big__meta">{{item.detail}}</view>
                <view class="tpl-big__btn">查看</view>
              </view>
            </view>
          </view>
          <view wx:else class="result-card" data-id="{{item.id}}" data-scene-id="{{item.sceneId}}" data-path="{{item.path}}" bindtap="goResult" hover-class="cy-pressed" hover-stay-time="80">
            <image wx:if="{{item.cover}}" class="result-card__cover" src="{{item.cover}}" mode="aspectFill" />
            <view wx:else class="result-card__cover result-card__cover--fallback">
              <cy-icon name="{{item.icon}}" size="40" />
            </view>
            <view class="result-card__body">
              <view class="result-card__type">{{item.typeLabel}}</view>
              <view class="result-card__title ep1">{{item.title}}</view>
              <view class="result-card__detail ep1">{{item.detail}}</view>
              <view class="result-card__tags" wx:if="{{item.tags.length}}">
                <text wx:for="{{item.tags}}" wx:key="index" class="result-card__tag">{{item}}</text>
              </view>
            </view>
            <cy-icon class="result-card__arrow" name="arrow-right" size="24" />
          </view>
        </view>
      </view>
      <view wx:if="{{contentEnabled}}" class="content-pagination">
        <button wx:if="{{contentHasMore && !contentError}}" loading="{{contentLoading}}" disabled="{{contentLoading}}" bindtap="loadMoreContent">{{contentLoading ? '加载中' : '加载更多内容'}}</button>
        <text wx:elif="{{!contentHasMore}}">内容已加载完</text>
        <button bindtap="runSearch" disabled="{{searchLoading || contentLoading}}">刷新搜索结果</button>
      </view>
    </view>
  </view>
</view>
</view>
