/* 结构与色板照抄队伍页 pages/team/team.wxss(玩家深色;跨分包不能 @import):卡片、行、发丝线;选中照 cy-option-sheet 实心圆点 */
page { background: var(--cy-bg-page); }
.pp { min-height: 100vh; box-sizing: border-box; padding: 0 var(--cy-page-x) calc(var(--cy-space-6) + env(safe-area-inset-bottom)); background: var(--cy-bg-page); color: var(--cy-text-title); }
.pp-card { margin-bottom: var(--cy-space-3); padding: 0 var(--cy-space-3-5); border: 1rpx solid var(--cy-border-card); border-radius: var(--cy-radius-md); background: var(--cy-bg-card); }
.pp-row { display: flex; align-items: center; gap: var(--cy-space-2); min-height: 132rpx; padding: var(--cy-space-3) 0; box-sizing: border-box; border-bottom: 1rpx solid var(--cy-border-line); color: var(--cy-text-secondary); }
.pp-row:last-child { border-bottom: 0; }
.pp-row__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--cy-space-1); }
.pp-row__t { font-size: var(--cy-font-body); font-weight: 700; color: var(--cy-text-title); }
.pp-row__d { font-size: var(--cy-font-caption); line-height: var(--cy-leading-normal); color: var(--cy-text-secondary); }
.pp-field { padding: var(--cy-space-3) 0; border-bottom: 1rpx solid var(--cy-border-line); }
.pp-field:last-child { border-bottom: 0; }
.pp-label { display: block; margin-bottom: var(--cy-space-2); font-size: var(--cy-font-label); color: var(--cy-text-secondary); }
.pp-input { height: var(--cy-btn-h); padding: 0 var(--cy-space-3); border: 1rpx solid var(--cy-border-line); border-radius: var(--cy-radius-sm); background: var(--cy-bg-elevated); color: var(--cy-text-title); font-size: var(--cy-font-body); box-sizing: border-box; }
.pp-opts { display: flex; flex-direction: column; }
.pp-opt, .pp-ord, .pp-bin { display: flex; align-items: center; gap: var(--cy-space-2); min-height: 88rpx; }
.pp-opt + .pp-opt, .pp-ord + .pp-ord, .pp-bin + .pp-bin { border-top: 1rpx solid var(--cy-border-line); }
.pp-opt__t { flex: 1; min-width: 0; font-size: var(--cy-font-body); color: var(--cy-text-title); }
.pp-dot { flex: none; display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: var(--cy-radius-pill); box-sizing: border-box; border: 2rpx solid var(--cy-color-border-strong); }
.pp-opt.is-on .pp-dot { border-color: var(--cy-text-title); background: var(--cy-text-title); }
.pp-opt.is-on .pp-dot::after { content: ''; width: var(--cy-space-1-5); height: var(--cy-space-1-5); border-radius: var(--cy-radius-pill); background: var(--cy-bg-card); }
.pp-ord__no { flex: none; width: 40rpx; text-align: center; font-size: var(--cy-font-caption); font-weight: 700; color: var(--cy-text-secondary); }
.pp-mv { flex: none; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; color: var(--cy-text-title); }
.pp-mv.is-off { opacity: .3; }
.pp-seg { flex: none; display: flex; gap: var(--cy-space-1-5); }
.pp-seg__b { min-width: 88rpx; height: 64rpx; padding: 0 var(--cy-space-3); display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: var(--cy-radius-pill); border: 1rpx solid var(--cy-border-line); font-size: var(--cy-font-label); color: var(--cy-text-secondary); }
.pp-seg__b.is-on { border-color: var(--cy-text-title); background: var(--cy-text-title); color: var(--cy-bg-card); font-weight: 700; }
.pp-sec { margin: var(--cy-space-5) 0 var(--cy-space-2); font-size: var(--cy-font-subtitle); font-weight: 800; }
.pp-todo { display: flex; gap: var(--cy-space-2); padding: var(--cy-space-3) 0; border-bottom: 1rpx solid var(--cy-border-line); }
.pp-todo:last-child { border-bottom: 0; }
.pp-todo__no { flex: none; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%; background: var(--cy-bg-elevated); font-size: var(--cy-font-caption); font-weight: 700; }
.pp-todo__t { flex: 1; min-width: 0; font-size: var(--cy-font-label); line-height: var(--cy-leading-normal); color: var(--cy-text-body); }
.pp-err { display: block; margin-top: var(--cy-space-3); font-size: var(--cy-font-label); line-height: var(--cy-leading-normal); color: var(--cy-danger); }
.pp-actions { display: flex; gap: var(--cy-space-2); margin-top: var(--cy-space-4); }
.pp-btn { flex: none; min-width: 200rpx; min-height: var(--cy-btn-h); display: flex; align-items: center; justify-content: center; border-radius: var(--cy-radius-sm); font-size: var(--cy-font-body); font-weight: 700; box-sizing: border-box; }
.pp-btn.secondary { border: 1rpx solid var(--cy-border-line); background: var(--cy-bg-card); color: var(--cy-text-title); }
.pp-btn-main { flex: 1; }
.pp-input.is-bad { border-color: var(--cy-danger); }
.pp-miss { display: block; padding-top: var(--cy-space-1-5); font-size: var(--cy-font-label); color: var(--cy-danger); }
