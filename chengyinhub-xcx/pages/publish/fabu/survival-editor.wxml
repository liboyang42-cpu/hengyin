<!-- 恢复与配给 / 公共设施 / 结果卡编辑层（2026-10-09 协调者设计）。
     两级：分区列表 → 单项编辑（标题左侧返回箭头，同九宫格单格编辑的返回方式）。
     · 列表层「完成」= 整体保存回主题草稿；✕ = 放弃本次全部改动。
     · 单项层「完成」= 提交本项并回列表；返回箭头 = 放弃本项改动回列表；删除放在底部红卡。
     卡片、字段、下拉与彩蛋/物品编辑同一套 rt-* 与 node-card 样式。 -->
<cy-sheet show="{{survivalEditor.show}}" fixed="full" bind:close="closeSurvivalEditor" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop + 18}}px);--cy-comp-sheet-role-glass:#f3f4f5">
 <view class="rt-editor">
  <view class="node-sheet__top"><view class="node-sheet__close" bindtap="closeSurvivalEditor" aria-role="button" aria-label="关闭且不保存" hover-class="cy-pressed" hover-stay-time="80">退出</view>
   <view wx:if="{{survivalEditor.kind && survivalEditor.section !== 'card'}}" class="node-sheet__done" bindtap="commitSurvivalRow" aria-role="button" aria-label="完成此项" hover-class="cy-pressed" hover-stay-time="80">完成</view>
   <view wx:else class="node-sheet__done" bindtap="saveSurvivalEditor" aria-role="button" aria-label="保存并关闭" hover-class="cy-pressed" hover-stay-time="80">完成</view>

  </view>
  <view class="rt-title">
   <view wx:if="{{survivalEditor.kind && survivalEditor.section !== 'card'}}" bindtap="backSurvivalList" aria-role="button" aria-label="返回列表，不保存此项" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="back" size="32" /></view>
   <text>{{survivalEditor.kind === 'recoveries' ? (survivalEditor.row.kind === 'RESCUE' ? '救助' : '休整') : survivalEditor.kind === 'rations' ? '幕配给' : survivalEditor.kind === 'facilities' ? '设施' : survivalEditor.section === 'card' ? '结果卡' : survivalEditor.section === 'facility' ? '公共设施' : '恢复与配给'}}</text>
  </view>
  <cy-inline-error wx:if="{{survivalEditor.error}}" title="{{survivalEditor.error}}" />

  <!-- 分区列表：恢复与配给 -->
  <block wx:if="{{!survivalEditor.kind && survivalEditor.section === 'recovery'}}">
   <view class="node-card">
    <view class="rt-card-head"><text>休整与救助</text><view class="node-pill" data-kind="recoveries" data-index="-1" bindtap="editSurvivalRow" aria-role="button" aria-label="添加休整或救助" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" />添加</view></view>
    <view wx:for="{{survivalRecoveries}}" wx:key="index" class="node-card__row rt-list-row" data-kind="recoveries" data-index="{{index}}" bindtap="editSurvivalRow" aria-role="button" aria-label="编辑{{item.label}}" hover-class="cy-pressed" hover-stay-time="80">
     <view class="node-card__main"><text class="node-card__title">{{item.label}}</text><text class="node-card__value">{{item.summary}}</text></view>
     <cy-icon name="chevron-right" size="24" />
    </view>
    <text wx:if="{{!survivalRecoveries.length}}" class="node-card__value">还没有。{{runtimeHpLabel}}降低后，队伍可在这里设置的休整或救助中恢复。</text>
   </view>
   <view class="node-card">
    <view class="rt-card-head"><text>幕配给</text><view class="node-pill" data-kind="rations" data-index="-1" bindtap="editSurvivalRow" aria-role="button" aria-label="添加幕配给" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" />添加</view></view>
    <view wx:for="{{survivalRations}}" wx:key="index" class="node-card__row rt-list-row" data-kind="rations" data-index="{{index}}" bindtap="editSurvivalRow" aria-role="button" aria-label="编辑{{item.label}}" hover-class="cy-pressed" hover-stay-time="80">
     <view class="node-card__main"><text class="node-card__title">{{item.label}}</text><text class="node-card__value">{{item.summary}}</text></view>
     <cy-icon name="chevron-right" size="24" />
    </view>
    <text wx:if="{{!survivalRations.length}}" class="node-card__value">还没有。每幕开始时消耗物品，不足时扣{{runtimeHpLabel}}。</text>
   </view>
  </block>

  <!-- 分区列表：公共设施 -->
  <block wx:if="{{!survivalEditor.kind && survivalEditor.section === 'facility'}}">
   <view class="node-card">
    <view class="rt-card-head"><text>设施</text><view class="node-pill" data-kind="facilities" data-index="-1" bindtap="editSurvivalRow" aria-role="button" aria-label="添加设施" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" />添加</view></view>
    <view wx:for="{{survivalFacilities}}" wx:key="index">
     <view wx:if="{{item.generated}}" class="node-card__row rt-list-row" aria-label="{{item.label}}，{{item.sourceLabel}}">
      <view class="node-card__main"><text class="node-card__title">{{item.label}}</text><text class="node-card__value">{{item.sourceLabel}}</text></view>
      <view class="node-pill rt-disabled" aria-disabled="true">在节点中编辑</view>
     </view>
     <view wx:else class="node-card__row rt-list-row" data-kind="facilities" data-index="{{index}}" bindtap="editSurvivalRow" aria-role="button" aria-label="编辑{{item.label}}" hover-class="cy-pressed" hover-stay-time="80">
      <view class="node-card__main"><text class="node-card__title">{{item.label}}</text><text class="node-card__value">{{item.summary}}</text></view>
      <cy-icon name="chevron-right" size="24" />
     </view>
    </view>
    <text wx:if="{{!survivalFacilities.length}}" class="node-card__value">暂无设施</text>
   </view>
  </block>

  <!-- 单项：休整 / 救助 -->
  <block wx:if="{{survivalEditor.kind === 'recoveries'}}">
   <view class="node-card">
    <view class="rt-field"><text>恢复方式</text><cy-dropdown topic-editor range="{{survivalRecoveryKinds}}" range-key="label" value="{{survivalEditor.row.kind === 'RESCUE' ? 1 : 0}}" bind:change="pickRecoveryKind"><view class="rt-select">{{survivalEditor.row.kind === 'RESCUE' ? survivalRecoveryKinds[1].label : survivalRecoveryKinds[0].label}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
    <view class="rt-two">
     <view class="rt-field"><text>{{survivalEditor.row.kind === 'RESCUE' ? runtimeHpLabel + '恢复到' : runtimeHpLabel + '增加'}}</text><input type="number" value="{{survivalEditor.row.kind === 'RESCUE' ? survivalEditor.row.hpFloor : survivalEditor.row.hpDelta}}" data-field="{{survivalEditor.row.kind === 'RESCUE' ? 'hpFloor' : 'hpDelta'}}" bindinput="inputSurvivalField" /></view>
     <view class="rt-field"><text>最多使用次数</text><input type="number" value="{{survivalEditor.row.limit}}" data-field="limit" bindinput="inputSurvivalField" /></view>
    </view>
   </view>
   <view class="node-card">
    <view class="rt-card-head"><text>适用的幕</text><text class="rt-count">{{survivalActCheckedCount ? '已选 ' + survivalActCheckedCount : '所有幕'}}</text></view>
    <view wx:for="{{survivalActChecks}}" wx:key="value" class="node-card__row rt-check-row" data-value="{{item.value}}" bindtap="toggleRecoveryAct" aria-role="checkbox" aria-checked="{{item.checked}}" hover-class="cy-pressed" hover-stay-time="80">
     <view class="node-card__main"><text class="node-card__title">{{item.label}}</text><text wx:if="{{item.missing}}" class="node-binding__error">此幕已删除，点一下移除后重新选择</text></view>
     <view class="rt-check {{item.checked ? 'is-on' : ''}}" aria-hidden="true"><cy-icon wx:if="{{item.checked}}" name="check" size="24" /></view>
    </view>
    <text class="story-initial__example">都不选表示所有幕都可使用。</text>
   </view>
  </block>

  <!-- 单项：幕配给 -->
  <view wx:if="{{survivalEditor.kind === 'rations'}}" class="node-card">
   <view class="rt-field"><text>哪一幕</text><cy-dropdown topic-editor range="{{survivalActs}}" range-key="label" value="{{survivalSelected.actKey.index}}" data-field="actKey" data-options="survivalActs" bind:change="pickSurvivalField"><view class="rt-select">{{survivalSelected.actKey.label}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
   <view class="rt-field"><text>消耗物品</text><cy-dropdown topic-editor range="{{survivalMaterialItems}}" range-key="label" value="{{survivalSelected.itemId.index}}" data-field="itemId" data-options="survivalMaterialItems" bind:change="pickSurvivalField"><view class="rt-select">{{survivalSelected.itemId.label}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
   <view class="rt-two">
    <view class="rt-field"><text>数量</text><input type="number" value="{{survivalEditor.row.quantity}}" data-field="quantity" bindinput="inputSurvivalField" /></view>
    <view class="rt-field"><text>不足时扣{{runtimeHpLabel}}</text><input type="number" value="{{survivalEditor.row.fallbackHpCost}}" data-field="fallbackHpCost" bindinput="inputSurvivalField" /></view>
   </view>
  </view>

  <!-- 单项：设施 -->
  <block wx:if="{{survivalEditor.kind === 'facilities'}}">
   <view class="node-card">
    <view class="rt-field"><text>哪一幕</text><cy-dropdown topic-editor range="{{survivalActs}}" range-key="label" value="{{survivalSelected.actKey.index}}" data-field="actKey" data-options="survivalActs" bind:change="pickSurvivalField"><view class="rt-select">{{survivalSelected.actKey.label}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
    <view class="rt-two">
     <view class="rt-field"><text>次数按谁计</text><cy-dropdown topic-editor range="{{survivalScopes}}" range-key="label" value="{{survivalSelected.scope.index}}" data-field="scope" data-options="survivalScopes" bind:change="pickSurvivalField"><view class="rt-select">{{survivalSelected.scope.label}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
     <view class="rt-field"><text>最多使用次数</text><input type="number" value="{{survivalEditor.row.limit}}" data-field="limit" bindinput="inputSurvivalField" /></view>
    </view>
    <view class="rt-two">
     <view class="rt-field"><text>作用于</text><cy-dropdown topic-editor range="{{survivalTargets}}" range-key="label" value="{{survivalSelected.targetScope.index}}" data-field="targetScope" data-options="survivalTargets" bind:change="pickSurvivalField"><view class="rt-select">{{survivalSelected.targetScope.label}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
     <view class="rt-field"><text>{{runtimeHpLabel}}变化</text><input type="text" value="{{survivalEditor.row.hpDelta}}" placeholder="例如 2 或 -1" data-field="hpDelta" bindinput="inputSurvivalField" /></view>
    </view>
   </view>
   <view class="node-card">
    <view class="rt-field"><text>到场核验</text><cy-dropdown topic-editor range="{{survivalLocations}}" range-key="label" value="{{survivalSelected.arrivalLocationKey.index}}" data-field="arrivalLocationKey" data-options="survivalLocations" bind:change="pickSurvivalField"><view class="rt-select">{{survivalSelected.arrivalLocationKey.label}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
    <view class="rt-field"><text>操作节点</text><cy-dropdown topic-editor range="{{survivalNodes}}" range-key="label" value="{{survivalSelected.operationNodeId.index}}" data-field="operationNodeId" data-options="survivalNodes" bind:change="pickSurvivalField"><view class="rt-select">{{survivalSelected.operationNodeId.label}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
    <text wx:if="{{survivalNodes.length <= 1}}" class="story-initial__example">先保存主题与节点，才能选择操作节点。</text>
   </view>
   <view class="node-card">
    <view class="rt-card-head"><text>使用条件 · 全部满足</text><view class="node-pill" bindtap="addSurvivalCondition" aria-role="button" aria-label="添加使用条件" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" />添加</view></view>
    <view wx:for="{{survivalConditionRows}}" wx:key="index" wx:for-index="ci" class="rt-cond">
     <view class="rt-card-head rt-cond__head"><text>条件 {{ci + 1}}</text><view class="rt-delete" data-index="{{ci}}" data-field="remove" bindtap="editSurvivalCondition" aria-role="button" aria-label="移除条件 {{ci + 1}}" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
     <view class="rt-field"><cy-dropdown topic-editor range="{{survivalOps}}" range-key="label" value="{{item.opIndex}}" data-index="{{ci}}" data-field="op" data-options="survivalOps" bind:change="editSurvivalCondition"><view class="rt-select">{{item.opLabel}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
     <view wx:if="{{item.op === 'ITEM_HELD' || item.op === 'ITEM_ACQUIRED'}}" class="rt-two">
      <view class="rt-field"><cy-dropdown topic-editor range="{{survivalItems}}" range-key="label" data-index="{{ci}}" data-field="itemId" data-options="survivalItems" bind:change="editSurvivalCondition"><view class="rt-select">{{item.itemLabel}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
      <view class="rt-field rt-quantity"><input type="number" value="{{item.quantity}}" placeholder="数量" data-index="{{ci}}" data-field="quantity" bindinput="editSurvivalCondition" /></view>
     </view>
     <view wx:elif="{{item.op === 'NODE_COMPLETED'}}" class="rt-field"><cy-dropdown topic-editor range="{{survivalNodes}}" range-key="label" data-index="{{ci}}" data-field="nodeId" data-options="survivalNodes" bind:change="editSurvivalCondition"><view class="rt-select">{{item.nodeLabel}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
     <view wx:else class="rt-two">
      <view class="rt-field"><cy-dropdown topic-editor range="{{survivalStates}}" range-key="label" data-index="{{ci}}" data-field="var" data-options="survivalStates" bind:change="editSurvivalCondition"><view class="rt-select">{{item.stateLabel}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
      <view class="rt-field rt-quantity"><input type="text" value="{{item.value}}" placeholder="数值" data-index="{{ci}}" data-field="value" bindinput="editSurvivalCondition" /></view>
     </view>
    </view>
    <text wx:if="{{!survivalConditionRows.length}}" class="node-card__value">没有条件时，到场即可使用。</text>
   </view>
  </block>

  <!-- 结果卡（无列表层） -->
  <block wx:if="{{survivalEditor.section === 'card'}}">
   <view class="node-card">
    <view class="rt-photo-name">
     <view class="rt-image" bindtap="uploadSurvivalCover" aria-role="button" aria-label="{{survivalEditor.row.cover ? '更换结果卡封面' : '上传结果卡封面'}}" hover-class="cy-pressed" hover-stay-time="80"><image wx:if="{{survivalEditor.row.cover}}" src="{{survivalEditor.row.cover}}" mode="aspectFill" /><block wx:else><cy-icon name="image" size="32" /><text>上传封面</text></block></view>
     <view class="node-card__main"><text class="node-card__title">结果卡封面</text><text class="node-card__value">{{survivalEditor.row.cover ? '点图片更换' : '不上传则用主题封面'}}</text></view>
     <view wx:if="{{survivalEditor.row.cover}}" class="rt-delete" data-field="cover" bindtap="clearSurvivalField" aria-role="button" aria-label="移除结果卡封面" hover-class="cy-pressed" hover-stay-time="80">移除</view>
    </view>
   </view>
   <view class="node-card">
    <view class="rt-card-head"><text>卡片上显示</text></view>
    <view wx:for="{{survivalCardFields}}" wx:key="value" class="node-card__row rt-check-row" data-value="{{item.value}}" bindtap="toggleSurvivalCardField" aria-role="checkbox" aria-checked="{{item.checked}}" hover-class="cy-pressed" hover-stay-time="80">
     <view class="node-card__main"><text class="node-card__title">{{item.label}}</text></view>
     <view class="rt-check {{item.checked ? 'is-on' : ''}}" aria-hidden="true"><cy-icon wx:if="{{item.checked}}" name="check" size="24" /></view>
    </view>
    <view class="node-card__hr"></view>
    <view class="node-card__row"><view class="node-card__main"><text class="node-card__title">显示已解锁内容</text></view><cy-switch checked="{{survivalEditor.row.showUnlocks}}" bindchange="toggleSurvivalCardUnlocks" accessibility-label="显示已解锁内容" /></view>
   </view>
  </block>

  <view wx:if="{{survivalEditor.kind && survivalEditor.index >= 0}}" class="node-card node-card--danger" bindtap="removeSurvivalRow" aria-role="button" aria-label="删除此项" hover-class="cy-pressed" hover-stay-time="80">删除此项</view>
  <view wx:if="{{survivalEditor.section === 'card' && survivalEditor.customized}}" class="node-card node-card--danger" bindtap="removeSurvivalRow" aria-role="button" aria-label="恢复默认结果卡" hover-class="cy-pressed" hover-stay-time="80">恢复默认结果卡</view>
 </view>
</cy-sheet>
