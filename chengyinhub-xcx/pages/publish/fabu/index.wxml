<cy-category-sheet show="{{categorySheetVisible}}" type="{{1}}" ids="{{categorySheetIds}}"
  bind:select="onCategorySelect" bind:close="onCategorySheetClose" />

  <!-- 主题模式选择器(2026-08-11 用户定)。原来点左卡是【直接对切】——
       两种模式的差别(要不要定集合时间地点、票怎么卖)全靠创作者自己知道,切错了
       整条票务链路的必填项都跟着变。改成先把两种模式摊开讲清楚再让人选。
       文案取自票种编辑器稿(2770:11762 / 2770:13325)的那两句模式说明,同一句话只有一份。 -->
  <cy-sheet show="{{modePickerShow}}" style="--cy-comp-sheet-max-h: calc(100vh - {{chrome.sheetTop}}px)" bind:close="closeModePicker" class="node-sheet-host">
    <view class="pd-topic-detail node-sheet">
      <view class="node-sheet__top"><view class="node-sheet__close" bindtap="closeModePicker" aria-role="button" aria-label="关闭模式选择" hover-class="cy-pressed" hover-stay-time="80">退出</view>
        <view class="node-sheet__done" bindtap="confirmModePicker" aria-role="button" aria-label="确认创作模式" hover-class="cy-pressed" hover-stay-time="80">使用此模式</view>

      </view>
      <view class="node-sheet__titlebar">
        <text class="node-sheet__eyebrow">主题模式</text>
        <text class="node-sheet__name node-sheet__name--static">这个主题怎么玩？</text>
      </view>

      <view class="node-card mode-opt" bindtap="onPickMode" data-mode="1" aria-role="radio" aria-checked="{{modePickerMode === 1}}" hover-class="cy-pressed" hover-stay-time="80">
        <view class="node-card__row">
          <view class="node-card__ico mode-opt__ico"><cy-icon name="flag" size="32" /></view>
          <view class="node-card__main">
            <text class="node-card__title mode-opt__name">城市定向</text>
            <text class="mode-opt__desc">固定集合时间与地点</text>
          </view>
          <view class="mode-opt__mark {{modePickerMode === 1 ? 'is-on' : ''}}" aria-hidden="true" />
        </view>
      </view>

      <view class="node-card mode-opt" bindtap="onPickMode" data-mode="2" aria-role="radio" aria-checked="{{modePickerMode === 2}}" hover-class="cy-pressed" hover-stay-time="80">
        <view class="node-card__row">
          <view class="node-card__ico mode-opt__ico"><cy-icon name="tab-explore" size="32" /></view>
          <view class="node-card__main">
            <text class="node-card__title mode-opt__name">自由探索</text>
            <text class="mode-opt__desc">有效期内自由前往</text>
          </view>
          <view class="mode-opt__mark {{modePickerMode === 2 ? 'is-on' : ''}}" aria-hidden="true" />
        </view>
      </view>

      <view class="tk-note">切换后另存为新草稿，原稿保留</view>
    </view>
  </cy-sheet>

  <include src="./topic-detail-sheet.wxml" />

  <cy-sheet show="{{valueEditor.show}}" style="--cy-comp-sheet-max-h: calc(100vh - {{chrome.sheetTop}}px)" bind:close="closeValueEditor" class="node-sheet-host">
    <view class="node-sheet story-initial" wx:if="{{valueEditor.row}}">
      <view class="node-sheet__top"><view class="node-sheet__close" bindtap="closeValueEditor" aria-role="button" aria-label="关闭数值编辑" hover-class="cy-pressed">退出</view><view class="node-sheet__done" bindtap="saveValueEditor" aria-role="button" aria-label="保存数值" hover-class="cy-pressed">完成</view></view>
      <view class="node-sheet__titlebar"><text class="node-sheet__eyebrow">取值范围</text><text class="node-sheet__name node-sheet__name--static">{{valueEditor.index < 0 ? '添加数值' : '编辑数值'}}</text></view>
      <view class="node-card">
        <view class="rt-field"><text>名称</text><input value="{{valueEditor.row.label}}" disabled="{{valueEditor.definitionReadOnly}}" maxlength="128" placeholder="输入数值名称" data-field="label" bindinput="onValueField" /></view>
        <text class="story-initial__example">改名后，已有引用仍会保持关联。</text>
        <view class="rt-two"><view class="rt-field"><text>下限</text><input type="text" value="{{valueEditor.row.min}}" disabled="{{valueEditor.definitionReadOnly}}" data-field="min" bindinput="onValueField" /></view><view class="rt-field"><text>上限</text><input type="text" value="{{valueEditor.row.max}}" disabled="{{valueEditor.definitionReadOnly}}" data-field="max" bindinput="onValueField" /></view></view>
        <view class="node-card__row"><view class="node-card__main"><text class="node-card__title">玩家可见</text></view><cy-switch checked="{{valueEditor.row.visible}}" disabled="{{valueEditor.definitionReadOnly}}" data-field="visible" bindchange="onValueField" /></view>
        <text class="story-initial__example">开局值在第一章的「初始状态」中填写；修改范围后，越界的开局值会标出并阻止发布。</text>
      </view>
      <view class="node-card">
        <view class="node-card__row"><view class="node-card__main"><text class="node-card__title">关联</text></view><view class="node-pill" wx:if="{{runtimeHpEnabled}}" bindtap="addValueLink" aria-role="button" aria-label="添加数值关联" hover-class="cy-pressed">添加<cy-icon name="plus" size="24" /></view></view>
        <text class="story-initial__example">仅支持此值下降时扣减已启用的{{runtimeHpLabel}}，不支持其他目标或双向关联。</text>
        <text class="story-initial__example" wx:if="{{!runtimeHpEnabled}}">请先启用{{runtimeHpLabel}}。</text>
        <view wx:for="{{valueEditor.links}}" wx:key="id" wx:for-index="li">
          <view class="node-card__hr"></view>
          <view class="rt-field"><text>触发方式</text><cy-dropdown topic-editor range="{{valueTriggers}}" value="{{item.trigger === 'PER_POINT' ? 0 : item.trigger === 'PER_EVENT' ? 1 : 2}}" data-index="{{li}}" data-field="trigger" bind:change="onValueLink"><view class="rt-select">{{item.trigger === 'PER_POINT' ? valueTriggers[0] : item.trigger === 'PER_EVENT' ? valueTriggers[1] : valueTriggers[2]}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
          <view class="rt-field"><text>来源</text><cy-dropdown topic-editor range="{{valueReasonLabels}}" value="{{item.allowedReasons[0] === 'TASK_COST' ? 0 : item.allowedReasons[0] === 'TEMPLATE_EFFECT' ? 1 : item.allowedReasons[0] === 'CHAPTER_COST' ? 2 : item.allowedReasons[0] === 'ITEM_USE' ? 3 : 4}}" data-index="{{li}}" data-field="reason" bind:change="onValueLink"><view class="rt-select">{{item.allowedReasons[0] === 'TASK_COST' ? valueReasonLabels[0] : item.allowedReasons[0] === 'TEMPLATE_EFFECT' ? valueReasonLabels[1] : item.allowedReasons[0] === 'CHAPTER_COST' ? valueReasonLabels[2] : item.allowedReasons[0] === 'ITEM_USE' ? valueReasonLabels[3] : valueReasonLabels[4]}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
          <view class="rt-field"><text>次数范围</text><text wx:if="{{item.trigger === 'FIRST_THRESHOLD'}}">本局一次</text><cy-dropdown wx:else topic-editor range="{{valueFrequencies}}" value="{{item.frequency === 'RUN' ? 1 : 0}}" data-index="{{li}}" data-field="frequency" bind:change="onValueLink"><view class="rt-select">{{item.frequency === 'RUN' ? valueFrequencies[1] : valueFrequencies[0]}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
          <view class="rt-field" wx:if="{{item.trigger === 'PER_POINT'}}"><text>每点扣减</text><input type="number" value="{{item.multiplier}}" data-index="{{li}}" data-field="multiplier" bindinput="onValueLink" /></view>
          <view class="rt-field" wx:else><text>固定扣减</text><input type="number" value="{{item.amount}}" data-index="{{li}}" data-field="amount" bindinput="onValueLink" /></view>
          <view class="rt-field" wx:if="{{item.trigger === 'FIRST_THRESHOLD'}}"><text>首次阈值</text><input type="text" value="{{item.threshold}}" data-index="{{li}}" data-field="threshold" bindinput="onValueLink" /></view>
          <view class="node-pill" data-index="{{li}}" bindtap="removeValueLink" aria-role="button" aria-label="移除关联" hover-class="cy-pressed">移除关联</view>
        </view>
      </view>
      <view class="node-card node-card--danger" wx:if="{{valueEditor.index >= 0 && !valueEditor.definitionReadOnly}}" bindtap="removeValue" aria-role="button" aria-label="删除数值" hover-class="cy-pressed">删除数值</view>
      <view wx:if="{{valueEditor.definitionReadOnly}}" class="rt-hint">定义在主题配置的状态键中管理；这里可以编辑数值关联。</view>
      <cy-inline-error wx:if="{{valueEditor.error}}" title="{{valueEditor.error}}" />
    </view>
  </cy-sheet>

<!-- 结局:journeyStory.ending.endings。作者只配得出两种条件(某个伏笔应验了 / 到过某个站点),
     服务端认的语法更宽 —— 在别处配的复杂条件在这里只读,原样保留,不会被这一屏抹掉。 -->
<!-- 结局面板已撤(2026-09-24):结局 = 结局章,在章节设置里打开「设为结局」。 -->

<!-- 编辑主题的伏笔配置：入口位于主题详情，仅编辑唯一伏笔的步数和文字。 -->
<cy-sheet show="{{thoughtsEditor.show}}" variant="bottom" bind:close="closeThoughts" class="node-sheet-host">
  <view class="node-sheet story-initial story-thought">
    <view class="node-sheet__top"><view class="node-sheet__close" bindtap="closeThoughts" aria-role="button" aria-label="关闭伏笔" hover-class="cy-pressed" hover-stay-time="80">退出</view>

    </view>
    <view class="node-sheet__titlebar"><text class="node-sheet__name node-sheet__name--static">伏笔</text></view>
    <text class="story-thought__err" wx:if="{{thoughtsEditor.list.length > 1}}">只能配置一个伏笔，当前旧配置包含多个</text>
    <view class="node-card" wx:for="{{thoughtsEditor.list}}" wx:key="key" wx:for-item="th" wx:for-index="ti">
      <cy-btn variant="ghost" size="sm" data-index="{{ti}}" bindtap="removeThought" aria-label="删除这条伏笔">删除伏笔</cy-btn>
      <cy-field label="步数" required value="{{th.need}}" placeholder="输入步数"
                data-index="{{ti}}" data-field="need" bind:input="onThoughtInput" />
      <cy-field label="输入文字" required variant="textarea" value="{{th.desc}}" maxlength="60"
                placeholder="输入伏笔文字" data-index="{{ti}}" data-field="desc" bind:input="onThoughtInput" />
    </view>
    <text class="story-thought__err" wx:if="{{thoughtsEditor.error}}">{{thoughtsEditor.error}}</text>
    <cy-btn variant="primary" block bindtap="saveThoughts" aria-label="保存伏笔">完成</cy-btn>
  </view>
</cy-sheet>

<cy-sheet show="{{initialStateEditor.show}}" style="--cy-comp-sheet-max-h: calc(100vh - {{chrome.sheetTop}}px)" bind:close="closeInitialState" class="node-sheet-host">
  <view class="node-sheet story-initial" wx:if="{{initialStateEditor.rules}}">
    <view class="node-sheet__top"><view class="node-sheet__close" bindtap="closeInitialState" aria-role="button" aria-label="关闭初始状态" hover-class="cy-pressed" hover-stay-time="80">退出</view>
      <view class="node-sheet__done" bindtap="saveInitialState" aria-role="button" aria-label="保存初始状态" hover-class="cy-pressed" hover-stay-time="80">完成</view>

    </view>
    <view class="node-sheet__titlebar">
      <text class="node-sheet__eyebrow">主题配置</text>
      <text class="node-sheet__name node-sheet__name--static">初始状态</text>
    </view>
    <view class="node-card">
      <attribute-binding-editor wx:if="{{initialStateEditor.show}}" rules="{{formData.journeyRules}}" snapshot="{{attributeRegistrySnapshot}}" topic-id="{{editingTopicId}}" config-version="{{formData.configVersion}}" read-only="{{editScope === 'WHITELIST'}}" bind:confirm="onAttributeBindingConfirm" bind:manage="manageAttributeDefinitions" bind:refresh="loadAttributeRegistry" />
      <cy-inline-error wx:if="{{attributeRegistryError}}" title="{{attributeRegistryError}}" />
    </view>
    <view class="node-card" wx:if="{{initialStateEditor.rules.hp.enabled}}">
      <view class="story-initial__row"><text class="node-card__title">{{runtimeHpInitialLabel}}</text><cy-switch checked="{{true}}" disabled="{{editScope === 'WHITELIST'}}" data-field="hp.enabled" bind:change="onInitialStateField" accessibility-label="启用{{runtimeHpInitialLabel}}" /></view>
      <view class="story-initial__numbers">
        <cy-field label="开局{{runtimeHpInitialLabel}}" value="{{initialStateEditor.rules.hp.init}}" data-field="hp.init" bind:input="onInitialStateField" readonly="{{editScope === 'WHITELIST'}}" />
        <cy-field label="上限（主题设置）" value="{{initialStateEditor.rules.hp.max}}" readonly="{{true}}" />
      </view>
    </view>
    <view class="node-card" wx:if="{{initialStateEditor.rules.luck.enabled}}">
      <view class="story-initial__row"><text class="node-card__title">{{runtimeLuckInitialLabel}}</text><cy-switch checked="{{true}}" disabled="{{editScope === 'WHITELIST'}}" data-field="luck.enabled" bind:change="onInitialStateField" accessibility-label="启用{{runtimeLuckInitialLabel}}" /></view>
      <view class="story-initial__numbers">
        <cy-field label="开局{{runtimeLuckInitialLabel}}" value="{{initialStateEditor.rules.luck.init}}" data-field="luck.init" bind:input="onInitialStateField" readonly="{{editScope === 'WHITELIST'}}" />
        <cy-field label="上限（主题设置）" value="{{initialStateEditor.rules.luck.max}}" readonly="{{true}}" />
      </view>
    </view>
    <view class="node-card" wx:for="{{initialStateEditor.values}}" wx:key="key">
      <view class="story-initial__row"><text class="node-card__title">{{item.label}}</text><text class="node-card__value">{{item.min}} 至 {{item.max}}</text></view>
      <view class="story-initial__numbers"><cy-field label="开局{{item.label}}" value="{{item.initial}}" data-index="{{item.index}}" data-field="attribute.initial" bind:input="onInitialStateField" readonly="{{editScope === 'WHITELIST' || initialStateEditor.rules.attributeBinding}}" /></view>
      <cy-inline-error wx:if="{{item.invalidInitial}}" title="开局值超出当前范围，请修改后完成" />
    </view>
    <view class="story-initial__choices" wx:if="{{editScope !== 'WHITELIST'}}">
      <text class="story-initial__heading">添加初始状态</text>
      <view class="story-initial__options">
        <view class="story-initial__option" wx:for="{{initialStateOptions}}" wx:key="type" data-type="{{item.type}}" bindtap="addInitialState" aria-role="button" aria-label="添加{{item.label}}，{{item.example}}" hover-class="cy-pressed">
          <view class="story-initial__option-top"><text>{{item.label}}</text><text class="story-initial__option-mark">{{(item.type === 'hp' && initialStateEditor.rules.hp.enabled) || (item.type === 'luck' && initialStateEditor.rules.luck.enabled) ? '已添加' : '添加'}}</text></view>
          <text class="story-initial__example">{{item.example}}</text>
        </view>
      </view>
    </view>
    <cy-inline-error wx:if="{{initialStateEditor.error}}" title="{{initialStateEditor.error}}" />
  </view>
</cy-sheet>

  <!-- 2026-08-20 物理返回守卫:任一浮层开着时,返回键/侧滑先关最上层浮层(节点抽屉的
       玩法视图先退回详情),不再把整个编辑器弹出去。表达式覆盖本页全部浮层且无排斥项:
       浮层间切换时它保持为真,不会产生「误触发 afterleave 把底层关掉」的竞态;
       backGuardOff 用于容器被返回键消费后翻转重挂(page-container 每页只能有一个)。 -->
  <page-container
    show="{{!backGuardOff && (structureEditor.show || survivalEditor.show || runtimeZeroEditor.show || chapterPreview.show || initialStateEditor.show || valueEditor.show || routeMappingShow || popChapterNodes || popChapter || publishCheck.show || storyEditor.show || modePickerShow || topicDetailShow)}}"
    duration="{{0}}" overlay="{{false}}"
    custom-style="width:0;height:0;background:transparent;pointer-events:none"
    bind:afterleave="onNativeBackGuard" />
<include src="runtime-editor.wxml" />
<include src="runtime-structure-editor.wxml" /> <!-- structure -->
<include src="survival-editor.wxml" /> <!-- survival -->
<include src="zero-hp-editor.wxml" /> <!-- R5 HP 归零 -->
  </block>
</view>
<cy-privacy-gate show="{{privacyGateShow}}" bind:settled="onPrivacyGateSettled" />

<cy-chapter-gate wx:if="{{chapterPreview.show}}" number="{{chapterPreview.number}}" total="{{chapterPreview.total}}" title="{{chapterPreview.title}}" subtitle="{{chapterPreview.subtitle}}" reduced-motion="{{reducedMotion}}" bind:continue="closeChapterPreview" />
