<cy-sheet show="{{runtimeEditor.show}}" stacked="{{runtimeRewardOpen}}" bind:close="closeRuntimeEditor" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop + 18}}px);--cy-comp-sheet-role-glass:#f3f4f5">
 <view class="rt-editor" style="min-height:calc(100vh - {{chrome.sheetTop + 18}}px - env(safe-area-inset-bottom) - 24rpx)">
  <view class="node-sheet__top"><view class="node-sheet__close" bindtap="closeRuntimeEditor" aria-label="关闭配置" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="node-sheet__done" bindtap="closeRuntimeEditor" aria-label="关闭配置" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
  <view class="rt-title"><view wx:if="{{runtimeEditor.kind === 'bingo-cell'}}" bindtap="backRuntimeBingo" aria-label="返回九宫格" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="back" size="32" /></view><text>{{runtimeEditor.title}}</text></view>
  <block wx:if="{{runtimeEditor.kind === 'bag'}}">
   <view class="rt-two rt-add"><view class="node-pill {{medalEditable ? '' : 'rt-disabled'}}" aria-disabled="{{!medalEditable}}" data-kind="MEDAL" bindtap="addRuntimeContent" aria-role="button" hover-class="{{medalEditable ? 'cy-pressed' : 'none'}}" hover-stay-time="80"><cy-icon name="plus" size="24" />添加勋章</view><view class="node-pill" data-kind="ITEM" bindtap="addRuntimeContent" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" />添加物品</view></view>
   <view class="node-card rt-two"><view class="rt-field"><text>物品容量</text><input type="number" value="{{runtimeBag.capacity}}" data-field="capacity" bindinput="onRuntimePolicy" /></view><view class="rt-policy"><text>允许丢弃</text><cy-switch checked="{{runtimeBag.allowDiscard}}" data-field="allowDiscard" bindchange="onRuntimePolicy" /></view></view>
   <view class="node-card" wx:for="{{runtimeBag.items}}" wx:key="id" wx:for-index="ii">
    <view class="rt-card-head"><text>{{item.kind === 'MEDAL' ? '勋章' : '物品'}}</text><view class="rt-delete" data-index="{{ii}}" bindtap="removeRuntimeItem" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">删除</view></view>
    <view class="rt-photo-name"><view class="rt-image" data-index="{{ii}}" bindtap="uploadRuntimeImage" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" /><block wx:else><cy-icon name="image" size="32" /><text>上传图片</text></block></view><view class="rt-field"><text>名称</text><input value="{{item.name}}" disabled="{{item.kind === 'MEDAL' && !medalEditable}}" placeholder="请输入名称" maxlength="40" data-index="{{ii}}" data-field="name" bindinput="onRuntimeItem" /></view></view>
    <view class="rt-two"><view class="rt-field"><text>发放时机</text><cy-dropdown topic-editor range="{{runtimeTimings}}" value="{{item.timingIndex}}" data-index="{{ii}}" data-field="timing" bind:change="onRuntimeItem"><view class="rt-select">{{runtimeTimings[item.timingIndex]}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view><view class="rt-field" wx:if="{{item.kind === 'ITEM'}}"><text>如何使用</text><cy-dropdown topic-editor range="{{runtimePurposes}}" value="{{item.purposeIndex}}" unchecked-value="0" data-index="{{ii}}" data-field="purpose" bind:change="onRuntimeItem"><view class="rt-select">{{runtimePurposes[item.purposeIndex]}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view></view>
    <view wx:if="{{item.kind === 'ITEM'}}" class="rt-field"><text>每件占格</text><input type="number" value="{{item.slotCost || 1}}" data-index="{{ii}}" data-field="slotCost" bindinput="onRuntimeItem" /></view>
    <view wx:if="{{item.timingIndex}}" class="rt-field"><text>发放数量</text><input type="number" value="{{item.quantity}}" data-index="{{ii}}" data-field="quantity" bindinput="onRuntimeItem" /></view>
    <block wx:if="{{item.purposeIndex && item.kind === 'ITEM'}}"><view class="rt-field"><text>{{item.mode === 'REDUCE' ? '减耗数值' : item.statLabel + '变化'}}</text><input type="text" value="{{item.delta}}" placeholder="例如 1 或 -1" data-index="{{ii}}" data-field="delta" bindinput="onRuntimeItem" /></view><view class="rt-field"><text>生效方式</text><cy-dropdown topic-editor range="{{item.effectOptions}}" value="{{item.effectIndex}}" data-index="{{ii}}" data-field="effect" bind:change="onRuntimeItem"><view class="rt-select">{{item.effectOptions[item.effectIndex]}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view></block>
   </view>
  </block>
  <block wx:if="{{runtimeEditor.kind === 'eggs'}}">
   <view class="node-pill rt-add" bindtap="addRuntimeEgg" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" />添加彩蛋</view>
   <view class="node-card" wx:for="{{runtimeEggs}}" wx:key="id" wx:for-index="ei"><view class="rt-card-head"><text>彩蛋 {{ei+1}}</text><view class="rt-delete" data-index="{{ei}}" bindtap="removeRuntimeEgg" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">删除</view></view>
    <view class="rt-field"><text>名称</text><input value="{{item.name}}" maxlength="40" data-index="{{ei}}" data-field="name" bindinput="onRuntimeEgg" /></view>
    <view class="rt-two"><view class="rt-field"><text>触发方式</text><cy-dropdown topic-editor range="{{runtimeTriggers}}" value="{{item.triggerIndex}}" data-index="{{ei}}" data-field="trigger" bind:change="onRuntimeEgg"><view class="rt-select">{{runtimeTriggers[item.triggerIndex]}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view><view class="rt-field"><text>{{item.triggerIndex ? '本章累计步数' : '章节开始后（分钟）'}}</text><input type="number" value="{{item.threshold}}" data-index="{{ei}}" data-field="threshold" bindinput="onRuntimeEgg" /></view></view>
    <view class="rt-field"><text>内容</text><textarea value="{{item.content}}" maxlength="500" fixed data-index="{{ei}}" data-field="content" bindinput="onRuntimeEgg" /></view>
    <view class="rt-two" wx:for="{{item.rewards}}" wx:key="index" wx:for-item="reward" wx:for-index="ri"><view class="rt-field"><text>奖励</text><cy-dropdown topic-editor range="{{runtimeRewardOptions}}" range-key="name" value="{{reward.selectedIndex}}" data-index="{{ei}}" data-reward="{{ri}}" data-field="itemId" bind:change="onRuntimeEggReward"><view class="rt-select">{{reward.selectedIndex >= 0 ? runtimeRewardOptions[reward.selectedIndex].name : '选择物品或勋章'}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view><view class="rt-field rt-quantity"><text>数量</text><input type="number" value="{{reward.quantity}}" data-index="{{ei}}" data-reward="{{ri}}" data-field="quantity" bindinput="onRuntimeEggReward" /><view class="rt-delete" data-index="{{ei}}" data-reward="{{ri}}" bindtap="removeRuntimeEggReward" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">移除</view></view></view>
    <view class="node-pill rt-add" data-index="{{ei}}" bindtap="addRuntimeEggReward" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" />添加奖励</view>
   </view>
  </block>
  <block wx:if="{{runtimeEditor.kind === 'rewards'}}">
   <view class="node-card"><text class="node-card__title">优惠券</text><cy-reward-selector bind:openchange="onRuntimeRewardOpen" value="{{formData.completeRewardCouponId}}" selected-name="{{completionRewardCouponName}}" occasion="topic" placeholder="选择优惠券" scope="{{operationScope}}" bind:change="onCompletionRewardChange" /></view>
   <view class="node-card"><view class="rt-field"><text>勋章或物品</text><cy-dropdown topic-editor range="{{runtimeRewardOptions}}" range-key="name" value="{{runtimeCompletionIndex}}" bind:change="onRuntimeCompletionItem"><view class="rt-select">{{runtimeCompletionIndex >= 0 ? runtimeRewardOptions[runtimeCompletionIndex].name : '选择勋章或物品'}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view><view class="rt-delete" wx:if="{{runtimeCompletionIndex >= 0}}" bindtap="clearRuntimeCompletionItem" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">清除</view></view>
   <view class="node-card" wx:if="{{medalEditable || formData.finishMedalName || formData.finishMedalImg}}">
    <block wx:if="{{medalEditable}}"><view class="rt-photo-name"><view class="rt-image" bindtap="uploadFinishMedal" aria-label="上传通关勋章图片" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><image wx:if="{{formData.finishMedalImg}}" src="{{formData.finishMedalImg}}" mode="aspectFill" /><cy-icon wx:else name="star" size="32" /></view><view class="rt-field"><text>通关勋章</text><input value="{{formData.finishMedalName}}" placeholder="勋章名称" bindinput="onFinishMedalNameInput" /></view></view></block>
    <block wx:else><view class="rt-photo-name" aria-label="勋章设计是俱乐部主理人的权益，当前身份暂未解锁"><image class="rt-image" wx:if="{{formData.finishMedalImg}}" src="{{formData.finishMedalImg}}" mode="aspectFill" /><text>{{formData.finishMedalName || '通关勋章'}}</text><view class="node-pill--locked">未解锁</view></view></block>
   </view>
  </block>
  <cy-inline-error wx:if="{{runtimeEditor.kind === 'bingo' && bingoError}}" title="{{bingoError}}" />
  <block wx:if="{{runtimeEditor.kind === 'bingo'}}"><view class="rt-bingo"><view wx:for="{{bingoRows}}" wx:key="pos" class="rt-bingo-cell" data-index="{{index}}" bindtap="openRuntimeBingoCell" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">{{item.label || index + 1}}</view></view></block>
  <block wx:if="{{runtimeEditor.kind === 'bingo-cell'}}"><view class="node-card"><view class="rt-field"><text>标题</text><input value="{{bingoRows[runtimeBingoIndex].label}}" placeholder="填写标题" data-index="{{runtimeBingoIndex}}" bindinput="onBingoLabelInput" /></view><view class="rt-field"><text>完成反馈</text><input value="{{bingoRows[runtimeBingoIndex].feedbackText}}" data-index="{{runtimeBingoIndex}}" bindinput="onBingoFeedbackInput" /></view><cy-reward-selector bind:openchange="onRuntimeRewardOpen" value="{{bingoRows[runtimeBingoIndex].couponId}}" selected-name="{{bingoRows[runtimeBingoIndex].couponName}}" occasion="topic" placeholder="选择奖励" scope="{{operationScope}}" data-index="{{runtimeBingoIndex}}" bind:change="onBingoCouponChange" /></view></block>
 </view>
</cy-sheet>
