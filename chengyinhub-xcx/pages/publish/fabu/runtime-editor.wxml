   <view class="node-pill rt-add" bindtap="addRuntimeEgg" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" />添加彩蛋</view>
   <view class="node-card" wx:for="{{runtimeEggs}}" wx:key="id" wx:for-index="ei"><view class="rt-card-head"><text>彩蛋 {{ei+1}}</text><view class="rt-delete" data-index="{{ei}}" bindtap="removeRuntimeEgg" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">删除</view></view>
    <view class="rt-field"><text>名称</text><input value="{{item.name}}" maxlength="40" data-index="{{ei}}" data-field="name" bindinput="onRuntimeEgg" /></view>
    <view class="rt-two"><view class="rt-field"><text>触发方式</text><cy-dropdown topic-editor range="{{runtimeTriggers}}" value="{{item.triggerIndex}}" data-index="{{ei}}" data-field="trigger" bind:change="onRuntimeEgg"><view class="rt-select">{{runtimeTriggers[item.triggerIndex]}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view><view class="rt-field"><text>{{item.triggerIndex ? '本章累计步数' : '章节开始后（分钟）'}}</text><input type="number" value="{{item.threshold}}" data-index="{{ei}}" data-field="threshold" bindinput="onRuntimeEgg" /></view></view>
    <view class="rt-field"><text>内容</text><textarea value="{{item.content}}" maxlength="500" fixed data-index="{{ei}}" data-field="content" bindinput="onRuntimeEgg" /></view>
    <view class="rt-two" wx:for="{{item.rewards}}" wx:key="index" wx:for-item="reward" wx:for-index="ri"><view class="rt-field"><text>奖励</text><cy-dropdown topic-editor range="{{runtimeRewardOptions}}" range-key="name" value="{{reward.selectedIndex}}" data-index="{{ei}}" data-reward="{{ri}}" data-field="itemId" bind:change="onRuntimeEggReward"><view class="rt-select">{{reward.selectedIndex >= 0 ? runtimeRewardOptions[reward.selectedIndex].name : '选择物品或勋章'}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view><view class="rt-field rt-quantity"><text>数量</text><input type="number" value="{{reward.quantity}}" data-index="{{ei}}" data-reward="{{ri}}" data-field="quantity" bindinput="onRuntimeEggReward" /><view class="rt-delete" data-index="{{ei}}" data-reward="{{ri}}" bindtap="removeRuntimeEggReward" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">移除</view></view></view>
    <view class="node-pill rt-add" data-index="{{ei}}" bindtap="addRuntimeEggReward" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" />添加奖励</view>
   </view>
  </block>
  <block wx:if="{{runtimeEditor.kind === 'rewards'}}">
   <view class="node-card"><text class="node-card__title">优惠券</text><cy-reward-selector id="runtime-reward-selector" bind:openchange="onRuntimeRewardOpen" value="{{runtimeRewards.couponId}}" selected-name="{{runtimeRewards.couponName}}" occasion="topic" placeholder="选择优惠券" scope="{{operationScope}}" bind:change="onRuntimeCouponChange" /></view>
   <view class="node-card"><view class="rt-field"><text>勋章或物品</text><cy-dropdown topic-editor range="{{runtimeRewardOptions}}" range-key="name" value="{{runtimeCompletionIndex}}" bind:change="onRuntimeCompletionItem"><view class="rt-select">{{runtimeCompletionIndex >= 0 ? runtimeRewardOptions[runtimeCompletionIndex].name : '选择勋章或物品'}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view><view class="rt-delete" wx:if="{{runtimeCompletionIndex >= 0}}" bindtap="clearRuntimeCompletionItem" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">清除</view></view>
   <view class="node-card" wx:if="{{medalEditable || runtimeRewards.medalName || runtimeRewards.medalImage}}">
    <block wx:if="{{medalEditable}}"><view class="rt-photo-name"><view class="rt-image" bindtap="uploadRuntimeMedal" aria-label="上传通关勋章图片" aria-role="button" hover-class="cy-pressed" hover-stay-time="80"><image wx:if="{{runtimeRewards.medalImage}}" src="{{runtimeRewards.medalImage}}" mode="aspectFill" /><cy-icon wx:else name="star" size="32" /></view><view class="rt-field"><text>通关勋章</text><input value="{{runtimeRewards.medalName}}" placeholder="勋章名称" bindinput="onRuntimeMedalName" /></view></view></block>
    <block wx:else><view class="rt-photo-name" aria-label="勋章设计是俱乐部主理人的权益，当前身份暂未解锁"><image class="rt-image" wx:if="{{runtimeRewards.medalImage}}" src="{{runtimeRewards.medalImage}}" mode="aspectFill" /><text>{{runtimeRewards.medalName || '通关勋章'}}</text><view class="node-pill--locked">未解锁</view></view></block>
   </view>
  </block>

  <cy-inline-error wx:if="{{runtimeEditor.kind === 'bingo' && bingoError}}" title="{{bingoError}}" />
  <block wx:if="{{runtimeEditor.kind === 'bingo'}}"><view class="rt-bingo"><view wx:for="{{bingoRows}}" wx:key="pos" class="rt-bingo-cell" data-index="{{index}}" bindtap="openRuntimeBingoCell" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">{{item.label || index + 1}}</view></view></block>
  <block wx:if="{{runtimeEditor.kind === 'bingo-cell'}}"><view class="node-card"><view class="rt-field"><text>标题</text><input value="{{bingoRows[runtimeBingoIndex].label}}" placeholder="填写标题" data-index="{{runtimeBingoIndex}}" bindinput="onBingoLabelInput" /></view><view class="rt-field"><text>完成反馈</text><input value="{{bingoRows[runtimeBingoIndex].feedbackText}}" data-index="{{runtimeBingoIndex}}" bindinput="onBingoFeedbackInput" /></view><cy-reward-selector id="runtime-bingo-reward-selector" bind:openchange="onRuntimeRewardOpen" value="{{bingoRows[runtimeBingoIndex].couponId}}" selected-name="{{bingoRows[runtimeBingoIndex].couponName}}" occasion="topic" placeholder="选择奖励" scope="{{operationScope}}" data-index="{{runtimeBingoIndex}}" bind:change="onBingoCouponChange" /></view></block>
 </view>
</cy-sheet>
