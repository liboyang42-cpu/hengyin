<!-- 主题值域 · HP 归零后（R5，2026-10-10 主人批准原型）：一个面板配完归零策略、恢复条件、次数用完后与归零时回复。
     页头统一「左 退出（放弃本次改动）/ 右 完成（校验后保存回主题草稿）」；选择策略用两列下拉，不可选项写明原因。
     旧版（BLOCK_PAID / LEGACY_END / 旧 CHALLENGE）只读显示并原样保留。 -->
<cy-sheet show="{{runtimeZeroEditor.show}}" fixed="full" bind:close="closeZeroHpEditor" style="--cy-comp-sheet-max-h:calc(100vh - {{chrome.sheetTop + 18}}px);--cy-comp-sheet-role-glass:#f3f4f5">
 <view class="rt-editor" wx:if="{{runtimeZeroEditor.draft}}">
  <view class="node-sheet__top"><view class="node-sheet__close" bindtap="closeZeroHpEditor" aria-role="button" aria-label="退出归零设置" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="node-sheet__done" bindtap="saveZeroHpEditor" aria-role="button" aria-label="完成归零设置" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
  <view class="rt-title"><text>{{runtimeHpLabel}}归零后</text></view>
  <view class="node-card" wx:if="{{runtimeZeroEditor.readOnly}}"><view class="node-card__row"><view class="node-card__main"><text class="node-card__title">旧版归零设置</text><text class="node-card__value">{{runtimeZeroHpSummary}} · 只读，保存时原样保留</text></view></view></view>
  <block wx:else>
   <view class="node-card">
    <view class="rt-field"><text>归零后</text>
     <cy-dropdown topic-editor columns="{{2}}" range="{{runtimeZeroHpOptions}}" range-key="label" reason-key="reason" value="{{zh.idx(runtimeZeroHpOptions, runtimeZeroEditor.draft.policy)}}" bind:change="pickZeroHpPolicy"><view class="rt-select">{{zh.label(runtimeZeroHpOptions, runtimeZeroEditor.draft.policy)}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown>
    </view>
   </view>
   <view class="node-card" wx:if="{{runtimeZeroEditor.draft.policy === 'CHALLENGE'}}">
    <text class="story-initial__example" wx:if="{{!runtimeChallengeNodes.length}}">{{supportMatrix ? '没有可用挑战节点，请检查玩法配置或等待详情加载。' : '请先保存主题和节点，才能选择挑战节点。'}}</text>
    <view class="rt-field"><text>用哪个节点的玩法</text><cy-dropdown topic-editor range="{{runtimeChallengeNodes}}" range-key="name" reason-key="reason" value="{{zh.idx(runtimeChallengeNodes, runtimeZeroEditor.draft.challenge.challengeNodeId, 'id')}}" bind:change="pickZeroHpChallengeNode"><view class="rt-select">{{zh.label(runtimeChallengeNodes, runtimeZeroEditor.draft.challenge.challengeNodeId, 'id', 'name')}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
    <view class="rt-field" wx:if="{{runtimeAlternativeNodes.length}}"><text>备选节点（最多 3 个）</text>
     <view class="rt-pills"><view wx:for="{{runtimeAlternativeNodes}}" wx:key="id" class="node-pill" data-id="{{item.id}}" bindtap="toggleZeroHpAlternative" aria-role="button" aria-disabled="{{!!item.reason && !item.selected}}" aria-label="{{item.selected ? '移除' : '添加'}}备选{{item.name}}" hover-class="cy-pressed" hover-stay-time="80">{{item.selected ? '已选 · ' : '添加 · '}}{{item.name}}<text wx:if="{{item.reason}}" class="node-binding__error">{{item.reason}}{{item.selected ? ' · 点击移除' : ''}}</text></view></view>
    </view>
    <view class="rt-two"><view class="rt-field"><text>需完成几次</text><input type="number" value="{{runtimeZeroEditor.draft.challenge.requiredCompletions}}" data-path="challenge.requiredCompletions" bindinput="inputZeroHpField" /></view><view class="rt-field"><text>限时（秒）</text><input type="number" value="{{runtimeZeroEditor.draft.challenge.withinSeconds}}" data-path="challenge.withinSeconds" bindinput="inputZeroHpField" /></view></view>
    <view class="rt-two"><view class="rt-field"><text>恢复到</text><input type="number" value="{{runtimeZeroEditor.draft.challenge.restoreTo}}" data-path="challenge.restoreTo" bindinput="inputZeroHpField" /></view><view class="rt-field"><text>最多恢复几次</text><input type="number" value="{{runtimeZeroEditor.draft.challenge.limit}}" data-path="challenge.limit" bindinput="inputZeroHpField" /></view></view>
    <view class="rt-field"><text>次数用完后</text><cy-dropdown topic-editor range="{{runtimeZeroThenOptions}}" range-key="label" value="{{zh.idx(runtimeZeroThenOptions, runtimeZeroEditor.draft.challenge.thenPolicy)}}" data-block="challenge" bind:change="pickZeroHpThenPolicy"><view class="rt-select">{{zh.label(runtimeZeroThenOptions, runtimeZeroEditor.draft.challenge.thenPolicy)}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view>
   </view>
   <view class="node-card" wx:if="{{runtimeZeroEditor.draft.policy === 'STEPS'}}">
    <view class="rt-two"><view class="rt-field"><text>走够步数</text><input type="number" value="{{runtimeZeroEditor.draft.steps.steps}}" data-path="steps.steps" bindinput="inputZeroHpField" /></view><view class="rt-field"><text>恢复到</text><input type="number" value="{{runtimeZeroEditor.draft.steps.restoreTo}}" data-path="steps.restoreTo" bindinput="inputZeroHpField" /></view></view>
    <view class="rt-two"><view class="rt-field"><text>最多恢复几次</text><input type="number" value="{{runtimeZeroEditor.draft.steps.limit}}" data-path="steps.limit" bindinput="inputZeroHpField" /></view><view class="rt-field"><text>次数用完后</text><cy-dropdown topic-editor range="{{runtimeZeroThenOptions}}" range-key="label" value="{{zh.idx(runtimeZeroThenOptions, runtimeZeroEditor.draft.steps.thenPolicy)}}" data-block="steps" bind:change="pickZeroHpThenPolicy"><view class="rt-select">{{zh.label(runtimeZeroThenOptions, runtimeZeroEditor.draft.steps.thenPolicy)}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view></view>
    <text class="story-initial__example">以归零后第一次同步的微信运动步数为起点累计。</text>
   </view>
   <view class="node-card" wx:if="{{runtimeZeroEditor.draft.policy === 'WAIT'}}">
    <view class="rt-two"><view class="rt-field"><text>等待（分钟）</text><input type="number" value="{{runtimeZeroEditor.draft.wait.minutes}}" data-path="wait.minutes" bindinput="inputZeroHpField" /></view><view class="rt-field"><text>恢复到</text><input type="number" value="{{runtimeZeroEditor.draft.wait.restoreTo}}" data-path="wait.restoreTo" bindinput="inputZeroHpField" /></view></view>
    <view class="rt-two"><view class="rt-field"><text>最多恢复几次</text><input type="number" value="{{runtimeZeroEditor.draft.wait.limit}}" data-path="wait.limit" bindinput="inputZeroHpField" /></view><view class="rt-field"><text>次数用完后</text><cy-dropdown topic-editor range="{{runtimeZeroThenOptions}}" range-key="label" value="{{zh.idx(runtimeZeroThenOptions, runtimeZeroEditor.draft.wait.thenPolicy)}}" data-block="wait" bind:change="pickZeroHpThenPolicy"><view class="rt-select">{{zh.label(runtimeZeroThenOptions, runtimeZeroEditor.draft.wait.thenPolicy)}}<cy-icon name="chevron-right" size="24" /></view></cy-dropdown></view></view>
   </view>
   <view class="node-card">
    <view class="rt-field"><text>归零时对玩家说</text><input value="{{runtimeZeroEditor.draft.zeroMessage}}" maxlength="2000" placeholder="例如 你冻得发抖，先暖和过来再走" data-path="zeroMessage" bindinput="inputZeroHpField" /></view>
    <text class="story-initial__example" wx:if="{{runtimeZeroEditor.draft.policy === 'THEME_FAIL'}}">本次游玩结束，按主题「结果卡」显示失败结果。</text>
   </view>
  </block>
  <text class="node-binding__error" wx:if="{{runtimeZeroEditor.error}}">{{runtimeZeroEditor.error}}</text>
 </view>
</cy-sheet>
