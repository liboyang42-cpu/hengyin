/* 共用「九宫格上传器」样式。@import 到各编辑页使用。
   结构:
   <view class="pgrid-head"><text class="pgrid-hint">说明</text><text class="pgrid-count">n/9</text></view>
   <view class="pgrid">
     <view class="pgrid-cell"><image class="pgrid-cell-img"/><view class="pgrid-del">×</view></view> ...
     <view class="pgrid-cell pgrid-add"><text class="pgrid-add-plus">＋</text><text class="pgrid-add-txt">添加照片</text></view>
   </view>
*/
.pgrid-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--cy-space-1-5);
}
.pgrid-hint {
  font-size: var(--cy-font-label);
  color: var(--cy-color-text-tertiary);
}
.pgrid-count {
  font-size: var(--cy-font-label);
  color: var(--cy-color-text-tertiary);
  font-variant-numeric: tabular-nums;
}
.pgrid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--cy-space-2);
}
.pgrid-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--cy-radius-sm);
  overflow: hidden;
  background: var(--cy-color-bg-surface-subtle);
}
.pgrid-cell-img {
  width: 100%;
  height: 100%;
}
.pgrid-del {
  position: absolute;
  top: var(--cy-legacy-4);
  right: var(--cy-legacy-4);
  width: var(--cy-btn-h);
  height: var(--cy-btn-h);
}
.pgrid-del__glyph {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--cy-color-overlay);
  color: #FFFFFF; /* ds-ok: 压在照片遮罩上的白字,双主题同值 */
  font-size: var(--cy-font-body);
}
.pgrid-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: transparent;
  border: 4rpx dashed var(--cy-color-border-strong);
}
.pgrid-add-plus {
  font-size: 52rpx; /* ds-ok: 加号字形尺寸,不是排版字号 */
  color: var(--cy-color-text-tertiary);
  line-height: 1;
}
.pgrid-add-txt {
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
  margin-top: var(--cy-legacy-6);
}
