<!-- 城瘾 · 创建城市路线(简易版)—— 地图为主角版 -->
<!-- 模式语义:mode=2 自由(绿)/ mode=1 定向(蓝) -->
<view class="simple-ai theme-topic-editor {{reducedMotion ? 'simple-ai--reduced' : ''}}">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <!-- 2026-10-28 业主 p86(参考 X alexyango / ianneo_ai):浅色渐变底 + 兴趣气泡 + 灵感 chip + 圆形发送键;
       出稿后是一张草稿卡,点「打开草稿」再展开原来的逐站确认。额度只在用完时用下方提示说明。 -->
  <view class="simple-ai__glow" aria-hidden="true"><view class="simple-ai__blob simple-ai__blob--a"></view><view class="simple-ai__blob simple-ai__blob--b"></view><view class="simple-ai__blob simple-ai__blob--c"></view></view>
  <cy-nav-bar title="快速配置" />
  <view class="simple-ai__nav-spacer" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <cy-empty wx:if="{{creatorLoginRequired}}" title="登录后配置路线" cta="去登录" bind:cta="onCreatorLogin" />
  <block wx:else>
  <scroll-view class="simple-ai__scroll" scroll-y="true">
    <view class="simple-ai__body">
      <view class="simple-ai__hero" wx:if="{{!aiPlan || planOpen}}">
        <text class="simple-ai__kicker">{{mode === 2 ? '自由探索 · 章节承接路线' : '城市定向 · 集合式路线'}}</text>
        <text class="simple-ai__title">{{aiPlan ? '这条路线，已经有了轮廓。' : '嗨，想做一条什么样的路线？'}}</text>
      </view>

      <block wx:if="{{!aiPlan}}">
        <view class="simple-ai__prompt-label">你喜欢什么</view>
        <view class="simple-ai__bubbles">
          <view class="simple-ai__bubble {{item.on ? 'is-on' : ''}}" wx:for="{{interests}}" wx:key="key"
                style="left: {{item.x}}%; top: {{item.y}}rpx; --b: {{item.size}}rpx; animation-delay: {{index * 60}}ms;"
                data-key="{{item.key}}" bindtap="toggleInterest" aria-role="checkbox" aria-checked="{{item.on}}" aria-label="{{item.label}}"
                hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="{{item.icon}}" size="{{item.on ? 44 : 40}}" />
          </view>
        </view>
        <view class="simple-ai__picked" wx:if="{{interestText}}">
          <text class="simple-ai__picked-t">{{interestText}}</text>
          <text class="simple-ai__picked-n">选了 {{interestCount}} 个</text>
        </view>
      </block>

      <cy-progress-status wx:if="{{aiGenerating}}" density="compact"
                          title="正在生成主题草稿" sub="完成后仍需你确认地点"
                          reduced-motion="{{reducedMotion}}" />
      <!-- P-43(2026-10-27):失败时给一个明确的重试(结果未确认时是「查看结果」),输入框里的描述原样保留 -->
      <cy-inline-error wx:elif="{{aiError}}" kind="data"
                       title="这次没能生成，你的描述已保留" sub="{{aiError}}"
                       action="{{aiIdea ? (aiDraftPending ? '查看结果' : '重试') : ''}}" bind:action="retryAiPlan" />
      <!-- 稿 F5(99:5984):额度为 0 时界面上就写「今日额度已用完」,不是等他点了才说。
           发送键已经置灰(is-exhausted),但灰着不给理由 —— 顶部那行「还可生成 0 次」
           是小字,不会有人把两件事连起来。这里同时给出路:走「专业手动」。 -->
      <cy-inline-error wx:elif="{{!aiPlan && aiQuotaLoaded && aiRemaining <= 0}}" kind="data"
                       title="今日额度已用完" sub="可改用手动创建" />

      <block wx:if="{{aiPlan && !planOpen}}">
        <view class="simple-ai__summary" wx:if="{{interestText || aiIdea}}">{{interestText ? interestText + (aiIdea ? ' · ' + aiIdea : '') : aiIdea}}</view>
        <view class="simple-ai__draft">
          <image class="simple-ai__draft-img" src="{{mode === 2 ? '/images/route_free_cover.png' : '/images/route_city_cover.png'}}" mode="aspectFill" />
          <view class="simple-ai__draft-shade"></view>
          <view class="simple-ai__draft-over">
            <text class="simple-ai__draft-t">{{aiPlan.title}}</text>
            <text class="simple-ai__draft-m">{{aiPlanNodes.length}} 站</text>
            <view class="simple-ai__draft-btn" bindtap="openDraft" aria-role="button" aria-label="打开草稿" hover-class="cy-pressed" hover-stay-time="80">打开草稿</view>
          </view>
        </view>
        <view class="simple-ai__stops">
          <view class="simple-ai__stop" wx:for="{{aiPlanNodes}}" wx:key="index" wx:for-item="node">
            <view class="simple-ai__stop-n">{{index + 1}}</view>
            <text class="simple-ai__stop-t">{{node.name}}</text>
          </view>
        </view>
      </block>

      <block wx:if="{{aiPlan && planOpen}}">
        <view class="simple-ai__section-heading">
          <text>AI 为你整理的初稿</text>
          <text class="simple-ai__section-state">可编辑</text>
        </view>
        <cy-card class="simple-ai__card">
          <text class="simple-ai__field-label">主题名称<text class="req" aria-hidden="true">*</text></text>
          <input class="simple-ai__field-input" value="{{aiPlan.title}}" bindinput="onAiPlanTitleInput" maxlength="30" aria-label="主题名称" />
          <text class="simple-ai__field-label simple-ai__field-label--space">故事简介</text>
          <textarea class="simple-ai__story" value="{{aiPlan.storyline}}" bindinput="onAiPlanStoryInput" maxlength="500" fixed="{{true}}" aria-label="故事简介" />
        </cy-card>

        <view class="simple-ai__section-heading simple-ai__section-heading--locations">
          <view>
            <text>确认地点</text>
          </view>
          <text class="simple-ai__section-count">{{ aiPlanNodes.length || 0 }} 个节点</text>
        </view>
        <cy-card class="simple-ai__node" wx:for="{{aiPlanNodes}}" wx:key="index" wx:for-item="node" wx:for-index="nodeIndex">
          <view class="simple-ai__node-head">
            <text class="simple-ai__node-num">{{nodeIndex + 1}}</text>
            <view class="simple-ai__node-copy">
              <input class="simple-ai__node-name" value="{{node.name}}" bindinput="onAiNodeNameInput" data-index="{{nodeIndex}}" maxlength="30" aria-label="第{{nodeIndex + 1 || 1}}个节点名称" />
              <textarea class="simple-ai__node-story" value="{{node.description}}" bindinput="onAiNodeStoryInput" data-index="{{nodeIndex}}" maxlength="300" fixed="{{true}}" aria-label="第{{nodeIndex + 1 || 1}}个节点故事" />
            </view>
          </view>
          <view class="simple-ai__poi {{node.confirmed ? 'is-confirmed' : ''}}" bindtap="confirmAiNodePoi" data-index="{{nodeIndex}}" aria-role="button" aria-label="第{{nodeIndex + 1 || 1}}个节点，{{node.confirmed ? '修改地点' : '确认地点'}}" hover-class="cy-pressed" hover-stay-time="80">
            <text class="simple-ai__poi-label">{{node.confirmed ? node.address : '在地图中确认地点'}}</text>
            <view class="simple-ai__poi-arrow"><cy-icon name="arrow-right" size="28" /></view>
          </view>
        </cy-card>

        <!-- 置灰 ≠ 哑巴:cy-btn 吞掉禁用态的 tap,必须显式接 disabledtap 才拿得到理由。
             enterAiEditor 的前两道守卫与 canEnterAiEditor 同判据,禁用时点它只会落 aiError 文案。 -->
        <cy-btn variant="primary" style="margin-top:var(--cy-space-4)" disabled="{{!canEnterAiEditor}}" bindtap="enterAiEditor" bind:disabledtap="enterAiEditor"><text>确认地点，进入编辑器</text><cy-icon name="arrow-right" size="28" /></cy-btn>
      </block>
    </view>
  </scroll-view>

  <view class="simple-ai__composer-wrap">
    <scroll-view class="simple-ai__chips" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{!planOpen}}">
      <view class="simple-ai__chips-track">
        <view class="simple-ai__chip" wx:for="{{aiPlan ? aiTweaks : aiPrompts}}" wx:key="*this" bindtap="useAiPrompt" data-text="{{item}}" aria-role="button" aria-label="使用灵感：{{item}}" hover-class="cy-pressed" hover-stay-time="80">{{item}}</view>
      </view>
    </scroll-view>
    <view class="simple-ai__composer">
      <textarea class="simple-ai__input" value="{{aiIdea}}" bindinput="onAiIdeaInput" maxlength="300" auto-height="{{true}}" placeholder="说说你想要的路线…" placeholder-class="simple-ai__placeholder" fixed="{{true}}" aria-label="路线灵感" />
    </view>
    <!-- W10b #22:上一次起草结果未确认时,这颗键只回读那一次(查看结果),不另起一次,也不受额度置灰影响。 -->
    <view class="simple-ai__send {{aiGenerating ? 'is-loading' : ''}} {{(!aiDraftPending && aiQuotaLoaded && aiRemaining <= 0) ? 'is-exhausted' : ''}}" bindtap="generateAiPlan" aria-role="button" aria-label="{{aiDraftPending ? '查看上一次起草结果' : '生成主题草稿'}}" aria-disabled="{{aiGenerating || (!aiDraftPending && aiQuotaLoaded && aiRemaining <= 0)}}" hover-class="{{aiGenerating || (!aiDraftPending && aiQuotaLoaded && aiRemaining <= 0) ? 'none' : 'cy-pressed'}}" hover-stay-time="80">
      <text wx:if="{{aiGenerating}}" class="simple-ai__send-t">…</text>
      <text wx:elif="{{aiDraftPending}}" class="simple-ai__send-t">查看</text>
      <view wx:else class="simple-ai__send-ic"><cy-icon name="arrow-right" size="40" /></view>
    </view>
  </view>
  </block>
</view>
