/* 地点待办:入口沿编辑器白卡行;弹层内每个地点一组 键/值 行,危险态红字 */
.lt-entry { display: flex; align-items: center; gap: var(--cy-space-2); min-height: 96rpx; margin: 0 var(--cy-page-x) var(--cy-space-3); padding: 0 var(--cy-space-4); border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-surface); color: var(--cy-color-text-primary); }
.lt-entry__t { flex: 1; font-size: var(--cy-type-body); font-weight: 600; }
.lt-entry__v { font-size: var(--cy-font-label); color: var(--cy-color-text-secondary); }
.lt-entry__v.is-bad { color: var(--cy-color-status-danger-on-interactive); }
.lt { display: block; }
.lt-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cy-space-1) var(--cy-space-3); padding: var(--cy-space-3) 0; border-bottom: 1rpx solid var(--cy-comp-sheet-role-divider); }
.lt-row__main { flex: 1; min-width: 0; }
.lt-row__addr { display: block; margin-top: 4rpx; font-size: var(--cy-font-label); color: var(--cy-color-text-secondary); }
.lt-row__st { display: block; margin-top: 4rpx; font-size: var(--cy-font-caption); color: var(--cy-color-text-tertiary); }
.lt-row__st.is-bad { color: var(--cy-color-status-danger-on-interactive); }
.lt-row:last-child { border-bottom: none; }
.lt-row__hd { display: flex; align-items: center; gap: var(--cy-space-2); }
.lt-row__t { flex: 1; min-width: 0; font-size: var(--cy-type-body); font-weight: 700; color: var(--cy-color-text-primary); }
.lt-tag { flex: none; padding: 4rpx var(--cy-space-2); border-radius: var(--cy-radius-pill); font-size: var(--cy-font-caption); color: var(--cy-color-text-secondary); background: var(--cy-color-bg-surface); }
.lt-tag--bad { color: var(--cy-color-status-danger-on-interactive); }
.lt-act { flex: none; display: flex; align-items: center; justify-content: center; min-height: var(--cy-btn-h); padding: 0 var(--cy-space-4); border-radius: var(--cy-radius-pill); border: 1rpx solid var(--cy-color-border-strong); font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-color-text-primary); }
.lt-acts { flex: none; display: flex; gap: var(--cy-space-2); }
.lt-act--ghost { border-color: transparent; background: var(--cy-color-bg-surface-subtle); }
.lt-err { display: block; width: 100%; padding-top: var(--cy-space-1); font-size: var(--cy-font-label); color: var(--cy-color-status-danger-on-interactive); }

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.lt-entry { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
.lt-act { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
.lt-act--ghost { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
