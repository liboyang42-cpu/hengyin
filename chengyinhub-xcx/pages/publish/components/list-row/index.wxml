<view class="lr {{hr ? 'lr--hr' : ''}} {{danger ? 'lr--danger' : ''}} {{add ? 'lr--add' : ''}} {{bad ? 'lr--bad' : ''}} {{disabled ? 'is-disabled' : ''}}" bindtap="onTap" aria-role="{{tappable ? 'button' : ''}}" aria-label="{{title}}{{value ? ' ' + strong + value : ''}}" hover-class="{{tappable && !disabled ? 'cy-pressed' : 'none'}}" hover-stay-time="80">
  <slot name="lead"></slot>
  <view wx:if="{{add}}" class="lr__plus"><cy-icon name="plus" size="24" /></view>
  <view wx:if="{{ok || bad}}" class="lr__st {{bad ? 'lr__st--bad' : ''}}"></view>
  <view wx:if="{{dot}}" class="lr__dot" style="background: var(--cy-color-{{dot}})"></view>
  <view class="lr__m"><text class="lr__t">{{title}}</text><slot name="main"></slot></view>
  <text wx:if="{{value || strong}}" class="lr__v"><text class="lr__vb">{{strong}}</text>{{value}}</text>
  <slot></slot>
  <view wx:if="{{chevron || fold}}" class="lr__chev {{fold && open ? 'is-open' : ''}}"><cy-icon name="chevron-right" size="28" /></view>
</view>
