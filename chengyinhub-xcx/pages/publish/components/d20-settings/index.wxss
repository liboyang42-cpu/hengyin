.dif__c--std .dif__d { -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%222%22%20stroke-linejoin%3D%22round%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M12%202.2%2020.5%207.1v9.8L12%2021.8%203.5%2016.9V7.1Z%22%2F%3E%3Cpath%20d%3D%22M12%207.6%2016.3%2015H7.7Z%22%2F%3E%3Cpath%20d%3D%22M12%202.2v5.4M3.5%2016.9%207.7%2015M20.5%2016.9%2016.3%2015M7.7%2015%2012%2021.8%2016.3%2015M3.5%207.1%2012%207.6%2020.5%207.1%22%2F%3E%3C%2Fsvg%3E"); mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%222%22%20stroke-linejoin%3D%22round%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M12%202.2%2020.5%207.1v9.8L12%2021.8%203.5%2016.9V7.1Z%22%2F%3E%3Cpath%20d%3D%22M12%207.6%2016.3%2015H7.7Z%22%2F%3E%3Cpath%20d%3D%22M12%202.2v5.4M3.5%2016.9%207.7%2015M20.5%2016.9%2016.3%2015M7.7%2015%2012%2021.8%2016.3%2015M3.5%207.1%2012%207.6%2020.5%207.1%22%2F%3E%3C%2Fsvg%3E"); }
.dif__c--hard .dif__d { -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%222.9%22%20stroke-linejoin%3D%22round%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M12%202.2%2020.5%207.1v9.8L12%2021.8%203.5%2016.9V7.1Z%22%2F%3E%3Cpath%20d%3D%22M12%207.6%2016.3%2015H7.7Z%22%2F%3E%3Cpath%20d%3D%22M12%202.2v5.4M3.5%2016.9%207.7%2015M20.5%2016.9%2016.3%2015M7.7%2015%2012%2021.8%2016.3%2015M3.5%207.1%2012%207.6%2020.5%207.1%22%2F%3E%3C%2Fsvg%3E"); mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%222.9%22%20stroke-linejoin%3D%22round%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M12%202.2%2020.5%207.1v9.8L12%2021.8%203.5%2016.9V7.1Z%22%2F%3E%3Cpath%20d%3D%22M12%207.6%2016.3%2015H7.7Z%22%2F%3E%3Cpath%20d%3D%22M12%202.2v5.4M3.5%2016.9%207.7%2015M20.5%2016.9%2016.3%2015M7.7%2015%2012%2021.8%2016.3%2015M3.5%207.1%2012%207.6%2020.5%207.1%22%2F%3E%3C%2Fsvg%3E"); }
.dif__n { font-size: var(--cy-type-card-title); font-weight: 700; line-height: 1.2; }
.dif__p { display: flex; gap: 8rpx; }
.dif__dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; }
.dif__dot.is-off { background: transparent; box-shadow: inset 0 0 0 2rpx currentColor; opacity: .45; }
@media (prefers-reduced-motion: reduce) { .dif__c { transition: none; } }

/* 就地展开 */
.xp__row { position: relative; display: flex; align-items: center; min-height: 92rpx; padding: var(--cy-space-2) var(--cy-space-4); box-sizing: border-box; background: var(--cy-color-bg-surface); }
.xp__row--hr::before { content: ""; position: absolute; left: var(--cy-space-4); right: 0; top: 0; height: 1px; background: var(--cy-color-border-subtle); }
.xp__del { position: relative; display: flex; align-items: center; min-height: 92rpx; padding: 0 var(--cy-space-4); font-size: var(--cy-type-body); color: var(--cy-color-status-danger); }
.xp__del::before { content: ""; position: absolute; left: var(--cy-space-4); right: 0; top: 0; height: 1px; background: var(--cy-color-border-subtle); }
.xp__in { flex: 1 1 auto; min-width: 0; text-align: right; font-size: var(--cy-type-body); color: var(--cy-color-text-primary); }
.xp__in--l { text-align: left; }
.xp__field { position: relative; display: flex; align-items: center; gap: var(--cy-space-2); min-height: 100rpx; padding: 0 var(--cy-space-4); background: var(--cy-color-bg-surface); }
.xp__go { flex: none; min-height: 88rpx; display: flex; align-items: center; font-size: var(--cy-type-button); font-weight: 600; color: var(--cy-color-text-primary); }
.xp__go.is-off { color: var(--cy-color-text-disabled); }

/* 组件样式隔离,全局 .cy-pressed 进不来,本地补一份(同 cy-card) */
.cy-pressed { opacity: .88; }
