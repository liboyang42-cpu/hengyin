/* 和主题详情同一个灰底面板(node-sheet-host 的那一句,组件里要自己写) */
.d20-host { --cy-comp-sheet-role-glass: var(--cy-comp-sheet-role-page); }
.d20 { padding-bottom: var(--cy-space-3); }

/* 规则难度:三张大卡,选中的填满强调色、微微浮起,点一下回弹 */
.dif { display: flex; gap: 20rpx; padding-top: 4rpx; }
.dif__c {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 8rpx 28rpx;
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-bg-surface);
  box-shadow: inset 0 0 0 1px var(--cy-color-border-strong);
  color: var(--cy-color-text-primary);
  transition: transform var(--cy-motion-expand) var(--cy-ease-spring), box-shadow var(--cy-motion-expand) var(--cy-ease-standard), background-color var(--cy-motion-fast) var(--cy-ease-standard), color var(--cy-motion-fast) var(--cy-ease-standard);
}
.dif__c.is-on { background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); box-shadow: 0 20rpx 44rpx rgba(0, 0, 0, .16), 0 4rpx 12rpx rgba(0, 0, 0, .10); transform: translateY(-6rpx); } /* ds-ok 选中的难度卡微微浮起(原型 dif__c.is-on) */
.dif__c:active { transform: scale(.96); }
/* 点中那一下:放大一点再由 spring 缓动回位,就是回弹;减少动态效果时没有过渡也就不弹 */
.dif__c.is-on.is-tap { transform: translateY(-6rpx) scale(1.04); }
.is-ro .dif__c { pointer-events: none; }
.is-ro .dif__c:not(.is-on) { opacity: .45; }
/* d20 线稿走 mask,越难线越粗 */
.dif__d { width: 68rpx; height: 68rpx; background-color: currentColor; -webkit-mask-size: 100% 100%; mask-size: 100% 100%; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }
