<cy-card class="pt-card">
  <view class="pt-label">玩家选择汇总</view>
  <view class="pt-hint">只统计人数和占比，不显示是谁选的。</view>
  <view class="pt-hint" wx:if="{{loading}}">读取中…</view>
  <cy-inline-error kind="error" wx:elif="{{error}}" title="{{error}}" action="重试" bind:action="retry" />
  <block wx:else>
    <view class="pt-total">已有 {{total}} 份回答</view>
    <view class="pt-hint" wx:if="{{!enough}}">满 {{min}} 份回答后显示每个结果的占比。</view>
    <view class="pt-row" wx:for="{{rows}}" wx:key="code">
      <view class="pt-row__head"><text class="pt-row__title">{{item.title}}</text><text class="pt-row__num">{{item.responses}} 人 · {{item.percent}}%</text></view>
      <view class="pt-bar"><view class="pt-bar__fill" style="width: {{item.percent}}%"></view></view>
    </view>
  </block>
</cy-card>
