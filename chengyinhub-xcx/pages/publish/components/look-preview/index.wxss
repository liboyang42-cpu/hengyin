/* 组件样式隔离,全局 .cy-pressed 进不来,本地定义一份(同 ai-assist)。 */
.cy-pressed { opacity: .88; }
/* 常驻在面板顶部时不留半屏的下边距,高度让位给下面的风格与预设 */
.lp--embedded { padding-bottom: 0; }
.lp--embedded .lp__frame { height: 480rpx; }
/* 末世:第一章的时间段,与玩家页同一层天光 */
.lpv.look--survival.look-time--dawn { background-image: linear-gradient(180deg, rgba(70,100,160,.35) 0%, rgba(240,180,140,.28) 100%); } /* ds-ok */
.lpv.look--survival.look-time--noon { background-image: linear-gradient(180deg, rgba(255,255,255,.10) 0%, rgba(255,250,225,.06) 100%); } /* ds-ok */
.lpv.look--survival.look-time--dusk { background-image: linear-gradient(180deg, rgba(60,40,110,.35) 0%, rgba(240,130,70,.42) 100%); } /* ds-ok */
.lpv.look--survival.look-time--night { background-image: linear-gradient(180deg, rgba(0,4,16,.45) 0%, rgba(0,4,16,.2) 100%); } /* ds-ok */
.lp__fx--front { z-index: 2; pointer-events: none; }

/* ===== 故事文字动效:与玩家页 pages/play/index.wxss 同一套(选择器从 .chfull__para 换成 .lp__story);选了就在示例正文上重播一次。
   浮现 = 原有 st-line 显形,不另写;逐字类把一段拆成 .tfx__c 单字。只用过渡 + 逐字延迟,不新增关键帧。 */
.tfx__c{ display:inline-block; white-space:pre; }
/* 逐字类:整段本身立即可见,显形交给每个字 */
.lp__story.tfx--type, .lp__story.tfx--ink, .lp__story.tfx--gather, .lp__story.tfx--drop, .lp__story.tfx--wind, .lp__story.tfx--signal, .lp__story.tfx--decode{ opacity:1; transform:none; filter:none; }
/* 打字机:一字一字立刻出现 */
.tfx--type .tfx__c{ opacity:0; transition:opacity 0s linear calc(var(--i) * 70ms); }
.tfx--type.is-in .tfx__c{ opacity:1; }
/* 墨晕:字从洇开的墨里收拢成形 */
.tfx--ink .tfx__c{ opacity:0; filter:blur(14rpx); transform:scale(1.35); transition:opacity .9s ease calc(var(--i) * 45ms), filter 1.2s ease calc(var(--i) * 45ms), transform 1.2s cubic-bezier(.22,1,.36,1) calc(var(--i) * 45ms); }
.tfx--ink.is-in .tfx__c{ opacity:1; filter:none; transform:none; }
/* 聚星:每个字从四散的星点聚过来 */
.tfx--gather .tfx__c{ opacity:0; filter:blur(8rpx); transform:translate(var(--dx), var(--dy)) scale(.3); transition:opacity 1s ease calc(var(--r) * 900ms), filter 1.2s ease calc(var(--r) * 900ms), transform 1.6s cubic-bezier(.16,1,.3,1) calc(var(--r) * 900ms); }
.tfx--gather.is-in .tfx__c{ opacity:1; filter:none; transform:none; }
/* 落定:每个字从上方落下,轻轻回弹 */
.tfx--drop .tfx__c{ opacity:0; transform:translateY(-32rpx); transition:opacity .4s ease calc(var(--i) * 40ms), transform .7s cubic-bezier(.34,1.56,.64,1) calc(var(--i) * 40ms); }
.tfx--drop.is-in .tfx__c{ opacity:1; transform:none; }
/* 风吹:字顺着风从右边斜着吹进来 */
.tfx--wind .tfx__c{ opacity:0; filter:blur(6rpx); transform:translateX(68rpx) skewX(-18deg); transition:opacity .6s ease calc(var(--i) * 35ms), filter .8s ease calc(var(--i) * 35ms), transform .9s cubic-bezier(.22,1,.36,1) calc(var(--i) * 35ms); }
.tfx--wind.is-in .tfx__c{ opacity:1; filter:none; transform:none; }
/* 信号:像接收不稳的电台,闪几下才稳住 */
.tfx--signal .tfx__c{ opacity:0; transition:opacity .9s steps(5, jump-both) calc(var(--r) * 700ms); }
.tfx--signal.is-in .tfx__c{ opacity:1; }
/* 解码:乱码逐字还原(play-look _decodeLine 换字符),还没还原的字用强调色 */
.tfx--decode .tfx__c.is-raw{ color:var(--look-b); opacity:.75; }
/* 呼吸光:整段淡入后亮一下 */
.lp__story.tfx--glow{ transform:none; filter:none; transition:opacity 1.2s ease, text-shadow 1.4s ease .6s; }
.lp__story.tfx--glow.is-in{ text-shadow:0 0 30rpx var(--look-a); }
/* 擦出:从左到右揭开 */
.lp__story.tfx--wipe{ opacity:1; transform:none; filter:none; clip-path:inset(0 100% 0 0); transition:clip-path 1.3s cubic-bezier(.65,0,.35,1); }
.lp__story.tfx--wipe.is-in{ clip-path:inset(0 0 0 0); }
/* 雾散:很虚的一整段,慢慢变清楚 */
.lp__story.tfx--fog{ transform:none; filter:blur(28rpx); letter-spacing:.25em; transition:opacity 2s ease, filter 2.6s ease, letter-spacing 2.6s ease; }
.lp__story.tfx--fog.is-in{ filter:none; letter-spacing:0; }
/* 霓虹点亮:灯管通电,闪两下亮起 */
.lp__story.tfx--neon{ transform:none; filter:none; transition:opacity .6s steps(4, jump-both); }
.lp__story.tfx--neon.is-in{ text-shadow:0 0 28rpx var(--look-a); }
/* 扫描:一道扫描线从上到下扫过,扫过的地方才出现 */
.lp__story.tfx--scan{ opacity:1; transform:none; filter:none; clip-path:inset(0 0 100% 0); transition:clip-path 1s linear; }
.lp__story.tfx--scan.is-in{ clip-path:inset(0 0 0 0); }
