.binding { color: var(--cy-color-text-primary); font-size: var(--cy-type-body); }
.binding__title { display:block; font-weight:600; margin:var(--cy-space-2) 0; }
.binding__hint { display:block; color:var(--cy-color-text-secondary); line-height:1.6; }
.binding__option { display:flex; align-items:center; min-height:var(--cy-btn-h); }
.binding__conflict { padding:var(--cy-space-2) 0; border-bottom:1rpx solid var(--cy-color-border-subtle); line-height:1.6; }
.binding__actions { display:flex; flex-wrap:wrap; gap:var(--cy-space-2); margin:var(--cy-space-2) 0; }
.binding__act { flex:1 1 auto; min-width:0; }
