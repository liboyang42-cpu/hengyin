<view class="rules">
  <button class="rules__toggle" bindtap="toggle" aria-expanded="{{expanded}}">条件与效果 · {{summary}}</button>
  <view wx:if="{{expanded}}">
    <text class="rules__hint">条件全部满足时可走此分支；效果按配置顺序执行。未完成的输入会保存在本机，完成时再校验。</text>
    <view wx:for="{{rows}}" wx:key="path" wx:for-item="row" class="rules__row rules__depth-{{row.depth}}">
      <text class="rules__hint">{{row.kind === 'condition' ? '条件' : '效果'}}</text>
      <picker range="{{row.types}}" value="{{row.typeIndex}}" range-key="label" data-path="{{row.path}}" bindchange="op"><view class="rules__select">{{row.label}} ▾</view></picker>
      <view wx:for="{{row.fields}}" wx:key="key" wx:for-item="field" class="rules__field">
        <text>{{field.label}}</text>
        <picker wx:if="{{field.kind === 'pick'}}" range="{{field.options}}" value="{{field.selectedIndex}}" range-key="label" data-path="{{row.path}}" data-key="{{field.key}}" bindchange="pick"><view class="rules__select">{{field.display}} ▾</view></picker>
        <text wx:if="{{field.kind === 'pick' && !field.options.length}}" class="rules__hint">暂无可选项，请先完成对应节点或数值配置。</text>
        <input wx:if="{{field.kind !== 'pick'}}" value="{{field.value}}" type="text" maxlength="512" data-path="{{row.path}}" data-key="{{field.key}}" bindinput="input" aria-label="{{field.label}}" placeholder="请输入" />
      </view>
      <button wx:if="{{row.canAdd}}" data-path="{{row.path}}" bindtap="child">添加子条件</button>
      <button data-path="{{row.path}}" bindtap="remove" aria-label="删除{{row.label}}">删除此{{row.kind === 'condition' ? '条件' : '效果'}}</button>
    </view>
    <button bindtap="reset">撤销未完成的规则修改</button>
    <text wx:if="{{error}}" class="rules__error" aria-role="alert">{{error}}</text>
    <view class="rules__actions"><button data-kind="condition" bindtap="add">添加条件</button><button data-kind="effect" bindtap="add">添加效果</button></view>
  </view>
</view>
