      </block>
      <view class="cg-cfg-hint" wx:if="{{effectRows['check.successEffects'][ei].missing}}">数值已删除，请重选</view>
      <cy-dropdown portal="{{false}}" range="{{resourceEffectOps}}" range-key="label" value="{{opt.idx(resourceEffectOps, eff.op)}}" data-path="check.successEffects" data-index="{{ei}}" bind:change="pickEffectOp"><view class="cg-pick {{opt.idx(resourceEffectOps, eff.op) < 0 ? 'empty' : ''}}">{{opt.label(resourceEffectOps, eff.op)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
      <input class="cg-cfg-input" type="number" value="{{eff.value}}" placeholder="数量 1 至 999" data-path="check.successEffects" data-index="{{ei}}" data-field="value" bindinput="updateEffectField" />
      <cy-inline-error wx:if="{{opt.rowErr(effectErrors, 'check.successEffects', ei)}}" title="{{opt.rowErr(effectErrors, 'check.successEffects', ei)}}" />
    </block>
    <block wx:else>
    <input class="cg-cfg-input" value="{{eff.var}}" placeholder="变量名，如 counter.energy"
           data-path="check.successEffects" data-index="{{ei}}" data-field="var" bindinput="updateEffectField" />
    <cy-dropdown portal="{{false}}" range="{{effectOps}}" range-key="label" value="{{opt.idx(effectOps, eff.op)}}" data-path="check.successEffects" data-index="{{ei}}" bind:change="pickEffectOp"><view class="cg-pick">{{opt.label(effectOps, eff.op)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
    <input class="cg-cfg-input" type="{{eff.op === 'ADD_TAG' ? 'text' : 'number'}}" value="{{eff.value}}"
           placeholder="{{eff.op === 'ADD_TAG' ? 'tag.hurried（tag. 开头）' : '1'}}"
           data-path="check.successEffects" data-index="{{ei}}" data-field="value" bindinput="updateEffectField" />
    </block>
    </view>

    <view class="cg-cfg-label" wx:if="{{advanced.check.failEffects.length}}">判定失败后的效果</view>
    <view class="cg-adv-repeat" wx:for="{{advanced.check.failEffects}}" wx:key="index" wx:for-index="ei" wx:for-item="eff">
    <view class="cg-adv-repeat-head">
      <text>效果 {{ei + 1}}</text>
      <view class="cg-adv-del" data-path="check.failEffects" data-index="{{ei}}" bindtap="removeEffectRow" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
    </view>
    <!-- R3 协调者界面：新行选“需要的数值”（模板内声明，采用到主题时再对应），操作只有增加/恢复到至少；旧/高级行保留原变量输入 -->
    <block wx:if="{{!effectRows['check.failEffects'][ei].legacy}}">
      <view class="cg-cfg-hint" wx:if="{{effectResourceDisabledReason}}">{{effectResourceDisabledReason}}</view>
      <cy-dropdown portal="{{false}}" range="{{effectValueSlots}}" range-key="label" value="{{opt.idx(effectValueSlots, eff.var)}}" data-path="check.failEffects" data-index="{{ei}}" bind:change="pickEffectResource"><view class="cg-pick {{effectRows['check.failEffects'][ei].label ? '' : 'empty'}}" aria-role="button" aria-label="选择需要的数值">{{effectRows['check.failEffects'][ei].label || '选择需要的数值'}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
      <block wx:if="{{effectResourceDraft && effectResourceDraft.path === 'check.failEffects' && effectResourceDraft.index === ei}}">
        <input class="cg-cfg-input" value="{{effectResourceDraft.label}}" maxlength="20" placeholder="给需要的数值起名（1 至 20 字），采用到主题时再对应" data-field="label" bindinput="updateEffectResourceField" />
        <view class="cg-tool-actions cg-effect-draft-actions"><view bindtap="saveEffectResource" aria-role="button" aria-label="确认新建需要的数值" hover-class="cy-pressed" hover-stay-time="80">确认</view><view bindtap="closeEffectResource" aria-role="button" aria-label="取消新建" hover-class="cy-pressed" hover-stay-time="80">取消</view></view>
        <cy-inline-error wx:if="{{effectResourceError}}" title="{{effectResourceError.error}}" />
      </block>
      <view class="cg-cfg-hint" wx:if="{{effectRows['check.failEffects'][ei].missing}}">数值已删除，请重选</view>
      <cy-dropdown portal="{{false}}" range="{{resourceEffectOps}}" range-key="label" value="{{opt.idx(resourceEffectOps, eff.op)}}" data-path="check.failEffects" data-index="{{ei}}" bind:change="pickEffectOp"><view class="cg-pick {{opt.idx(resourceEffectOps, eff.op) < 0 ? 'empty' : ''}}">{{opt.label(resourceEffectOps, eff.op)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
      <input class="cg-cfg-input" type="number" value="{{eff.value}}" placeholder="数量 1 至 999" data-path="check.failEffects" data-index="{{ei}}" data-field="value" bindinput="updateEffectField" />
      <cy-inline-error wx:if="{{opt.rowErr(effectErrors, 'check.failEffects', ei)}}" title="{{opt.rowErr(effectErrors, 'check.failEffects', ei)}}" />
    </block>
    <block wx:else>
    <input class="cg-cfg-input" value="{{eff.var}}" placeholder="变量名，如 counter.energy"
           data-path="check.failEffects" data-index="{{ei}}" data-field="var" bindinput="updateEffectField" />
    <cy-dropdown portal="{{false}}" range="{{effectOps}}" range-key="label" value="{{opt.idx(effectOps, eff.op)}}" data-path="check.failEffects" data-index="{{ei}}" bind:change="pickEffectOp"><view class="cg-pick">{{opt.label(effectOps, eff.op)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
    <input class="cg-cfg-input" type="{{eff.op === 'ADD_TAG' ? 'text' : 'number'}}" value="{{eff.value}}"
           placeholder="{{eff.op === 'ADD_TAG' ? 'tag.hurried（tag. 开头）' : '1'}}"
           data-path="check.failEffects" data-index="{{ei}}" data-field="value" bindinput="updateEffectField" />
    </block>
    </view>
    <view class="cg-ios-grp cg-ios-gap">
      <view class="cg-ios-row is-static"><view class="cg-ios-m"><text class="cg-ios-t">幸运</text></view><cy-switch checked="{{luckIndex >= 0}}" bindchange="toggleLuck" accessibility-label="幸运" /></view>
      <block wx:if="{{luckIndex >= 0}}">
        <view class="cg-ios-row" data-open="luck" bindtap="toggleCheckRow" aria-role="button" aria-label="幸运加分" aria-expanded="{{checkOpen === 'luck'}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">幸运加分</text></view><text class="cg-ios-v">{{checkView.luckLabel}}</text><view class="cg-ios-fold {{checkOpen === 'luck' ? 'is-open' : ''}}"><cy-icon name="chevron-right" size="28" /></view></view>
        <block wx:if="{{checkOpen === 'luck'}}">
          <view class="cg-ios-row" wx:for="{{luckOptions}}" wx:key="label" data-index="{{index}}" bindtap="onLuckPick" aria-role="button" aria-label="{{item.label}}" aria-selected="{{luckIndex === index}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">{{item.label}}</text></view><view class="cg-ios-chk {{luckIndex === index ? 'is-on' : ''}}"><cy-icon name="check" size="28" /></view></view>
        </block>
      </block>
      <view class="cg-ios-row is-static"><view class="cg-ios-m"><text class="cg-ios-t">生命值越低越困难</text></view><cy-switch checked="{{hpLadderOn}}" bindchange="toggleHpLadder" accessibility-label="生命值越低越困难" /></view>
    </view>
      </view>
      </view>
    </view>

    <view class="cg-gcfg" wx:if="{{gameSection === 'album'}}">
    <view class="cg-adv-body">
      <view class="cg-cfg-label">照片（1 至 6 张） <text class="req" aria-hidden="true">*</text></view>
      <view class="cg-adv-repeat" wx:for="{{advanced.album.images}}" wx:key="index" wx:for-index="ai">
        <view class="cg-adv-repeat-head"><text>照片 {{ai + 1}}</text><view class="cg-adv-del" data-index="{{ai}}" bindtap="removeAlbumImage" aria-role="button" aria-label="删除第{{(ai + 1) || 1}}张照片" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
        <view class="cg-qmedia cg-qmedia--one">
          <view class="cg-qmedia-slot" data-index="{{ai}}" bindtap="chooseAlbumImage" aria-role="button" aria-label="替换第{{(ai + 1) || 1}}张照片" hover-class="cy-pressed" hover-stay-time="80"><image class="cg-qmedia-img" src="{{item.url}}" mode="aspectFill" /></view>
        </view>
        <input class="cg-cfg-input" value="{{item.line}}" maxlength="40" placeholder="这一张的配文" data-index="{{ai}}" bindinput="onAlbumLine" aria-label="第{{(ai + 1) || 1}}张照片配文" />
      </view>
      <view class="cg-adv-add" wx:if="{{advanced.album.images.length < 6}}" bindtap="chooseAlbumImage" aria-role="button" aria-label="添加照片" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加照片</view>
    </view>
    </view>

    <view class="cg-gcfg" wx:if="{{gameSection === 'note'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.note.title}}" placeholder="例如 写一句留给下一个人" data-section="note" data-field="title" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">提示词 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.note.prompt}}" placeholder="例如 你看到窗外什么" data-section="note" data-field="prompt" bindinput="onAdvancedField" />
    <view class="cg-adv-grid">
    <view><view class="cg-cfg-label">最多几个字</view><input class="cg-cfg-input" type="number" value="{{advanced.note.maxLength}}" placeholder="40" data-section="note" data-field="maxLength" data-numeric="1" bindinput="onAdvancedField" /></view>
    <view><view class="cg-cfg-label">展示条数（0–5）</view><input class="cg-cfg-input" type="number" value="{{advanced.note.showPrevious}}" placeholder="3" data-section="note" data-field="showPrevious" data-numeric="1" bindinput="onAdvancedField" /></view>
    </view>
    <view class="cg-cfg-label">预设短句（最多 6 条）</view>
    <view class="cg-adv-repeat" wx:for="{{advanced.note.presets}}" wx:key="index" wx:for-index="pi">
    <view class="cg-adv-repeat-head"><text>短句 {{pi + 1}}</text><view class="cg-adv-del" data-index="{{pi}}" bindtap="removeNotePreset" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
    <input class="cg-cfg-input" value="{{item}}" placeholder="例如 天是灰的" data-index="{{pi}}" bindinput="updateNotePreset" />
    </view>
    <view class="cg-adv-add" wx:if="{{advanced.note.presets.length < 6}}" bindtap="addNotePreset" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加短句</view>
    <view><view class="cg-cfg-label">奖励分</view><input class="cg-cfg-input" type="number" value="{{advanced.note.xp}}" placeholder="0 表示不给分" data-section="note" data-field="xp" data-numeric="1" bindinput="onAdvancedField" /></view>
      </view>
    </view>

    <view class="cg-gcfg" wx:if="{{gameSection === 'typeIn'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.typeIn.title}}" placeholder="例如 打出这行字" data-section="typeIn" data-field="title" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">要打的那行字（1 至 40 字） <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.typeIn.target}}" placeholder="例如 hello world" data-section="typeIn" data-field="target" bindinput="onAdvancedField" />
    <view class="cg-adv-grid" wx:if="{{advanced.outcomeRules.version !== 1}}">
    <view><view class="cg-cfg-label">限时（3 至 120 秒） <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" type="number" value="{{advanced.typeIn.seconds}}" placeholder="10" data-section="typeIn" data-field="seconds" data-numeric="1" bindinput="onAdvancedField" /></view>
    <view><view class="cg-cfg-label">次数上限（0 = 不限）</view><input class="cg-cfg-input" type="number" value="{{advanced.typeIn.tries}}" placeholder="0" data-section="typeIn" data-field="tries" data-numeric="1" bindinput="onAdvancedField" /></view>
    </view>
    <block wx:else><view class="cg-cfg-label">次数上限（0 = 不限）</view><input class="cg-cfg-input" type="number" value="{{advanced.typeIn.tries}}" placeholder="0" data-section="typeIn" data-field="tries" data-numeric="1" bindinput="onAdvancedField" /></block>
    <view class="cg-rw-line compact"><view class="cg-rw-name">区分大小写</view><cy-switch checked="{{advanced.typeIn.caseSensitive}}" data-key="typeIn.caseSensitive" bindchange="onAdvancedSubToggle" /></view>
    <view class="cg-rw-line compact"><view class="cg-rw-name">终端样式（黑底白字，打对后整屏收成一条线）</view><cy-switch checked="{{advanced.typeIn.terminalSkin}}" data-key="typeIn.terminalSkin" bindchange="onAdvancedSubToggle" /></view>
    <view><view class="cg-cfg-label">奖励分</view><input class="cg-cfg-input" type="number" value="{{advanced.typeIn.xp}}" placeholder="0 表示不给分" data-section="typeIn" data-field="xp" data-numeric="1" bindinput="onAdvancedField" /></view>
      </view>
    </view>


    <!-- 「按这份配置试玩」:原型 §1.1 —— 没选玩法时整条不出现,
       而不是灰着摆在那儿再写一句话解释它为什么不能用。 -->
    <view class="cg-adv-repeat cg-resource-slots" wx:if="{{advanced.interactionRules.resourceSlots.length}}">
    <view class="cg-adv-repeat-head">需要的资源</view>

    <view class="cg-cfg-hint" wx:for="{{advanced.interactionRules.resourceSlots}}" wx:key="key" wx:for-item="slot">{{slot.kind === 'VALUE' ? '数值' : '物资'}} · {{slot.label}}</view>
    </view>
    <cy-inline-error class="cg-inline-error" wx:if="{{supportError || advancedConfigError || errors.advanced}}" title="{{supportError || advancedConfigError || errors.advanced}}" />
    <view class="cg-advanced" wx:if="{{gameKey !== 'album'}}">
    <view class="cg-gcfg cg-adv-section" wx:if="{{advanced.blindTaste.enabled}}">
      <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">闭眼盲品</view></view><cy-switch checked="{{advanced.blindTaste.enabled}}" data-key="blindTaste" bindchange="onAdvancedToggle" /></view>
      <view class="cg-adv-body" wx:if="{{advanced.blindTaste.enabled}}">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.blindTaste.title}}" placeholder="例如 闭上眼 先尝再猜" data-section="blindTaste" data-field="title" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">步骤说明</view>
    <textarea class="cg-cfg-textarea" value="{{advanced.blindTaste.steps}}" placeholder="① 向店员领盲品小样 ② 闭眼尝 ③ 睁眼作答" data-section="blindTaste" data-field="steps" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">旁白</view>
    <input class="cg-cfg-input" value="{{advanced.blindTaste.hint}}" placeholder="例如 别偷看，舌头比眼睛诚实" data-section="blindTaste" data-field="hint" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">选项与正确答案</view>
    <view class="cg-adv-repeat" wx:for="{{advanced.blindTaste.options}}" wx:key="index" wx:for-index="bi">
    <view class="cg-adv-repeat-head">
      <text>选项 {{bi + 1}}</text>
      <view class="cg-adv-del" data-index="{{bi}}" bindtap="removeBlindOption" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
    </view>
    <input class="cg-cfg-input" value="{{item.key}}" placeholder="选项 key，如 A" data-index="{{bi}}" data-field="key" bindinput="updateBlindOption" />
    <input class="cg-cfg-input" value="{{item.label}}" placeholder="玩家看到的文案" data-index="{{bi}}" data-field="label" bindinput="updateBlindOption" />
    <view class="cg-choice-li cg-adv-correct"
      data-key="{{item.key}}" bindtap="setBlindAnswer"
      aria-role="radio" aria-checked="{{advanced.blindTaste.answerKey === item.key}}"
      aria-label="把选项 {{item.key}} 设为正确答案"
      hover-class="cy-pressed" hover-stay-time="80">
      <view class="cg-choice-radio"><icon wx:if="{{advanced.blindTaste.answerKey === item.key}}" type="success" size="20" /><icon wx:else type="circle" size="20" color="var(--cy-color-text-tertiary)" /></view>
      <text>{{advanced.blindTaste.answerKey === item.key ? '正确答案' : '设为正确答案'}}</text>
    </view>
    </view>
    <view class="cg-adv-add" bindtap="addBlindOption" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加选项</view>
    <view class="cg-cfg-label">奖励分</view>
    <input class="cg-cfg-input" type="number" value="{{advanced.blindTaste.xp}}" placeholder="0 表示不给分" data-section="blindTaste" data-field="xp" data-numeric="1" bindinput="onAdvancedField" />
      </view>
    </view>
    <view class="cg-gcfg cg-adv-section" wx:if="{{advanced.dailySign.enabled}}">
      <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">今日城市签</view></view><cy-switch checked="{{advanced.dailySign.enabled}}" data-key="dailySign" bindchange="onAdvancedToggle" /></view>
      <view class="cg-adv-body" wx:if="{{advanced.dailySign.enabled}}">
    <view class="cg-cfg-label">开场签 <text class="req" wx:if="{{!formData.originalTemplateId}}" aria-hidden="true">*</text></view>
    <view class="cg-adv-repeat" wx:for="{{dailySignDrafts}}" wx:key="index" wx:for-index="pi">
    <view class="cg-adv-repeat-head">
      <text>开场签 {{pi + 1}}</text>
      <view class="cg-adv-del" data-index="{{pi}}" bindtap="removeDailyPoem" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
    </view>
    <textarea class="cg-cfg-textarea" value="{{item}}" placeholder="一行一句，最多 4 行，每行 24 字以内" data-index="{{pi}}" bindinput="updateDailyPoem" />
    </view>
    <view class="cg-adv-add" bindtap="addDailyPoem" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加开场签</view>
    <view class="cg-cfg-label">开场签落款</view>
    <input class="cg-cfg-input" value="{{advanced.dailySign.signer}}" placeholder="例如 店主老王" data-section="dailySign" data-field="signer" bindinput="onAdvancedField" />
      </view>
    </view>
    <!-- 放宽改的是限时 / 打字 / 排序 / 比价这些玩法的容错面,所以跟「限时挑战」放在一起,
     不放检定段:检定模板本身没有可放宽的东西(2026-09-23 走查 W-01)。 -->
    <view class="cg-gcfg cg-adv-section" wx:if="{{relaxOptions.length}}">
      <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">状态不好时松一点</view></view><cy-switch checked="{{relaxIndex >= 0}}" bindchange="toggleRelax" /></view>
      <cy-dropdown portal="{{false}}" wx:if="{{relaxIndex >= 0}}" class="cg-adv-reveal" range="{{relaxOptions}}" range-key="label" value="{{relaxIndex}}" bind:change="onRelaxPick"><view class="cg-pick">{{relaxOptions[relaxIndex].label}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
    </view>
    </view>

    <view class="cg-try" wx:if="{{gameKey && gameCurrent.section}}" bindtap="tryCurrentGame"
        aria-role="button" aria-label="按这份配置试玩" hover-class="cy-pressed" hover-stay-time="80">
    <cy-icon name="play" size="32" />按这份配置试玩
    </view>

    <!-- 结果合同:这一关能产出哪些路线结果。跟着选中的玩法走,所以排在配置后面 -->
    <view class="cg-outcome-contract" wx:if="{{gameKey && gameKey !== 'album'}}">
    <view class="cg-cfg-label">可触发的结果</view>
    <view class="cg-outcome-row" wx:for="{{outcomePreview}}" wx:key="code">
      <text class="cg-outcome-label">{{item.label}}</text>
    </view>
    <cy-inline-error class="cg-inline-error" wx:for="{{outcomeContractErrors}}" wx:key="sourceKey" title="{{item.message}}" />
    </view>

    <!-- 文字问答 -->
    <cy-card class="cg-cfg" wx:if="{{ !advanced.qa.enabled && formData.validationMethod === 1 }}">
    <view class="cg-cfg-label">问题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{ formData.questionName }}" bindinput="onQuestionNameChange"
      placeholder="例如:这座桥建于哪一年?" placeholder-class="cg-ph" />
    <view class="cg-cfg-label">正确答案 <text class="req" wx:if="{{!formData.originalTemplateId}}" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{ formData.questionAnswer }}" bindinput="onQuestionAnswerChange"
      placeholder="可填多个，用、分隔" placeholder-class="cg-ph" />
    </cy-card>

    <!-- 选项问答 -->
    <cy-card class="cg-cfg" wx:if="{{ !advanced.qa.enabled && formData.validationMethod === 3 }}">
    <view class="cg-cfg-label">问题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{ optionQuestion }}" bindinput="onOptionQuestionChange"
      placeholder="例如:石碑上的图案象征什么?" placeholder-class="cg-ph" />
    <view class="cg-cfg-label">选项 · 点圆圈设为正确答案</view>
    <view class="cg-choice-list">
      <view class="cg-choice-item" wx:for="{{ optionItems }}" wx:key="letter" wx:for-item="opt" wx:for-index="oi">
        <view class="cg-choice-li">
          <view class="cg-choice-radio {{ opt.isCorrect ? 'on' : '' }}" bindtap="pickCorrectOption" data-index="{{ oi }}"
            aria-role="radio" aria-checked="{{opt.isCorrect}}" aria-label="设为正确答案 {{opt.letter}}" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon wx:if="{{opt.isCorrect}}" name="check" size="32" /><text wx:else class="cg-choice-radio__glyph">{{opt.letter}}</text>
          </view>
          <input class="cg-cfg-input flat" value="{{ opt.text }}" bindinput="onOptionTextChange" data-index="{{ oi }}"
            placeholder="选项 {{ opt.letter }}" placeholder-class="cg-ph" />
          <view class="cg-choice-del" catchtap="deleteOption" data-index="{{ oi }}" wx:if="{{ optionItems.length > 2 }}" aria-role="button" aria-label="删除选项 {{opt.letter}}" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="close-sm" size="32" />
          </view>
        </view>
        <!-- 选项媒体:配了就显示缩略图/已配标记,没配是两个轻量的加号 -->
        <view class="cg-opt-media">
          <view wx:if="{{ opt.img }}" class="cg-opt-thumb-hit" catchtap="uploadOptionImg" data-index="{{ oi }}"
            aria-role="button" aria-label="更换选项 {{opt.letter}} 配图" hover-class="cy-pressed" hover-stay-time="80">
            <image class="cg-opt-thumb" src="{{ opt.img }}" mode="aspectFill" />
          </view>
          <view wx:else class="cg-opt-chip" catchtap="uploadOptionImg" data-index="{{ oi }}" aria-role="button" aria-label="上传选项 {{opt.letter}} 配图" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="plus" size="24" /><text class="cg-opt-chip__visual">配图</text>
          </view>
          <view class="cg-opt-chip {{ opt.audio ? 'on' : '' }}" catchtap="uploadOptionAudio" data-index="{{ oi }}" aria-role="button" aria-label="配置选项 {{opt.letter}} 音频" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="{{opt.audio ? 'check' : 'plus'}}" size="24" /><text class="cg-opt-chip__visual">音频</text>
          </view>
          <view class="cg-opt-chip cg-opt-chip--clear" wx:if="{{ opt.img || opt.audio }}"
            catchtap="clearOptionMedia" data-index="{{ oi }}" aria-role="button" aria-label="清除选项 {{opt.letter}} 媒体" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="close-sm" size="24" />
          </view>
        </view>
      </view>
    </view>
    <view class="cg-cfg-add" wx:if="{{ optionItems.length < 4 }}" bindtap="addChoiceOption" aria-role="button" aria-label="添加选项" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加选项</view>
    </cy-card>

    <!-- 偏好题组：结构化 JSON 是服务端合同真源；这里即时展开全部结果分支，提审前必须看完。 -->
    <cy-card id="pref-config" class="cg-cfg" wx:if="{{ !advanced.qa.enabled && formData.validationMethod === 6 }}">
    <view class="cg-cfg-label">偏好题配置</view>
    <textarea class="cg-cfg-textarea cg-pref-json" value="{{ formData.preferenceJson }}"
      bindinput="onPreferenceJsonChange" maxlength="-1"
      placeholder="填写 steps / dimensions / results / tagOutput" placeholder-class="cg-ph" />
    <view class="cg-cfg-add" bindtap="fillPreferenceExample" aria-role="button" aria-label="填入可编辑偏好题示例" hover-class="cy-pressed" hover-stay-time="80">填入可编辑示例</view>
    <cy-inline-error class="cg-inline-error" wx:if="{{preferenceConfigError}}" title="{{preferenceConfigError}}" />
    <view class="cg-cfg-label" wx:if="{{ preferencePreview.length }}">全部结果分支预览</view>
    <view class="cg-pref-branch" wx:for="{{ preferencePreview }}" wx:key="code">
      <view class="cg-pref-branch__code">{{ item.code }}</view>
      <view class="cg-pref-branch__title">{{ item.title }}</view>
      <view class="cg-pref-branch__body">{{ item.body }}</view>
      <view class="cg-pref-branch__next" wx:if="{{ item.nextStep }}">下一步 · {{ item.nextStep }}</view>
    </view>
    </cy-card>

    <!-- 题干附件:文字作答与选项问答共用一段,别在两张卡里各写一份(改一处漏一处) -->
    <cy-card class="cg-cfg" wx:if="{{ formData.validationMethod === 1 || formData.validationMethod === 3 }}">
    <view class="cg-cfg-label">题干附件</view>
    <view class="cg-qmedia">
      <view class="cg-qmedia-slot" wx:if="{{ formData.questionImg }}">
        <image class="cg-qmedia-img" src="{{ formData.questionImg }}" mode="aspectFill" />
        <view class="cg-qmedia-x" catchtap="clearQuestionImg" aria-role="button" aria-label="删除题干配图" hover-class="cy-pressed" hover-stay-time="80">
          <cy-icon name="close-sm" size="28" />
        </view>
      </view>
      <view class="cg-qmedia-add" wx:else bindtap="uploadQuestionImg" hover-class="cy-pressed" hover-stay-time="80">
        <cy-icon name="image" size="40" /><text class="cg-qmedia-t">配图</text>
      </view>

      <view class="cg-qmedia-slot" wx:if="{{ formData.questionAudio }}">
        <cy-icon name="play" size="40" /><text class="cg-qmedia-t">已配音频</text>
        <view class="cg-qmedia-x" catchtap="clearQuestionAudio" aria-role="button" aria-label="删除题干音频" hover-class="cy-pressed" hover-stay-time="80">
          <cy-icon name="close-sm" size="28" />
        </view>
      </view>
      <view class="cg-qmedia-add" wx:else bindtap="uploadQuestionAudio" hover-class="cy-pressed" hover-stay-time="80">
        <cy-icon name="play" size="40" /><text class="cg-qmedia-t">配音</text>
      </view>
    </view>
    </cy-card>

    <!-- 拍照打卡 -->
    <cy-card class="cg-cfg" wx:if="{{ !advanced.qa.enabled && formData.validationMethod === 2 }}">
    <view class="cg-cfg-label">拍照要求</view>
    <textarea class="cg-cfg-textarea" value="{{ formData.photoRequireDesc }}" bindinput="onPhotoRequireDescChange"
      maxlength="50" placeholder="告诉玩家要拍什么，例如:与这棵古树合影" placeholder-class="cg-ph" />
    </cy-card>

    <!-- 提示(并入完成方式;text/choice/gps 可开关) -->
    <view class="cg-hint-wrap" wx:if="{{ !advanced.qa.enabled && methodSupportsHint }}">
    <view class="cg-sw-row">
      <view class="cg-hint-head">
        <view class="cg-hint-emoji"><cy-icon name="info" size="32" /></view>
        <view>
          <view class="cg-sw-label">提示</view>
        </view>
      </view>
      <cy-switch checked="{{ hintEnabled }}" bindchange="onHintEnabledChange" />
    </view>
    <view class="cg-hint-fields" wx:if="{{ hintEnabled }}">
      <input class="cg-cfg-input" value="{{ formData.hint1 }}" bindinput="onHint1Change"
        placeholder="一级提示，如:留意脚下的石板" placeholder-class="cg-ph" />
      <input class="cg-cfg-input" value="{{ formData.hint2 }}" bindinput="onHint2Change"
        placeholder="二级提示(可选),更明确的引导" placeholder-class="cg-ph" />
      <input class="cg-cfg-input" value="{{ formData.answerReveal }}" bindinput="onAnswerRevealChange"
        placeholder="备用答案，卡住时直接给出" placeholder-class="cg-ph" />
    </view>
    </view>
    <!-- 结果反馈(2026-10-22 主人定稿):先写清三步,下面成功反馈 / 失败反馈各一个开关,打开才出现编辑。
         文字与配图写在 outcomeRules.pass / fail 的 reply / images;消耗与效果仍在同一行结果里,从「消耗与效果」进去改。 -->
    <block wx:if="{{r5Editor.afterRows.length}}">
    <view class="cg-sec" id="sec-fb"><text class="cg-sec__t">结果反馈</text></view>
    <view class="cg-gcfg">
      <view class="cg-fb-steps">
        <view class="cg-fb-step" wx:for="{{r5Editor.fbSteps}}" wx:key="*this"><text class="cg-fb-step__no">{{index + 1}}</text><text class="cg-fb-step__t">{{item}}</text></view>
      </view>
      <block wx:for="{{r5Editor.fbRows}}" wx:key="path" wx:for-item="fb">
        <view class="cg-rw-line cg-line"><view class="cg-rw-name">{{fb.label}}</view><cy-switch checked="{{fb.has || (fb.key === 'pass' ? fbOpenPass : fbOpenFail)}}" data-path="{{fb.path}}" data-key="{{fb.key}}" bindchange="toggleOutcomeFeedback" accessibility-label="{{fb.label}}" /></view>
        <view class="cg-fb-body" wx:if="{{fb.has || (fb.key === 'pass' ? fbOpenPass : fbOpenFail)}}">
          <textarea class="cg-cfg-textarea" value="{{fb.reply}}" maxlength="2000" placeholder="{{fb.label}}的文字" placeholder-class="cg-ph" data-path="{{fb.path}}" bindinput="inputOutcomeReply" />
          <view class="pgrid">
            <view class="pgrid-cell" wx:for="{{fb.images}}" wx:key="*this" wx:for-item="img" wx:for-index="ii">
              <image src="{{img}}" mode="aspectFill" class="pgrid-cell-img" />
              <view class="pgrid-del" catchtap="removeOutcomeImage" data-path="{{fb.path}}" data-index="{{ii}}" aria-role="button" aria-label="删除{{fb.label}}配图 {{ii + 1}}" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
            </view>
            <view class="pgrid-cell pgrid-add" wx:if="{{fb.images.length < 3}}" bindtap="uploadOutcomeImage" data-path="{{fb.path}}" aria-role="button" aria-label="添加{{fb.label}}配图" hover-class="cy-pressed" hover-stay-time="80">
              <view class="pgrid-add-plus"><cy-icon name="plus" size="32" /></view>
            </view>
          </view>
          <view class="cg-r5-row {{fb.disabled ? 'is-off' : ''}}" data-path="{{fb.path}}" data-inline="1" bindtap="openAfterSheet" aria-role="button" aria-label="编辑{{fb.label}}的消耗与效果" aria-disabled="{{fb.disabled}}" hover-class="{{fb.disabled ? '' : 'cy-pressed'}}" hover-stay-time="80">
            <view class="cg-r5-row__main"><text class="cg-r5-row__title cg-r5-row__title--plain">消耗与效果</text></view>
            <text class="cg-ios-v">{{fb.reason || (fb.count + ' 项')}}</text><view class="cg-ios-fold" wx:if="{{!fb.disabled}}"><cy-icon name="chevron-right" size="28" /></view>
          </view>
        </view>
      </block>
      <block wx:if="{{r5Editor.optionAfterRows.length}}">
        <view class="cg-cfg-label cg-r5-gap">每个结果单独回复</view>
        <view class="cg-r5-row {{index ? 'cg-r5-row--hr' : ''}} {{item.disabled ? 'is-off' : ''}}" wx:for="{{r5Editor.optionAfterRows}}" wx:key="path" data-path="{{item.path}}" bindtap="openAfterSheet" aria-role="button" aria-label="编辑{{item.label}}" aria-disabled="{{item.disabled}}" hover-class="{{item.disabled ? '' : 'cy-pressed'}}" hover-stay-time="80">
          <view class="cg-r5-row__main"><text class="cg-r5-row__title cg-r5-row__title--plain">{{item.label}}</text><text class="cg-r5-row__sub">{{item.reason || item.summary}}</text></view>
          <view class="cg-r5-pill" wx:if="{{!item.disabled}}">编辑<cy-icon name="chevron-right" size="24" /></view>
        </view>
      </block>
      <view class="cg-cfg-label cg-r5-gap">效果作用于</view>
      <cy-dropdown topic-editor columns="{{2}}" range="{{effectScopeOptions}}" range-key="label" reason-key="reason" value="{{opt.idx(effectScopeOptions, advanced.interactionRules.targetScope || 'OWNER')}}" bind:change="pickEffectScope"><view class="cg-pick">{{opt.label(effectScopeOptions, advanced.interactionRules.targetScope || 'OWNER')}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
    </view>
    </block>
    <view class="cg-gcfg" wx:if="{{advanced.branch.enabled || (!r5Editor.nextDisabledReason && gameSection)}}">
      <view class="cg-adv-body">
      <view class="cg-r5-sec">{{advanced.branch.enabled && advanced.outcomeRules.version !== 1 ? '分支剧情（旧设置）' : '反馈分段（本站内）'}}</view>

    <view wx:if="{{advanced.branch.enabled && advanced.outcomeRules.version !== 1}}" class="cg-cfg-label">起点步骤 ID <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" wx:if="{{advanced.branch.enabled && advanced.outcomeRules.version !== 1}}" value="{{advanced.branch.startStepId}}" data-section="branch" data-field="startStepId" bindinput="onAdvancedField" />
    <view class="cg-adv-repeat" wx:for="{{advanced.branch.steps}}" wx:key="id" wx:for-index="si" wx:for-item="step">
    <view class="cg-adv-repeat-head"><text>步骤 {{si + 1}}</text><view class="cg-adv-del" data-index="{{si}}" bindtap="removeBranchStep" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
    <input class="cg-cfg-input" wx:if="{{advanced.branch.enabled && advanced.outcomeRules.version !== 1}}" value="{{step.id}}" placeholder="步骤 ID" data-index="{{si}}" data-field="id" bindinput="updateBranchStep" />
    <input class="cg-cfg-input" value="{{step.title}}" placeholder="步骤标题" data-index="{{si}}" data-field="title" bindinput="updateBranchStep" />
    <textarea class="cg-cfg-textarea" value="{{step.body}}" placeholder="这一段的反馈内容" data-index="{{si}}" data-field="body" bindinput="updateBranchStep" />
    <view class="cg-rw-line compact"><view class="cg-rw-name">这一段结束反馈</view><cy-switch checked="{{step.terminal}}" data-index="{{si}}" bindchange="toggleBranchTerminal" /></view>
    <view wx:if="{{step.terminal && advanced.branch.enabled && advanced.outcomeRules.version !== 1}}" class="cg-outcome-fields">
      <view class="cg-cfg-label">稳定 outcomeCode <text class="req" aria-hidden="true">*</text></view>
      <input class="cg-cfg-input" value="{{step.outcomeCode}}" placeholder="例如 FOUND_CLOCK" data-index="{{si}}" data-field="outcomeCode" bindinput="updateBranchStep" />
      <view class="cg-cfg-label">名称（仅自己可见）</view>
      <input class="cg-cfg-input" value="{{step.outcomeLabel}}" placeholder="例如 找到钟楼" data-index="{{si}}" data-field="outcomeLabel" bindinput="updateBranchStep" />
    </view>
    <view wx:if="{{!step.terminal}}" class="cg-adv-options">
      <view class="cg-adv-repeat" wx:for="{{step.options}}" wx:key="id" wx:for-index="oi" wx:for-item="option">
        <view class="cg-adv-repeat-head"><text>选项 {{oi + 1}}</text><view class="cg-adv-del" data-stepindex="{{si}}" data-optionindex="{{oi}}" bindtap="removeBranchOption" aria-role="button" aria-label="删除选项" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
        <input class="cg-cfg-input" wx:if="{{advanced.branch.enabled && advanced.outcomeRules.version !== 1}}" value="{{option.id}}" placeholder="选项 ID" data-stepindex="{{si}}" data-optionindex="{{oi}}" data-field="id" bindinput="updateBranchOption" />
        <input class="cg-cfg-input" value="{{option.label}}" placeholder="选项文案" data-stepindex="{{si}}" data-optionindex="{{oi}}" data-field="label" bindinput="updateBranchOption" />
        <cy-dropdown topic-editor columns="{{2}}" range="{{r5Editor.feedbackStepOptions}}" range-key="label" reason-key="reason" value="{{opt.idx(r5Editor.feedbackStepOptions, option.nextStepId)}}" data-stepindex="{{si}}" data-optionindex="{{oi}}" bind:change="pickBranchNextStep"><view class="cg-pick">{{opt.label(r5Editor.feedbackStepOptions, option.nextStepId)}}<cy-icon name="back" size="28" /></view></cy-dropdown>
        <input class="cg-cfg-input" wx:if="{{advanced.branch.enabled && advanced.outcomeRules.version !== 1}}" type="number" value="{{option.score}}" placeholder="得分" data-stepindex="{{si}}" data-optionindex="{{oi}}" data-field="score" data-numeric="1" bindinput="updateBranchOption" />
      </view>
      <view class="cg-adv-add" data-index="{{si}}" bindtap="addBranchOption" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加选项</view>
    </view>
    </view>
    <view class="cg-adv-add" bindtap="addBranchStep" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加反馈分段</view>
      </view>
    </view>

    <view class="cg-gcfg" wx:if="{{r5Editor.legacyRows.length}}">
      <view class="cg-r5-sec">旧设置（只读，保存时原样保留）</view>
      <view class="cg-cfg-hint" wx:for="{{r5Editor.legacyRows}}" wx:key="path">{{item.label}}：{{item.displayValue}}</view>
    </view>
      </view>



      <!-- ======= 完成奖励 ======= -->
      <view class="cg-sec" id="sec-reward" wx:if="{{ mod.key === 'reward' && gameKey !== 'album' }}"><text class="cg-sec__t">完成奖励</text><view class="cg-sec__act" bindtap="confirmRemoveModule" data-key="reward" aria-role="button" aria-label="移除完成奖励" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
      <cy-card class="cg-card" wx:if="{{ mod.key === 'reward' && gameKey !== 'album' }}">
          <!-- 优惠券:从我已发布的券里选 -->
          <view class="cg-rw-row">
            <view class="cg-rw-line">
              <view class="cg-rw-meta">
                <view class="cg-rw-name">优惠券</view>
              </view>
              <cy-switch checked="{{ rwCoupon }}" bindchange="onToggleCoupon" />
            </view>
            <cy-card class="cg-rw-cfg" wx:if="{{ rwCoupon }}">
              <cy-reward-selector
                value="{{formData.couponId}}"
                selected-name="{{selectedCouponName}}"
                occasion="node"
                label="节点完成奖励"
                placeholder="选择优惠券"
                allow-create="{{true}}"
                scope="{{operationScope}}"
                bind:change="onRewardCouponChange" />
            </cy-card>
          </view>

          <!-- 文字反馈:2026-10-22 起不再提供(文字写在结果反馈里);旧模板已有的文字仍显示,关掉即清空 -->
          <view class="cg-rw-row" wx:if="{{ rwText }}">
            <view class="cg-rw-line">
              <view class="cg-rw-meta">
                <view class="cg-rw-name">文字反馈</view>
              </view>
              <cy-switch checked="{{ rwText }}" bindchange="onToggleText" />
            </view>
            <cy-card class="cg-rw-cfg" wx:if="{{ rwText }}">
              <textarea class="cg-cfg-textarea" value="{{ formData.feedbackText }}" bindinput="onFeedbackTextChange"
                placeholder="例如:恭喜你解开了老城的第一个秘密!" placeholder-class="cg-ph" />
            </cy-card>
          </view>

          <!-- 勋章 -->
          <view class="cg-rw-row last">
            <view class="cg-rw-line">
              <view class="cg-rw-meta">
                <view class="cg-rw-name">勋章</view>
              </view>
              <cy-switch checked="{{ rwMedal }}" bindchange="onToggleMedal" />
            </view>
            <cy-card class="cg-rw-cfg" wx:if="{{ rwMedal }}">
              <view class="cg-medal">
                <view class="cg-medal-up" bindtap="uploadMedal" aria-role="button" aria-label="{{formData.medalImg ? '更换勋章图片' : '上传勋章图片'}}" hover-class="cy-pressed" hover-stay-time="80">
                  <image wx:if="{{ formData.medalImg }}" class="cg-medal-img" src="{{ formData.medalImg }}" mode="aspectFill" />
                  <cy-icon wx:else name="plus" size="40" />
                </view>
                <input class="cg-cfg-input flat" value="{{ formData.medalName }}" bindinput="onMedalNameInput"
                  placeholder="勋章名称，如 老城探秘者" placeholder-class="cg-ph" />
                <view class="cg-medal-clear" wx:if="{{ formData.medalImg }}" catchtap="clearMedal" aria-role="button" aria-label="清除勋章图片" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
              </view>
              <!-- 双样式(用户 8-07 拍板):发布者可选 二维发光 / 3D珐琅;珐琅建议透明角方图 -->
              <view class="cg-cfg-label">勋章样式</view>
              <cy-dropdown portal="{{false}}" range="{{medalStyleOptions}}" range-key="label" value="{{opt.idx(medalStyleOptions, formData.medalStyle)}}" bind:change="onMedalStyle"><view class="cg-pick {{opt.idx(medalStyleOptions, formData.medalStyle) < 0 ? 'empty' : ''}}">{{opt.label(medalStyleOptions, formData.medalStyle)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            </cy-card>
          </view>
          <cy-inline-error class="cg-inline-error" wx:if="{{errors.reward}}" title="{{errors.reward}}" />
      </cy-card>

      <!-- ======= 剧情故事(多时间节点) ======= -->
      <cy-card class="cg-mod cg-mod--plain" id="fieldStory" wx:if="{{ mod.key === 'story' }}">
          <cy-inline-error class="cg-inline-error" wx:if="{{errors.story}}" title="{{errors.story}}" />
        <view class="cg-mod-head">
          <view class="cg-mod-ico cg-mod-ico--purple"><cy-icon name="edit" size="40" /></view>
          <view class="cg-mod-meta">
            <view class="cg-mod-name">剧情故事</view>
          </view>
          <view class="cg-mod-del" bindtap="removeModule" data-key="story" aria-role="button" aria-label="移除剧情故事" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="close-sm" size="32" />
          </view>
        </view>
        <view class="cg-mod-body pad">
          <cy-card class="cg-beat" wx:for="{{ storyBeats }}" wx:key="id" wx:for-item="beat" wx:for-index="bi">
            <view class="cg-beat-head">
              <view class="cg-beat-tag"><view class="cg-beat-no">{{ bi + 1 }}</view>时间节点</view>
              <view class="cg-beat-del" wx:if="{{ storyBeats.length > 1 }}" bindtap="removeStoryBeat" data-index="{{ bi }}" aria-role="button" aria-label="删除时间节点 {{bi + 1}}" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
            </view>
            <textarea class="cg-beat-text" value="{{ beat.text }}" bindinput="onStoryBeatText" data-index="{{ bi }}"
              placeholder="这一刻发生了什么?写下玩家此时读到的片段…" placeholder-class="cg-ph" />
            <view class="cg-beat-row">
              <input class="cg-beat-tagin" value="{{ beat.tag }}" bindinput="onStoryBeatTag" data-index="{{ bi }}"
                placeholder="时刻标签，如「此刻」" placeholder-class="cg-ph" />
            </view>
            <view class="cg-beat-photos">
              <view class="pgrid-head">
                <text class="pgrid-hint">配图（最多 6 张）</text>
                <text class="pgrid-count">{{ beat.imgs.length }}/6</text>
              </view>
              <view class="pgrid">
                <block wx:for="{{ beat.imgs }}" wx:key="index" wx:for-item="img" wx:for-index="ii">
                  <view class="pgrid-cell">
                    <image src="{{ img }}" mode="aspectFill" class="pgrid-cell-img" />
                    <view class="pgrid-del" catchtap="removeStoryBeatImg" data-index="{{ bi }}" data-imgindex="{{ ii }}" aria-role="button" aria-label="删除剧情配图 {{ii + 1}}" hover-class="cy-pressed" hover-stay-time="80">
                      <cy-icon name="close-sm" size="28" />
                    </view>
                  </view>
                </block>
                <view class="pgrid-cell pgrid-add" wx:if="{{ beat.imgs.length < 6 }}" bindtap="uploadStoryBeatImg" data-index="{{ bi }}" hover-class="cy-pressed" hover-stay-time="80">
                  <view class="pgrid-add-plus"><cy-icon name="plus" size="32" /></view>
                  <text class="pgrid-add-txt">加图</text>
                </view>
              </view>
            </view>
          </cy-card>
          <view class="cg-beat-add" bindtap="addStoryBeat" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加时间节点 · 延长时间线</view>
        </view>
      </cy-card>


    </block>

    <!-- 互动工具(2026-10-22 主人定稿):放在页面最下面,一开始就在;添加从底部弹出。语音讲解、背景音乐也在这里。 -->
    <view class="cg-sec" id="sec-template-tools"><text class="cg-sec__t">互动工具</text></view>
    <cy-card class="cg-card">
      <view class="cg-r5-row {{index ? 'cg-r5-row--hr' : ''}}" wx:for="{{r5Editor.toolRows}}" wx:key="key" data-key="{{item.key}}" bindtap="openR5ToolSheet" aria-role="button" aria-label="配置{{item.label}}" hover-class="cy-pressed" hover-stay-time="80">
        <view class="cg-r5-row__main"><text class="cg-r5-row__title">{{item.label}}</text><text class="cg-r5-row__sub">{{item.summary}}</text></view>
        <view class="cg-r5-pill">配置<cy-icon name="chevron-right" size="24" /></view>
      </view>
      <view class="cg-r5-row {{r5Editor.toolRows.length ? 'cg-r5-row--hr' : ''}}" wx:if="{{ opt.has(moduleList, 'voice') }}" bindtap="openVoiceSheet" aria-role="button" aria-label="配置语音讲解" hover-class="cy-pressed" hover-stay-time="80">
        <view class="cg-r5-row__main"><text class="cg-r5-row__title">语音讲解</text><text class="cg-r5-row__sub">{{formData.audioUrl ? (formData.audioFileName || '已上传音频') : '未上传'}}</text></view>
        <view class="cg-r5-pill">配置<cy-icon name="chevron-right" size="24" /></view>
      </view>
      <view class="cg-r5-row {{r5Editor.toolRows.length || opt.has(moduleList, 'voice') ? 'cg-r5-row--hr' : ''}}" wx:if="{{ advanced.backgroundMusic }}" bindtap="openMusicSheet" aria-role="button" aria-label="配置背景音乐" hover-class="cy-pressed" hover-stay-time="80">
        <view class="cg-r5-row__main"><text class="cg-r5-row__title">背景音乐</text><text class="cg-r5-row__sub">{{advanced.backgroundMusic.title || (advanced.backgroundMusic.audioUrl ? '已上传音乐' : '未上传')}}{{advanced.backgroundMusic.loop === false ? '' : ' · 循环'}}</text></view>
        <view class="cg-r5-pill">配置<cy-icon name="chevron-right" size="24" /></view>
      </view>
      <view class="cg-adv-add {{r5Editor.toolRows.length || opt.has(moduleList, 'voice') || advanced.backgroundMusic ? '' : 'cg-adv-add--first'}}" bindtap="openToolPicker" aria-role="button" aria-label="添加互动工具" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加互动工具</view>
    </cy-card>

    <!-- 空态 / 添加模块 -->
    <cy-card class="cg-empty" wx:if="{{ moduleList.length === 0 }}">
      <cy-empty title="还没有添加玩法模块" sub="先设置完成方式" cta="添加模块" bind:cta="openAddSheet" />
    </cy-card>
    <view class="cg-addmod" wx:elif="{{ availableModules.length > 0 }}" hover-class="cg-addmod--pressed" hover-stay-time="80" bindtap="openAddSheet"><cy-icon name="plus" size="28" />添加模块</view>

    <view class="cg-scroll-pad"></view>
  </scroll-view>

  <!-- 编辑态底部栏 -->
  <view class="cg-bottombar" wx:if="{{!editorLoading && !loadError}}">
    <cy-btn wx:if="{{!previewMode && from !== 'fabu' && from !== 'citynode'}}" variant="secondary" disabled="{{submitting}}" loading="{{submitting && submittingAction === 'draft'}}" bindtap="saveDraft">保存草稿</cy-btn>
    <cy-btn variant="primary" disabled="{{!canOpenPreview}}" aria-disabled="{{!canOpenPreview || submitting}}" loading="{{submitting}}" bindtap="openPreview" bind:disabledtap="onPreviewDisabledTap">查看预览</cy-btn>
  </view>

  <!-- ============ 预览态(沉浸式分步,深色底) ============ -->
  <view class="cg-preview {{ pvStepKey === 'challenge' && pvKit ? 'cg-preview--kit' : '' }}" wx:if="{{ previewVisible }}">
    <!-- ★ 玩法壳挂在预览层根部,不进滚动流:玩家侧(pages/play)也是这么挂的,
         它自己就是一整屏。塞进滚动流里会被上面的翻页条和内边距顶下去 ——
         题面该在离顶 84px 的位置,实测被推到了 340px,和原型对不上就是这么来的。 -->
    <scroll-view wx:if="{{pvStepKey === 'challenge' && pvKit && (pvKit.present === 'inline' || pvKit.type === 'journeycheck')}}" class="cg-pv-inline-scroll" scroll-y>
      <!-- 照玩家故事流的样子排:故事底色 → 流里这张玩法卡 → 「继续故事」。
           不再在外面另印一行标题 —— 作者没起名时它回落成题目,和玩法自己的题目印两遍。 -->
      <view class="cg-pv-inline-kit">
        <cy-playkit class="{{ pvKit.mode === 'CARD' ? 'theme-dark' : '' }}" kit="{{pvKit}}" show="{{true}}" inline="{{true}}" bind:kitaction="onPvKitAction" />
      </view>
      <view class="cg-pv-inline-end"><view class="cg-pv-inline-continue">继续故事</view></view>
    </scroll-view>
    <cy-playkit class="{{ pvKit.mode === 'CARD' ? 'theme-dark' : '' }}" wx:elif="{{pvStepKey === 'challenge' && pvKit}}" kit="{{pvKit}}" show="{{true}}" bind:kitaction="onPvKitAction" />
    <!-- 左上角一颗「退出」,玩到一半也能走。内嵌的玩法没有自己的退出键,全屏的那颗在预览里藏掉(--pk-back-display),
         两种玩法都只认这一颗,位置和样子照玩法台面的 .st__back -->
    <view class="cg-pv-exit" wx:if="{{ pvStepKey === 'challenge' && pvKit }}" style="top:{{statusBarHeight + 12}}px" bindtap="closePreview"
          aria-role="button" aria-label="退出试玩" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="back" size="40" /></view>
    <!-- 照「城瘾玩法试玩台」:玩法铺满整屏,不压翻页点和箭头;
         玩完由判定屏整屏涌上来,作者配的成功 / 失败反馈就写在这一屏。 -->
    <cy-play-verdict wx:if="{{ pvStepKey === 'challenge' && pvKit }}" show="{{ pvVerdict.show }}" kind="{{ pvVerdict.kind }}"
                     text="{{ pvVerdict.text }}" images="{{ pvVerdict.images }}" closable="{{ true }}" bind:close="closePvVerdict" />
    <!-- 2026-09-18 UI-22:翻页条 + 步骤标签固定在滚动区之上(不再 sticky 在滚动流里),
         步骤标签紧贴翻页点,滚到哪一步都和下面的内容对得上,也不会被滚过去的卡片压住。 -->
    <view class="cg-pv-head" wx:if="{{ !(pvStepKey === 'challenge' && pvKit) }}">
      <view class="cg-pv-pager">
        <view class="cg-pv-arrow {{ pvStep <= 0 ? 'disabled' : '' }}" bindtap="pvPrev" aria-role="button" aria-label="上一步预览" aria-disabled="{{pvStep <= 0}}" hover-class="{{pvStep <= 0 ? 'none' : 'cy-pressed'}}" hover-stay-time="80"><cy-icon name="back" size="36" /></view>
        <view class="cg-pv-dots">
          <view class="cg-pv-dot {{ pvStep === idx ? 'on' : '' }}" wx:for="{{ pvSteps }}" wx:key="*this" wx:for-index="idx"></view>
        </view>
        <view class="cg-pv-arrow {{ pvStep >= pvSteps.length - 1 ? 'disabled' : '' }}" bindtap="pvNext" aria-role="button" aria-label="下一步预览" aria-disabled="{{pvStep >= pvSteps.length - 1}}" hover-class="{{pvStep >= pvSteps.length - 1 ? 'none' : 'cy-pressed'}}" hover-stay-time="80"><cy-icon name="arrow-right" size="36" /></view>
      </view>
      <view class="cg-pv-step">玩家视角 · {{ pvStepLabel }}({{ pvStep + 1 }}/{{ pvSteps.length }})</view>
    </view>
    <scroll-view scroll-y class="cg-pv-scroll" wx:if="{{ !(pvStepKey === 'challenge' && pvKit) }}">
      <view class="cg-pv-body">

        <!-- 1. 到达点位 -->
        <view class="cg-pv-panel" wx:if="{{ pvStepKey === 'arrival' }}">
          <view class="cg-pv-cover {{ formData.imgUrl || defaultCover ? 'cg-pv-cover--img' : 'cg-pv-cover--noimg' }}">
            <image wx:if="{{ formData.imgUrl || defaultCover }}" src="{{ formData.imgUrl || defaultCover }}" mode="aspectFill" class="cg-pv-cover-img" />
            <view class="cg-pv-cover-mask">
              <view class="cg-pv-badge">你已抵达</view>
              <view class="cg-pv-cover-tit">{{ formData.title }}</view>
            </view>
          </view>
          <cy-card class="cg-pv-card">
            <view class="cg-pv-desc">{{ formData.description }}</view>
            <view class="cg-pv-meta">
              <view class="cg-pv-meta-li"><view class="cg-pv-meta-k">难度</view><view class="cg-pv-meta-v">{{ difficultyLabel || '未设置' }}</view></view>
            </view>
          </cy-card>
          <cy-btn variant="primary" style="margin-top:var(--cy-space-4)" bindtap="pvNext">开始任务</cy-btn>
        </view>

        <!-- 2. 剧情时间流(沉浸式,多节点) -->
        <view class="cg-pv-panel" wx:if="{{ pvStepKey === 'story' }}">
          <view class="cg-pv-beat" wx:for="{{ pvBeats }}" wx:key="id" wx:for-item="pb">
            <view class="cg-pv-beat-tag"><view class="cg-pv-beat-line"></view>{{ pb.label }}</view>
            <view class="cg-pv-beat-img" wx:for="{{ pb.imgs }}" wx:key="index" wx:for-item="pimg"><image src="{{ pimg }}" mode="aspectFill" class="cg-pv-beat-img-pic" /></view>
            <view class="cg-pv-beat-text">{{ pb.text }}</view>
          </view>
          <cy-btn variant="primary" style="margin-top:var(--cy-space-4)" bindtap="pvNext">继续</cy-btn>
        </view>

        <!-- 3. 点位任务(玩法壳铺满整屏,挂在预览层根部,见上面 cy-playkit) -->

        <view class="cg-pv-panel" wx:if="{{ pvStepKey === 'challenge' && !pvKit }}">
          <cy-card class="cg-pv-card">
            <view class="cg-pv-ch-head">
              <view class="cg-pv-ch-ico"><cy-icon name="{{pvMethodIconName}}" size="48" /></view>
              <view class="cg-pv-ch-label">{{ pvMethodLabel }}</view>
            </view>
            <view class="cg-pv-ch-tit">{{ pvChallengeTitle }}</view>
            <view class="cg-pv-ch-body">
              <!-- 文字问答 -->
              <input wx:if="{{ !gameKey && formData.validationMethod === 1 }}" class="cg-pv-answer {{ pvWrong ? 'err' : '' }}"
                value="{{ pvAnswer }}" bindinput="onPvAnswer" placeholder="输入你的答案" placeholder-class="cg-ph" />
              <!-- 选项问答 -->
              <view wx:elif="{{ formData.validationMethod === 3 }}" class="cg-pv-choices">
                <view class="cg-pv-choice {{ pvSelected === oi ? 'on' : '' }}" wx:for="{{ optionItems }}" wx:key="letter" wx:for-index="oi" wx:for-item="opt"
                  bindtap="onPvSelectChoice" data-index="{{ oi }}" hover-class="cy-pressed" hover-stay-time="80"><text class="cg-pv-choice-l">{{ opt.letter }}</text>{{ opt.text || '选项 ' }}</view>
              </view>
              <!-- 拍照 -->
              <view wx:elif="{{ formData.validationMethod === 2 }}" class="cg-pv-photo">拍照上传</view>
              <!-- 扫码 -->
              <view wx:elif="{{ formData.validationMethod === 4 }}" class="cg-pv-scan">打开扫一扫</view>
              <!-- GPS -->
              <view wx:elif="{{ formData.validationMethod === 5 }}" class="cg-pv-gps"><view class="cg-pv-gps-ico"><cy-icon name="gps" size="40" /></view>走到目标位置自动通过</view>
              <view wx:elif="{{ formData.validationMethod === 6 }}" class="cg-pv-pref">
                <view class="cg-pv-pref__branch" wx:for="{{ preferencePreview }}" wx:key="code">
                  <text>{{ item.code }}</text><text>{{ item.title }}</text>
                </view>
              </view>
              <!-- 无需 -->
              <view wx:else class="cg-pv-none">本节点无需验证，点击下方按钮即可完成</view>
            </view>
            <view class="cg-pv-wrong" wx:if="{{ pvWrong }}"><cy-icon name="warning" size="32" />回答不正确，再试一次</view>
          </cy-card>
          <view class="cg-pv-usehint" wx:if="{{ pvHasHint && !pvHintShown }}" bindtap="pvUseHint" aria-role="button" aria-label="使用提示" hover-class="cy-pressed" hover-stay-time="80">需要提示？</view>
          <view class="cg-pv-hint" wx:if="{{ pvHintShown }}">{{ pvHintText }}</view>
          <cy-btn variant="primary" style="margin-top:var(--cy-space-4)" bindtap="pvSubmitChallenge">{{ pvSubmitLabel }}</cy-btn>
        </view>

        <!-- 4. 任务完成 -->
        <view wx:if="{{ pvStepKey === 'complete' }}" class="cg-pv-panel cg-pv-complete">
          <view class="cg-pv-check"><cy-icon name="check" size="96" /></view>
          <view class="cg-pv-complete-t1">任务完成!</view>
          <view class="cg-pv-complete-t2">你解开了这个节点的秘密</view>
          <cy-btn variant="primary" class="cy-btn-inline" style="margin-top:var(--cy-space-4)" bindtap="pvNext">{{ rwAny ? '领取奖励' : '完成' }}</cy-btn>
        </view>

        <!-- 5. 获得奖励 -->
        <view class="cg-pv-panel" wx:if="{{ pvStepKey === 'reward' }}">
          <view class="cg-pv-reward-tit">获得奖励</view>
          <cy-card class="cg-pv-coupon" wx:if="{{ rwCoupon && selectedCouponName }}">
            <view class="cg-pv-coupon__inner">
              <view class="cg-pv-coupon-l">券</view>
              <view class="cg-pv-coupon-r">
                <view class="cg-pv-coupon-name">{{ selectedCouponName }}</view>
                <view class="cg-pv-coupon-sub">到店核销</view>
              </view>
            </view>
          </cy-card>
          <cy-card class="cg-pv-medal" wx:if="{{ rwMedal && formData.medalName }}">
            <view class="cg-pv-medal-ico"><image wx:if="{{ formData.medalImg }}" src="{{ formData.medalImg }}" mode="aspectFill" class="cg-pv-medal-img" /><text wx:else>章</text></view>
            <view class="cg-pv-medal-name">{{ formData.medalName }}</view>
            <view class="cg-pv-medal-sub">已收入你的成就墙</view>
          </cy-card>
          <cy-card class="cg-pv-rwtext" wx:if="{{ rwText && formData.feedbackText }}">{{ formData.feedbackText }}</cy-card>
          <cy-card class="cg-pv-norw" wx:if="{{ !rwAny }}">未配置奖励模块</cy-card>
        </view>
      </view>
      <view class="cg-scroll-pad"></view>
    </scroll-view>

    <!-- 预览态底部栏(FE-04:previewMode 时隐藏发布/草稿控件,temp 收窄为纯预览) -->
    <!-- 玩法那一屏只有玩法本身(照试玩台);保存 / 发布留在玩完之后的几步 -->
    <view class="cg-pv-submit" wx:if="{{!previewMode && !(pvStepKey === 'challenge' && pvKit)}}">
      <!-- 2026-09-23 用户:底部「保存前摘要」删掉;只在保存失败时出失败说明 -->
      <cy-inline-error wx:if="{{submitError}}" kind="network"
        title="{{from === 'citynode' ? '玩法没有保存成功' : (lastSubmitAction === 'draft' ? '草稿没有保存成功' : '玩法没有发布成功')}}"
        sub="{{submitError}}" action="重试" bind:action="retrySubmit" />
      <!-- 据点玩法没有草稿(saveDraft 对 citynode 只会弹「请直接保存」),不摆一颗点了没用的键;
           主键是「保存玩法」—— 保存后回到据点页再提交投放,这里不是发布路线。 -->
      <view class="cg-pv-bottombar">
        <cy-btn wx:if="{{from !== 'citynode' && from !== 'fabu'}}" variant="secondary" style="flex:1" loading="{{submittingAction === 'draft'}}" disabled="{{submitting}}" bindtap="saveDraft">保存草稿</cy-btn>
        <cy-btn variant="primary" style="flex:1.4" loading="{{submittingAction === 'publish' || submittingAction === 'bind'}}" disabled="{{!canPublishGame}}" aria-disabled="{{!canPublishGame || submitting}}" bindtap="publishGame">{{from === 'citynode' ? '保存玩法' : from === 'fabu' ? '保存并绑定' : '发布玩法'}}</cy-btn>
      </view>
    </view>
  </view>

  <!-- ============ 添加模块 sheet ============ -->
  <view class="cg-mask {{cgOut === 'add' ? 'is-out' : ''}}" wx:if="{{ showAddSheet }}" bindtap="cgDismiss" data-close="closeAddSheet" data-out="add" aria-role="button" aria-label="关闭" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet {{cgOut === 'add' ? 'is-out' : ''}}" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);" wx:if="{{ showAddSheet }}">
    <view class="cg-sheet-bar"></view>
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeAddSheet" data-out="add" aria-role="button" aria-label="退出添加模块" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="cg-edit-head__title">添加模块</view><view class="cg-edit-head__done" bindtap="closeAddSheet" aria-role="button" aria-label="完成添加模块" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
    <view class="cg-sheet-list">
      <view class="cg-sheet-card" wx:for="{{ availableModules }}" wx:key="key" hover-class="cg-sheet-card--pressed" hover-stay-time="80" bindtap="addModule" data-key="{{ item.key }}">
        <view class="cg-sheet-meta">
          <view class="cg-sheet-name">{{ item.name }}<text class="cg-tag {{ item.tagClass }}" wx:if="{{ item.tag }}">{{ item.tag }}</text></view>
          <view class="cg-sheet-desc">{{ item.desc }}</view>
        </view>
        <view class="cg-sheet-plus"><cy-icon name="plus" size="32" /></view>
      </view>
    </view>
    <view class="cg-sheet-allin" wx:if="{{ availableModules.length === 0 }}">全部模块已添加</view>
  </view>

  <!-- ============ 选择玩法 sheet(2026-10-22 主人定稿,Figma 标签样式):半屏弹层;所有分类排成一条只左右滑,
       每类最多四行胶囊标签(宽度随字数、带图标),点分类跳过去;点标签先选中,底部看说明 / 预览,「完成」才换玩法。 ============ -->
  <view class="cg-mask {{cgOut === 'game' ? 'is-out' : ''}}" wx:if="{{ gameSheetOpen }}" bindtap="cgDismiss" data-close="closeR5GameSheet" data-out="game" aria-role="button" aria-label="退出选择玩法" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet cg-tsheet cg-tsheet--auto {{cgOut === 'game' ? 'is-out' : ''}}" wx:if="{{ gameSheetOpen }}">
    <view class="cg-sheet-bar"></view>
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeR5GameSheet" data-out="game" aria-role="button" aria-label="退出选择玩法" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="cg-edit-head__title">选择玩法</view><view class="cg-edit-head__done" bindtap="confirmR5GameSheet" aria-role="button" aria-label="完成选择玩法" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
    <scroll-view scroll-x class="cg-gsheet-nav" enhanced show-scrollbar="{{false}}" scroll-into-view="{{ sheetNavAnchor }}" scroll-with-animation>
      <view class="cg-gsheet-navi {{ sheetGroup === idx ? 'is-on' : '' }}" id="gnav-{{ idx }}" wx:for="{{ r5Editor.gameGroups }}" wx:key="title" wx:for-index="idx"
            data-index="{{ idx }}" bindtap="jumpR5GameGroup" aria-role="button" aria-label="跳到{{ item.title }}" hover-class="cy-pressed" hover-stay-time="80">{{ item.title }}</view>
    </scroll-view>
    <scroll-view scroll-x class="cg-tstrip" enhanced show-scrollbar="{{false}}" scroll-into-view="{{ sheetAnchor }}" scroll-with-animation bindscroll="onGameStripScroll">
      <view class="cg-tstrip__in">
        <view class="cg-tblock" id="gsheet-g{{ gi }}" wx:for="{{ r5Editor.gameGroups }}" wx:key="title" wx:for-item="group" wx:for-index="gi">
          <view class="cg-tblock__t">{{ group.title }}</view>
          <view class="cg-trow" wx:for="{{ group.rows }}" wx:key="index" wx:for-item="row">
            <view class="cg-tag-pill {{ sheetPick === g.key ? 'is-on' : '' }} {{ g.reason || lockedGames[g.pickKey] || supportReasons[g.pickKey] ? 'is-off' : '' }}" wx:for="{{ row }}" wx:key="key" wx:for-item="g"
                  data-key="{{ g.key }}" data-reason="{{ g.reason || lockedGames[g.pickKey] || supportReasons[g.pickKey] }}" bindtap="pickR5GameTag"
                  aria-role="button" aria-selected="{{ sheetPick === g.key }}" aria-label="{{ g.label }}" hover-class="cy-pressed" hover-stay-time="60">
              <cy-icon class="cg-tag-pill__ic" name="{{ g.icon }}" size="36" />
              <text class="cg-tag-pill__t">{{ g.label }}</text>
              <image class="cg-tag-pill__ck" wx:if="{{ sheetPick === g.key }}" src="/pages/publish/images/icon_tag_check.svg" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="cg-tsheet__foot">
      <view class="cg-tsheet__sub"><text class="cg-tsheet__name" wx:if="{{ sheetPickItem }}">{{ sheetPickItem.label }}</text>{{ sheetPickItem ? (sheetPickItem.reason || sheetPickItem.sub) : '选一个玩法' }}</view>
      <view class="cg-r5-pill" wx:if="{{ sheetPickItem && !sheetPickItem.reason }}" data-key="{{ sheetPickItem.pickKey }}" bindtap="previewGameFromSheet" aria-role="button" aria-label="预览{{ sheetPickItem.label }}" hover-class="cy-pressed" hover-stay-time="80">预览</view>
    </view>
  </view>

  <!-- ============ 添加互动工具(底部弹出,同一种标签;已添加的打勾,点它直接去配置) ============ -->
  <view class="cg-mask {{cgOut === 'toolpicker' ? 'is-out' : ''}}" wx:if="{{ toolPickerOpen }}" bindtap="cgDismiss" data-close="closeToolPicker" data-out="toolpicker" aria-role="button" aria-label="退出添加互动工具" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet cg-tsheet cg-tsheet--auto {{cgOut === 'toolpicker' ? 'is-out' : ''}}" wx:if="{{ toolPickerOpen }}">
    <view class="cg-sheet-bar"></view>
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeToolPicker" data-out="toolpicker" aria-role="button" aria-label="退出添加互动工具" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="cg-edit-head__title">互动工具</view><view class="cg-edit-head__done" bindtap="closeToolPicker" aria-role="button" aria-label="完成添加互动工具" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
    <view class="cg-tpad">
      <view class="cg-tag-pill {{ item.on ? 'is-on' : '' }} {{ item.reason ? 'is-off' : '' }}" wx:for="{{ toolPickerItems }}" wx:key="key"
            data-key="{{ item.key }}" data-reason="{{ item.reason }}" bindtap="pickToolTag"
            aria-role="checkbox" aria-checked="{{ item.on }}" aria-label="{{ item.label }}" hover-class="cy-pressed" hover-stay-time="60">
        <cy-icon class="cg-tag-pill__ic" name="{{ item.icon }}" size="36" />
        <text class="cg-tag-pill__t">{{ item.label }}</text>
        <image class="cg-tag-pill__ck" wx:if="{{ item.on }}" src="/pages/publish/images/icon_tag_check.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="cg-tsheet__foot"><view class="cg-tsheet__sub">{{ toolPickerHint }}</view></view>
  </view>

  <!-- ============ 语音讲解(互动工具) ============ -->
  <view class="cg-mask {{cgOut === 'voice' ? 'is-out' : ''}}" wx:if="{{ voiceSheetOpen }}" bindtap="cgDismiss" data-close="closeVoiceSheet" data-out="voice" aria-role="button" aria-label="退出语音讲解" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet cg-edit-sheet {{cgOut === 'voice' ? 'is-out' : ''}}" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);" wx:if="{{ voiceSheetOpen }}">
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeVoiceSheet" data-out="voice" aria-role="button" aria-label="退出语音讲解" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="cg-edit-head__title">语音讲解</view><view class="cg-edit-head__done" bindtap="closeVoiceSheet" aria-role="button" aria-label="完成语音讲解" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
    <view class="cg-gcfg">
          <cy-inline-error class="cg-inline-error" wx:if="{{errors.voice}}" title="{{errors.voice}}" />
          <cy-card class="cg-audio" wx:if="{{ formData.audioUrl }}">
            <view class="cg-audio__inner">
              <view class="cg-audio-play" bindtap="onPreviewAudio" aria-role="button" aria-label="{{audioPreviewPlaying?'暂停导览音频':'播放导览音频'}}" hover-class="cy-pressed" hover-stay-time="80">{{audioPreviewPlaying?'暂停':'播放'}}</view>
              <view class="cg-audio-meta">
                <view class="cg-audio-name">{{formData.audioFileName||'导览音频'}}{{formData.audioFormat?'.'+formData.audioFormat:''}}</view>
              </view>
              <view class="cg-audio-del" bindtap="clearAudio" aria-role="button" aria-label="删除导览音频" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
            </view>
          </cy-card>
          <view class="cg-audio-empty" wx:else bindtap="uploadAudio" hover-class="cy-pressed" hover-stay-time="80">上传音频文件</view>
          <view wx:if="{{ formData.audioUrl }}">
            <view class="cg-cfg-label">时长（秒，选填）</view>
            <input class="cg-cfg-input" type="number" value="{{ formData.audioDuration }}" bindinput="onAudioDurationChange"
              placeholder="例如:45" placeholder-class="cg-ph" />
          </view>
            </view>
    <view class="cg-adv-add cg-adv-add--danger" data-key="voice" bindtap="removeVoiceTool" aria-role="button" aria-label="移除语音讲解" hover-class="cy-pressed" hover-stay-time="80">移除语音讲解</view>
  </view>

  <!-- ============ 背景音乐(互动工具):advanced.backgroundMusic,有这一段就算开着 ============ -->
  <view class="cg-mask {{cgOut === 'music' ? 'is-out' : ''}}" wx:if="{{ musicSheetOpen }}" bindtap="cgDismiss" data-close="closeMusicSheet" data-out="music" aria-role="button" aria-label="退出背景音乐" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet cg-edit-sheet {{cgOut === 'music' ? 'is-out' : ''}}" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);" wx:if="{{ musicSheetOpen }}">
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeMusicSheet" data-out="music" aria-role="button" aria-label="退出背景音乐" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="cg-edit-head__title">背景音乐</view><view class="cg-edit-head__done" bindtap="saveMusicSheet" aria-role="button" aria-label="完成背景音乐" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
    <view class="cg-gcfg">
      <view class="cg-cfg-label">音乐名称</view>
      <input class="cg-cfg-input" value="{{musicDraft.title}}" maxlength="40" placeholder="例如 老城茶馆" placeholder-class="cg-ph" bindinput="inputMusicTitle" />
      <view class="cg-cfg-label">音乐 <text class="req" aria-hidden="true">*</text></view>
      <cy-card class="cg-audio" wx:if="{{ musicDraft.audioUrl }}">
        <view class="cg-audio__inner">
          <view class="cg-audio-meta"><view class="cg-audio-name">{{musicDraft.fileName || '背景音乐'}}</view></view>
          <view class="cg-audio-del" bindtap="clearMusicAudio" aria-role="button" aria-label="删除背景音乐" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
        </view>
      </cy-card>
      <view class="cg-audio-empty" wx:else bindtap="uploadMusicAudio" aria-role="button" aria-label="上传背景音乐" hover-class="cy-pressed" hover-stay-time="80">上传音频文件</view>
      <view class="cg-rw-line cg-line"><view class="cg-rw-name">循环播放</view><cy-switch checked="{{musicDraft.loop}}" bindchange="toggleMusicLoop" accessibility-label="循环播放" /></view>
    </view>
    <cy-inline-error class="cg-inline-error" wx:if="{{musicError}}" title="{{musicError}}" />
    <view class="cg-adv-add cg-adv-add--danger" bindtap="removeMusicTool" aria-role="button" aria-label="移除背景音乐" hover-class="cy-pressed" hover-stay-time="80">移除背景音乐</view>
  </view>

  <!-- ============ R5 扫码参与：扫完回复 ============ -->
  <view class="cg-mask {{cgOut === 'scan' ? 'is-out' : ''}}" wx:if="{{scanSheetOpen}}" bindtap="cgDismiss" data-close="closeScanSheet" data-out="scan" aria-role="button" aria-label="退出扫完回复" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet cg-edit-sheet {{cgOut === 'scan' ? 'is-out' : ''}}" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);" wx:if="{{scanSheetOpen}}">
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeScanSheet" data-out="scan" aria-role="button" aria-label="退出扫完回复" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="cg-edit-head__title">扫完回复</view><view class="cg-edit-head__done" bindtap="saveScanSheet" aria-role="button" aria-label="完成扫完回复" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
    <cy-inline-error class="cg-inline-error" wx:if="{{r5Editor.error}}" title="{{r5Editor.error}}" />

          <view class="cg-gcfg" >
        <view class="cg-adv-body">
    <view class="cg-cfg-label">扫码后回什么</view>
    <cy-dropdown portal="{{false}}" range="{{scanKinds}}" range-key="label" value="{{opt.idx(scanKinds, advanced.scan.kind)}}" bind:change="pickScanKind"><view class="cg-pick {{opt.idx(scanKinds, advanced.scan.kind) < 0 ? 'empty' : ''}}">{{opt.label(scanKinds, advanced.scan.kind)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
    <view class="cg-cfg-label">回复内容 <text class="req" wx:if="{{advanced.scan.kind === 'TEXT'}}" aria-hidden="true">*</text></view>
    <textarea class="cg-cfg-textarea" value="{{advanced.scan.reply}}" placeholder="例如 欢迎来到这家店，今天的手冲是耶加雪菲。" data-section="scan" data-field="reply" bindinput="onAdvancedField" />
    <block wx:if="{{advanced.scan.kind === 'VOICE'}}">
      <view class="cg-cfg-label">语音地址 <text class="req" aria-hidden="true">*</text></view>
      <input class="cg-cfg-input" value="{{advanced.scan.audioUrl}}" placeholder="https 链接或站内路径" data-section="scan" data-field="audioUrl" bindinput="onAdvancedField" />
    </block>
    <block wx:elif="{{advanced.scan.kind === 'IMAGE'}}">
      <view class="cg-cfg-label">图片地址 <text class="req" aria-hidden="true">*</text></view>
      <input class="cg-cfg-input" value="{{advanced.scan.imageUrl}}" placeholder="https 链接或站内路径" data-section="scan" data-field="imageUrl" bindinput="onAdvancedField" />
    </block>
    <block wx:elif="{{advanced.scan.kind === 'OVERLAY'}}">
      <view class="cg-cfg-label">显形图地址 <text class="req" aria-hidden="true">*</text></view>
      <input class="cg-cfg-input" value="{{advanced.scan.overlayUrl}}" placeholder="https 链接或站内路径" data-section="scan" data-field="overlayUrl" bindinput="onAdvancedField" />
      <view class="cg-cfg-label">图片宽度（%）</view>
      <slider min="20" max="100" step="5" value="{{advanced.scan.overlayScale || 60}}" show-value
              activeColor="var(--cy-color-action-primary-bg)" backgroundColor="var(--cy-color-border-subtle)"
              block-size="24" data-section="scan" data-field="overlayScale" data-numeric="1" bindchange="onAdvancedField" />
      <view class="cg-cfg-label">东西怎么出来</view>
      <cy-dropdown portal="{{false}}" range="{{scanArModes}}" range-key="label" value="{{opt.idx(scanArModes, advanced.scan.arMode)}}" bind:change="pickScanArMode"><view class="cg-pick {{opt.idx(scanArModes, advanced.scan.arMode) < 0 ? 'empty' : ''}}">{{opt.label(scanArModes, advanced.scan.arMode)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
      <block wx:if="{{advanced.scan.arMode === 'MARKER'}}">
        <view class="cg-cfg-label">识别图地址（现场那件实物的正面照片） <text class="req" aria-hidden="true">*</text></view>
        <input class="cg-cfg-input" value="{{advanced.scan.markerUrl}}" placeholder="https 链接或站内路径" data-section="scan" data-field="markerUrl" bindinput="onAdvancedField" />
      </block>
      <!-- 3D 模型(2026-09-23):有模型放模型,没模型把显形图做成立牌;只收 .glb(xr-frame 的格式) -->
      <block wx:if="{{advanced.scan.arMode !== 'NONE'}}">
        <view class="cg-cfg-label">3D 模型</view>
        <!-- 整行、与上下输入框左右对齐(用户 9-23):模型没有缩略图,不用方形图片槽 -->
        <view class="cg-adv-add cg-model cg-model--done" wx:if="{{advanced.scan.modelUrl}}">
          <cy-icon name="check" size="28" />已上传 3D 模型
          <view class="cg-model-x" catchtap="clearScanModel" aria-role="button" aria-label="删除 3D 模型" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="close-sm" size="28" />
          </view>
        </view>
        <view class="cg-adv-add cg-model" wx:else bindtap="uploadScanModel" aria-role="button" aria-label="上传 3D 模型" hover-class="cy-pressed" hover-stay-time="80">
          <cy-icon name="plus" size="28" />上传 .glb 模型
        </view>
      </block>
    </block>
    <view class="cg-cfg-label">奖励分</view>
    <input class="cg-cfg-input" type="number" value="{{advanced.scan.xp}}" placeholder="0 至 200" data-section="scan" data-field="xp" data-numeric="1" bindinput="onAdvancedField" />
        </view>
    </view>
  </view>

  <!-- ============ R5 附加规则面板（限时挑战 / 时段限定 / 排行榜） ============ -->
  <view class="cg-mask {{cgOut === 'rule' ? 'is-out' : ''}}" wx:if="{{toolSheetKey && !toolSheetOpen}}" bindtap="cgDismiss" data-close="closeR5ToolSheet" data-out="rule" aria-role="button" aria-label="退出附加规则" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet cg-edit-sheet {{cgOut === 'rule' ? 'is-out' : ''}}" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);" wx:if="{{toolSheetKey && !toolSheetOpen}}">
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeR5ToolSheet" data-out="rule" aria-role="button" aria-label="退出附加规则" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="cg-edit-head__title">{{toolSheetKey === 'timer' ? '限时挑战' : toolSheetKey === 'timeWindow' ? '时段限定' : '排行榜'}}</view><view class="cg-edit-head__done" bindtap="saveR5ToolSheet" aria-role="button" aria-label="完成附加规则" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
    <block wx:if="{{toolSheetKey === 'timer'}}">
      <view class="cg-gcfg cg-adv-section" wx:if="{{advanced.timer.enabled}}">
        <!-- 限时只给真的会执行它的玩法(施工文档 §1.4)。计步、竞猜、抽卡、硬币、骰子、扫码
             这些没有可限的东西 —— 摆一个不会生效的开关,商家以为设了,玩家那边什么也没发生。 -->
        <view class="cg-rw-line" wx:if="{{timerAvailable}}"><view class="cg-rw-meta"><view class="cg-rw-name">限时挑战</view></view><cy-switch checked="{{advanced.timer.enabled}}" data-key="timer" bindchange="onAdvancedToggle" /></view>
        <view class="cg-cfg-hint" wx:else>此玩法不支持限时</view>
        <view class="cg-adv-grid" wx:if="{{advanced.timer.enabled}}">
          <view><view class="cg-cfg-label">时长（秒） <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" type="number" value="{{advanced.timer.durationSeconds}}" data-section="timer" data-field="durationSeconds" data-numeric="1" bindinput="onAdvancedField" /></view>
          <view><view class="cg-cfg-label">超时结果</view><cy-dropdown portal="{{false}}" range="{{timerTimeoutOptions}}" data-section="timer" data-field="timeoutResult" data-options="timerTimeoutOptions" bind:change="onAdvancedPicker"><view class="cg-pick">{{advanced.timer.timeoutResult}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown></view>
        </view>
      </view>

    </block>
    <block wx:if="{{toolSheetKey === 'timeWindow'}}">
      <view class="cg-gcfg cg-adv-section" wx:if="{{advanced.timeWindow.enabled}}">
        <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">时段限定</view></view><cy-switch checked="{{advanced.timeWindow.enabled}}" data-key="timeWindow" bindchange="onAdvancedToggle" /></view>
        <view class="cg-adv-body" wx:if="{{advanced.timeWindow.enabled}}">
          <view class="cg-adv-grid">
            <view><view class="cg-cfg-label">开放起 <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" value="{{advanced.timeWindow.openFrom}}" placeholder="23:00" data-section="timeWindow" data-field="openFrom" bindinput="onAdvancedField" /></view>
            <view><view class="cg-cfg-label">开放止 <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" value="{{advanced.timeWindow.openTo}}" placeholder="01:00" data-section="timeWindow" data-field="openTo" bindinput="onAdvancedField" /></view>
          </view>
          <view class="cg-cfg-label">小标题</view>
          <input class="cg-cfg-input" value="{{advanced.timeWindow.eyebrow}}" placeholder="例如 午夜电台 · 时段限定" data-section="timeWindow" data-field="eyebrow" bindinput="onAdvancedField" />
          <view class="cg-cfg-label">未开放时的标题</view>
          <input class="cg-cfg-input" value="{{advanced.timeWindow.title}}" placeholder="例如 还没到开播时间" data-section="timeWindow" data-field="title" bindinput="onAdvancedField" />
          <view class="cg-cfg-label">订阅消息模板 ID</view>
          <input class="cg-cfg-input" value="{{advanced.timeWindow.subscribeTmplId}}" placeholder="留空则不提供开播提醒" data-section="timeWindow" data-field="subscribeTmplId" bindinput="onAdvancedField" />
        </view>
      </view>
    </block>
    <block wx:if="{{toolSheetKey === 'leaderboard'}}">
      <view class="cg-gcfg cg-adv-section" wx:if="{{advanced.leaderboard.enabled}}">
        <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">排行榜</view></view><cy-switch checked="{{advanced.leaderboard.enabled}}" data-key="leaderboard" bindchange="onAdvancedToggle" /></view>
        <view class="cg-adv-body" wx:if="{{advanced.leaderboard.enabled}}">
          <view class="cg-cfg-label">排名依据</view>
          <cy-dropdown portal="{{false}}" range="{{leaderboardMetricOptions}}" data-section="leaderboard" data-field="metric" data-options="leaderboardMetricOptions" bind:change="onAdvancedPicker"><view class="cg-pick">{{advanced.leaderboard.metric}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
          <view class="cg-cfg-label">排行范围</view>
          <cy-dropdown portal="{{false}}" range="{{leaderboardScopeOptions}}" data-section="leaderboard" data-field="scope" data-options="leaderboardScopeOptions" bind:change="onAdvancedPicker"><view class="cg-pick">{{advanced.leaderboard.scope}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
          <view class="cg-cfg-label">展示人数</view>
          <input class="cg-cfg-input" type="number" value="{{advanced.leaderboard.limit}}" placeholder="展示人数" data-section="leaderboard" data-field="limit" data-numeric="1" bindinput="onAdvancedField" />
        </view>
      </view>
    </block>
    <view class="cg-adv-add cg-adv-add--danger" data-key="{{toolSheetKey}}" bindtap="removeR5Tool" aria-role="button" aria-label="移除这条附加规则" hover-class="cy-pressed" hover-stay-time="80">移除这条附加规则</view>
  </view>

  <!-- 10-28 原型 A e-temp-mod:「添加加值 / 添加代价」叠一张半屏,种类一列,点一种就地展开名字,点名字就加上 -->
  <view class="cg-mask {{cgOut === 'check' ? 'is-out' : ''}}" wx:if="{{checkSheet.show}}" bindtap="cgDismiss" data-close="closeCheckSheet" data-out="check" aria-role="button" aria-label="取消" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet cg-edit-sheet cg-ios-sheet {{cgOut === 'check' ? 'is-out' : ''}}" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);" wx:if="{{checkSheet.show}}">
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeCheckSheet" data-out="check" aria-role="button" aria-label="取消" hover-class="cy-pressed" hover-stay-time="80">取消</view><view class="cg-edit-head__title">{{checkSheet.title}}</view><view class="cg-edit-head__done is-ghost"></view></view>
      <view class="cg-ios-grp">
        <block wx:for="{{checkSheet.kinds}}" wx:key="key" wx:for-item="kind">
          <view class="cg-ios-row" data-key="{{kind.key}}" bindtap="toggleCheckKind" aria-role="button" aria-label="{{kind.label}}" aria-expanded="{{checkSheet.open === kind.key}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">{{kind.label}}</text></view><view class="cg-ios-fold {{checkSheet.open === kind.key ? 'is-open' : ''}}"><cy-icon name="chevron-right" size="28" /></view></view>
          <block wx:if="{{checkSheet.open === kind.key}}">
            <view class="cg-ios-row is-sub" wx:for="{{kind.names}}" wx:key="key" wx:for-item="name" data-kind="{{kind.key}}" data-key="{{name.key}}" bindtap="pickCheckName" aria-role="button" aria-label="{{name.label}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">{{name.label}}</text></view></view>
          </block>
        </block>
      </view>
  </view>

  <!-- ============ R5 结果之后（回复 / 消耗 / 效果 / 反馈下一段） ============ -->
  <view class="cg-mask cg-mask--top {{cgOut === 'after' ? 'is-out' : ''}}" wx:if="{{afterEditor.show}}" bindtap="cgDismiss" data-close="closeAfterSheet" data-out="after" aria-role="button" aria-label="退出结果之后" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet cg-edit-sheet cg-edit-sheet--top {{cgOut === 'after' ? 'is-out' : ''}}" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);" wx:if="{{afterEditor.show}}">
    <!-- 10-28 原型 A e-after-add:「添加效果」往下开的唯一一层,种类一列,点一种就地展开名字 -->
    <block wx:if="{{afterAdd.show}}">
      <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="closeAfterAdd" aria-role="button" aria-label="返回消耗与效果" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="back" size="28" />消耗与效果</view><view class="cg-edit-head__title">添加效果</view><view class="cg-edit-head__done is-ghost"></view></view>
      <view class="cg-ios-grp">
        <block wx:for="{{afterEffectKinds}}" wx:key="key" wx:for-item="kind">
          <view class="cg-ios-row" data-key="{{kind.key}}" bindtap="toggleAfterAddKind" aria-role="button" aria-label="{{kind.label}}" aria-expanded="{{afterAdd.open === kind.key}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">{{kind.label}}</text></view><view class="cg-ios-fold {{afterAdd.open === kind.key ? 'is-open' : ''}}"><cy-icon name="chevron-right" size="28" /></view></view>
          <block wx:if="{{afterAdd.open === kind.key}}">
            <view class="cg-ios-row is-sub" wx:for="{{r5Editor.valueSlots}}" wx:key="key" wx:for-item="slot" data-op="{{kind.key}}" data-key="{{slot.key}}" bindtap="pickAfterAddName" aria-role="button" aria-label="{{slot.label}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">{{slot.label}}</text></view></view>
          </block>
        </block>
      </view>
    </block>
    <block wx:else>
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeAfterSheet" data-out="after" aria-role="button" aria-label="取消" hover-class="cy-pressed" hover-stay-time="80">取消</view><view class="cg-edit-head__title">{{afterEditor.inline ? '消耗与效果' : opt.label(r5Editor.optionAfterRows, afterEditor.path, 'path')}}</view><view class="cg-edit-head__done" bindtap="saveAfterSheet" aria-role="button" aria-label="完成结果之后" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
    <view class="cg-gcfg" wx:if="{{!afterEditor.inline}}">
      <view class="cg-cfg-label">回复一句</view>
      <input class="cg-cfg-input" value="{{afterEditor.draft.reply}}" maxlength="2000" placeholder="例如 你稳住了呼吸" placeholder-class="cg-ph" bindinput="inputAfterReply" />
      <view class="cg-cfg-label">配图</view>
      <view class="pgrid">
        <view class="pgrid-cell" wx:for="{{afterEditor.draft.images}}" wx:key="*this" wx:for-item="img" wx:for-index="ii">
          <image src="{{img}}" mode="aspectFill" class="pgrid-cell-img" />
          <view class="pgrid-del" catchtap="removeAfterImage" data-index="{{ii}}" aria-role="button" aria-label="删除配图 {{ii + 1}}" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
        </view>
        <view class="pgrid-cell pgrid-add" wx:if="{{afterEditor.draft.images.length < 3}}" bindtap="uploadAfterImage" aria-role="button" aria-label="添加配图" hover-class="cy-pressed" hover-stay-time="80"><view class="pgrid-add-plus"><cy-icon name="plus" size="32" /></view></view>
      </view>
    </view>
    <!-- 10-28 原型 A e-after:消耗 / 效果 句子列表,点一句就地展开;「之后」就地勾选(after-section.js) -->
    <view class="cg-ios-hd">消耗</view>
    <view class="cg-ios-grp">
      <block wx:for="{{afterEditor.draft.costs}}" wx:key="index">
        <view class="cg-ios-row" data-open="{{'cost-' + index}}" bindtap="toggleAfterRow" aria-role="button" aria-label="{{opt.label(r5Editor.valueSlots, item.statKey)}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">{{item.statKey ? opt.label(r5Editor.valueSlots, item.statKey) : '请选择'}} −{{item.amount || 0}}</text></view><view class="cg-ios-fold {{afterOpen === 'cost-' + index ? 'is-open' : ''}}"><cy-icon name="chevron-right" size="28" /></view></view>
        <block wx:if="{{afterOpen === 'cost-' + index}}">
          <view class="cg-ios-row is-static"><text class="cg-ios-t is-l">数量</text><view class="cg-ios-stp"><view class="{{item.amount <= 1 ? 'is-dis' : ''}}" data-kind="costs" data-index="{{index}}" data-delta="-1" bindtap="stepAfterRow" aria-role="button" aria-label="减少" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-minus"></view></view><text>{{item.amount || 0}}</text><view class="{{item.amount >= 999 ? 'is-dis' : ''}}" data-kind="costs" data-index="{{index}}" data-delta="1" bindtap="stepAfterRow" aria-role="button" aria-label="增加" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" /></view></view></view>
          <view class="cg-ios-row is-danger" data-kind="costs" data-index="{{index}}" bindtap="removeAfterRowInline" aria-role="button" aria-label="删除这项消耗" hover-class="cy-pressed" hover-stay-time="80"><text class="cg-ios-t">删除</text></view>
        </block>
      </block>
      <view class="cg-ios-row is-add" data-open="costAdd" bindtap="toggleAfterRow" aria-role="button" aria-label="添加消耗" aria-expanded="{{afterOpen === 'costAdd'}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-add"><cy-icon name="plus" size="24" /></view><view class="cg-ios-m"><text class="cg-ios-t">添加消耗</text></view></view>
      <view wx:if="{{afterOpen === 'costAdd'}}" class="cg-ios-pills">
        <block wx:for="{{r5Editor.valueSlots}}" wx:key="key" wx:for-item="slot"><view wx:if="{{opt.idx(afterEditor.draft.costs, slot.key, 'statKey') < 0}}" class="cg-ios-pill" data-key="{{slot.key}}" bindtap="addAfterCost" aria-role="button" aria-label="{{slot.label}}" hover-class="cy-pressed" hover-stay-time="80">{{slot.label}}</view></block>
        <input wx:if="{{afterNewValue}}" class="cg-ios-pill-in" focus maxlength="20" confirm-type="done" bindconfirm="confirmAfterNewValue" aria-label="新建数值" />
        <view wx:else class="cg-ios-pill" bindtap="openAfterNewValue" aria-role="button" aria-label="新建数值" hover-class="cy-pressed" hover-stay-time="80">新建数值</view>
      </view>
    </view>
    <view class="cg-ios-hd">效果</view>
    <view class="cg-ios-grp">
      <block wx:for="{{afterEditor.draft.effects}}" wx:key="index">
        <view class="cg-ios-row" data-open="{{'eff-' + index}}" bindtap="toggleAfterRow" aria-role="button" aria-label="{{opt.label(r5Editor.valueSlots, item.var)}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">{{item.var ? opt.label(r5Editor.valueSlots, item.var) : '请选择'}} {{item.op === 'FLOOR' ? '恢复到至少 ' : '+'}}{{item.value || 0}}</text></view><view class="cg-ios-fold {{afterOpen === 'eff-' + index ? 'is-open' : ''}}"><cy-icon name="chevron-right" size="28" /></view></view>
        <block wx:if="{{afterOpen === 'eff-' + index}}">
          <view class="cg-ios-row is-static"><view class="cg-ios-seg"><view wx:for="{{afterEffectKinds}}" wx:key="key" wx:for-item="kind" class="{{item.op === kind.key ? 'is-on' : ''}}" data-index="{{index}}" data-op="{{kind.key}}" bindtap="pickAfterEffectOp" aria-role="button" aria-selected="{{item.op === kind.key}}" hover-class="cy-pressed" hover-stay-time="80">{{kind.label}}</view></view></view>
          <view class="cg-ios-row is-static"><text class="cg-ios-t is-l">数量</text><view class="cg-ios-stp"><view class="{{item.value <= 1 ? 'is-dis' : ''}}" data-kind="effects" data-index="{{index}}" data-delta="-1" bindtap="stepAfterRow" aria-role="button" aria-label="减少" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-minus"></view></view><text>{{item.value || 0}}</text><view class="{{item.value >= 999 ? 'is-dis' : ''}}" data-kind="effects" data-index="{{index}}" data-delta="1" bindtap="stepAfterRow" aria-role="button" aria-label="增加" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" /></view></view></view>
          <view class="cg-ios-row is-danger" data-kind="effects" data-index="{{index}}" bindtap="removeAfterRowInline" aria-role="button" aria-label="删除这个效果" hover-class="cy-pressed" hover-stay-time="80"><text class="cg-ios-t">删除</text></view>
        </block>
      </block>
      <view class="cg-ios-row is-add {{r5Editor.valueSlots.length ? '' : 'is-off'}}" bindtap="openAfterAdd" aria-role="button" aria-label="添加效果" aria-disabled="{{!r5Editor.valueSlots.length}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-add"><cy-icon name="plus" size="24" /></view><view class="cg-ios-m"><text class="cg-ios-t">添加效果</text></view></view>
    </view>
    <view class="cg-ios-grp cg-ios-gap">
      <view class="cg-ios-row" data-open="next" bindtap="toggleAfterRow" aria-role="button" aria-label="之后" aria-disabled="{{!!r5Editor.nextDisabledReason}}" aria-expanded="{{afterOpen === 'next'}}" hover-class="{{r5Editor.nextDisabledReason ? '' : 'cy-pressed'}}" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">之后</text></view><text class="cg-ios-v">{{r5Editor.nextDisabledReason || opt.label(r5Editor.nextStepOptions, afterEditor.draft.next)}}</text><view wx:if="{{!r5Editor.nextDisabledReason}}" class="cg-ios-fold {{afterOpen === 'next' ? 'is-open' : ''}}"><cy-icon name="chevron-right" size="28" /></view></view>
      <block wx:if="{{afterOpen === 'next'}}">
        <view class="cg-ios-row {{item.reason ? 'is-off' : ''}}" wx:for="{{r5Editor.nextStepOptions}}" wx:key="key" data-index="{{index}}" bindtap="pickAfterNextRow" aria-role="button" aria-label="{{item.label}}" aria-disabled="{{!!item.reason}}" aria-selected="{{afterEditor.draft.next === item.key}}" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-ios-m"><text class="cg-ios-t">{{item.label}}</text></view><view class="cg-ios-chk {{afterEditor.draft.next === item.key ? 'is-on' : ''}}"><cy-icon name="check" size="28" /></view></view>
      </block>
    </view>
    <cy-inline-error class="cg-inline-error" wx:if="{{afterEditor.error}}" title="{{afterEditor.error}}" />
    </block>
  </view>

  <!-- 工具子浮层编辑的是临时副本；关闭或点击遮罩不会改动玩法。 -->
  <view class="cg-mask {{cgOut === 'tool' ? 'is-out' : ''}}" wx:if="{{toolSheetOpen}}" bindtap="cgDismiss" data-close="closeR5ToolSheet" data-out="tool" aria-role="button" aria-label="退出工具" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet cg-tool-sheet {{cgOut === 'tool' ? 'is-out' : ''}}" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);" wx:if="{{toolSheetOpen}}">
    <view class="cg-sheet-bar"></view>
    <view class="cg-edit-head"><view class="cg-edit-head__exit" bindtap="cgDismiss" data-close="closeR5ToolSheet" data-out="tool" aria-role="button" aria-label="退出工具" hover-class="cy-pressed" hover-stay-time="80">退出</view><view class="cg-edit-head__title">{{toolKey === 'cost' ? '费用' : toolKey === 'reward' ? '奖励' : toolKey === 'clue' ? '线索' : toolKey === 'uses' ? '成功使用次数' : toolKey === 'trade' ? '物资交换' : '投票与投入'}}</view><view class="cg-edit-head__done" bindtap="saveR5ToolSheet" aria-role="button" aria-label="完成工具" hover-class="cy-pressed" hover-stay-time="80">完成</view></view>
    <scroll-view scroll-y class="cg-tool-scroll">
      <view wx:if="{{toolKey === 'cost'}}">
        <view class="cg-rw-line compact"><view class="cg-rw-name">任选一组费用</view><cy-switch checked="{{toolDraft.mode === 'OPTIONS'}}" data-field="mode" bindchange="updateToolField" /></view>

        <view class="cg-adv-repeat" wx:for="{{toolDraft.groups}}" wx:key="index" wx:for-item="group" wx:for-index="gi">
          <view class="cg-adv-repeat-head">{{toolDraft.mode === 'OPTIONS' ? '费用组 ' + (gi + 1) : '固定费用'}}<view wx:if="{{toolDraft.mode === 'OPTIONS' && toolDraft.groups.length > 2}}" data-group="{{gi}}" bindtap="removeCostGroup" aria-role="button" aria-label="移除费用组" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
          <input wx:if="{{toolDraft.mode === 'OPTIONS'}}" class="cg-cfg-input" value="{{group.label}}" placeholder="组名，可不填" data-group="{{gi}}" data-field="label" bindinput="updateCostRow" />
          <view class="cg-adv-repeat" wx:for="{{group.rows}}" wx:key="index" wx:for-item="cost" wx:for-index="ri">
            <view class="cg-adv-repeat-head">费用 {{ri + 1}}<view wx:if="{{group.rows.length > 1}}" data-group="{{gi}}" data-row="{{ri}}" bindtap="removeCostRow" aria-role="button" aria-label="移除费用" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
            <cy-dropdown portal="{{false}}" range="{{slotKinds}}" range-key="label" value="{{opt.idx(slotKinds, cost.kind)}}" data-group="{{gi}}" data-row="{{ri}}" data-field="kind" bind:change="updateCostRow"><view class="cg-pick">{{opt.label(slotKinds, cost.kind)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            <cy-dropdown portal="{{false}}" range="{{cost.kind === 'VALUE' ? toolDraft.valueSlots : toolDraft.itemSlots}}" range-key="label" value="{{opt.idx(cost.kind === 'VALUE' ? toolDraft.valueSlots : toolDraft.itemSlots, cost.key)}}" data-group="{{gi}}" data-row="{{ri}}" data-field="key" bind:change="updateCostRow"><view class="cg-pick">{{opt.label(cost.kind === 'VALUE' ? toolDraft.valueSlots : toolDraft.itemSlots, cost.key)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            <input wx:if="{{!cost.key}}" class="cg-cfg-input" value="{{cost.label}}" placeholder="给需要的资源起名（1 至 20 字）" data-group="{{gi}}" data-row="{{ri}}" data-field="label" bindinput="updateCostRow" />
            <input class="cg-cfg-input" type="number" value="{{cost.amount}}" placeholder="数量 1 至 999" data-group="{{gi}}" data-row="{{ri}}" data-field="amount" bindinput="updateCostRow" />
            <cy-inline-error wx:if="{{toolError && toolError.group === gi && toolError.row === ri}}" title="{{toolError.error}}" />
          </view>
          <view class="cg-adv-add" data-group="{{gi}}" bindtap="addCostRow" wx:if="{{group.rows.length < 32}}" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加费用</view>
          <cy-inline-error wx:if="{{toolError && toolError.group === gi && toolError.row == null}}" title="{{toolError.error}}" />
        </view>
        <view class="cg-adv-add" wx:if="{{toolDraft.mode === 'OPTIONS' && toolDraft.groups.length < 4}}" bindtap="addCostGroup" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加费用组</view>
      </view>
      <view wx:elif="{{toolKey === 'reward'}}">
        <view class="cg-rw-line compact"><view class="cg-rw-name">任选一组奖励</view><cy-switch checked="{{toolDraft.mode === 'OPTIONS'}}" data-field="mode" bindchange="updateToolField" /></view>
        <view class="cg-adv-repeat" wx:for="{{toolDraft.groups}}" wx:key="index" wx:for-item="group" wx:for-index="gi">
          <view class="cg-adv-repeat-head">{{toolDraft.mode === 'OPTIONS' ? '奖励组 ' + (gi + 1) : '固定奖励'}}<view wx:if="{{toolDraft.mode === 'OPTIONS' && toolDraft.groups.length > 2}}" data-group="{{gi}}" bindtap="removeCostGroup" aria-role="button" aria-label="移除奖励组" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
          <input wx:if="{{toolDraft.mode === 'OPTIONS'}}" class="cg-cfg-input" value="{{group.label}}" placeholder="组名，可不填" data-group="{{gi}}" data-field="label" bindinput="updateCostRow" />
          <view class="cg-adv-repeat" wx:for="{{group.rows}}" wx:key="index" wx:for-item="grant" wx:for-index="ri">
            <view class="cg-adv-repeat-head">物资 {{ri + 1}}<view wx:if="{{group.rows.length > 1}}" data-group="{{gi}}" data-row="{{ri}}" bindtap="removeCostRow" aria-role="button" aria-label="移除奖励物资" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
            <cy-dropdown portal="{{false}}" range="{{toolDraft.itemSlots}}" range-key="label" value="{{opt.idx(toolDraft.itemSlots, grant.key)}}" data-group="{{gi}}" data-row="{{ri}}" data-field="key" bind:change="updateCostRow"><view class="cg-pick">{{opt.label(toolDraft.itemSlots, grant.key)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            <input wx:if="{{!grant.key}}" class="cg-cfg-input" value="{{grant.label}}" placeholder="给需要的物资起名（1 至 20 字）" data-group="{{gi}}" data-row="{{ri}}" data-field="label" bindinput="updateCostRow" />
            <input class="cg-cfg-input" type="number" value="{{grant.amount}}" placeholder="数量 1 至 999" data-group="{{gi}}" data-row="{{ri}}" data-field="amount" bindinput="updateCostRow" />
            <cy-inline-error wx:if="{{toolError && toolError.group === gi && toolError.row === ri}}" title="{{toolError.error}}" />
          </view>
          <view class="cg-adv-add" data-group="{{gi}}" bindtap="addCostRow" wx:if="{{group.rows.length < 32}}" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加物资</view>
          <cy-inline-error wx:if="{{toolError && toolError.group === gi && toolError.row == null}}" title="{{toolError.error}}" />
        </view>
        <view class="cg-adv-add" wx:if="{{toolDraft.mode === 'OPTIONS' && toolDraft.groups.length < 4}}" bindtap="addCostGroup" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加奖励组</view>
      </view>
      <view wx:elif="{{toolKey === 'clue'}}">
        <view class="cg-adv-repeat" wx:for="{{toolDraft.rows}}" wx:key="index" wx:for-item="clue" wx:for-index="ci">
          <view class="cg-adv-repeat-head">线索 {{ci + 1}}<view wx:if="{{toolDraft.rows.length > 1}}" data-index="{{ci}}" bindtap="removeClueRow" aria-role="button" aria-label="移除线索" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
          <input class="cg-cfg-input" value="{{clue.name}}" maxlength="20" placeholder="线索名称" data-index="{{ci}}" data-field="name" bindinput="updateClueRow" />
          <view class="cg-rw-line compact"><view class="cg-rw-name">{{clueContent[clue.name] || '未配内容'}}</view></view>
          <view class="cg-rw-line compact"><view class="cg-rw-name">全场公开</view><cy-switch checked="{{clue.public}}" data-index="{{ci}}" data-field="public" bindchange="updateClueRow" /></view>
          <cy-inline-error wx:if="{{toolError && toolError.row === ci}}" title="{{toolError.error}}" />
        </view>
        <view class="cg-adv-add" wx:if="{{toolDraft.rows.length < 10}}" bindtap="addClueRow" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加线索</view>
        <view class="cg-rw-line compact"><view class="cg-rw-name">只首次生效</view><cy-switch checked="{{toolDraft.publicOnce}}" data-field="publicOnce" bindchange="updateToolField" /></view>
        <cy-inline-error wx:if="{{toolError && toolError.field === 'publicOnce'}}" title="{{toolError.error}}" />
      </view>
      <view wx:elif="{{toolKey === 'uses'}}">
        <view class="cg-cfg-label">成功上限</view><input class="cg-cfg-input" type="number" value="{{toolDraft.limit}}" placeholder="1 至 99" data-field="limit" bindinput="updateToolField" />
        <cy-inline-error wx:if="{{toolError && toolError.field === 'limit'}}" title="{{toolError.error}}" />
        <view class="cg-cfg-label">次数计算方式</view><cy-dropdown portal="{{false}}" range="{{toolScopes}}" range-key="label" value="{{opt.idx(toolScopes, toolDraft.scope)}}" data-field="scope" bind:change="updateToolField"><view class="cg-pick">{{opt.label(toolScopes, toolDraft.scope)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
        <view class="cg-rw-line compact"><view class="cg-rw-name">效果对象须已到达</view><cy-switch checked="{{toolDraft.requireArrival}}" data-field="requireArrival" bindchange="updateToolField" /></view>
      </view>
      <view wx:elif="{{toolKey === 'trade'}}"><view class="cg-rw-line"><view class="cg-rw-name">允许物资交换</view><cy-switch checked="{{toolDraft.allowTrade}}" data-field="allowTrade" bindchange="updateToolField" /></view></view>
      <view wx:else>
        <view class="cg-cfg-hint" wx:if="{{supportConditions.vote}}">{{supportConditions.vote}}</view>

        <view class="cg-adv-repeat" wx:for="{{toolDraft.plans}}" wx:key="index" wx:for-item="plan" wx:for-index="pi">
          <view class="cg-adv-repeat-head">选项 {{pi + 1}}<view data-plan="{{pi}}" bindtap="removeVotePlan" aria-role="button" aria-label="移除选项" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
          <input class="cg-cfg-input" value="{{plan.title}}" placeholder="选项名称" data-plan="{{pi}}" data-field="title" bindinput="updateVotePlan" />
          <textarea class="cg-cfg-textarea" value="{{plan.summary}}" placeholder="选项说明，可不填" data-plan="{{pi}}" data-field="summary" bindinput="updateVotePlan" />
          <view class="cg-adv-repeat" wx:for="{{plan.materialCost}}" wx:key="index" wx:for-item="material" wx:for-index="mi">
            <view class="cg-adv-repeat-head">投入物资 {{mi + 1}}<view data-plan="{{pi}}" data-material="{{mi}}" bindtap="removeVoteMaterial" aria-role="button" aria-label="移除投入物资" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
            <cy-dropdown portal="{{false}}" range="{{toolDraft.itemSlots}}" range-key="label" value="{{opt.idx(toolDraft.itemSlots, material.itemId)}}" data-plan="{{pi}}" data-material="{{mi}}" data-field="itemId" bind:change="updateVotePlan"><view class="cg-pick">{{opt.label(toolDraft.itemSlots, material.itemId)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            <input wx:if="{{!material.itemId}}" class="cg-cfg-input" value="{{material.label}}" placeholder="给需要的物资起名（1 至 20 字）" data-plan="{{pi}}" data-material="{{mi}}" data-field="label" bindinput="updateVotePlan" />
            <input class="cg-cfg-input" type="number" value="{{material.quantity}}" placeholder="数量 1 至 999" data-plan="{{pi}}" data-material="{{mi}}" data-field="quantity" bindinput="updateVotePlan" />
            <cy-inline-error wx:if="{{toolError && toolError.plan === pi && toolError.material === mi}}" title="{{toolError.error}}" />
          </view>
          <view class="cg-adv-add" data-plan="{{pi}}" bindtap="addVoteMaterial" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加投入物资</view>
          <view class="cg-cfg-label">需要的线索</view>
          <view class="cg-adv-repeat" wx:for="{{plan.clueNames}}" wx:key="index" wx:for-item="clueName" wx:for-index="ci">
            <view class="cg-adv-repeat-head">线索 {{ci + 1}}<view data-plan="{{pi}}" data-index="{{ci}}" bindtap="removePlanClue" aria-role="button" aria-label="移除需要的线索" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
            <input class="cg-cfg-input" value="{{clueName}}" maxlength="20" placeholder="与公开线索同名" data-plan="{{pi}}" data-index="{{ci}}" bindinput="updatePlanClue" />
          </view>
          <view class="cg-adv-add" wx:if="{{plan.clueNames.length < 10}}" data-plan="{{pi}}" bindtap="addPlanClue" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加需要的线索</view>
          <cy-inline-error wx:if="{{toolError && toolError.plan === pi && toolError.material == null}}" title="{{toolError.error}}" />
        </view>
        <view class="cg-adv-add" bindtap="addVotePlan" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加投票选项</view>
        <view class="cg-adv-repeat" wx:if="{{toolDraft.plans.length}}">
          <view class="cg-adv-repeat-head">没有方案执行时</view>
          <input class="cg-cfg-input" value="{{toolDraft.fallbackTitle}}" placeholder="标题" data-field="fallbackTitle" bindinput="updateToolField" />
          <textarea class="cg-cfg-textarea" value="{{toolDraft.fallbackSummary}}" placeholder="内容，可不填" data-field="fallbackSummary" bindinput="updateToolField" />
          <cy-inline-error wx:if="{{toolError && (toolError.field === 'fallbackTitle' || toolError.field === 'fallbackSummary')}}" title="{{toolError.error}}" />
        </view>
      </view>
      <view class="cg-adv-repeat" wx:if="{{(toolKey === 'cost' || toolKey === 'vote') && toolDraft.slots.length}}">
        <view class="cg-adv-repeat-head">需要的资源</view>

        <view wx:for="{{toolDraft.slots}}" wx:key="key" wx:for-item="slot" wx:for-index="si">
          <view class="cg-cfg-label">{{slot.kind === 'VALUE' ? '数值' : '物资'}} · {{slot.key}}</view>
          <input class="cg-cfg-input" value="{{slot.label}}" placeholder="资源名称（1 至 20 字）" data-slot="{{si}}" bindinput="updateSlotLabel" />
          <cy-inline-error wx:if="{{toolError && toolError.slot === si}}" title="{{toolError.error}}" />
        </view>
      </view>
      <cy-inline-error wx:if="{{toolError && toolError.group == null && toolError.plan == null && toolError.slot == null && toolError.field !== 'limit'}}" title="{{toolError.error}}" />
    </scroll-view>
    <view class="cg-adv-add cg-adv-add--danger" data-key="{{toolKey}}" bindtap="removeR5Tool" aria-role="button" aria-label="移除这个工具" hover-class="cy-pressed" hover-stay-time="80">移除这个工具</view>
  </view>

  <!-- ============ 通用 picker sheet(玩家人数/玩法时长/适用场所) ============ -->
  <view class="cg-mask {{cgOut === 'picker' ? 'is-out' : ''}}" wx:if="{{ pickerSheet.open }}" bindtap="cgDismiss" data-close="closePickerSheet" data-out="picker" aria-role="button" aria-label="关闭选择器" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="cg-sheet picker {{cgOut === 'picker' ? 'is-out' : ''}}" style="--cy-comp-sheet-max-h:calc(100vh - {{sheetTop}}px);" wx:if="{{ pickerSheet.open }}">
    <view class="cg-sheet-bar"></view>
    <view class="cg-sheet-head">
      <view class="cg-sheet-tit">{{ pickerSheet.title }}</view>
      <view class="cg-sheet-close" bindtap="cgDismiss" data-close="closePickerSheet" data-out="picker" aria-role="button" aria-label="关闭选择器" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="44" /></view>
    </view>
    <view class="cg-picker-list">
      <view class="cg-picker-li {{ item.active ? 'on' : '' }}" wx:for="{{ pickerSheet.options }}" wx:key="value"
        bindtap="onPickerSheetSelect" data-value="{{ item.value }}" data-label="{{ item.label }}" hover-class="cy-pressed" hover-stay-time="80"
        aria-role="radio" aria-label="{{item.label}}" aria-checked="{{item.active}}">
        <text class="cg-picker-label">{{ item.label }}</text><view class="cg-picker-tick" aria-hidden="true"></view>
      </view>
    </view>
  </view>

  <cy-category-sheet show="{{categorySheetVisible}}" type="{{4}}" ids="{{categorySheetIds}}"
    bind:select="onCategorySelect" bind:close="onCategorySheetClose" />

  <!-- 2026-08-20 物理返回守卫:任一浮层(预览/添加模块/picker/分类)开着时,
       返回键/侧滑先关最上层浮层再谈退页。表达式覆盖本页全部浮层且无排斥项,
       浮层间切换时保持为真,不产生误触发竞态;backGuardOff 用于返回键消费后重挂。 -->
  <page-container
    show="{{!backGuardOff && (previewVisible || showAddSheet || pickerSheet.open || categorySheetVisible || gameSheetOpen || toolSheetOpen || gameConfigOpen || scanSheetOpen || toolSheetKey || checkSheet.show || afterEditor.show)}}"
    duration="{{0}}" overlay="{{false}}"
    custom-style="width:0;height:0;background:transparent;pointer-events:none"
    bind:afterleave="onNativeBackGuard" />
</view>

<creation-success model="{{creationSuccess}}" bind:action="onCreationSuccessAction" />

<!-- 模板草稿/发布成功走结果面板(纯导航,收掉直接落模板库);
     「节点玩法已保存」仍走上面的 creation-success —— 它有「继续编辑玩法」这个留在原地的分叉。 -->
<cy-result-sheet show="{{resultSheet.show}}" kind="{{resultSheet.kind}}" title="{{resultSheet.title}}"
  sub="{{resultSheet.sub}}" meta="{{resultSheet.meta}}" pill="{{resultSheet.pill}}" why="{{resultSheet.why}}"
  duration="{{resultSheet.duration}}" bind:close="onResultSheetClose" />
