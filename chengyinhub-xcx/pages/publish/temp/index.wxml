    <view><view class="cg-cfg-label">量程下限</view><input class="cg-cfg-input" type="digit" value="{{advanced.estimate.min}}" data-section="estimate" data-field="min" data-numeric="1" bindinput="onAdvancedField" /></view>
    <view><view class="cg-cfg-label">量程上限</view><input class="cg-cfg-input" type="digit" value="{{advanced.estimate.max}}" data-section="estimate" data-field="max" data-numeric="1" bindinput="onAdvancedField" /></view>
    </view>
