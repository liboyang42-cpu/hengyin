    <view><view class="cg-cfg-label">次数上限</view><input class="cg-cfg-input" type="number" value="{{advanced.pricePair.maxTries}}" placeholder="0 表示不限" data-section="pricePair" data-field="maxTries" data-numeric="1" bindinput="onAdvancedField" /></view>
    </view>
