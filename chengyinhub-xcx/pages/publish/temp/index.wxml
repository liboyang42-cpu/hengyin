          wx:for="{{advanced.hiddenObject.hotspots}}" wx:key="id" wx:for-index="hi"
          wx:if="{{item.x >= 0 && item.y >= 0}}"
          style="left:{{item.x * 100 || 0}}%;top:{{item.y * 100 || 0}}%">{{hi + 1}}</view>
