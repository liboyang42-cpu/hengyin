    <view><view class="cg-cfg-label">几轮 <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" type="number" value="{{advanced.reaction.rounds}}" placeholder="1 至 10" data-section="reaction" data-field="rounds" data-numeric="1" bindinput="onAdvancedField" /></view>
    <view><view class="cg-cfg-label">达标毫秒 <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" type="number" value="{{advanced.reaction.goalMs}}" placeholder="120 至 2000" data-section="reaction" data-field="goalMs" data-numeric="1" bindinput="onAdvancedField" /></view>
    </view>
      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'ballShake'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
