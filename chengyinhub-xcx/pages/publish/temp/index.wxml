    <view wx:if="{{advanced.ballShake.timed}}">
    <view class="cg-cfg-label">时限（秒） <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" type="number" value="{{advanced.ballShake.seconds}}" placeholder="3 至 300" data-section="ballShake" data-field="seconds" data-numeric="1" bindinput="onAdvancedField" />
    </view>
      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'quietHold'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.quietHold.kicker}}" placeholder="例如 别出声" data-section="quietHold" data-field="kicker" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">要安静多久（秒） <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" type="number" value="{{advanced.quietHold.seconds}}" placeholder="5 至 300" data-section="quietHold" data-field="seconds" data-numeric="1" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">说明</view>
    <input class="cg-cfg-input" value="{{advanced.quietHold.sub}}" placeholder="例如 声音过线就从头再来" data-section="quietHold" data-field="sub" bindinput="onAdvancedField" />

      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'compass'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.compass.kicker}}" placeholder="例如 把手机转向钟楼" data-section="compass" data-field="kicker" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">目标方位（度） <text class="req" aria-hidden="true">*</text></view>
    <view class="cg-adv-grid">
    <view><input class="cg-cfg-input" type="number" value="{{advanced.compass.bearing}}" placeholder="0 至 359，正北是 0" data-section="compass" data-field="bearing" data-numeric="1" bindinput="onAdvancedField" /></view>
    <view><view class="cg-adv-add" bindtap="onCompassCapture" hover-class="cy-pressed" hover-stay-time="80">对准方向取值</view></view>
    </view>
    <view class="cg-adv-grid">
    <view><view class="cg-cfg-label">容差（度） <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" type="number" value="{{advanced.compass.tolerance}}" placeholder="5 至 90" data-section="compass" data-field="tolerance" data-numeric="1" bindinput="onAdvancedField" /></view>
    <view><view class="cg-cfg-label">保持几秒 <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" type="number" value="{{advanced.compass.holdSeconds}}" placeholder="1 至 10" data-section="compass" data-field="holdSeconds" data-numeric="1" bindinput="onAdvancedField" /></view>
    </view>
    <view class="cg-cfg-label">提示语</view>
    <input class="cg-cfg-input" value="{{advanced.compass.hint}}" placeholder="例如 它比你想的更靠右" data-section="compass" data-field="hint" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">奖励分</view>
    <input class="cg-cfg-input" type="number" value="{{advanced.compass.xp}}" placeholder="0 表示不给分" data-section="compass" data-field="xp" data-numeric="1" bindinput="onAdvancedField" />

      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'shout'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.shout.kicker}}" placeholder="例如 一起喊，让这儿听见" data-section="shout" data-field="kicker" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">要连续喊满几秒 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" type="number" value="{{advanced.shout.seconds}}" placeholder="5 至 300" data-section="shout" data-field="seconds" data-numeric="1" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">奖励分</view>
    <input class="cg-cfg-input" type="number" value="{{advanced.shout.xp}}" placeholder="0 表示不给分" data-section="shout" data-field="xp" data-numeric="1" bindinput="onAdvancedField" />

      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'countdown'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.countdown.kicker}}" placeholder="例如 倒计时" data-section="countdown" data-field="kicker" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">倒计时长（秒） <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" type="number" value="{{advanced.countdown.seconds}}" placeholder="5 至 3600" data-section="countdown" data-field="seconds" data-numeric="1" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">到点时说什么 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.countdown.doneText}}" placeholder="例如 时间到。" data-section="countdown" data-field="doneText" bindinput="onAdvancedField" />
      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'stopwatch'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.stopwatch.kicker}}" placeholder="例如 把手机拿到面前，随时可以开始" data-section="stopwatch" data-field="kicker" bindinput="onAdvancedField" />
    <view class="cg-adv-grid">
    <view><view class="cg-cfg-label">目标时间（秒） <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" type="digit" value="{{advanced.stopwatch.targetSeconds}}" placeholder="3 至 120" data-section="stopwatch" data-field="targetSeconds" data-numeric="1" bindinput="onAdvancedField" /></view>
    <view><view class="cg-cfg-label">允许误差（毫秒） <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" type="number" value="{{advanced.stopwatch.toleranceMs}}" placeholder="50 至 5000" data-section="stopwatch" data-field="toleranceMs" data-numeric="1" bindinput="onAdvancedField" /></view>
    </view>

    <view class="cg-cfg-label">次数上限</view>
    <input class="cg-cfg-input" type="number" value="{{advanced.stopwatch.tries}}" placeholder="0 表示不限" data-section="stopwatch" data-field="tries" data-numeric="1" bindinput="onAdvancedField" />
      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'sort' || segmentOn.sort}}">
      <view class="cg-adv-body">
    <view class="cg-qa-sec cg-qa-sec--first" wx:if="{{segmentOn.sort}}">排序<view class="cg-seg-del" data-section="sort" bindtap="removeSegment" aria-role="button" aria-label="移除排序这一段" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
    <view class="cg-cfg-label">题干 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.sort.prompt}}" placeholder="例如 把冲泡顺序排好" data-section="sort" data-field="prompt" bindinput="onAdvancedField" />
    <!-- 排序条目按**正确顺序**从上到下录入:这个顺序就是 answerOrder。
       玩家拿到的条目会被服务端打乱,面板不提供拖拽 / 上下移。 -->
    <view class="cg-cfg-label">按正确顺序排好（从上到下就是答案） <text class="req" aria-hidden="true">*</text></view>
    <view class="cg-adv-repeat" wx:for="{{advanced.sort.items}}" wx:key="id" wx:for-index="si">
    <view class="cg-adv-repeat-head">
      <text>第 {{si + 1}} 步</text>
      <view class="cg-adv-del" data-index="{{si}}" bindtap="removeSortItem" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
    </view>
    <input class="cg-cfg-input" value="{{item.label}}" placeholder="例如 先温杯" data-path="sort.items" data-index="{{si}}" data-field="label" bindinput="updateAdvancedRow" />
    </view>
    <view class="cg-adv-add" bindtap="addSortItem" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加一步</view>
      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'match' || segmentOn.match}}">
      <view class="cg-adv-body">
    <view class="cg-qa-sec cg-qa-sec--first" wx:if="{{segmentOn.match}}">连线<view class="cg-seg-del" data-section="match" bindtap="removeSegment" aria-role="button" aria-label="移除连线这一段" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
    <view class="cg-cfg-label">题干 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.match.prompt}}" placeholder="例如 把工具和它的用途连起来" data-section="match" data-field="prompt" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">一对一配好（左 | 右） <text class="req" aria-hidden="true">*</text></view>
    <view class="cg-adv-repeat" wx:for="{{advanced.match.left}}" wx:key="id" wx:for-index="mi" wx:for-item="leftRow">
    <view class="cg-adv-repeat-head">
      <text>第 {{mi + 1}} 对</text>
      <view class="cg-adv-del" data-index="{{mi}}" bindtap="removeMatchPair" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
    </view>
    <view class="cg-adv-grid">
      <input class="cg-cfg-input" value="{{leftRow.label}}" placeholder="左，如 手冲壶" data-path="match.left" data-index="{{mi}}" data-field="label" bindinput="updateAdvancedRow" />
      <input class="cg-cfg-input" value="{{advanced.match.right[mi].label}}" placeholder="右，如 装水" data-path="match.right" data-index="{{mi}}" data-field="label" bindinput="updateAdvancedRow" />
    </view>
    </view>
    <view class="cg-adv-add" bindtap="addMatchPair" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加一对</view>
      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'classify' || segmentOn.classify}}">
      <view class="cg-adv-body">
    <view class="cg-qa-sec cg-qa-sec--first" wx:if="{{segmentOn.classify}}">分类<view class="cg-seg-del" data-section="classify" bindtap="removeSegment" aria-role="button" aria-label="移除分类这一段" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
    <view class="cg-cfg-label">题干 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.classify.prompt}}" placeholder="例如 把这几样东西分到的类别里" data-section="classify" data-field="prompt" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">类别（2 至 4 个） <text class="req" aria-hidden="true">*</text></view>
    <view class="cg-adv-repeat" wx:for="{{advanced.classify.bins}}" wx:key="id" wx:for-index="bi" wx:for-item="binRow">
    <view class="cg-adv-repeat-head">
      <text>类别 {{bi + 1}}</text>
      <view class="cg-adv-del" data-index="{{bi}}" bindtap="removeClassifyBin" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
    </view>
    <input class="cg-cfg-input" value="{{binRow.label}}" placeholder="例如 器具 / 耗材" data-path="classify.bins" data-index="{{bi}}" data-field="label" bindinput="updateAdvancedRow" />
    </view>
    <view class="cg-adv-add" bindtap="addClassifyBin" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加类别</view>
    <view class="cg-cfg-label">条目（2 至 10 条，每条选一个类别） <text class="req" aria-hidden="true">*</text></view>
    <view class="cg-adv-repeat" wx:for="{{advanced.classify.items}}" wx:key="id" wx:for-index="ci" wx:for-item="itemRow">
    <view class="cg-adv-repeat-head">
      <text>条目 {{ci + 1}}</text>
      <view class="cg-adv-del" data-index="{{ci}}" bindtap="removeClassifyItem" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
    </view>
    <input class="cg-cfg-input" value="{{itemRow.label}}" placeholder="例如 滤杯" data-path="classify.items" data-index="{{ci}}" data-field="label" bindinput="updateAdvancedRow" />
    <cy-dropdown portal="{{false}}" range="{{opt.names(advanced.classify.bins, '类别 ')}}" value="{{opt.idx(advanced.classify.bins, advanced.classify.answer[itemRow.id], 'id')}}" data-item="{{itemRow.id}}" bind:change="setClassifyBin"><view class="cg-pick {{opt.idx(advanced.classify.bins, advanced.classify.answer[itemRow.id], 'id') < 0 ? 'empty' : ''}}"><text>{{opt.label(advanced.classify.bins, advanced.classify.answer[itemRow.id], 'id', '类别 ')}}</text><view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
    <view class="cg-cfg-hint" wx:if="{{!advanced.classify.answer[itemRow.id]}}">未选择类别</view>
    </view>
    <view class="cg-adv-add" bindtap="addClassifyItem" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加条目</view>
      </view>
    </view>
    <cy-dropdown wx:if="{{segmentAddOptions.length}}" topic-editor columns="{{2}}" range="{{segmentAddOptions}}" range-key="label" value="{{-1}}" bind:change="addSegment">
      <view class="cg-adv-add" aria-role="button" aria-label="再加一段题目"><cy-icon name="plus" size="28" />再加一段题目</view>
    </cy-dropdown>

    <!-- ===== 《预制人生》五段(施工契约 2026-09-17 §2)。字段名与取值范围照契约写死,
       后端 validator 按同一份契约写 —— 对不上会被直接拒掉,而且不报错。 ===== -->
    <view class="cg-gcfg" wx:if="{{gameSection === 'profile'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">标题 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.profile.title}}" placeholder="例如 出生登记" data-section="profile" data-field="title" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">引导语</view>
    <input class="cg-cfg-input" value="{{advanced.profile.lead}}" placeholder="例如 填完这张表，你就有了身份" data-section="profile" data-field="lead" bindinput="onAdvancedField" />
    <view class="cg-rw-line compact"><view class="cg-rw-name">填写后添加头像</view><cy-switch checked="{{advanced.profile.avatar.enabled}}" data-key="profile.avatar.enabled" bindchange="onAdvancedSubToggle" /></view>
    <view class="cg-rw-line compact" wx:if="{{advanced.profile.avatar.enabled}}"><view class="cg-rw-name">头像必填</view><cy-switch checked="{{advanced.profile.avatar.required}}" data-key="profile.avatar.required" bindchange="onAdvancedSubToggle" /></view>

    <view class="cg-adv-repeat" wx:for="{{advanced.profile.questions}}" wx:key="key" wx:for-index="qi" wx:for-item="q">
    <view class="cg-adv-repeat-head"><text>问题 {{qi + 1}} · 必答</text><view class="cg-adv-del" data-index="{{qi}}" bindtap="removeProfileQuestion" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
    <input class="cg-cfg-input" value="{{q.label}}" placeholder="玩家看到的问题，如 你叫什么" data-index="{{qi}}" data-field="label" bindinput="updateProfileQuestion" />
    <input class="cg-cfg-input" value="{{q.key}}" placeholder="变量名，如 name（字母开头，最多 16 位）" data-index="{{qi}}" data-field="key" bindinput="updateProfileQuestion" />
    <cy-dropdown portal="{{false}}" range="{{profileKinds}}" range-key="label" value="{{opt.idx(profileKinds, q.kind)}}" data-index="{{qi}}" bind:change="pickProfileKind"><view class="cg-pick {{opt.idx(profileKinds, q.kind) < 0 ? 'empty' : ''}}">{{opt.label(profileKinds, q.kind)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
    <block wx:if="{{q.kind === 'text'}}">
      <view><view class="cg-cfg-label">最多几个字</view><input class="cg-cfg-input" type="number" value="{{q.maxLength}}" placeholder="12" data-index="{{qi}}" data-field="maxLength" data-numeric="1" bindinput="updateProfileQuestion" /></view>
    </block>
    <block wx:else>
      <view class="cg-adv-repeat" wx:for="{{q.options}}" wx:key="key" wx:for-index="oi" wx:for-item="o">
        <view class="cg-adv-repeat-head"><text>选项 {{oi + 1}}</text><view class="cg-adv-del" data-qindex="{{qi}}" data-index="{{oi}}" bindtap="removeProfileOption" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
        <input class="cg-cfg-input" value="{{o.label}}" placeholder="玩家看到的文案，如 店员" data-qindex="{{qi}}" data-index="{{oi}}" data-field="label" bindinput="updateProfileOption" />
        <input class="cg-cfg-input" value="{{o.key}}" placeholder="存下来的值，如 clerk" data-qindex="{{qi}}" data-index="{{oi}}" data-field="key" bindinput="updateProfileOption" />
        <view class="cg-rw-line compact"><view class="cg-rw-name">记住这个选择（结局和后文可以用）</view><cy-switch checked="{{opt.memo(o.effects)}}" data-path="{{'profile.questions.' + qi + '.options'}}" data-index="{{oi}}" bindchange="toggleOptionMemo" /></view>
        <view class="cg-cfg-label">选了它之后的效果</view>
        <view class="cg-adv-repeat" wx:for="{{o.effects}}" wx:key="index" wx:for-index="ei" wx:for-item="eff">
          <view class="cg-adv-repeat-head">
            <text>加成 {{ei + 1}}</text>
            <view class="cg-adv-del" data-path="{{'profile.questions.' + qi + '.options.' + oi + '.effects'}}" data-index="{{ei}}" bindtap="removeEffectRow" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
          </view>
          <!-- R3 协调者界面：新行选“需要的数值”（模板内声明，采用到主题时再对应），操作只有增加/恢复到至少；旧/高级行保留原变量输入 -->
          <block wx:if="{{!effectRows['profile.questions.' + qi + '.options.' + oi + '.effects'][ei].legacy}}">
            <view class="cg-cfg-hint" wx:if="{{effectResourceDisabledReason}}">{{effectResourceDisabledReason}}</view>
            <cy-dropdown portal="{{false}}" range="{{effectValueSlots}}" range-key="label" value="{{opt.idx(effectValueSlots, eff.var)}}" data-path="{{'profile.questions.' + qi + '.options.' + oi + '.effects'}}" data-index="{{ei}}" bind:change="pickEffectResource"><view class="cg-pick {{effectRows['profile.questions.' + qi + '.options.' + oi + '.effects'][ei].label ? '' : 'empty'}}" aria-role="button" aria-label="选择需要的数值">{{effectRows['profile.questions.' + qi + '.options.' + oi + '.effects'][ei].label || '选择需要的数值'}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            <block wx:if="{{effectResourceDraft && effectResourceDraft.path === 'profile.questions.' + qi + '.options.' + oi + '.effects' && effectResourceDraft.index === ei}}">
              <input class="cg-cfg-input" value="{{effectResourceDraft.label}}" maxlength="20" placeholder="给需要的数值起名（1 至 20 字），采用到主题时再对应" data-field="label" bindinput="updateEffectResourceField" />
              <view class="cg-tool-actions cg-effect-draft-actions"><view bindtap="saveEffectResource" aria-role="button" aria-label="确认新建需要的数值" hover-class="cy-pressed" hover-stay-time="80">确认</view><view bindtap="closeEffectResource" aria-role="button" aria-label="取消新建" hover-class="cy-pressed" hover-stay-time="80">取消</view></view>
              <cy-inline-error wx:if="{{effectResourceError}}" title="{{effectResourceError.error}}" />
            </block>
