<!-- 创建节点玩法 · 关卡编辑器(玻璃拟态重做) -->
<!-- 视觉照设计稿 docs/design/城市解谜玩法创建.dc.html;数据接真实系统 -->
<!-- 单选一律 cy-dropdown(2026-09-22 用户定):存的是 key、显示的是 label,由 key 反查下标;
     不另存一份「选中下标」—— 模板回填只写 key,另存一份迟早对不上。找不到返回 -1(面板里不打勾,触发器显示「请选择」)。 -->
<wxs module="opt">
  var idx = function (list, key, field) {
    var f = field || 'key';
    for (var i = 0; i < (list || []).length; i++) { if (list[i][f] === key) return i; }
    return -1;
  };
  // 选项上挂没挂「记住这个选择」(tag.m_ 开头的贴标签效果)
  var memo = function (effects) {
    for (var i = 0; i < (effects || []).length; i++) { if (effects[i].op === 'ADD_TAG' && (effects[i].value || '').indexOf('tag.m_') === 0) return true; }
    return false;
  };
  var has = function (list, key) {
    for (var i = 0; i < (list || []).length; i++) { if (list[i].key === key) return true; }
    return false;
  };
  module.exports = {
    has: has,
    // R3：效果行的字段错误（effectErrors 列表）按 path/index 取本行第一条
    rowErr: function (errors, path, index) { for (var i = 0; i < (errors || []).length; i++) { if (errors[i].path === path && errors[i].index === index) return errors[i].error; } return ''; },
    memo: memo,
    idx: idx,
    // 触发器上显示的字:找不到(没选过 / 老模板存了不认识的值)一律「请选择」;没起名的按序号叫
    label: function (list, key, field, prefix) {
      var i = idx(list, key, field);
      if (i < 0) return '请选择';
      return list[i].label || ((prefix || '') + (i + 1));
    },
    names: function (list, prefix) {
      var out = [];
      for (var i = 0; i < (list || []).length; i++) { out.push(list[i].label || (prefix + (i + 1))); }
      return out;
    }
  };
</wxs>
<view class="cg theme-topic-editor {{reducedMotion ? 'cg--reduced-motion' : ''}}">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />

  <!-- ============ 顶部导航 ============ -->
  <!-- 试玩玩法屏时整条导航让位:玩法屏自己带「退出」,再画一个返回箭头会和它叠在一起,
       而且那条白底会把深色的玩法屏框成一张卡。 -->
  <cy-nav-bar wx:if="{{ !(previewVisible && pvKit && pvStepKey === 'challenge') }}" title="{{ previewVisible ? '玩家视角预览' : '编辑玩法模板' }}" title-align="left" custom-back bind:back="goBack" />
  <view class="cg-nav-spacer" style="height: {{ statusBarHeight + navBarHeight }}px;"></view>

  <cy-empty wx:if="{{creatorLoginRequired}}" title="登录后编辑玩法模板" cta="去登录" bind:cta="onCreatorLogin" />
  <view class="cg-load-state" wx:elif="{{editorLoading}}">
    <cy-skeleton type="detail" />
    <view class="cg-load-state__hint">加载中</view>
  </view>
  <view class="cg-load-state" wx:elif="{{loadError}}">
    <view wx:if="{{loadErrorIsOperation}}" bindtap="inspectAdoptionTemplates" aria-role="button" aria-label="查看我的玩法" hover-class="cy-pressed" hover-stay-time="80">查看我的玩法</view>
    <cy-error load-failure="{{!loadErrorIsOperation && !loadErrorIsAccess}}" title="{{loadErrorIsOperation ? '采用尚未确认' : loadErrorIsAccess ? '当前请求无法读取玩法' : '玩法详情加载失败'}}" sub="{{loadError}}" retry="重新加载" bind:retry="retryGetData" />
  </view>

  <!-- ============ 编辑态 ============ -->
  <scroll-view wx:else scroll-y class="cg-scroll" style="padding-top: {{statusBarHeight + navBarHeight}}px;" enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoView}}">
    <text wx:if="{{supportMatrixLoading}}" aria-live="polite">正在读取玩法支持范围</text>
<cy-inline-error load-failure class="cg-inline-error" wx:if="{{supportMatrixLoadError}}" title="{{supportMatrixLoadError}}" action="重试" bind:action="retrySupportMatrix" />

    <!-- 封面 + 名字:原型是**同一张卡** —— 上半是 1:1 的大方块封面(斜纹占位 + 圆形 ＋),
         下半是名字输入框(原型 .hero / .hero-cover / .hero-body)。 -->
    <view class="cg-hero" id="sec-top">
      <view class="cg-hero-cover cg-hero-cover--picked" wx:if="{{ formData.imgUrl || defaultCover }}" bindtap="uploadPic" aria-role="button" aria-label="更换玩法封面" hover-class="cy-pressed" hover-stay-time="80">
        <image class="cg-hero-img" src="{{ formData.imgUrl || defaultCover }}" mode="aspectFill" />
        <view class="cg-cover-del" wx:if="{{formData.imgUrl}}" catchtap="clearCover" aria-role="button" aria-label="删除玩法封面" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="32" /></view>
      </view>
      <view class="cg-hero-cover" wx:else bindtap="uploadPic" aria-role="button" aria-label="上传玩法封面"
            hover-class="cy-pressed" hover-stay-time="80">
        <view class="cg-hero-plus"><cy-icon name="plus" size="36" /></view>
        <view class="cg-hero-c1">上传玩法封面</view>
      </view>
      <view class="cg-hero-body">
        <view class="cg-title-row">
          <text class="req" aria-hidden="true">*</text>
          <input class="cg-title-input {{errors.title ? 'err' : ''}}" bindinput="onTitleChange" value="{{ formData.title }}"
          maxlength="20" placeholder="给这个玩法起个名字" placeholder-class="cg-ph" />
        </view>
        <cy-inline-error class="cg-inline-error" wx:if="{{errors.title}}" title="{{errors.title}}" action="清除" data-field="title" bind:action="clearBasicField" />
      </view>
    </view>


    <!-- ============ 基本信息 ============ -->
    <!-- 从发布页进来的故事玩法不出这张卡:玩法看点 / 人数时长 / 类别都是给公共玩法库用的,
         故事玩法以草稿绑在主题上、不会自动进入广场。走查 W-04:逼作者给「新生儿登记」选
         「运动健身 / 美食烹饪」。 -->
    <!-- 2026-10-22 主人定稿:分区标题放在卡片外,标题前不画竖线 -->
    <view class="cg-sec" id="sec-basic" wx:if="{{from !== 'fabu'}}"><text class="cg-sec__t">模板信息</text></view>
    <cy-card class="cg-card" wx:if="{{from !== 'fabu'}}">

      <!-- 玩法描述 -->
      <view class="cg-field">
        <view class="cg-row-between">
          <view class="cg-label">玩法看点 <text class="req">*</text></view>
          <view class="cg-count">{{ formData.description.length || 0 }}/{{descriptionMaxLength}}</view>
        </view>
        <textarea class="cg-textarea sm {{errors.description ? 'err' : ''}}" value="{{ formData.description }}" bindinput="onDescriptionChange"
          maxlength="{{descriptionMaxLength}}" placeholder="一句话介绍这个玩法的看点" placeholder-class="cg-ph" />
        <cy-inline-error class="cg-inline-error" wx:if="{{errors.description}}" title="{{errors.description}}" action="清除" data-field="description" bind:action="clearBasicField" />
      </view>

      <!-- 2026-10-10 主人裁定：独立模板不再配置玩家人数 / 玩法时长（人数不需要配置；时长在购买主题时按整个主题各站时长汇总展示）。旧模板已存的值后端原样保留回读。 -->
      <!-- 所需材料 / 商铺类型 -->
      <view class="cg-field cg-divider">
        <view class="cg-two">
          <view class="cg-col">
            <view class="cg-label">所需材料</view>
            <input class="cg-input" value="{{ formData.requiredMaterials }}" bindinput="onRequiredMaterialsChange"
              placeholder="如:手机、笔" placeholder-class="cg-ph" />
          </view>
          <view class="cg-col">
            <view class="cg-label">商铺类型</view>
            <view class="cg-pick {{ formData.usageLocation ? '' : 'empty' }}" bindtap="openVenueSheet" hover-class="cy-pressed" hover-stay-time="80">
              <text>{{ formData.usageLocation || '请选择' }}</text><view class="cg-caret"><cy-icon name="back" size="28" /></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 玩法类别(走真实选择页) -->
      <view class="cg-field cg-divider">
        <view class="cg-label">玩法类别 <text class="req">*</text></view>
        <view class="cg-chips">
          <view class="cg-chip" wx:for="{{ categoryList }}" wx:key="id">
            {{ item.categoryName }}
            <view class="cg-chip-x" catchtap="removeCategory" data-id="{{ item.id }}" aria-role="button" aria-label="删除类别 {{item.categoryName}}" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
          </view>
          <view class="cg-chip-add" bindtap="navigateToCategorySelect" aria-role="button" aria-label="添加玩法类别" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加类别</view>
        </view>
        <cy-inline-error class="cg-inline-error" wx:if="{{errors.categoryIds}}" title="{{errors.categoryIds}}" />
      </view>

      <view class="cg-sq-row">
        <view class="cg-sq-meta">
          <view class="cg-sq-name">先保存为我的玩法</view>
        </view>
      </view>

      <!-- 据点玩法语义:正交于「完成方式」,决定玩家在店里看到的是什么形态。
           只有从据点进来才有 —— 普通模板发布 DTO 没有 interaction_type 这个字段。 -->
      <view class="cg-field cg-divider" wx:if="{{ from === 'citynode' }}">
        <view class="cg-label">玩法形态 <text class="req">*</text></view>
        <cy-dropdown portal="{{false}}" range="{{ interactionTypes }}" range-key="label" value="{{ opt.idx(interactionTypes, interactionType) }}" bind:change="onPickInteraction"><view class="cg-pick {{ interactionType ? '' : 'empty' }} {{ errors.interactionType ? 'err' : '' }}"><text>{{ opt.label(interactionTypes, interactionType) }}</text><view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
        <cy-inline-error class="cg-inline-error" wx:if="{{errors.interactionType}}" title="{{errors.interactionType}}" />
      </view>
    </cy-card>

    <!-- ============ 玩法规则 ============ -->
    <view class="cg-sec" id="sec-rule"><text class="cg-sec__t">玩法规则<text class="req" aria-hidden="true">*</text></text></view>
    <cy-card class="cg-card">
      <!-- 原型:序号是个圆点,画在输入框**外面**左侧;每步一个自增高的输入框 + 删除。
           整份规则仍然存在 formData.ruleInstructions 里(一行一步),没有新建后端字段。 -->
      <view class="cg-steps">
        <view class="cg-step" wx:for="{{ ruleSteps }}" wx:key="*this" wx:for-index="si">
          <view class="cg-step-no">{{ si + 1 }}</view>
          <view class="cg-step-field">
            <textarea class="cg-step-ta" value="{{ item }}" data-index="{{ si }}" bindinput="onRuleStepInput"
              auto-height maxlength="60" placeholder="第 {{ si + 1 }} 步要玩家做什么" placeholder-class="cg-ph" />
            <view class="cg-step-del" wx:if="{{ ruleSteps.length > 1 }}" catchtap="removeRuleStep" data-index="{{ si }}"
                  aria-role="button" aria-label="删除第 {{ si + 1 }} 步" hover-class="cy-pressed" hover-stay-time="80">
              <cy-icon name="close-sm" size="28" />
            </view>
          </view>
        </view>
      </view>
      <view class="cg-step-add" bindtap="addRuleStep" aria-role="button" aria-label="添加一步"
            hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加一步</view>
    </cy-card>

    <!-- ============ 玩法模块 ============ -->
    <view id="sec-module"></view>

    <!-- 完成方式缺失提示 -->
    <cy-inline-error class="cg-inline-error cg-inline-error--banner" wx:if="{{errors.finish}}" title="{{errors.finish}}" />

    <block wx:for="{{ moduleList }}" wx:key="key" wx:for-item="mod">

      <!-- ======= 完成方式(核心) ======= -->
      <!-- R5：参与方式（扫码是参与方式，不是玩法）。与玩法互不占位。 -->
      <!-- 参与方式:扫码参与 / 直接参与 / 定位到达(原下拉选项);扫码时「扫完回复」单独一个开关,打开才编辑回复 -->
      <view class="cg-sec" id="sec-join" wx:if="{{ mod.key === 'finish' }}"><text class="cg-sec__t">参与方式</text></view>
      <cy-card class="cg-card" wx:if="{{ mod.key === 'finish' }}">
        <cy-dropdown topic-editor columns="{{2}}" range="{{r5Editor.participationOptions}}" range-key="label" reason-key="reason" value="{{opt.idx(r5Editor.participationOptions, r5Editor.participation)}}" bind:change="pickParticipation">
          <view class="cg-pick" aria-role="button" aria-label="选择参与方式">{{opt.label(r5Editor.participationOptions, r5Editor.participation)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view>
        </cy-dropdown>
        <block wx:if="{{r5Editor.participation === 'scan'}}">
          <view class="cg-rw-line cg-line"><view class="cg-rw-name">扫完回复</view><cy-switch checked="{{advanced.scan.kind !== 'NONE'}}" bindchange="toggleScanReply" accessibility-label="扫完回复" /></view>
          <!-- 照原型:开关打开就是一行回复,不再先选「回复方式」;老模板里的语音 / 图片回复照旧点进去配 -->
          <view class="cg-scan-reply" wx:if="{{advanced.scan.kind !== 'NONE'}}">
            <block wx:if="{{advanced.scan.kind === 'TEXT'}}">
              <textarea class="cg-cfg-textarea" value="{{advanced.scan.reply}}" maxlength="200" auto-height placeholder="例如 欢迎来到老城茶馆" placeholder-class="cg-ph" data-section="scan" data-field="reply" bindinput="onAdvancedField" aria-label="扫完回复的内容" />
            </block>
            <view class="cg-r5-row" wx:else bindtap="openScanSheet" aria-role="button" aria-label="配置扫完回复" hover-class="cy-pressed" hover-stay-time="80">
              <view class="cg-r5-row__main"><text class="cg-r5-row__title cg-r5-row__title--plain">{{opt.label(scanReplyKinds, advanced.scan.kind)}}回复</text><text class="cg-r5-row__sub">{{r5Editor.scanSummary}}</text></view>
              <view class="cg-r5-pill">配置<cy-icon name="chevron-right" size="24" /></view>
            </view>
          </view>
        </block>
      </cy-card>
      <!-- 玩法:标题在卡外(不标星、不挂「核心」),卡里只放所选玩法与形式/怎么出现;玩法自己的设置拆成下面几张卡 -->
      <view class="cg-sec" id="sec-game" wx:if="{{ mod.key === 'finish' }}"><text class="cg-sec__t">玩法</text><view class="cg-sec__act" bindtap="confirmRemoveModule" data-key="finish" aria-role="button" aria-label="移除玩法模块" hover-class="cy-pressed" hover-stay-time="80">移除</view></view>
      <cy-card class="cg-card" wx:if="{{ mod.key === 'finish' }}">
          <!-- 2026-10-22 主人定稿 HTML 原型：选择玩法改为半屏标签弹层，左右滑动 -->
          <view wx:if="{{!gameKey}}" class="cg-r5-row" bindtap="openR5GameSheet" aria-role="button" aria-label="选择玩法" hover-class="cy-pressed" hover-stay-time="80"><view class="cg-r5-row__main"><text class="cg-r5-row__title">选择玩法</text><cy-inline-error wx:if="{{errors.finish}}" class="cg-r5-row__sub is-err" kind="error" title="{{errors.finish}}" /></view><view class="cg-r5-pill">选择<cy-icon name="chevron-right" size="24" /></view></view>
          <block wx:else>
            <view class="cg-r5-row">
              <view class="cg-game-ico cg-game-ico--{{r5Editor.gameTint}}"><cy-icon name="{{gameCurrent.icon}}" size="36" /></view>
              <view class="cg-r5-row__main"><text class="cg-r5-row__title">{{gameCurrent.label}}</text><text class="cg-r5-row__sub" wx:if="{{gameCurrent.sub}}">{{gameCurrent.sub}}</text></view>
              <view class="cg-r5-pill" bindtap="openR5GameSheet" aria-role="button" aria-label="更换玩法" hover-class="cy-pressed" hover-stay-time="80">更换</view>
            </view>
            <!-- 2026-10-23 主人:「形式」不在卡里选了(每种形式在选择玩法里各是一枚标签),卡里只留呈现方式 -->
            <view class="cg-game-opts" wx:if="{{gameKey !== 'bingo' && gameKey !== 'album'}}">
              <view><view class="cg-cfg-label">呈现方式</view>
                <cy-dropdown portal="{{false}}" range="{{presentOptions}}" range-key="label" value="{{opt.idx(presentOptions, presentChoice)}}" disabled="{{presentInlineLocked}}" bind:change="onPickPresent"><view class="cg-pick {{opt.idx(presentOptions, presentChoice) < 0 ? 'empty' : ''}}">{{opt.label(presentOptions, presentChoice)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
              </view>
            </view>
            <view class="cg-cfg-hint" wx:if="{{presentInlineLocked}}">只能整屏：{{presentLockReason}}</view>
          </block>
      </cy-card>
      <view class="cg-inline-cfg" id="game-cfg" wx:if="{{ mod.key === 'finish' && gameKey }}">
    <view class="cg-sec"><text class="cg-sec__t">玩法设置</text></view>
    <cy-inline-error class="cg-inline-error" wx:if="{{r5Editor.error}}" title="{{r5Editor.error}}" />
          <view class="cg-gcfg" wx:if="{{gameKey === 'bingo'}}">
    <view class="cg-cfg-label">九宫格在主题编辑页配置</view>
    </view>
    <!-- 推理类三段:校验错当场说清楚,不必等到点保存(见 data.gameConfigError) -->
    <cy-inline-error class="cg-inline-error" wx:if="{{gameConfigError}}" title="{{gameConfigError}}" />

    <view class="cg-gcfg" wx:if="{{advanced.random.enabled}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">这副卡叫什么</view><input class="cg-cfg-input" value="{{advanced.random.deckName}}" placeholder="如 今日线索卡" data-section="random" data-field="deckName" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">每局抽取数量 <text class="req" aria-hidden="true">*</text></view><input class="cg-cfg-input" type="number" value="{{advanced.random.drawCount}}" data-section="random" data-field="drawCount" data-numeric="1" bindinput="onAdvancedField" />
    <view class="cg-adv-repeat" wx:for="{{advanced.random.items}}" wx:key="id" wx:for-index="ri">
    <view class="cg-adv-repeat-head"><text>物品 {{ri + 1}}</text><view class="cg-adv-del" data-index="{{ri}}" bindtap="removeRandomItem" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
    <input class="cg-cfg-input" value="{{item.id}}" placeholder="唯一 ID，如 clue_1" data-index="{{ri}}" data-field="id" bindinput="updateRandomItem" />
    <input class="cg-cfg-input" value="{{item.label}}" placeholder="玩家看到的名称" data-index="{{ri}}" data-field="label" bindinput="updateRandomItem" />
    <input class="cg-cfg-input" type="number" value="{{item.weight}}" placeholder="权重" data-index="{{ri}}" data-field="weight" data-numeric="1" bindinput="updateRandomItem" />
    <textarea class="cg-cfg-textarea" value="{{item.content}}" placeholder="抽中后展示的内容" data-index="{{ri}}" data-field="content" bindinput="updateRandomItem" />
    </view>
    <view class="cg-adv-add" bindtap="addRandomItem" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加盲盒物品</view>
      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'steps'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">目标步数 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" type="number" value="{{advanced.steps.goal}}" placeholder="100 至 100000" data-section="steps" data-field="goal" data-numeric="1" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">小标题</view>
    <input class="cg-cfg-input" value="{{advanced.steps.eyebrow}}" placeholder="例如 低碳行动 · 今日步数" data-section="steps" data-field="eyebrow" bindinput="onAdvancedField" />
    <view class="cg-cfg-label">奖励分</view>
    <input class="cg-cfg-input" type="number" value="{{advanced.steps.xp}}" placeholder="0 表示不给分" data-section="steps" data-field="xp" data-numeric="1" bindinput="onAdvancedField" />
      </view>
    </view>
    <view class="cg-gcfg" wx:if="{{gameSection === 'estimate'}}">
      <view class="cg-adv-body">
    <view class="cg-cfg-label">题干 <text class="req" aria-hidden="true">*</text></view>
    <input class="cg-cfg-input" value="{{advanced.estimate.title}}" placeholder="例如 这罐咖啡豆有多少颗" data-section="estimate" data-field="title" bindinput="onAdvancedField" />
    <view class="cg-adv-grid">
    <view><view class="cg-cfg-label">单位</view><input class="cg-cfg-input" value="{{advanced.estimate.unit}}" placeholder="颗 / 杯 / 本" data-section="estimate" data-field="unit" bindinput="onAdvancedField" /></view>
    <view><view class="cg-cfg-label">奖励分</view><input class="cg-cfg-input" type="number" value="{{advanced.estimate.xp}}" placeholder="0 表示不给分" data-section="estimate" data-field="xp" data-numeric="1" bindinput="onAdvancedField" /></view>
