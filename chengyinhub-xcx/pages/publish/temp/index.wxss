  border: 2rpx solid #EBEBEB; border-radius: 60rpx; /* ds-ok: Figma 1:18929 实测 */
  background: #FFFFFF; color: #777777; /* ds-ok: Figma 1:18929 实测 */
  font-size: var(--cy-font-body); white-space: nowrap;
}
.cg-tag-pill.is-on { background: #D9D9D9; color: #131313; padding-right: 84rpx; } /* ds-ok: Figma 1:18929 实测 */
.cg-tag-pill.is-off { opacity: .45; }
.cg-tag-pill__ic { flex: none; display: flex; }
.cg-tag-pill__t { white-space: nowrap; }
.cg-tag-pill__ck { position: absolute; right: 32rpx; top: 50%; width: 20rpx; height: 16rpx; margin-top: -8rpx; }
.cg-tsheet__foot { flex: none; display: flex; align-items: center; gap: var(--cy-space-3); padding: var(--cy-space-3) var(--cy-space-1) calc(var(--cy-space-4) + env(safe-area-inset-bottom)); }
.cg-tsheet__sub { flex: 1; min-width: 0; font-size: var(--cy-font-label); line-height: var(--cy-leading-normal); color: var(--cy-color-text-secondary); white-space: normal; }
.cg-tsheet__name { margin-right: var(--cy-space-2); font-weight: 600; color: var(--cy-color-text-primary); }
/* 标签条左右两端按透明度渐隐,提示还能往旁边滑 */
.cg-tstrip { -webkit-mask-image: linear-gradient(to right, transparent 0, black 24rpx, black calc(100% - 48rpx), transparent 100%); mask-image: linear-gradient(to right, transparent 0, black 24rpx, black calc(100% - 48rpx), transparent 100%); }

/* 2026-10-22 开发者工具实拍后补:玩法设置里的分区小标题去掉竖条;扫完回复、三步说明下留出间距;
   编辑浮层里不再灰框套白输入框(和页面一样:白底 + 浅灰输入框);标签条首列让开渐隐区 */
.cg-inline-cfg .cg-qa-sec::before { display: none; }
.cg-scan-reply { padding-top: var(--cy-space-3); }
.cg-fb-steps + .cg-line { margin-top: var(--cy-space-4); }
.cg-edit-sheet .cg-gcfg { background: transparent; border: 0; padding: 0; }
.cg-edit-sheet .cg-gcfg .cg-input, .cg-edit-sheet .cg-gcfg .cg-cfg-input, .cg-edit-sheet .cg-gcfg .cg-textarea,
.cg-edit-sheet .cg-gcfg .cg-cfg-textarea, .cg-edit-sheet .cg-gcfg .cg-pick { background: var(--cy-bg-card-2); border-color: transparent; }
.cg-tstrip__in { padding-left: var(--cy-space-4); padding-right: var(--cy-space-6); }

/* 玩法图标按分类上一层浅色:浅底 + 同色图标,不用渐变 */
.cg-game-ico--qa { background: rgba(252,63,63,.10); color: #E5484D; } /* ds-ok: 原型定稿的玩法分类色 */
.cg-game-ico--logic { background: rgba(91,140,255,.12); color: #3E6FE0; } /* ds-ok: 原型定稿的玩法分类色 */
.cg-game-ico--play { background: rgba(18,184,134,.12); color: #0E9E73; } /* ds-ok: 原型定稿的玩法分类色 */
.cg-game-ico--challenge { background: rgba(124,92,255,.12); color: #6A4CE8; } /* ds-ok: 原型定稿的玩法分类色 */

/* 浮层上下两端按透明度渐隐(2026-10-22 主人定稿):固定头下方、底部各一段,内容滚过去时淡出,不是换颜色 */
.cg-edit-head::after { content: ""; position: absolute; left: 0; right: 0; bottom: -32rpx; height: 32rpx; pointer-events: none;
  background: linear-gradient(var(--cy-color-bg-surface), transparent); }
.cg-sheet::after { content: ""; display: block; position: sticky; bottom: calc(-1 * (var(--cy-space-4) + env(safe-area-inset-bottom))); height: 64rpx; margin-top: -64rpx; pointer-events: none;
  background: linear-gradient(transparent, var(--cy-bg-card)); }

/* 试玩的退出键(2026-10-23):照玩法台面 .st__back 的位置与大小;全屏玩法自己那颗在预览里藏掉,只留这一颗 */
.cg-preview--kit { --pk-back-display: none; }
.cg-pv-exit {
  position: fixed; left: var(--cy-page-x); z-index: var(--cy-z-popover);
  width: 88rpx; height: 88rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(127, 127, 127, .24); color: var(--cy-color-text-inverse);  /* ds-ok 叠在深浅两种玩法皮肤上都看得清的中性半透明 */
}

/* ============ 2026-10-23 主人走查:间距照原型 gameplay-create-proto-20261022(1px = 2rpx) ============
   分区标题 22/4/10、卡片内边距 16、圆角 14、页边 13;开关行上分隔线 + 16 间距;字段之间 16。 */
.cg-sec { margin: 44rpx 26rpx 0; padding: 0 8rpx; }                                 /* ds-ok 原型 .sh 22px 4px 10px */
.cg-sec + .cg-card, .cg-sec + .cg-gcfg, .cg-sec + .cg-inline-error + .cg-gcfg,
.cg-inline-cfg > .cg-sec + .cg-gcfg, .cg-inline-cfg > .cg-sec + .cg-inline-error + .cg-gcfg { margin-top: var(--cy-space-2-5); }
.cg-card { margin-left: 26rpx; margin-right: 26rpx; --cy-comp-card-pad: var(--cy-space-4); --cy-comp-card-radius: 28rpx; } /* ds-ok 原型 .card 16px / 14px,页边 13px */
.cg-inline-cfg > .cg-gcfg, .cg-inline-cfg > .cg-cfg { margin-left: 26rpx; margin-right: 26rpx; padding: var(--cy-space-4); border-radius: 28rpx; } /* ds-ok 同上 */
.cg-line { display: flex; align-items: center; min-height: 88rpx; margin-top: var(--cy-space-4); padding-top: var(--cy-space-1-5); } /* ds-ok 原型 .frow.line 44px */
.cg-scan-reply { padding-top: var(--cy-space-1); }
.cg-game-opts { margin-top: var(--cy-space-4); }
.cg-addmod { margin: 44rpx 26rpx 0; }                                                 /* ds-ok 原型 .addmod margin-top 22px */

/* 底部两颗按钮直接浮在页面上(2026-10-23 主人:不要白底栏)。
   栏本身只留一层页面底色的透明度渐隐,滚到下面的字不会和按钮叠在一起;
   查看预览是黑色主键,不能点时是半透明黑而不是一行灰字;保存草稿是白色胶囊带投影。 */
.cg-bottombar {
  background: linear-gradient(to bottom, rgba(243, 244, 244, 0), var(--cy-color-bg-page) 58%); /* ds-ok 页面底色的透明度渐隐 */
  backdrop-filter: none; border-top: 0; box-shadow: none;
  padding-top: var(--cy-space-6);
  --cy-bg-subtle: rgba(17, 18, 20, .28);              /* ds-ok 不能点的主键:半透明黑 */
  --cy-text-placeholder: #FFFFFF;                     /* ds-ok 同上,字仍是白 */
  --cy-comp-btn-secondary-bg: #FFFFFF;                /* ds-ok 保存草稿:白胶囊浮在灰页面上 */
}
.cg-bottombar > cy-btn { border-radius: var(--cy-comp-btn-radius); box-shadow: 0 12rpx 32rpx rgba(17, 18, 20, .12); } /* ds-ok 浮起来的投影 */

/* ===== 10-28 原型 A e-temp / e-after:分组列表 + 就地展开(检定段、添加加值半屏、消耗与效果半屏) =====
   L1 的半屏基础样式(feature/cy27-l1-editor-d20)落地后并过去,这里不再单留一份。 */
/* 检定段沿用 cg-gcfg > cg-adv-body 外壳(段形状契约),里面这一层盖住白卡,分组列表直接落在页面底色上 */
.cg-ios-flat { margin: calc(-1 * var(--cy-space-4)); padding-bottom: var(--cy-space-1); background: var(--cy-color-bg-page); }
.cg-ios-grp { background: var(--cy-color-bg-surface); border-radius: var(--cy-radius-lg); overflow: hidden; }
.cg-ios-grp + .cg-ios-grp, .cg-ios-gap { margin-top: var(--cy-space-3); }
.cg-ios-hd { display: flex; align-items: flex-end; justify-content: space-between; padding: 44rpx var(--cy-space-4) 14rpx; font-size: var(--cy-font-label); color: var(--cy-color-text-tertiary); } /* ds-ok 原型 .ios-hd 22px 7px */
.cg-ios-hd__act { font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-color-text-primary); }
.cg-ios-ft { padding: 14rpx var(--cy-space-4) 0; font-size: var(--cy-font-label); color: var(--cy-color-text-tertiary); } /* ds-ok 原型 .ios-ft 7px */
.cg-ios-ft.is-err { color: var(--cy-color-status-danger); }
.cg-ios-row { position: relative; display: flex; align-items: center; gap: 20rpx; min-height: 100rpx; padding: var(--cy-space-2) var(--cy-space-4); box-sizing: border-box; background: var(--cy-color-bg-surface); } /* ds-ok 原型 .ios-row 50px */
.cg-ios-row + .cg-ios-row::before { content: ""; position: absolute; left: var(--cy-space-4); right: 0; top: 0; height: 1rpx; background: var(--cy-color-border-subtle); }
.cg-ios-row.is-sub { padding-left: 56rpx; }
.cg-ios-row.is-add .cg-ios-t { font-weight: 600; }
.cg-ios-row.is-off { pointer-events: none; }
.cg-ios-row.is-off .cg-ios-t { color: var(--cy-color-text-disabled); }
.cg-ios-row.is-off .cg-ios-add { background: var(--cy-color-text-disabled); }
.cg-ios-row.is-danger { justify-content: center; }
.cg-ios-row.is-danger .cg-ios-t { color: var(--cy-color-status-danger); }
.cg-ios-m { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
.cg-ios-t { font-size: var(--cy-font-body); color: var(--cy-color-text-primary); }
.cg-ios-t.is-l { flex: none; min-width: 128rpx; }
.cg-ios-v { flex: none; max-width: 60%; font-size: var(--cy-font-body); color: var(--cy-color-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cg-ios-in { flex: 1 1 auto; min-width: 0; text-align: right; font-size: var(--cy-font-body); color: var(--cy-color-text-primary); }
.cg-ios-in.is-l { text-align: left; }
.cg-ios-fold { flex: none; display: flex; color: var(--cy-color-text-tertiary); transition: transform var(--cy-motion-expand) var(--cy-ease-standard); }
.cg-ios-fold.is-open { transform: rotate(90deg); }
.cg-ios-chk { flex: none; display: flex; color: var(--cy-color-text-primary); visibility: hidden; }
.cg-ios-chk.is-on { visibility: visible; }
.cg-ios-add { flex: none; width: 44rpx; height: 44rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); } /* ds-ok 原型 .ios-ic--add 22px,行本身是命中区 */
.cg-ios-seg { flex: 1 1 auto; display: flex; padding: 4rpx; border-radius: var(--cy-radius-sm); background: var(--cy-color-bg-surface-subtle); }
.cg-ios-seg > view { flex: 1; min-height: 64rpx; padding: 0 var(--cy-space-1); display: flex; align-items: center; justify-content: center; border-radius: var(--cy-radius-sm); font-size: var(--cy-font-label); color: var(--cy-color-text-primary); white-space: nowrap; }
.cg-ios-seg > view.is-on { background: var(--cy-color-bg-surface); font-weight: 600; box-shadow: var(--cy-shadow-card); }
.cg-ios-stp { margin-left: auto; display: flex; align-items: center; gap: var(--cy-space-2); font-size: var(--cy-font-body); color: var(--cy-color-text-primary); }
.cg-ios-stp > view { min-width: 88rpx; min-height: 64rpx; padding: 0 var(--cy-space-2); box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: var(--cy-radius-sm); background: var(--cy-color-bg-surface-subtle); font-size: var(--cy-font-body); }
.cg-ios-stp > view.is-dis { pointer-events: none; color: var(--cy-color-text-disabled); }
.cg-ios-minus { width: 24rpx; height: 4rpx; border-radius: var(--cy-radius-pill); background: currentColor; }
.cg-ios-pills { display: flex; flex-wrap: wrap; gap: var(--cy-space-2); padding: var(--cy-space-2) var(--cy-space-4) var(--cy-space-3); background: var(--cy-color-bg-surface); }
.cg-ios-pill { min-height: 64rpx; padding: 0 var(--cy-space-3); display: flex; align-items: center; border-radius: var(--cy-radius-pill); background: var(--cy-color-bg-surface-subtle); font-size: var(--cy-font-label); color: var(--cy-color-text-primary); }
.cg-ios-pill-in { flex: 1 1 240rpx; min-height: 64rpx; padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--cy-color-bg-surface-subtle); font-size: var(--cy-font-label); }
.cg-ios-sheet { background: var(--cy-color-bg-page); }
.cg-ios-sheet .cg-edit-head { background: var(--cy-color-bg-page); }
.cg-edit-head__done.is-ghost { background: transparent; }
