.cg-hero-body { padding: var(--cy-space-4); }           /* ds-ok 原型 16px */

.cg-pv-inline-scroll { position:absolute; inset:0; height:100%; padding-top:calc(env(safe-area-inset-top) + 160rpx); box-sizing:border-box;
  background:#000000; color:var(--cy-color-text-inverse); } /* ds-ok 160rpx 让开胶囊与翻页条;#000 = 玩家暗色 --cy-color-bg-page(故事流 .chfull 的底)。本分包是浅色主题,令牌在这里解析成浅灰,只能写死 */
/* 与玩家故事流 pages/play/index.wxss 的 .chfull__kit 逐条一致(契约测试钉着)。 */
.cg-pv-inline-kit { margin:0 var(--cy-page-x); --pe-unfold:1; --pk-stage-pos:relative; --pk-stage-height:auto; --pk-stage-body-pos:relative; --pk-stage-bg:transparent; --pk-stage-overflow:visible; --pk-back-display:none; --pk-col-pos:relative; --pk-col-pad:0; --pk-col-align:stretch; --pk-col-text:left; --pk-btn-pos:relative; --pk-btn-x:0; --pk-btn-bottom:0; --pk-btn-mt:var(--cy-space-5); --cy-play-question-size:44rpx; --pk-q-weight:600; --pk-row-justify:flex-start; --pk-qt-radius:32rpx; } /* ds-ok 同 .chfull__kit */
/* 2026-09-23 用户:题目和作答放到页面中间(与玩家故事流内嵌玩法同一口径) */
.cg-pv-inline-kit { min-height:calc(100vh - env(safe-area-inset-top) - 160rpx - 300rpx); display:flex; flex-direction:column; }
/* 2026-10-23 复查:用上下 auto 外边距居中,不用 justify-content:center —— 内容比容器高时(D20 掷出后多一条难度线)
   后者会往上溢出,把标题顶到退出键底下;auto 外边距只在有余量时才居中 */
.cg-pv-inline-kit > cy-playkit, .cg-pv-inline-kit > cy-playkit-journey-check { margin-top: auto; margin-bottom: auto; }
.cg-pv-inline-end { padding:var(--cy-space-6) var(--cy-page-x) 300rpx; } /* ds-ok 300rpx 让开底部翻页条 */
/* 同玩家故事流 .chfull__continue(白底深字全圆角)。预览里只是示意,不可点。 */
.cg-pv-inline-continue { height:88rpx; border-radius:var(--cy-radius-pill); display:flex; align-items:center; justify-content:center;
  background:#FFFFFF; color:#111111; font-size:29rpx; font-weight:700; opacity:.5; } /* ds-ok 29rpx 同 .chfull__continue */

/* ===== R5 模板编辑器（2026-10-10 主人批准原型 template-editor-v2-proto.html）=====
   首页每项同一种行：图标 + 名称 + 一行摘要 + 右侧「配置 ›」药丸；配置都在底部面板，
   面板页头统一「左 退出（放弃本次改动）/ 右 完成（校验后保存）」；单选一律下拉，
   选择玩法 / 参与方式 / 形式 / 互动工具用 cy-dropdown 两列卡片档。 */
.cg-r5-row { display: flex; align-items: center; gap: var(--cy-space-2-5); min-height: var(--cy-btn-h); padding: var(--cy-space-2) 0; }
.cg-r5-row--hr { border-top: 1rpx solid var(--cy-color-border-subtle); }
.cg-r5-row.is-off { opacity: .55; }
.cg-r5-ico { flex: none; width: var(--cy-btn-h); height: var(--cy-btn-h); border-radius: var(--cy-radius-pill); background: var(--cy-color-bg-surface-subtle); display: flex; align-items: center; justify-content: center; color: var(--cy-color-text-primary); }
.cg-r5-row__main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.cg-r5-row__title { font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-color-text-primary); }
.cg-r5-row__title--plain { font-weight: 500; }
.cg-r5-row__title .cg-tag { margin-left: var(--cy-space-1-5); vertical-align: 2rpx; }
.cg-r5-row__sub { margin-top: 4rpx; font-size: var(--cy-font-label); color: var(--cy-color-text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cg-r5-row__sub.is-err { color: var(--cy-color-status-danger); }
.cg-r5-pill { flex: none; display: flex; align-items: center; gap: 4rpx; min-height: 64rpx; padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--cy-color-bg-surface-subtle); font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-color-text-primary); }
.cg-r5-sec { margin: var(--cy-space-1) 0 var(--cy-space-2); font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-color-text-secondary); }
.cg-r5-gap { margin-top: var(--cy-space-3); }
.cg-chips { display: flex; flex-wrap: wrap; gap: var(--cy-space-1-5); }
.cg-chip { min-height: 56rpx; padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--cy-color-bg-surface-subtle); display: flex; align-items: center; font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-color-text-primary); }
.cg-chip.is-on { background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); }

/* 编辑面板：不用毛玻璃 —— backdrop-filter 会把面板变成 fixed 子层的包含块，面板内的下拉会错位。 */
.cg-sheet.cg-edit-sheet { backdrop-filter: none; background: var(--cy-color-bg-surface); padding-top: var(--cy-space-2); }
.cg-edit-sheet .cg-gcfg { margin-top: var(--cy-space-3); }
.cg-mask.cg-mask--top { z-index: 97; }
.cg-sheet.cg-edit-sheet--top { z-index: 98; }
.cg-edit-head { position: sticky; top: calc(-1 * var(--cy-space-2)); z-index: 1; display: flex; align-items: center; gap: var(--cy-space-2); min-height: var(--cy-btn-h); padding: var(--cy-space-2) 0; background: var(--cy-color-bg-surface); }
.cg-edit-head__exit { flex: none; min-width: var(--cy-btn-h); min-height: var(--cy-btn-h); display: flex; align-items: center; font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-color-text-primary); }
.cg-edit-head__title { flex: 1; min-width: 0; text-align: center; font-size: var(--cy-comp-sheet-title-size); font-weight: 700; color: var(--cy-color-text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cg-edit-head__done { flex: none; min-width: 128rpx; height: var(--cy-btn-h); padding: 0 var(--cy-space-4); box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: var(--cy-radius-pill); background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); font-size: var(--cy-font-body); font-weight: 700; }

/* 结果之后：消耗一行两格（数值下拉 + 数量），效果为「数值 / 怎么改」一行两格 + 数量 */
.cg-r5-line, .cg-r5-effect { margin-bottom: var(--cy-space-2); }
.cg-r5-line > cy-dropdown, .cg-r5-effect cy-dropdown { flex: 1; min-width: 0; }
.cg-r5-effect .cg-two { margin-bottom: var(--cy-space-1-5); }
.cg-r5-amount { flex: 1; min-width: 0; display: flex; align-items: center; gap: var(--cy-space-1-5); }
.cg-r5-amount .cg-cfg-input { flex: 1; min-width: 0; margin-bottom: 0; }
.cg-r5-del { flex: none; width: var(--cy-btn-h); height: var(--cy-btn-h); display: flex; align-items: center; justify-content: center; color: var(--cy-color-text-secondary); }
.cg-adv-add.cg-adv-add--danger { border-style: solid; border-color: transparent; color: var(--cy-color-status-danger); }

/* 选项问答（2026-10-11 主人批准 HTML 原型）：分区标题、两项一行、选项内“选中后的反馈”（文字 + 最多 3 张图） */
.cg-qa-sec { display: flex; align-items: center; gap: var(--cy-space-1-5); margin: var(--cy-space-4) 0 var(--cy-space-2); padding-top: var(--cy-space-3-5); border-top: 1rpx solid var(--cy-border-line); font-size: var(--cy-font-body); font-weight: 800; color: var(--cy-text-title); }
.cg-qa-sec::before { content: ""; width: 6rpx; height: 28rpx; border-radius: 3rpx; background: var(--cy-brand); flex: none; } /* ds-ok: 6rpx 宽标题装饰竖条用半宽 3rpx 圆角，保留现有胶囊端部几何；无等值圆角 token */
.cg-qa-sec--first { margin-top: 0; padding-top: 0; border-top: 0; }
.cg-qa-pair { margin-bottom: var(--cy-space-1); }
.cg-qa-pair .cg-cfg-input { margin-bottom: 0; }
.cg-qa-fb { padding: var(--cy-space-2-5); border-radius: var(--cy-radius-md); background: var(--cy-bg-card); display: flex; flex-direction: column; gap: var(--cy-space-2); }
.cg-qa-fb .cg-cfg-label { margin-bottom: 0; }
.cg-qa-fb .cg-cfg-textarea { background: var(--cy-bg-card-2); }
.cg-qa-imgs { flex-wrap: wrap; }
.cg-qa-imgs .cg-qmedia-slot, .cg-qa-imgs .cg-qmedia-add { flex: 0 0 160rpx; height: 160rpx; }

/* 多段题目：附加段标题右侧的移除 */
.cg-seg-del { margin-left: auto; font-size: var(--cy-legacy-26); font-weight: 400; color: var(--cy-color-text-secondary); }

/* ============ 2026-10-22 主人定稿(HTML 原型 gameplay-create-proto-20261022) ============
   分区标题放在卡片外、标题前不画竖线;卡片只有一层(白卡 + 浅灰输入框),玩法设置不再灰套白、灰套灰;
   浮层头左「退出」右「完成」同字号同字重;选择玩法 / 添加互动工具是 Figma 胶囊标签。 */
.cg-sec {
  display: flex; align-items: center; gap: var(--cy-space-2);
  margin: var(--cy-space-5) var(--cy-space-4) 0; padding: 0 var(--cy-space-1);
}
.cg-sec__t { font-size: var(--cy-font-subtitle); font-weight: 700; color: var(--cy-text-title); }
.cg-sec__act { margin-left: auto; min-height: var(--cy-btn-h); display: flex; align-items: center; font-size: var(--cy-font-body); color: var(--cy-color-text-secondary); }
.cg-sec + .cg-card, .cg-sec + .cg-gcfg, .cg-sec + .cg-inline-error + .cg-gcfg { margin-top: var(--cy-space-2); }
.cg-line { padding-top: var(--cy-space-3); margin-top: var(--cy-space-3); border-top: 1rpx solid var(--cy-color-border-subtle); justify-content: space-between; }
.cg-line .cg-rw-name { flex: 1; }
.cg-scan-reply { padding-top: var(--cy-space-1); }
.cg-scan-reply cy-dropdown { display: block; margin-bottom: var(--cy-space-1); }
.cg-game-ico { flex: none; width: 76rpx; height: 76rpx; border-radius: var(--cy-radius-md); display: flex; align-items: center; justify-content: center; background: var(--cy-color-bg-surface-subtle); color: var(--cy-color-text-primary); }
.cg-game-opts { margin-top: var(--cy-space-2); }

/* 玩法设置:每块都是与 .cg-card 同一层的白卡,里面只有浅灰输入框 */
.cg-inline-cfg { margin: 0; }
.cg-inline-cfg > .cg-gcfg, .cg-inline-cfg > .cg-cfg {
  margin: var(--cy-space-3) var(--cy-space-4) 0; padding: var(--cy-space-4);
  border: 0; border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface);
}
.cg-inline-cfg > .cg-sec + .cg-gcfg, .cg-inline-cfg > .cg-sec + .cg-inline-error + .cg-gcfg { margin-top: var(--cy-space-2); }
.cg-inline-cfg .cg-gcfg .cg-input, .cg-inline-cfg .cg-gcfg .cg-textarea,
.cg-inline-cfg .cg-gcfg .cg-cfg-input, .cg-inline-cfg .cg-gcfg .cg-cfg-textarea,
.cg-inline-cfg .cg-gcfg .cg-pick { background: var(--cy-bg-card-2); border-color: transparent; }
/* 重复项(选项、步骤)不再是灰底小卡:同一张白卡里用细线分开 */
.cg-inline-cfg .cg-adv-repeat { background: transparent; padding: var(--cy-space-3) 0; border-radius: 0; border-top: 1rpx solid var(--cy-color-border-subtle); }
.cg-inline-cfg .cg-adv-repeat .cg-cfg-input, .cg-inline-cfg .cg-adv-repeat .cg-input,
.cg-inline-cfg .cg-adv-repeat .cg-textarea, .cg-inline-cfg .cg-adv-repeat .cg-pick { background: var(--cy-bg-card-2); }
.cg-adv-add.cg-adv-add--first { margin-top: 0; }

/* 结果反馈:三步说明 + 成功/失败开关 */
.cg-fb-steps { display: flex; flex-direction: column; gap: var(--cy-space-2); }
.cg-fb-step { display: flex; gap: var(--cy-space-2); font-size: var(--cy-font-body); line-height: var(--cy-leading-normal); color: var(--cy-text-title); }
.cg-fb-step__no { flex: none; width: 32rpx; font-weight: 600; color: var(--cy-color-text-secondary); }
.cg-fb-body { padding-top: var(--cy-space-2); }
.cg-fb-body .pgrid { margin: var(--cy-space-1) 0 var(--cy-space-2); }

/* 浮层头:左退出、右完成,同字号同字重,标题居中 */
.cg-edit-head__exit, .cg-edit-head__done {
  flex: none; min-width: 128rpx; height: var(--cy-btn-h); padding: 0; background: transparent; border-radius: 0;
  display: flex; align-items: center; font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-color-text-primary);
}
.cg-edit-head__done { justify-content: flex-end; }

/* 选择玩法:半屏弹层;所有分类排成一条,只能左右滑 */
.cg-tsheet { display: flex; flex-direction: column; height: 70vh; padding-bottom: 0; }
.cg-tsheet.cg-tsheet--auto { height: auto; }
.cg-tstrip { flex: 1; min-height: 0; width: 100%; white-space: nowrap; }
.cg-tstrip__in { display: inline-flex; align-items: flex-start; gap: 56rpx; padding: var(--cy-space-3) var(--cy-space-1) var(--cy-space-2); }
.cg-tblock { display: inline-flex; flex-direction: column; gap: 20rpx; flex: none; }
.cg-tblock__t { font-size: var(--cy-font-label); color: var(--cy-color-text-secondary); height: 36rpx; }
.cg-trow { display: flex; gap: 24rpx; }
.cg-tpad { display: flex; flex-wrap: wrap; gap: 20rpx 24rpx; padding: var(--cy-space-3) var(--cy-space-1) var(--cy-space-2); }
/* Figma「Edit Interests」胶囊(节点 1:18929):高 47、全圆角、1px #EBEBEB 描边;
   未选白底灰字 #777,选中 #D9D9D9 底深字 #131313 + 右侧对勾。宽度随字数。 */
.cg-tag-pill {
  position: relative; flex: none; box-sizing: border-box;
