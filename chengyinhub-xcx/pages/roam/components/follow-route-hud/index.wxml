<view class="frh" wx:if="{{hud}}" aria-role="status" aria-label="{{hud.a11y}}">
  <view class="frh__icon"><cy-icon name="route" size="32" /></view>
  <view class="frh__main">
    <view class="frh__head">
      <text class="frh__name">{{hud.name || '官方线路'}}</text>
      <text class="frh__progress">{{hud.progress || ''}}</text>
    </view>
    <text class="frh__next">{{hud.nextText || ''}}</text>
    <text class="frh__sub" wx:if="{{hud.distText}}">{{hud.distText}} · 仅本机估算，不计入打卡</text>
    <text class="frh__sub" wx:if="{{hud.skippedText}}">{{hud.skippedText}}</text>
  </view>
  <view class="frh__exit" bindtap="onExit" aria-role="button" aria-label="退出跟随线路，继续自由漫游" hover-class="cy-pressed" hover-stay-time="80">
    <text>退出跟随</text>
  </view>
</view>
