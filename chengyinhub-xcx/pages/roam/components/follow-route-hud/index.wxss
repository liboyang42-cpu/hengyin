.frh { display: flex; align-items: center; gap: var(--cy-space-3); margin: 0 var(--cy-space-3-5); padding: var(--cy-space-3); border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-elevated); color: var(--cy-color-text-primary); }
.frh__icon { flex: none; color: var(--cy-color-brand); }
.frh__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.frh__head { display: flex; align-items: baseline; gap: var(--cy-space-2); min-width: 0; }
.frh__name { flex: 1; min-width: 0; font-size: var(--cy-type-body); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.frh__progress { flex: none; font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.frh__next { font-size: var(--cy-type-label); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.frh__sub { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.frh__exit { flex: none; min-width: 88rpx; min-height: 88rpx; padding: 0 var(--cy-space-3); display: flex; align-items: center; justify-content: center; border-radius: var(--cy-radius-pill); border: 1rpx solid var(--cy-color-border-subtle); font-size: var(--cy-type-label); }
.cy-pressed { opacity: .88; }
