<!-- 半屏 sheet:内容短(说明 + 一个链接 + 一个动作),不需要全屏 -->
<cy-scene-sheet show="{{show}}" variant="half" theme="{{theme}}" title="隐私与定位" mask-closable="{{true}}" bind:requestclose="onClose">
  <view class="pv-sheet">
    <text class="pv-sheet__body">城瘾会在你使用相关功能时处理必要信息。漫游定位仅用于实时位置展示、到点打卡和轨迹记录；不使用时不会在后台持续采集。</text>
    <view class="pv-sheet__link" bindtap="openPrivacyContract" aria-role="button" aria-label="查看用户隐私保护指引" hover-class="cy-pressed" hover-stay-time="80">查看《用户隐私保护指引》</view>

    <!-- N015 敏感地点遮挡:手动选点,只存本机;分享时这些地点附近的轨迹点/打卡地点会被去掉 -->
    <text class="pv-sheet__title">分享时遮挡敏感地点</text>
    <view class="pv-sheet__row" wx:for="{{maskZones}}" wx:key="id">
      <text class="pv-sheet__row-label">{{item.name}} · {{item.r}} 米内</text>
      <text class="pv-sheet__zone-remove" data-id="{{item.id}}" bindtap="removeMaskZone" aria-role="button" aria-label="移除敏感地点 {{item.name}}" hover-class="cy-pressed">移除</text>
    </view>
    <cy-btn wx:if="{{maskZones.length < maskZoneMax}}" variant="secondary" class="pv-sheet__action" bindtap="addMaskZone">添加敏感地点</cy-btn>
    <text class="pv-sheet__sub">{{maskZones.length ? '分享足迹时会去掉这些地点附近的轨迹点和打卡地点；只对之后的分享生效，已发出的图片不会改变。' : '还没有设置。可以添加家、公司等不想出现在分享图上的地点（最多 ' + maskZoneMax + ' 处）。'}}坐标仍会量化，但无法保证绝对推断不出住址。</text>
    <cy-inline-error class="pv-sheet__warn" wx:if="{{saveError}}" kind="data"
      title="隐私设置未保存" sub="{{saveError}}" />

    <text class="pv-sheet__title">漫游定位</text>
    <text class="pv-sheet__sub">撤回后，漫游不会继续读取实时位置或记录新的轨迹。</text>
    <cy-btn variant="secondary" loading="{{submitting}}" disabled="{{submitting}}" class="pv-sheet__action" bindtap="withdrawRoamLocationConsent">撤回漫游定位同意</cy-btn>
  </view>
</cy-scene-sheet>
