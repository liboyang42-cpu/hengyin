<!-- 主办方「我发的这条路线」视图。
     与 project-join 同一套视觉词汇(浅灰底 + 白卡 + 关系入口),但对象不同:
     承接方管的是自己那一站,主办方管的是整条线上谁在帮他。
     同样只负责渲染,所有点击从 bind:act 冒泡回页面。 -->
<!-- 2026-10-31 业主批准 P-6:俱乐部主办用同一套页面,深色 -->
<view class="page {{ hostOwnerType === 'club' ? 'theme-dark' : 'theme-merchant' }}">
  <!-- 2026-09-18 ✕统一裁决:打卡码弹层显示时导航退场,唯一出口是弹层✕/遮罩 -->
  <cy-nav-bar overlay pill pillDark scrolled="{{navScrolled}}" tint="{{navScrolled ? '' : 'light'}}" wx:if="{{!navHidden}}" />

  <cy-error class="load-error" wx:if="{{ loadFailed }}" load-failure="{{true}}" style="padding-top: {{ statusBarHeight + navBarHeight }}px;" />

  <block wx:else>
  <view class="hero">
    <image class="hero-img" wx:if="{{ hostTopic.img }}" src="{{ hostTopic.img }}" mode="aspectFill" />
    <view class="hero-img hero-img--fallback" wx:else></view>
    <view class="hero-scrim"></view>
    <view class="hero-status">
      <view class="hero-status-dot {{ recruitDone ? 'state-running' : 'state-ok' }}"></view>
      <text>{{ hostStatusText }}</text>
    </view>
  </view>


  <view class="head">
    <view class="head-title">{{ hostTopic.name }}</view>
    <view class="head-meta">
      <view class="meta-chip">
        <cy-icon name="calendar" size="{{ 26 }}" />
        <text>{{ hostTopic.scheduleValue || '开放时间待定' }}</text>
      </view>
      <view class="chip head-role">主办</view>
    </view>
    <view class="head-chips" wx:if="{{hostPlayers.paidCount > 0}}">
      <view class="chip" wx:if="{{ hostPlayers.paidCount > 0 }}">已售 {{ hostPlayers.paidCount || 0 }} 份</view>
    </view>

  </view>

  <!-- ===== 四个关系入口 ===== -->
  <view class="qa">
    <view class="qa-btn {{ item.disabled ? 'qa-btn--off' : '' }}" wx:for="{{ quickActions }}" wx:key="key" aria-disabled="{{ !!item.disabled }}"
          data-act="onQuickAction" data-key="{{ item.key }}" bindtap="emit" hover-class="{{ item.disabled ? 'none' : 'qa-btn--tap' }}">
      <view class="qa-ico"><cy-icon wx:if="{{item.iconName}}" name="{{item.iconName}}" size="40" /><image wx:else class="qa-ico-img" src="{{ item.icon }}" mode="aspectFit" /></view>
      <text class="qa-label">{{ item.label }}</text>
    </view>
  </view>

  <!-- 走查 v2 R14(业主 2026-10-30):商家发自由探索,要先邀 1 家俱乐部承办,对方接受后才能开售 -->
  <view class="gate" wx:if="{{ needExecutorClub }}">
    <text class="gate-t">邀请一个俱乐部承办后才能开始售票</text>
    <view class="gate-btn" bindtap="emit" data-act="onQuickAction" data-key="club" aria-role="button" aria-label="去邀请俱乐部承办" hover-class="cy-pressed" hover-stay-time="80">去邀请</view>
  </view>

  <!-- ===== 售卖 ===== -->
  <view class="sec">
    <view class="sec-head">
      <text class="sec-title">售卖</text>
      <view class="sec-action" bindtap="emit" data-act="goFinance" hover-class="cy-pressed" hover-stay-time="80">
        <text>结算</text>
        <cy-icon name="arrow-right" size="{{ 24 }}" />
      </view>
    </view>
    <view class="metrics">
      <view class="metric">
        <text class="metric-n">{{ hostPlayers.paidCount }}</text>
        <text class="metric-l">已售份数</text>
      </view>
      <view class="metric">
        <text class="metric-n">{{ hostRecruit.nodeFilled }}</text>
        <text class="metric-l">已招节点</text>
      </view>
      <view class="metric" wx:if="{{ hostOwnerType !== 'club' }}">
        <text class="metric-n">{{ clubCount }}</text>
        <text class="metric-l">合作俱乐部</text>
      </view>
    </view>
    <!-- 只给聚合量:玩家跟主办方之间没有需要电话联系的契约,核销靠扫码 -->
    <!-- CU-C-123:零单不再补一句「数字为 0 是正常的」—— 上面那格已经把 0 摆在眼前,
         这句只解释显而易见的事实、不给动作,还占掉指标卡与底部入口之间的一整行。 -->
  </view>

  <!-- 2026-11-01 业主:与俱乐部活动详情(Figma 俱乐部 H4–H6)同一块 —— 开售后出「核销」三格,右上「记录」进核销台账 -->
  <view class="sec" wx:if="{{ showVerify }}">
    <view class="sec-head">
      <text class="sec-title">核销</text>
      <view class="sec-action" bindtap="emit" data-act="goLedger" aria-role="button" aria-label="打开核销台账" hover-class="cy-pressed" hover-stay-time="80">
        <text>台账</text>
        <cy-icon name="arrow-right" size="{{ 24 }}" />
      </view>
    </view>
    <view class="metrics">
      <view class="metric">
        <text class="metric-n">{{ hostPlayers.pendingCount || 0 }}</text>
        <text class="metric-l">待核销</text>
      </view>
      <view class="metric">
        <text class="metric-n">{{ hostPlayers.arrivedCount || 0 }}</text>
        <text class="metric-l">已核销</text>
      </view>
    </view>
  </view>

  <!-- 2026-11-01 业主:商家打开主题卡也能看剧情、玩法与答案,与俱乐部活动详情「主题」同一块 -->
  <view class="sec">
    <view class="sec-head"><text class="sec-title">主题</text></view>
    <view class="tcard" bindtap="emit" data-act="goStory" aria-role="button" aria-label="打开剧情与玩法" hover-class="cy-pressed" hover-stay-time="80">
      <image class="tcard-cover" wx:if="{{ hostTopic.img }}" src="{{ hostTopic.img }}" mode="aspectFill" lazy-load="true" />
      <view class="tcard-body">
        <text class="tcard-name">{{ hostTopic.name }}</text>
        <text class="tcard-sub" wx:if="{{ topicStructure }}">{{ topicStructure }}</text>
        <view class="tcard-more"><text>打开剧情与玩法</text><cy-icon name="arrow-right" size="{{ 24 }}" /></view>
      </view>
    </view>
  </view>

  <view class="sec" wx:if="{{ hostTopic.circleThemeCode }}">
    <view class="sec-head">
      <text class="sec-title">30天供给复核</text>
      <text class="sec-action">{{ hostTopic.circleReviewText }}</text>
    </view>
    <view class="sec-empty">系统会重新校验3—4家当前供给；少于3家、资料过期或商家重复时不会刷新。</view>
    <!-- BL-183:模板副本的8个候选全部是关闭的,不先选角色就没有可复核的供给。
         只有这一个写接口,没有读当前已选的接口 —— 半屏不预选、不假装知道现在开了哪几个。 -->
    <cy-btn variant="secondary" bindtap="emit" data-act="openCircleConfig">选择供给角色</cy-btn>
    <cy-btn variant="secondary" bindtap="emit" data-act="reviewCircleSupplies">确认本实例供给已复核</cy-btn>
  </view>

  <view class="page-pad"></view>

  <!-- 走查 v2 R04/R16(业主 2026-10-30):底部「查看收到的申请」撤掉 —— 申请在招商 / 俱乐部弹窗里处理,不跳出主题。
       换成进度:做完是洋红勾,当前这步洋红圈 + 蓝字状态,子项写还差什么、右侧蓝字直接去处理;每一步都能点开对应弹窗。 -->
  <view class="pg" wx:if="{{ hostProgress.length }}">
    <view class="pg-h"><text class="pg-t">进度</text><text class="pg-hr">{{ hostTopic.productType == 2 ? '自由探索' : '城市定向' }} · 主办</text></view>
    <view class="pg-row pg-row--{{ step.state }} {{ step.lock ? 'pg-row--lock' : '' }}" wx:for="{{ hostProgress }}" wx:for-item="step" wx:key="key">
      <view class="pg-rail">
        <view class="pg-dot pg-dot--{{ step.state }} {{ step.lock ? 'pg-dot--lock' : '' }}">
          <cy-icon wx:if="{{ step.lock }}" name="lock" size="{{ 20 }}" />
        </view>
        <view class="pg-line {{ step.state === 'done' ? 'pg-line--done' : '' }}"></view>
      </view>
      <view class="pg-m">
        <view class="pg-top">
          <text class="pg-lab">{{ step.label }}</text>
          <text class="pg-stat" wx:if="{{ step.status }}">{{ step.status }}</text>
          <text class="pg-ask" wx:elif="{{ step.lock }}">{{ step.lock }}</text>
        </view>
        <view class="pg-sub" wx:if="{{ step.subs.length }}">
          <view class="pg-si {{ sub.ok ? 'pg-si--ok' : 'pg-si--now' }}" wx:for="{{ step.subs }}" wx:for-item="sub" wx:key="text">
            <view class="pg-si-dot"></view>
            <text class="pg-si-t">{{ sub.text }}</text>
            <text class="pg-go" wx:if="{{ sub.act }}" bindtap="emit" data-act="{{ sub.act }}" data-key="{{ sub.actKey || '' }}"
                  aria-role="button" aria-label="{{ sub.actText }}" hover-class="cy-pressed" hover-stay-time="80">{{ sub.actText }}</text>
            <cy-icon class="pg-go-ico" wx:if="{{ sub.act }}" name="chevron-right" size="{{ 22 }}" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 2026-11-01 业主:底部固定条与俱乐部活动详情 / 承接视图同一套 ——「哪些内容还能改」压在主键正上方,主键按状态变 -->
  <view class="foot-space"></view>
  <view class="bottom-bar" wx:if="{{ hostPrimary.text }}">
    <view class="rules" bindtap="emit" data-act="toggleRules" aria-role="button" aria-expanded="{{rulesOpen}}"
          aria-label="{{rulesOpen ? '收起可修改内容说明' : '查看哪些内容还能修改'}}" hover-class="cy-pressed" hover-stay-time="80">
      <cy-icon name="info" size="{{ 26 }}" />
      <text wx:if="{{ rulesOpen }}">开卖后日期、节点和票价不能再改，名称、描述和封面可以随时改。</text>
      <text wx:else>哪些内容还能改</text>
      <cy-icon wx:if="{{ !rulesOpen }}" name="arrow-right" size="24" />
    </view>
    <cy-btn variant="primary" style="width:100%" disabled="{{ hostPrimary.disabled }}"
            bindtap="emit" data-act="{{ hostPrimary.act }}" data-key="{{ hostPrimary.key }}">{{ hostPrimary.text }}</cy-btn>
  </view>
  </block>


  <!-- ===== 俱乐部抽屉 ===== -->
  <project-drawer show="{{ clubSheet.show }}" title="合作俱乐部" actions="{{ clubActions }}" under="{{ layers.clubInvite.show || layers.clubHome.show }}"
                  bind:close="emitCloseClub" bind:action="emitDrawerAction">
    <!-- 走查 v2 R05(业主 2026-10-30):顶部三格数,下面「已邀约」与「可以邀约的俱乐部」两组;每行「邀约 / 主页」,不跳出主题 -->
    <view class="cs-sum">
      <view class="cs-sum-i"><text class="cs-sum-n">{{ clubAccepted }}</text><text class="cs-sum-l">已合作</text></view>
      <view class="cs-sum-i"><text class="cs-sum-n">{{ clubSheet.items.length - clubAccepted }}</text><text class="cs-sum-l">等回复</text></view>
      <view class="cs-sum-i"><text class="cs-sum-n">{{ clubCandidates.rows.length }}</text><text class="cs-sum-l">可邀约</text></view>
    </view>
    <block wx:if="{{ clubSheet.items.length }}">
      <view class="dg-label">已邀约</view>
      <view class="dcard cs-list">
      <view class="dr" wx:for="{{ clubSheet.items }}" wx:key="clubId">
        <image class="dr-avatar dr-avatar--round" wx:if="{{ item.logo }}" src="{{ item.logo }}" mode="aspectFill" />
        <view class="dr-avatar dr-avatar--round dr-avatar--fallback" wx:else>{{ item.initial }}</view>
        <view class="dr-text">
          <view class="dr-line1">
            <text class="dr-name">{{ item.name }}</text>
            <text class="dr-tag {{ item.accepted ? 'dr-tag--ok' : 'dr-tag--wait' }}"
                  wx:if="{{ item.statusText }}">{{ item.statusText }}</text>
          </view>
          <text class="dr-sub" wx:if="{{ item.leaderName || item.terms }}">{{ item.leaderName ? '负责人 ' + item.leaderName : '' }}{{ item.leaderName && item.terms ? ' · ' : '' }}{{ item.terms }}</text>
          <!-- 2026-10-31 P-6:三格状态 已发出 → 已读 → 已接受;走完的格子实心,当前一格在走 -->
          <view class="trk" wx:if="{{ item.track }}">
            <view class="trk-i {{ step.cls }}" wx:for="{{ item.track }}" wx:for-item="step" wx:key="label"><view class="trk-bar"><view class="trk-fill"></view></view><text>{{ step.label }}</text></view>
          </view>
          <view class="dr-phone" wx:if="{{ item.phone }}">
            <text class="dr-phone-n">{{ item.phone }}</text>
            <view class="dr-copy" catchtap="emit" data-act="copyText" data-text="{{ item.phone }}" aria-role="button" aria-label="复制电话" hover-class="cy-pressed" hover-stay-time="80"><image class="dr-copy-img" src="/pages/topic/images/icon_copy.svg" mode="aspectFit" /></view>
          </view>
          <text class="dr-sub" wx:else>未留电话</text>
        </view>
        <view class="cs-pill cs-pill--g" catchtap="emit" data-act="openClubHome" data-id="{{ item.clubId }}" aria-role="button" aria-label="打开 {{ item.name }} 主页" hover-class="cy-pressed" hover-stay-time="80">主页</view>
      </view>
      </view>
    </block>
    <block wx:if="{{ clubCandidates.state }}">
      <view class="dg-label">可以邀约的俱乐部</view>
      <cy-skeleton wx:if="{{ clubCandidates.state === 'loading' }}" type="list" count="{{ 3 }}" />
      <cy-inline-error wx:elif="{{ clubCandidates.state === 'error' }}" kind="data" title="俱乐部列表没读到" action="重试" data-act="loadClubCandidates" bind:action="emit" />
      <view class="dcard cs-list" wx:elif="{{ clubCandidates.rows.length }}">
      <view class="dr" wx:for="{{ clubCandidates.rows }}" wx:key="id">
        <image class="dr-avatar dr-avatar--round" wx:if="{{ item.logo }}" src="{{ item.logo }}" mode="aspectFill" />
        <view class="dr-avatar dr-avatar--round dr-avatar--fallback" wx:else>{{ item.initial }}</view>
        <view class="dr-text">
          <text class="dr-name ep1">{{ item.name }}</text>
          <text class="dr-sub" wx:if="{{ item.meta }}">{{ item.meta }}</text>
        </view>
        <view class="cs-pill" catchtap="emit" data-act="inviteClubRow" data-id="{{ item.id }}" data-name="{{ item.name }}" aria-role="button" aria-label="邀约 {{ item.name }}" hover-class="cy-pressed" hover-stay-time="80">邀约</view>
        <view class="cs-pill cs-pill--g" catchtap="emit" data-act="openClubHome" data-id="{{ item.id }}" aria-role="button" aria-label="打开 {{ item.name }} 主页" hover-class="cy-pressed" hover-stay-time="80">主页</view>
      </view>
      </view>
      <cy-empty wx:else size="sm" title="附近暂时没有可以邀约的俱乐部" />
    </block>
    <cy-empty wx:if="{{ !clubSheet.items.length && !clubCandidates.state }}" title="还没有俱乐部带团" />
  </project-drawer>

  <!-- ===== 承接商家抽屉(主办方独有) ===== -->
  <!-- CU-C-126:原来 headerVariant="action" 走「取消 / 标题 / 完成」,两颗都只执行 onClose,
       面板内又没有待保存表单 —— 「完成」不完成任何业务动作,还和同类抽屉的右上 ✕ 不一致。
       退回默认标题头(右上 ✕),真正的招商动作留在底部 merchantActions(去找商家 / 收到的申请)。 -->
  <project-drawer class="{{ hostOwnerType === 'club' ? 'theme-dark' : '' }}" show="{{ merchantSheet.show }}" title="招商" actions="{{ merchantActions }}" under="{{ layers.tier.show || layers.shops.show }}"
                  bind:close="emitCloseMerchant" bind:action="emitDrawerAction">
    <!-- 走查 v2 R06(业主 2026-10-30):顶部三格;每一站用主题图、给「自己承接 / 招商」;收到的申请在弹窗里确认,不跳出主题 -->
    <view class="cs-sum">
      <!-- 2026-10-31 P-6:有站点行(自由探索每站一个档位)时按站点数;城市定向仍按节点 -->
      <view class="cs-sum-i"><text class="cs-sum-n">{{ recruitStations.length ? stationSum.taken + '/' + recruitStations.length : hostRecruit.nodeFilled + '/' + hostRecruit.nodeTotal }}</text><text class="cs-sum-l">已招站点</text></view>
      <view class="cs-sum-i"><text class="cs-sum-n">{{ recruitStations.length ? stationSum.pending : (hostRecruit.pendingCount || 0) }}</text><text class="cs-sum-l">待处理申请</text></view>
      <view class="cs-sum-i"><text class="cs-sum-n">{{ recruitStations.length ? stationSum.open : hostRecruit.openNodes.length }}</text><text class="cs-sum-l">还没人接</text></view>
    </view>

    <!-- 2026-10-31 业主批准 P-6 招商第三版:档位挂在每一站上(cms_topic_chapter.terms_mode),同一站所有商家条件相同;
         还没人接的站可以改档(叠「这一站的档位」),已有商家接了就锁住(后端同样拒)。「招商」叠附近商家。 -->
    <block wx:if="{{ recruitStations.length }}">
      <view class="dg-label">站点</view>
      <view class="dcard cs-list">
        <view class="dr st3" wx:for="{{ recruitStations }}" wx:key="chapterId">
          <image class="dr-avatar" wx:if="{{ hostTopic.img }}" src="{{ hostTopic.img }}" mode="aspectFill" />
          <view class="dr-avatar dr-avatar--fallback" wx:else><cy-icon name="discover-shop" size="{{ 32 }}" /></view>
          <view class="dr-text">
            <text class="dr-name ep1">{{ item.name }}</text>
            <view class="st3-t"><text class="tchip tchip--{{ item.tierKey }}" wx:if="{{ item.tierLabel }}">{{ item.tierLabel }}</text><text class="dr-sub ep1">{{ item.takerName || item.termsText }}</text></view>
          </view>
          <text class="dr-tag dr-tag--ok" wx:if="{{ item.state === 'taken' }}">已承接</text>
          <text class="dr-tag" wx:elif="{{ item.state === 'off' }}">未开放</text>
          <block wx:else>
            <view class="cs-pill cs-pill--g" catchtap="emit" data-act="openTierLayer" data-id="{{ item.chapterId }}" aria-role="button" aria-label="{{ item.name }}的档位" hover-class="cy-pressed" hover-stay-time="80">档位</view>
            <view class="cs-pill" catchtap="emit" data-act="openShopsLayer" data-id="{{ item.chapterId }}" aria-role="button" aria-label="为 {{ item.name }} 招商" hover-class="cy-pressed" hover-stay-time="80">招商</view>
          </block>
        </view>
      </view>
    </block>

    <block wx:if="{{ regApplies.rows.length }}">
      <view class="dg-label">收到的申请</view>
      <view class="dcard cs-list">
      <view class="dr" wx:for="{{ regApplies.rows }}" wx:key="id">
        <image class="dr-avatar" wx:if="{{ item.logo }}" src="{{ item.logo }}" mode="aspectFill" />
        <view class="dr-avatar dr-avatar--fallback" wx:else>{{ item.initial }}</view>
        <view class="dr-text">
          <text class="dr-name">{{ item.name }}</text>
          <text class="dr-sub" wx:if="{{ item.place }}">申请 {{ item.place }}</text>
        </view>
        <view class="cs-pill" catchtap="emit" data-act="confirmRegRow" data-id="{{ item.id }}" data-name="{{ item.name }}" aria-role="button" aria-label="确认 {{ item.name }}" hover-class="cy-pressed" hover-stay-time="80">确认</view>
      </view>
      </view>
    </block>
    <cy-inline-error wx:if="{{ regApplies.state === 'error' }}" kind="data" title="收到的申请没读到" action="重试" data-act="loadRegApplies" bind:action="emit" />

    <block wx:if="{{ ownerChapterApplicationsState === 'error' || pendingMerchantNodesState === 'error' }}">
      <view class="review-error">
        <text>章节审核数据没加载完整，请重试后再判断是否无人申请。</text>
        <view class="review-retry" catchtap="emit" data-act="retryChapterReviews" hover-class="cy-pressed" hover-stay-time="80">重新加载</view>
      </view>
    </block>

    <block wx:if="{{ ownerChapterApplications.length }}">
      <view class="dg-label">章节承接申请</view>
      <view class="dcard">
        <view class="review-row" wx:for="{{ ownerChapterApplications }}" wx:key="id">
          <view class="review-main">
            <view class="dr-line1">
              <text class="dr-name ep1">{{ item.merchantName || '未命名商家' }}</text>
              <text class="dr-tag {{ item.actionable ? 'dr-tag--wait' : '' }}">{{ item.statusLabel }}</text>
            </view>
            <text class="dr-sub">{{ item.chapterName || '未命名章节' }} · {{ item.sourceLabel }}</text>
            <text class="dr-sub" wx:if="{{ item.message }}">{{ item.message }}</text>
            <text class="dr-sub" wx:if="{{ item.auditRemark && !item.actionable }}">处理说明：{{ item.auditRemark }}</text>
            <text class="dr-sub" wx:if="{{ item.actionable }}">通过本申请时，该商家已提交的节点会一并过审</text>
          </view>
          <view class="review-actions" wx:if="{{item.revocableInvite}}">
            <view class="review-btn review-btn--ghost" catchtap="emit" data-act="revokeChapterInvitation" data-id="{{item.id}}" aria-role="button" aria-label="撤回章节邀请" hover-class="cy-pressed" hover-stay-time="80">撤回邀请</view>
          </view>
          <view class="review-actions" wx:if="{{ item.actionable }}">
            <view class="review-btn review-btn--ghost" catchtap="emit" data-act="auditChapterApplication"
                  data-id="{{item.id}}" data-approved="{{false}}" hover-class="cy-pressed" hover-stay-time="80">拒绝</view>
            <view class="review-btn" catchtap="emit" data-act="auditChapterApplication"
                  data-id="{{item.id}}" data-approved="{{true}}" hover-class="cy-pressed" hover-stay-time="80">确认</view>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{ pendingMerchantNodes.length }}">
      <!-- CU-C-63(用户裁定 A:保持联动):章节申请通过时,该商家待审核的点位在同一次处置里
           一并通过 —— 这张卡只是**过审后**更新的点位,单独审核只适用于这一类更新。
           原来两张卡都写「待审核」+ 各自一颗「通过」,看不出哪一半会被连带处置。 -->
      <view class="dg-label">过审后更新的节点（单独审核）</view>
      <view class="dcard">
        <view class="review-row" wx:for="{{ pendingMerchantNodes }}" wx:key="id">
          <view class="review-main">
            <view class="dr-line1"><text class="dr-name ep1">{{ item.name || '未命名节点' }}</text></view>
            <text class="dr-sub" wx:if="{{ item.address }}">{{ item.address }}</text>
            <text class="dr-sub" wx:if="{{ item.description }}">{{ item.description }}</text>
          </view>
          <view class="review-actions">
            <view class="review-btn review-btn--ghost" catchtap="emit" data-act="auditMerchantNode"
                  data-id="{{item.id}}" data-approved="{{false}}" hover-class="cy-pressed" hover-stay-time="80">驳回</view>
            <view class="review-btn" catchtap="emit" data-act="auditMerchantNode"
                  data-id="{{item.id}}" data-approved="{{true}}" hover-class="cy-pressed" hover-stay-time="80">通过</view>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{ hostMerchants.length }}">
      <view class="dg-label">已确认</view>
      <view class="dcard">
      <view class="dr" wx:for="{{ hostMerchants }}" wx:key="registrationId">
        <image class="dr-avatar" wx:if="{{ item.logo }}" src="{{ item.logo }}" mode="aspectFill" />
        <view class="dr-avatar dr-avatar--fallback" wx:else><cy-icon name="discover-shop" size="{{ 32 }}" /></view>
        <view class="dr-text">
          <view class="dr-line1">
            <text class="dr-name ep1">{{ item.name || '未命名商家' }}</text>
            <text class="dr-tag dr-tag--self" wx:if="{{ item.isSelf }}">自己的店</text>
            <text class="dr-tag" wx:if="{{ item.statusText }}">{{ item.statusText }}</text>
          </view>
          <text class="dr-sub" wx:if="{{ item.nodeName }}">{{ item.nodeName }}</text>
          <view class="dr-phone" wx:if="{{ item.phone }}">
            <text class="dr-phone-n">{{ item.phone }}</text>
            <view class="dr-copy" catchtap="emit" data-act="copyText" data-text="{{ item.phone }}" aria-role="button" aria-label="复制电话" hover-class="cy-pressed" hover-stay-time="80"><image class="dr-copy-img" src="/pages/topic/images/icon_copy.svg" mode="aspectFit" /></view>
          </view>
        </view>
      </view>
      </view>
    </block>

    <block wx:if="{{ hostRecruit.openNodes.length }}">
      <view class="dg-label">还没人接</view>
      <view class="dcard">
      <view class="dn" wx:for="{{ hostRecruit.openNodes }}" wx:key="nodeId">
        <image class="dn-img" wx:if="{{ hostTopic.img }}" src="{{ hostTopic.img }}" mode="aspectFill" />
        <view class="dn-img dn-img--none" wx:else><cy-icon name="image" size="{{ 32 }}" /></view>
        <text class="dn-name">{{ item.nodeName || '未命名节点' }}</text>
        <view class="cs-pill cs-pill--g" catchtap="emit" data-act="selfTakeNode" data-id="{{ item.nodeId }}" data-name="{{ item.nodeName }}" aria-role="button" aria-label="自己承接 {{ item.nodeName }}" hover-class="cy-pressed" hover-stay-time="80">自己承接</view>
        <view class="cs-pill" catchtap="emit" data-act="recruitNode" data-id="{{ item.nodeId }}" aria-role="button" aria-label="为 {{ item.nodeName }} 招商" hover-class="cy-pressed" hover-stay-time="80">招商</view>
      </view>
      </view>
    </block>

    <!-- CU-M-181:原来这句写着「先去编辑里加站点」,但抽屉底部那颗按钮恒写「去找商家」,
         照着空态做找不到「编辑」,照按钮点又落进没有站点可承接的空页。空态只陈述前置条件,
         怎么补交给底部那颗按 nodeTotal 换出来的「去加站点」。 -->
    <cy-empty wx:if="{{ !recruitStations.length && !hostMerchants.length && !hostRecruit.openNodes.length }}" title="这条路线还没有配置节点" sub="先把节点配好，商家才有可承接的站。" />
  </project-drawer>

  <!-- ===== 圈层供给角色抽屉(BL-183) ===== -->
  <project-drawer show="{{ circleConfig.show }}" title="选择供给角色" subtitle="选 3–4 个，每类至少一个"
                  actions="{{ circleConfig.submitting ? [] : circleConfigActions }}"
                  bind:close="emitCloseCircleConfig" bind:action="emitCircleConfigSubmit">
    <view class="dg-sub">保存后需重新确认</view>
    <view class="dcard">
      <view class="dpick" wx:for="{{ circleCandidates }}" wx:key="code"
            catchtap="toggleCircleCandidate" data-code="{{ item.code }}"
            aria-role="checkbox" aria-checked="{{ item.picked }}" aria-label="{{ item.name }}"
            hover-class="cy-pressed" hover-stay-time="80">
        <view class="dpick-text">
          <text class="dpick-name">{{ item.name }}</text>
          <text class="dpick-sub">{{ item.roleLabel }} · {{ item.merchant }}</text>
        </view>
        <text class="dpick-tag {{ item.picked ? 'dpick-tag--on' : '' }}">{{ item.picked ? '已选' : '未选' }}</text>
      </view>
    </view>
    <view class="dg-sub" wx:if="{{ circleConfigHint }}">{{ circleConfigHint }}</view>
    <cy-inline-error wx:if="{{ circleConfig.errorText }}" kind="data" title="{{ circleConfig.errorTitle || '供给角色没有保存' }}"
      sub="{{ circleConfig.errorText }}" />
  </project-drawer>

  <!-- ===== 「更多」抽屉:按 role + 状态分组(2026-09-05) ===== -->
  <project-drawer show="{{ moreSheet.show }}" title="更多" bind:close="emitCloseMore"> <!-- 2026-10-31 P-6:与合作俱乐部 / 招商 / 客户同一档全屏 -->
    <!-- CU-C-68:站点资格探不到时给一行可见且可重试的说明 —— 探不到 ≠ 没资格,
         不能静静把「本站运营」那一组灰着不解释。 -->
    <cy-inline-error wx:if="{{ stationOpsErrorText }}" kind="data" title="本站运营项没能确认"
      sub="{{ stationOpsErrorText }}" action="重新确认" data-act="probeStationOperable" bind:action="emit" />
    <block wx:for="{{ moreSheet.groups }}" wx:key="head" wx:for-item="grp">
      <view class="more-group" wx:if="{{grp.visibleRows.length}}">
        <view class="dpick {{ row.disabled ? 'dpick--off' : '' }}" wx:for="{{ grp.visibleRows }}" wx:for-item="row" wx:key="key"
              catchtap="emit" data-act="onMorePick" data-key="{{ row.key }}" hover-class="cy-pressed" hover-stay-time="80">
          <view class="dpick-text">
            <text class="dpick-name {{ row.danger ? 'dpick-name--danger' : '' }}">{{ row.label }}</text>
          </view>
          <view wx:if="{{ row.key === 'chapterOpen' && row.switchKnown }}" catchtap="noop" hover-class="cy-pressed" hover-stay-time="80">
            <cy-switch checked="{{ row.checked }}" disabled="{{ row.disabled || row.busy }}"
              accessibility-label="{{ row.label }}" bind:change="emit" data-act="onMorePick" data-key="{{ row.key }}" />
          </view>
          <text class="dpick-tag dpick-tag--{{ row.tagKind || 'neutral' }}" wx:elif="{{ row.tag }}">{{ row.tag }}</text>
        </view>
      </view>
    </block>
  </project-drawer>

  <!-- ===== 本主题客户抽屉 ===== -->
  <project-drawer show="{{ playerSheet.show }}" title="客户" under="{{ broadcastSheet.show }}" done-text="{{ playerPick.selecting ? '完成' : '' }}" customer-mode="{{true}}" actions="{{ playerActions }}"
                  bind:close="emitClosePlayer" bind:action="emitDrawerAction">
    <!-- CU-C-67:名单读失败与「一单没卖」是两个态 —— 失败时不摆三个 0(那读起来就是「没人买票」),
         就地给可重试的错态。零单空态仍在 playerSheet.emptyText 那一条里。 -->
    <cy-inline-error load-failure wx:if="{{ playerSheet.errorText }}" kind="data" title="客户名单加载失败"
      sub="{{ playerSheet.errorText }}" action="重新加载" data-act="retryPlayerSheet" bind:action="emit" />
    <block wx:else>
    <!-- 走查 v2 R07(业主 2026-10-30 定稿):汇总改成数字在上、名称在下的格子,与招商 / 俱乐部弹窗一致 -->
    <view class="dsum" wx:if="{{ playerSheet.shopDay }}">
      <view class="dsum-i"><text class="dsum-n">{{ playerSheet.visibleCount || 0 }}</text><text class="dsum-l">本店现场可见</text></view>
      <view class="dsum-i"><text class="dsum-n">{{ playerSheet.redeemedCount || 0 }}</text><text class="dsum-l">已核销</text></view>
    </view>
    <view class="dsum" wx:else>
      <view class="dsum-i"><text class="dsum-n">{{ playerSheet.notSelling ? '—' : (playerSheet.summary.paidCount || 0) }}</text><text class="dsum-l">已售</text></view>
      <view class="dsum-i"><text class="dsum-n">{{ playerSheet.notSelling ? '—' : (playerSheet.summary.pendingCount || 0) }}</text><text class="dsum-l">还没到店</text></view>
      <!-- 稿 471:6605 汇总是四格:已售 / 待核销 / 已接洽 / 已核销。
           已接洽 = 玩家扫过码等我确认,原来它被并进「待核销」里数。 -->
      <view class="dsum-i" wx:if="{{ playerSheet.summary.contactedCount }}"><text class="dsum-n">{{ playerSheet.summary.contactedCount || 0 }}</text><text class="dsum-l">已接洽</text></view>
      <view class="dsum-i"><text class="dsum-n">{{ playerSheet.notSelling ? '—' : (playerSheet.summary.arrivedCount || 0) }}</text><text class="dsum-l">已核销</text></view>
      <view class="dsum-i" wx:if="{{ playerSheet.summary.refundedCount }}"><text class="dsum-n">{{ playerSheet.summary.refundedCount || 0 }}</text><text class="dsum-l">已退款</text></view>
    </view>
    <view class="dfil" wx:if="{{ !playerSheet.notSelling }}">
      <view class="dfil-item {{ playerSheet.filter === item.key ? 'dfil-item--on' : '' }}"
            wx:for="{{ playerFilters }}" wx:key="key" wx:if="{{ item.key !== 'contacted' || playerSheet.summary.contactedCount }}"
            catchtap="emit" data-act="onPlayerFilter" data-key="{{ item.key }}" hover-class="cy-pressed" hover-stay-time="80">{{ item.label }}</view>
      <!-- 2026-11-01 业主:在客户名单里直接勾人发消息 -->
      <view class="pl-sel" wx:if="{{ playerPick.can && !playerPick.selecting }}" catchtap="emit" data-act="togglePlayerPick" aria-role="button" aria-label="选择要发消息的客户" hover-class="cy-pressed" hover-stay-time="80">选择</view>
    </view>

    <view class="dg-sub" wx:if="{{ playerSheet.contactHint }}">{{ playerSheet.contactHint }}</view>

    <view class="player-list">
    <block wx:if="{{ playerSheet.groups.length }}">
      <block wx:for="{{ playerSheet.groups }}" wx:for-item="g" wx:key="key">
        <!-- 走查 v2 W2-07 / F7:「全部」里上面还没到店、下面已核销,各带人数 -->
        <view class="pl-h" wx:if="{{ g.title }}"><text>{{ g.title }}</text><text class="pl-h-n">{{ g.rows.length }}</text></view>
        <view class="dr player-row {{ playerPick.selecting && playerPick.off[p.memberId] ? 'player-row--off' : '' }}" wx:for="{{ g.rows }}" wx:for-item="p" wx:key="registrationId"
              bindtap="emit" data-act="{{ playerPick.selecting ? 'pickPlayerRow' : '' }}" data-id="{{ p.memberId }}" hover-class="{{ playerPick.selecting ? 'cy-pressed' : 'none' }}" hover-stay-time="80">
          <view class="pl-check {{ playerPick.ids[p.memberId] ? 'pl-check--on' : '' }}" wx:if="{{ playerPick.selecting }}"></view>
          <image class="dr-avatar dr-avatar--round" wx:if="{{ p.avatar }}" src="{{ p.avatar }}" mode="aspectFill" />
          <view class="dr-avatar dr-avatar--round dr-avatar--fallback" wx:else>{{ p.initial }}</view>
          <view class="dr-text">
            <view class="dr-line1"><text class="dr-name">{{ p.name || '未留姓名' }}</text></view>
            <text class="dr-sub">{{ p.when }}<block wx:if="{{ p.arrivedTimeText }}"> · {{ p.arrivedTimeText }} 核销</block></text>
            <view class="dr-phone" wx:if="{{ p.phone }}">
              <text class="dr-phone-n">{{ p.phone }}</text>
              <view class="dr-copy" catchtap="emit" data-act="copyText" data-text="{{ p.phone }}" aria-role="button" aria-label="复制电话" hover-class="cy-pressed" hover-stay-time="80"><image class="dr-copy-img" src="/pages/topic/images/icon_copy.svg" mode="aspectFit" /></view>
            </view>
          </view>
          <text class="pl-nomsg" wx:if="{{ playerPick.selecting && playerPick.off[p.memberId] }}">不接收</text>
          <text class="dr-state dr-state--{{ p.state }}" wx:else>{{ p.stateText }}</text>
        </view>
      </block>
    </block>
    <view class="dempty {{ playerSheet.notSelling ? 'dempty--closed' : '' }}" wx:else>{{ playerSheet.emptyText }}</view>
    </view>
    <!-- 2026-11-01 业主:俱乐部也要能发通知 —— 俱乐部主办走俱乐部群发通知,默认发给本主题这一场的报名玩家 -->
    <view class="bcast-row" wx:if="{{ hostOwnerType === 'club' }}" catchtap="emit" data-act="openClubNotify" aria-role="button" aria-label="发通知" hover-class="cy-pressed" hover-stay-time="80">
      <text class="bcast-t">发通知</text>
      <text class="bcast-s">发给本主题的报名玩家</text>
      <cy-icon name="chevron-right" size="{{ 28 }}" />
    </view>
    </block>
  </project-drawer>
  <!-- ===== 叠层(2026-10-31 业主批准 P-6):都叠在抽屉上,不跳出主题 ===== -->
  <!-- 2026-11-01 业主定稿(审阅页 65gFrW…):定向广播 —— 顶部横滑头像选人(头像 + 名字 + 状态),下面范围与内容,底部发送 -->
  <project-layer show="{{ broadcastSheet.show }}" depth="{{ 2 }}" title="定向广播" data-act="closeBroadcast" bind:back="emit">
    <block wx:if="{{ broadcastSheet.sent }}">
      <view class="bx-sent">
        <view class="bx-sent-ok"></view>
        <text class="bx-sent-t">已发出</text>
        <text class="bx-sent-n">{{ broadcastSheet.count || 0 }} 人</text>
      </view>
      <view class="bx-rows">
        <view class="bx-row"><text class="bx-row-t">会收到</text><text class="bx-row-s">{{ broadcastSheet.count || 0 }} 人</text></view>
        <view class="bx-row"><text class="bx-row-t">这次没发</text><text class="bx-row-s">{{ broadcastSheet.skipped || 0 }} 人</text></view>
        <view class="bx-row"><text class="bx-row-t">今天还能发</text><text class="bx-row-s">{{ broadcastSheet.remaining || 0 }} 条</text></view>
      </view>
      <view class="bx-quote">{{ broadcastSheet.content }}</view>
    </block>
    <block wx:else>
      <view class="bx-to">
        <text class="bx-to-t">发给</text>
        <text class="bx-to-n" wx:if="{{ broadcastSheet.state === 'ready' || broadcastSheet.state === 'none' }}">{{ broadcastSheet.count || 0 }} 人</text>
        <view class="bx-clear" wx:if="{{ broadcastSheet.state === 'ready' && broadcastSheet.count }}" bindtap="emit" data-act="clearBroadcastPicks" aria-role="button" aria-label="清空已选" hover-class="cy-pressed" hover-stay-time="80">清空</view>
      </view>
      <scroll-view class="bx-strip" scroll-x enhanced show-scrollbar="{{ false }}" wx:if="{{ broadcastSheet.state === 'ready' || broadcastSheet.state === 'loading' }}">
        <view class="bx-strip-in">
          <block wx:if="{{ broadcastSheet.state === 'loading' }}">
            <view class="bx-p" wx:for="{{ 5 }}" wx:key="*this"><view class="bx-av bx-av--sk"></view><view class="bx-sk-t"></view></view>
          </block>
          <view class="bx-p {{ item.picked ? 'bx-p--on' : '' }} {{ item.off ? 'bx-p--off' : '' }}" wx:for="{{ broadcastSheet.rows }}" wx:key="id"
                bindtap="emit" data-act="pickBroadcastRow" data-id="{{ item.id }}" aria-role="checkbox" aria-checked="{{ item.picked }}" aria-label="{{ item.name }}，{{ item.statusText }}" hover-class="{{ item.off ? 'none' : 'cy-pressed' }}" hover-stay-time="80">
            <view class="bx-av">
              <image class="bx-av-img" wx:if="{{ item.avatar }}" src="{{ item.avatar }}" mode="aspectFill" lazy-load="true" />
              <text wx:else>{{ item.initial }}</text>
              <view class="bx-tick"></view>
            </view>
            <text class="bx-pn">{{ item.name }}</text>
            <text class="bx-ps bx-ps--{{ item.statusKey }}">{{ item.statusText }}</text>
          </view>
        </view>
      </scroll-view>
      <view class="bx-quiet" wx:elif="{{ broadcastSheet.state === 'none' }}"><text>现在没有能收到消息的玩家</text></view>
      <view class="bx-quiet" wx:elif="{{ broadcastSheet.state === 'error' }}">
        <text>{{ broadcastSheet.error }}</text>
        <text class="bx-quiet-a" bindtap="emit" data-act="openBroadcast" aria-role="button" aria-label="重新读取收件人" hover-class="cy-pressed" hover-stay-time="80">重试</text>
      </view>
      <view class="bx-seg">
        <view class="bx-chip {{ broadcastSheet.scope === 'all' ? 'bx-chip--on' : '' }}" bindtap="emit" data-act="setBroadcastScope" data-scope="all" aria-role="button" aria-label="全部买票玩家" hover-class="cy-pressed" hover-stay-time="80">全部买票玩家</view>
        <view class="bx-chip {{ broadcastSheet.scope === 'pending' ? 'bx-chip--on' : '' }}" bindtap="emit" data-act="setBroadcastScope" data-scope="pending" aria-role="button" aria-label="还没到店" hover-class="cy-pressed" hover-stay-time="80">还没到店</view>
        <view class="bx-chip {{ broadcastSheet.scope === 'arrived' ? 'bx-chip--on' : '' }}" bindtap="emit" data-act="setBroadcastScope" data-scope="arrived" aria-role="button" aria-label="已核销" hover-class="cy-pressed" hover-stay-time="80">已核销</view>
      </view>
      <view class="bx-field">
        <textarea class="bx-ta" maxlength="50" placeholder="写点什么，比如：周六下雨，第三站改到室内" value="{{ broadcastSheet.content }}" disabled="{{ broadcastSheet.sending }}" data-act="onBroadcastInput" bindinput="emitInput" />
        <text class="bx-count">{{ broadcastSheet.content.length || 0 }}/50</text>
      </view>
    </block>
    <view slot="foot">
      <view class="bx-send" wx:if="{{ broadcastSheet.sent }}" bindtap="emit" data-act="closeBroadcast" aria-role="button" aria-label="完成" hover-class="cy-pressed" hover-stay-time="80">完成</view>
      <view class="bx-send {{ broadcastSheet.canSend ? '' : 'bx-send--off' }}" wx:else bindtap="emit" data-act="sendBroadcast" aria-role="button" aria-label="{{ broadcastSheet.sendText }}" aria-disabled="{{ !broadcastSheet.canSend }}" hover-class="cy-pressed" hover-stay-time="80">{{ broadcastSheet.sendText }}</view>
    </view>
  </project-layer>
  <!-- 邀约俱乐部:字段照 coop/invite(按人分成金额 / 引流合作、邀请语),只是搬进叠层 -->
  <project-layer show="{{ layers.clubInvite.show }}" depth="{{ layers.clubInvite.depth }}" title="邀约俱乐部" data-act="closeLayer" data-layer="clubInvite" bind:back="emit">
    <view class="lv-to">
      <image class="dr-avatar dr-avatar--round" wx:if="{{ layers.clubInvite.logo }}" src="{{ layers.clubInvite.logo }}" mode="aspectFill" />
      <view class="dr-avatar dr-avatar--round dr-avatar--fallback" wx:else>{{ layers.clubInvite.initial }}</view>
      <view class="lv-to-t"><text class="lv-to-n">{{ layers.clubInvite.name }}</text><text class="lv-to-s">{{ hostTopic.name }}</text></view>
    </view>
    <view class="dg-label">合作方式</view>
    <view class="dcard lv-terms">
      <view class="lv-seg">
        <view class="lv-seg-i {{ layers.clubInvite.shareMode === 2 ? 'is-on' : '' }}" catchtap="emit" data-act="setClubInviteMode" data-mode="{{ 2 }}" aria-role="button" aria-label="按人分成" hover-class="cy-pressed" hover-stay-time="80">按人分成</view>
        <view class="lv-seg-i {{ layers.clubInvite.shareMode === 0 ? 'is-on' : '' }}" catchtap="emit" data-act="setClubInviteMode" data-mode="{{ 0 }}" aria-role="button" aria-label="引流合作" hover-class="cy-pressed" hover-stay-time="80">引流合作</view>
      </view>
      <view class="lv-fee" wx:if="{{ layers.clubInvite.shareMode === 2 }}">
        <text>每核销 1 位玩家</text>
        <view class="lv-fee-v"><text>¥</text><input class="lv-fee-in" type="digit" value="{{ layers.clubInvite.fee }}" placeholder="0" data-act="onClubInviteFee" bindinput="emitInput" /></view>
      </view>
    </view>
    <view class="dg-label">邀请语</view>
    <view class="dcard lv-msg"><textarea class="lv-msg-in" value="{{ layers.clubInvite.message }}" placeholder="邀请贵俱乐部来参加活动" maxlength="200" auto-height data-act="onClubInviteMessage" bindinput="emitInput" /></view>
    <text class="lv-err" wx:if="{{ layers.clubInvite.error }}">{{ layers.clubInvite.error }}</text>
    <view slot="foot" class="lv-send {{ layers.clubInvite.sending ? 'is-busy' : '' }}" catchtap="emit" data-act="sendClubInvite" aria-role="button" aria-label="发出邀约" hover-class="cy-pressed" hover-stay-time="80">{{ layers.clubInvite.sending ? '正在发出…' : '发出邀约' }}</view>
  </project-layer>

  <!-- 俱乐部主页:主理人、四格数据(没有的写「—」)、标签与常去区域、完整介绍、最近带过的活动、最近动态与成员 -->
  <project-layer show="{{ layers.clubHome.show }}" depth="{{ layers.clubHome.depth }}" under="{{ layers.clubInvite.show }}" title="{{ layers.clubHome.name || '俱乐部' }}" data-act="closeLayer" data-layer="clubHome" bind:back="emit">
    <cy-skeleton wx:if="{{ layers.clubHome.state === 'loading' }}" type="list" count="{{ 3 }}" />
    <cy-inline-error wx:elif="{{ layers.clubHome.state === 'error' }}" kind="data" title="俱乐部主页没读到" action="重试" data-act="reloadClubHome" bind:action="emit" />
    <block wx:else>
      <image class="lv-cover" wx:if="{{ layers.clubHome.cover }}" src="{{ layers.clubHome.cover }}" mode="aspectFill" />
      <view class="lv-id">
        <image class="dr-avatar dr-avatar--round lv-logo" wx:if="{{ layers.clubHome.logo }}" src="{{ layers.clubHome.logo }}" mode="aspectFill" />
        <view class="dr-avatar dr-avatar--round dr-avatar--fallback lv-logo" wx:else>{{ layers.clubHome.initial }}</view>
        <view class="lv-to-t"><text class="lv-home-n">{{ layers.clubHome.name }}</text><text class="lv-to-s" wx:if="{{ layers.clubHome.meta }}">{{ layers.clubHome.meta }}</text></view>
      </view>
      <view class="lv-stats">
        <view class="lv-stat" wx:for="{{ layers.clubHome.stats }}" wx:key="label"><text class="lv-stat-n">{{ item.value }}</text><text class="lv-stat-l">{{ item.label }}</text></view>
      </view>
      <view class="lv-tags" wx:if="{{ layers.clubHome.tags.length || layers.clubHome.areas.length }}">
        <text class="lv-tag" wx:for="{{ layers.clubHome.tags }}" wx:key="*this">{{ item }}</text>
        <text class="lv-tag lv-tag--area" wx:for="{{ layers.clubHome.areas }}" wx:key="*this">{{ item }}</text>
      </view>
      <text class="lv-bio" wx:if="{{ layers.clubHome.bio }}">{{ layers.clubHome.bio }}</text>
      <block wx:if="{{ layers.clubHome.acts.length }}">
        <view class="dg-label">最近带过的活动</view>
        <scroll-view class="lv-acts" scroll-x enhanced show-scrollbar="{{ false }}">
          <view class="lv-act" wx:for="{{ layers.clubHome.acts }}" wx:key="id">
            <image class="lv-act-img" wx:if="{{ item.img }}" src="{{ item.img }}" mode="aspectFill" />
            <view class="lv-act-img lv-act-img--none" wx:else></view>
            <text class="lv-act-t ep1">{{ item.name }}</text>
          </view>
        </scroll-view>
      </block>
      <block wx:if="{{ layers.clubHome.post }}">
        <view class="dg-label">最近动态</view>
        <view class="dcard lv-post"><text class="lv-post-t">{{ layers.clubHome.post.text }}</text><text class="lv-post-m">{{ layers.clubHome.post.time }}</text></view>
      </block>
      <block wx:if="{{ layers.clubHome.members.length }}">
        <view class="dg-label">成员</view>
        <view class="lv-members">
          <block wx:for="{{ layers.clubHome.members }}" wx:key="id">
            <image class="dr-avatar dr-avatar--round" wx:if="{{ item.avatar }}" src="{{ item.avatar }}" mode="aspectFill" />
            <view class="dr-avatar dr-avatar--round dr-avatar--fallback" wx:else>{{ item.initial }}</view>
          </block>
          <text class="lv-members-more" wx:if="{{ layers.clubHome.moreMembers }}">+{{ layers.clubHome.moreMembers }}</text>
        </view>
      </block>
    </block>
    <view slot="foot" wx:if="{{ layers.clubHome.canInvite }}" class="lv-send" catchtap="emit" data-act="inviteFromClubHome" aria-role="button" aria-label="邀约这个俱乐部" hover-class="cy-pressed" hover-stay-time="80">邀约</view>
  </project-layer>

  <!-- 这一站的档位:商家主办两档(权益 / 引流);俱乐部自己发的自由探索多一档计酬(俱乐部直付商家) -->
  <project-layer show="{{ layers.tier.show }}" depth="{{ 2 }}" title="这一站的档位" data-act="closeLayer" data-layer="tier" bind:back="emit">
    <view class="lv-st">「{{ layers.tier.name }}」这一站</view>
    <view class="lv-tiers">
      <view class="lv-tier {{ layers.tier.mode === item.key ? 'is-on' : '' }}" wx:for="{{ layers.tier.options }}" wx:key="key"
            catchtap="emit" data-act="setTierMode" data-mode="{{ item.key }}" aria-role="button" aria-label="{{ item.label }}" hover-class="cy-pressed" hover-stay-time="80">
        <view class="lv-tier-h"><text>{{ item.label }}</text>
          <view class="lv-tier-v" wx:if="{{ item.field && layers.tier.mode === item.key }}"><text>{{ item.fieldLabel }} ¥</text>
            <input class="lv-tier-in" type="digit" value="{{ item.field === 'perkMinValue' ? layers.tier.perkMinValue : layers.tier.maxPerHeadFee }}" data-act="onTierField" data-field="{{ item.field }}" bindinput="emitInput" /></view>
        </view>
        <text class="lv-tier-d">{{ item.desc }}</text>
      </view>
    </view>
    <view class="dg-label">最多几家商家接</view>
    <view class="dcard lv-cnt">
      <text>商家数上限</text>
      <view class="lv-step">
        <view class="lv-step-b" catchtap="emit" data-act="stepTierMax" data-delta="{{ -1 }}" aria-role="button" aria-label="减少" hover-class="cy-pressed" hover-stay-time="80"><view class="lv-step-minus"></view></view>
        <text class="lv-step-v">{{ layers.tier.maxMerchant > 0 ? layers.tier.maxMerchant : '不限' }}</text>
        <view class="lv-step-b" catchtap="emit" data-act="stepTierMax" data-delta="{{ 1 }}" aria-role="button" aria-label="增加" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="32" /></view>
      </view>
    </view>
    <text class="lv-note" wx:if="{{ !layers.tier.club }}">计酬档要平台按核销付钱，商家发起的主题暂不开放。</text>
    <text class="lv-err" wx:if="{{ layers.tier.error }}">{{ layers.tier.error }}</text>
    <view slot="foot" class="lv-send {{ layers.tier.saving ? 'is-busy' : '' }}" catchtap="emit" data-act="saveTier" aria-role="button" aria-label="保存档位" hover-class="cy-pressed" hover-stay-time="80">{{ layers.tier.saving ? '正在保存…' : '保存' }}</view>
  </project-layer>

  <!-- 附近商家:为这一站找商家,可邀约的给「邀约承接」 -->
  <project-layer show="{{ layers.shops.show }}" depth="{{ 2 }}" under="{{ layers.shopInvite.show }}" title="附近商家" data-act="closeLayer" data-layer="shops" bind:back="emit">
    <view class="lv-st">为「{{ layers.shops.name }}」找商家</view>
    <cy-skeleton wx:if="{{ layers.shops.state === 'loading' }}" type="list" count="{{ 4 }}" />
    <cy-inline-error wx:elif="{{ layers.shops.state === 'error' }}" kind="data" title="附近商家没读到" action="重试" data-act="reloadShops" bind:action="emit" />
    <view class="dcard cs-list" wx:elif="{{ layers.shops.rows.length }}">
      <view class="dr" wx:for="{{ layers.shops.rows }}" wx:key="memberId">
        <image class="dr-avatar" wx:if="{{ item.logo }}" src="{{ item.logo }}" mode="aspectFill" />
        <view class="dr-avatar dr-avatar--fallback" wx:else>{{ item.initial }}</view>
        <view class="dr-text"><text class="dr-name ep1">{{ item.name }}</text><text class="dr-sub ep1" wx:if="{{ item.sub }}">{{ item.sub }}</text></view>
        <view class="cs-pill" catchtap="emit" data-act="openShopInvite" data-id="{{ item.memberId }}" aria-role="button" aria-label="邀约 {{ item.name }} 承接" hover-class="cy-pressed" hover-stay-time="80">邀约承接</view>
      </view>
    </view>
    <cy-empty wx:else size="sm" title="附近暂时没有可以邀约的商家" />
  </project-layer>

  <!-- 邀约承接:写的就是这一站的档与条件(只读);商家只能接受或拒绝,不能换档 -->
  <project-layer show="{{ layers.shopInvite.show }}" depth="{{ 3 }}" title="邀约承接" data-act="closeLayer" data-layer="shopInvite" bind:back="emit">
    <view class="lv-to">
      <image class="dr-avatar" wx:if="{{ layers.shopInvite.logo }}" src="{{ layers.shopInvite.logo }}" mode="aspectFill" />
      <view class="dr-avatar dr-avatar--fallback" wx:else>{{ layers.shopInvite.initial }}</view>
      <view class="lv-to-t"><text class="lv-to-n">{{ layers.shopInvite.name }}</text><text class="lv-to-s">{{ layers.shopInvite.station }}</text></view>
    </view>
    <view class="dg-label">这一站的合作方式</view>
    <view class="dcard lv-terms"><view class="lv-inv3"><text class="tchip tchip--{{ layers.shopInvite.tierKey }}">{{ layers.shopInvite.tierLabel }}</text><text>{{ layers.shopInvite.termsText }}</text></view></view>
    <text class="lv-err" wx:if="{{ layers.shopInvite.error }}">{{ layers.shopInvite.error }}</text>
    <view slot="foot" class="lv-send {{ layers.shopInvite.sending ? 'is-busy' : '' }}" catchtap="emit" data-act="sendShopInvite" aria-role="button" aria-label="发出邀约" hover-class="cy-pressed" hover-stay-time="80">{{ layers.shopInvite.sending ? '正在发出…' : '发出邀约' }}</view>
  </project-layer>
</view>
