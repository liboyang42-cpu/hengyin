/* isolated 组件内全局 .cy-pressed 进不来,必须本地定义一份。
   只减淡不位移:位移要配 .cy-motion-reduced 兜底,而那个类挂在组件外的祖先上。 */
.cy-pressed { opacity: .88; }

.nnf-subtitle {
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-type-body);
  line-height: 1.5;
  margin-bottom: var(--cy-space-4);
}

.nnf-loading {
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-type-caption);
  padding: var(--cy-space-4) 0;
}

.nnf-field {
  margin-bottom: var(--cy-space-4);
}

.nnf-label {
  display: flex;
  align-items: center;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-body);
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: var(--cy-space-2);
}

.nnf-required,
.nnf-optional {
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-type-caption);
  font-weight: 500;
  flex-shrink: 0;
  margin-left: var(--cy-space-1);
}

.nnf-input,
.nnf-textarea {
  background: var(--cy-color-bg-surface-subtle);
  border: 0;
  border-radius: var(--cy-radius-lg);
  box-sizing: border-box;
  color: var(--cy-color-input-text);
  font-size: var(--cy-type-card-title);
  min-height: calc(var(--cy-btn-h) + var(--cy-space-2));
  padding: 0 var(--cy-space-4);
  width: 100%;
}

.nnf-input {
  display: flex;
  align-items: center;
}

.nnf-textarea {
  height: 150rpx;
  padding: var(--cy-space-3) var(--cy-space-4);
  line-height: 1.5;
}

.nnf-placeholder {
  color: var(--cy-color-text-placeholder);
}

.nnf-avatars {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--cy-space-2);
}

.nnf-avatar {
  position: relative;
  box-sizing: border-box;
  background: var(--cy-color-bg-surface-subtle);
  border: 4rpx solid transparent;
  border-radius: var(--cy-radius-lg);
  aspect-ratio: 1;
  min-width: 0;
  overflow: hidden;
  padding: 4rpx;
  width: 100%;
}

.nnf-avatar.is-on {
  border-color: var(--cy-color-action-primary-bg);
}

.nnf-photo-row {
  align-items: center;
  display: flex;
  gap: var(--cy-space-2);
  margin-top: var(--cy-space-2);
}

.nnf-photo-preview {
  background: var(--cy-color-bg-surface-subtle);
  border-radius: var(--cy-radius-lg);
  height: 108rpx;
  overflow: hidden;
  width: 108rpx;
  flex-shrink: 0;
}

.nnf-voice-status {
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-type-caption);
  margin-bottom: var(--cy-space-2);
}

.nnf-voice-file {
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-type-caption);
  margin-bottom: var(--cy-space-2);
}

.nnf-actions {
  display: flex;
  gap: var(--cy-space-2);
  padding-top: var(--cy-space-2);
}

.nnf-action-button {
  flex: 1;
  min-width: 0;
}

/* 离屏工作画布:不参与布局,但必须真实渲染(display:none 拿不到 canvas 节点)。
   尺寸与门店形象页一致(384px=32×12)。 */
.nnf-work {
  position: fixed;
  left: -1000px;
  top: -1000px;
  width: 384px;
  height: 384px;
}

.nnf-required { color: var(--cy-color-status-danger); }
