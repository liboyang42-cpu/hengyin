<!-- 节点 NPC 长表单复用全屏面板，正文滚动，保存操作固定在底部。 -->
<cy-sheet show="{{show}}" variant="full" nav-title="节点NPC" footer="{{true}}" closable="{{!saving}}" maskClosable="{{!saving}}" bind:close="onSheetClose">
  <view class="nnf-subtitle">{{nodeName || '当前节点'}}</view>

  <view class="nnf-loading" wx:if="{{loading}}">正在读取…</view>
  <block wx:else>
    <view class="nnf-field">
      <view class="nnf-label">角色名字 <text class="nnf-required" aria-hidden="true">*</text></view>
      <input class="nnf-input" maxlength="32" value="{{form.name}}" disabled="{{saving}}"
        placeholder="玩家在节点里遇到的角色名" placeholder-class="nnf-placeholder"
        data-key="name" bindinput="onInput" />
    </view>

    <view class="nnf-field">
      <view class="nnf-label">形象 <text class="nnf-required" aria-hidden="true">*</text></view>
      <view class="nnf-avatars">
        <view class="nnf-avatar {{presetId === item && source === 'preset' ? 'is-on' : ''}}"
          wx:for="{{presetIds}}" wx:key="*this" data-id="{{item}}" bindtap="pickPreset"
          hover-class="cy-pressed" hover-stay-time="80"
          aria-role="button" aria-label="选择形象 {{item}}">
          <cy-npc-avatar src="{{'px1:' + item}}" />
        </view>
      </view>
      <view class="nnf-photo-row">
        <cy-btn variant="secondary" class="nnf-action-button" disabled="{{saving || processing}}"
          bindtap="choosePhoto">{{processing ? '处理中…' : (source === 'photo' ? '换一张照片' : '用照片生成')}}</cy-btn>
        <view class="nnf-photo-preview" wx:if="{{source === 'photo'}}">
          <cy-npc-avatar src="{{avatarPreview}}" />
        </view>
      </view>
    </view>

    <view class="nnf-field">
      <view class="nnf-label">台词 <text class="nnf-optional">选填</text></view>
      <textarea class="nnf-textarea" maxlength="255" value="{{form.greeting}}" disabled="{{saving}}"
        placeholder="玩家见到他时说的第一句话" placeholder-class="nnf-placeholder"
        data-key="greeting" bindinput="onInput" />
    </view>

    <view class="nnf-field">
      <view class="nnf-label">声音 <text class="nnf-optional">选填</text></view>
      <view class="nnf-voice-status">{{voiceStatusText}}</view>
      <cy-inline-error wx:if="{{voiceError}}" kind="error" title="声音暂未完成" sub="{{voiceError}}"
        action="{{voiceUnknown ? '查询原请求' : ''}}" bind:action="refreshVoice" />
      <view class="nnf-voice-file" wx:if="{{voiceFileText}}">{{voiceFileText}}</view>
      <view class="nnf-actions">
        <cy-btn variant="secondary" class="nnf-action-button" disabled="{{saving || voiceBusy || voiceUnknown || voiceStatus === 1}}"
          bindtap="chooseVoice">选择录音</cy-btn>
        <cy-btn variant="primary" class="nnf-action-button" disabled="{{!voiceFile || saving || voiceBusy || voiceUnknown || voiceStatus === 1}}"
          bindtap="uploadVoice">生成声音</cy-btn>
      </view>

      <view wx:if="{{voiceUnknown}}">
        <text>原结果未知，仍可能完成并占用额度。不会自动重发。</text>
        <cy-btn variant="secondary" bindtap="refreshVoice" disabled="{{voiceBusy}}">查询原请求</cy-btn>
        <cy-btn variant="secondary" bindtap="confirmNewVoiceRequest" disabled="{{voiceBusy}}">确认后另起独立请求</cy-btn>
      </view>
      <view wx:for="{{voiceHistory}}" wx:key="requestId">
        <text>原声音请求 · {{item.state}}</text>
        <cy-btn variant="ghost" data-request="{{item.requestId}}" bindtap="readVoiceHistory">查看原结果</cy-btn>
      </view>
      <text wx:if="{{voiceHistoryResult}}">{{voiceHistoryResult}}</text>
      <view class="nnf-actions" wx:if="{{voiceSample || voiceStatus === 3}}">
        <cy-btn variant="secondary" class="nnf-action-button" wx:if="{{voiceSample}}" bindtap="playVoice">{{voicePlaying ? '停止' : '试听'}}</cy-btn>
        <cy-btn variant="secondary" class="nnf-action-button" bindtap="resetVoice">清除重录</cy-btn>
      </view>
    </view>

  </block>

  <view class="nnf-actions" slot="footer" wx:if="{{!loading}}">
    <cy-btn variant="ghost" disabled="{{saving}}" bindtap="onSheetClose">取消</cy-btn>
    <cy-btn variant="primary" loading="{{saving}}" disabled="{{!form.name}}" bindtap="save">保存</cy-btn>
  </view>

  <!-- 端上像素化的离屏画布:不进布局,但必须真实渲染出来才拿得到节点 -->
  <canvas type="2d" id="nnf-work" class="nnf-work" />
</cy-sheet>

<!-- 结果面板放在 sheet 之后:同档 z-index 下后画的在上,与既有页面(coop/invite)同一做法 -->
<cy-result-sheet show="{{result.show}}" kind="{{result.kind}}" title="{{result.title}}" why="{{result.why}}"
  duration="{{result.duration}}" bind:close="onResultClose" />
