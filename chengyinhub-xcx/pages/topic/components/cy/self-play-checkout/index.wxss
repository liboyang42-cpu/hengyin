/* 从右侧推入的整屏层,版式与报名结算页一致(深色玩家域)。 */
.ck { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; z-index: calc(var(--cy-z-modal) - 1); /* 「还差姓名和手机号」弹窗要压在结算层上(实走 A3) */ background: var(--cy-bg-page);
  transform: translateX(100%); transition: transform .45s cubic-bezier(.2, .82, .2, 1); }
.ck.is-on { transform: none; }
.ck-pressed { opacity: .75; }
.ck__nav { position: absolute; left: 0; right: 0; top: 0; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 20rpx; box-sizing: border-box; background: var(--cy-bg-page); z-index: 2; }
.ck__back { position: absolute; left: var(--cy-page-x); bottom: 12rpx; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--cy-color-bg-surface); display: flex; align-items: center; justify-content: center; }
.ck__chev { width: 18rpx; height: 18rpx; border-left: 4rpx solid var(--cy-color-text-primary); border-bottom: 4rpx solid var(--cy-color-text-primary); transform: rotate(45deg); margin-left: 6rpx; }
.ck__title { font-size: var(--cy-font-title, 34rpx); font-weight: 600; color: var(--cy-color-text-primary); line-height: 72rpx; }
.ck__body { position: relative; flex: 1; min-height: 0; padding: 0 var(--cy-page-x); box-sizing: border-box; }
.ck__sec { display: block; margin: 36rpx 4rpx 16rpx; font-size: 28rpx; font-weight: 600; color: var(--cy-color-text-secondary); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__card { background: var(--cy-bg-card); border-radius: var(--cy-radius-xl); }
.ck__who { display: flex; align-items: center; justify-content: space-between; padding: 28rpx; }
.ck__who-main { display: flex; align-items: baseline; gap: 16rpx; }
.ck__who-n { font-size: 30rpx; color: var(--cy-color-text-primary); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__who-p, .ck__more { font-size: 26rpx; color: var(--cy-color-text-secondary); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__who-miss { font-size: 28rpx; color: var(--cy-color-status-warning); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__item { display: flex; gap: 24rpx; padding: 24rpx; align-items: center; }
.ck__cover { flex: none; width: 144rpx; height: 144rpx; border-radius: 24rpx; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__item-tx { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.ck__item-n { font-size: 32rpx; font-weight: 600; color: var(--cy-color-text-primary); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__item-s { font-size: 24rpx; color: var(--cy-color-text-secondary); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__row { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 28rpx; border-top: 1rpx solid var(--cy-color-border-subtle); }
.ck__row:first-child { border-top: 0; }
.ck__k { font-size: 28rpx; color: var(--cy-color-text-secondary); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__v { font-size: 28rpx; color: var(--cy-color-text-primary); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__k--sum { color: var(--cy-color-text-primary); font-weight: 600; }
.ck__v--sum { font-size: 34rpx; font-weight: 700; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__consent { width: 100%; }
.ck__hint { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--cy-color-status-warning); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__err { display: flex; gap: 16rpx; margin-top: 12rpx; font-size: 24rpx; color: var(--cy-color-status-danger); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__err-act { text-decoration: underline; }
.ck__bar { flex: none; display: flex; flex-direction: column; gap: 16rpx; padding: 24rpx var(--cy-page-x) calc(24rpx + env(safe-area-inset-bottom));
  background: var(--cy-bg-page); border-top: 1rpx solid var(--cy-color-border-subtle); }
.ck__pay-row { display: flex; align-items: center; gap: 28rpx; }
.ck__sum { display: flex; flex-direction: column; }
.ck__sum-k { font-size: 22rpx; color: var(--cy-color-text-secondary); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__sum-v { font-size: 44rpx; font-weight: 800; color: var(--cy-color-text-primary); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__pay { margin-left: auto; height: var(--cy-btn-h); padding: 0 64rpx; border-radius: var(--cy-radius-pill, 999rpx); display: flex; align-items: center; /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); font-size: 30rpx; font-weight: 700; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__pay.is-busy { opacity: .6; }
/* v13 原型对齐:深灰卡 16px 圆角;主题信息「时间 / 地点」小字在上、值在下;合计斜体粗数字 */
/* ds-ok: 本段颜色照 v13 原型取值 */
.ck { background: #000; } /* ds-ok */
.ck__nav { background: #000; } /* ds-ok */
.ck__back { background: rgba(28,28,30,.72); } /* ds-ok */
.ck__sec { margin: 35rpx 4rpx 15rpx; font-size: 27rpx; color: #ddd; } /* ds-ok */
.ck__card { background: #1C1C1E; border-radius: 31rpx; } /* ds-ok */
.ck__item { gap: 23rpx; padding: 23rpx; }
.ck__cover { width: 138rpx; height: 138rpx; border-radius: 23rpx; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__item-tx { gap: 2rpx; }
.ck__item-n { font-size: 31rpx; margin-bottom: 4rpx; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__item-s { font-size: 23rpx; color: #8E8E93; } /* ds-ok */
.ck__item-v { font-size: 29rpx; font-weight: 500; color: #fff; margin-bottom: 4rpx; } /* ds-ok */
.ck__row { padding: 27rpx; border-top-color: rgba(255,255,255,.08); } /* ds-ok */
.ck__v { font-weight: 500; }
.ck__v--sum, .ck__sum-v { font-style: italic; font-weight: 800; }
.ck__sum-v { font-size: 50rpx; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.ck__bar { background: #000; border-top-color: rgba(255,255,255,.08); } /* ds-ok */
.ck__pay { height: 96rpx; padding: 0 58rpx; background: #fff; color: #000; font-size: 31rpx; font-weight: 600; } /* ds-ok */

.ck__back::after { content: ""; position: absolute; left: 50%; top: 50%; width: 88rpx; height: 88rpx; transform: translate(-50%, -50%); } /* 透明热区撑到 44px,视觉尺寸按原型不变 */

/* r2-store 2026-11-10 STRUCTURE §1:主题头 → 可选卡 → 通票行 → 明细 → 信任行;颜色全走 --cy-* 令牌 */
.ck__head { padding-top: var(--cy-space-4, 24rpx); }
.ck__hero { display: block; width: 100%; height: 280rpx; border-radius: var(--cy-radius-xl); background: var(--cy-color-bg-surface); }
.ck__name { display: block; margin-top: var(--cy-space-4, 24rpx); font-size: var(--cy-font-title, 40rpx); font-weight: 700; color: var(--cy-color-text-primary); line-height: 1.3; }
.ck__pills { display: flex; flex-wrap: wrap; gap: var(--cy-space-2, 12rpx); margin-top: var(--cy-space-3, 16rpx); }
.ck__pill { padding: 6rpx 18rpx; border-radius: var(--cy-radius-pill); background: var(--cy-color-bg-surface); color: var(--cy-color-text-secondary); font-size: var(--cy-font-caption); }
.ck__opt { position: relative; margin-top: var(--cy-space-4, 24rpx); padding: 28rpx; border-radius: var(--cy-radius-xl); background: var(--cy-bg-card); border: 3rpx solid transparent; }
.ck__opt.is-sel { border-color: var(--cy-color-text-primary); }
.ck__opt-top { display: flex; align-items: center; gap: var(--cy-space-3, 16rpx); min-height: 48rpx; }
.ck__dot { flex: none; width: 36rpx; height: 36rpx; border-radius: 50%; border: 3rpx solid var(--cy-color-border-strong); box-sizing: border-box; }
.ck__dot.is-on { border: 11rpx solid var(--cy-color-text-primary); }
.ck__opt-t { flex: 1; min-width: 0; font-size: var(--cy-font-body, 30rpx); font-weight: 600; color: var(--cy-color-text-primary); }
.ck__opt-p { display: flex; align-items: baseline; gap: var(--cy-space-2, 12rpx); }
.ck__price { font-size: 36rpx; font-weight: 800; color: var(--cy-color-text-primary); } /* ds-ok: 与底栏合计同一档数字 */
.ck__price.is-dim { opacity: .5; }
.ck__strike { font-size: var(--cy-font-caption, 24rpx); color: var(--cy-color-text-secondary); text-decoration: line-through; }
.ck__opt-l { display: block; margin: 10rpx 0 0 52rpx; font-size: var(--cy-font-caption, 24rpx); color: var(--cy-color-text-secondary); }
/* 通票行做成票根:左右两个半圆缺口,颜色取页面底色 */
.ck__ticket::before, .ck__ticket::after { content: ""; position: absolute; top: 50%; width: 28rpx; height: 28rpx; margin-top: -14rpx; border-radius: 50%; background: var(--cy-bg-page); }
.ck__ticket::before { left: -14rpx; }
.ck__ticket::after { right: -14rpx; }
.ck__who { margin-top: var(--cy-space-5, 32rpx); gap: var(--cy-space-3, 16rpx); }
.ck__who .ck__k { flex: none; }
.ck__who-main, .ck__who-miss { flex: 1; min-width: 0; text-align: right; justify-content: flex-end; }
.ck__rows { margin-top: var(--cy-space-4, 24rpx); }
.ck__v.is-minus { color: var(--cy-color-status-success); }
.ck__refused { margin-top: var(--cy-space-4, 24rpx); font-size: var(--cy-font-caption, 24rpx); color: var(--cy-color-status-danger); text-align: center; }
.ck__trust { display: flex; justify-content: space-around; gap: var(--cy-space-2, 12rpx); margin-top: var(--cy-space-5, 32rpx); padding: 0 var(--cy-space-2, 12rpx); }
.ck__trust-i { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10rpx; font-size: var(--cy-font-caption, 24rpx); color: var(--cy-color-text-secondary); text-align: center; }
.ck__pay.is-off { opacity: .4; }
.ck__member { display: flex; align-items: center; gap: 20rpx; margin: 0 0 var(--cy-space-3); padding: 24rpx 28rpx; border-radius: var(--cy-radius-lg); background: var(--cy-color-status-success-soft); color: var(--cy-color-status-success); font-size: var(--cy-font-body); font-weight: 600; }

/* 细节打磨二期 L1/L5/L7 */
.ck__price { font-variant-numeric: tabular-nums; }
.ck__card { box-shadow: var(--cy-depth-rest); }
