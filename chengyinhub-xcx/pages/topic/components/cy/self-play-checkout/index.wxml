<view class="ck {{show ? 'is-on' : ''}}" aria-hidden="{{!show}}">
  <view class="ck__nav" style="height: {{topInset}}px;">
    <view class="ck__back" bindtap="onBack" aria-role="button" aria-label="返回" hover-class="ck-pressed" hover-stay-time="80"><view class="ck__chev"></view></view>
    <text class="ck__title">确认订单</text>
  </view>
  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="ck__body" style="top: {{topInset}}px;">
    <!-- 1 主题头 -->
    <view class="ck__head">
      <image wx:if="{{cover}}" class="ck__hero" src="{{cover}}" mode="aspectFill" />
      <text class="ck__name">{{name}}</text>
      <view class="ck__pills" wx:if="{{view.pills.length || placeText}}">
        <text class="ck__pill" wx:for="{{view.pills}}" wx:key="*this">{{item}}</text>
        <text class="ck__pill" wx:if="{{placeText}}">{{placeText}}</text>
      </view>
    </view>

    <!-- l-pass:通行证覆盖本主题(服务端 platformPassCovered)时本单 ¥0 -->
    <view class="ck__member" wx:if="{{view.member}}" aria-role="status"><text>你的通行证覆盖这个主题 · 本单 ¥0</text></view>

    <!-- 2 单次购买(默认选中) -->
    <view class="ck__opt is-sel" aria-role="radio" aria-checked="true" aria-label="{{view.single.title}} {{view.single.price}}">
      <view class="ck__opt-top">
        <view class="ck__dot is-on"></view>
        <text class="ck__opt-t">{{view.single.title}}</text>
        <view class="ck__opt-p">
          <text class="ck__strike" wx:if="{{view.single.strike}}">{{view.single.strike}}</text>
          <text class="ck__price {{view.loading ? 'is-dim' : ''}}">{{view.single.price}}</text>
        </view>
      </view>
      <text class="ck__opt-l" wx:if="{{view.single.line}}">{{view.single.line}}</text>
    </view>

    <!-- 3 城市通票:只列覆盖本主题的在售商品,点进原通行证详情页 -->
    <view wx:for="{{view.passes}}" wx:key="id" class="ck__opt ck__ticket" bindtap="onPass" data-id="{{item.id}}"
          aria-role="button" aria-label="{{item.name}} {{item.price}}" hover-class="ck-pressed" hover-stay-time="80">
      <view class="ck__opt-top">
        <view class="ck__dot"></view>
        <text class="ck__opt-t">{{item.name}}</text>
        <view class="ck__opt-p"><text class="ck__price">{{item.price}}</text><cy-icon class="ck__more" name="chevron-right" size="28" /></view>
      </view>
      <text class="ck__opt-l" wx:if="{{item.meta}}">{{item.meta}}</text>
    </view>

    <!-- 参与人(建单必填) -->
    <view class="ck__card ck__who" bindtap="onProfile" aria-role="button" aria-label="修改参与人信息" hover-class="ck-pressed" hover-stay-time="80">
      <text class="ck__k">参与人</text>
      <view wx:if="{{profileName}}" class="ck__who-main"><text class="ck__who-n">{{profileName}}</text><text class="ck__who-p">{{profilePhone}}</text></view>
      <text wx:else class="ck__who-miss">补全姓名和手机号</text>
      <cy-icon class="ck__more" name="chevron-right" size="28" />
    </view>

    <!-- 7 明细 -->
    <view class="ck__card ck__rows" wx:if="{{view.bill.length}}">
      <view class="ck__row" wx:for="{{view.bill}}" wx:key="key"><text class="ck__k">{{item.k}}</text><text class="ck__v {{item.minus ? 'is-minus' : ''}}">{{item.v}}</text></view>
      <view class="ck__row ck__row--sum"><text class="ck__k ck__k--sum">合计</text><text class="ck__v ck__v--sum">{{view.totalText}}</text></view>
    </view>
    <view class="ck__refused" wx:if="{{view.refused}}" aria-role="alert">{{view.refusal}}</view>

    <!-- 8 信任行:只放服务端/建单口径能保证的事实 -->
    <view class="ck__trust" wx:if="{{view.trust.length}}">
      <view class="ck__trust-i" wx:for="{{view.trust}}" wx:key="key"><cy-icon name="{{item.icon}}" size="36" /><text>{{item.label}}</text></view>
    </view>

    <!-- 10 单独同意(个保法第 23 条,建单必需) -->
    <view class="ck__consent">
      <cy-consent-check checked="{{consentChecked}}" text="同意将姓名、手机号提供给主办方，用于报名核验" bind:change="onConsent" />
      <text class="ck__hint" wx:if="{{consentHint}}">{{consentHint}}</text>
      <view class="ck__err" wx:if="{{consentError}}" aria-role="alert">
        <text>{{consentError}}</text>
        <text class="ck__err-act" bindtap="onPay" aria-role="button" aria-label="重试" hover-class="ck-pressed" hover-stay-time="80">重试</text>
      </view>
    </view>
    <view class="ck__pad"></view>
  </scroll-view>
  <!-- 11 底栏:合计 + 支付,随报价实时更新 -->
  <view class="ck__bar">
    <view class="ck__sum"><text class="ck__sum-v">{{view.totalText}}</text><text class="ck__sum-k">1 人</text></view>
    <view class="ck__pay {{loading || view.loading ? 'is-busy' : ''}} {{view.refused ? 'is-off' : ''}}" bindtap="onPay" aria-role="button" aria-disabled="{{view.refused}}" aria-label="{{view.payLabel}}" hover-class="ck-pressed" hover-stay-time="80">{{loading ? '处理中…' : view.payLabel}}</view>
  </view>
</view>
