/* 整屏层:模糊的是**下面的页面**(backdrop-filter),不是另画的色块。 */
.pr { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 960; background: transparent; overflow: hidden; color: var(--cy-color-text-primary); }
.pr-pressed { opacity: .8; }
.pr__blur { position: absolute; top: 0; right: 0; bottom: 0; left: 0; opacity: 0; transition: opacity .42s ease-out;
  backdrop-filter: blur(52rpx) saturate(1.6) brightness(1.06); -webkit-backdrop-filter: blur(52rpx) saturate(1.6) brightness(1.06); }
.pr.blur .pr__blur { opacity: 1; }
.pr__black { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: #000; opacity: 0; transition: opacity 1.4s ease .5s; } /* ds-ok 落定后回到纯黑 */
.pr.dark .pr__black { opacity: 1; }

/* 边缘光:四根琥珀光条 + 两个亮点(白、洋红)沿边顺时针跑一圈 4s */
.pr__edge { position: absolute; top: 0; right: 0; bottom: 0; left: 0; opacity: 0; transition: opacity .6s ease; pointer-events: none; }
.pr.edge .pr__edge { opacity: 1; }
.pr.dark .pr__edge { opacity: 0; transition: opacity 1.4s ease .5s; }
.pr__bar { position: absolute; overflow: hidden; }
.pr__bar--t { left: 0; right: 0; top: 0; height: 56rpx; background: linear-gradient(180deg, rgba(244, 164, 40, .95), rgba(244, 164, 40, 0)); } /* ds-ok 琥珀边光 */
.pr__bar--b { left: 0; right: 0; bottom: 0; height: 56rpx; background: linear-gradient(0deg, rgba(244, 164, 40, .95), rgba(244, 164, 40, 0)); } /* ds-ok */
.pr__bar--l { left: 0; top: 0; bottom: 0; width: 48rpx; background: linear-gradient(90deg, rgba(244, 164, 40, .95), rgba(244, 164, 40, 0)); } /* ds-ok */
.pr__bar--r { right: 0; top: 0; bottom: 0; width: 48rpx; background: linear-gradient(270deg, rgba(244, 164, 40, .95), rgba(244, 164, 40, 0)); } /* ds-ok */
.pr__bar::before, .pr__bar::after { content: ''; position: absolute; border-radius: 50%; opacity: 0; filter: blur(16rpx); }
.pr__bar::before { background: rgba(255, 255, 255, .95); } /* ds-ok 白亮点 */
.pr__bar::after { background: rgba(255, 79, 216, .9); } /* ds-ok 洋红亮点 */
.pr__bar--t::before, .pr__bar--t::after, .pr__bar--b::before, .pr__bar--b::after { top: -20rpx; width: 220rpx; height: 90rpx; }
.pr__bar--l::before, .pr__bar--l::after, .pr__bar--r::before, .pr__bar--r::after { left: -20rpx; width: 90rpx; height: 220rpx; }
.pr__bar--t::before { animation: pr-run-t 4s linear infinite; }
.pr__bar--r::before { animation: pr-run-r 4s linear 1s infinite; }
.pr__bar--b::before { animation: pr-run-b 4s linear 2s infinite; }
.pr__bar--l::before { animation: pr-run-l 4s linear 3s infinite; }
.pr__bar--t::after { animation: pr-run-t 4s linear 2s infinite; }
.pr__bar--r::after { animation: pr-run-r 4s linear 3s infinite; }
.pr__bar--b::after { animation: pr-run-b 4s linear 4s infinite; }
.pr__bar--l::after { animation: pr-run-l 4s linear 5s infinite; }
@keyframes pr-run-t { 0% { left: -30%; opacity: 0; } 3% { opacity: 1; } 24% { left: 100%; opacity: 1; } 25%, 100% { left: 100%; opacity: 0; } }
@keyframes pr-run-r { 0% { top: -20%; opacity: 0; } 3% { opacity: 1; } 24% { top: 100%; opacity: 1; } 25%, 100% { top: 100%; opacity: 0; } }
@keyframes pr-run-b { 0% { left: 100%; opacity: 0; } 3% { opacity: 1; } 24% { left: -30%; opacity: 1; } 25%, 100% { left: -30%; opacity: 0; } }
@keyframes pr-run-l { 0% { top: 100%; opacity: 0; } 3% { opacity: 1; } 24% { top: -20%; opacity: 1; } 25%, 100% { top: -20%; opacity: 0; } }
.pr__spk { position: absolute; width: 6rpx; height: 6rpx; border-radius: 50%; background: #fff; opacity: 0; animation: pr-spk 2.4s ease-in-out infinite; } /* ds-ok 闪点 */
.pr__spk--1 { right: 40rpx; top: 32%; animation-delay: .3s; }
.pr__spk--2 { right: 56rpx; top: 52%; animation-delay: 1.1s; background: #ffd9a0; } /* ds-ok */
.pr__spk--3 { left: 44rpx; top: 64%; animation-delay: .7s; background: #ffc2f2; } /* ds-ok */
.pr__spk--4 { right: 80rpx; bottom: 14%; animation-delay: 1.7s; }
@keyframes pr-spk { 0%, 100% { opacity: 0; transform: translateY(0); } 50% { opacity: .95; transform: translateY(-20rpx); } }

/* 左上标题:逐字由糊变清 */
.pr__head { position: absolute; left: 48rpx; right: 48rpx; top: 200rpx; z-index: 3; }
.pr__title { font-size: 60rpx; font-weight: 700; line-height: 1.2; min-height: 72rpx; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.pr__sub { margin-top: 16rpx; font-size: 28rpx; color: rgba(255, 255, 255, .75); min-height: 36rpx; } /* ds-ok 黑底次文 */
.pr__ch { display: inline-block; opacity: 0; filter: blur(20rpx); transform: translateY(20rpx) scale(1.15); animation: pr-ch .7s cubic-bezier(.2, .8, .2, 1) forwards; }
@keyframes pr-ch { to { opacity: 1; filter: blur(0); transform: none; } }

/* 底部升起的紫光 → 中央白色光球 */
.pr__rise { position: absolute; left: 50%; bottom: 60rpx; width: 340rpx; height: 340rpx; margin-left: -170rpx; border-radius: 50%; opacity: 0; z-index: 2;
  transform: translateY(0) scale(.6, .5); transition: opacity 1.6s cubic-bezier(.3, .6, .3, 1) .3s, transform 1.6s cubic-bezier(.3, .6, .3, 1) .3s;
  background: radial-gradient(circle, #f1c6ff 0%, #a64dff 42%, rgba(140, 40, 255, 0) 70%); filter: blur(32rpx); } /* ds-ok 升起的光 */
.pr.edge .pr__rise { opacity: .9; transform: translateY(-300rpx) scale(.9, 1.5); }
.pr.orb .pr__rise, .pr.card .pr__rise { opacity: 0; transform: translateY(-460rpx) scale(.5, .8); transition-duration: .5s; transition-delay: 0s; }
.pr__orb { position: absolute; left: 50%; top: 46%; width: 660rpx; height: 660rpx; margin: -330rpx 0 0 -330rpx; border-radius: 50%; opacity: 0; z-index: 2;
  background: radial-gradient(circle, #fff 0%, rgba(255, 255, 255, .9) 14%, rgba(255, 255, 255, .35) 34%, rgba(255, 255, 255, 0) 62%); } /* ds-ok 光球 */
.pr.orb .pr__orb { animation: pr-orb-in .62s cubic-bezier(.2, .8, .2, 1) forwards, pr-breathe 1.1s ease-in-out .62s infinite alternate; }
.pr.card .pr__orb { animation: pr-orb-out .52s cubic-bezier(.2, .8, .2, 1) forwards; }
@keyframes pr-orb-in { from { opacity: 0; transform: scale(.35); } to { opacity: 1; transform: scale(1); } }
@keyframes pr-breathe { to { transform: scale(1.12); } }
@keyframes pr-orb-out { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(1.9); } }
.pr__fx { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 5; pointer-events: none; }

/* 通行证:圆角平滑、照片 + 镭射彩光;背面黑色金属 + logo。边光颜色随升级变化。 */
.pr__card { position: absolute; left: 50%; top: 46%; width: 448rpx; height: 660rpx; margin: -330rpx 0 0 -224rpx; z-index: 4; perspective: 2400rpx; opacity: 0;
  transform: scale(.2); filter: blur(36rpx); transition: opacity .62s cubic-bezier(.2, .85, .25, 1.05), transform .62s cubic-bezier(.2, .85, .25, 1.05), filter .62s ease; }
.pr.card .pr__card { opacity: 1; transform: none; filter: blur(0); }
.pr__in { position: absolute; top: 0; right: 0; bottom: 0; left: 0; transform-style: preserve-3d; }
.pr.spin .pr__in { animation: pr-spin 2.4s cubic-bezier(.12, .7, .25, 1) both; }
@keyframes pr-spin { 0% { transform: translateY(340rpx) scale(.55) rotateY(-40deg) rotateX(10deg); }
  40% { transform: translateY(0) scale(1) rotateY(360deg) rotateX(-6deg); } 100% { transform: rotateY(720deg) rotateX(0); } }
.pr__card.is-fly { animation: pr-fly .98s cubic-bezier(.45, 0, .25, 1) forwards !important; }
@keyframes pr-fly { 0% { transform: none; opacity: 1; } 38% { transform: scale(1.38); opacity: 1; } 100% { transform: translate(120rpx, -1600rpx) rotate(16deg) scale(.55); opacity: .2; } }
.pr__f, .pr__b { position: absolute; top: 0; right: 0; bottom: 0; left: 0; border-radius: 48rpx; overflow: hidden; /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  backface-visibility: hidden; -webkit-backface-visibility: hidden; transition: box-shadow .3s; }
.pr__f { background: #141518; box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, .2), 0 0 60rpx var(--pr-tier); } /* ds-ok 卡底 */
.pr__img { position: absolute; left: 0; right: 0; top: 0; width: 100%; height: 58%; }
.pr__mk { position: absolute; right: 28rpx; top: 28rpx; width: 52rpx; height: 52rpx; opacity: .9; }
.pr__t { position: absolute; left: 32rpx; right: 32rpx; top: 356rpx; display: flex; flex-direction: column; gap: 8rpx; }
.pr__kind { font-size: 20rpx; letter-spacing: 2rpx; color: rgba(255, 255, 255, .6); } /* ds-ok 卡上次文 */
.pr__name { font-size: 42rpx; font-weight: 700; line-height: 1.2; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.pr__row { position: absolute; left: 32rpx; right: 32rpx; bottom: 36rpx; display: flex; gap: 12rpx; padding-top: 24rpx; border-top: 2rpx solid rgba(255, 255, 255, .14); } /* ds-ok */
.pr__cell { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
/* 票种名最长(如「自玩通行证」),等分时最后一个字被挤到第二行(实走复核 A6):最后一格多给宽度,仍过长才省略 */
.pr__cell:last-child { flex: 1.5; }
.pr__cell:last-child .pr__v { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pr__k { font-size: 20rpx; color: rgba(255, 255, 255, .55); } /* ds-ok */
.pr__v { font-size: 28rpx; font-weight: 600; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
/* 镭射:彩虹带 color-dodge 叠在照片和卡底上,持续扫动 */
.pr__holo { position: absolute; top: 0; right: 0; bottom: 0; left: 0; mix-blend-mode: color-dodge; opacity: .62; pointer-events: none;
  background: repeating-linear-gradient(115deg, rgba(255, 0, 132, 0) 0%, rgba(255, 0, 132, .38) 7%, rgba(255, 214, 0, .36) 14%, rgba(0, 255, 163, .36) 21%, rgba(0, 168, 255, .38) 28%, rgba(173, 0, 255, 0) 35%); /* ds-ok 镭射材质 */
  background-size: 240% 240%; animation: pr-holo 3.2s ease-in-out infinite alternate; }
@keyframes pr-holo { from { background-position: 0% 0%; } to { background-position: 100% 100%; } }
.pr__b { transform: rotateY(180deg); box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .22), inset 0 0 0 9rpx var(--pr-tier), 0 0 60rpx var(--pr-tier); } /* ds-ok */
.pr__metal { position: absolute; top: 0; right: 0; bottom: 0; left: 0;
  background: radial-gradient(120% 70% at 18% 0%, rgba(255, 255, 255, .2), rgba(255, 255, 255, 0) 46%), /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
    conic-gradient(from 0deg at 50% 55%, #141518, #5e626a, #1a1b1f, #a7abb3, #202227, #6b6f77, #121316, #8e939b, #141518), /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
    repeating-linear-gradient(90deg, rgba(255, 255, 255, .05) 0 2rpx, rgba(0, 0, 0, .08) 2rpx 4rpx); /* ds-ok 黑色金属材质 */
  background-blend-mode: screen, normal, overlay; }
.pr__metal::after { content: ''; position: absolute; top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(115deg, rgba(255, 255, 255, 0) 38%, rgba(255, 255, 255, .22) 50%, rgba(255, 255, 255, 0) 62%); /* ds-ok 金属高光 */
  background-size: 260% 100%; animation: pr-metal 2.6s ease-in-out infinite; }
@keyframes pr-metal { 0% { background-position: 130% 0; } 60%, 100% { background-position: -40% 0; } }
.pr__logo { position: absolute; left: 50%; top: 50%; width: 180rpx; height: 180rpx; margin: -130rpx 0 0 -90rpx; filter: grayscale(1) brightness(1.6); opacity: .9; }
.pr__brand { position: absolute; left: 0; right: 0; top: calc(50% + 80rpx); text-align: center; font-size: 22rpx; letter-spacing: 12rpx; color: #b9bec7; font-weight: 700; } /* ds-ok 金属刻字 */

.pr__btns { position: absolute; left: 40rpx; right: 40rpx; bottom: calc(60rpx + env(safe-area-inset-bottom)); z-index: 6; display: flex; gap: 20rpx;
  opacity: 0; transform: translateY(40rpx); transition: opacity .5s, transform .5s cubic-bezier(.2, .82, .2, 1); pointer-events: none; }
.pr__btns.is-on { opacity: 1; transform: none; pointer-events: auto; }
.pr__btn { flex: 1; height: var(--cy-btn-h); border-radius: 999rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.pr__btn--s { background: var(--cy-color-bg-surface-strong); color: var(--cy-color-text-primary); }
.pr__btn--w { background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); }

/* 减少动态效果:不升光、不长卡、不旋转、不飞走,直接给落定终态(JS 侧同时跳过时间线) */
.pr--reduced .pr__spk, .pr--reduced .pr__rise, .pr--reduced .pr__orb { animation: none !important; opacity: 0; }
.pr--reduced .pr__card, .pr--reduced .pr__in { animation: none !important; opacity: 1; transition: none; transform: none; filter: none; }
.pr--reduced .pr__rise { transition: none; }
.pr--reduced .pr__ch { animation: none; opacity: 1; filter: none; transform: none; }
/* v13 原型对齐:卡 224×330、居中略偏上;正面不带外发光,照片占上 62% 渐隐到卡底 */
.pr__card { top: 50%; width: 431rpx; height: 635rpx; margin: -385rpx 0 0 -215rpx; }
.pr__f { box-shadow: inset 0 0 0 3rpx rgba(255,255,255,.18); border-radius: 46rpx; } /* ds-ok */
.pr__b { border-radius: 46rpx; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.pr__img { height: 62%; -webkit-mask: linear-gradient(180deg, #000 40%, transparent); mask: linear-gradient(180deg, #000 40%, transparent); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.pr__t { top: 292rpx; left: 31rpx; right: 31rpx; }
.pr__name { font-size: 40rpx; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.pr__row { left: 31rpx; right: 31rpx; bottom: 35rpx; padding-top: 23rpx; }
.pr__holo { opacity: .55; }
.pr__mk { filter: brightness(0) invert(1); opacity: .85; }
