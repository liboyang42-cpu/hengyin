.mc-row { white-space: nowrap; margin: 0 calc(-1 * var(--cy-page-x)); }
.mc-track { display: inline-flex; gap: 24rpx; padding: 8rpx var(--cy-page-x); }
/* 圆角卡 + 底部模糊层:模糊层自己也裁圆角,clip-path 兜住 backdrop-filter 漏出的直角(原型 v6 的坑) */
.mc { position: relative; flex: none; width: 460rpx; height: 628rpx; border-radius: 52rpx; overflow: hidden; /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  clip-path: inset(0 round 52rpx); background: var(--cy-color-bg-surface-strong); white-space: normal; }
.mc__img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.mc__gift { position: absolute; left: 24rpx; top: 24rpx; z-index: 2; font-size: 22rpx; font-weight: 700; color: var(--cy-color-text-primary); /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  padding: 10rpx 20rpx; border-radius: 24rpx; background: rgba(0, 0, 0, .45); backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx); } /* ds-ok 压图玻璃 */
.mc__blur { position: absolute; left: 0; right: 0; bottom: 0; height: 58%; border-radius: 0 0 52rpx 52rpx; /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  backdrop-filter: blur(32rpx); -webkit-backdrop-filter: blur(32rpx);
  -webkit-mask: linear-gradient(180deg, transparent 0%, #000 55%); mask: linear-gradient(180deg, transparent 0%, #000 55%); } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.mc__shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(28, 26, 24, .55) 62%, rgba(24, 22, 20, .92) 100%); } /* ds-ok 压图渐变 */
.mc__in { position: absolute; left: 32rpx; right: 28rpx; bottom: 28rpx; }
.mc__name { display: flex; align-items: center; gap: 12rpx; }
.mc__n { font-size: 40rpx; font-weight: 700; color: var(--cy-color-text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
/* 绿色认证角标:参与本主题的商家都已过审 */
.mc__ok { flex: none; width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--cy-color-status-success); position: relative; }
.mc__ok::after { content: ''; position: absolute; left: 10rpx; top: 9rpx; width: 13rpx; height: 7rpx;
  border-left: 4rpx solid var(--cy-color-text-primary); border-bottom: 4rpx solid var(--cy-color-text-primary); transform: rotate(-45deg); }
.mc__desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 12rpx 0 24rpx;
  font-size: 25rpx; line-height: 1.45; color: rgba(255, 255, 255, .72); } /* ds-ok 压图正文 */
.mc__row { display: flex; align-items: center; gap: 20rpx; }
.mc__place { flex: 1; min-width: 0; font-size: 24rpx; font-weight: 600; color: var(--cy-color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.mc__btn { flex: none; height: 80rpx; padding: 0 36rpx; border-radius: 40rpx; display: flex; align-items: center; /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  background: #121212; color: var(--cy-color-text-primary); font-size: 28rpx; font-weight: 600; } /* ds-ok 参考稿深色按钮 */
.mc-pressed { opacity: .8; }
