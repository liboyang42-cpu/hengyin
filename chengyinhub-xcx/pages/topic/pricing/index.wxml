<wxs src="../../../utils/wxs/money.wxs" module="money" />
<view class="pg theme-merchant {{reducedMotion ? 'cy-motion-reduced' : ''}}" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-nav-bar custom-back bind:back="goBack" />
  <cy-page-title title="确认终价" safe-top="{{false}}" />
  <scroll-view scroll-y class="pg-scroll" enhanced show-scrollbar="{{false}}">
    <cy-skeleton wx:if="{{loading && !hasPreview}}" type="card" count="{{2}}" />
    <cy-empty class="cy-fade-in" wx:elif="{{errorText === '缺少主题信息'}}" fill kind="missing-param" title="缺少主题信息"
              sub="请返回重新进入" cta="返回上一页" bind:cta="goBack" />
    <cy-error load-failure wx:elif="{{errorText && !hasPreview}}" fill title="定价信息加载失败" sub="{{errorText}}"
              retry="重试" bind:retry="preview" auto-back />
    <block wx:else>
      <cy-inline-error wx:if="{{errorText && hasPreview}}" title="最新定价暂未取回" sub="{{errorText}}" action="重试" bind:action="preview" />
      <view wx:if="{{loading && hasPreview}}" class="pg-refreshing" aria-role="status" aria-live="polite">正在确认最新定价…</view>
      <cy-tabs class="pg-tabs" variant="chip" tabs="{{typeTabs}}" active="{{subType}}" bind:change="chooseType" />

      <view class="pg-card cy-rise-in" wx:if="{{subType==='guided' && !priced}}">
        <view class="pg-title">带队成本</view>
        <!-- ⚠️ 原来只有 placeholder 当标签,一填值就消失(2026-08-19 E24 实拍:两个框只剩 200 / 10,
             分不清谁是成本谁是人数)。这两个数直接驱动下面的成本地板,是定价页的输入,
             必须有常驻标签。 -->
        <view class="pg-fields">
          <view class="pg-field">
            <text class="pg-field-label">本团带队总成本</text>
            <input class="pg-input" type="digit" value="{{leadCost}}" placeholder="0" bindinput="onCostInput" />
          </view>
          <view class="pg-field">
            <text class="pg-field-label">成团人数<text class="pg-req" aria-hidden="true">*</text></text>
            <input class="pg-input" type="number" value="{{teamSize}}" placeholder="0" bindinput="onTeamInput" />
            <!-- CU-C-70 + P-34(第四轮):成团人数空/0 时当场在这一栏下面用红字说清,不再是卡片底部的蓝色提示框。 -->
            <cy-inline-error class="pg-field-err" wx:if="{{teamSizeError}}" kind="error" title="{{teamSizeError}}" />
          </view>
        </view>
        <cy-btn variant="secondary" bindtap="recalculate">重新计算地板</cy-btn>
      </view>

      <view class="pg-card pg-floor cy-rise-in">
        <!-- CU-C-99:「乙-2」是内部条款编号,不该出现在给主理人看的标题里。 -->
        <text class="pg-kicker">最低价</text>
        <text class="pg-money">{{money.amount(floorText)}}</text>
        <text class="pg-note">终价不可低于此值</text>
      </view>

      <!-- 第四轮(业主:多票价):作者发了几张票时逐张确认终价,每张预填作者的价、各自对地板校验;一张票照旧用滑块。 -->
      <view class="pg-card cy-rise-in" wx:if="{{subType==='guided' && tickets.length > 1}}">
        <view class="pg-title">你的终价</view>
        <view class="pg-ticket" wx:for="{{tickets}}" wx:key="ticketId">
          <text class="pg-field-label">{{item.name || '票种 ' + (index + 1)}}<text class="pg-req" aria-hidden="true">*</text></text>
          <input class="pg-input" type="digit" value="{{item.price}}" placeholder="0" data-idx="{{index}}"
                 aria-label="{{item.name || '票种 ' + (index + 1)}}终价" bindinput="onTicketPriceInput" />
          <cy-inline-error class="pg-field-err" wx:if="{{item.error}}" kind="error" title="{{item.error}}" />
        </view>
        <view class="pg-reference"><text>{{referenceText}}</text></view>
      </view>

      <view class="pg-card cy-rise-in" wx:else>
        <view class="pg-price-row">
          <text class="pg-title">你的终价</text>
          <text class="pg-final">{{money.amount(finalPrice)}}</text>
        </view>
        <slider min="{{floor}}" max="{{sliderMax}}" value="{{finalPrice}}" step="1"
                activeColor="var(--cy-color-action-primary-bg)" backgroundColor="var(--cy-color-border-subtle)"
                block-size="24" bindchange="onSliderChange" />
        <view class="pg-range"><text>地板 {{money.amount(floorText)}}</text><text>{{money.amount(sliderMax)}}</text></view>
        <view class="pg-reference">
          <text>{{referenceText}}</text>
          <text wx:if="{{referenceDeltaText}}" class="pg-delta">{{referenceDeltaText}}</text>
        </view>
      </view>

      <view class="pg-card cy-rise-in" wx:if="{{lineup.length}}">
        <view class="pg-title">合作阵容</view>
        
        <view class="pg-lineup-row" wx:for="{{lineup}}" wx:key="lineupKey" data-idx="{{index}}"
              bindtap="goPartner" hover-class="cy-pressed" hover-stay-time="80"
              aria-role="button" aria-label="查看{{item.name || (item.toType==='club' ? '合作俱乐部' : '承接商家')}}的结算条款">
          <view class="pg-lineup-info">
            <text class="pg-lineup-name ep1">{{item.name || (item.toType==='club' ? '合作俱乐部' : '承接商家')}}</text>
            <text class="pg-lineup-terms">{{item.termsText}}</text>
          </view>
          <cy-icon name="arrow-right" size="24" class="pg-lineup-chevron" />
        </view>
      </view>

      
      <view class="pg-actions">
        <view class="pg-note" wx:if="{{priced}}">终价已确认</view>
        <view class="pg-note" wx:elif="{{phaseBlocked}}">合作阵容锁定后可定价</view>
        <cy-inline-error wx:if="{{submitError}}" kind="error" title="终价确认失败" sub="{{submitError}}" action="{{phaseBlocked ? '' : '重试'}}" bind:action="confirmPrice" />
        <!-- CU-C-100:按钮原来写「并开售」,而后端确认只推到 PRICING、开售要运营另行送审
             (回执是「终价已确认，请等待开售审核」)。照回执改口径,不承诺当场开卖。 -->
        <cy-btn variant="primary" loading="{{saving}}" disabled="{{!canConfirmPrice}}" bindtap="confirmPrice" bind:disabledtap="onConfirmDisabledTap">确认终价并提交开售审核</cy-btn>
      </view>
      <view class="pg-pad"></view>
    </block>
  </scroll-view>
</view>
