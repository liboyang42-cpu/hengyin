.hticket__b { display: block; margin-top: 12rpx; font-size: 33rpx; font-weight: 700; line-height: 1.25; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.hticket__p { position: absolute; left: 27rpx; bottom: 23rpx; font-size: 50rpx; font-weight: 800; font-style: italic; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.hticket__u { position: absolute; right: 27rpx; bottom: 31rpx; font-size: 19rpx; color: rgba(255,255,255,.55); } /* ds-ok */
.hticket__perf { position: absolute; left: 42%; top: 23rpx; bottom: 23rpx; z-index: 3; border-left: 4rpx dashed rgba(255,255,255,.25); } /* ds-ok */
.hticket__n { position: absolute; left: 42%; z-index: 3; width: 35rpx; height: 35rpx; margin-left: -17rpx; border-radius: 50%; background: #1C1C1E; } /* ds-ok */
.hticket__n--t { top: -17rpx; } .hticket__n--b { bottom: -17rpx; }
.hticket__holo { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 2; pointer-events: none; mix-blend-mode: color-dodge; opacity: .55; background-size: 280% 280%;
  background-image: repeating-linear-gradient(115deg, rgba(255,0,132,0) 0%, rgba(255,0,132,.38) 7%, rgba(255,214,0,.36) 14%, rgba(0,255,163,.36) 21%, rgba(0,168,255,.38) 28%, rgba(173,0,255,0) 35%); /* ds-ok v13 镭射 */
  animation: holo-pan 6s ease-in-out infinite alternate; }
