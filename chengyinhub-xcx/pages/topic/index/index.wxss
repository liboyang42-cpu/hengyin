.bsheet__x { position: absolute; right: 27rpx; top: 27rpx; width: 58rpx; height: 58rpx; border-radius: 50%; background: #2C2C2E; display: flex; align-items: center; justify-content: center; } /* ds-ok */
.bsheet__xi { position: relative; width: 23rpx; height: 23rpx; }
.bsheet__xi::before, .bsheet__xi::after { content: ''; position: absolute; left: 50%; top: 0; width: 5rpx; height: 100%; margin-left: -2rpx; border-radius: 2rpx; background: #fff; transform: rotate(45deg); } /* ds-ok */
.bsheet__xi::after { transform: rotate(-45deg); }
.bsheet__h { display: block; margin-top: 8rpx; font-size: 42rpx; font-weight: 700; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
