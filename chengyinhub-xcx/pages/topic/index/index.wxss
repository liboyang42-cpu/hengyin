/* cy-sheet 收编 voteShow(评价路线):保留 .pop pop-vote 内层类,全局 common.wxss 的 .pop-vote 后代尺寸
 * (textarea 260/缩略图 208/上传图标 104/3列网格)照常;页级降级 .pop-vote 自身 chrome + 去 .pop-cont 横向 padding(面板已 --cy-page-x) */
.pop-vote {
  position: static;
  width: auto;
  left: auto;
  bottom: auto;
  z-index: auto;
  background: transparent;
  box-shadow: none;
  border-radius: 0;
  padding-top: 0;
}
.pop-vote .pop-cont {
  padding-left: 0;
  padding-right: 0;
}
.pop-vote .vote-hint { margin: var(--cy-space-3) 0; color: var(--cy-text-body); font-size: var(--cy-font-body); line-height: var(--cy-leading-normal); }
.pop-vote .bm-btn { background: transparent; padding: var(--cy-space-4) 0 0; }
.pop-vote .vote-pic .li .item { position: relative; }
.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  color: var(--cy-color-text-inverse);
}
.delete-btn__glyph {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-comp-scrim);
}

/* ===== 主题音频讲解 =====
 * 原为 WXML 内联 style 整块字面值(底色/紫钮/白字/两档灰字/三档字号/圆角/半透明描边全是裸值)。
 * ds-hardcode-gate.sh 只 diff *.wxss(见该脚本 FILES= 那一行),WXML 内联样式是它的盲区,
 * 所以这块硬编码长期零告警 —— 现搬进 .wxss 并全部换 token,顺带把它挪进门禁能扫到的地方。 */
.topic-audio {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2-5);
  margin: var(--cy-space-2-5) 0;
  padding: var(--cy-space-3) var(--cy-space-3-5);
  background: var(--cy-color-bg-elevated);
  border: 1rpx solid var(--cy-color-border-subtle);
  border-radius: var(--cy-radius-md);
  min-height: 88rpx;
  box-sizing: border-box;
}

/* 播放/暂停键:品牌紫在此是「强调/进行中」语义,不是页面主 CTA(全局规范 §3.7 铁律 1) */
.topic-audio__btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--cy-space-6);
  height: var(--cy-space-6);
  border-radius: 50%;
  background: var(--cy-accent);
  color: var(--cy-text-inverse);
  font-size: var(--cy-font-body);
}
.topic-audio__pause { font-size: var(--cy-type-micro); font-weight: 700; }

.topic-audio__main { flex: 1; }

.topic-audio__title {
  font-size: var(--cy-font-body);
  color: var(--cy-text-title);
}

.topic-audio__meta {
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}

/* ── 探店日场次卡(det5 内,isExplore 时替代「阵容」花名册)── */
.sess {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--cy-bg-card);
  border-radius: var(--cy-radius-lg);
  padding: var(--cy-space-3-5) var(--cy-space-4);
  margin: 0 25rpx 16rpx;
}
.sess__name { font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-text-title); }
.sess__time { font-size: var(--cy-font-label); color: var(--cy-text-body); margin-top: 6rpx; }
.sess__meet { font-size: var(--cy-font-label); color: var(--cy-text-secondary); margin-top: 4rpx; }
.sess__side { text-align: right; flex-shrink: 0; margin-left: var(--cy-space-3-5); }
.sess__price { font-size: var(--cy-font-body); font-weight: 700; color: var(--cy-text-title); }
.sess__left { font-size: var(--cy-font-label); color: var(--cy-text-secondary); margin-top: 6rpx; }
.sess__capacity { font-size: var(--cy-font-label); color: var(--cy-text-secondary); margin: 0 25rpx 8rpx; }
.sess__note { font-size: var(--cy-font-label); color: var(--cy-text-secondary); margin: 8rpx 25rpx 0; }

/* ── 场地卡(详情 tab 简介下方,Figma 2233:11677)── */
.venue-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--cy-bg-card);
  border-radius: var(--cy-radius-lg);
  padding: var(--cy-space-3-5) var(--cy-space-4);
  margin-top: var(--cy-space-4);
}
.venue-card__name { font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-text-title); }
.venue-card__addr { font-size: var(--cy-font-label); color: var(--cy-text-body); margin-top: 6rpx; }
.venue-card__pin { flex-shrink: 0; margin-left: var(--cy-space-4); }

/* 减少动态效果:吸顶标签栏的滑入是整条位移,直接到位;吸顶本身与配色照常,反馈不归零。 */
.topic--reduced .sticky-tab-wrapper.sticky { animation: none; }

/* M2 自玩通行证确认弹层内容 */
.topic-selfplay__body { display: flex; flex-direction: column; gap: var(--cy-space-3); text-align: left; }
.topic-selfplay__text { font-size: var(--cy-font-body); color: var(--cy-color-text-secondary); line-height: 1.5; }
.topic-selfplay__err { display: flex; justify-content: space-between; gap: var(--cy-space-2); font-size: var(--cy-font-caption); color: var(--cy-color-status-danger); }
.topic-selfplay__hint { font-size: var(--cy-font-caption); color: var(--cy-color-text-secondary); }
.topic-selfplay__err-act { color: var(--cy-color-text-primary); text-decoration: underline; flex: none; }
/* 站点卡(稿 214:568,与商家浅色版 181:715 同结构、取玩家域深色 token) */
.node-card {
  margin-top: var(--cy-space-3);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-card);
  overflow: hidden;
}
.node-card-cover { position: relative; }
.node-card-img {
  display: block;
  width: 100%;
  height: 320rpx;
  background: var(--cy-bg-card-2);
}
.node-card-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--cy-space-2) var(--cy-space-4);
  background: var(--cy-comp-scrim);
  font-size: var(--cy-font-label);
  color: var(--cy-text-inverse);
}
.node-card-foot {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--cy-space-3);
  padding: var(--cy-space-3) var(--cy-space-4);
}
.node-card-address {
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
  line-height: 1.5;
  word-break: break-all;
}
.node-card-who {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}
.node-card-name {
  font-size: var(--cy-font-subtitle);
  color: var(--cy-text-title);
}
.node-card-place {
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}
.node-card-more {
  margin-left: var(--cy-space-2);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}

/* 稿 214:384「阵容/商家」:横滑人物卡 —— 圆头像 + 名字 + 角色。
   横滑用 scroll-view(不折行不换页),与稿里章节/玩法模板同一种处理。 */
.topic .lineup {
  padding: var(--cy-space-5) 0 var(--cy-space-2);
}

.topic .lineup .det-type {
  margin: 0 var(--cy-page-x) var(--cy-space-3-5) var(--cy-page-x);
}

.topic .lineup-row {
  white-space: nowrap;
  padding: 0 var(--cy-page-x);
}

.topic .lineup-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  padding: var(--cy-space-4) var(--cy-space-2-5);
  margin-right: var(--cy-space-2-5);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-card);
  vertical-align: top;
}

.topic .lineup-name {
  margin-top: var(--cy-space-2-5);
  max-width: 100%;
  font-size: var(--cy-font-body);
  font-weight: 600;
  color: var(--cy-text-title);
}

.topic .lineup-role {
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-muted);
}

/* 稿 219:389/416 评价空态:一句「写了有什么好处」+ 一个入口 */
.det6-empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--cy-space-3);
  padding-bottom: var(--cy-space-4);
}
.det6-empty-s {
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}

/* 稿 214:689:站与站之间那行「N min 步行」 */
.item-walk {
  /* 站与站之间那一行:左边让开编号列,视觉上落在时间轴上 */
  margin: var(--cy-space-2) 0 var(--cy-space-3) var(--cy-space-8);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-tertiary);
}

/* 稿 181:644 / 214:499「活动内容」：主题介绍下面的一串「这趟里都有什么」，
   一行一条、行首一个点。内容全部来自后端真字段，缺就少一条、都缺整块不出。 */
.topic-includes { margin-top: var(--cy-space-3); }
.topic-includes__t {
  margin-bottom: var(--cy-space-2);
  font-size: var(--cy-font-label);
  font-weight: 600;
  color: var(--cy-text-title);
}
.topic-includes__li {
  position: relative;
  padding-left: var(--cy-space-4);
  margin-bottom: var(--cy-space-1-5);
  font-size: var(--cy-font-label);
  line-height: var(--cy-leading-normal);
  color: var(--cy-text-body);
}
.topic-includes__li::before {
  content: '·';
  position: absolute;
  left: var(--cy-space-2);
}


/* ===== 稿 214:384 数据条(玩家深色;商家浅色版 181:575 是同一块) =====
   稿上的死数:格宽 104、格内 gap 4、小标题 11、大数字 19(纯数字那格 23)、
   格与格之间一条 1×32 竖线。1px = 2rpx。 */
.statbar {
  margin: 0;
  padding: 20rpx 16rpx;
  background: var(--cy-color-play-surface-solid);
  white-space: nowrap;
}
.statbar__row { display: flex; align-items: center; }
.statbar__cell {
  flex: none;
  width: 208rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
/* 稿 188:2968:1×32 的竖线,不是格子的边框 —— 首尾两侧不出现 */
.statbar__sep {
  flex: none;
  width: 1rpx;
  height: 64rpx;
  background: var(--cy-color-play-line);
}
/* CU-M-189 / CU-C-110 / CU-C-130:数据条底钉死为不透明近黑 #101010,而 --cy-text-inverse
   在玩家暗域求值是 #0A0A0A(它是"白底上的反色字"),两者叠出 1.05:1。这块不跟随
   日间域换底,所以文字也不该借用会随主题翻转的 inverse 档,直接用暗域正文/次级字。 */
.statbar__label {
  font-size: var(--cy-type-caption);
  letter-spacing: .44rpx;
  color: var(--cy-color-text-secondary);
}
.statbar__value {
  font-size: 38rpx;            /* ds-ok:稿 19px,card-title(16)与 sheet-title(22)之间没有这一档;为一个元素加全局 token 要同步六处,不值 */
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: .76rpx;
  color: var(--cy-color-text-primary);
}
.statbar__sub {
  font-size: var(--cy-type-caption);
  letter-spacing: .44rpx;
  color: var(--cy-color-text-secondary);
}
.statbar__stars { display: flex; gap: 4rpx; color: var(--cy-color-text-primary); }

/* ===== 2026-10-22 业主动效落地(docs/design/动效界面落地_20261022)===== */
/* A1 封面:多张照片各自慢推,交叉淡入淡出 */
.topic .slide1 .kb { position: absolute; inset: 0; overflow: hidden; }
.topic .slide1 .kb__im { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; will-change: transform, opacity;
  transition: opacity 1.2s ease, transform 9s ease-out; }
.topic .slide1 .kb__im.is-on { opacity: 1; }
/* 两种推法交替:A 由近推远、B 由远拉近;换张时旧图边淡出边慢慢回位 */
.kb__im--a { transform: scale(1.02); }
.kb__im--a.is-on { transform: scale(1.14) translate(-2%, -1.5%); }
.kb__im--b { transform: scale(1.12) translate(2%, 1%); }
.kb__im--b.is-on { transform: scale(1.02); }
/* 点「查看详情与报名」:封面文字下沉淡出 → 第二屏头图回落、信息逐行上浮(点按转场,不是滚动) */
.topic .slide1 .slide-txt { transition: transform .28s cubic-bezier(.4,0,1,1), opacity .28s ease; }
.topic .slide1 .slide-txt--leave { transform: translateY(40rpx); opacity: 0; }
.slide2--enter .det1 { animation: hero-drop .7s cubic-bezier(.16,1,.3,1) both; }
.slide2--enter .hero-by, .slide2--enter .hero-title, .slide2--enter .hero-acts, .slide2--enter .statbar { animation: hero-up .6s cubic-bezier(.16,1,.3,1) both; }
.slide2--enter .hero-title { animation-delay: .06s; }
.slide2--enter .hero-acts { animation-delay: .12s; }
.slide2--enter .statbar { animation-delay: .18s; }
@keyframes hero-drop { from { transform: scale(1.08); opacity: .4; } to { transform: none; opacity: 1; } }
@keyframes hero-up { from { transform: translateY(36rpx); opacity: 0; } to { transform: none; opacity: 1; } }

/* A3–A5 标题区:发布者 / 标题 / 价格按钮 + 收藏 + 类型文字 */
.hero-info { padding: var(--cy-space-5) var(--cy-space-6) var(--cy-space-4); background: var(--cy-color-play-surface-solid); }
.hero-by { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.hero-by__n { font-size: var(--cy-type-caption); font-weight: 600; color: var(--cy-color-text-primary); }
.hero-by__k { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.hero-title { font-size: var(--cy-type-page-title); font-weight: 700; line-height: var(--cy-leading-tight); color: var(--cy-color-text-primary); }
.hero-acts { display: flex; align-items: center; gap: 20rpx; margin-top: var(--cy-space-4); min-height: 88rpx; }
.hero-cta { flex: none; height: 88rpx; padding: 0 40rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-color-action-primary-fg); background: var(--cy-color-action-primary-bg); }
.hero-fav { flex: none; width: 88rpx; height: 88rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  color: var(--cy-color-text-primary); border: 1rpx solid var(--cy-color-play-line); background: var(--cy-color-bg-surface-subtle); }
.hero-fav.is-on, .dock-fav.is-on { color: var(--cy-color-status-danger); }
/* 停靠期间原位留空(占位不塌),由停靠层在顶层飞行 */
.hero-cta.is-away, .hero-fav.is-away { visibility: hidden; }
.hero-type { font-size: var(--cy-font-body); font-weight: 600; }
.hero-type--city { color: #4D9BFF; } /* ds-ok:业主定 城市定向=蓝;暗底上可读的蓝,设计系统无此语义色 */
.hero-type--free { color: #2FD27A; } /* ds-ok:业主定 自由探索=绿;暗底上可读的绿 */

/* 停靠层:价格按钮在右下角,收藏在顶栏胶囊左侧(带胶囊同款描边) */
.dock-cta { position: fixed; z-index: 60; box-sizing: border-box; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; padding: 0 32rpx; /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-color-action-primary-fg); background: var(--cy-color-action-primary-bg);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, .45); /* ds-ok:浮层投影 */ }
.dock-cta.is-merged { opacity: 0; pointer-events: none; } /* 落进详情底栏主按钮后让位给它 */
.dock-fav { position: fixed; z-index: 120; box-sizing: border-box; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  color: var(--cy-color-text-primary); background: rgba(0, 0, 0, .25); /* ds-ok:与微信胶囊同款半透明底 */
  border: 1rpx solid rgba(255, 255, 255, .25); /* ds-ok:微信胶囊描边 */ }

/* A6 数据条首格徽章后的分隔线沿用 .statbar__sep */

/* A12 / A7 参与商家与组队 */
.topic-shops { padding: 0 var(--cy-space-6) var(--cy-space-6); }
.topic-teams { padding: var(--cy-space-6) var(--cy-space-6) 0; }
.topic-teams__card { border-radius: var(--cy-radius-xl); background: var(--cy-color-play-surface-solid); border: 1rpx solid var(--cy-color-play-line); padding: 8rpx 28rpx; }
.topic-teams__hd { display: flex; align-items: baseline; justify-content: space-between; padding: 20rpx 0 12rpx; }
.topic-teams__n { font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-color-text-primary); }
.topic-teams__need { font-size: var(--cy-type-caption); color: var(--cy-color-status-warning); }
.topic-teams__row { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-top: 1rpx solid var(--cy-color-play-line); }
.topic-teams__av { flex: none; display: flex; }
.topic-teams__av cy-avatar + cy-avatar { margin-left: -16rpx; }
.topic-teams__tx { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.topic-teams__t { font-size: var(--cy-font-body); color: var(--cy-color-text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.topic-teams__s { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.topic-teams__cnt { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.topic-teams__c { font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-color-text-primary); }
.topic-teams__m { font-size: var(--cy-type-caption); color: var(--cy-color-status-warning); }
.topic-teams__ft { padding: 16rpx 0 20rpx; border-top: 1rpx solid var(--cy-color-play-line); font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }

/* A9 故事标签:扇形下面的标题 + A10 章节卡(整图 + 底部模糊渐变,点开展开) */
.story-head { padding: 8rpx var(--cy-space-6) var(--cy-space-4); display: flex; flex-direction: column; gap: 8rpx; }
.story-head__t { font-size: var(--cy-type-page-title); font-weight: 700; color: var(--cy-color-text-primary); }
.story-head__s { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.story-cards { padding: 0 var(--cy-space-6) var(--cy-space-6); display: flex; flex-direction: column; gap: 20rpx; }
.story-cc { position: relative; height: 200rpx; border-radius: var(--cy-radius-xl); overflow: hidden; clip-path: inset(0 round var(--cy-radius-xl));
  background: var(--cy-color-play-surface-solid); transition: height .45s cubic-bezier(.16,1,.3,1), opacity .56s ease, transform .56s cubic-bezier(.2,.82,.2,1); }
.story-cc.is-open { height: 520rpx; }
.story-cc__img { position: absolute; inset: 0; width: 100%; height: 100%; }
.story-cc__blur { position: absolute; left: 0; right: 0; bottom: 0; height: 70%; backdrop-filter: blur(24rpx); -webkit-backdrop-filter: blur(24rpx);
  -webkit-mask-image: linear-gradient(transparent, #000 55%); mask-image: linear-gradient(transparent, #000 55%); /* ds-ok:遮罩 alpha */ }
.story-cc__sh { position: absolute; inset: 0; background: linear-gradient(rgba(0,0,0,.05), rgba(0,0,0,.72)); /* ds-ok:照片压暗渐变 */ }
