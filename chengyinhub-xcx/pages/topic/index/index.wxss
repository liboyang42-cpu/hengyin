/* v13 切标签:每块从下方 16px 依次浮上(原型 stagger 45–60ms);故事里的章节卡带一点 X 轴倾斜飞入 */
.topic .tabcont > view, .topic .tabcont > text, .topic .tabcont > cy-merchant-cards { transition: opacity .46s ease, transform .46s cubic-bezier(.2,.82,.2,1); }
.topic .tab-pre.tabcont > view, .topic .tab-pre.tabcont > text, .topic .tab-pre.tabcont > cy-merchant-cards { opacity: 0; transform: translateY(31rpx); transition: none; }
.topic .tabcont > view:nth-child(2), .topic .tabcont > text:nth-child(2) { transition-delay: .05s; } .topic .tabcont > view:nth-child(3), .topic .tabcont > text:nth-child(3) { transition-delay: .1s; }
.topic .tabcont > view:nth-child(4), .topic .tabcont > text:nth-child(4) { transition-delay: .15s; } .topic .tabcont > view:nth-child(5), .topic .tabcont > text:nth-child(5) { transition-delay: .2s; }
.topic .tabcont > view:nth-child(6), .topic .tabcont > text:nth-child(6) { transition-delay: .25s; } .topic .tabcont > view:nth-child(7), .topic .tabcont > text:nth-child(7) { transition-delay: .3s; }
.topic .tabcont > view:nth-child(n+8), .topic .tabcont > text:nth-child(n+8) { transition-delay: .35s; }
.topic .tab-pre .story-cc { opacity: 0; transform: translateY(77rpx) rotateX(-25deg) scale(.96); transition: none; }

