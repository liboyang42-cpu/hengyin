@import "../team.wxss";

button.team-action { margin: 0; padding: 0; line-height: normal; }
button.team-action::after { border: 0; }
.team-actions + .team-card { margin-top: var(--cy-space-4); } /* 邀请队友与「公开招募」卡之间留白 */
.team-report { text-align: center; text-decoration: underline; padding: var(--cy-space-3) 0; }

/* 队伍进度矩阵(原型 B T-32):成员 × 节点,节点多时横滑 */
.tm-sum { min-height: 0; padding-bottom: var(--cy-space-1); border-bottom: 0; }
.tm-matrix { width: 100%; margin-top: var(--cy-space-2); white-space: nowrap; }
.tm-mx { display: inline-block; min-width: 100%; }
.tm-mx-row { display: flex; align-items: center; min-height: 70rpx; border-top: 1rpx solid var(--cy-border-line); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.tm-mx-head { border-top: 0; }
.tm-mx-name { flex: none; width: 124rpx; padding-right: var(--cy-space-2); box-sizing: border-box; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--cy-text-title); }
.tm-mx-cell { flex: 1 0 92rpx; width: 92rpx; display: flex; justify-content: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; }
.tm-mx-foot .tm-mx-cell.ok { color: var(--cy-brand); }
.tm-dot { width: 20rpx; height: 20rpx; border-radius: 50%; border: 2rpx solid var(--cy-border-line); box-sizing: border-box; }
.tm-dot.on { background: var(--cy-text-title); border-color: var(--cy-text-title); }
.tm-rank { flex: none; width: 46rpx; font-weight: 800; color: var(--cy-text-secondary); }
.tm-val { flex: none; color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }

/* U06-01 席位(r2-join):头像 + 空位虚线圈一排,依次弹入;空位轻呼吸;下方小标签 */
.tm-seats { padding-top: var(--cy-space-3); padding-bottom: var(--cy-space-3); }
.tm-seat-strip { display: flex; flex-wrap: wrap; gap: var(--cy-space-2); }
.tm-seat-cell { position: relative; width: 88rpx; height: 88rpx; transition: opacity 360ms cubic-bezier(.3,1.3,.5,1) var(--tm-d, 0ms), transform 360ms cubic-bezier(.3,1.3,.5,1) var(--tm-d, 0ms); }
/* 依次弹入:数据落地前 enter(seatIn) 挂 is-pre(缩小透明、无过渡),撤掉后按 --tm-d 逐个错开弹回 */
.tm-seat-strip.is-pre .tm-seat-cell { opacity: 0; transform: scale(.6); transition: none; }
.tm-seat-av { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--cy-bg-elevated); }
.tm-seat-crown { position: absolute; left: 50%; bottom: -10rpx; transform: translateX(-50%); padding: 0 10rpx; border-radius: var(--cy-radius-pill); background: var(--cy-brand); color: var(--cy-text-inverse); font-size: var(--cy-font-micro); line-height: 1.4; white-space: nowrap; }
.tm-seat-open { width: 88rpx; height: 88rpx; box-sizing: border-box; border-radius: 50%; border: 3rpx dashed var(--cy-text-secondary); display: flex; align-items: center; justify-content: center; color: var(--cy-text-secondary); opacity: .75; transition: opacity 1.2s ease-in-out; }
/* 空位轻呼吸:beats(seatBreath) 每 1.2s 在 .75 与 1 之间往返(原 2.4s 一个来回,ease-in-out) */
.tm-seat-strip.is-lit .tm-seat-open { opacity: 1; }
.tm-chips { display: flex; flex-wrap: wrap; gap: var(--cy-space-1-5); margin-top: var(--cy-space-3); }
.tm-seat-strip + .tm-chips { padding-top: var(--cy-space-3); border-top: 1rpx solid var(--cy-border-line); }
.tm-chip { display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx var(--cy-space-2); border-radius: var(--cy-radius-pill); background: var(--cy-bg-elevated); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.tm-chip__v { font-weight: 700; color: var(--cy-text-title); font-variant-numeric: tabular-nums; }
.tm-chip.is-bad, .tm-chip.is-bad .tm-chip__v { color: var(--cy-danger); }
@media (prefers-reduced-motion: reduce) { .tm-seat-strip .tm-seat-cell { opacity: 1; transform: none; transition: none; } .tm-seat-strip .tm-seat-open { opacity: 1; transition: none; } }

/* l-misc 队伍二维码弹层:码图是白底方块(黑点码要白底才扫得出),加入码一行可点复制 */
.tm-qr { display: flex; flex-direction: column; align-items: center; gap: var(--cy-space-4); padding: var(--cy-space-2) var(--cy-space-4) var(--cy-space-5); }
.tm-qr__img { width: 480rpx; height: 480rpx; border-radius: var(--cy-radius-md); background: var(--cy-comp-sheet-invite-qr-bg); }
.tm-qr__state { min-height: 120rpx; display: flex; align-items: center; color: var(--cy-text-secondary); font-size: var(--cy-font-body); }
.tm-qr__code { width: 100%; min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; gap: var(--cy-space-2); padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-md); background: var(--cy-bg-elevated); }
.tm-qr__k { flex: none; color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.tm-qr__v { flex: 1; min-width: 0; color: var(--cy-text-title); font-size: var(--cy-font-body); word-break: break-all; }
.tm-qr__copy { flex: none; color: var(--cy-brand); font-size: var(--cy-font-caption); font-weight: 600; }

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.team-report { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
.tm-qr__code { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
