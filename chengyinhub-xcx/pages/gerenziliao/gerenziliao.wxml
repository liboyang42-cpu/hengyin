<view class="theme-dark">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
<cy-nav-bar />
<view class="profile-nav-spacer" style="height: {{statusBarHeight + navBarHeight}}px;"></view>
<view class="profile-load-shell" wx:if="{{loading && !loaded}}">
  <cy-skeleton wx:if="{{loading && !loaded}}" type="form-section" count="{{5}}" loading-label="正在读取个人资料" />
</view>
<cy-state-shell wx:elif="{{loadError && !loaded}}" kind="{{loadErrorKind}}"
                title="{{loadError}}" sub="{{loadErrorSub}}" primary="重新加载"
                fill size="lg" bind:primary="retryLoad" auto-back custom-back bind:back="exitPage" />
<block wx:else>
<view class="profile-refresh-state">
  <text wx:if="{{refreshing}}" class="profile-refreshing" aria-role="status">正在确认个人资料…</text>
</view>
<view class="shzltop">
  <view class="shzltop_tu" bindtap="uploadPic" aria-role="button" aria-label="修改头像" hover-class="cy-pressed" hover-stay-time="80">
      <cy-avatar src="{{userInfo.avatar || '/images/d_profile.png'}}" size="170" />
      <view class="dbj pen-badge" aria-hidden="true"><cy-icon name="edit" size="24" /></view>
  </view>
  <text wx:if="{{avatarReviewText}}" class="profile-avatar-review" aria-role="status">{{avatarReviewText}}</text>
</view>
<view class="shzlbox">
  <view class="shzlbox_li">
    <view class="shzlbox_li_left">
      <view class="shzlbox_li_left_name">昵称</view>
      <view class="shzlbox_li_left_txt {{userInfo.name ? '' : 'is-empty'}}">{{userInfo.name || '未填写'}}</view>
    </view>
    <view class="shzlbox_li_right" bindtap="openPop4" aria-role="button" aria-label="编辑昵称" hover-class="cy-pressed" hover-stay-time="80">
      <view class="pen-badge" aria-hidden="true"><cy-icon name="edit" size="24" /></view>
    </view>
  </view>
  <view class="shzlbox_li">
    <view class="shzlbox_li_left">
      <view class="shzlbox_li_left_name">手机号</view>
      <view class="shzlbox_li_left_txt {{userInfo.phone ? '' : 'is-empty'}}">{{phoneMasked || '未绑定'}}</view>
    </view>
    <!-- P-56(2026-10-27):已绑定也给修改图标,点开走微信手机号授权换绑(同一 getPhoneNumber → /api/getwxbindphone) -->
    <button class="shzlbox_li_right shzlbox_bind" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber" aria-label="{{userInfo.phone ? '更换手机号' : '绑定手机号'}}" hover-class="cy-pressed" hover-stay-time="80">
      <view class="pen-badge" aria-hidden="true"><cy-icon name="edit" size="24" /></view>
    </button>
  </view>
  <view class="shzlbox_li">
    <view class="shzlbox_li_left">
      <view class="shzlbox_li_left_name">城市签名</view>

      <view class="shzlbox_li_left_txt {{userInfo.introduction ? '' : 'is-empty'}}">{{userInfo.introduction || '未填写'}}</view>
    </view>
    <view class="shzlbox_li_right" bindtap="openPop" aria-role="button" aria-label="编辑城市签名" hover-class="cy-pressed" hover-stay-time="80"><view class="pen-badge" aria-hidden="true"><cy-icon name="edit" size="24" /></view></view>
  </view>
  <view class="shzlbox_li">
    <view class="shzlbox_li_left">
      <view class="shzlbox_li_left_name">探索作品</view>
      <view class="shzlbox_li_left_ntu" wx:if="{{casePicsList.length > 0}}">
        <view class="shzlbox_li_left_ntu_li" wx:for="{{casePicsList}}" wx:key="index">
          <image lazy-load="true" src="{{item}}" mode="aspectFill" />
        </view>
      </view>
      <view class="shzlbox_li_left_txt is-empty" wx:else>未填写</view>
      <!--<view class="shzlbox_li_left_txt lan">{{userInfo.caseIntroducton}}</view>-->
    </view>
    <view class="shzlbox_li_right" bindtap="openPop2" aria-role="button" aria-label="编辑探索作品" hover-class="cy-pressed" hover-stay-time="80"><view class="pen-badge" aria-hidden="true"><cy-icon name="edit" size="24" /></view></view>
  </view>
  <view class="shzlbox_li">
    <view class="shzlbox_li_left">
      <view class="shzlbox_li_left_name">联系二维码</view>
      <view class="shzlbox_li_left_ntu" wx:if="{{userInfo.wechat}}">
        <view class="shzlbox_li_left_ntu_li">
          <image lazy-load="true" src="{{userInfo.wechat }}" mode="aspectFill" />
        </view>
      </view>
      <view class="shzlbox_li_left_txt is-empty" wx:else>未填写</view>
      <!--<view class="shzlbox_li_left_txt lan">{{userInfo.website}}</view>-->
    </view>
    <view class="shzlbox_li_right" bindtap="openPop3" aria-role="button" aria-label="编辑联系二维码" hover-class="cy-pressed" hover-stay-time="80"><view class="pen-badge" aria-hidden="true"><cy-icon name="edit" size="24" /></view></view>
  </view>
  <view class="shzlbox_li">
    <view class="shzlbox_li_left">
      <view class="shzlbox_li_left_name">路线偏好</view>
      <view class="shzlbox_li_left_txt" wx:if="{{categoryList.length > 0}}">
        <view class="shzlbox_li_left_txt_li" wx:for="{{categoryList}}" wx:key="id">
          <image class="profile-category-icon" lazy-load="true" src="{{item.icon}}" mode="widthFix" />
          <text>{{item.categoryName}}</text>
          <view class="del-hit" bindtap="removeCategory" aria-role="button" aria-label="移除该分类" data-id="{{item.id}}" hover-class="cy-pressed" hover-stay-time="80" ds-ok="宿主 chip 高 50rpx 且 overflow:hidden，纵向热区物理上封顶 50rpx（25px）；已扩到 chip 允许的最大值 48×50rpx（24×25px，满足 WCAG 2.5.8 AA 的 24px 下限）。要到 88rpx 必须把 chip 本身加高到 88rpx，那是视觉改动，需设计走查。不能靠去掉 overflow:hidden 突破：chip 行间距只有 10rpx，热区一越界就会跨行盖住上下一行 chip 的删除钮，互相偷点击。"><image lazy-load="true" class="del" src="/images/del.png" mode="widthFix" /></view>
        </view>
      </view>
      <view class="shzlbox_li_left_txt is-empty" wx:else>未填写</view>
    </view>
    <view class="shzlbox_li_right" bindtap="navigateToCategorySelect" aria-role="button" aria-label="编辑路线偏好" hover-class="cy-pressed" hover-stay-time="80">
      <view class="pen-badge" aria-hidden="true"><cy-icon name="edit" size="24" /></view>
    </view>
  </view>
</view>
<view class="profile-save-state">
  <cy-progress-status wx:if="{{saving || saveSucceeded}}" density="compact"
                      steps="{{saveSteps}}" current="{{saveSucceeded ? 1 : 0}}"
                      title="{{saveSucceeded ? '资料已保存' : '正在保存资料'}}"
                      sub="请勿离开本页" />
  <cy-inline-error wx:if="{{saveError}}" title="资料没有保存" sub="{{saveError}}"
                   action="重试保存" bind:action="saveInfo" />
</view>
<!-- 底栏避让走 token(DS §3.11-2),原来是 180rpx 的内联字面占位 -->
<view class="gz-footer-hold"></view>
<!-- 保存栏收编 cy-footer-bar(与同队列 address / addressinfo 同范式)。
     原自造的 .bmbottom 是 position:fixed 但**没有任何 z-index** —— 本队列唯一不带层级的固定栏,
     C03-R4 复拍的 S1_scroll_bottom 里它在滚到底后整条消失(02 顶部态还在)。
     cy-footer-bar 自带 z-index: var(--cy-z-nav)=90 + 安全区 + 页边距,且低于 cy-sheet(800),
     所以本页四个编辑面板照常压在它上面。 -->
<cy-footer-bar>
  <cy-btn variant="primary" loading="{{saving}}" disabled="{{!canSave || saving}}" bindtap="saveInfo"
          accessibility-label="{{saving ? '正在保存个人资料' : '保存个人资料'}}">{{saving ? '保存中…' : '保存'}}</cy-btn>
</cy-footer-bar>

<!-- 个人介绍 -->
<cy-sheet class="profile-edit-sheet" show="{{ popDavid }}" title="城市签名" footer bind:close="cancel">
  <view class="pop-model pop-temp">
    <view class="david_tk">
      <view class="david_tk_box {{tempIntroduction ? 'is-filled' : ''}}">
        <textarea value="{{tempIntroduction}}" placeholder="写一句你喜欢的城市探索方式" placeholder-class="profile-edit-placeholder" bindinput="onInputChange" data-field="introduction"></textarea>
      </view>
    </view>
  </view>
  <cy-btn slot="footer" variant="primary" bindtap="confirm">完成</cy-btn>
</cy-sheet>

  <!-- 探索作品 -->
<cy-sheet class="profile-edit-sheet" show="{{ popDavid2 }}" title="探索作品" footer bind:close="cancel2">
  <view class="pop-model pop-temp">
    <view class="david_tk">
      <view class="david_tk_con">
        <view class="david_tk_con_sc" wx:for="{{tempCasePics}}" wx:key="index" wx:for-item="pic" wx:for-index="index">
          <image lazy-load="true" src="{{pic}}" mode="aspectFill" />
          <view class="david_del-hit" bindtap="deleteCasePic" aria-role="button" aria-label="删除这张作品图" data-index="{{index}}" hover-class="cy-pressed" hover-stay-time="80"><image lazy-load="true" class="david_del" src="/images/del.png" mode="aspectFill" /></view>
        </view>
        <button class="david_tk_con_tgb" bindtap="uploadCasePics" wx:if="{{tempCasePics.length < 9}}">
          <view class="david_tk_con_tgb_tu"><image lazy-load="true" src="/pages/gerenziliao/images/d_sctb.png" mode="widthFix" /></view>
          <view class="david_tk_con_tgb_txt">上传<text>路线照片</text></view>
        </button>
      </view>
    </view>
  </view>
  <cy-btn slot="footer" variant="primary" bindtap="confirm2">完成</cy-btn>
</cy-sheet>

  <!-- 联系二维码 -->
<cy-sheet class="profile-edit-sheet" show="{{ popDavid3 }}" title="联系二维码" footer bind:close="cancel3">
  <view class="pop-model pop-temp">
    <view class="david_tk">
      <view class="david_tk_con profile-contact-media">
        <view class="david_tk_con_sc" wx:if="{{tempWechat}}">
          <image lazy-load="true" src="{{tempWechat}}" mode="aspectFit" />
          <view class="david_del-hit" bindtap="deleteWechat" aria-role="button" aria-label="清除微信号" hover-class="cy-pressed" hover-stay-time="80"><image lazy-load="true" class="david_del" src="/images/del.png" mode="aspectFill" /></view>
        </view>
        <button class="david_tk_con_tgb" bindtap="uploadWechat" wx:if="{{!tempWechat}}">
          <view class="david_tk_con_tgb_tu"><image lazy-load="true" src="/pages/gerenziliao/images/d_sctb.png" mode="widthFix" /></view>
          <view class="david_tk_con_tgb_txt">上传<text>联系二维码</text></view>
        </button>
      </view>
    </view>
  </view>
  <cy-btn slot="footer" variant="primary" bindtap="confirm3">完成</cy-btn>
</cy-sheet>

  <!-- 昵称 -->
<cy-sheet class="profile-edit-sheet" inset show="{{ popDavid4 }}" title="昵称" footer bind:close="cancel4">
  <view class="pop-model pop-temp">
    <view class="david_tk">
      <cy-field class="profile-name-field" value="{{tempName}}" placeholder="请输入昵称" disabled="{{saving}}" maxlength="{{24}}"
                bind:input="onInputChange" data-field="name"
                error="{{nicknameState === 'taken' || nicknameState === 'invalid'}}" errorText="{{nicknameHint}}"
                success="{{nicknameState === 'available'}}"
                helperText="{{nicknameState === 'taken' || nicknameState === 'invalid' ? '' : (nicknameHint || '2–24 个字，可用文字、数字和 _ # - . · 空格')}}" />
      <view wx:if="{{nicknameState === 'error'}}" class="profile-name-actions">
        <view class="profile-name-link" bindtap="retryNicknameCheck"
              aria-role="button" aria-label="重新检查昵称" hover-class="cy-pressed" hover-stay-time="80">重新检查</view>
      </view>
      <view wx:if="{{nicknameState === 'taken' || nicknameSuggestions.length}}" class="profile-name-suggest">
        <view class="profile-name-suggest-head">
          <text class="profile-name-suggest-title">{{nicknameSuggesting && !nicknameSuggestions.length ? '正在找可用的昵称…' : '可以用这些昵称'}}</text>
          <view class="profile-name-link {{nicknameSuggesting || saving ? 'is-disabled' : ''}}" bindtap="moreNicknameSuggestions"
                aria-role="button" aria-label="换一批推荐昵称" aria-disabled="{{nicknameSuggesting || saving}}"
                hover-class="{{nicknameSuggesting || saving ? 'none' : 'cy-pressed'}}" hover-stay-time="80">{{nicknameSuggesting ? '正在推荐…' : '换一批'}}</view>
        </view>
        <view class="profile-name-chips">
          <view wx:for="{{nicknameSuggestions}}" wx:key="*this" class="profile-name-chip" data-name="{{item}}" bindtap="pickNicknameSuggestion"
                aria-role="button" aria-label="使用昵称 {{item}}" hover-class="cy-pressed" hover-stay-time="80">{{item}}</view>
        </view>
      </view>
      <cy-inline-error wx:if="{{nicknameSuggestError}}" title="没拿到推荐" sub="{{nicknameSuggestError}}"
                       action="再试一次" bind:action="moreNicknameSuggestions" />
    </view>
  </view>
  <cy-btn slot="footer" variant="primary" bindtap="confirm4">完成</cy-btn>
</cy-sheet>

<cy-category-sheet class="profile-edit-sheet" show="{{categorySheetVisible}}" type="{{1}}" ids="{{categorySheetIds}}"
  bind:select="onCategorySelect" bind:close="onCategorySheetClose" />
</block>
</view>
