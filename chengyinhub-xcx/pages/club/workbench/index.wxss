@import "../../../style/tokens.wxss";

.cw-shell {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--cy-bg-page);
  color: var(--cy-text-title);
}

.cw-shell-back {
  width: fit-content;
  min-height: 88rpx;
  margin: var(--cy-space-3) auto 0;
  padding: 0 var(--cy-space-4);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  color: var(--cy-text-secondary);
  font-size: var(--cy-font-body);
}

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.cw-shell-back { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
