/* C1 channels-structure:版式沿用 pages/club/roles(同一套 token 与行样式),不新增视觉。 */
page { background: var(--cy-bg-page); }
.page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(var(--cy-space-6) + var(--cy-safe-bottom)); }
.section { margin: 40rpx var(--cy-page-x) 0; } /* ds-ok: 40rpx = Figma 区块间距 20px，同 pages/club/roles */
cy-page-title + .section { margin-top: 0; }
.section-head { display: flex; align-items: center; gap: var(--cy-space-2-5); }
.section-title { flex: 1; min-width: 0; color: var(--cy-text-title); font-size: var(--cy-font-body); font-weight: 700; }
.ds-card { margin-top: var(--cy-space-4); padding: 0 28rpx; border-radius: var(--cy-comp-card-radius); background: var(--cy-comp-card-bg); } /* ds-ok: 28rpx = Figma 卡片左右内距 14px，同 pages/club/roles */
.row { display: flex; align-items: center; gap: var(--cy-space-2-5); padding: 26rpx 0; transition: var(--cy-tr-press); } /* ds-ok: 26rpx = Figma 行上下内距 13px，同 pages/club/roles */
.row + .row { border-top: 1rpx solid var(--cy-color-border-subtle); }
.row-text { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: var(--cy-space-1); }
.row-title { overflow: hidden; color: var(--cy-text-title); font-size: var(--cy-font-body); text-overflow: ellipsis; white-space: nowrap; }
.row-desc { color: var(--cy-text-tertiary); font-size: var(--cy-font-caption); line-height: 1.5; }
.row-value { flex: none; color: var(--cy-text-tertiary); font-size: var(--cy-font-label); white-space: nowrap; font-variant-numeric: tabular-nums; }
.row-value--primary { color: var(--cy-text-title); }
.row-pick-arrow { flex: none; margin-left: var(--cy-space-1); color: var(--cy-text-secondary); }
.row-actions { display: flex; flex: none; align-items: center; gap: var(--cy-space-3); }
.row-link-plain { color: var(--cy-text-secondary); font-size: var(--cy-font-label); }
.disabled { opacity: .45; pointer-events: none; }
.picker { padding: 0 0 24rpx; } /* cy-sheet 面板已带页边距，同 pages/club/roles */
.assign-btn { margin: var(--cy-space-4) 0 0; height: 96rpx; display: flex; align-items: center;
  justify-content: center; border-radius: var(--cy-radius-pill); background: var(--cy-text-title);
  color: var(--cy-color-bg-page); font-size: var(--cy-font-body); font-weight: 700; }
.assign-btn.disabled { opacity: .45; }
