<view class="page theme-dark">
  <cy-toast id="cy-toast" />
  <cy-modal-host id="cy-modal-host" />
  <cy-nav-bar custom-back bind:back="onBack" />
  <view style="height: {{statusBarHeight + navBarHeight}}px;"></view>
  <cy-page-title title="频道" safe-top="{{false}}" />

  <cy-skeleton wx:if="{{state === 'loading'}}" type="list" count="4" />
  <cy-error wx:elif="{{state === 'invalid'}}" title="{{errMsg || '缺少俱乐部信息'}}" retry="" />
  <cy-error wx:elif="{{state === 'no-access'}}" title="加入俱乐部后才能查看频道" sub="{{errMsg}}" retry="" />
  <cy-error load-failure wx:elif="{{state === 'error'}}" title="频道加载失败" sub="{{errMsg}}" retry="重新加载" bind:retry="onRetry" />

  <block wx:elif="{{state === 'ready'}}">
    <!-- 管理动作:只有管理清单接口放行(主理人/管理员)时才出现 -->
    <view class="section" wx:if="{{isManager}}">
      <view class="ds-card">
        <view class="row" bindtap="onCreate" aria-role="button" aria-label="新建频道或分类" hover-class="cy-pressed" hover-stay-time="80">
          <cy-icon name="plus" size="32" />
          <view class="row-text"><text class="row-title">新建频道或分类</text></view>
          <cy-icon class="row-pick-arrow" name="arrow-right" size="24" />
        </view>
        <view class="row" bindtap="toggleReorder" aria-role="button" aria-label="{{reordering ? '完成调整' : '调整顺序'}}" hover-class="cy-pressed" hover-stay-time="80">
          <cy-icon name="list" size="32" />
          <view class="row-text">
            <text class="row-title">{{reordering ? '完成调整' : '调整顺序'}}</text>
            <text class="row-desc">上下移动频道和分类，或把频道移到别的分类</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 邀请沿用俱乐部分享链接(与俱乐部详情页同一路径)，加入后自动看到频道。 -->
    <view class="section">
      <view class="ds-card">
        <button class="row share-row" open-type="share" aria-label="邀请朋友加入俱乐部" hover-class="cy-pressed" hover-stay-time="80">
          <cy-icon name="share" size="32" />
          <view class="row-text"><text class="row-title">邀请朋友</text><text class="row-desc">发送俱乐部链接，加入后就能看到这些频道</text></view>
          <cy-icon class="row-pick-arrow" name="arrow-right" size="24" />
        </button>
      </view>
    </view>

    <cy-empty wx:if="{{sections.length === 0}}" fill kind="empty" title="还没有频道" />

    <view class="section" wx:for="{{sections}}" wx:for-item="section" wx:key="key" wx:if="{{isManager || section.channels.length}}">
      <view class="section-head">
        <text class="section-title">{{section.title || '频道'}}</text>
        <block wx:if="{{isManager && section.category}}">
          <text wx:if="{{section.category.archived}}" class="row-value">已归档</text>
          <view wx:if="{{reordering}}" class="row-actions">
            <text class="row-link-plain {{section.category.canUp && !busy ? '' : 'disabled'}}" data-id="{{section.category.id}}" data-dir="up" catchtap="onMove" aria-role="button" aria-label="上移分类" hover-class="cy-pressed" hover-stay-time="80">上移</text>
            <text class="row-link-plain {{section.category.canDown && !busy ? '' : 'disabled'}}" data-id="{{section.category.id}}" data-dir="down" catchtap="onMove" aria-role="button" aria-label="下移分类" hover-class="cy-pressed" hover-stay-time="80">下移</text>
          </view>
          <view wx:else class="row-actions">
            <text class="row-link-plain" data-id="{{section.category.id}}" catchtap="onArchive" aria-role="button" aria-label="{{section.category.archived ? '取消归档分类' : '归档分类'}}" hover-class="cy-pressed" hover-stay-time="80">{{section.category.archived ? '取消归档' : '归档'}}</text>
          </view>
        </block>
      </view>
      <view class="ds-card">
        <view class="row" wx:for="{{section.channels}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onOpenChannel" aria-role="button" aria-label="打开频道 {{item.name}}" hover-class="cy-pressed" hover-stay-time="80">
          <cy-icon name="comment" size="32" />
          <view class="row-text">
            <text class="row-title">{{item.name}}</text>
            <text class="row-desc">{{item.kindLabel}}<text wx:if="{{item.isDefault}}"> · 默认频道</text><text wx:if="{{item.archived}}"> · 已归档，只读</text><text wx:elif="{{item.kind === 2}}"> · 仅主理人和管理员发言</text><text wx:if="{{item.topic}}"> · {{item.topic}}</text></text>
          </view>
          <text wx:if="{{!isManager && item.unread > 0}}" class="row-value row-value--primary">{{item.unread > 99 ? '99+' : item.unread}}</text>
          <view wx:if="{{isManager && reordering}}" class="row-actions">
            <text wx:if="{{!item.isDefault}}" class="row-link-plain {{busy ? 'disabled' : ''}}" data-id="{{item.id}}" catchtap="onMoveTo" aria-role="button" aria-label="把 {{item.name}} 移到别的分类" hover-class="cy-pressed" hover-stay-time="80">移到</text>
            <text class="row-link-plain {{item.canUp && !busy ? '' : 'disabled'}}" data-id="{{item.id}}" data-dir="up" catchtap="onMove" aria-role="button" aria-label="上移 {{item.name}}" hover-class="cy-pressed" hover-stay-time="80">上移</text>
            <text class="row-link-plain {{item.canDown && !busy ? '' : 'disabled'}}" data-id="{{item.id}}" data-dir="down" catchtap="onMove" aria-role="button" aria-label="下移 {{item.name}}" hover-class="cy-pressed" hover-stay-time="80">下移</text>
          </view>
          <view wx:elif="{{isManager}}" class="row-actions">
            <text wx:if="{{!item.archived}}" class="row-link-plain" data-id="{{item.id}}" catchtap="onEdit" aria-role="button" aria-label="设置 {{item.name}}" hover-class="cy-pressed" hover-stay-time="80">设置</text>
            <text wx:if="{{!item.isDefault || item.archived}}" class="row-link-plain" data-id="{{item.id}}" catchtap="onArchive" aria-role="button" aria-label="{{item.archived ? '取消归档' : '归档'}} {{item.name}}" hover-class="cy-pressed" hover-stay-time="80">{{item.archived ? '取消归档' : '归档'}}</text>
          </view>
          <cy-icon wx:else class="row-pick-arrow" name="arrow-right" size="24" />
        </view>
        <view wx:if="{{section.channels.length === 0}}" class="row"><text class="row-desc">这个分类下还没有频道</text></view>
      </view>
    </view>
  </block>

  <cy-sheet show="{{editorShow}}" title="{{editor && editor.mode === 'edit' ? '频道设置' : '新建'}}" handle closable maskClosable bind:close="onEditorClose">
    <view class="picker" wx:if="{{editor}}">
      <cy-field label="名称" placeholder="1–64 个字" value="{{editor.name}}" maxlength="64" required bind:input="onNameInput" />
      <cy-field wx:if="{{editor.kind !== 0}}" label="话题" placeholder="一句话说明这个频道聊什么(可不填)" value="{{editor.topic}}" maxlength="120" bind:input="onTopicInput" />
      <cy-cell wx:if="{{editor.mode === 'create'}}" title="类型" value="{{editor.kindLabel}}" bind:tap="onPickKind" />
      <cy-cell wx:if="{{editor.mode === 'create' && editor.kind !== 0}}" title="分类" value="{{editor.parentLabel}}" bind:tap="onPickParent" />
      <cy-cell wx:if="{{editor.kind !== 0}}" title="慢速模式" description="成员两次发言之间至少间隔这么久；主理人和管理员不受限" value="{{editor.slowmodeLabel}}" bind:tap="onPickSlowmode" />
      <view class="assign-btn {{busy ? 'disabled' : ''}}" bindtap="onEditorSave" aria-role="button" aria-label="保存" hover-class="cy-pressed" hover-stay-time="80">保存</view>
    </view>
  </cy-sheet>

  <cy-option-sheet show="{{pickerShow}}" title="{{pickerTitle}}" items="{{pickerItems}}" immediate bind:select="onPickerSelect" bind:cancel="onPickerCancel" />
</view>
