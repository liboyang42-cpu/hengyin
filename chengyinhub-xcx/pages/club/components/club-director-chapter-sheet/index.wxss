:host { display: block; }
.cdcs__body { display: flex; flex-direction: column; }
.cdcs__primary {
  margin-top: 20rpx;
  padding: 30rpx 0;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-btn-solid-bg);
  color: var(--cy-btn-solid-fg);
  font-size: var(--cy-font-body);
  font-weight: 600;
  text-align: center;
}
.cdcs__primary.is-disabled { opacity: .45; }
.cdcs__caption {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  color: var(--cy-color-status-warning);
  font-size: var(--cy-font-caption);
}

/* isolated 组件内全局 .cy-pressed 进不来,按仓库既有组件做法本地定义一份 */
.cy-pressed { opacity: .88; }

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.cdcs__primary { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
