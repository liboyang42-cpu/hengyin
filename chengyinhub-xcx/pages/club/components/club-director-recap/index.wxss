:host { display: block; }
.cdrecap__title {
  display: block;
  margin-bottom: 20rpx;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-title);
  font-weight: 700;
}
.cdrecap__section { margin-bottom: 20rpx; }
.cdrecap__section-title {
  display: block;
  margin-bottom: 16rpx;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-subtitle);
  font-weight: 700;
}
.cdrecap__metrics {
  margin-bottom: 32rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}
.cdrecap__metric {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: var(--cy-space-4) 20rpx var(--cy-space-4) 28rpx;
  border-radius: var(--cy-comp-sheet-card-radius);
  background: var(--cy-color-bg-surface-strong);
  box-sizing: border-box;
}
.cdrecap__metric-value {
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-display);
  font-weight: 700;
}
.cdrecap__metric-unit {
  margin-left: 4rpx;
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-font-caption);
  font-weight: 400;
}
.cdrecap__metric-label {
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-font-caption);
}
.cdrecap__caption {
  display: block;
  margin-top: 4rpx;
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
}

/* 细节打磨二期 L1/L5/L7 */
.cdrecap__metric-value,
.cdrecap__metric-unit,
.cdrecap__metric-label { font-variant-numeric: tabular-nums; }
