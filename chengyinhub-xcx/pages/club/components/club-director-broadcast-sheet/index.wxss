:host { display: block; }
.cdbs__body { display: flex; flex-direction: column; }
.cdbs__section-title {
  display: block;
  margin: 20rpx 0 16rpx;
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
  font-weight: 600;
}
.cdbs__field { position: relative; border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-elevated); }
.cdbs__textarea {
  display: block;
  width: 100%;
  height: 200rpx;
  padding: 28rpx 28rpx 56rpx;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-body);
  box-sizing: border-box;
}
.cdbs__count { position: absolute; right: 24rpx; bottom: 16rpx; color: var(--cy-color-text-tertiary); font-size: var(--cy-font-caption); font-variant-numeric: tabular-nums; }
.cdbs__textarea-placeholder { color: var(--cy-color-text-placeholder); }
.cdbs__primary {
  margin-top: 20rpx;
  padding: 30rpx 0;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-btn-solid-bg);
  color: var(--cy-btn-solid-fg);
  font-size: var(--cy-font-body);
  font-weight: 600;
  text-align: center;
}
.cdbs__primary.is-disabled { opacity: .45; }
.cdbs__to { display: flex; align-items: baseline; gap: 16rpx; padding-bottom: 12rpx; }
.cdbs__to-t { color: var(--cy-color-text-secondary); font-size: var(--cy-font-body); }
.cdbs__to-n { color: var(--cy-color-text-primary); font-size: var(--cy-font-display); font-weight: 800; font-variant-numeric: tabular-nums; }
.cdbs__strip { white-space: nowrap; }
.cdbs__strip-in { display: inline-flex; gap: 28rpx; padding: 12rpx 8rpx; }
.cdbs__p { flex: none; width: 128rpx; display: inline-flex; flex-direction: column; align-items: center; gap: 8rpx; }
.cdbs__av { position: relative; width: 112rpx; height: 112rpx; border-radius: var(--cy-radius-pill); display: flex; align-items: center; justify-content: center; background: var(--cy-color-bg-elevated); color: var(--cy-color-text-primary); font-size: var(--cy-font-subtitle); font-weight: 700; }
.cdbs__p--on .cdbs__av { box-shadow: 0 0 0 4rpx var(--cy-color-bg-surface), 0 0 0 8rpx var(--cy-btn-solid-bg); }
.cdbs__tick { position: absolute; right: -8rpx; bottom: -8rpx; width: 44rpx; height: 44rpx; box-sizing: border-box; border-radius: var(--cy-radius-pill); border: 4rpx solid var(--cy-color-bg-surface); background: var(--cy-btn-solid-bg); color: var(--cy-btn-solid-fg); display: flex; align-items: center; justify-content: center; }
.cdbs__tick::after { content: ""; width: 10rpx; height: 20rpx; margin-top: -4rpx; border: solid currentColor; border-width: 0 4rpx 4rpx 0; transform: rotate(45deg); }
.cdbs__pn { max-width: 128rpx; color: var(--cy-color-text-primary); font-size: var(--cy-font-label); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cdbs__ps { color: var(--cy-color-text-secondary); font-size: var(--cy-font-caption); white-space: nowrap; }
.cdbs__rows { margin-top: 20rpx; border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-elevated); overflow: hidden; }
.cdbs__row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 26rpx 28rpx; }
.cdbs__row + .cdbs__row { border-top: 1rpx solid var(--cy-color-border-subtle); }
.cdbs__row-m { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.cdbs__row-t { color: var(--cy-color-text-primary); font-size: var(--cy-font-body); }
.cdbs__row-s { color: var(--cy-color-text-secondary); font-size: var(--cy-font-caption); }
.cdbs__row-on { color: var(--cy-color-status-success); font-size: var(--cy-font-label); font-weight: 600; }
.cdbs__row-pick { color: var(--cy-color-text-primary); font-size: var(--cy-font-label); }

/* isolated 组件内全局 .cy-pressed 进不来,按仓库既有组件做法本地定义一份 */
.cy-pressed { opacity: .88; }

.form-required { color: var(--cy-color-status-danger); margin-left: var(--cy-space-1); }

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.cdbs__p { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
.cdbs__row { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
.cdbs__primary { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
