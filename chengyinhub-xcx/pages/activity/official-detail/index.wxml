<view class="theme-merchant od-root">
  <view wx:if="{{commandRecovery.state || commandRecovery.busy}}" class="od-card" aria-role="status">
    <text>{{commandRecovery.label}}</text>
    <text>{{commandRecovery.message}}</text>
    <text wx:if="{{commandRecovery.requestId}}">原请求号：{{commandRecovery.requestId}}</text>
    <block wx:if="{{commandRecovery.state === 'UNKNOWN'}}">
      <cy-btn disabled="{{commandRecovery.busy}}" bindtap="queryCommand">查询原请求</cy-btn>
      <cy-btn disabled="{{commandRecovery.busy}}" bindtap="retryCommand">按原输入重试</cy-btn>
      <cy-btn disabled="{{commandRecovery.busy}}" bindtap="cancelCommand">终止尚未执行的请求</cy-btn>
      <text>终止只针对未执行的原请求；已经提交的业务不会撤销。</text>
    </block>
    <cy-btn wx:if="{{commandRecovery.state === 'APPLIED' || commandRecovery.state === 'REJECTED' || commandRecovery.state === 'CANCELLED'}}"
      bindtap="acknowledgeCommand">确认结果</cy-btn>
  </view>
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-privacy-gate show="{{privacyGateShow}}" bind:settled="onPrivacyGateSettled" />
  <cy-nav-bar overlay="{{!!e}}" scrolled="{{navScrolled}}" pill="{{!!e && !navScrolled}}" pillDark="{{!!e && !navScrolled}}" tint="{{(!e || navScrolled) ? 'dark' : 'light'}}" />

  <view class="od-page" wx:if="{{e}}">
    <text class="od-refresh-state" wx:if="{{loading}}" aria-role="status">正在更新活动详情…</text>
    <scroll-view scroll-y class="od-scroll" enhanced show-scrollbar="{{false}}" bindscroll="onScroll">
      <view class="od-hero">
        <image wx:if="{{e.coverImg}}" class="od-hero-image" src="{{e.coverImg}}" mode="aspectFill" />
        <view wx:else class="od-hero-placeholder"><cy-icon name="image" size="52" /></view>
        <view class="od-hero-scrim"></view>
        <view class="od-hero-meta">
          <text class="od-category">{{e._categoryText}}</text>
          <view class="od-organizer">
            <image class="od-organizer-logo" src="/images/cy_logo_mark.png" mode="aspectFill" />
            <text class="od-organizer-name">城瘾官方</text>
            <text class="od-organizer-role">发起</text>
          </view>
        </view>
      </view>

      <scroll-view scroll-x class="od-facts" enhanced show-scrollbar="{{false}}">
        <view class="od-facts-inner">
          <view class="od-fact">
            <text class="od-fact-label">参与</text>
            <text class="od-fact-value">{{e.participants != null ? e.participants : '—'}}</text>
            
          </view>
          <view class="od-fact" wx:if="{{e.signed}}">
            <text class="od-fact-label">我的进度</text>
            <text class="od-fact-value od-fact-value--compact">{{e._progressText}}</text>
            <text class="od-fact-sub">{{e._isV2 ? '有效任务' : '已完成'}}</text>
          </view>
          <view class="od-fact">
            <text class="od-fact-label">活动周期</text>
            <text class="od-fact-value od-fact-value--compact">{{e._durationText}}</text>
            
          </view>
          <view class="od-fact">
            <text class="od-fact-label">开放时间</text>
            <text class="od-fact-value od-fact-value--compact">{{e._dateRange}}</text>
            
          </view>
          <view class="od-fact">
            <text class="od-fact-label">活动范围</text>
            <text class="od-fact-value od-fact-value--compact">{{e._scopeText}}</text>
            <text class="od-fact-sub">{{countdown || e._statusText}}</text>
          </view>
          <view class="od-fact" wx:if="{{e._taskTotal}}">
            <text class="od-fact-label">活动任务</text>
            <text class="od-fact-value">{{e._taskTotal}}</text>
            
          </view>
        </view>
      </scroll-view>

      <view class="od-section od-overview">
        <text class="od-title">{{e.title}}</text>
        <text wx:if="{{e.subtitle || e.story}}" class="od-copy">{{e.subtitle || e.story}}</text>
        <view wx:if="{{e.city}}" class="od-location">
          <view class="od-location-copy">
            <text class="od-location-name">{{e.city}}</text>
            
          </view>
          <view class="od-location-map">
            <view class="od-map-line od-map-line--a"></view>
            <view class="od-map-line od-map-line--b"></view>
            <view class="od-map-pin"><cy-icon name="pin" size="32" /></view>
          </view>
        </view>
      </view>

      <!-- 集合与联系 / 到场签到(原型 B T-38 / T-39):放在页面内容里,不挂在根节点之外 -->
      <cy-event-attendance event-id="{{id}}" organizer="{{false}}" />

      <view wx:if="{{e._activityCards.length}}" class="od-section od-section--divided">
        <text class="od-heading">活动介绍</text>
        <scroll-view scroll-x class="od-card-scroll" enhanced show-scrollbar="{{false}}">
          <view class="od-card-row">
            <view wx:for="{{e._activityCards}}" wx:key="_key" class="od-activity-card {{item.complete ? 'is-complete' : ''}}"
                  aria-role="text" aria-label="{{item.title}}，{{item.description}}">
              <view class="od-activity-cover">
                <image wx:if="{{e.coverImg}}" src="{{e.coverImg}}" mode="aspectFill" />
                <view wx:else class="od-activity-cover-placeholder"><cy-icon name="flag" size="40" /></view>
                <text wx:if="{{item.complete}}" class="od-card-state">已验证</text>
              </view>
              <text class="od-card-title">{{item.title}}</text>
              <text class="od-card-sub">{{item.description}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{e._showStoryDetail}}" class="od-section od-section--divided">
        <text class="od-heading">详情信息</text>
        <text class="od-copy">{{e.story}}</text>
      </view>

      <view wx:if="{{e._isV2}}" class="od-section od-section--divided">
        <view class="od-section-head">
          <text class="od-heading">我的活动任务</text>
          <text class="od-eligible {{e.eligible ? 'is-ok' : ''}}">{{e._eligibleText}}</text>
        </view>
        <text wx:if="{{!e.signed}}" class="od-note">报名后的到达才计入活动</text>
        <text wx:if="{{e.paused}}" class="od-note od-note--danger">活动暂时暂停：{{e.pausedReason || '等待运营处理后恢复'}}</text>
        <cy-inline-error load-failure wx:if="{{boundTopicError}}" kind="data" title="绑定主题名称没读到" sub="{{boundTopicError}}" />
        <view wx:if="{{e.missions.length}}" class="od-task-list">
          <view wx:for="{{e.missions}}" wx:key="missionCode" class="od-task {{item.complete ? 'is-complete' : ''}}"
                bindtap="onMissionTap" data-code="{{item.missionCode}}" hover-class="cy-pressed" hover-stay-time="80"
                aria-role="button" aria-label="{{item._titleText}}，{{item._descText}}，{{item.complete ? '已验证' : item._supported ? (item.canVerifyArrival ? '去验证' : '自动同步') : '暂不支持'}}">
            <view class="od-task-index">
              <cy-icon wx:if="{{item.complete}}" name="check" size="28" />
              <text wx:else>{{index + 1}}</text>
            </view>
            <view class="od-task-copy">
              <text class="od-task-title">{{item._titleText}}</text>
              <text wx:if="{{item._topicName}}" class="od-task-sub">绑定主题：{{item._topicName}}</text>
              <text class="od-task-sub">{{item._descText}}</text>
            </view>
            <text class="od-task-action">{{item.complete ? '已验证' : item._supported ? (item.canVerifyArrival ? '去验证' : '自动同步') : '暂不支持'}}</text>
          </view>
        </view>
        <text wx:else class="od-note">暂无任务</text>
      </view>

      <view wx:if="{{e._board}}" class="od-section od-section--divided">
        <view class="od-section-head"><text class="od-heading">赛事榜单</text><text wx:if="{{e._board.chip}}" class="od-eligible">{{e._board.chip}}</text></view>
        <view wx:if="{{e._board.rows.length}}" class="od-task-list">
          <view wx:for="{{e._board.rows}}" wx:key="_key" class="od-task" aria-role="text" aria-label="第 {{item.rank || 0}} 名，{{item.name}}，{{item.value}}">
            <view class="od-task-index"><text>{{item.rank}}</text></view>
            <view class="od-task-copy"><text class="od-task-title">{{item.name}}</text></view>
            <text class="od-task-action">{{item.value}}</text>
          </view>
        </view>
        <text wx:else class="od-note">暂无成绩</text>
      </view>

      <view class="od-section od-section--divided">
        <text class="od-heading">活动奖励</text>
        <!-- F22:只展示后端 rewardJson 里真实配置的奖励;没有配置就如实说明,不摆默认承诺。 -->
        <view wx:if="{{rewards.length}}" class="od-reward-list">
          <view wx:for="{{rewards}}" wx:key="*this" class="od-reward-row">
            <text class="od-reward-name">{{item}}</text>
            <cy-icon name="gift" size="30" />
          </view>
        </view>
        <text wx:else class="od-note">未配置奖励</text>
      </view>

      <view wx:if="{{e.collective && e.collective.enabled}}" class="od-section od-section--divided">
        <view class="od-progress-head">
          <view>
            <text class="od-progress-value">{{e.collective.pct === 0 ? 0 : (e.collective.pct || '--')}}%</text>
            <text class="od-progress-label">全城已点亮</text>
          </view>
          <text class="od-progress-count">{{e.collective.current}} / {{e.collective.threshold}}</text>
        </view>
        <view class="od-progress-track"><view class="od-progress-fill" style="width:{{e.collective.pct || 0}}%"></view></view>
        <!-- F22:集体进度区始终保留;只有真的配置了合法集体券才承诺「达标发放」,否则如实说明不承诺。 -->
        <text class="od-progress-tip" wx:if="{{e._hasCollectiveReward}}">开启且集体达标、本人保持有效报名并完成全部任务后发放集体奖励</text>
        <text class="od-progress-tip" wx:else>未配置集体奖励</text>
      </view>

      <view wx:if="{{rewards.length}}" class="od-reward-tip">
        <cy-icon name="gift" size="28" />
        <view>
          <text>完成活动任务后按上方配置发放</text>
          <text>实际发放结果以活动结算为准</text>
        </view>
      </view>

      <view wx:if="{{(e._policyTitle && !e.signed) || signupBlocked}}" class="od-section od-section--divided">
        <text class="od-heading">安全须知</text>
        <cy-consent-check wx:if="{{e._policyTitle && !e.signed}}" checked="{{policyChecked}}" text="我已阅读并同意《{{e._policyTitle}}》" bind:change="onPolicyChange" />
        <text wx:if="{{signupBlocked}}" class="od-note">按平台规则，你暂时不能报名这一场。</text>
      </view>

      <!-- CL6-SLOT official-coorganizers:联合主办展示挂载位(主办 + 全部协办方)。
           待 CL6 分支 claude/cl6-official-coorganizers-20261015 合入、且公开详情读接口返回 parties 后,
           在此挂 <cy-official-coorganizers mode="section" parties="{{parties}}" />(index.json 同步登记)。
           当前 detail/eventBase 不返回 parties,不编造字段,故暂不渲染。 -->
      <!-- 主办入口:仅当服务端 publish-check 对当前账号放行(本场主办/协办)才出现,玩家看不到 -->
      <view wx:if="{{organizerEntry}}" class="od-section od-section--divided">
        <text class="od-heading">主办控制台</text>
        <text class="od-copy">你参与主办这场活动，可以在控制台里发布、暂停或恢复活动（只有本场有效主办能提交）。</text>
        <view class="od-organizer-entry" bindtap="openOrganizer" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="打开主办控制台">打开主办控制台</view>
      </view>
      <view class="od-bottom-space"></view>
    </scroll-view>

    <view class="od-cta-bar">
      <button class="od-share" open-type="share" aria-label="分享活动">
        <view class="od-share-visual"><cy-icon name="share" size="34" /></view>
      </button>
      <view wx:if="{{cta.type !== 'wait' && cta.type !== 'ended'}}" class="od-cta {{cta.type}}"
            bindtap="onCta" aria-role="button" aria-label="{{cta.text}}" hover-class="cy-pressed" hover-stay-time="80">{{cta.text}}</view>
      <view wx:else class="od-cta {{cta.type}}" aria-role="text">{{cta.text}}</view>
    </view>
  </view>

  <cy-skeleton wx:elif="{{loading}}" type="detail" />
  <view wx:else class="od-loading">
    <cy-state-shell fill size="lg" kind="{{loadErrKind}}"
                    title="{{loadErrTitle}}" sub="{{loadErrSub}}"
                    primary="{{loadErrAction}}" bind:primary="onLoadErrorAction" auto-back custom-back bind:back="onLoadErrorBack" />
  </view>
</view>

