@import '../../../style/merchant-light-scope.wxss';

.oo-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--cy-bg-page);
  color: var(--cy-text-title);
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.oo-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
  padding: 0 var(--cy-space-4);
  background: var(--cy-bg-page);
}
.oo-sync {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  color: var(--cy-text-secondary);
  font-size: var(--cy-font-caption);
}
.oo-sec { margin: var(--cy-space-5) 0 var(--cy-space-2); color: var(--cy-text-title); font-size: var(--cy-font-body); font-weight: 800; }
.oo-card {
  margin-bottom: var(--cy-space-3);
  padding: var(--cy-space-4);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-card);
}
.oo-head { margin-top: var(--cy-space-2); }
.oo-row { display: flex; justify-content: space-between; align-items: center; gap: var(--cy-space-2); }
.oo-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--cy-font-subtitle); font-weight: 700; }
.oo-meta, .oo-hint, .oo-item { display: block; margin-top: var(--cy-space-2); font-size: var(--cy-font-label); line-height: 1.5; word-break: break-all; }
.oo-meta { color: var(--cy-text-secondary); }
.oo-hint { color: var(--cy-text-tertiary); }
.oo-item { color: var(--cy-text-secondary); }
.oo-item--block { color: var(--cy-color-status-danger); }
.oo-btn { display: block; margin-top: var(--cy-space-3); }
.oo-result { margin-bottom: var(--cy-space-3); }
.oo-result-ok { padding: var(--cy-space-3); border-radius: var(--cy-radius-lg); background: var(--cy-color-status-success-soft); }
.oo-result-title { display: block; color: var(--cy-color-status-success); font-size: var(--cy-font-body); font-weight: 700; }
.oo-result-sub { display: block; margin-top: var(--cy-space-1); color: var(--cy-text-secondary); font-size: var(--cy-font-label); }
.oo-pause { margin-top: var(--cy-space-3); }
.oo-pause:first-child { margin-top: 0; }
.oo-pause-label { display: block; color: var(--cy-text-title); font-size: var(--cy-font-label); font-weight: 700; }
.oo-chips { display: flex; flex-wrap: wrap; gap: var(--cy-space-2); margin: var(--cy-space-2) 0; }
.oo-chip { min-height: var(--cy-btn-h); display: flex; align-items: center; padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--cy-bg-card-2); color: var(--cy-text-secondary); font-size: var(--cy-font-label); }
.oo-chip.is-on { background: var(--cy-text-title); color: var(--cy-bg-card); font-weight: 700; }
.oo-bottom { height: calc(var(--cy-space-8) + env(safe-area-inset-bottom)); }

page { --cy-comp-nav-bg: var(--cy-bg-page); }
