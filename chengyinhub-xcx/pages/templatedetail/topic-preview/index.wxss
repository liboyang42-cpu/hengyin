/* 主题模板预览 —— 1:1 照业主定稿 HTML 原型 v21(px × 2 = rpx;卡堆位移在 JS 里按 px 算)。 */
page { background: #000; } /* ds-ok 预览页固定纯黑底(原型 .px) */
.tp { position: relative; min-height: 100vh; background: #000; color: #F8F8F8; padding-bottom: calc(300rpx + env(safe-area-inset-bottom)); overflow: hidden; } /* ds-ok 原型 .px 纯黑底 */
.tp-glow { position: absolute; left: 0; right: 0; top: 0; height: 840rpx; pointer-events: none; background: radial-gradient(120% 70% at 50% 18%, var(--glow), rgba(0, 0, 0, 0) 70%); } /* ds-ok 封面取色光晕 */
.tp > view:not(.tp-glow) { position: relative; }

.tp-state { padding: 240rpx 32rpx 0; display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.tp-state__t { font-size: 28rpx; color: rgba(255, 255, 255, 0.62); } /* ds-ok 原型深色次级字 */
.tp-state__btn { height: 64rpx; padding: 0 36rpx; border-radius: 32rpx; background: rgba(255, 255, 255, 0.08); display: flex; align-items: center; font-size: 26rpx; font-weight: 600; } /* ds-ok 原型 .sbtn */
.tp-skel { width: 328rpx; height: 328rpx; border-radius: 32rpx; background: #1C1C1E; } /* ds-ok 卡位占位 */

/* ---- 卡堆 ---- */
.stk { position: relative; height: 528rpx; }
.kc { position: absolute; left: 50%; top: 92rpx; width: 328rpx; height: 328rpx; margin-left: -164rpx; border-radius: 32rpx; transition: transform .5s cubic-bezier(.3, .8, .3, 1), opacity .4s, filter .4s; } /* ds-ok 原型 .x10 .kc 164px 方卡 */
.stk--pre .kc { transform: translateY(20px) scale(.8) !important; opacity: 0 !important; transition: none !important; }
.kin { position: absolute; left: 0; top: 0; right: 0; bottom: 0; transform-style: preserve-3d; transition: transform .6s cubic-bezier(.3, .8, .3, 1); }
.kc--fl .kin { transform: rotateY(180deg); }
.fc, .bk { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 32rpx; overflow: hidden; -webkit-backface-visibility: hidden; backface-visibility: hidden; box-shadow: 0 32rpx 80rpx rgba(0, 0, 0, 0.55); } /* ds-ok 原型卡面阴影 */
.fc { background: #111; } /* ds-ok 原型 .x10 .fc */
.fc__img { width: 100%; height: 100%; display: block; }
.fc__err { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; font-size: var(--cy-font-caption); color: rgba(255, 255, 255, 0.45); } /* ds-ok 原型深色次级字 */
.fc__err-ic { width: 96rpx; height: 72rpx; }
.bk { transform: rotateY(180deg); background: #1C1C1E; border: 1rpx solid rgba(255, 255, 255, 0.14); padding: 26rpx 26rpx 22rpx; box-sizing: border-box; display: flex; flex-direction: column; } /* ds-ok 原型 .b13 卡背 */
.bk__t { font-size: 23rpx; line-height: 1.3; font-weight: 700; } /* ds-ok 原型 .b13>b 11.5px */
.bk__ol { margin-top: 20rpx; display: flex; flex-direction: column; gap: 14rpx; }
.bk__li { display: flex; gap: 14rpx; align-items: baseline; font-size: 20rpx; line-height: 1.35; color: rgba(255, 255, 255, 0.88); white-space: nowrap; overflow: hidden; } /* ds-ok 原型 .b13 li 10px */
.bk__no { font-weight: 700; color: rgba(255, 255, 255, 0.45); width: 14rpx; flex-shrink: 0; } /* ds-ok 原型序号色 */
.bk__tx { overflow: hidden; text-overflow: ellipsis; }
.bk__ft { margin-top: auto; display: flex; align-items: center; gap: 8rpx; font-size: 19rpx; color: rgba(255, 255, 255, 0.45); } /* ds-ok 原型 .b13 .ft 9.5px */
.bk__clock { width: 20rpx; height: 20rpx; }

/* ---- 标题 + ✓ 清单 ---- */
.tp-info { transition: opacity .4s; }
.tp-info--dim { opacity: .35; }
.tp-title { display: block; margin-top: 16rpx; padding: 0 40rpx; font-size: 52rpx; line-height: 1.15; font-weight: 800; letter-spacing: -0.01em; } /* ds-ok 原型 .x10 h2 26px */
.tp-ck { margin-top: 32rpx; padding: 0 40rpx; display: flex; flex-direction: column; gap: 20rpx; }
.tp-ck__li { display: flex; gap: 18rpx; align-items: center; font-size: 30rpx; } /* ds-ok 原型 .x10 .ck li 15px */
.tp-ck__ic { width: 32rpx; height: 32rpx; flex-shrink: 0; }

/* ---- 底部白色主按钮 + 光晕 ---- */
.tp-cta { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(56rpx + env(safe-area-inset-bottom)); z-index: 6; }
.tp-cta::before { content: ""; position: absolute; left: -32rpx; right: -32rpx; top: -80rpx; bottom: -200rpx; background: linear-gradient(180deg, rgba(0, 0, 0, 0), #000 55%); z-index: -2; } /* ds-ok 原型 .fab-bar.x 底部渐隐 */
.tp-cta__glow { position: absolute; left: 10%; right: 10%; top: -60rpx; height: 120rpx; border-radius: 50%; background: var(--glow); filter: blur(28px); z-index: -1; opacity: .9; }
.tp-cta__btn { height: 96rpx; border-radius: 999rpx; background: #F8F8F8; color: #0A0A0A; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 700; } /* ds-ok 原型 .btn.pri 白色主按钮 */
