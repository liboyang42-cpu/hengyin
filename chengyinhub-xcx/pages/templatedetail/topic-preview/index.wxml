<view class="tp {{ light ? 'tp--light theme-merchant' : 'theme-dark' }} {{ reducedMotion ? 'cy-motion-reduced' : '' }}" style="--glow: {{ glow }};">
  <cy-toast id="cy-toast" />
  <cy-modal-host id="cy-modal-host" />
  <view class="tp-glow" aria-hidden="true"></view>
  <cy-nav-bar overlay tint="{{ light ? 'dark' : 'light' }}" />

  <view wx:if="{{ loading }}" class="tp-state"><cy-skeleton type="detail" count="1" loading-label="正在加载主题模板" /></view>
  <view wx:elif="{{ errorMsg }}" class="tp-state">
    <text class="tp-state__t">{{ errorMsg }}</text>
    <view wx:if="{{ errorRefused }}" class="tp-state__btn" bindtap="goBack" aria-role="button" aria-label="返回" hover-class="cy-pressed" hover-stay-time="80">返回</view>
    <view wx:else class="tp-state__btn" bindtap="load" aria-role="button" aria-label="重试" hover-class="cy-pressed" hover-stay-time="80">重试</view>
  </view>
  <block wx:else>
    <!-- 扇形卡堆：左右滑切换，点最前面那张翻面 -->
    <view class="stk {{ entered ? '' : 'stk--pre' }}" style="margin-top: {{ navTop }}px;" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
      <view class="kc {{ item.flipped ? 'kc--fl' : '' }}" wx:for="{{ cards }}" wx:key="index" data-index="{{ index }}" bindtap="tapCard" hover-class="cy-pressed" hover-stay-time="80"
        style="{{ item.style }} {{ settled ? '' : 'transition-delay: ' + item.delay + 's;' }}"
        aria-role="button" aria-label="{{ item.cover ? name : item.title }}{{ item.front ? '，点按翻面' : '' }}">
        <view class="kin">
          <view class="fc">
            <image wx:if="{{ cover }}" class="fc__img" src="{{ cover }}" mode="aspectFill" style="{{ item.imgStyle }}" binderror="onCoverError" />
            <view wx:else class="fc__err cy-cover-fb" aria-role="img" aria-label="{{ name }} 暂无封面"><image class="fc__err-ic" src="/images/cover-route.svg" mode="aspectFit" /></view>
          </view>
          <view class="bk">
            <text class="bk__t">{{ item.title }}</text>
            <view class="bk__ol">
              <view class="bk__li" wx:for="{{ item.steps }}" wx:for-item="step" wx:for-index="si" wx:key="si">
                <text class="bk__no">{{ step === '…' ? '' : si + 1 }}</text><text class="bk__tx">{{ step }}</text>
              </view>
            </view>
            <view class="bk__ft" wx:if="{{ item.foot }}"><image class="bk__clock" src="/pages/templatedetail/art/tab/clock.svg" mode="aspectFit" />{{ item.foot }}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="tp-info {{ cards[sel] && flip ? 'tp-info--dim' : '' }}">
      <text class="tp-title cy-rise-in" style="animation-delay: .25s;">{{ name }}</text>
      <view class="tp-ck">
        <view class="tp-ck__li cy-rise-in" wx:for="{{ checks }}" wx:key="index" style="animation-delay: {{ 0.35 + index * 0.08 }}s;">
          <image class="tp-ck__ic" src="/pages/templatedetail/art/tab/check.svg" mode="aspectFit" /><text>{{ item }}</text>
        </view>
      </view>
      <view class="tp-intro" wx:if="{{ intro.desc || intro.chapters.length }}">
        <text class="tp-intro__d" wx:if="{{ intro.desc }}">{{ intro.desc }}</text>
        <view class="tp-intro__ch" wx:for="{{ intro.chapters }}" wx:key="key">
          <text class="tp-intro__t">{{ item.name }}</text>
          <text class="tp-intro__g" wx:if="{{ item.guide }}">{{ item.guide }}</text>
        </view>
      </view>
    </view>

    <view class="tp-cta">
      <view class="tp-cta__glow" aria-hidden="true"></view>
      <view class="tp-cta__row">
        <view class="tp-cta__btn tp-cta__btn--sec cy-rise-in" style="animation-delay: .6s;" bindtap="goDetail" aria-role="button" aria-label="查看详情" hover-class="cy-pressed" hover-stay-time="80">查看详情</view>
        <view class="tp-cta__btn tp-cta__btn--pri cy-rise-in" style="animation-delay: .6s;" bindtap="useTemplate" aria-role="button" aria-label="用这个模板" hover-class="cy-pressed" hover-stay-time="80">用这个模板</view>
      </view>
    </view>
  </block>
</view>
