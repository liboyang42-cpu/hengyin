/* 模板页货架 —— 1:1 照业主定稿 HTML 原型 v21(px × 2 = rpx)。
   玩家态深色;商家态(light)只换颜色变量，版式不变。 */
.shelf {
  --sh-bg: #0B0B0D; /* ds-ok 业主定稿原型 v21 原值 */
  --sh-fg: #F8F8F8; /* ds-ok 业主定稿原型 v21 原值 */
  --sh-fg2: rgba(255, 255, 255, 0.55); /* ds-ok 业主定稿原型 v21 原值 */
  --sh-fg3: rgba(255, 255, 255, 0.45); /* ds-ok 业主定稿原型 v21 原值 */
  --sh-fill: rgba(255, 255, 255, 0.08); /* ds-ok 业主定稿原型 v21 原值 */
  --sh-card: #17171a; /* ds-ok 业主定稿原型 v21 原值 */
  --sh-tile: #1C1C1E; /* ds-ok 业主定稿原型 v21 原值 */
  --sh-line: rgba(255, 255, 255, 0.1); /* ds-ok 业主定稿原型 v21 原值 */
  --sh-tag-on-bg: #F8F8F8; /* ds-ok 业主定稿原型 v21 原值 */
  --sh-tag-on-fg: #0A0A0A; /* ds-ok 业主定稿原型 v21 原值 */
  position: relative;
  min-height: 100%;
  color: var(--sh-fg);
  padding-bottom: 40rpx;
}
.shelf--light {
  --sh-fg: #111114; /* ds-ok 业主定稿原型 v21 原值 */
  --sh-fg2: rgba(17, 17, 20, 0.55); /* ds-ok 业主定稿原型 v21 原值 */
  --sh-fg3: rgba(17, 17, 20, 0.45); /* ds-ok 业主定稿原型 v21 原值 */
  --sh-fill: rgba(17, 17, 20, 0.06); /* ds-ok 业主定稿原型 v21 原值 */
  --sh-card: #E9E9EE; /* ds-ok 业主定稿原型 v21 原值 */
  --sh-tile: #F2F2F5; /* ds-ok 业主定稿原型 v21 原值 */
  --sh-line: rgba(17, 17, 20, 0.1); /* ds-ok 业主定稿原型 v21 原值 */
  --sh-tag-on-bg: #111114; /* ds-ok 业主定稿原型 v21 原值 */
  --sh-tag-on-fg: #FFFFFF; /* ds-ok 业主定稿原型 v21 原值 */
}
/* isolated 规则同 cy-modal:组件内本地补一份按压类(与 style/components.wxss 同值) */
.cy-pressed { opacity: .88; transform: scale(.98); transition: transform var(--cy-motion-press) var(--cy-ease-out), opacity var(--cy-motion-press) var(--cy-ease-out); }
.cy-motion-reduced .cy-pressed { transform: none; }
.sh-glow {
  position: absolute; left: 0; right: 0; top: -400rpx; height: 1340rpx; pointer-events: none; z-index: 0;
  background: radial-gradient(130% 75% at 50% 30%, var(--glow) 0, rgba(0, 0, 0, 0) 72%); /* ds-ok 业主定稿原型 v21 原值 */
  transition: background 0.6s ease;
}

/* ---- 立体图标 tab(cy-tabs variant=icon)+ 搜索 ---- */
.sh-top { position: relative; z-index: 1; display: flex; align-items: center; gap: 28rpx; padding: 8rpx 32rpx 0; }
.sh-search { flex: 1; min-width: 0; height: 88rpx; margin-bottom: 6rpx; display: flex; align-items: center; } /* 整行 88rpx 触控高度，可见药丸 68rpx */
.sh-search__pill { flex: 1; min-width: 0; height: 68rpx; padding: 0 24rpx; border-radius: 999rpx; background: var(--sh-fill); display: flex; align-items: center; gap: 16rpx; } /* ds-ok 原型 .swl .pill 34px */
.sh-search__ic { width: 32rpx; height: 32rpx; opacity: 0.6; flex-shrink: 0; }
.shelf:not(.shelf--light) .sh-search__ic { filter: invert(1); }
.sh-search__ph { font-size: 24rpx; color: var(--sh-fg3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */

/* ---- 状态 ---- */
.sh-state { position: relative; z-index: 1; display: block; min-height: 480rpx; }

/* ---- 横滑容器 ---- */
.sh-rail { position: relative; z-index: 1; width: 100%; white-space: nowrap; }
.sh-rail__in { display: inline-flex; gap: 20rpx; padding: 24rpx 32rpx 8rpx; }
.sh-rail__in--g { gap: 20rpx; }
.sh-rail__in--rows { gap: 24rpx; }

/* ---- 主题精选大卡(横版) ---- */
.lc { flex: 0 0 622rpx; width: 622rpx; height: 368rpx; border-radius: 40rpx; overflow: hidden; position: relative; background: var(--sh-card); white-space: normal; } /* ds-ok 业主定稿原型 v21 原值 */
.lc__img { width: 100%; height: 100%; display: block; }
.lc__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 88rpx 28rpx 24rpx; background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.78)); display: flex; flex-direction: column; } /* ds-ok 业主定稿原型 v21 原值 */
.lc__type { font-size: 22rpx; font-weight: 600; letter-spacing: 0.02em; } /* ds-ok 业主定稿原型 v21 原值 */
.lc__type--city { color: #CBB8FF; } /* ds-ok 业主定稿原型 v21 原值 */
.lc__type--free { color: #8BE6C4; } /* ds-ok 业主定稿原型 v21 原值 */
.lc__name { font-size: 36rpx; font-weight: 700; margin-top: 4rpx; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */
.lc__meta { font-size: 24rpx; color: rgba(255, 255, 255, 0.75); margin-top: 4rpx; } /* ds-ok 业主定稿原型 v21 原值 */
.sh-dots { position: relative; z-index: 1; display: flex; justify-content: center; gap: 12rpx; padding-top: 20rpx; }
.sh-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background: rgba(128, 128, 128, 0.4); transition: background 0.25s; } /* ds-ok 业主定稿原型 v21 原值 */
.sh-dot--on { width: 32rpx; background: var(--sh-fg); opacity: 0.85; }

/* ---- 标签(图标与文字隔约 4 个空格) ---- */
.sh-tags { position: relative; z-index: 1; width: 100%; white-space: nowrap; }
.sh-tags__in { display: inline-flex; gap: 12rpx; padding: 32rpx 32rpx 4rpx; }
.tg { flex-shrink: 0; height: 60rpx; padding: 0 26rpx; border-radius: 30rpx; display: inline-flex; align-items: center; font-size: 26rpx; font-weight: 500; color: var(--sh-fg); opacity: 0.92; background: var(--sh-fill); } /* ds-ok 业主定稿原型 v21 原值 */
.tg--on { background: var(--sh-tag-on-bg); color: var(--sh-tag-on-fg); font-weight: 600; opacity: 1; }
.tg__ic { width: 52rpx; height: 52rpx; margin: -8rpx 36rpx -8rpx -16rpx; flex-shrink: 0; }

/* ---- 货架 ---- */
.sh-body { position: relative; z-index: 1; }
.sh5 { display: flex; align-items: center; gap: 4rpx; padding: 44rpx 32rpx 0; font-size: 38rpx; font-weight: 700; } /* ds-ok 业主定稿原型 v21 原值 */
.sh5__chev { width: 34rpx; height: 34rpx; }

/* 全部主题:3 行一列 */
.col3 { flex: 0 0 622rpx; width: 622rpx; display: flex; flex-direction: column; white-space: normal; }
.r5 { display: flex; align-items: center; gap: 24rpx; padding: 14rpx 0; }
.r5__pic { width: 208rpx; height: 128rpx; border-radius: 24rpx; flex-shrink: 0; background: var(--sh-card); } /* ds-ok 业主定稿原型 v21 原值 */
.r5__tx { flex: 1; min-width: 0; align-self: stretch; display: flex; flex-direction: column; justify-content: center; border-bottom: 1rpx solid var(--sh-line); padding-bottom: 14rpx; margin-bottom: -14rpx; }
.r5:last-child .r5__tx { border-bottom: none; }
.r5__name { font-size: 29rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */
.r5__sub { font-size: 25rpx; color: var(--sh-fg3); margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */
.r5__meta { font-size: 22rpx; color: var(--sh-fg3); margin-top: 8rpx; display: flex; gap: 12rpx; align-items: center; white-space: nowrap; } /* ds-ok 业主定稿原型 v21 原值 */
.tb { font-size: 21rpx; font-weight: 700; padding: 4rpx 12rpx; border-radius: 10rpx; line-height: 1.2; } /* ds-ok 业主定稿原型 v21 原值 */
.tb--city { background: rgba(183, 155, 255, 0.16); color: #A68BFF; } /* ds-ok 业主定稿原型 v21 原值 */
.tb--free { background: rgba(111, 216, 176, 0.14); color: #3FBF8E; } /* ds-ok 业主定稿原型 v21 原值 */
.shelf:not(.shelf--light) .tb--city { color: #C9B5FF; } /* ds-ok 业主定稿原型 v21 原值 */
.shelf:not(.shelf--light) .tb--free { color: #7FE0BB; } /* ds-ok 业主定稿原型 v21 原值 */

/* 其它主题货架:中卡 */
.mc { flex: 0 0 424rpx; width: 424rpx; white-space: normal; }
.mc__pic { width: 424rpx; height: 238rpx; border-radius: 28rpx; display: block; background: var(--sh-card); } /* ds-ok 业主定稿原型 v21 原值 */
.mc__name { display: block; font-size: 28rpx; font-weight: 600; margin-top: 16rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */
.mc__meta { display: block; font-size: 23rpx; color: var(--sh-fg3); margin-top: 4rpx; } /* ds-ok 业主定稿原型 v21 原值 */

/* ---- 分类页(主题)---- */
.ch9 { display: flex; align-items: center; gap: 24rpx; padding: 32rpx 32rpx 12rpx; }
.ch9__ic { width: 128rpx; height: 128rpx; padding: 12rpx; box-sizing: border-box; border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0)); } /* ds-ok 业主定稿原型 v21 原值 */
.ch9__t { font-size: 44rpx; font-weight: 700; letter-spacing: -0.01em; } /* ds-ok 业主定稿原型 v21 原值 */
.tci { margin: 32rpx 32rpx 0; display: block; }
.tci__pic { width: 100%; height: 386rpx; border-radius: 32rpx; display: block; background: var(--sh-card); } /* ds-ok 业主定稿原型 v21 原值 */
.tci__tx { padding: 20rpx 4rpx 28rpx; border-bottom: 1rpx solid var(--sh-line); display: flex; flex-direction: column; }
.tci__type { font-size: 23rpx; font-weight: 600; } /* ds-ok 业主定稿原型 v21 原值 */
.tci__type--city { color: #A68BFF; } /* ds-ok 业主定稿原型 v21 原值 */
.tci__type--free { color: #3FBF8E; } /* ds-ok 业主定稿原型 v21 原值 */
.shelf:not(.shelf--light) .tci__type--city { color: #CBB8FF; } /* ds-ok 业主定稿原型 v21 原值 */
.shelf:not(.shelf--light) .tci__type--free { color: #8BE6C4; } /* ds-ok 业主定稿原型 v21 原值 */
.tci__name { font-size: 36rpx; font-weight: 700; margin-top: 6rpx; } /* ds-ok 业主定稿原型 v21 原值 */
.tci__sub { font-size: 26rpx; color: var(--sh-fg2); margin-top: 4rpx; } /* ds-ok 业主定稿原型 v21 原值 */
.tci__desc { margin-top: 12rpx; font-size: 26rpx; line-height: 1.55; color: var(--sh-fg3); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; } /* ds-ok 业主定稿原型 v21 原值 */

/* ---- 玩法精选大卡 = App Store 游戏卡 ---- */
.ap { flex: 0 0 636rpx; width: 636rpx; white-space: normal; }
.ap__eyebrow { display: block; font-size: 24rpx; font-weight: 600; } /* ds-ok 业主定稿原型 v21 原值 */
.ap__blurb { margin-top: 4rpx; font-size: 40rpx; line-height: 1.25; height: 2.5em; color: var(--sh-fg2); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; } /* ds-ok 业主定稿原型 v21 原值 */
.ap__lead { color: var(--sh-fg); }
.ap__card { margin-top: 20rpx; height: 408rpx; border-radius: 32rpx; position: relative; overflow: hidden; background: var(--sh-tile); } /* ds-ok 业主定稿原型 v21 原值 */
.ap__cover { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; }
.ap__blur, .ap__tint { position: absolute; left: 0; right: 0; bottom: 0; height: 46%; z-index: 1; pointer-events: none; }
.ap__blur--1 { -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%); mask-image: linear-gradient(to bottom, transparent, #000 30%); } /* ds-ok 业主定稿原型 v21 原值 */
.ap__blur--2 { -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); -webkit-mask-image: linear-gradient(to bottom, transparent 20%, #000 60%); mask-image: linear-gradient(to bottom, transparent 20%, #000 60%); } /* ds-ok 业主定稿原型 v21 原值 */
.ap__blur--3 { -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); -webkit-mask-image: linear-gradient(to bottom, transparent 45%, #000 85%); mask-image: linear-gradient(to bottom, transparent 45%, #000 85%); } /* ds-ok 业主定稿原型 v21 原值 */
.ap__tint { background: linear-gradient(to bottom, rgba(0, 0, 0, 0), var(--tint-mid) 45%, var(--tint-end)); } /* ds-ok 业主定稿原型 v21 原值 */
.ap__bar { position: absolute; left: 0; right: 0; bottom: 0; height: 124rpx; z-index: 2; display: flex; align-items: center; gap: 20rpx; padding: 0 24rpx; color: #fff; } /* ds-ok 业主定稿原型 v21 原值 */
.ap__icon { width: 80rpx; height: 80rpx; flex-shrink: 0; }
.ap__tx { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ap__name { font-size: 28rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */
.ap__short { font-size: 24rpx; color: rgba(255, 255, 255, 0.75); margin-top: 2rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */
.ap__pill { flex-shrink: 0; height: 56rpx; padding: 0 36rpx; border-radius: 28rpx; display: flex; align-items: center; font-size: 28rpx; font-weight: 700; color: #007AFF; background: rgba(235, 235, 245, 0.92); } /* ds-ok 业主定稿原型 v21 原值 */

/* 到店互动 / 小队协作 / 城市探索:3 行一列，无分隔线，右侧露出下一列 */
.col3--g { flex: 0 0 580rpx; width: 580rpx; min-width: 0; overflow: hidden; }
.r16 { display: flex; align-items: center; gap: 24rpx; padding: 14rpx 0; }
.r16__ic { width: 120rpx; height: 120rpx; padding: 8rpx; box-sizing: border-box; border-radius: 50%; flex-shrink: 0; background: radial-gradient(closest-side, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0)); } /* ds-ok 业主定稿原型 v21 原值 */
.r16__tx { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.r16__name { font-size: 30rpx; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */
.r16__short { font-size: 26rpx; color: var(--sh-fg2); margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */

/* 分类页(玩法):方块两列 */
.gg { display: grid; grid-template-columns: 1fr 1fr; gap: 36rpx 24rpx; padding: 28rpx 32rpx 0; }
.gg__it { min-width: 0; display: flex; flex-direction: column; }
.gg__im { width: 100%; padding-top: 100%; position: relative; border-radius: 28rpx; overflow: hidden; background: var(--sh-tile); } /* ds-ok 业主定稿原型 v21 原值 */
.gg__cover { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.gg__prop { position: absolute; left: 19%; top: 19%; width: 62%; height: 62%; }
.gg__name { font-size: 30rpx; font-weight: 600; margin-top: 16rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 业主定稿原型 v21 原值 */
.gg__short { font-size: 25rpx; color: var(--sh-fg2); margin-top: 4rpx; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; } /* ds-ok 业主定稿原型 v21 原值 */

/* 远端封面拉不动(不在包内的主题):复用全仓既有失败态 no_data.svg +「封面暂不可用」,不拿别的图冒充 */
.cv-err { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: var(--sh-fg3); background: var(--sh-card); }
.cv-err__ic { width: 96rpx; height: 72rpx; }
.cv-err__t { font-size: var(--cy-font-caption); }

/* 「全部分类」入口与半屏：组标题 + 自动换行的同款标签 */
.tg--more { color: var(--sh-fg2); }
.at { padding: 8rpx 0 24rpx; }
.at__grp { padding-top: 20rpx; }
.at__hd { display: block; font-size: var(--cy-font-caption); font-weight: 600; color: var(--cy-text-secondary); padding-bottom: 16rpx; }
.at__tags { display: flex; flex-wrap: wrap; gap: 16rpx 12rpx; }
.at .tg { color: var(--cy-text-title); background: var(--cy-bg-card-2); }
.at .tg--on { background: var(--cy-text-title); color: var(--cy-bg-page); }
