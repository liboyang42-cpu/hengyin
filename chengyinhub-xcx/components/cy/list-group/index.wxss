.lg__hd {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--cy-space-2);
  padding: 44rpx var(--cy-space-4) 14rpx;
  font-size: var(--cy-type-label);
  line-height: 1.3;
  color: var(--cy-color-text-tertiary);
}
.lg__act { font-size: var(--cy-type-body); font-weight: 600; color: var(--cy-color-text-primary); }
.lg--gap { margin-top: 44rpx; }
.lg__box { background: var(--cy-color-bg-surface); border-radius: var(--cy-radius-lg); overflow: hidden; }
