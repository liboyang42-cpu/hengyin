:host {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

/* Figma 297:1827 帖文卡 · 换算 1pt = 2rpx。
 * 四 variant 共用这一层壳,差异只有两处几何:
 *   --pc-avatar 头像/首列宽 —— Image / Text 44pt(带关注角标),Roam / Template 40pt
 *   --pc-gap    块间距     —— 通用 12pt,Roam 14pt
 * ⚠️ 首列宽必须与 .post-card__avatar 同值,所以两处都读 --pc-avatar,别再各写一份字面值。 */
/* 2026-10-22 新稿(俱乐部页重做 211:271/326/354):不再是「头像一列 + 内容一列」的两栏网格 ——
 * 头像只属于头部那一行(头像 · 名字/时间 · 更多),正文、图廊、模板封面、动作行都占满卡片整宽。
 * 头像改成绝对定位压在头部行首,头部给它让出 头像宽 + 10pt;wxml 结构不动。 */
.post-card {
  /* 帖文第三轮(业主定稿 P-1 = Threads 版):头像 36pt 单独占左栏,昵称、正文、图、分享卡、动作行都缩进到头像右侧 */
  --pc-avatar: 72rpx;                 /* 36pt */
  --pc-rail: calc(var(--pc-avatar) + var(--cy-space-3));   /* 左栏 = 头像 + 12pt */
  --pc-gap: var(--cy-space-2);        /* 8pt */
  position: relative;
  display: block;
  padding: var(--cy-space-3) var(--cy-page-x) var(--cy-space-1-5);   /* 上 12pt / 下 6pt / 左右 16pt */
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--cy-color-border-subtle);
}
/* Roam(isCompletionShare)/ Template(hasPlayCover):头像 40pt */
/* 帖文第三轮:四种帖文同一条左栏,不再按 variant 换头像大小 */

/* 转发条目:头像上方一行「某某 转发了」,头像随之下移这一行的高度 */
.post-card__repost-by {
  margin-bottom: var(--cy-space-2);
  overflow: hidden;
  font-size: var(--cy-font-label);
  line-height: var(--cy-space-4);
  color: var(--cy-color-text-tertiary);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.post-card--repost .post-card__avatar { top: calc(var(--cy-space-3) + var(--cy-space-4) + var(--cy-space-2)); }

.post-card__avatar {
  position: absolute;
  left: var(--cy-page-x);
  top: var(--cy-space-3);             /* 与卡片上内边距对齐 */
  z-index: 1;
  width: var(--pc-avatar);
  height: var(--pc-avatar);
}

.post-card__avatar-img {
  width: 100%;
  height: 100%;
  border: 3rpx solid var(--cy-color-border-strong);
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--cy-color-bg-elevated);
}

/* 2026-10-29 V-08:必须两级选择器(0,2,0)。微信内置 wx-button:not([size=mini]) { width:184px } 是 (0,1,1),
   单写 .post-card__follow 时角标被顶成 184px 宽的白色椭圆,从头像左下方伸出去(业主:头像下面的白色月牙)。 */
.post-card__avatar .post-card__follow {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 36rpx;
  height: 36rpx;
  min-height: 0;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: var(--cy-btn-solid-bg);
  color: var(--cy-btn-solid-fg);
  border: 4rpx solid var(--cy-color-bg-page);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--cy-motion-press) var(--cy-ease-out), background-color 200ms ease;
}
/* 点了变成勾(弹一下),0.9 秒后收起 */
.post-card__avatar .post-card__follow.is-done { background: var(--cy-color-status-success); animation: pc-like-pop 400ms var(--cy-ease-spring) both; }
.post-card--reduced .post-card__avatar .post-card__follow.is-done { animation: none; }

.post-card__avatar .post-card__follow::after {
  content: '';
  position: absolute;
  left: -28rpx;
  top: -28rpx;
  width: 88rpx;
  height: 88rpx;
  border: none;
}

.post-card__follow-icon { color: currentColor; }
.post-card__main { min-width: 0; padding-left: var(--pc-rail); }
/* 稿:Header 垂直居中。首列的头像比 who 竖排高,所以这里跟着头像撑到同高,昵称才真的压在头像中线上。 */
.post-card__head {
  display: flex;
  align-items: center;
  min-height: 40rpx;                  /* 昵称一行,与头像上沿对齐 */
  margin-bottom: 2rpx;
}
.post-card__identity { flex: 1; min-width: 0; }
.post-card__name { display: flex; align-items: center; min-width: 0; gap: var(--cy-space-1); }
.post-card__nick {
  min-width: 0;
  overflow: hidden;
  flex-shrink: 1;
  font-size: var(--cy-font-subtitle);   /* 32rpx = 16pt */
  font-weight: 500;                     /* 稿 Medium(原 Bold) */
  color: var(--cy-color-text-primary);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.post-card__verified { width: var(--cy-space-3); height: var(--cy-space-3); flex: none; }
.post-card__badge {
  flex: none;
  padding: 0 var(--cy-space-1-5);
  border: 2rpx solid var(--cy-info);
  border-radius: var(--cy-radius-pill);
  color: var(--cy-info);
  font-size: var(--cy-font-caption);
  font-weight: 700;
  line-height: var(--cy-space-4);
  white-space: nowrap;
}
.post-card__badge--notice { border-color: var(--cy-color-status-warning); color: var(--cy-color-status-warning); }
.post-card__meta {
  margin-top: 6rpx;                     /* Who 竖排间距 3pt */
  overflow: hidden;
  font-size: var(--cy-font-label);      /* 24rpx = 12pt */
  color: var(--cy-color-text-tertiary);
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* .post-card--light 的三条覆盖与 light 属性本身都已删:原先基态写死白字、靠 light 档换回 token,
 * 现在基态直接读 --cy-color-text-primary/-tertiary,两档同值 ⇒ 覆盖变成纯噪声。
 * light 属性与类名保留,后续真出现浅色卡面时在这里挂新规则。 */
.post-card__club--interactive { text-decoration: underline; text-underline-offset: 4rpx; }
.post-card__more {
  flex: none;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -24rpx calc(-1 * var(--cy-space-3)) -24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-color-text-secondary);
}
.post-card__audit {
  display: inline-block;
  margin-bottom: var(--pc-gap);
  padding: var(--cy-space-1) var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-danger-soft);
  color: var(--cy-danger);
  font-size: var(--cy-font-label);
}
.post-card__body { margin-bottom: var(--pc-gap); }
.post-card__text {
  display: -webkit-box;
  margin: 0;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;               /* 帖文第三轮:最多 6 行,超出才「展开」 */
  white-space: pre-wrap;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-subtitle);   /* 30rpx 一档(15pt) */
  /* 稿行高 22pt @ 字号 14pt。写比例不写 44rpx —— 用户把微信字号调大时 --cy-type-scale 会放大
   * font-size,固定 rpx 行高会把第二行切掉。 */
  line-height: 1.571;
}
.post-card__text--expanded { display: block; overflow: visible; -webkit-line-clamp: unset; white-space: pre-wrap; }
.post-card__link { color: var(--cy-info); }
.post-card__expand {
  display: block;
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-label);      /* 24rpx = 12pt */
  font-weight: 500;
  color: var(--cy-color-text-secondary);
}
.post-card__body { margin-bottom: 0; }
/* 单图:按原比例放在正文列里,竖图最高 420pt 截掉下半 */
.post-card__one { position: relative; margin-top: var(--pc-gap); max-width: 100%; max-height: 840rpx; overflow: hidden; border-radius: var(--cy-radius-sm); }
.post-card__one-img { display: block; width: 100%; border-radius: var(--cy-radius-sm); background: var(--cy-color-bg-surface-subtle); }
/* 多图:等高横滑,能滑过头像那一栏到屏幕两边;不出「1/3」,下一张总露出一截 */
.post-card__strip-wrap { position: relative; margin: var(--pc-gap) calc(-1 * var(--cy-page-x)) 0 calc(-1 * (var(--pc-rail) + var(--cy-page-x))); }
.post-card__strip { width: 100%; white-space: nowrap; }
.post-card__strip-row { display: inline-flex; gap: var(--cy-space-1-5); padding: 0 var(--cy-page-x) 0 calc(var(--pc-rail) + var(--cy-page-x)); }
.post-card__strip-pic { flex: none; height: 464rpx; min-width: 200rpx; max-width: 560rpx; border-radius: var(--cy-radius-sm); background: var(--cy-color-bg-surface-subtle); }
.post-card__strip-map { width: 560rpx; }
/* 双击点赞:图片中间飘出一颗大心 */
/* 双击点赞:图片中间飘出一颗大心(两段过渡:弹出 → 上飘淡出;不用 keyframes,快速连点不抖) */
.post-card__bigheart { position: absolute; left: 50%; top: 50%; width: 168rpx; height: 168rpx; margin: -84rpx 0 0 -84rpx; color: #ffffff; /* ds-ok: 压在照片上的常量白心 */
  pointer-events: none; filter: drop-shadow(0 8rpx 28rpx rgba(0, 0, 0, .4)); opacity: 0; transform: scale(0); }
.post-card__bigheart.is-in { opacity: 1; transform: scale(1); transition: transform 260ms var(--cy-ease-spring), opacity 120ms ease; }
.post-card__bigheart.is-out { opacity: 0; transform: scale(1.1) translateY(-40rpx); transition: transform 260ms ease-out, opacity 260ms ease-out; }
/* 分享出来的内容自成一张卡:带边框,卡顶一行类型 */
.post-card__ref { margin-top: var(--cy-space-2-5); padding: var(--cy-space-3); border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-surface); }
.post-card__ref-label { display: flex; align-items: center; gap: var(--cy-space-1-5); margin-bottom: var(--cy-space-2); font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-color-text-secondary); }
.post-card__actions { display: flex; align-items: center; min-height: 88rpx; margin-left: -18rpx; }
/* 帖文第三轮:赞、评论、转发、分享四个图标靠左排,分享不再甩到最右边 */
.post-card__actions-left { display: flex; align-items: center; min-width: 0; gap: 0; }
.post-card__action {
  min-width: 88rpx;                     /* 44pt 触达区不缩(club-feed-actions-hit-targets) */
  min-height: 88rpx;
  padding: 0 18rpx;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;                            /* 图标 ↔ 数字 4pt */
  border-radius: var(--cy-radius-pill);
  border: 0;
  background: transparent;
  line-height: 1;
  color: var(--cy-color-text-primary);
}
.post-card__action::after { border: none; }
.post-card__action--like.is-on { color: var(--cy-color-status-danger); }
.post-card__action--repost.is-on { color: var(--cy-color-status-success); }
.post-card__repost-icon { flex: none; color: currentColor; }
/* 描边 heart = 未赞(继承 .post-card__action 的 primary),实心 heart-filled = 已赞
 * (由 .post-card__action--like.is-on 上色 --cy-color-status-danger,计数文字同色)。
 * 原先是一张自带红的位图 SVG,靠去色滤镜压成「灰实心心」,读起来像已赞,已废弃。 */
.post-card__heart { flex: none; color: currentColor; }
/* 2026-10-22 owner「简单必要的动效」:点亮那一下心形弹起再落位(过冲弹性);进页时已赞的不播 */
.post-card__action--like.is-pop .post-card__heart { animation: pc-like-pop 420ms var(--cy-ease-spring) both; }
@keyframes pc-like-pop {
  0% { transform: scale(1); }
  35% { transform: scale(1.32); }
  100% { transform: scale(1); }
}
.post-card--reduced .post-card__heart { animation: none; }
/* 点亮时六个小点散开 + 数字滚一格(两段过渡,不用 keyframes) */
.post-card__heart-wrap { position: relative; display: flex; }
.post-card__burst { position: absolute; left: 50%; top: 50%; width: 0; height: 0; pointer-events: none; }
.post-card__burst-dot { position: absolute; left: -4rpx; top: -4rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--cy-color-status-danger); opacity: 0; transform: rotate(var(--a)) translateY(-12rpx); }
.post-card__burst.is-start .post-card__burst-dot { opacity: 1; }
.post-card__burst.is-go .post-card__burst-dot { opacity: 0; transform: rotate(var(--a)) translateY(-34rpx) scale(.2); transition: transform 480ms ease-out, opacity 480ms ease-out; }
.post-card__count-roll { height: 36rpx; overflow: hidden; display: flex; align-items: center; }
.post-card__action-text.is-up { transform: translateY(100%); }
.post-card__action-text.is-down { transform: translateY(-100%); }
.post-card__action-text.is-roll { transform: translateY(0); transition: transform 280ms ease-out; }
@media (prefers-reduced-motion: reduce) { .post-card__burst, .post-card__bigheart { display: none; } .post-card__action-text.is-up, .post-card__action-text.is-down { transform: none; } }
.post-card__action-text { font-size: var(--cy-font-label); font-weight: 400; color: currentColor; font-variant-numeric: tabular-nums; }
/* 矢量图标随 currentColor 走,不再需要 brightness/invert 兜暗端 —— 同 .post-card__share-icon。 */
.post-card__comment-icon { color: currentColor; }
.post-card__share {
  width: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  flex: none;
  /* 帖文第三轮:分享跟在转发后面靠左排,不再甩到最右 */
  padding: 0;
  margin: 0 0 0 var(--cy-space-1);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  color: var(--cy-color-text-primary);
}
.post-card__share::after { border: none; }
.post-card__share-icon { width: 40rpx; height: 40rpx; filter: invert(1); }
.cy-pressed { opacity: 0.78; transform: scale(0.985); }

/* —— Roam(211:271):动作行之后的 Kudos 与 CommentPreview,几何同 completion-share-card,字号按新稿 13pt —— */
.post-card__kudos {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2);               /* 8pt */
  min-width: 0;
  margin-top: var(--pc-gap);
}
.post-card__kudos-avatars { flex: none; display: flex; }
.post-card__kudos-avatar {
  width: 48rpx;                         /* 24pt */
  height: 48rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--cy-color-bg-page);
  border-radius: 50%;
  background: var(--cy-color-bg-elevated);
}
.post-card__kudos-avatar + .post-card__kudos-avatar { margin-left: -16rpx; }   /* 叠 8pt */
.post-card__kudos-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;                     /* ds-ok: 新稿 13pt,type 阶无 13 */
  color: var(--cy-color-text-secondary);
}
.post-card__comment-preview {
  display: flex;
  flex-direction: column;
  gap: var(--cy-space-1-5);                        /* 6pt */
  margin-top: var(--pc-gap);
  padding: var(--cy-space-3) var(--cy-space-3-5);  /* 12pt / 14pt */
  border-radius: var(--cy-radius-lg);              /* 16pt */
  background: var(--cy-color-bg-surface-subtle);
}
.post-card__comment-line {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;                     /* ds-ok: 新稿 13pt */
}
.post-card__comment-nick { margin-right: var(--cy-space-1-5); font-weight: 600; color: var(--cy-color-text-primary); }
.post-card__comment-text { color: var(--cy-color-text-secondary); }
.post-card__comment-more { font-size: var(--cy-font-label); color: var(--cy-color-text-tertiary); }   /* 12pt */

@media (prefers-reduced-motion: reduce) {
  .cy-pressed { transform: none; }
}

/* 商家身份在俱乐部详情里查看时整页浅色,卡面文字跟着翻(pages/club/detail 传 light)。
   只覆写颜色,不碰 Figma 297:1827 的排版。 */
.post-card--light .post-card__nick { color: var(--cy-color-text-primary); }
.post-card--light .post-card__meta { color: var(--cy-color-text-secondary); }
.post-card--light .post-card__action { color: var(--cy-color-text-primary); }
.post-card--light .post-card__comment-icon { filter: brightness(0); opacity: 0.62; }
.post-card--light .post-card__share { color: var(--cy-color-text-primary); }
.post-card--light .post-card__share-icon { filter: none; }
