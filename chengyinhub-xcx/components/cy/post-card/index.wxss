:host {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

/* Figma 297:1827 帖文卡 · 换算 1pt = 2rpx。
 * 四 variant 共用这一层壳,差异只有两处几何:
 *   --pc-avatar 头像/首列宽 —— Image / Text 44pt(带关注角标),Roam / Template 40pt
 *   --pc-gap    块间距     —— 通用 12pt,Roam 14pt
 * ⚠️ 首列宽必须与 .post-card__avatar 同值,所以两处都读 --pc-avatar,别再各写一份字面值。 */
/* 2026-10-22 新稿(俱乐部页重做 211:271/326/354):不再是「头像一列 + 内容一列」的两栏网格 ——
 * 头像只属于头部那一行(头像 · 名字/时间 · 更多),正文、图廊、模板封面、动作行都占满卡片整宽。
 * 头像改成绝对定位压在头部行首,头部给它让出 头像宽 + 10pt;wxml 结构不动。 */
.post-card {
  --pc-avatar: 88rpx;                 /* 44pt */
  --pc-gap: var(--cy-space-3);        /* 12pt = 24rpx */
  position: relative;
  display: block;
  padding: 36rpx var(--cy-page-x);    /* 上下 18pt / 左右 16pt */
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--cy-color-border-subtle);
}
/* Roam(isCompletionShare)/ Template(hasPlayCover):头像 40pt */
.post-card--compact { --pc-avatar: var(--cy-space-7); }   /* 80rpx */
/* Roam 块间距 14pt(插槽卡自己的 :host margin-bottom 已是 --cy-space-3-5,同值) */
.post-card--roam { --pc-gap: var(--cy-space-3-5); }       /* 28rpx */

/* 转发条目:头像上方一行「某某 转发了」,头像随之下移这一行的高度 */
.post-card__repost-by {
  margin-bottom: var(--cy-space-2);
  overflow: hidden;
  font-size: var(--cy-font-label);
  line-height: var(--cy-space-4);
  color: var(--cy-color-text-tertiary);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.post-card--repost .post-card__avatar { top: calc(36rpx + var(--cy-space-4) + var(--cy-space-2)); }

.post-card__avatar {
  position: absolute;
  left: var(--cy-page-x);
  top: 36rpx;                         /* 与卡片上内边距 18pt 对齐,正好落在头部行首 */
  z-index: 1;
  width: var(--pc-avatar);
  height: var(--pc-avatar);
}

.post-card__avatar-img {
  width: 100%;
  height: 100%;
  border: 3rpx solid var(--cy-color-border-strong);
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--cy-color-bg-elevated);
}

.post-card__follow {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 32rpx;
  height: 32rpx;
  min-height: 0;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: var(--cy-btn-solid-bg);
  border: 3rpx solid var(--cy-color-bg-page);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-card__follow::after {
  content: '';
  position: absolute;
  left: -28rpx;
  top: -28rpx;
  width: 88rpx;
  height: 88rpx;
  border: none;
}

.post-card__follow-icon { width: 16rpx; height: 16rpx; filter: brightness(0); }
.post-card__main { min-width: 0; }
/* 稿:Header 垂直居中。首列的头像比 who 竖排高,所以这里跟着头像撑到同高,昵称才真的压在头像中线上。 */
.post-card__head {
  display: flex;
  align-items: center;
  min-height: var(--pc-avatar);
  padding-left: calc(var(--pc-avatar) + var(--cy-space-2-5));   /* 让出头像 + Header 间距 10pt */
  margin-bottom: var(--pc-gap);
}
.post-card__identity { flex: 1; min-width: 0; }
.post-card__name { display: flex; align-items: center; min-width: 0; gap: var(--cy-space-1); }
.post-card__nick {
  min-width: 0;
  overflow: hidden;
  flex-shrink: 1;
  font-size: var(--cy-font-subtitle);   /* 32rpx = 16pt */
  font-weight: 500;                     /* 稿 Medium(原 Bold) */
  color: var(--cy-color-text-primary);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.post-card__verified { width: var(--cy-space-3); height: var(--cy-space-3); flex: none; }
.post-card__badge {
  flex: none;
  padding: 0 var(--cy-space-1-5);
  border: 2rpx solid var(--cy-info);
  border-radius: var(--cy-radius-pill);
  color: var(--cy-info);
  font-size: var(--cy-font-caption);
  font-weight: 700;
  line-height: var(--cy-space-4);
  white-space: nowrap;
}
.post-card__badge--notice { border-color: var(--cy-color-status-warning); color: var(--cy-color-status-warning); }
.post-card__meta {
  margin-top: 6rpx;                     /* Who 竖排间距 3pt */
  overflow: hidden;
  font-size: var(--cy-font-label);      /* 24rpx = 12pt */
  color: var(--cy-color-text-tertiary);
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* .post-card--light 的三条覆盖与 light 属性本身都已删:原先基态写死白字、靠 light 档换回 token,
 * 现在基态直接读 --cy-color-text-primary/-tertiary,两档同值 ⇒ 覆盖变成纯噪声。
 * light 属性与类名保留,后续真出现浅色卡面时在这里挂新规则。 */
.post-card__club--interactive { text-decoration: underline; text-underline-offset: 4rpx; }
.post-card__more {
  flex: none;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0 calc(-1 * var(--cy-space-3)) 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-color-text-secondary);
}
.post-card__audit {
  display: inline-block;
  margin-bottom: var(--pc-gap);
  padding: var(--cy-space-1) var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-danger-soft);
  color: var(--cy-danger);
  font-size: var(--cy-font-label);
}
.post-card__body { margin-bottom: var(--pc-gap); }
.post-card__text {
  display: -webkit-box;
  margin: 0;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-body);       /* 28rpx = 14pt */
  /* 稿行高 22pt @ 字号 14pt。写比例不写 44rpx —— 用户把微信字号调大时 --cy-type-scale 会放大
   * font-size,固定 rpx 行高会把第二行切掉。 */
  line-height: 1.571;
}
.post-card__text--expanded { display: block; overflow: visible; -webkit-line-clamp: unset; white-space: pre-wrap; }
.post-card__link { color: var(--cy-info); }
.post-card__expand {
  display: block;
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-label);      /* 24rpx = 12pt */
  font-weight: 500;
  color: var(--cy-color-text-secondary);
}
.post-card__gallery { position: relative; margin-bottom: var(--pc-gap); }
.post-card__media { width: 100%; white-space: nowrap; }
.post-card__media-row { display: inline-flex; gap: var(--cy-space-2-5); }   /* 10pt */
.post-card__media-map,
.post-card__media-pic {
  width: 600rpx;                        /* 300pt:窄于可视宽,右边露出下一张 = 提示可横滑 */
  height: 460rpx;                       /* 230pt */
  flex: none;
  border-radius: var(--cy-radius-lg);   /* 32rpx = 16pt */
  background: var(--cy-color-bg-surface-subtle);
}
.post-card__count {
  position: absolute;
  top: 24rpx;                           /* 距顶 12pt */
  left: 576rpx;                         /* 稿 211:326:压在第一张图(600rpx)右上角,距其右缘 12pt */
  transform: translateX(-100%);
  padding: 10rpx 20rpx;                 /* 上下 5pt / 左右 10pt */
  border-radius: var(--cy-radius-pill);
  /* 黑纱 + 白字是一体的:这层压在用户照片上,浅色档翻成白底黑字就在亮照片上读不出来了,
   * 所以两处都刻意不绑主题变量。 */
  background: rgba(0, 0, 0, .6); /* ds-ok: 压在照片上的黑纱,不随主题翻转 */
  color: #ffffff; /* ds-ok: 同上,黑纱上恒用白字 */
  font-size: var(--cy-font-label);      /* 24rpx = 12pt */
  font-weight: 500;
  line-height: 1;
  pointer-events: none;
}
.post-card__actions { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.post-card__actions-left { display: flex; align-items: center; flex: 1; min-width: 0; gap: 44rpx; }  /* 动作间距 22pt */
.post-card__action {
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;                           /* 图标 ↔ 数字 7pt */
  border: 0;
  background: transparent;
  line-height: 1;
  color: var(--cy-color-text-primary);
}
.post-card__action::after { border: none; }
.post-card__action--like.is-on { color: var(--cy-color-status-danger); }
.post-card__action--repost.is-on { color: var(--cy-color-status-success); }
.post-card__repost-icon { flex: none; color: currentColor; }
/* 描边 heart = 未赞(继承 .post-card__action 的 primary),实心 heart-filled = 已赞
 * (由 .post-card__action--like.is-on 上色 --cy-color-status-danger,计数文字同色)。
 * 原先是一张自带红的位图 SVG,靠去色滤镜压成「灰实心心」,读起来像已赞,已废弃。 */
.post-card__heart { flex: none; color: currentColor; }
/* 2026-10-22 owner「简单必要的动效」:点亮那一下心形弹起再落位(过冲弹性);进页时已赞的不播 */
.post-card__action--like.is-pop .post-card__heart { animation: pc-like-pop 420ms var(--cy-ease-spring) both; }
@keyframes pc-like-pop {
  0% { transform: scale(1); }
  35% { transform: scale(1.32); }
  100% { transform: scale(1); }
}
.post-card--reduced .post-card__heart { animation: none; }
@media (prefers-reduced-motion: reduce) { .post-card__action--like.is-pop .post-card__heart { animation: none; } }
.post-card__action-text { font-size: var(--cy-font-body); font-weight: 500; color: currentColor; }   /* 28rpx = 14pt Medium */
/* 矢量图标随 currentColor 走,不再需要 brightness/invert 兜暗端 —— 同 .post-card__share-icon。 */
.post-card__comment-icon { color: currentColor; }
.post-card__share {
  width: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  flex: none;
  /* UI-15(2026-09-18):分享要更靠右 —— 88rpx 热区不动,glyph 由居中改贴右缘,
     与主栏右边线(卡片内容右缘)对齐,视觉上比原先再右移 22rpx。 */
  padding: 0;
  margin: 0 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  border: 0;
  background: transparent;
  color: var(--cy-color-text-primary);
}
.post-card__share::after { border: none; }
.post-card__share-icon { width: 44rpx; height: 44rpx; filter: invert(1); }
.cy-pressed { opacity: 0.78; transform: scale(0.985); }

/* —— Roam(211:271):动作行之后的 Kudos 与 CommentPreview,几何同 completion-share-card,字号按新稿 13pt —— */
.post-card__kudos {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2);               /* 8pt */
  min-width: 0;
  margin-top: var(--pc-gap);
}
.post-card__kudos-avatars { flex: none; display: flex; }
.post-card__kudos-avatar {
  width: 48rpx;                         /* 24pt */
  height: 48rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--cy-color-bg-page);
  border-radius: 50%;
  background: var(--cy-color-bg-elevated);
}
.post-card__kudos-avatar + .post-card__kudos-avatar { margin-left: -16rpx; }   /* 叠 8pt */
.post-card__kudos-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;                     /* ds-ok: 新稿 13pt,type 阶无 13 */
  color: var(--cy-color-text-secondary);
}
.post-card__comment-preview {
  display: flex;
  flex-direction: column;
  gap: var(--cy-space-1-5);                        /* 6pt */
  margin-top: var(--pc-gap);
  padding: var(--cy-space-3) var(--cy-space-3-5);  /* 12pt / 14pt */
  border-radius: var(--cy-radius-lg);              /* 16pt */
  background: var(--cy-color-bg-surface-subtle);
}
.post-card__comment-line {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;                     /* ds-ok: 新稿 13pt */
}
.post-card__comment-nick { margin-right: var(--cy-space-1-5); font-weight: 600; color: var(--cy-color-text-primary); }
.post-card__comment-text { color: var(--cy-color-text-secondary); }
.post-card__comment-more { font-size: var(--cy-font-label); color: var(--cy-color-text-tertiary); }   /* 12pt */

@media (prefers-reduced-motion: reduce) {
  .cy-pressed { transform: none; }
}

/* 商家身份在俱乐部详情里查看时整页浅色,卡面文字跟着翻(pages/club/detail 传 light)。
   只覆写颜色,不碰 Figma 297:1827 的排版。 */
.post-card--light .post-card__nick { color: var(--cy-color-text-primary); }
.post-card--light .post-card__meta { color: var(--cy-color-text-secondary); }
.post-card--light .post-card__action { color: var(--cy-color-text-primary); }
.post-card--light .post-card__comment-icon { filter: brightness(0); opacity: 0.62; }
.post-card--light .post-card__share { color: var(--cy-color-text-primary); }
.post-card--light .post-card__share-icon { filter: none; }
