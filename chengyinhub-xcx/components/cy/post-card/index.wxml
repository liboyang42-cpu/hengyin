<wxs src="../../../utils/wxs/img.wxs" module="img" />
<!-- Figma 297:1827 · variant 由 post 字段派生,页面不判:
     isCompletionShare → Roam(头像 40 / 块间距 14) · hasPlayCover → Template(头像 40)
     picList 有图 → Image(头像 44) · 都没有 → Text(头像 44)
     2026-10-22 新稿(俱乐部页重做 211:271 / 211:326 / 211:354):头像只在头部那一行,正文、图、模板封面、
     动作行都占满整宽(不再缩进到头像右侧);Roam 的点赞头像组与评论预览排在动作行之后。 -->
<view class="post-card {{reducedMotion ? 'post-card--reduced' : ''}} {{light ? 'post-card--light' : ''}} {{post.isCompletionShare || post.hasPlayCover ? 'post-card--compact' : ''}} {{post.isCompletionShare ? 'post-card--roam' : ''}} {{post.repostBy ? 'post-card--repost' : ''}}" bindtap="emitDetail" aria-role="button" aria-label="{{accessibilityLabel}}" hover-class="cy-pressed" hover-stay-time="80">
  <!-- 2026-10-29 业主:转发条目在头像上方一行「某某 转发了」,原帖照常排在下面,同一张卡 -->
  <view class="post-card__repost-by" wx:if="{{post.repostBy}}">{{post.repostBy.nick || '城瘾玩家'}} 转发了</view>
  <view class="post-card__avatar">
      <image class="post-card__avatar-img" wx:if="{{interactiveUser}}" lazy-load="true" catchtap="emitUser" aria-role="button" aria-label="打开用户主页"
             src="{{img.first(post.memberAvatar) || '/images/d_profile.png'}}" mode="aspectFill" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true" />
      <image class="post-card__avatar-img" wx:else lazy-load="true" src="{{img.first(post.memberAvatar) || '/images/d_profile.png'}}" mode="aspectFill" />
      <button catchtap="emitFollow" aria-role="button" aria-label="关注" class="post-card__follow"
              wx:if="{{showFollow && (!post.hasPlayCover || post.isCompletionShare) && post.isFollowTheUser == 0 && post.memberId != userId}}">
        <image class="post-card__follow-icon" lazy-load="true" src="/images/icon_jia.png" mode="widthFix" />
      </button>
  </view>
  <view class="post-card__main">
    <view class="post-card__head">
      <view class="post-card__identity">
        <view class="post-card__name">
          <text class="post-card__nick">{{post.memberNickname || '城瘾玩家'}}</text>
          <image class="post-card__verified" lazy-load="true" src="/images/icon_rz.png" mode="widthFix" wx:if="{{post.rz}}" />
          <text class="post-card__badge" wx:if="{{post.memberLevelId > 0}}">Lv.{{post.memberLevelId}}</text>
          <text class="post-card__badge" wx:if="{{post.authorBadge}}">{{post.authorBadge}}</text>
          <text class="post-card__badge post-card__badge--notice" wx:if="{{post.noticeBadge}}">{{post.noticeBadge}}</text>
        </view>
        <view class="post-card__meta" wx:if="{{post.clubName || post.formattedCreateTime || post.timeText}}">
          <text class="post-card__club post-card__club--interactive" wx:if="{{post.clubName && interactiveClub}}" catchtap="emitClub" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">{{post.clubName}}</text>
          <text class="post-card__club" wx:elif="{{post.clubName}}">{{post.clubName}}</text>
          <text wx:if="{{post.clubName && (post.formattedCreateTime || post.timeText)}}"> · </text>
          <text>{{post.formattedCreateTime || post.timeText}}</text>
        </view>
      </view>
      <view class="post-card__more" wx:if="{{showMore}}" catchtap="emitMore"
          aria-role="button" aria-label="更多操作" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">
        <cy-icon name="more" size="44" />
      </view>
    </view>

    <view class="post-card__audit" wx:if="{{post.lifecycleLabel || (!post.lifecycle && post.status == 2)}}">{{post.lifecycleLabel || '未通过审核 · 仅自己可见'}}</view>
    <view class="post-card__body" wx:if="{{post.contents}}" catchtap="emitDetail" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">
      <view class="post-card__text {{textExpanded ? 'post-card__text--expanded' : ''}}">{{post.contents}}<text wx:if="{{post.link}}" class="post-card__link">{{post.link}}</text></view>
      <text class="post-card__expand" wx:if="{{expandableText && textLong}}" catchtap="toggleText" aria-role="button" aria-label="{{textExpanded ? '收起正文' : '展开正文'}}" aria-expanded="{{textExpanded}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">{{textExpanded ? '收起' : '展开'}}</text>
      <text class="post-card__expand" wx:elif="{{textLong}}">展开</text>
    </view>

    <!-- ★ Roam / Template 的正文块在组件里出,页面不判 variant(帖文卡 C 系列拍板)。
         以前这两块靠 pages/square/list 往 slot="special" 里塞,于是同一张卡在
         俱乐部页和达人页就少了一半:normalizeClubPost 明明派生出了 isCompletionShare,
         而没人渲染它 —— 更糟的是下面的图廊被 isCompletionShare 关掉,整条帖子只剩文字。
         字段用 || 兜底而不是在 js 里再派生一次:广场喂 completionImage/playCover,
         俱乐部只有 sportCover,缺的那几个在子组件里各自 wx:if 挂空,不造假数据。 -->
    <cy-completion-share-card
      wx:if="{{post.isCompletionShare}}"
      cover="{{post.completionImage || post.routePreviewImg || post.sportCover}}"
      title="{{post.sportName}}"
      node-total="{{post.nodeTotal}}"
      roam-result="{{post.isRoamResultShare}}"
      medal-gold="{{post.medalGold}}"
      medal-silver="{{post.medalSilver}}"
      medal-bronze="{{post.medalBronze}}"
      comment-count="{{post.commentCount}}"
      distance-text="{{post.distanceText}}"
      shop-text="{{post.shopText}}"
      duration-text="{{post.durationText}}"
      kudos-avatars="{{post.kudosAvatars}}"
      kudos-text="{{post.kudosText}}"
      comment-nick="{{post.commentNick}}"
      comment-text="{{post.commentText}}"
      tail="{{false}}"
      post-index="{{index}}"
      bind:detail="emitPlayDetail"
    />
    <!-- 2026-10-27 P-21 owner:帖文里关联的路线卡用主题封面(sportCover),路线预览图只做兜底 ——
         路线预览图常是一整块深色地图底,卡面看起来就是一块黑。 -->
    <cy-feed-play-card
      wx:if="{{post.hasPlayCover && !post.isCompletionShare}}"
      cover="{{post.sportCover || post.playCover || post.routePreviewImg}}"
      title="{{post.sportName}}"
      subtitle="{{post.playSubtitle}}"
      completed="{{post.completed}}"
      remixable="{{post.isTopicTemplate}}"
      node-total="{{post.nodeTotal}}"
      post-index="{{index}}"
      bind:detail="emitPlayDetail"
      bind:remix="emitRemix"
      bind:play="emitPlay"
    />

    <slot name="special" />

    <view class="post-card__gallery"
          wx:if="{{!post.isCompletionShare && ((post.picList && post.picList.length > 0) || (!post.hasPlayCover && (post.routePreviewImg || post.sportCover)))}}">
      <scroll-view class="post-card__media" scroll-x="true" enhanced="true" show-scrollbar="{{false}}" bindscroll="onGalleryScroll">
        <view class="post-card__media-row">
        <image wx:if="{{!post.sportName && (post.routePreviewImg || post.sportCover)}}" class="post-card__media-map"
               src="{{post.routePreviewImg || post.sportCover}}" mode="aspectFill" lazy-load="true" catchtap="emitDetail"
               aria-role="button" aria-label="查看路线图" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true" />
        <block wx:for="{{post.picList}}" wx:for-item="pic" wx:for-index="picIndex" wx:key="picIndex">
          <image lazy-load="true" class="post-card__media-pic" src="{{pic}}" mode="aspectFill" data-picindex="{{picIndex}}"
                 catchtap="emitPreview" aria-role="button" aria-label="{{interactiveMedia ? '查看大图' : accessibilityLabel}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true" />
        </block>
        </view>
      </scroll-view>
      <!-- 稿(211:326):「第几张 / 共几张」页码 pill,压在第一张图的右上角;横滑时跟着当前张数走 -->
      <view class="post-card__count" wx:if="{{post.picList.length > 1}}" aria-hidden="true">{{galleryIdx + 1}}/{{post.picList.length}}</view>
    </view>

    <view class="post-card__actions">
      <view class="post-card__actions-left">
      <view wx:if="{{interactiveActions}}" class="post-card__action post-card__action--like {{post.isLiked == 1 ? 'is-on' : ''}} {{likePop ? 'is-pop' : ''}}"
            catchtap="emitLike" aria-role="button" aria-label="{{post.isLiked == 1 ? '取消点赞' : '点赞'}}，当前 {{post.likeCount || 0}}" aria-pressed="{{post.isLiked == 1}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">
        <cy-icon class="post-card__heart" wx:if="{{post.isLiked == 1}}" name="heart-filled" size="44" /><cy-icon class="post-card__heart" wx:else name="heart" size="44" /><text class="post-card__action-text">{{post.likeCount || ''}}</text>
      </view>
      <view wx:else class="post-card__action post-card__action--like {{post.isLiked == 1 ? 'is-on' : ''}}" aria-hidden="true">
        <cy-icon class="post-card__heart" wx:if="{{post.isLiked == 1}}" name="heart-filled" size="44" /><cy-icon class="post-card__heart" wx:else name="heart" size="44" /><text class="post-card__action-text">{{post.likeCount || ''}}</text>
      </view>
      <view wx:if="{{interactiveActions}}" class="post-card__action" catchtap="emitComment"
            aria-role="button" aria-label="查看评论，当前 {{post.commentCount || 0}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">
        <cy-icon class="post-card__comment-icon" name="comment" size="44" /><text class="post-card__action-text">{{post.commentCount || ''}}</text>
      </view>
      <view wx:else class="post-card__action" aria-hidden="true">
        <cy-icon class="post-card__comment-icon" name="comment" size="44" /><text class="post-card__action-text">{{post.commentCount || ''}}</text>
      </view>
      <!-- 2026-10-29 业主:动作行 = 点赞 / 评论 / 转发 / 分享;收藏挪进「···」菜单 -->
      <view wx:if="{{showRepost}}" class="post-card__action post-card__action--repost {{post.viewerReposted ? 'is-on' : ''}}"
            catchtap="emitRepost" aria-role="button" aria-label="{{post.viewerReposted ? '撤销转发' : '转发'}}，当前 {{post.repostCount || 0}}" aria-pressed="{{post.viewerReposted ? true : false}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">
        <cy-icon class="post-card__repost-icon" name="repost" size="44" /><text class="post-card__action-text">{{post.repostCount || ''}}</text>
      </view>
      </view>
      <button class="post-card__share" wx:if="{{showShare}}" open-type="share" data-id="{{post.id}}" data-post-id="{{post.id}}" data-club-id="{{post.clubId}}" aria-label="分享到微信">
        <image class="post-card__share-icon" src="/images/icon_share.png" mode="aspectFit" />
      </button>
    </view>
    <!-- Roam(211:271):动作行之后是点赞头像组 + 评论预览 -->
    <block wx:if="{{post.isCompletionShare}}">
      <view class="post-card__kudos" wx:if="{{post.kudosAvatars.length > 0 || post.kudosText}}">
        <view class="post-card__kudos-avatars" wx:if="{{post.kudosAvatars.length > 0}}">
          <block wx:for="{{post.kudosAvatars}}" wx:for-index="kudosIndex" wx:key="kudosIndex">
            <image class="post-card__kudos-avatar" wx:if="{{kudosIndex < 3}}" src="{{item}}" mode="aspectFill" lazy-load="true" />
          </block>
        </view>
        <text class="post-card__kudos-text" wx:if="{{post.kudosText}}">{{post.kudosText}}</text>
      </view>
      <view class="post-card__comment-preview" wx:if="{{post.commentText || post.commentCount > 0}}" catchtap="emitComment"
            aria-role="button" aria-label="查看全部评论" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">
        <view class="post-card__comment-line" wx:if="{{post.commentText}}">
          <text class="post-card__comment-nick" wx:if="{{post.commentNick}}">{{post.commentNick}}</text>
          <text class="post-card__comment-text">{{post.commentText}}</text>
        </view>
        <text class="post-card__comment-more" wx:if="{{post.commentCount > 0}}">查看全部 {{post.commentCount || 0}} 条评论</text>
      </view>
    </block>
    <slot name="moderation" />
  </view>
</view>
