<view class="profile-loading {{navMode === 'merchant' ? 'theme-merchant' : ''}}">
  <cy-nav-bar back="{{viewer !== 'self'}}" custom-back bind:back="goBack" />
  <cy-page-title title="个人主页" safe-top="{{false}}" />
  <view class="profile-loading__body">
    <cy-error load-failure wx:if="{{failed}}" title="主页加载失败" retry="重试" bind:retry="retryLoad" />
    <view wx:else aria-role="status" aria-live="polite" aria-label="主页正在加载">
      <cy-skeleton wx:if="{{loading}}" />
      <text class="profile-loading__hint">加载中</text>
    </view>
  </view>
  <tabBar wx:if="{{viewer === 'self'}}" activePath="/pages/member/index/index"
    mode="{{navMode}}" activeKey="{{navMode === 'merchant' ? 'mine' : ''}}" dark="{{navMode !== 'merchant'}}" />
</view>
