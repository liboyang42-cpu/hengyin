<wxs src="../../../utils/wxs/money.wxs" module="money" />
<view class="ae">
  <cy-skeleton wx:if="{{state === 'loading'}}" type="amount" count="{{1}}" />
  <view wx:elif="{{state === 'error' || state === 'login' || state === 'permission'}}" class="ae-fill cy-fade-in" aria-role="alert">
    <cy-error load-failure="{{state === 'error'}}" fill="{{true}}" size="lg" title="{{state === 'login' ? '登录后查看账户收益' : state === 'permission' ? '当前账号无法查看收益' : '收益加载失败'}}" retry="{{state === 'login' ? '登录' : '重试'}}" bind:retry="refresh" />
  </view>
  <block wx:else>
    <view class="ae-hero">
      <view class="ae-card">
        <text class="ae-card__label">账户收益</text>
        <text class="ae-card__amount">{{money.amount(balanceDisplay || balance)}}</text>
      </view>
      <cy-funds-stages />
      <view class="ae-actions">
        <view class="ae-action" bindtap="openIncomeDetail" aria-role="button" aria-label="查看账户收益明细" hover-class="cy-pressed" hover-stay-time="80">明细</view>
        <view class="ae-action" bindtap="openWithdraw" aria-role="button" aria-label="联系平台客服处理提现" hover-class="cy-pressed" hover-stay-time="80">提现</view>
        <view class="ae-action" bindtap="openWithdrawHistory" aria-role="button" aria-label="打开提现记录弹窗" hover-class="cy-pressed" hover-stay-time="80">提现记录</view>
      </view>
    </view>
    <view class="ae-section">
      <cy-cell title="邀请记录" bind:tap="openInvite" />
    </view>
    <cy-empty class="ae-fill" wx:if="{{balance === '0.00'}}" fill="{{true}}" size="lg" kind="empty" title="还没有收益" sub="创作收益与主办分润到账后都会显示在这里" cta="去发布路线" bind:cta="goPublish" />
  </block>
</view>
