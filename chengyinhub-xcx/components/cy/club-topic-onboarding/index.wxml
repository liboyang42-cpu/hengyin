<cy-scene-sheet
  wx:if="{{show}}"
  show="{{true}}"
  variant="half"
  title="承接商家"
  closable="{{true}}"
  mask-closable="{{true}}"
  bind:close="onClose"
>
  <view class="cto">
    <cy-skeleton wx:if="{{loadState === 'loading'}}" type="form-section" count="4" loading-label="正在读取招商信息" />
    <!-- 403:没权限不是加载失败,不给一个永远重试不好的按钮,只写服务端给的原因 -->
    <cy-empty wx:elif="{{loadState === 'denied'}}" title="{{loadErrorText || '商家信息获取失败'}}" />
    <cy-error load-failure wx:elif="{{loadState === 'error'}}" title="招商信息没能打开" sub="{{loadErrorText}}" retry="重试" bind:retry="onRetry" />
    <cy-empty wx:elif="{{loadState === 'empty'}}" kind="empty" title="还没有可招商的{{mode === 'chapter' ? '章节' : '站点'}}" />

    <!-- ============ mode = node:城市定向按节点招商(J3-A) ============ -->
    <block wx:elif="{{loadState === 'ready' && mode === 'node'}}">
      <text class="cto__summary">已招 {{doneCount}}/{{totalCount}} 站 · {{pendingCount || 0}} 家待确认</text>
      <view class="cto__progress"><view class="cto__progress-fill" style="width:{{progressPct || 0}}%;"></view></view>

      <block wx:for="{{sections}}" wx:key="chapterName" wx:for-item="section">
        <view class="cto__section-head">
          <text class="cto__section-title">{{section.chapterName}}</text>
          <text class="cto__section-meta">{{section.stationCount}} 站 · 已招 {{section.wonCount}}</text>
        </view>
        <block wx:for="{{section.nodes}}" wx:key="id" wx:for-item="node" wx:for-index="ni">
          <view class="cto__node {{node.state === 'open' ? 'cto__node--open' : ''}}">
            <view class="cto__node-seq">{{node.seq || ni + 1}}</view>
            <view class="cto__node-text">
              <text class="cto__title">{{node.name}}</text>
              <text class="cto__meta">{{node.sub}}</text>
            </view>
            <view class="cto__node-trail" wx:if="{{node.state !== 'open'}}">
              <text class="cto__title">{{node.merchantName}}</text>
              <text class="cto__status cto__status--{{node.state === 'won' ? 'success' : 'warning'}}">{{node.statusLabel}}</text>
              <!-- 商家接受后才有联系方式(服务端只给已确认商家下发 phone),复制的是真号 -->
              <view wx:if="{{node.phone}}" class="cto__phone" data-phone="{{node.phone}}" bindtap="onCopyPhone"
                aria-role="button" aria-label="复制 {{node.merchantName}} 的手机号" hover-class="cy-pressed" hover-stay-time="80">
                <text>{{node.phoneText}}</text><cy-icon name="copy" size="24" />
              </view>
            </view>
            <view wx:elif="{{canAct}}" class="cto__cta" data-id="{{node.id}}" bindtap="onInviteNode" aria-role="button" aria-label="去招商 {{node.name}}" hover-class="cy-pressed" hover-stay-time="80">去招商</view>
          </view>
        </block>
      </block>

      <view wx:if="{{canAct}}" class="cto__pool-btn" bindtap="onViewPool" aria-role="button" aria-label="查看候选池" hover-class="cy-pressed" hover-stay-time="80">查看候选池</view>
    </block>

    <!-- ============ mode = chapter:自由探索按章节招商(J3-B) ============ -->
    <block wx:elif="{{loadState === 'ready' && mode === 'chapter'}}">

      <block wx:for="{{chapters}}" wx:key="id" wx:for-item="chapter">
        <view class="cto__chapter-card">
          <view class="cto__chapter-head">
            <text class="cto__chapter-name">{{chapter.name}}</text>
            <text class="cto__chip cto__chip--{{chapter.recruiting ? 'success' : 'default'}}">{{chapter.statusLabel}}</text>
          </view>
          <text class="cto__meta">{{chapter.category}}{{chapter.capacityText ? ' · 需可容纳 ' + chapter.capacityText : ''}}</text>

          <block wx:if="{{chapter.recruiting}}">
            <view class="cto__tags" wx:if="{{chapter.tags.length}}">
              <text class="cto__tag" wx:for="{{chapter.tags}}" wx:key="index" wx:for-item="tag">{{tag}}</text>
            </view>
            <text class="cto__approved">已通过 {{chapter.approvedCount}} / {{chapter.capLimit ? '上限 ' + chapter.capLimit + ' 家' : '不限家数'}}</text>
            <text class="cto__meta" wx:if="{{chapter.thresholdText}}">{{chapter.thresholdText}}</text>
            <view class="cto__hairline" wx:if="{{canAct}}"></view>
            <view class="cto__chapter-foot" wx:if="{{canAct}}">
              <text class="cto__link" data-id="{{chapter.id}}" bindtap="onEditConditions" aria-role="button" aria-label="设置招募条件" hover-class="cy-pressed" hover-stay-time="80">设置招募条件</text>
              <view class="cto__pill" data-id="{{chapter.id}}" bindtap="onViewApplications" aria-role="button" aria-label="查看申请 {{chapter.pendingCount}}" hover-class="cy-pressed" hover-stay-time="80">查看申请 {{chapter.pendingCount}}</view>
            </view>
          </block>
          <block wx:elif="{{canAct && !chapter.finished}}">
            <view class="cto__actions-end">
              <view class="cto__outline-btn" data-id="{{chapter.id}}" bindtap="onOpenRecruiting" aria-role="button" aria-label="开放招募" hover-class="cy-pressed" hover-stay-time="80">开放招募</view>
            </view>
          </block>
        </view>
      </block>
    </block>
  </view>
</cy-scene-sheet>
