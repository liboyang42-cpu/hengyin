/* 通用分享页(P-8;r3-share 改版,参考 refs4/share-page-cards):页面是压暗的色块底,中间一张整色卡;
   卡 560×896rpx(导出图 750×1200 的 0.7467 倍),上半封面、下沿一道弧、徽标压在弧上、两行大标题;卡下色块圆点 + 一颗主按钮 + 一排小渠道 */
.sc { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: calc(var(--cy-z-sheet) + 10); box-sizing: border-box; display: flex; flex-direction: column; background: var(--sc-bg); color: var(--cy-color-text-primary); transition: background .3s; }
.sc::before { content: ""; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, .45); pointer-events: none; } /* ds-ok 页面压暗,卡片保留整色 */
.sc-top { position: relative; flex: none; height: 88rpx; display: flex; align-items: center; padding: 0 204rpx 0 16rpx; }
.sc-x, .sc-sp { flex: none; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.sc-h { flex: 1; text-align: center; font-size: var(--cy-type-card-title); font-weight: 700; }
.sc-stage { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 16rpx 0; }

.sc-card { position: relative; flex: none; width: 560rpx; height: 896rpx; border-radius: var(--cy-radius-xl); overflow: hidden; background: var(--sc-bg); box-shadow: 0 32rpx 80rpx rgba(0, 0, 0, .45), inset 0 0 0 2rpx rgba(255, 255, 255, .08);
  opacity: 0; transform: translateY(var(--cy-motion-rise-md)) scale(.96);
  transition: background .3s, opacity var(--cy-motion-slow) var(--cy-ease-out), transform var(--cy-motion-curl) var(--cy-ease-settle); } /* ds-ok P-8 整色卡投影 */
/* r4-motion 2026-11-10:进场改成 transition(动效棘轮不许新增关键帧):层 show 之后下一帧挂 sc--in,卡上浮 → 徽标弹入 → 文字上浮按 stagger-hero 错开;减动效一步到位 */
.sc--in .sc-card { opacity: 1; transform: none; }
.sc-art { position: absolute; left: 0; top: 0; width: 560rpx; height: 463rpx; background: rgba(0, 0, 0, .22); overflow: hidden; } /* ds-ok 无封面时的上半压暗 */
.sc-cover { display: block; width: 560rpx; height: 463rpx; }
/* 弧:椭圆上沿压住封面下沿,两边比中间低(导出图同一椭圆) */
.sc-arc { position: absolute; left: -168rpx; top: 403rpx; width: 896rpx; height: 545rpx; border-radius: 50%; background: var(--sc-bg); transition: background .3s; }
.sc-badge { position: absolute; left: 228rpx; top: 351rpx; width: 104rpx; height: 104rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; background: #FFFFFF; box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .35);
  opacity: 0; transform: scale(.4); transition: opacity var(--cy-motion-standard) var(--cy-ease-out) calc(var(--cy-motion-stagger-hero) * 2), transform var(--cy-motion-reveal) var(--cy-ease-spring) calc(var(--cy-motion-stagger-hero) * 2); } /* ds-ok 徽标白底 */
.sc--in .sc-badge { opacity: 1; transform: none; }
.sc-badge-img { width: 76rpx; height: 76rpx; }
.sc-in { position: absolute; left: 0; right: 0; top: 479rpx; bottom: 0; display: flex; flex-direction: column; align-items: center; padding: 0 40rpx 32rpx; box-sizing: border-box; text-align: center;
  opacity: 0; transform: translateY(var(--cy-motion-rise-sm)); transition: opacity var(--cy-motion-slow) var(--cy-ease-out) calc(var(--cy-motion-stagger-hero) * 3), transform var(--cy-motion-slow) var(--cy-ease-settle) calc(var(--cy-motion-stagger-hero) * 3); }
.sc--in .sc-in { opacity: 1; transform: none; }
.sc--reduced .sc-card, .sc--reduced .sc-badge, .sc--reduced .sc-in { transition: none; opacity: 1; transform: none; }
.sc-eb { max-width: 100%; box-sizing: border-box; padding: 0 20rpx; line-height: 44rpx; border-radius: var(--cy-radius-pill); background: rgba(255, 255, 255, .16); font-size: var(--cy-type-label); font-weight: 600; color: rgba(255, 255, 255, .86); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 卡片压字;一行,与导出图同(qx-a7) */
.sc-big { margin-top: 24rpx; max-width: 100%; font-size: 54rpx; line-height: 66rpx; font-weight: 900; color: #FFFFFF; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: break-word; } /* ds-ok 卡片压字;两行大标题 */
.sc-m { margin-top: 16rpx; max-width: 100%; font-size: var(--cy-type-body); line-height: 36rpx; color: rgba(255, 255, 255, .78); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* ds-ok 卡片压字 */
.sc-foot { margin-top: auto; align-self: stretch; display: flex; align-items: flex-end; justify-content: space-between; }
.sc-brand { font-size: var(--cy-type-card-title); font-weight: 800; color: #FFFFFF; } /* ds-ok 卡片压字 */
.sc-qr { width: 100rpx; height: 100rpx; padding: 6rpx; border-radius: var(--cy-radius-sm); background: #FFFFFF; } /* ds-ok 小程序码白底 */
.sc-card--shop .sc-qr { width: 128rpx; height: 128rpx; }
/* 勋章:上半是勋章本身,后面一圈暖光 */
.sc-glow { position: absolute; left: 80rpx; top: 17rpx; width: 400rpx; height: 400rpx; border-radius: 50%; background: radial-gradient(circle, rgba(255, 214, 120, .45) 0%, rgba(255, 214, 120, 0) 70%); } /* ds-ok 勋章暖光 */
.sc-medal { position: absolute; left: 0; right: 0; top: 0; height: 434rpx; display: flex; align-items: center; justify-content: center; color: #E9B44C; } /* ds-ok 勋章金 */
.sc-medal-img { width: 224rpx; height: 224rpx; }

.sc-sw { position: relative; flex: none; display: flex; justify-content: center; gap: 0; }
.sc-swatch { width: 72rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.sc-dot { width: 32rpx; height: 32rpx; border-radius: 50%; box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, .35); transition: transform .2s; } /* ds-ok 色块描边 */
.sc-swatch.is-on .sc-dot { transform: scale(1.25); box-shadow: 0 0 0 4rpx #FFFFFF; } /* ds-ok 当前色块 */

.sc-acts { position: relative; flex: none; display: flex; flex-direction: column; gap: 24rpx; padding: 8rpx 48rpx calc(24rpx + env(safe-area-inset-bottom)); }
.sc-primary { width: 100% !important; height: 96rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: var(--cy-comp-btn-radius); background: #FFFFFF; color: #121317; font-size: var(--cy-type-body); font-weight: 700; line-height: normal; } /* ds-ok 色块底上的白色主按钮 */
.sc-primary::after { border: 0; }
.sc-ch { display: flex; justify-content: space-between; }
.sc-ch-i { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; font-size: var(--cy-type-caption); color: rgba(255, 255, 255, .86); } /* ds-ok 色块底上的白字 */
.sc-ch-c { width: 88rpx; height: 88rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .14); color: #FFFFFF; } /* ds-ok P-8 渠道圆钮 */
.sc-cv { position: fixed; left: -9999rpx; top: 0; width: 750px; height: 1200px; }
.cy-pressed { opacity: .88; }

@media (prefers-reduced-motion: reduce) { .sc-card, .sc-badge, .sc-in { transition: none; opacity: 1; transform: none; } .sc, .sc-arc, .sc-dot { transition: none; } }
