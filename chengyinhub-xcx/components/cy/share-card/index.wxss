/* 通用分享页(P-8):底色随色块,卡片居中偏下;渠道圆钮 64px、横向滑动 */
.sc { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: calc(var(--cy-z-sheet) + 10); box-sizing: border-box; display: flex; flex-direction: column; background: var(--sc-bg); color: var(--cy-color-text-primary); transition: background .3s; }
.sc-top { flex: none; height: 88rpx; display: flex; align-items: center; padding: 0 204rpx 0 16rpx; }
.sc-x, .sc-sp { flex: none; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.sc-h { flex: 1; text-align: center; font-size: var(--cy-type-card-title); font-weight: 700; }
.sc-stage { flex: 1; display: flex; align-items: flex-end; justify-content: center; padding: 48rpx 0 32rpx; }
.sc-card { position: relative; width: 560rpx; min-height: 820rpx; border-radius: var(--cy-radius-xl); overflow: hidden; background: rgba(0, 0, 0, .28); box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, .35); } /* ds-ok P-8 卡片压在色块底上 */
.sc-in { position: relative; display: flex; flex-direction: column; padding: 40rpx; box-sizing: border-box; min-height: 820rpx; }
.sc-eb { font-size: var(--cy-type-label); font-weight: 600; color: rgba(255, 255, 255, .7); } /* ds-ok 卡片压字 */
.sc-t { margin-top: 12rpx; font-size: var(--cy-type-sheet-title); font-weight: 800; line-height: 1.2; color: #FFFFFF; } /* ds-ok 卡片压字 */
.sc-m { margin-top: 8rpx; font-size: var(--cy-type-body); color: rgba(255, 255, 255, .7); } /* ds-ok 卡片压字 */
.sc-c { text-align: center; }
.sc-foot { margin-top: auto; display: flex; align-items: flex-end; justify-content: space-between; padding-top: 32rpx; }
.sc-brand { font-size: var(--cy-type-card-title); font-weight: 800; color: #FFFFFF; } /* ds-ok 卡片压字 */
.sc-qr { width: 120rpx; height: 120rpx; padding: 8rpx; border-radius: var(--cy-radius-sm); background: #FFFFFF; } /* ds-ok 小程序码白底 */
.sc-card--act .sc-cover { display: block; width: 560rpx; height: 420rpx; }
.sc-card--act .sc-in { min-height: 400rpx; }
.sc-when { display: flex; flex-direction: column; margin-top: 16rpx; }
.sc-date { font-size: var(--cy-type-data-xl); line-height: 1; font-weight: 900; font-style: italic; color: #FFFFFF; } /* ds-ok 卡片压字 */
.sc-whenl { margin-top: 8rpx; font-size: var(--cy-type-label); color: rgba(255, 255, 255, .7); } /* ds-ok 卡片压字 */
.sc-bgimg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.sc-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, .55); } /* ds-ok 封面压暗 */
.sc-big { margin-top: 12rpx; font-size: var(--cy-type-data-xl); line-height: 1.05; font-weight: 900; font-style: italic; color: #FFFFFF; } /* ds-ok 卡片压字 */
.sc-line { margin-top: 40rpx; display: flex; flex-direction: column; }
.sc-line-i { position: relative; display: flex; align-items: center; gap: 20rpx; min-height: 76rpx; }
.sc-line-i + .sc-line-i::before { content: ""; position: absolute; left: 19rpx; top: -38rpx; width: 3rpx; height: 58rpx; background: rgba(255, 255, 255, .4); } /* ds-ok 路线竖线 */
.sc-line-dot { position: relative; z-index: 1; flex: none; width: 40rpx; height: 40rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #FFFFFF; color: #121317; font-size: var(--cy-type-caption); font-weight: 800; } /* ds-ok 站点编号圆点 */
.sc-line-t { font-size: var(--cy-type-body); font-weight: 600; color: #FFFFFF; } /* ds-ok 卡片压字 */
.sc-medal { display: flex; align-items: center; justify-content: center; height: 420rpx; color: #E9B44C; } /* ds-ok 勋章金 */
.sc-medal-img { width: 300rpx; height: 300rpx; }
.sc-sw { flex: none; display: flex; justify-content: center; gap: 4rpx; padding: 0 0 16rpx; }
.sc-swatch { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.sc-dot { width: 56rpx; height: 56rpx; border-radius: 50%; box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, .35); } /* ds-ok 色块描边 */
.sc-swatch.is-on .sc-dot { box-shadow: 0 0 0 5rpx #FFFFFF; } /* ds-ok 当前色块 */
.sc-ch { flex: none; white-space: nowrap; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.sc-ch-i { display: inline-flex; flex-direction: column; align-items: center; gap: 12rpx; width: 152rpx; vertical-align: top; font-size: var(--cy-type-label); color: #FFFFFF; } /* ds-ok 色块底上的白字 */
.sc-ch-i:first-child { margin-left: 24rpx; }
.sc-ch-btn { margin: 0; padding: 0; line-height: normal; background: transparent; border-radius: 0; }
.sc-ch-btn::after { border: 0; }
.sc-ch-c { width: 128rpx; height: 128rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .14); } /* ds-ok P-8 渠道圆钮 64px */
.sc-cv { position: fixed; left: -9999rpx; top: 0; width: 750px; height: 1200px; }
.cy-pressed { opacity: .88; }
