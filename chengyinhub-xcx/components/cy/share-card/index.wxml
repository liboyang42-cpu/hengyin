<!-- 通用分享层(2026-10-31 业主批准 P-8):每种内容只有一张卡,卡片在页面中间偏下;四个色块换底色;
     下面一排渠道圆钮放大、横向滑动。活动 / 主题 / 勋章走这一层,漫游的分享仍在漫游页那套(可见范围、发到广场)。 -->
<view wx:if="{{show}}" class="sc" style="--sc-bg:{{bg}};padding-top:{{statusBarHeight}}px;" catchtouchmove="noop">
  <view class="sc-top">
    <view class="sc-x" bindtap="close" aria-role="button" aria-label="关闭分享" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close" size="36" /></view>
    <text class="sc-h">分享{{label}}</text>
    <view class="sc-sp"></view>
  </view>

  <view class="sc-stage">
    <!-- 活动:封面在上,活动名、粗斜体大日期、时间地点在下 -->
    <view class="sc-card sc-card--act" wx:if="{{kind === 'activity' || kind === 'shop'}}">
      <image class="sc-cover" wx:if="{{cover}}" src="{{cover}}" mode="aspectFill" />
      <view class="sc-in">
        <text class="sc-eb">{{label}}</text>
        <text class="sc-t">{{title}}</text>
        <view class="sc-when" wx:if="{{date || when}}"><text class="sc-date" wx:if="{{date}}">{{date}}</text><text class="sc-whenl">{{when}}</text></view>
        <view class="sc-foot"><text class="sc-brand">城瘾</text><image class="sc-qr" wx:if="{{qr}}" src="{{qr}}" mode="aspectFit" /></view>
      </view>
    </view>
    <!-- 主题:封面铺满整张卡并压暗,大号粗斜体主题名,下面一条竖着的路线,站点编号连成线 -->
    <view class="sc-card sc-card--theme" wx:elif="{{kind === 'theme'}}">
      <image class="sc-bgimg" wx:if="{{cover}}" src="{{cover}}" mode="aspectFill" />
      <view class="sc-shade"></view>
      <view class="sc-in">
        <text class="sc-eb">{{meta ? '主题 · ' + meta : '主题'}}</text>
        <text class="sc-big">{{title}}</text>
        <view class="sc-line" wx:if="{{stops.length}}">
          <view class="sc-line-i" wx:for="{{stops}}" wx:key="index"><view class="sc-line-dot">{{index + 1}}</view><text class="sc-line-t">{{item}}</text></view>
        </view>
        <view class="sc-foot"><text class="sc-brand">城瘾</text><image class="sc-qr" wx:if="{{qr}}" src="{{qr}}" mode="aspectFit" /></view>
      </view>
    </view>
    <!-- 勋章:卡片中间是勋章本身 -->
    <view class="sc-card sc-card--medal" wx:else>
      <view class="sc-in">
        <text class="sc-eb">勋章</text>
        <view class="sc-medal"><image class="sc-medal-img" wx:if="{{cover}}" src="{{cover}}" mode="aspectFit" /><cy-icon wx:else name="star-filled" size="110" /></view>
        <text class="sc-t sc-c">{{title}}</text>
        <text class="sc-m sc-c" wx:if="{{meta}}">{{meta}}</text>
        <view class="sc-foot"><text class="sc-brand">城瘾</text><image class="sc-qr" wx:if="{{qr}}" src="{{qr}}" mode="aspectFit" /></view>
      </view>
    </view>
  </view>

  <view class="sc-sw">
    <view class="sc-swatch {{index === colorIndex ? 'is-on' : ''}}" wx:for="{{colors}}" wx:key="*this"
          data-i="{{index}}" bindtap="pickColor" aria-role="button" aria-label="换第 {{index + 1}} 种底色" hover-class="cy-pressed" hover-stay-time="80"><view class="sc-dot" style="background:{{item}}"></view></view>
  </view>

  <scroll-view class="sc-ch" scroll-x enhanced show-scrollbar="{{false}}">
    <button class="sc-ch-i sc-ch-btn" open-type="share" data-share-kind="card" aria-label="发给微信好友"><view class="sc-ch-c"><cy-icon name="share" size="44" /></view><text>微信好友</text></button>
    <view class="sc-ch-i" wx:for="{{channels}}" wx:key="key" data-key="{{item.key}}" bindtap="onChannel" aria-role="button" aria-label="{{item.label}}" hover-class="cy-pressed" hover-stay-time="80">
      <view class="sc-ch-c"><cy-icon name="{{item.icon}}" size="44" /></view><text>{{item.label}}</text>
    </view>
  </scroll-view>
  <canvas type="2d" id="sccv" class="sc-cv"></canvas>
</view>
