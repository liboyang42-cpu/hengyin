<!-- 真弹窗:页内组件 + wx:if,不压页面栈。待决策态强制闸 ⇒ mask 不可关、无关闭叉。 -->
<cy-scene-sheet
  wx:if="{{show}}"
  show="{{true}}"
  variant="half"
  theme="player"
  title="隐私与定位"
  closable="{{false}}"
  mask-closable="{{false}}"
>
  <view class="pg">
    <text class="pg__body">城瘾在你主动开启漫游后使用定位用于到点打卡和记录足迹；锁屏或切到后台后仍记录，结束漫游即停止。向附近用户分享位置默认关闭，需另行单独同意；开启后展示街区模糊位置、昵称、头像及本次漫游信息，可随时关闭，关闭不影响自己的轨迹。拍照判定、识物成卡、NPC 对话和 AI 创作助手会把你提交的照片或文字发送给第三方模型服务商（DeepSeek）处理，声音复刻会把录音发送给阿里云语音模型（通义 CosyVoice）生成音色；照片与声音处理均需另行单独同意，结果仅用于本次功能。</text>
    <view class="pg__link" bindtap="openPrivacyContract" aria-role="button" aria-label="查看用户隐私保护指引" hover-class="cy-pressed" hover-stay-time="80">查看《用户隐私保护指引》</view>
    <!-- 微信强制:同意必须是原生 button open-type,不能收编 cy-btn。
         2026-09-18 对齐 pages/privacy 已定方案:两颗并排,不同意在左(secondary 描边)、同意在右;
         原来竖排 + ghost 玻璃底与卡面同色,「暂不同意」根本看不清。 -->
    <view bindtap="openService" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="阅读用户服务协议">阅读《用户服务协议》</view>
    <checkbox-group bindchange="toggleService"><label><checkbox value="service" checked="{{serviceAgreed}}"/>我已阅读并同意《用户服务协议》及隐私保护指引</label></checkbox-group>
    <view class="pg__actions">
      <cy-btn variant="secondary" disabled="{{submitting}}" class="pg__action" bindtap="disagreePrivacy">暂不同意</cy-btn>
      <button class="pg__agree" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy" loading="{{submitting}}" disabled="{{submitting || !serviceAgreed}}" aria-disabled="{{submitting || !serviceAgreed}}">同意并继续</button>
    </view>
  </view>
</cy-scene-sheet>

<cy-agreement-sheet show="{{showServiceSheet}}" type="service" theme="player" bind:close="closeService" />
