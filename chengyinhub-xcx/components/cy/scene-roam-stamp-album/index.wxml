<!-- 集邮册 · 照原型 f-sticker 搬:三列方格,每格底部压地名/留言,末尾一格虚线「还没收到」。
     2026-09-10 用户裁决:漫游四模式不跟小程序 UI 规则走,原来那套「收藏夹合上/展开 + 散落
     票面」(Figma 220:1388)整个退场。
     原型没有的三样留着 —— 它是静态稿,没有接口:空/错/加载三态、分页续读、相机入口。 -->
<view class="album-body">
  <cy-tabs plain tabs="{{tabs}}" active="{{tab}}" bind:change="onTabChange" />
  <text class="album-sub" wx:if="{{loaded}}">{{tab === 'received' ? '别人投来、你换回的 ' + (total || 0) + ' 枚' : '这座城市里你已经收下的 ' + (total || 0) + ' 枚'}}</text>

  <view class="stkgrid" wx:if="{{items.length}}">
    <block wx:for="{{items}}" wx:key="id">
      <!-- BL-05:只有「收到的」可点开详情;「我的」保持原样 -->
      <view class="stkcell" wx:if="{{tab === 'received'}}" data-index="{{index}}" bindtap="openDetail" aria-role="button" aria-label="查看这枚收到的邮票" hover-class="cy-pressed" hover-stay-time="80">
        <image class="stkcell__img" src="{{item.picUrl}}" mode="aspectFill" lazy-load />
        <text class="stkcell__cap" wx:if="{{item.caption}}">{{item.caption}}</text>
      </view>
      <view class="stkcell" wx:else>
        <image class="stkcell__img" src="{{item.picUrl}}" mode="aspectFill" lazy-load />
        <text class="stkcell__cap" wx:if="{{item.caption}}">{{item.caption}}</text>
      </view>
    </block>
    <!-- 原型末尾那一格虚线占位:它不是加载态,是「这座城市还有没收到的」 -->
    <view class="stkcell stkcell--lock" wx:if="{{noMore && tab === 'mine'}}"><text class="stkcell__lock-t">还没收到</text></view>
  </view>

  <cy-error class="album-state" fill size="lg" wx:if="{{error && !items.length}}" title="{{tab === 'received' ? '收到的邮票没打开' : '集邮册没打开'}}" sub="邮票都还在，只是这次没读到。" retry="重试" bind:retry="retryLoad" />
  <cy-skeleton wx:elif="{{loading && !items.length}}" type="card" count="2" />
  <view class="album-empty" wx:elif="{{loaded && total === 0 && tab === 'mine'}}"><text class="album-empty__title">还没有邮票</text><text class="album-empty__sub">上街拍一张，城市就进你的册子了</text><view class="album-empty__cta" bindtap="openCamera" aria-role="button" aria-label="打开集邮相机" hover-class="cy-pressed" hover-stay-time="80">打开集邮相机</view></view>
  <view class="album-empty" wx:elif="{{loaded && total === 0}}"><text class="album-empty__title">还没有收到的邮票</text><text class="album-empty__sub">投一张自己的票，就能换回别人那张</text></view>

  <text class="album-mini" wx:if="{{items.length && tab === 'mine'}}">每投一张换来的那张，就落在这儿。</text>

  <view class="album-more" wx:if="{{loading && items.length}}">正在读取下一页</view>
  <view class="album-more album-more--error" wx:elif="{{error && items.length}}" bindtap="retryLoad" aria-role="button" aria-label="重试读取下一页" hover-class="album__press" hover-stay-time="80">这一页没读到 · 点此重试</view>
  <view class="album-load-more" wx:elif="{{!noMore && items.length}}" bindtap="loadMore" aria-role="button" aria-label="继续读取城市邮票" hover-class="album__press" hover-stay-time="80">继续展开下一页</view>
  <!-- BL-49:「收到的」读完后给到底提示(「我的」末尾已有「还没收到」虚线格,不重复) -->
  <view class="album-more" wx:elif="{{noMore && items.length && tab === 'received'}}" aria-role="text">收到的邮票都在这里了</view>

  <view class="album-fab" bindtap="openCamera" hover-class="album-fab--press" hover-stay-time="60" wx:if="{{total > 0}}" aria-role="button" aria-label="打开集邮相机"><cy-icon name="plus" size="40" /></view>

  <!-- BL-05 收到的邮票详情:只列接口已有字段;作者不在接口里(换到的票对收件人匿名),不编造 -->
  <cy-sheet show="{{!!detail}}" title="收到的邮票" handle closable maskClosable bind:close="closeDetail">
    <view class="stkdetail" wx:if="{{detail}}">
      <image class="stkdetail__img" src="{{detail.picUrl}}" mode="aspectFit" bindtap="previewDetail" aria-role="button" aria-label="查看大图" hover-class="cy-pressed" hover-stay-time="80" />
      <text class="stkdetail__cap" wx:if="{{detail.caption}}">{{detail.caption}}</text>
      <view class="stkdetail__row"><text class="stkdetail__k">来源</text><text class="stkdetail__v">投一张自己的票换回 · 对方匿名</text></view>
      <view class="stkdetail__row" wx:if="{{detail.kindLabel}}"><text class="stkdetail__k">类型</text><text class="stkdetail__v">{{detail.kindLabel}}</text></view>
      <view class="stkdetail__row" wx:if="{{detail.timeText}}"><text class="stkdetail__k">拍下时间</text><text class="stkdetail__v">{{detail.timeText}}</text></view>
    </view>
  </cy-sheet>
</view>
