:host { display: block; height: 100%; }

.siv {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--cy-color-text-primary);
  /* 同 scene-roam-history:面板底由 .ss__panel 出,这里再刷一层半透会叠成近实色。 */
  font-family: -apple-system, BlinkMacSystemFont, "Inter", "PingFang SC", sans-serif;
}

.siv--player {
  --siv-bg: var(--cy-comp-sheet-player-bg);
  --siv-text: var(--cy-color-text-primary);
  --siv-muted: var(--cy-comp-sheet-player-muted);
  --siv-border: var(--cy-comp-sheet-invite-border-player);
  --siv-missing-bg: var(--cy-comp-sheet-invite-missing-bg-player);
  background: var(--siv-bg);
  color: var(--siv-text);
}

.siv--merchant {
  --siv-bg: var(--cy-comp-sheet-merchant-bg);
  --siv-text: var(--cy-comp-sheet-merchant-title);
  --siv-muted: var(--cy-color-text-tertiary);
  --siv-border: var(--cy-comp-sheet-invite-border-merchant);
  --siv-missing-bg: var(--cy-comp-sheet-invite-missing-bg-merchant);
  background: var(--siv-bg);
  color: var(--siv-text);
}

.siv__qr-frame {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  flex: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--cy-comp-sheet-invite-qr-radius);
  background: var(--cy-comp-sheet-invite-qr-bg);
}

.siv__qr-status { width: 100%; }

.siv__qr {
  position: absolute;
  inset: 0;
  width: 520rpx;
  height: 520rpx;
  display: block;
  opacity: 0;
  clip-path: circle(0% at 50% 50%);
  transition: opacity var(--cy-motion-standard) var(--cy-ease), clip-path 900ms cubic-bezier(.2,.7,.2,1);
}

.siv__qr--ready { opacity: 1; clip-path: circle(75% at 50% 50%); }
/* 彩色圈层压在码上(lighten:黑点被染色、白底不变),码露全后整层淡出,点回到黑色 */
.siv__ripple { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: lighten; opacity: 1;
  background: radial-gradient(circle at 50% 50%, #4ade80 0%, #f97316 22%, #6366f1 44%, #a855f7 62%, #be185d 80%); /* ds-ok: 出现动效的彩色圈,终态不可见 */
  transition: opacity 900ms ease 700ms; }
.siv__ripple--done { opacity: 0; }
.siv__logo { position: absolute; left: 50%; top: 50%; width: 112rpx; height: 112rpx; margin: -56rpx 0 0 -56rpx; border-radius: 28rpx; background: #fff; /* ds-ok: 码中心的白底 logo 位 */
  display: flex; align-items: center; justify-content: center; opacity: 0; transform: scale(.6); transition: opacity 300ms ease 500ms, transform 400ms cubic-bezier(.34,1.56,.64,1) 500ms; }
.siv__logo-img { width: 84rpx; height: 84rpx; filter: brightness(0); } /* 业主:中间是黑色的城瘾 logo */
.siv__logo--ready { opacity: 1; transform: scale(1); }
.siv--reduced .siv__qr, .siv--reduced .siv__ripple, .siv--reduced .siv__logo { transition: none; }

.siv__qr-state {
  width: 520rpx;
  height: 520rpx;
  flex: none;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx;
  border-radius: var(--cy-comp-sheet-invite-missing-radius);
  background: var(--siv-missing-bg);
  text-align: center;
}

.siv__copy {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 32rpx;
  text-align: center;
}

.siv__title {
  max-width: 640rpx;
  font-size: var(--cy-comp-sheet-invite-title-size);
  line-height: 56rpx;
  font-weight: 700;
  letter-spacing: -.3rpx;
}

.siv__description {
  max-width: 620rpx;
  margin-top: 16rpx;
  color: var(--siv-muted);
  font-size: var(--cy-comp-sheet-invite-description-size);
  line-height: 40rpx;
}

.siv__share {
  width: 640rpx;
  height: 116rpx;
  flex: none;
  box-sizing: border-box;
  margin-top: auto;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--siv-border);
  border-radius: var(--cy-comp-sheet-invite-button-radius);
  background: transparent;
  color: var(--siv-text);
  font-size: var(--cy-comp-sheet-sound-status-size);
  line-height: 44rpx;
  font-weight: 700;
}

.siv__share::after { border: 0; }
.siv__share.button-hover { opacity: .68; }

/* BL-71:个人码可点开预览。isolated 组件内全局 .cy-pressed 进不来,照 scene-qr-ticket 本地定义,只减淡不位移。 */
.cy-pressed { opacity: .88; }
