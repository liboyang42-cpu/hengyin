<view class="seg {{disabled ? 'is-disabled' : ''}}" aria-role="radiogroup" aria-label="{{label}}">
  <view wx:for="{{items}}" wx:key="label" class="seg__i {{index === current ? 'is-on' : ''}}" data-index="{{index}}" bindtap="onPick" aria-role="radio" aria-checked="{{index === current}}" aria-label="{{item.label}}" hover-class="cy-pressed" hover-stay-time="80">{{item.label}}</view>
</view>
