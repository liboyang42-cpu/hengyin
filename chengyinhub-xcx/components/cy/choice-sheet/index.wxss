.cs { padding: 0 var(--cy-space-4) var(--cy-space-2); }
.cs__t { display: block; margin-bottom: 28rpx; text-align: center; font-size: var(--cy-type-sheet-title); font-weight: 700; color: var(--cy-color-text-primary); }
.cs__os { display: flex; flex-direction: column; gap: var(--cy-space-2); }
.cs__o {
  display: flex;
  align-items: center;
  gap: var(--cy-space-3);
  min-height: 108rpx;
  padding: 0 36rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: var(--cy-color-bg-page);
  color: var(--cy-color-text-primary);
  transition: transform var(--cy-motion-expand) var(--cy-ease-spring), background-color var(--cy-motion-fast) var(--cy-ease-standard), color var(--cy-motion-fast) var(--cy-ease-standard);
}
.cs__o:active { transform: scale(.97); }
.cs__o.is-on { background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); }
.cs__n { flex: 1; font-size: var(--cy-type-body); font-weight: 600; }
.cs__v { font-size: var(--cy-type-label); opacity: .62; font-variant-numeric: tabular-nums; }
.cs__err { display: block; margin-top: 20rpx; }
/* 线稿图标走 mask,颜色跟着 currentColor(选中时自动变反色) */
.cs__ic { flex: none; width: 44rpx; height: 44rpx; background-color: currentColor; -webkit-mask-size: 100% 100%; mask-size: 100% 100%; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }
@media (prefers-reduced-motion: reduce) { .cs__o { transition: none; } .cs__o:active { transform: none; } }
