.ch { display: flex; flex-wrap: wrap; gap: var(--cy-space-2); padding-top: var(--cy-space-3); }
.ch__c {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 68rpx;
  padding: 0 28rpx 0 24rpx;
  box-sizing: border-box;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-surface);
  font-size: var(--cy-type-label);
  font-weight: 600;
  color: var(--cy-color-text-primary);
  transition: transform var(--cy-motion-press) var(--cy-ease-standard);
}
.ch__c:active { transform: scale(.95); }
.ch__dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.ch__c--add { padding: 0 28rpx; gap: 8rpx; background: transparent; box-shadow: inset 0 0 0 1px var(--cy-color-border-strong); }
.ch__field {
  flex: 1 1 100%;
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding: 0 6rpx 0 28rpx;
  box-sizing: border-box;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-surface);
  box-shadow: inset 0 0 0 3rpx var(--cy-color-text-primary);
}
.ch__field.is-bad { box-shadow: inset 0 0 0 3rpx var(--cy-color-status-danger); }
.ch__field.is-bad .ch__in { color: var(--cy-color-status-danger); }
.ch__in { flex: 1 1 auto; min-width: 0; font-size: var(--cy-type-body); color: var(--cy-color-text-primary); }
.ch__go { flex: none; padding: 0 var(--cy-space-4); min-height: 64rpx; display: flex; align-items: center; font-size: var(--cy-type-button); font-weight: 600; color: var(--cy-color-text-primary); }
.ch__go.is-off { color: var(--cy-color-text-disabled); }
.ch__err { display: block; padding: 14rpx var(--cy-space-4) 0; font-size: var(--cy-type-caption); color: var(--cy-color-status-danger); }

/* 组件样式隔离,全局 .cy-pressed 进不来,本地补一份(同 cy-card) */
.cy-pressed { opacity: .88; }
