<view class="cy-card {{flat ? 'cy-card--flat' : ''}} {{media ? 'cy-card--media' : ''}}"
      aria-role="{{interactive ? 'button' : ''}}"
      aria-label="{{interactive ? accessibilityLabel : ''}}"
      hover-class="{{hoverClass}}"
      hover-stay-time="{{hoverStayTime}}">
  <slot></slot>
</view>
