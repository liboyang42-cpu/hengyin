<cy-modal show="{{show}}" title="{{title}}" content="{{editable ? '' : content}}" confirm-text="{{confirmText}}" cancel-text="{{cancelText}}"
  show-cancel="{{showCancel}}" danger="{{danger}}" bind:confirm="onConfirm" bind:cancel="onCancel">
  <view wx:if="{{editable}}" class="mh__editable">
    <text wx:if="{{content}}" class="mh__content">{{content}}</text>
    <!-- PR10 F-L3-09:长原因(如 500 字拒绝原因)用多行框;同一套底色/边框/校验,只是能看见整段 -->
    <textarea wx:if="{{multiline}}" class="mh__input mh__input--multiline" value="{{inputValue}}" placeholder="{{placeholderText}}" placeholder-class="mh__placeholder"
      maxlength="{{maxlength > 0 ? maxlength : 140}}" bindinput="onInput" fixed="{{true}}" show-confirm-bar="{{false}}" aria-label="{{placeholderText || title}}" />
    <input wx:else class="mh__input" value="{{inputValue}}" placeholder="{{placeholderText}}" placeholder-class="mh__placeholder"
      maxlength="{{maxlength > 0 ? maxlength : 140}}" bindinput="onInput" confirm-type="done" aria-label="{{placeholderText || title}}" />
    <!-- CU-C-56/58/M-49:校验不过的提示贴在输入框下,面板不关、输入不丢 -->
    <cy-inline-error wx:if="{{inputError}}" class="mh__error" kind="error" title="{{inputError}}" sub="" />
  </view>
</cy-modal>
<!-- 已登记危险写(utils/danger-actions.js)走三段式确认;modal.show({ dangerKey, dangerParams, success }) 路由到这里 -->
<cy-danger-confirm id="dc" bind:confirm="onDcConfirm" bind:cancel="onDcCancel" />
