/* 地图区:686×360rpx 深灰底 + 淡网格;轨迹亮紫,起点空心、终点白色实心,店铺四色打点 */
.rc__map { position: relative; width: 686rpx; height: 360rpx; overflow: hidden; background-color: #15171C; background-image: linear-gradient(rgba(255, 255, 255, .035) 2rpx, transparent 2rpx), linear-gradient(90deg, rgba(255, 255, 255, .035) 2rpx, transparent 2rpx); background-size: 64rpx 64rpx; } /* ds-ok P-7 深色地图卡底(业主批准稿) */
.rc__seg { position: absolute; height: 8rpx; margin-top: -4rpx; border-radius: 4rpx; background: #8C88FF; transform-origin: 0 50%; } /* ds-ok P-7 轨迹亮紫 */
.rc__poi { position: absolute; width: 18rpx; height: 18rpx; margin: -9rpx 0 0 -9rpx; border-radius: 50%; border: 4rpx solid #15171C; } /* ds-ok P-7 店铺点描边 = 地图底 */
.rc__poi--0 { background: #8C88FF; } /* ds-ok P-7 店铺四色 */
.rc__poi--1 { background: #B7BCC8; } /* ds-ok P-7 店铺四色 */
.rc__poi--2 { background: #8C91A0; } /* ds-ok P-7 店铺四色 */
.rc__poi--3 { background: #FFFFFF; } /* ds-ok P-7 店铺四色 */
.rc__pin { position: absolute; width: 22rpx; height: 22rpx; margin: -11rpx 0 0 -11rpx; border-radius: 50%; }
.rc__pin--start { background: #15171C; border: 6rpx solid #FFFFFF; } /* ds-ok P-7 起点空心 */
.rc__pin--end { background: #FFFFFF; border: 4rpx solid #15171C; } /* ds-ok P-7 终点实心 */
.rc__pin--only { left: 50%; top: 50%; background: #8C88FF; border: 6rpx solid #15171C; } /* ds-ok P-7 没有轨迹:只画一个点 */
/* 2026-11-09 V3-40:真实底图铺满卡片上半;盖一层透明点击层,点卡片仍走外层 openSession(原生地图不吞点击、不能拖) */
.rc__real { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.rc__hit { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
