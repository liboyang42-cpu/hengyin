/* cy-toast · 轻提示:底部居中胶囊,不挡操作,色随主题(与 cy-modal 同一档面板色)
 * 进出场用 transition(棘轮:toast 这类快速重触发元素不开 @keyframes),减动效下直接切换。 */
:host { display: block; }
.ct {
  position: fixed;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  z-index: var(--cy-z-toast);
  display: inline-flex;
  align-items: center;
  gap: var(--cy-space-2);
  max-width: 600rpx;
  padding: var(--cy-space-2-5) var(--cy-space-4);
  box-sizing: border-box;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-comp-modal-panel);
  border: 2rpx solid var(--cy-border-card);
  color: var(--cy-text-title);
  font-size: var(--cy-font-body);
  line-height: 1.4;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, 16rpx);
  transition: opacity var(--cy-motion-standard) var(--cy-ease-out), transform var(--cy-motion-standard) var(--cy-ease-out);
}
.ct.ct--in { opacity: 1; transform: translate(-50%, 0); }
.ct.ct--reduced-motion { transition: none; }
.ct__icon { flex: none; }
.ct--success .ct__icon { color: var(--cy-color-status-success); }
.ct--error .ct__icon { color: var(--cy-color-status-danger); }
.ct__text { word-break: break-all; }

/* 可撤销提示条(snackbar,2026-10-23):和 toast 同一个位置、同一张面板色,
 * 但横向撑满(左右留页边距)、文案左对齐、右侧一个文字按钮,所以它要接点击。 */
.ct.ct--snack {
  left: var(--cy-page-x);
  right: var(--cy-page-x);
  max-width: none;
  display: flex;
  justify-content: space-between;
  min-height: var(--cy-btn-h);
  padding: 0 var(--cy-space-1) 0 var(--cy-space-4);
  border-radius: var(--cy-radius-lg);
  pointer-events: auto;
  transform: translate(0, 16rpx);
}
.ct.ct--snack.ct--in { transform: translate(0, 0); }
.ct--snack .ct__text { flex: 1; min-width: 0; word-break: break-word; }
.ct__action {
  flex: none;
  min-width: var(--cy-btn-h);
  height: var(--cy-btn-h);
  padding: 0 var(--cy-space-3);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: var(--cy-text-title);
}
.ct__action--pressed { opacity: .6; }
