<wxs module="gs" src="../../../utils/wxs/gesture.wxs" />
<view class="sh sh--{{variant}} {{(stacked || _under) ? 'sh--stacked' : ''}} {{inset ? 'sh--inset' : ''}} {{footer ? 'sh--has-footer' : ''}} {{anchorSelector ? 'sh--morph' : ''}} {{_morphOpen ? 'sh--morph-open' : ''}} {{reducedMotion ? 'sh--reduced-motion' : ''}} {{_closing ? 'sh--closing' : ''}} {{_dragOut ? 'sh--drag-out' : ''}} {{fixed ? 'sh--fixed sh--fixed-' + fixed : ''}} {{_lv ? 'sh--lv-' + _lv : ''}} {{_measuring ? 'sh--measure' : ''}} {{_keepMask ? 'sh--keep-mask' : ''}} {{_handoffIn ? 'sh--handoff-in' : ''}}" wx:if="{{_render}}" catchtouchmove="noop" aria-hidden="{{!show || _closing}}" style="{{fullMaxH}}">
  <view class="sh__mask" bindtap="onMask" catchtouchmove="noop" aria-role="button" aria-label="关闭当前面板" hover-class="cy-pressed" hover-stay-time="80"></view>
  <view class="sh__panel {{anchorSelector ? 'sh__panel--morph' : ''}}" catchtap="noop" data-gpanel="1" bindtransitionend="{{gs.sheetSettle}}" change:gcmd="{{gs.sheetCmd}}" gcmd="{{_gestureCmd}}" style="{{(_morphOpen && !_closing) ? '' : _morphStyle}}">
    <!-- bottom:拖拽抓手(full 顶部是导航栏,不用抓手)。触摸挂在 .sh__grip 上而不是 8rpx 高的 .sh__handle:
         grip 用 ::after 反向撑出热区,不加 padding(横条位置是 Figma 给过稿的)。
         qx-u1:跟手在视图层(utils/wxs/gesture.wxs),头部同样能起拖;正文 scroll-view 不起拖,照常滚动。 -->
    <view class="sh__grip" wx:if="{{handle && variant !== 'full'}}"
          catchtouchstart="{{gs.sheetStart}}" catchtouchmove="{{gs.sheetMove}}"
          catchtouchend="{{gs.sheetEnd}}" catchtouchcancel="{{gs.sheetEnd}}"
          data-panel=".sh__panel" data-root=".sh" data-dragcls="sh--dragging" data-off="{{_closing}}"
          data-blocked="{{!maskClosable || dirty}}" data-rm="{{reducedMotion}}" data-wh="{{_winH}}"
          aria-label="向下拖动关闭当前面板">
      <view class="sh__handle"></view>
    </view>

    <!-- full:返回 + 标题 + 关闭。返回只退内部步骤(back),✕ 才是退出任务(requestclose)。
         这一行不再吃 padding-top / padding-right:面板顶已经落在胶囊底下,✕ 直接贴弹层右缘(CU-M-163) -->
    <view class="sh__nav" wx:if="{{variant === 'full' && (navTitle || title || canBack)}}">
      <view class="sh__nav-left">
        <view class="sh__nav-btn" wx:if="{{canBack}}" bindtap="onBack" aria-role="button" aria-label="上一步" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="back" size="34" /></view>
        <view class="sh__nav-title">{{navTitle || title}}</view>
      </view>
      <view class="sh__nav-btn sh__nav-btn--close" wx:if="{{closable}}" bindtap="onClose" data-testid="sheet-close" aria-role="button" aria-label="{{closeLabel}}" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="{{closeIcon}}" size="{{closeIconSize}}" /></view>
    </view>
    <!-- full:步骤进度(steps>1 才画) -->
    <view class="sh__progress" wx:if="{{variant === 'full' && steps > 1}}">
      <view class="sh__progress-seg {{index <= current ? 'sh__progress-seg--on' : ''}}"
            wx:for="{{stepList}}" wx:key="*this"></view>
    </view>

    <!-- 普通与全高共用 title；全高只渲染导航栏，避免重复标题和关闭键。 -->
    <view class="sh__head {{closable ? 'sh__head--closable' : ''}}" wx:if="{{title && variant !== 'full'}}"
          bindtouchstart="{{gs.sheetStart}}" catchtouchmove="{{gs.sheetMove}}"
          bindtouchend="{{gs.sheetEnd}}" bindtouchcancel="{{gs.sheetEnd}}"
          data-panel=".sh__panel" data-root=".sh" data-dragcls="sh--dragging" data-off="{{_closing}}"
          data-blocked="{{!maskClosable || dirty}}" data-rm="{{reducedMotion}}" data-wh="{{_winH}}">
      <view class="sh__title {{closable ? 'sh__title--closable' : ''}}">{{title}}</view>
      <view class="sh__close" wx:if="{{closable}}" bindtap="onClose" data-testid="sheet-close" aria-role="button" aria-label="{{closeLabel}}" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="{{closeIcon}}" size="{{closeIconSize}}" /></view>
    </view>

    <!-- 正文是弹窗内唯一滚动区:长内容在里面滚,滚到头也不会把手势传给底下的页面(整层 catchtouchmove) -->
    <scroll-view class="sh__body" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}"><slot></slot></scroll-view>

    <!-- 底部固定 CTA(命名 slot,处理安全区;full 类必须有,bottom 可选) -->
    <view class="sh__footer" wx:if="{{footer}}"><slot name="footer"></slot></view>
  </view>
  <!-- G-2 物理返回 / 侧滑守卫(utils/native-back-guard.js):0 尺寸、无遮罩,只有最上层弹层挂 -->
  <page-container show="{{_backGuard}}" duration="{{0}}" overlay="{{false}}" custom-style="width:0;height:0;background:transparent;pointer-events:none" bind:afterleave="_onBackGuardLeave" />
</view>
