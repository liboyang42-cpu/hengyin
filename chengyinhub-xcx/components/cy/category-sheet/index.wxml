<cy-sheet show="{{show}}" title="选择分类" bind:close="onClose" footer="{{true}}" back-guard="{{backGuard}}">
  <view class="cs-list" wx:if="{{categoryList.length}}">
    <view class="cs-li {{item.checked ? 'cs-li--on' : ''}} {{item.disabled ? 'cs-li--disabled' : ''}}"
          wx:for="{{categoryList}}"
          wx:key="id"
          data-id="{{item.id}}"
          aria-role="{{num === 1 ? 'radio' : 'checkbox'}}" aria-checked="{{item.checked}}" aria-disabled="{{item.disabled}}" aria-label="{{item.categoryName}}"
          bindtap="toggleCategory" hover-class="cy-pressed" hover-stay-time="80">
      <view class="cs-li-ico"><cy-icon name="{{item.iconName}}" size="40" /></view>
      <view class="cs-li-txt">{{item.categoryName}}</view>
      <view class="cs-li-ok" aria-hidden="true"></view>
    </view>
  </view>
  <cy-empty wx:elif="{{loaded}}" kind="empty" title="暂无分类" />
  <cy-inline-error load-failure wx:elif="{{loadError}}" kind="network" title="{{loadError}}" sub="" action="重试" bind:action="getCategoryList" />
  <cy-skeleton wx:else type="list" count="4" />
  <view slot="footer">
    <cy-btn variant="primary" bindtap="onSave">保存</cy-btn>
  </view>
</cy-sheet>
