@import "../../../style/reduced-motion.wxss";
:host { display: block; }

.fd { display: flex; flex-direction: column; gap: var(--cy-space-2); }

/* label */
.fd__label { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cy-legacy-6); }
.fd__label-t { min-width: 0; word-break: break-word; font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.fd__req { font-size: var(--cy-type-caption); color: var(--cy-color-status-danger); }
.fd__count { margin-left: auto; font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); }
.fd__count--over { color: var(--cy-color-status-danger); }

/* control */
.fd__control {
  position: relative; display: flex; align-items: center; gap: var(--cy-space-2);
  min-height: 88rpx; padding: 0 var(--cy-space-3);
  /* Field 的常态边界由主题决定：深色靠填充分层，浅色保留原有边界。
     旧 input token 作为变量未定义时的兼容兜底。 */
  background: var(--cy-color-input-idle-bg);
  background: var(--cy-comp-field-idle-bg);
  box-shadow: var(--cy-comp-field-shadow, inset 0 0 0 2rpx var(--cy-color-border-subtle));
  box-shadow: var(--cy-comp-field-idle-shadow);
  border-radius: var(--cy-radius-md);
}
.fd--textarea .fd__control { min-height: 200rpx; align-items: stretch; padding: var(--cy-space-3); }

.fd__input, .fd__ta, .fd__val { min-width: 0; flex: 1; font-size: var(--cy-type-body); color: var(--cy-color-input-filled-fg); }
.fd__ta { width: 100%; height: 160rpx; line-height: var(--cy-leading-normal); }
.fd__input { min-height: 88rpx; height: calc(var(--cy-type-body) * 1.5 + 32rpx); }
.fd__val { white-space: normal; word-break: break-word; }
.fd__ph { color: var(--cy-color-text-placeholder); }
.fd__select { min-width: 0; min-height: 88rpx; flex: 1; display: flex; align-items: center; justify-content: space-between; }
.fd__arrow { color: var(--cy-color-text-tertiary); transform: rotate(90deg); transition: transform var(--cy-motion-fast) var(--cy-ease); }
.fd__arrow--up { transform: rotate(-90deg); }

.fd__tail { flex: none; color: var(--cy-color-text-tertiary); }
.fd__tail--ok { color: var(--cy-color-status-success); }
.fd__clear { flex: none; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; }

/* 常态填写不等于聚焦；深色常态不画白边。 */
.is-filled .fd__control {
  background: var(--cy-color-input-filled-bg);
  background: var(--cy-comp-field-filled-bg);
  box-shadow: var(--cy-comp-field-shadow, inset 0 0 0 2rpx var(--cy-color-text-primary));
  box-shadow: var(--cy-comp-field-filled-shadow);
}
.is-focused .fd__control { box-shadow: inset 0 0 0 4rpx var(--cy-color-text-primary); }
.is-error .fd__control { box-shadow: inset 0 0 0 2rpx var(--cy-color-status-danger); }
/* 2026-09-03 用户定:**成功态不描边** —— 填对了是常态,不该再邀功;尾部那枚勾够了。
   错误态的描边保留(它要拦住提交)。 */
.is-disabled .fd__control { background: var(--cy-comp-field-disabled-bg); box-shadow: none; }
.is-disabled .fd__input, .is-disabled .fd__ta, .is-disabled .fd__val, .is-disabled .fd__ph { color: var(--cy-color-text-disabled); }
.is-readonly .fd__control { background: transparent; box-shadow: none; padding-left: 0; }

/* helper / error */
.fd__help { display: flex; align-items: center; gap: 8rpx; min-height: 30rpx; }
.fd__helper { font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); }
.fd__err-i { color: var(--cy-color-status-danger); flex: none; }
.fd__err { font-size: var(--cy-type-caption); color: var(--cy-color-status-danger); }

/* 整行可点的选择字段:没反馈时和只读文本看起来一样 */
.fd__select--press { opacity: 0.7; }

/* isolated 组件内全局 .cy-pressed 进不来,必须本地定义一份。
   只减淡不位移:位移要配 .cy-motion-reduced 兜底,而那个类挂在组件外的祖先上,
   isolated 下同样够不着 —— 与其留个撤不掉的位移,不如按仓库既有组件按压类的做法只减淡。 */
.cy-pressed { opacity: .88; }
