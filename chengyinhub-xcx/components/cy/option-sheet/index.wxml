<cy-sheet inset="{{immediate && rows.length <= 3}}" show="{{show}}" title="{{title}}" closable="{{true}}" footer="{{!immediate}}"
          bind:close="onClose" bind:requestclose="onClose" back-guard="{{backGuard}}">
  <view class="os">
    <view class="os__row {{!immediate && !checkmark ? 'os__row--point' : ''}} {{row.disabled ? 'os__row--off' : ''}} {{row.danger ? 'os__row--danger' : ''}} {{(!immediate && picked === row.index) ? 'os__row--on' : ''}}"
          wx:for="{{rows}}" wx:for-item="row" wx:key="index"
          data-index="{{row.index}}" bindtap="onRow"
          hover-class="{{row.disabled ? '' : 'cy-pressed'}}" hover-stay-time="80"
          aria-role="{{immediate ? 'button' : 'radio'}}"
          aria-label="{{row.label}}"
          aria-selected="{{!immediate && picked === row.index}}"
          aria-checked="{{!immediate && picked === row.index}}"
          aria-disabled="{{row.disabled}}">
      <view class="os__label">{{row.label}}</view>
      <view class="os__dot {{checkmark ? 'os__dot--check' : 'os__dot--point'}}" wx:if="{{!immediate}}" aria-hidden="true"><cy-icon wx:if="{{checkmark && picked === row.index}}" name="check" size="24" /></view>
    </view>
  </view>
  <view slot="footer" wx:if="{{!immediate}}">
    <cy-btn variant="{{picked < 0 ? 'disabled' : 'primary'}}" disabled="{{picked < 0}}" bindtap="onConfirm">{{confirmText}}</cy-btn>
  </view>
</cy-sheet>
