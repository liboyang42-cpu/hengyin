<view class="theme-dark rd">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <view style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <cy-nav-bar plain custom-back bind:back="goBack" />
    <cy-page-title title="纠错进度" safe-top="{{false}}" />
    <view class="rd__body">
      <cy-skeleton wx:if="{{state === 'loading'}}" type="feed-card" count="2" />
      <cy-state-shell wx:elif="{{state === 'missing-param'}}" kind="missing-param" />
      <cy-state-shell wx:elif="{{state === 'no-permission'}}" kind="no-permission"
                      title="暂时不能查看这条纠错" sub="只有提交人本人可以查看纠错进度" />
      <cy-state-shell wx:elif="{{state === 'error'}}" kind="data" title="纠错进度没能加载出来"
                      sub="{{errorSub || '纠错审核不受影响，只是这次没读到'}}" primary="重试" bind:primary="retry" />
      <block wx:else>
        <view class="rd-card">
          <view class="rd-card__head">
            <text class="rd-card__title">{{item.title}}</text>
            <cy-tag variant="{{item.statusTone}}">{{item.statusText}}</cy-tag>
          </view>
          <text class="rd-card__hint">{{item.statusHint}}</text>
          <text class="rd-card__meta">受理编号 {{item.id}}{{item.createText ? ' · 提交于 ' + item.createText : ''}}</text>
          <text class="rd-card__meta" wx:if="{{item.reviewedText}}">审核于 {{item.reviewedText}}</text>
          <text class="rd-card__meta" wx:if="{{item.mergedText}}">更新于 {{item.mergedText}}</text>
          <text class="rd-card__privacy" wx:if="{{item.rewardText}}">{{item.rewardText}}</text>
        </view>

        <view class="rd-section" wx:if="{{item.reviewReason}}">
          <text class="rd-section__label">审核说明</text>
          <text class="rd-section__text">{{item.reviewReason}}</text>
        </view>
        <view class="rd-section" wx:if="{{item.description}}">
          <text class="rd-section__label">你的纠错说明</text>
          <text class="rd-section__text">{{item.description}}</text>
        </view>

        <view class="rd-actions" wx:if="{{item.canSupplement}}">
          <text class="rd-actions__hint">补充说明后，这条纠错会重新进入审核</text>
          <cy-btn variant="secondary" bindtap="openSupplement">补充说明</cy-btn>
        </view>
        <view class="rd-link" bindtap="goMine" aria-role="button" aria-label="查看我的全部纠错"
              hover-class="cy-pressed" hover-stay-time="80">查看我的全部纠错</view>
      </block>
    </view>
  </view>
</view>

<cy-sheet show="{{!!sheet}}" title="{{sheet === 'ok' ? '补充说明已提交' : sheet === 'fail' ? '补充说明没有提交成功' : sheet === 'unknown' ? '还没确认是否提交' : '补充说明'}}"
          closable="{{sheet !== 'busy'}}" mask-closable="{{sheet !== 'busy'}}" dirty="{{sheet === 'form' && !!supplement}}"
          bind:close="closeSheet" bind:requestclose="closeSheet">
  <view class="rd-sheet">
    <block wx:if="{{sheet === 'form'}}">
      <cy-field variant="textarea" label="补充说明" required show-count maxlength="{{maxLength}}"
                placeholder="补充审核需要的事实，比如正确的地址或营业时间"
                value="{{supplement}}" error="{{!!supplementError}}" error-text="{{supplementError}}"
                bind:input="onSupplementInput" />
      <text class="rd-sheet__note">本次补充仅支持文字说明，暂不能附图片或文件。</text>
      <cy-btn variant="primary" bindtap="submitSupplement">提交补充</cy-btn>
    </block>
    <block wx:elif="{{sheet === 'busy'}}">
      <text class="rd-sheet__text">正在提交补充说明…</text>
      <cy-btn variant="primary" loading="{{true}}">提交中</cy-btn>
    </block>
    <block wx:elif="{{sheet === 'ok'}}">
      <text class="rd-sheet__text">这条纠错已重新进入审核，结果会更新在这里。</text>
      <cy-btn variant="primary" bindtap="closeSheet">知道了</cy-btn>
    </block>
    <block wx:elif="{{sheet === 'fail'}}">
      <text class="rd-sheet__text">{{failText}}</text>
      <cy-btn variant="primary" bindtap="closeSheet">知道了</cy-btn>
    </block>
    <block wx:elif="{{sheet === 'unknown'}}">
      <text class="rd-sheet__text">网络不太稳定，暂时没确认是否提交。再试一次不会重复提交。</text>
      <view class="rd-sheet__row">
        <cy-btn variant="secondary" bindtap="closeSheet">稍后再看</cy-btn>
        <cy-btn variant="primary" bindtap="submitSupplement">再试一次</cy-btn>
      </view>
    </block>
  </view>
</cy-sheet>
