<view class="theme-dark">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
<view class="pr-page">
  <cy-nav-bar />
  <cy-page-title title="申请提现" />
  <view class="pr-content">
    <cy-skeleton wx:if="{{!loaded}}" type="amount" count="{{1}}" />
    <view class="pr-row" wx:elif="{{loadErr}}" aria-role="alert">
      <text class="pr-note">{{loadErr}}</text>
      <view class="pr-chip" bindtap="load" aria-role="button" aria-label="重新加载" hover-class="cy-pressed" hover-stay-time="80">重试</view>
    </view>
    <block wx:else>
      <view class="pr-row" wx:if="{{!open}}" aria-role="alert"><text class="pr-note">提现暂未开放，本页不会提交任何申请。</text></view>
      <view class="pr-row">
        <text class="pr-label">本次可申请</text>
        <text class="pr-value">¥{{view.available}}</text>
      </view>
      <view class="pr-row" wx:if="{{!view.wechatReady}}">
        <text class="pr-note">还没有可收款的微信，请先用微信登录小程序，或在城瘾 App 里扫码绑定收款微信。</text>
      </view>
      <view class="pr-row" wx:if="{{view.pendingId}}">
        <text class="pr-label">¥{{view.pendingAmount}}</text>
        <text class="pr-note">{{view.pendingText}}</text>
        <view class="pr-chip" wx:if="{{view.pendingStatus === 'PENDING'}}" bindtap="cancel" aria-role="button" aria-label="撤回这笔提现申请" hover-class="cy-pressed" hover-stay-time="80">撤回</view>
      </view>
      <view class="pr-row" wx:elif="{{open && view.wechatReady}}">
        <text class="pr-label">提现金额</text>
        <input class="pr-input" type="digit" value="{{amount}}" placeholder="{{view.minAmount}} 至 {{view.maxAmount}} 元" bindinput="onAmount" aria-label="提现金额" />
      </view>
      <view class="pr-notice" wx:if="{{notice}}" aria-role="alert">{{notice}}</view>
      <view class="pr-row" wx:for="{{view.last}}" wx:key="id">
        <text class="pr-label">¥{{item.amount}}</text>
        <text class="pr-note">{{item.text}}</text>
      </view>
      <view class="pr-tip">提交后由平台审核，通过后打到你的微信零钱；审核前可以撤回。打款时才从余额扣除。</view>
    </block>
    <view class="pr-bottom" wx:if="{{loaded && !loadErr && open && view.wechatReady && !view.pendingId}}">
      <cy-btn variant="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">提交申请</cy-btn>
    </view>
  </view>
</view>
</view>
