page { background: var(--cy-color-bg-page); }
.rw { min-height: 100vh; color: var(--cy-color-text-primary); }
.rw__body { padding: var(--cy-space-3) var(--cy-page-x, var(--cy-space-4)) calc(var(--cy-space-6) + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: var(--cy-space-3); }
.rw-row { display: flex; flex-direction: column; gap: 4rpx; padding: var(--cy-space-3) 0; border-bottom: 1rpx solid var(--cy-color-border-subtle); }
.rw-row + .rw-row { margin-top: calc(-1 * var(--cy-space-3)); }
.rw-row__head { display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-2); }
.rw-row__title { flex: 1; min-width: 0; font-size: var(--cy-type-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rw-row__sub { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.rw-row__meta { font-size: var(--cy-type-label); color: var(--cy-color-text-tertiary); }
.rw__more { min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); transition: var(--cy-tr-press); }
