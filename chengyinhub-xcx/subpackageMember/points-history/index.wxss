page { background: var(--cy-color-bg-page); }
.ph { min-height: 100vh; display: flex; flex-direction: column; color: var(--cy-color-text-primary); }
/* 2026-11-02 round2:与我的订单/我的参与同一家:标题直接接筛选(顶部不再多垫 space-3),空态在标题下方剩余空间居中(fill) */
.ph__frame { flex: 1; display: flex; flex-direction: column; }
.ph__body { flex: 1; display: flex; flex-direction: column; padding: 0 var(--cy-page-x, var(--cy-space-4)) calc(var(--cy-space-6) + env(safe-area-inset-bottom)); }
.ph-row { display: flex; align-items: flex-start; gap: var(--cy-space-3); padding: var(--cy-space-3) var(--cy-space-4); border-bottom: 1rpx solid var(--cy-color-border-subtle); }
.ph-row:last-child { border-bottom: none; }
.ph-row__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ph-row__side { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.ph-row__reason { font-size: var(--cy-type-body); }
.ph-row__sub { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); font-variant-numeric: tabular-nums; }
.ph-row__delta { font-size: var(--cy-type-body); font-weight: 700; font-variant-numeric: tabular-nums; }
.ph-row__delta.is-income { color: var(--cy-color-brand); }
.ph-row__delta.is-expense { color: var(--cy-color-text-primary); }
.ph__more { padding: var(--cy-space-4) 0; text-align: center; font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); }
/* BL-04 月份分组 */
.ph-group { margin-top: var(--cy-space-5); }
.ph-group__card { background: var(--cy-color-bg-surface); border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); overflow: hidden; }
.ph-group__title { display: block; padding-bottom: var(--cy-space-2); font-size: var(--cy-type-label); font-weight: 700; color: var(--cy-color-text-secondary); }

/* pm20 */
/* 2026-10-23 页面动效(utils/page-motion.js):容器 --pm-* 置 1 时先隐着,再依次浮上来;静止时无过渡,按压反馈不受影响;减少动态效果时从不触发 */
.ph-group { filter: opacity(calc(1 - var(--pm-l, 0))); translate: 0 calc(var(--pm-l, 0) * 31rpx); transition: filter var(--pm-l-d, 0s) ease, translate var(--pm-l-d, 0s) cubic-bezier(.2,.82,.2,1), transform var(--cy-motion-press) var(--cy-ease-out), opacity var(--cy-motion-press) var(--cy-ease-out); transition-delay: calc(var(--pm-l-s, 0) * 0ms), calc(var(--pm-l-s, 0) * 0ms), 0s, 0s; }
.ph-group:nth-child(2) { transition-delay: calc(var(--pm-l-s, 0) * 30ms), calc(var(--pm-l-s, 0) * 30ms), 0s, 0s; }
.ph-group:nth-child(3) { transition-delay: calc(var(--pm-l-s, 0) * 60ms), calc(var(--pm-l-s, 0) * 60ms), 0s, 0s; }
.ph-group:nth-child(4) { transition-delay: calc(var(--pm-l-s, 0) * 90ms), calc(var(--pm-l-s, 0) * 90ms), 0s, 0s; }
.ph-group:nth-child(5) { transition-delay: calc(var(--pm-l-s, 0) * 120ms), calc(var(--pm-l-s, 0) * 120ms), 0s, 0s; }
.ph-group:nth-child(6) { transition-delay: calc(var(--pm-l-s, 0) * 150ms), calc(var(--pm-l-s, 0) * 150ms), 0s, 0s; }
.ph-group:nth-child(7) { transition-delay: calc(var(--pm-l-s, 0) * 180ms), calc(var(--pm-l-s, 0) * 180ms), 0s, 0s; }
.ph-group:nth-child(8) { transition-delay: calc(var(--pm-l-s, 0) * 210ms), calc(var(--pm-l-s, 0) * 210ms), 0s, 0s; }
.ph-group:nth-child(n+9) { transition-delay: calc(var(--pm-l-s, 0) * 240ms), calc(var(--pm-l-s, 0) * 240ms), 0s, 0s; }

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.ph__more { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
