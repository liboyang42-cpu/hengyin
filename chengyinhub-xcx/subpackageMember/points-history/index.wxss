page { background: var(--cy-color-bg-page); }
.ph { min-height: 100vh; color: var(--cy-color-text-primary); }
.ph__body { padding: var(--cy-space-3) var(--cy-page-x, var(--cy-space-4)) var(--cy-space-6); }
.ph-row { display: flex; align-items: center; gap: var(--cy-space-3); padding: var(--cy-space-3) 0; border-bottom: 1rpx solid var(--cy-color-border-subtle); }
.ph-row__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ph-row__reason { font-size: 30rpx; }
.ph-row__sub { font-size: 24rpx; color: var(--cy-color-text-secondary); }
.ph-row__delta { flex: none; font-size: 34rpx; font-weight: 700; }
.ph-row__delta.is-income { color: var(--cy-color-brand); }
.ph-row__delta.is-expense { color: var(--cy-color-text-primary); }
.ph__more { padding: var(--cy-space-4) 0; text-align: center; font-size: 26rpx; color: var(--cy-color-text-secondary); }
