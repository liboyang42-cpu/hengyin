page { background: var(--cy-color-bg-page); }
.ro { min-height: 100vh; color: var(--cy-color-text-primary); }
.ro__body { padding: var(--cy-space-3) var(--cy-page-x, var(--cy-space-4)) calc(var(--cy-space-6) + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: var(--cy-space-4); }
.ro-card { display: flex; flex-direction: column; padding: var(--cy-space-4); border-radius: var(--cy-radius-md, 16rpx); background: var(--cy-color-bg-elevated, rgba(255, 255, 255, 0.06)); }
.ro-card__terms { font-size: var(--cy-type-body); line-height: 1.6; padding-bottom: var(--cy-space-3); }
.ro-card__fact { display: flex; justify-content: space-between; align-items: center; gap: var(--cy-space-3); min-height: 72rpx; border-top: 1rpx solid var(--cy-color-border-subtle); }
.ro-k { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.ro-v { font-size: var(--cy-type-label); text-align: right; }
.ro__block { font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); text-align: center; }
.ro__error { font-size: var(--cy-type-label); color: var(--cy-color-danger, #ff5a5f); text-align: center; }
