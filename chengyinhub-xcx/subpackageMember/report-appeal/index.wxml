<view class="theme-dark ra">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <view style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <cy-nav-bar plain custom-back bind:back="goBack" />
    <cy-page-title title="提交申诉" safe-top="{{false}}" />
    <view class="ra__body">
      <cy-skeleton wx:if="{{state === 'loading'}}" type="feed-card" count="1" />
      <cy-state-shell wx:elif="{{state === 'missing-param'}}" kind="missing-param" />
      <cy-state-shell wx:elif="{{state === 'no-permission'}}" kind="no-permission"
                      title="暂时不能申诉这条举报" sub="只有举报人本人和被举报的用户可以申诉" />
      <cy-state-shell wx:elif="{{state === 'error'}}" kind="data" title="举报信息没能加载出来"
                      sub="申诉还没提交，重新加载后再填写" primary="重试" bind:primary="retry" />
      <cy-state-shell wx:elif="{{state === 'closed'}}" kind="not-started"
                      title="现在还不能申诉" sub="举报当前为「{{report.stageText}}」，平台给出处理结论后才能申诉"
                      primary="返回进度" bind:primary="goBack" />
      <block wx:else>
        <view class="ra-card">
          <view class="ra-card__head">
            <text class="ra-card__title">{{report.targetText}} · 编号 {{report.id}}</text>
            <cy-tag variant="{{report.stageTone}}">{{report.stageText}}</cy-tag>
          </view>
          <text class="ra-card__text" wx:if="{{report.decisionSummary}}">处理结论：{{report.decisionSummary}}</text>
        </view>
        <cy-field variant="textarea" label="申诉理由" required show-count maxlength="{{maxLength}}"
                  placeholder="说明你对处理结论的异议和相关事实"
                  value="{{reason}}" error="{{!!reasonError}}" error-text="{{reasonError}}"
                  bind:input="onReasonInput" />
        <text class="ra-note">本次申诉仅支持文字说明，暂不能附图片或文件。{{mode === 'subject' ? '举报人的身份与举报内容不会向你展示。' : ''}}</text>
        <cy-btn variant="primary" loading="{{phase === 'busy'}}" bindtap="submit">提交申诉</cy-btn>
      </block>
    </view>
  </view>
</view>
<cy-result-sheet show="{{phase === 'busy'}}" kind="loading" title="正在提交申诉" />
<cy-result-sheet show="{{phase === 'ok'}}" kind="success" title="申诉已受理"
                 sub="平台会重新核查，结果会更新在举报进度里" primary-text="查看进度"
                 bind:primary="onResultDone" bind:close="onResultDone" />
<cy-result-sheet show="{{phase === 'fail'}}" kind="fail" title="申诉没有提交成功" why="{{failText}}"
                 primary-text="知道了" bind:primary="onFailClose" bind:close="onFailClose" />
<cy-result-sheet show="{{phase === 'unknown'}}" kind="fail" title="还没确认申诉是否提交"
                 why="网络不太稳定，暂时没读到申诉记录。再试一次不会重复提交。"
                 primary-text="再试一次" secondary-text="稍后再看"
                 bind:primary="onUnknownRetry" bind:secondary="onUnknownLater" bind:close="onUnknownLater" />
