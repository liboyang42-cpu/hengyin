<!-- 深链兼容壳(§4.1):站内一律走订单父页托管的 member-order-detail 场景,这一页只服务外部直达
     (支付回跳、分享链接)。订单详情与支付/退款逻辑只在组件里,这里不复制第二份。 -->
<view class="odt-shell theme-dark">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-nav-bar overlay scrolled="{{navScrolled}}" tint="light" custom-back bind:back="backToOrderList" />
  <cy-page-title title="订单详情" safe-top="{{false}}"
    style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" />
  <cy-scene-member-order-detail wx:if="{{!orderCenter || id}}" id="orderDetail" order-id="{{id}}" bind:back="backToOrderList" bind:close="backToOrderList" />
  <view wx:elif="{{orderCenter}}" class="entry-body" style="padding-top:{{navTop}}px">
    <cy-empty wx:if="{{entryState !== 'ready'}}" kind="{{entryState}}" title="{{entryTitle}}" cta="{{entryAction}}" bind:cta="onEntryAction" style="margin:auto 0" />
    <block wx:elif="{{summary}}">
      <cy-card>
        <view class="entry-title">{{summary.title}}</view>
        <view class="entry-status">{{summary.statusText}}</view>
        <view class="entry-row"><text>金额</text><text class="entry-value">¥{{summary.amountText}}</text></view>
        <view class="entry-row"><text>订单号</text><text class="entry-value" user-select>{{summary.orderNo}}</text></view>
        <view wx:if="{{summary.createdAtText}}" class="entry-row"><text>创建时间</text><text class="entry-value">{{summary.createdAtText}}</text></view>
      </cy-card>
      <button class="entry-button" open-type="contact">联系客服</button>
    </block>
  </view>
</view>
