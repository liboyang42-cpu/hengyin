<view class="theme-dark rp">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <view style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <cy-nav-bar plain custom-back bind:back="goBack" />
    <cy-page-title title="我的举报" safe-top="{{false}}" />
    <view class="rp__body">
      <cy-skeleton wx:if="{{state === 'loading'}}" type="feed-card" count="3" />
      <cy-state-shell wx:elif="{{state === 'error'}}" kind="data" title="举报记录没能加载出来"
                      sub="你的举报不受影响，只是这次没读到" primary="重试" bind:primary="retry" />
      <cy-state-shell wx:elif="{{state === 'empty'}}" kind="empty" title="还没有举报记录"
                      sub="通过平台举报通道提交的举报会出现在这里，可查看处理进度" />
      <block wx:else>
        <cy-tabs variant="chip" tabs="{{tabs}}" active="{{tab}}" bind:change="onTab" />
        <cy-state-shell wx:if="{{!rows.length}}" kind="empty"
                        title="{{tab === 'decided' ? '还没有已出结论的举报' : '没有处理中的举报'}}" sub="切换到「全部」查看所有记录" />
        <view class="rp-row" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail"
              aria-role="button" aria-label="{{item.targetText}}，{{item.reasonText}}，{{item.stageText}}，查看进度"
              hover-class="cy-pressed" hover-stay-time="80">
          <view class="rp-row__main">
            <view class="rp-row__head">
              <text class="rp-row__title">{{item.targetText}} · {{item.reasonText}}</text>
              <cy-tag variant="{{item.stageTone}}">{{item.stageText}}</cy-tag>
            </view>
            <text class="rp-row__sub">编号 {{item.id}}{{item.createText ? ' · ' + item.createText : ''}}</text>
            <text class="rp-row__sub" wx:if="{{item.etaText}}">{{item.etaText}}</text>
          </view>
          <cy-icon class="rp-row__arrow" name="arrow-right" size="28" />
        </view>
        <view class="rp__more" wx:if="{{hasMore}}" bindtap="loadMore" aria-role="button" aria-label="加载更多举报记录"
              hover-class="cy-pressed" hover-stay-time="80">加载更多</view>
        <view class="rp__more rp__more--end" wx:elif="{{rows.length}}">已经到底了</view>
      </block>
    </view>
  </view>
</view>
