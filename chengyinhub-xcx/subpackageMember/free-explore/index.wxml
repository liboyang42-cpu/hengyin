<view class="theme-dark bundle-page"><cy-access-gate kind="login" />
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-nav-bar />
  <view style="height: {{statusBarHeight + navBarHeight}}px;"></view>
  <cy-page-title title="自由探索权益" safe-top="{{false}}" />
  <view class="bundle-content">
    <cy-inline-error wx:if="{{error}}" kind="error" title="{{error}}" />
    <text wx:if="{{notice}}" class="bundle-note">{{notice}}</text>
    <cy-btn wx:if="{{!featureOff}}" variant="secondary" loading="{{loading}}" bindtap="reload">刷新</cy-btn>
    <cy-card wx:if="{{swapPending}}">
      <text class="bundle-title">换店结果确认中</text>
    </cy-card>
    <block wx:if="{{catalog}}">
      <text class="bundle-title">{{catalog.topicName}}</text>
      <text wx:if="{{!catalog.saleEnabled}}" class="bundle-note">暂未开售</text>
      <cy-card wx:for="{{catalog.items}}" wx:key="chapterId">
        <text class="bundle-title">{{item.name}} · 每人{{item.unitsText}}</text>
        <view wx:for="{{item.stores}}" wx:for-item="store" wx:key="offerId">
          <text class="bundle-note">{{store.merchantName}} · {{store.available ? '可用' : '暂不可用'}}</text>
        </view>
      </cy-card>
    </block>
    <cy-card wx:if="{{pending}}">
      <text class="bundle-title">取消结果确认中</text>
      <text class="bundle-note">{{pending.useWaiver ? '使用每月免费取消' : '取消预约'}}</text>
    </cy-card>
    <block wx:if="{{detail}}">
      <text class="bundle-title">订单号 {{detail.registrationNo}}</text>
      <text class="bundle-note">支付：{{detail.paymentText}} · 报名：{{detail.registrationText}}</text>
      <cy-card wx:if="{{detail.refundHold}}">
        <text class="bundle-title">{{detail.refundHold.text}}</text>
      </cy-card>
      <cy-empty wx:if="{{detail.legacy}}" kind="empty" title="这笔订单没有套票权益" />
      <block wx:else>
        <cy-card wx:for="{{detail.units}}" wx:key="id">
          <text class="bundle-title">权益 {{index + 1}} · {{item.statusText}}</text>
          <text class="bundle-note">有效期至 {{item.validTo}}</text>
          <cy-btn wx:if="{{(item.status === 'RESERVED' || item.status === 'AVAILABLE') && !pending && !swapPending}}" variant="secondary" data-id="{{item.id}}" bindtap="loadExitOptions">更换商家</cy-btn>
        </cy-card>
        <view wx:if="{{detail.fulfilledMerchants.length}}">
          <text class="bundle-title">已使用的商家</text>
          <cy-btn wx:for="{{detail.fulfilledMerchants}}" wx:key="merchantId" variant="secondary" data-member-id="{{item.merchantId}}" bindtap="loadReviews">商家评价</cy-btn>
        </view>
        <text class="bundle-title">预约记录</text>
        <cy-empty wx:if="{{!detail.reservations.length}}" kind="empty" title="暂无预约记录" />
        <cy-card wx:for="{{detail.reservations}}" wx:key="id">
          <text class="bundle-title">{{item.startAt}} · {{item.statusText}}</text>
          <view wx:if="{{item.canCancel && !pending && !swapPending}}" class="bundle-actions">
            <cy-btn variant="secondary" data-id="{{item.id}}" data-waiver="false" bindtap="cancelReservation">取消预约</cy-btn>
            <cy-btn variant="secondary" data-id="{{item.id}}" data-waiver="true" bindtap="cancelReservation">使用每月免费取消</cy-btn>
          </view>
          <cy-btn wx:if="{{item.merchantId}}" variant="secondary" data-member-id="{{item.merchantId}}" bindtap="loadReviews">商家评价</cy-btn>
        </cy-card>
        <cy-card wx:if="{{reviewPending}}">
          <text class="bundle-title">评价结果确认中</text>
          <cy-btn variant="secondary" loading="{{reviewBusy}}" bindtap="resumeReview">重新确认</cy-btn>
        </cy-card>
        <cy-card wx:if="{{review}}">
          <text class="bundle-title">商家公开评价</text>
          <text class="bundle-note">{{review.message}}</text>
          <view wx:for="{{review.items}}" wx:key="id">
            <text class="bundle-note">{{item.rating}}星 · {{item.content}}</text>
            <text wx:if="{{item.merchantReply}}" class="bundle-note">商家回复：{{item.merchantReply}}</text>
          </view>
          <text wx:if="{{!review.items.length}}" class="bundle-note">暂无公开评价</text>
          <cy-btn wx:if="{{review.hasMore}}" variant="secondary" loading="{{reviewBusy}}" bindtap="moreReviews">加载更多评价</cy-btn>
          <view wx:if="{{review.canCreate && !reviewPending}}">
            <slider min="1" max="5" step="1" value="{{reviewRating}}" show-value bindchange="rateReview" />
            <textarea value="{{reviewContent}}" maxlength="1000" placeholder="填写本次体验（2～1000字）" bindinput="inputReview" />
            <cy-btn variant="secondary" loading="{{reviewBusy}}" bindtap="submitReview">提交评价</cy-btn>
          </view>
        </cy-card>
        <cy-card wx:if="{{exitOptions}}">
          <text class="bundle-title">更换商家</text>
          <text wx:if="{{!exitOptions.merchantExited}}" class="bundle-note">商家仍可使用，无需更换</text>
          <text wx:elif="{{!exitOptions.targets.length}}" class="bundle-note">暂无可更换的商家</text>
          <cy-btn wx:for="{{exitOptions.targets}}" wx:key="offerId" variant="secondary" data-id="{{item.offerId}}" bindtap="consentSwap">改选 {{item.merchantName}}</cy-btn>
        </cy-card>
        <text wx:if="{{detail.exitCases.length}}" class="bundle-title">售后记录</text>
        <cy-card wx:for="{{detail.exitCases}}" wx:key="id"><text class="bundle-note">{{item.text}}</text></cy-card>
        <cy-btn variant="secondary" bindtap="loadQuote">查看可退金额</cy-btn>
        <cy-card wx:if="{{quote}}">
          <text class="bundle-title">可退金额 {{quote.amount || '—'}} 元</text>
          <text class="bundle-note">{{quote.reason}}</text>
          <text class="bundle-note">{{quote.notice}}</text>
        </cy-card>
      </block>
    </block>
  </view>
</view>
