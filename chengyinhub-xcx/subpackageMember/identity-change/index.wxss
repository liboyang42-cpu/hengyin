page { background: var(--cy-bg-page); }
.ic-page { min-height: 100vh; display: flex; flex-direction: column; color: var(--cy-text-title); }
.ic-content { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: var(--cy-space-3); box-sizing: border-box; padding: 0 var(--cy-page-x) var(--cy-space-7); }

.ic-card { display: flex; flex-direction: column; gap: var(--cy-space-1); padding: var(--cy-space-3) var(--cy-space-4); border-radius: var(--cy-radius-md); background: var(--cy-bg-card); }
.ic-card__title { font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-text-title); }
.ic-card__text { font-size: var(--cy-font-label); color: var(--cy-text-secondary); line-height: var(--cy-leading-normal); }
.ic-link { align-self: flex-start; min-height: var(--cy-btn-h); display: inline-flex; align-items: center; font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-text-title); }
.ic-link.is-busy { opacity: var(--cy-opacity-disabled); }

.ic-form { display: flex; flex-direction: column; gap: var(--cy-space-3); }
.ic-section { font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-text-title); }
.ic-field { padding: var(--cy-space-3) var(--cy-space-4); border-radius: var(--cy-radius-md); background: var(--cy-color-input-bg-empty); }
.ic-field--filled { background: var(--cy-color-input-bg-filled); }
.ic-label { display: block; font-size: var(--cy-font-label); color: var(--cy-text-secondary); margin-bottom: var(--cy-space-1); }
.ic-req { color: var(--cy-danger); margin-left: var(--cy-legacy-6); }
.ic-input { width: 100%; box-sizing: border-box; height: 64rpx; font-size: var(--cy-font-body); color: var(--cy-color-input-text); }
.ic-textarea { width: 100%; box-sizing: border-box; min-height: 160rpx; font-size: var(--cy-font-body); color: var(--cy-color-input-text); line-height: var(--cy-leading-normal); }
.ic-ph { color: var(--cy-color-input-placeholder); }
