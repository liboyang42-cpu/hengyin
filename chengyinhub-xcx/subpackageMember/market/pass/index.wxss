page { background: var(--cy-color-bg-page); }
.mp { min-height: 100vh; display: flex; flex-direction: column; color: var(--cy-color-text-primary); }
.mp__frame { flex: 1; display: flex; flex-direction: column; }
.mp__body { flex: 1; display: flex; flex-direction: column; gap: var(--cy-space-3); padding: 0 var(--cy-page-x, var(--cy-space-4)) calc(320rpx + env(safe-area-inset-bottom)); }
.mp-sec { margin-top: var(--cy-space-2); font-size: var(--cy-type-label); font-weight: 700; color: var(--cy-color-text-secondary); }
.mp-group { background: var(--cy-color-bg-surface); border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); overflow: hidden; }
.mp-row { display: flex; justify-content: space-between; align-items: center; gap: var(--cy-space-3); min-height: 88rpx; box-sizing: border-box; padding: var(--cy-space-3) var(--cy-space-4); border-bottom: 1rpx solid var(--cy-color-border-subtle); }
.mp-row:last-child { border-bottom: none; }
.mp-row__k { font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); flex: none; }
.mp-row__k--main { color: var(--cy-color-text-primary); flex: 1; min-width: 0; }
.mp-row__v { font-size: var(--cy-type-body); text-align: right; min-width: 0; }
.mp-row__v--strong { font-weight: 700; font-variant-numeric: tabular-nums; }
.mp-hero { padding: var(--cy-space-4) 0 var(--cy-space-6); }
.mp-for { margin-top: var(--cy-space-2); }
.mp-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: var(--cy-space-2); padding: var(--cy-space-3) var(--cy-page-x, var(--cy-space-4)) calc(var(--cy-space-3) + env(safe-area-inset-bottom)); background: var(--cy-color-bg-page); border-top: 1rpx solid var(--cy-color-border-subtle); }
.mp-bar__reason { min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); }
.mp-bar__note { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); text-align: center; }
.mp-gift { padding: var(--cy-space-4) 0; font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); text-align: center; }
.mp-share { width: 100%; min-height: 88rpx; line-height: 88rpx; border-radius: var(--cy-radius-pill); background: var(--cy-color-text-primary); color: var(--cy-color-bg-page); font-size: var(--cy-type-body); font-weight: 600; }
.mp-sum .mp-row.is-off .mp-row__v { color: var(--cy-color-text-secondary); font-weight: 500; }
.mp-sum__k { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.mp-sum__note { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
