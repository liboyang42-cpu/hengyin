/* l-pass 游戏主题库。卡片沿用俱乐部卡 / photo-card 结构(原型 .pc2):214px 高、22px 圆角、封面铺满、底部四段黑渐变。 */
.lb { min-height: 100vh; background: var(--cy-color-bg-page); color: var(--cy-color-text-primary); }
.lb__body { padding: 0 var(--cy-space-4, 32rpx); }
.lb__chips { display: flex; gap: 16rpx; margin: 8rpx 0 28rpx; }
.lb__chip { min-height: 64rpx; line-height: 64rpx; padding: 0 28rpx; border-radius: 999rpx; background: var(--cy-color-bg-surface-strong); color: var(--cy-color-text-secondary); font-size: 26rpx; }
.lb__chip.is-on { background: var(--cy-color-text-primary); color: var(--cy-color-bg-page); }
.lb__list { display: flex; flex-direction: column; gap: 24rpx; }
.lb__card { position: relative; display: flex; flex-direction: column; min-height: 428rpx; padding: 28rpx 24rpx; border-radius: 44rpx; overflow: hidden; background: #30383D; color: #FFFFFF; /* ds-ok 来源 photo-card 底色 */ }
.lb__cv { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.lb__gr { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(0, 0, 0, .24) 0%, rgba(0, 0, 0, .14) 32%, rgba(0, 0, 0, .7) 60%, rgba(0, 0, 0, .94) 100%); /* ds-ok 来源 .cc__gradient */ }
.lb__top { position: relative; display: flex; align-items: center; gap: 16rpx; min-height: 56rpx; }
.lb__logo { width: 56rpx; height: 56rpx; border-radius: 14rpx; background: #FFFFFF; color: #111111; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 900; /* ds-ok 城标 */ }
.lb__tag { padding: 6rpx 14rpx; border-radius: 24rpx; background: rgba(255, 255, 255, .12); color: rgba(255, 255, 255, .82); font-size: 22rpx; line-height: 28rpx; /* ds-ok */ }
.lb__tag--z { background: #CDFF71; color: #121213; font-weight: 800; /* ds-ok 柠檬绿 ¥0 */ }
.lb__sp { flex: 1; min-height: 80rpx; }
.lb__main { position: relative; display: flex; flex-direction: column; gap: 8rpx; }
.lb__name { font-size: 36rpx; font-weight: 700; line-height: 50rpx; }
.lb__data { font-size: 22rpx; line-height: 30rpx; color: rgba(255, 255, 255, .84); /* ds-ok */ }
.lb__bottom { display: flex; align-items: flex-end; gap: 16rpx; }
.lb__tags { display: flex; flex: 1; flex-wrap: wrap; gap: 12rpx; }
.lb__chev { color: rgba(255, 255, 255, .8); /* ds-ok */ }
.lb__pad { height: 80rpx; }
