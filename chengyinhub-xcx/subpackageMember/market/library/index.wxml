<!-- l-pass 游戏主题库(原型 ps-library):俱乐部卡式,一行一张,底部渐变,不写数量。行只读 GET /api/platform-pass/library。 -->
<view class="theme-dark lb"><cy-access-gate kind="login" />
  <cy-toast id="cy-toast" />
  <view class="lb__frame" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <cy-nav-bar plain custom-back bind:back="goBack" />
    <cy-page-title title="游戏主题库" safe-top="{{false}}" />
    <view class="lb__body">
      <view class="lb__chips" aria-role="tablist">
        <view wx:for="{{filters}}" wx:key="key" class="lb__chip {{item.key === filter ? 'is-on' : ''}}" data-key="{{item.key}}" bindtap="onFilter"
              aria-role="tab" aria-selected="{{item.key === filter}}" hover-class="cy-pressed" hover-stay-time="80">{{item.label}}</view>
      </view>
      <cy-skeleton wx:if="{{state === 'loading'}}" type="list" count="3" />
      <cy-error wx:elif="{{state === 'error'}}" title="加载失败" retry="重试" bind:retry="load" />
      <cy-empty wx:elif="{{state === 'off'}}" fill class="cy-fill-state" size="lg" kind="empty" title="通行证暂未开放" />
      <cy-empty wx:elif="{{!rows.length}}" fill class="cy-fill-state" size="lg" kind="empty" title="暂无可玩主题" />
      <view wx:else class="lb__list">
        <view wx:for="{{rows}}" wx:key="id" class="lb__card" data-id="{{item.id}}" bindtap="openTopic"
              aria-role="button" aria-label="{{item.name}}" hover-class="cy-pressed" hover-stay-time="80">
          <image class="lb__cv" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" lazy-load />
          <view class="lb__gr"></view>
          <view class="lb__top">
            <text class="lb__logo">城</text>
            <text class="lb__tag lb__tag--z" wx:if="{{covered}}">¥0 可玩</text>
          </view>
          <view class="lb__sp"></view>
          <view class="lb__main">
            <text class="lb__name">{{item.name}}</text>
            <text class="lb__data" wx:if="{{item.data}}">{{item.data}}</text>
            <view class="lb__bottom">
              <view class="lb__tags"><text class="lb__tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text></view>
              <cy-icon class="lb__chev" name="chevron-right" size="24" />
            </view>
          </view>
        </view>
      </view>
      <view class="lb__pad"></view>
    </view>
  </view>
</view>
