page { background: var(--cy-color-bg-page); }
.gf { min-height: 100vh; display: flex; flex-direction: column; color: var(--cy-color-text-primary); }
.gf__frame { flex: 1; display: flex; flex-direction: column; }
.gf__bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: var(--cy-space-2); padding: var(--cy-space-3) var(--cy-page-x, var(--cy-space-4)) calc(var(--cy-space-3) + env(safe-area-inset-bottom)); }
.gf__note { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); text-align: center; }
.gf-hero { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--cy-space-4); padding: 0 var(--cy-page-x, var(--cy-space-4)) 240rpx; text-align: center; }
.gf-hero__badge { position: relative; width: 176rpx; height: 176rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: var(--cy-color-brand-soft); color: var(--cy-color-brand); transition: opacity 480ms cubic-bezier(.3,1.3,.5,1), transform 480ms cubic-bezier(.3,1.3,.5,1); }
/* 进场:页面 enter(gfIn) 先挂 gf--pre(缩小、转一点、透明),34ms 后撤掉,徽章弹回原位 */
.gf--pre .gf-hero__badge { opacity: 0; transform: scale(.7) rotate(-8deg); transition: none; }
/* 光圈:beats(gfGlow) 每 2.4s 一轮 —— 0 复位(无过渡),1 用 1.68s(原 70% 处)向外扩开淡出,余下 30% 停在隐身 */
.gf-hero__glow { position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 50%; border: 3rpx solid var(--cy-color-brand); opacity: 0; transform: scale(1.3); transition: opacity 1.68s ease-out, transform 1.68s ease-out; }
.gf-glow--0 .gf-hero__glow { opacity: .6; transform: scale(.9); transition: none; }
.gf-hero.is-off .gf-hero__badge { background: var(--cy-color-bg-elevated); color: var(--cy-color-text-secondary); }
.gf-hero.is-done .gf-hero__badge { background: var(--cy-color-status-success-soft); color: var(--cy-color-status-success); }
.gf-hero__title { font-size: var(--cy-type-section-title); font-weight: 700; color: var(--cy-color-text-primary); }
@media (prefers-reduced-motion: reduce) { .gf-hero .gf-hero__badge { opacity: 1; transform: none; transition: none; } .gf-hero .gf-hero__glow { opacity: 0; transition: none; } }
