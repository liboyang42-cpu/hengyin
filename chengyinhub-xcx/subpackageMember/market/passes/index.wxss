page { background: var(--cy-color-bg-page); }
.mk { min-height: 100vh; display: flex; flex-direction: column; color: var(--cy-color-text-primary); }
.mk__frame { flex: 1; display: flex; flex-direction: column; }
.mk__body { flex: 1; display: flex; flex-direction: column; gap: var(--cy-space-3); padding: 0 var(--cy-page-x, var(--cy-space-4)) calc(var(--cy-space-6) + env(safe-area-inset-bottom)); }
.mk-card { display: flex; flex-direction: column; gap: var(--cy-space-1-5); padding: var(--cy-space-4); background: var(--cy-color-bg-surface); border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); }
.mk-card__head { display: flex; gap: var(--cy-space-2); }
.mk-card__kind, .mk-card__city { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.mk-card__name { font-size: var(--cy-type-title, 34rpx); font-weight: 700; }
.mk-card__meta, .mk-card__cover { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.mk-card__foot { display: flex; justify-content: space-between; align-items: baseline; gap: var(--cy-space-3); margin-top: var(--cy-space-1); }
.mk-card__price { font-size: var(--cy-type-body); font-weight: 700; font-variant-numeric: tabular-nums; }
.mk-group { background: var(--cy-color-bg-surface); border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); overflow: hidden; }
.mk-group__title { display: block; margin-top: var(--cy-space-2); font-size: var(--cy-type-label); font-weight: 700; color: var(--cy-color-text-secondary); }
.mk-row { display: flex; align-items: flex-start; gap: var(--cy-space-3); min-height: 88rpx; box-sizing: border-box; padding: var(--cy-space-3) var(--cy-space-4); border-bottom: 1rpx solid var(--cy-color-border-subtle); }
.mk-row:last-child { border-bottom: none; }
.mk-row__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.mk-row__side { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.mk-row__title { font-size: var(--cy-type-body); }
.mk-row__sub { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); font-variant-numeric: tabular-nums; }
.mk-row__amt { font-size: var(--cy-type-body); font-weight: 700; font-variant-numeric: tabular-nums; }
