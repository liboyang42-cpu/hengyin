<!-- l-pass 通行证(我的 → 通行证与礼品 → 通行证)。原型 proto/game ps-pass + ps-success。数字只读服务端。
     l-iconsB 2026-11-11:页面按 proto/icons ps-pass 改回标准玩家样式;商家账号只给一句原因。 -->
<view class="theme-dark pp"><cy-access-gate kind="login" />
  <cy-toast id="cy-toast" />
  <view class="pp__frame" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <cy-nav-bar overlay scrolled="{{scrolled}}" tint="light" custom-back title="通行证" bind:back="goBack" />
    <cy-skeleton wx:if="{{state === 'loading'}}" type="list" count="3" />
    <cy-error wx:elif="{{state === 'error'}}" title="加载失败" retry="重试" bind:retry="load" />
    <cy-empty wx:elif="{{state === 'merchant'}}" fill class="cy-fill-state" size="lg" kind="empty" title="商家账号没有通行证" />
    <cy-empty wx:elif="{{!view.enabled}}" fill class="cy-fill-state" size="lg" kind="empty" title="通行证暂未开放" />
    <view wx:else class="pp__body">
      <!-- l-iconsB:proto/icons ps-pass 标准玩家样式(实色卡 + 标准列表行 + 底部固定药丸,不做玻璃)。卡里只写服务端给的事实 -->
      <view class="pp__card">
        <view class="pp__card-top">
          <view class="pp__card-t">
            <text class="pp__eb">城瘾通行证</text>
            <text class="pp__h">{{view.active ? '已开通' : '未开通'}}</text>
            <text class="pp__k" wx:if="{{view.active && view.untilText}}">有效期至 {{view.untilText}}</text>
          </view>
          <view class="pp__key"><cy-illus name="key" size="184" /></view>
        </view>
      </view>

      <view class="pp__list">
        <view class="pp__row" bindtap="goLibrary" aria-role="button" aria-label="可玩主题库" hover-class="cy-pressed" hover-stay-time="80">
          <view class="pp__ic"><cy-illus name="seal" size="72" bare /></view>
          <view class="pp__row-m"><text class="pp__row-t">可玩主题库</text><text class="pp__row-s" wx:if="{{view.count !== null}}">{{view.count}} 个主题 · 持证 ¥0</text></view>
          <cy-icon name="chevron-right" size="32" />
        </view>
      </view>

      <view class="pp__plans" wx:if="{{view.plans.length}}" aria-role="radiogroup">
        <view wx:for="{{view.plans}}" wx:key="code" class="pp__plan {{item.on ? 'is-on' : ''}}" data-code="{{item.code}}" bindtap="onPlan"
              aria-role="radio" aria-checked="{{item.on}}" aria-label="{{item.line}} {{item.price}}" hover-class="cy-pressed" hover-stay-time="80">
          <text class="pp__rib" wx:if="{{item.best}}">最划算</text>
          <text class="pp__plan-p">{{item.price}}</text>
          <text class="pp__plan-l">{{item.line}}</text>
        </view>
      </view>
      <view wx:if="{{view.active && view.plans.length}}" class="pp__renew {{view.buyOff || buying ? 'is-off' : ''}}" bindtap="onBuy" aria-role="button" aria-disabled="{{view.buyOff}}" aria-label="{{view.buyLabel}}" hover-class="cy-pressed" hover-stay-time="80">{{buying ? '处理中…' : view.buyLabel}}</view>
      <text class="pp__terms" wx:if="{{view.terms}}">{{view.terms}}</text>
      <cy-inline-error class="pp__err" wx:if="{{buyError}}" kind="field" title="{{buyError}}" />
      <view class="pp__pad"></view>
    </view>
  </view>

  <view class="pp__foot" wx:if="{{state === 'ready' && view.enabled}}">
    <view wx:if="{{view.active}}" class="pp__pill" bindtap="goLibrary" aria-role="button" aria-label="去主题库" hover-class="cy-pressed" hover-stay-time="80">去主题库</view>
    <view wx:else class="pp__pill {{view.buyOff || buying ? 'is-off' : ''}}" bindtap="onBuy" aria-role="button" aria-disabled="{{view.buyOff}}" aria-label="{{view.buyLabel}}" hover-class="cy-pressed" hover-stay-time="80">{{buying ? '处理中…' : view.buyLabel}}</view>
  </view>

  <!-- ps-success:服务端订单 PAID 才出现。钥匙飞入 → 锁打开 → 积分币弹出 → 文案与封面升起。只用过渡。 -->
  <view class="ok {{ok.show ? 'is-show' : ''}} {{ok.step >= 1 ? 's1' : ''}} {{ok.step >= 2 ? 's2' : ''}} {{ok.step >= 3 ? 's3' : ''}} {{reduced ? 'is-reduced' : ''}}" wx:if="{{ok.mounted}}" aria-hidden="{{!ok.show}}">
    <text class="ok__skip" style="top: {{statusBarHeight + navBarHeight + 8}}px;" bindtap="goLibrary" aria-role="button" aria-label="跳过" hover-class="cy-pressed" hover-stay-time="80">跳过</text>
    <view class="ok__scene">
      <view class="ok__lock">
        <view class="ok__lk"><cy-illus name="locked" size="280" loop="{{false}}" /></view>
        <view class="ok__unl"><cy-illus name="unlocked" size="280" loop="{{false}}" /></view>
      </view>
      <view class="ok__keyfly"><cy-illus name="key" size="300" loop="{{false}}" /></view>
      <view class="ok__coin ok__coin--{{index}}" wx:for="{{[0,1,2,3]}}" wx:key="*this"><cy-illus name="points" size="88" bare loop="{{false}}" /></view>
    </view>
    <view class="ok__copy">
      <text class="ok__k">通行证 · 已开通</text>
      <text class="ok__t" wx:if="{{view.count !== null}}">{{view.count || 0}} 个主题，全部可玩</text>
      <text class="ok__s" wx:if="{{ok.untilText}}">到 {{ok.untilText}} · 价格都是 ¥0</text>
      <view class="ok__thumbs" wx:if="{{library.length}}">
        <image wx:for="{{library}}" wx:key="id" wx:if="{{index < 5 && item.cover}}" class="ok__th" style="transition-delay: {{index * 80}}ms;" src="{{item.cover}}" mode="aspectFill" />
      </view>
    </view>
    <view class="ok__foot"><view class="ok__pill" bindtap="goLibrary" aria-role="button" aria-label="进入可玩主题库" hover-class="cy-pressed" hover-stay-time="80">进入可玩主题库</view></view>
  </view>
</view>
