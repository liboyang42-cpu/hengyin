<!-- l-pass 通行证(我的 → 通行证与礼品 → 通行证)。原型 proto/game ps-pass。数字只读服务端。
     l-icons 2026-11-11:开通成功的 ps-success 层换成 subpackagePass/reveal 的钥匙开场(完整版);英雄区的插图换成 3D 玻璃序列帧;页面本身不做玻璃。 -->
<view class="theme-dark pp"><cy-access-gate kind="login" />
  <cy-toast id="cy-toast" />
  <view class="pp__frame" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <cy-nav-bar overlay scrolled="{{scrolled}}" tint="light" custom-back title="通行证" bind:back="goBack" />
    <cy-skeleton wx:if="{{state === 'loading'}}" type="list" count="3" />
    <cy-error wx:elif="{{state === 'error'}}" title="加载失败" retry="重试" bind:retry="load" />
    <cy-empty wx:elif="{{state === 'merchant'}}" fill class="cy-fill-state" size="lg" kind="empty" title="商家账号没有通行证" />
    <cy-empty wx:elif="{{!view.enabled}}" fill class="cy-fill-state" size="lg" kind="empty" title="通行证暂未开放" />
    <view wx:else class="pp__body">
      <view class="pp__hero">
        <view class="pp__art">
          <!-- l-icons:通行证是奖励时刻,用 3D 玻璃序列帧(proto/icons A 风格烤帧);页面其余仍是普通玩家样式,不做玻璃 -->
          <cy-frames sheets="{{[{ src: '/subpackageMember/images/frames/glass-pass.webp', n: 24 }]}}" cols="{{6}}" fw="{{112}}" fh="{{112}}" w="{{300}}" h="{{300}}" fps="{{10}}" reduced-motion="{{reduced}}" />
          <view class="pp__key"><cy-frames sheets="{{[{ src: '/subpackageMember/images/frames/glass-key.webp', n: 24 }]}}" cols="{{6}}" fw="{{112}}" fh="{{112}}" w="{{140}}" h="{{140}}" fps="{{10}}" delay="{{500}}" reduced-motion="{{reduced}}" /></view>
        </view>
        <view class="pp__cnt" wx:if="{{view.count !== null}}"><text class="pp__cnt-n">{{view.count}}</text><text class="pp__cnt-u">个主题 全部可玩</text></view>
        <text class="pp__until" wx:if="{{view.active && view.untilText}}">有效期至 {{view.untilText}}</text>
      </view>

      <view class="pp__plans" wx:if="{{view.plans.length}}" aria-role="radiogroup">
        <view wx:for="{{view.plans}}" wx:key="code" class="pp__plan {{item.on ? 'is-on' : ''}}" data-code="{{item.code}}" bindtap="onPlan"
              aria-role="radio" aria-checked="{{item.on}}" aria-label="{{item.line}} {{item.price}}" hover-class="cy-pressed" hover-stay-time="80">
          <text class="pp__rib" wx:if="{{item.best}}">最划算</text>
          <text class="pp__plan-p">{{item.price}}</text>
          <text class="pp__plan-l">{{item.line}}</text>
        </view>
      </view>
      <view class="pp__pill {{view.buyOff || buying ? 'is-off' : ''}}" bindtap="onBuy" aria-role="button" aria-disabled="{{view.buyOff}}" aria-label="{{view.buyLabel}}" hover-class="cy-pressed" hover-stay-time="80">{{buying ? '处理中…' : view.buyLabel}}</view>
      <text class="pp__terms" wx:if="{{view.terms}}">{{view.terms}}</text>
      <cy-inline-error class="pp__err" wx:if="{{buyError}}" kind="field" title="{{buyError}}" />

      <block wx:if="{{library.length}}">
        <text class="pp__sec">可玩主题库</text>
        <view class="pp__lib">
          <view wx:for="{{library}}" wx:key="id" wx:if="{{index < 4}}" class="pp__it" data-id="{{item.id}}" bindtap="openTopic" aria-role="button" aria-label="{{item.name}}" hover-class="cy-pressed" hover-stay-time="80">
            <image class="pp__it-cv" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" lazy-load />
            <text class="pp__it-z">¥0</text>
            <text class="pp__it-n">{{item.name}}</text>
            <text class="pp__it-d" wx:if="{{item.data}}">{{item.data}}</text>
          </view>
        </view>
        <view class="pp__more" bindtap="goLibrary" aria-role="button" aria-label="进入游戏主题库" hover-class="cy-pressed" hover-stay-time="80"><text>进入游戏主题库</text><cy-icon name="chevron-right" size="28" /></view>
      </block>
      <view class="pp__pad"></view>
    </view>
  </view>

</view>
