/* l-pass 通行证页。原型 proto/game page.css .pass2 / .lib / .psok 改写:只用 transition,不新增 keyframes。 */
.pp { --pp-warm-hi: #B8431A; --pp-warm-mid: #3B1708; --pp-ink: #FFF4EA; --pp-sub: rgba(255, 244, 234, .75); --pp-gold: #FFD9A8; /* ds-ok 参考 refs4 暖橙渐变与票面金(物件固有色) */
  min-height: 100vh; color: var(--pp-ink);
  background: radial-gradient(ellipse 90% 60% at 50% 0%, var(--pp-warm-hi) 0%, var(--pp-warm-mid) 45%, #000 85%); /* ds-ok 原型 .pass2 */ }
.pp__frame { min-height: 100vh; }
.pp__body { padding: 0 var(--cy-space-4, 32rpx); }
.pp__hero { display: flex; flex-direction: column; align-items: center; padding: 20rpx 0 12rpx; }
.pp__art { position: relative; width: 300rpx; height: 300rpx; }
.pp__key { position: absolute; right: -52rpx; bottom: -12rpx; }
.pp__cnt { display: flex; align-items: baseline; margin-top: 12rpx; }
.pp__cnt-n { font-size: 88rpx; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
.pp__cnt-u { margin-left: 12rpx; font-size: 32rpx; font-weight: 600; color: var(--pp-sub); }
.pp__until { margin-top: 12rpx; font-size: 28rpx; color: var(--pp-sub); }
.pp__plans { display: flex; gap: 20rpx; margin: 36rpx 0 24rpx; }
.pp__plan { position: relative; flex: 1; min-height: 88rpx; padding: 28rpx; border-radius: 36rpx; background: rgba(255, 255, 255, .08); border: 3rpx solid transparent; transition: background 200ms ease, border-color 200ms ease; /* ds-ok 原型 .plan */ }
.pp__plan.is-on { border-color: var(--pp-gold); background: rgba(255, 255, 255, .14); /* ds-ok */ }
.pp__plan-p { display: block; font-size: 44rpx; font-weight: 800; }
.pp__plan-l { display: block; margin-top: 4rpx; font-size: 24rpx; color: var(--pp-sub); }
.pp__rib { position: absolute; right: 20rpx; top: -18rpx; padding: 4rpx 16rpx; border-radius: 999rpx; background: var(--pp-gold); color: var(--pp-warm-mid); font-size: 20rpx; font-weight: 700; }
.pp__pill { height: 100rpx; border-radius: 50rpx; background: #FFFFFF; color: #111111; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; /* ds-ok 原型白药丸 */ }
.pp__pill.is-off { opacity: .45; }
.pp__terms { display: block; text-align: center; margin: 20rpx 0 8rpx; font-size: 22rpx; color: rgba(255, 244, 234, .55); /* ds-ok */ }
.pp__err { display: block; text-align: center; margin-top: 8rpx; font-size: 24rpx; color: var(--cy-color-status-danger); }
.pp__sec { display: block; margin: 44rpx 0 20rpx; font-size: 30rpx; font-weight: 700; color: rgba(255, 244, 234, .7); /* ds-ok */ }
.pp__lib { display: flex; flex-wrap: wrap; gap: 24rpx; }
.pp__it { position: relative; width: calc(50% - 12rpx); border-radius: 32rpx; overflow: hidden; background: var(--cy-color-bg-surface); }
.pp__it-cv { display: block; width: 100%; height: 220rpx; }
.pp__it-z { position: absolute; right: 16rpx; top: 16rpx; height: 44rpx; padding: 0 16rpx; border-radius: 22rpx; background: var(--cy-color-status-success); color: #FFFFFF; font-size: 24rpx; line-height: 44rpx; font-weight: 700; /* ds-ok ¥0 绿角标白字 */ }
.pp__it-n { display: block; padding: 16rpx 20rpx 4rpx; font-size: 28rpx; color: var(--cy-color-text-primary); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pp__it-d { display: block; padding: 0 20rpx 20rpx; font-size: 24rpx; color: var(--cy-color-text-tertiary); }
.pp__more { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 88rpx; margin-top: 16rpx; font-size: 28rpx; color: var(--pp-ink); }
.pp__pad { height: 80rpx; }

/* ps-success:钥匙 / 开锁(原型 .psok)。步骤 s1/s2/s3 只切 transform / opacity。 */
.ok { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 50; color: var(--pp-ink);
  background: radial-gradient(ellipse 90% 60% at 50% 100%, var(--pp-warm-hi) 0%, var(--pp-warm-mid) 45%, #0B0908 80%); /* ds-ok 原型 .psok */
  opacity: 0; transition: opacity 400ms ease; }
.ok.is-show { opacity: 1; }
.ok__skip { position: absolute; right: 200rpx; z-index: 2; min-height: 64rpx; line-height: 64rpx; padding: 0 12rpx; font-size: 28rpx; color: rgba(255, 244, 234, .7); /* ds-ok */ }
.ok__scene { position: absolute; left: 0; right: 0; top: 22%; height: 680rpx; }
.ok__lock { position: absolute; left: 50%; top: 40rpx; width: 280rpx; height: 280rpx; margin-left: -140rpx; opacity: 0; transform: translateY(40rpx) scale(.8); transition: transform 800ms cubic-bezier(.16, 1, .3, 1) 200ms, opacity 500ms ease 200ms; }
.ok.is-show .ok__lock { opacity: 1; transform: none; }
.ok__lk, .ok__unl { position: absolute; left: 0; top: 0; transition: opacity 300ms ease; }
.ok__unl { opacity: 0; }
.ok.s2 .ok__unl { opacity: 1; }
.ok.s2 .ok__lk { opacity: 0; }
.ok__keyfly { position: absolute; left: 50%; top: 380rpx; margin-left: -150rpx; transform-origin: 70% 50%; opacity: 0; transform: translate(-260rpx, 260rpx) rotate(-30deg) scale(.6); transition: transform 1400ms cubic-bezier(.16, 1, .3, 1), opacity 400ms ease; }
.ok.s1 .ok__keyfly { opacity: 1; transform: translate(40rpx, -60rpx) rotate(0deg) scale(.7); }
.ok.s2 .ok__keyfly { transform: translate(40rpx, -60rpx) rotate(90deg) scale(.7); transition: transform 600ms ease-in-out; }
.ok__coin { position: absolute; left: 50%; top: 300rpx; opacity: 0; transform: translate(0, 80rpx) scale(.2); transition: transform 900ms cubic-bezier(.2, 1.4, .5, 1), opacity 300ms ease; }
.ok.s2 .ok__coin { opacity: 1; }
.ok.s2 .ok__coin--0 { transform: translate(-240rpx, 40rpx); transition-delay: 0ms; }
.ok.s2 .ok__coin--1 { transform: translate(120rpx, -20rpx); transition-delay: 120ms; }
.ok.s2 .ok__coin--2 { transform: translate(-60rpx, -120rpx); transition-delay: 240ms; }
.ok.s2 .ok__coin--3 { transform: translate(220rpx, 80rpx); transition-delay: 360ms; }
.ok__copy { position: absolute; left: 56rpx; right: 56rpx; top: 60%; display: flex; flex-direction: column; align-items: center; text-align: center; opacity: 0; transform: translateY(32rpx); transition: transform 700ms cubic-bezier(.16, 1, .3, 1), opacity 500ms ease; }
.ok.s3 .ok__copy { opacity: 1; transform: none; }
.ok__k { font-size: 24rpx; letter-spacing: .2em; color: rgba(255, 244, 234, .6); /* ds-ok */ }
.ok__t { margin: 12rpx 0 16rpx; font-size: 52rpx; font-weight: 800; }
.ok__s { font-size: 28rpx; line-height: 1.6; color: var(--pp-sub); }
.ok__thumbs { display: flex; gap: 16rpx; justify-content: center; margin-top: 32rpx; }
.ok__th { width: 104rpx; height: 104rpx; border-radius: 24rpx; opacity: 0; transform: translateY(24rpx); transition: transform 600ms cubic-bezier(.16, 1, .3, 1), opacity 400ms ease; }
.ok.s3 .ok__th { opacity: 1; transform: none; }
.ok__foot { position: absolute; left: 32rpx; right: 32rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); opacity: 0; transition: opacity 500ms ease 300ms; }
.ok.s3 .ok__foot { opacity: 1; }
.ok__pill { height: 100rpx; border-radius: 50rpx; background: #FFFFFF; color: #111111; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; /* ds-ok 原型白药丸 */ }
/* 减少动态效果:直接终态 */
.ok.is-reduced, .ok.is-reduced .ok__lock, .ok.is-reduced .ok__keyfly, .ok.is-reduced .ok__coin, .ok.is-reduced .ok__copy, .ok.is-reduced .ok__th, .ok.is-reduced .ok__foot, .ok.is-reduced .ok__lk, .ok.is-reduced .ok__unl { transition: none; }
