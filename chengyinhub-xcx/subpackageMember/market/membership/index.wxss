/* l-pass 通行证页。原型 proto/game page.css .psok 改写:只用 transition,不新增 keyframes。 */
/* l-iconsB 2026-11-11:按 proto/icons ps-pass 改回标准玩家样式 —— 黑底 token、实色卡、标准列表行、底部固定白药丸;不做玻璃、不再用暖橙渐变。
   --pp-* 仍定义在这里给开通成功层(.ok)用。 */
.pp { --pp-warm-hi: #B8431A; --pp-warm-mid: #3B1708; --pp-ink: #FFF4EA; --pp-sub: rgba(255, 244, 234, .75); --pp-gold: #FFD9A8; /* ds-ok 开通成功层的暖橙与票面金(物件固有色) */
  min-height: 100vh; color: var(--cy-color-text-primary); background: var(--cy-color-bg-page); }
.pp__frame { min-height: 100vh; }
.pp__body { display: flex; flex-direction: column; gap: 20rpx; padding: 16rpx var(--cy-space-4) 0; }
.pp__card { padding: 40rpx 40rpx 36rpx; border-radius: var(--cy-radius-xl); background: var(--cy-color-bg-surface); border: 1px solid var(--cy-color-border-subtle); }
.pp__card-top { display: flex; align-items: center; justify-content: space-between; }
.pp__card-t { display: flex; flex-direction: column; min-width: 0; }
.pp__eb { font-size: var(--cy-type-micro); font-weight: 600; letter-spacing: .2em; color: var(--cy-color-text-secondary); }
.pp__h { margin-top: 16rpx; font-size: var(--cy-type-display); font-weight: 700; line-height: 1.1; }
.pp__k { margin-top: 16rpx; font-size: var(--cy-type-label); font-variant-numeric: tabular-nums; color: var(--cy-color-text-secondary); }
.pp__key { flex: none; margin: 0 -20rpx -20rpx 0; } /* 钥匙在锁里转四分之一圈时杆会往上扫,顶上不吃进卡片内边距 */
.pp__list { border-radius: var(--cy-radius-xl); background: var(--cy-color-bg-surface); border: 1px solid var(--cy-color-border-subtle); overflow: hidden; }
.pp__row { display: flex; align-items: center; gap: var(--cy-space-3); min-height: 88rpx; padding: 24rpx 28rpx; color: var(--cy-color-text-tertiary); }
.pp__row + .pp__row { border-top: 1px solid var(--cy-color-border-subtle); }
.pp__ic { flex: none; width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; }
.pp__row-m { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.pp__row-t { font-size: var(--cy-type-card-title); font-weight: 600; color: var(--cy-color-text-primary); }
.pp__row-s { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.pp__plans { display: flex; gap: 20rpx; margin-top: 20rpx; }
.pp__plan { position: relative; flex: 1; min-height: 88rpx; padding: 28rpx; border-radius: var(--cy-radius-xl); background: var(--cy-color-bg-surface); border: 3rpx solid var(--cy-color-border-subtle); transition: border-color 200ms ease; }
.pp__plan.is-on { border-color: var(--cy-color-text-primary); }
.pp__plan-p { display: block; font-size: var(--cy-type-sheet-title); font-weight: 800; }
.pp__plan-l { display: block; margin-top: 4rpx; font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.pp__rib { position: absolute; right: 20rpx; top: -18rpx; padding: 4rpx 16rpx; border-radius: var(--cy-radius-pill); background: var(--cy-color-brand); color: var(--cy-color-text-on-light); font-size: var(--cy-type-micro); font-weight: 700; }
.pp__renew { min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--cy-radius-pill); border: 1px solid var(--cy-color-border-default); font-size: var(--cy-type-button); font-weight: 600; }
.pp__renew.is-off { opacity: .45; }
.pp__terms { display: block; text-align: center; font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); }
.pp__err { display: block; text-align: center; font-size: var(--cy-type-label); color: var(--cy-color-status-danger); }
.pp__pad { height: calc(260rpx + env(safe-area-inset-bottom)); }
.pp__foot { position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--cy-z-sticky); padding: 28rpx 40rpx calc(28rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, transparent, var(--cy-color-bg-page) 55%); }
.pp__pill { height: 104rpx; border-radius: var(--cy-radius-pill); background: var(--cy-color-text-primary); color: var(--cy-color-bg-page); display: flex; align-items: center; justify-content: center; font-size: var(--cy-type-button); font-weight: 600; }
.pp__pill.is-off { opacity: .45; }

/* ps-success:钥匙 / 开锁(原型 .psok)。步骤 s1/s2/s3 只切 transform / opacity。 */
.ok { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: var(--cy-z-celebrate); color: var(--pp-ink);
  background: radial-gradient(ellipse 90% 60% at 50% 100%, var(--pp-warm-hi) 0%, var(--pp-warm-mid) 45%, #0B0908 80%); /* ds-ok 原型 .psok */
  opacity: 0; transition: opacity 400ms ease; }
.ok.is-show { opacity: 1; }
.ok__skip { position: absolute; right: 32rpx; z-index: 2; min-height: 64rpx; line-height: 64rpx; padding: 0 12rpx; font-size: 28rpx; color: rgba(255, 244, 234, .7); /* ds-ok */ }
.ok__scene { position: absolute; left: 0; right: 0; top: 22%; height: 680rpx; }
.ok__lock { position: absolute; left: 50%; top: 40rpx; width: 280rpx; height: 280rpx; margin-left: -140rpx; opacity: 0; transform: translateY(40rpx) scale(.8); transition: transform 800ms cubic-bezier(.16, 1, .3, 1) 200ms, opacity 500ms ease 200ms; }
.ok.is-show .ok__lock { opacity: 1; transform: none; }
.ok__lk, .ok__unl { position: absolute; left: 0; top: 0; transition: opacity 300ms ease; }
.ok__unl { opacity: 0; }
.ok.s2 .ok__unl { opacity: 1; }
.ok.s2 .ok__lk { opacity: 0; }
.ok__keyfly { position: absolute; left: 50%; top: 380rpx; margin-left: -150rpx; transform-origin: 70% 50%; opacity: 0; transform: translate(-260rpx, 260rpx) rotate(-30deg) scale(.6); transition: transform 1400ms cubic-bezier(.16, 1, .3, 1), opacity 400ms ease; }
.ok.s1 .ok__keyfly { opacity: 1; transform: translate(40rpx, -60rpx) rotate(0deg) scale(.7); }
.ok.s2 .ok__keyfly { transform: translate(40rpx, -60rpx) rotate(90deg) scale(.7); transition: transform 600ms ease-in-out; }
.ok__coin { position: absolute; left: 50%; top: 300rpx; opacity: 0; transform: translate(0, 80rpx) scale(.2); transition: transform 900ms cubic-bezier(.2, 1.4, .5, 1), opacity 300ms ease; }
.ok.s2 .ok__coin { opacity: 1; }
.ok.s2 .ok__coin--0 { transform: translate(-240rpx, 40rpx); transition-delay: 0ms; }
.ok.s2 .ok__coin--1 { transform: translate(200rpx, -40rpx); transition-delay: 120ms; }
.ok.s2 .ok__coin--2 { transform: translate(-280rpx, -160rpx); transition-delay: 240ms; }
.ok.s2 .ok__coin--3 { transform: translate(220rpx, 80rpx); transition-delay: 360ms; }
.ok__copy { position: absolute; left: 56rpx; right: 56rpx; top: 60%; display: flex; flex-direction: column; align-items: center; text-align: center; opacity: 0; transform: translateY(32rpx); transition: transform 700ms cubic-bezier(.16, 1, .3, 1), opacity 500ms ease; }
.ok.s3 .ok__copy { opacity: 1; transform: none; }
.ok__k { font-size: 24rpx; letter-spacing: .2em; color: rgba(255, 244, 234, .6); /* ds-ok */ }
.ok__t { margin: 12rpx 0 16rpx; font-size: 52rpx; font-weight: 800; } /* ds-ok: 上线波次原型逐值(装饰 / 品牌色块) */
.ok__s { font-size: var(--cy-type-body); line-height: 1.6; color: var(--pp-sub); }
.ok__thumbs { display: flex; gap: 16rpx; justify-content: center; margin-top: 32rpx; }
.ok__th { width: 104rpx; height: 104rpx; border-radius: var(--cy-radius-md); opacity: 0; transform: translateY(24rpx); transition: transform 600ms cubic-bezier(.16, 1, .3, 1), opacity 400ms ease; }
.ok.s3 .ok__th { opacity: 1; transform: none; }
.ok__foot { position: absolute; left: 32rpx; right: 32rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); opacity: 0; transition: opacity 500ms ease 300ms; }
.ok.s3 .ok__foot { opacity: 1; }
.ok__pill { height: 100rpx; border-radius: 50rpx; background: #FFFFFF; color: #111111; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; /* ds-ok 原型白药丸 */ }
/* 减少动态效果:直接终态 */
.ok.is-reduced, .ok.is-reduced .ok__lock, .ok.is-reduced .ok__keyfly, .ok.is-reduced .ok__coin, .ok.is-reduced .ok__copy, .ok.is-reduced .ok__th, .ok.is-reduced .ok__foot, .ok.is-reduced .ok__lk, .ok.is-reduced .ok__unl { transition: none; }
