.entry-body { box-sizing: border-box; min-height: 100vh; display: flex; flex-direction: column; padding: 0 var(--cy-page-x) calc(var(--cy-space-6) + env(safe-area-inset-bottom)); }
.entry-title { color: var(--cy-text-title); font-size: var(--cy-font-title); font-weight: 600; }
.entry-status { margin: var(--cy-space-3) 0; color: var(--cy-text-body); font-size: var(--cy-font-body); }
.entry-row { display: flex; justify-content: space-between; gap: var(--cy-space-4); padding: var(--cy-space-2) 0; color: var(--cy-text-secondary); font-size: var(--cy-font-label); }
.entry-value { color: var(--cy-text-body); text-align: right; word-break: break-all; }
.entry-button { margin-top: var(--cy-space-4); min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--cy-color-bg-surface); color: var(--cy-text-title); border-radius: var(--cy-radius-lg); font-size: var(--cy-font-body); }
.entry-button::after { border: 0; }
