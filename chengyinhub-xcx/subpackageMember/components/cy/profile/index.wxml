            <text class="pc-tag" wx:for="{{categoryList}}" wx:key="id">{{item.categoryName}}</text>
            <view class="pc-tag pc-tag--add" wx:if="{{categoryList.length === 0}}" bindtap="goEditInterests" aria-role="button" aria-label="添加兴趣" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="24" /><text>添加兴趣</text></view>
          </view>
