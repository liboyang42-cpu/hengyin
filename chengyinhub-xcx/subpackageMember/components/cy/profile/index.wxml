        <cy-cell wx:if="{{isSelf}}" class="pc-solo-cell" title="加入时间" value="{{joinDate}}" arrow="{{false}}" hairline="{{false}}" />

        <block wx:if="{{isSelf}}">
        <!-- 入口收纳(ADA §二G):原「探索与成长 / 更多 / 会员续费」三段共 6 行整宽 cell,
             压成一块 4 列图标网格(角色互斥 ⇒ 常态正好 2 行)。入口本身一个不增不减、
             跳转全部沿用原方法;去掉的只是每行那句说明文案 —— 标签已自明。
             ⚠️ 角标数字不做:钱包/票券余量在现有接口里没有字段,补一次请求去凑 = 新增接口调用(禁)。 -->
        <!-- 2026-08-20 用户定:商家视角不出现「探索与更多」(收益入口在我的资产,其余为玩家向)。
             P-53(2026-10-27):设置里已有的(成为主理人/我的收益/投诉建议)不再重复;只留「我的优惠券」「邀请好友」,
             展示方式与下面「当前权益」同一套列表行,不用黑色卡片网格。 -->
        <view class="pc-sec-tit" wx:if="{{!isMerchantView}}">探索与更多</view>
        <view class="pc-benefits" wx:if="{{!isMerchantView}}">
          <view class="pc-benefit" bindtap="goCoupon" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="我的优惠券">
            <cy-icon class="pc-benefit-ic" name="coupon" size="48" />
            <text class="pc-benefit-text">我的优惠券</text>
            <cy-icon class="pc-benefit-arrow" name="arrow-right" size="32" />
          </view>
          <view class="pc-benefit" bindtap="goInvite" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="邀请好友，分享城瘾给好友">
            <cy-icon class="pc-benefit-ic" name="gift" size="48" />
            <text class="pc-benefit-text">邀请好友</text>
            <cy-icon class="pc-benefit-arrow" name="arrow-right" size="32" />
          </view>
        </view>

        <view class="pc-sec-tit">当前权益</view>
        <view class="pc-benefits">
          <view class="pc-benefit {{item.unlocked ? '' : 'pc-benefit--lock'}}" wx:for="{{benefits}}" wx:key="text"
                bindtap="onBenefitTap" data-route="{{item.route}}" data-unlocked="{{item.unlocked}}" hover-class="cy-pressed" hover-stay-time="80">
            <!-- 2026-10-30 V-19 业主定 B:线条图标放大到 24pt、去掉圆底、与文字同一中线;没解锁的图标和字变灰,行尾一把锁 -->
            <cy-icon class="pc-benefit-ic" name="{{item.icon || 'check'}}" size="48" />
            <text class="pc-benefit-text">{{item.text}}</text>
            <cy-icon class="pc-benefit-lock" wx:if="{{!item.unlocked}}" name="lock" size="30" />
            <cy-icon class="pc-benefit-arrow" wx:elif="{{item.route}}" name="arrow-right" size="32" />
          </view>
        </view>
        </block>
        </block>
      </block>

      </block>
      <view style="height:180rpx;"></view>
