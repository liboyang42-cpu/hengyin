<cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{isMerchantView ? 'merchant' : 'player'}}" title="{{sceneCurrent.title}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="closeMoreMenu">
  <!-- UI-12:公开视角的「···」只给「分享主页 / 屏蔽」;改资料/背景/设置是本人的操作,不在公开视角出现。 -->
  <cy-cell wx:if="{{isSelf && isMerchantView}}" title="店铺资料" arrow="{{false}}" bind:tap="goShop" />
  <cy-cell title="分享主页" arrow="{{false}}" bind:tap="onShareProfile" />
  <cy-cell wx:if="{{isSelf}}" title="更换背景图 · 16:9 横图" arrow="{{false}}" bind:tap="onChangeHeroBg" />
  <cy-cell wx:if="{{isSelf}}" title="设置" arrow="{{false}}" bind:tap="onMoreSetting" />
  <!-- BL-32:他人(非商家)主页可举报该用户,走共用举报半屏(targetType=MEMBER)。 -->
  <cy-cell wx:if="{{!isSelf && !subjectIsMerchant}}" title="举报" arrow="{{false}}" bind:tap="onReportMember" />
  <!-- BL-33:商家公开主页举报该商家(targetType=MERCHANT,targetId=商家档案主键 subjectMerchant.id)。 -->
  <cy-cell wx:if="{{!isSelf && subjectIsMerchant && subjectMerchant.id}}" title="举报" arrow="{{false}}" bind:tap="onReportMerchant" />
  <!-- BL-67:商家公开主页信息纠错(问题上报,merchantId=商家档案主键 subjectMerchant.id)。 -->
  <cy-cell wx:if="{{!isSelf && subjectIsMerchant && subjectMerchant.id}}" title="信息纠错" arrow="{{false}}" bind:tap="onMerchantCorrection" />
  <!-- CU-M-43(2026-09-23 用户裁决 B):「屏蔽」暂不开放。原入口只弹一句「已屏蔽」,
       既不写关系数据也不落本地态,重进页面一切照旧 —— 是句假成功。写口接通前这里不放
       这条 cell,也不用「暂未开放」的理由行占位(不可点的行读起来仍像一个能用的功能)。 -->
</cy-scene-sheet>
</view>

<cy-report-sheet wx:if="{{!isSelf}}" show="{{reportShow}}" target-type="{{reportTargetType}}" target-id="{{reportTargetId}}" title="{{reportTitle}}" bind:close="onReportClose" />
<!-- 挂在 .pc-page 外,照 cy-coop-invite-sheet 包一层主题,商家日间页才取得到 theme-merchant token。 -->
<view class="{{isMerchantView ? 'theme-merchant' : ''}}"><cy-merchant-correction-sheet wx:if="{{!isSelf}}" show="{{correctionShow}}" merchant-id="{{correctionMerchantId}}" bind:close="onCorrectionClose" /></view>

<!-- [P0-2] ③ 选章核销:一商家在同一路线承接多章是常态 ⇒ 交集≥2 时由他自己选,
     选完调 scan_qr_code_chapter。不用 wx.showActionSheet —— 它的 itemList 上限 6 项,
     超了就得截断 = 静默丢选项。 -->
<view class="scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'member-chapter-picker'}}" catchtouchmove="blockSceneTouch">
<cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{isMerchantView ? 'merchant' : 'player'}}" title="{{sceneCurrent.title}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="onChapterSheetClose">
  <view class="chpick">
    <view class="chpick__hint">选择本次核销的章节</view>
    <view class="chpick__item" wx:for="{{chapterSheet.items}}" wx:key="id"
          data-id="{{item.id}}" bindtap="onChapterPick" hover-class="cy-pressed" hover-stay-time="80">
      <text class="chpick__name">{{item.name}}{{item.replayed ? '（已核销，请勿重复提供权益）' : ''}}</text>
      <cy-icon class="chpick__chev" name="arrow-right" size="32" />
    </view>
  </view>
</cy-scene-sheet>
</view>

<view class="scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'member-station-picker'}}" catchtouchmove="blockSceneTouch">
<cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{isMerchantView ? 'merchant' : 'player'}}" title="{{sceneCurrent.title}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="onStationSheetClose">
  <view class="chpick">
    <view class="chpick__hint">选择本次核销的节点</view>
    <view class="chpick__item" wx:for="{{stationSheet.items}}" wx:key="registrationMerchantId"
          data-registration-merchant-id="{{item.registrationMerchantId}}" bindtap="onStationPick" hover-class="cy-pressed" hover-stay-time="80">
      <text class="chpick__name">{{item.name}}</text>
      <cy-icon class="chpick__chev" name="arrow-right" size="32" />
    </view>
  </view>
</cy-scene-sheet>
</view>

<!-- 积分任务:双列统计头(我的积分/本周获得)+ 票券式虚线分隔 + 任务行(名称/说明 · +分值/完成态) -->
<view class="scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'points-tasks'}}" catchtouchmove="blockSceneTouch">
<cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{sceneCurrent.theme}}" title="{{sceneCurrent.title}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="onPointsSheetClose">
  <view class="pts-hero">
    <view class="pts-hero__col">
      <view class="pts-hero__label">我的积分</view>
      <view class="pts-hero__num">{{userInfo.point || 0}}</view>
    </view>
    <view class="pts-hero__div"></view>
    <view class="pts-hero__col">
      <view class="pts-hero__label">本周获得</view>
      <view class="pts-hero__num">+{{pointsStat.weekPoints}}</view>
    </view>
  </view>
  <cy-skeleton wx:if="{{pointsSheet.loading}}" type="list" count="{{3}}" />
  <view wx:elif="{{pointsSheet.failed}}" class="pts-loading cy-fade-in" bindtap="loadPointsTasks" hover-class="cy-pressed" hover-stay-time="80">加载失败，点此重试</view>
  <cy-empty wx:elif="{{pointsSheet.loaded && !pointsSheet.tasks.length && !pointsSheet.spendRules.length}}" title="暂无积分任务" />
  <block wx:else>
  <view class="pts-list" wx:if="{{pointsSheet.tasks.length}}">
    <view class="pts-row" wx:for="{{pointsSheet.tasks}}" wx:key="id">
      <view class="pts-row__main">
        <view class="pts-row__name">{{item.title}}</view>
        <view class="pts-row__desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
      <view class="pts-row__side">
        <view class="pts-row__gain">{{item.pointsText || '+' + item.points}}</view>
        <view class="pts-row__done {{item.doneCount ? '' : 'is-zero'}}">{{item.doneCount ? '已获 ' + item.doneCount + ' 次' : '待完成'}}</view>
      </view>
    </view>
  </view>
  <!-- 花分规则(后台 eventType=14 解锁提示):数值同样来自后台积分规则配置,客户端不写死分值 -->
  <view class="pts-list" wx:if="{{pointsSheet.spendRules.length}}">
    <view class="pts-hero__label">积分消耗</view>
    <view class="pts-row" wx:for="{{pointsSheet.spendRules}}" wx:key="id">
      <view class="pts-row__main">
        <view class="pts-row__name">{{item.title}}</view>
        <view class="pts-row__desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
      <view class="pts-row__side">
        <view class="pts-row__gain">{{item.pointsText || '-' + item.points + ' / 次'}}</view>
        <view class="pts-row__done is-zero">{{item.doneCount ? '已用 ' + item.doneCount + ' 次' : '未使用'}}</view>
      </view>
    </view>
  </view>
  </block>
</cy-scene-sheet>
</view>

<!-- 账户/订单/参与/收益统一挂在“我的”根场景；内容组件只读真实接口，宿主只管理栈。 -->
<view class="member-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id !== 'qr-coupon' && sceneCurrent.id !== 'share-invite' && sceneCurrent.id !== 'member-more-menu' && sceneCurrent.id !== 'member-chapter-picker' && sceneCurrent.id !== 'member-station-picker' && sceneCurrent.id !== 'points-tasks'}}" catchtouchmove="blockSceneTouch">
  <cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{sceneCurrent.theme}}" title="{{sceneCurrent.title}}" can-back="{{sceneCurrent.canBack}}" dirty="{{sceneCurrent.dirty}}" mask-closable="{{sceneCurrent.maskClosable}}" footer="{{sceneCurrent.footer}}" bind:requestclose="requestSceneClose" bind:back="backScene">
    <cy-scene-route-content id="sceneRouteContent" scene-id="{{sceneCurrent.id}}" params="{{sceneCurrent.params}}" theme="{{sceneCurrent.theme}}" bind:open="openChildScene" bind:back="backScene" bind:close="closeScene" bind:dirtychange="onSceneDirtyChange" />
    <view wx:if="{{sceneCurrent.footer}}" slot="footer" class="member-scene-footer">
      <cy-btn variant="primary" bindtap="submitSceneForm">{{sceneCurrent.id === 'member-withdraw' ? '确认提现' : sceneCurrent.id === 'settings-profile' ? '保存资料' : sceneCurrent.id === 'settings-feedback' ? '提交建议' : sceneCurrent.id === 'merchant-apply' ? '提交入驻申请' : sceneCurrent.id === 'club-apply' ? '提交申请' : sceneCurrent.id === 'merchant-citynode' ? '提交互动模板' : '保存'}}</cy-btn>
    </view>
  </cy-scene-sheet>
</view>
<view class="member-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'share-invite'}}" catchtouchmove="blockSceneTouch">
  <cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{sceneCurrent.theme}}" title="{{sceneCurrent.title}}" can-back="{{sceneCurrent.canBack}}" dirty="{{sceneCurrent.dirty}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="requestSceneClose" bind:back="backScene">
    <cy-scene-share-invite theme="{{sceneCurrent.theme}}" player-code="{{isSelf}}" />
  </cy-scene-sheet>
</view>
<view class="member-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'qr-coupon'}}" catchtouchmove="blockSceneTouch">
  <cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{sceneCurrent.theme}}" title="{{sceneCurrent.title}}" can-back="{{sceneCurrent.canBack}}" dirty="{{sceneCurrent.dirty}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="requestSceneClose" bind:back="backScene">
    <cy-scene-qr-coupon coupon-history-id="{{sceneCurrent.params.couponHistoryId}}" name="{{sceneCurrent.params.name}}" bind:close="backScene" />
  </cy-scene-sheet>
</view>
<cy-modal wx:if="{{isSelf}}" class="{{isMerchantView ? 'theme-merchant' : 'theme-dark'}}" show="{{sceneConfirm.show}}" title="放弃本轮修改" confirm-text="确认放弃" cancel-text="继续编辑" danger bind:confirm="confirmSceneDiscard" bind:cancel="cancelSceneDiscard" />

<!-- 门店 NPC 对话。bizId = 商家 id;与漫游轨共用 cy-npc-chat 壳,靠 scope 选端点。 -->
<cy-npc-chat wx:if="{{subjectIsMerchant && subjectMerchant.npc}}"
  show="{{merchantNpcChatShow}}"
  scope="merchant"
  session-id="{{subjectMerchant.id}}"
  npc-name="{{subjectMerchant.npc.name}}"
  greeting="{{subjectMerchant.npc.greeting}}"
  bind:close="closeMerchantNpcChat" />

<view class="{{isMerchantView ? 'theme-merchant' : ''}}"><cy-coop-invite-sheet id="coop-invite" show="{{coopInviteShow}}" target-id="{{userId}}" target-name="{{(subjectMerchant && subjectMerchant.name) || (userInfo && userInfo.nickname) || ''}}" invite-type="{{0}}" topic-id="{{topicId}}" chapter-id="{{chapterId}}" topic-name="{{topicName || ''}}" operation-scope="{{operationScope || ''}}" bind:close="closeCoopInvite" bind:sent="onCoopInviteSent" /></view>
