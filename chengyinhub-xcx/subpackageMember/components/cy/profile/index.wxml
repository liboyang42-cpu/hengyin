            <view class="pc-sec-tit">承接能力</view>
            <view class="pc-card pc-mrows">
              <view class="pc-mrow" wx:if="{{subjectMerchant.capacityText}}">
                <text class="pc-mrow-k">可容纳</text>
                <text class="pc-mrow-v">{{subjectMerchant.capacityText}}</text>
              </view>
              <view class="pc-mrow" wx:if="{{subjectMerchant.suitActivityTypes}}">
                <text class="pc-mrow-k">适合路线</text>
                <text class="pc-mrow-v">{{subjectMerchant.suitActivityTypes}}</text>
              </view>
              <view class="pc-mrow" wx:if="{{subjectMerchant.availableTime}}">
                <text class="pc-mrow-k">可承接时段</text>
                <text class="pc-mrow-v">{{subjectMerchant.availableTime}}</text>
              </view>
              <view class="pc-mrow" wx:if="{{subjectMerchant.demand}}">
                <text class="pc-mrow-k">合作诉求</text>
                <text class="pc-mrow-v">{{subjectMerchant.demand}}</text>
              </view>
            </view>
          </block>
        </block>

        <!-- 探测中:不知道是谁就先别渲染任何一套 About -->
        <cy-skeleton wx:elif="{{merchantState === 'loading'}}" type="list" count="{{2}}" />

        <!-- 网络失败:绝不回退成玩家 About 或「商家未完善」——那是拿「没查到」冒充业务事实 -->
        <view wx:elif="{{merchantState === 'network-error'}}" class="pc-metric-error">
          <cy-error load-failure title="资料加载失败"
            retry="重新加载" bind:retry="retryMerchantProbe" />
        </view>

        <!-- ===== 关于 · 玩家 / 俱乐部被看者(原样不动) ===== -->
        <block wx:else>
        <view class="pc-about-head">
          <view class="pc-sec-tit pc-sec-tit--flush">个人介绍</view>
          <view class="pc-about-edit" wx:if="{{isSelf}}" bindtap="goEditIntro" aria-role="button" aria-label="编辑个人介绍" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="edit" size="28" />
            <text>编辑</text>
          </view>
        </view>
        <view class="pc-card pc-about">{{userInfo.introduction || '还没有个人介绍'}}</view>

        <!-- 2026-10-30 走查:没有兴趣时不再写「完善资料后可展示兴趣」这类说明 —— 本人给一枚「添加兴趣」直达路线偏好,别人的主页整段不出 -->
        <block wx:if="{{categoryList.length || isSelf}}">
          <view class="pc-sec-tit">兴趣标签</view>
