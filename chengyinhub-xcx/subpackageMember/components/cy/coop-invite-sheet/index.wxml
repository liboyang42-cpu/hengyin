<view class="theme-merchant invite-theme">
<cy-sheet show="{{show}}" title="发送邀约" handle inset footer mask-closable="{{!submitting}}" closable="{{!submitting}}" bind:close="close">
  <view class="invite">
    <block wx:if="{{!topicId}}">
      <scroll-view wx:if="{{topics.length}}" scroll-x show-scrollbar="{{false}}" class="invite__rail" bindscrolltolower="moreTopics" aria-label="选择自己发布的主题">
        <view class="invite__track"><view wx:for="{{topics}}" wx:key="id" class="invite__card" data-id="{{item.id}}" bindtap="pickTopic" hover-class="cy-pressed" hover-stay-time="80" aria-role="radio" aria-checked="{{selectedId == item.id}}" aria-label="{{item.name}}">
          <view class="invite__cover invite__cover--{{item.tone}}"><image class="invite__cover-img" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" /><text wx:else>{{item.number}}</text></view>
          <view class="invite__name"><text class="invite__name-text">{{item.name}}</text><cy-icon wx:if="{{selectedId == item.id}}" name="check" size="24" /></view>
        </view></view>
      </scroll-view>
      <text wx:if="{{loading}}" class="invite__hint">加载中</text>
      <text wx:elif="{{!topics.length && !error}}" class="invite__hint">暂无自己发布的主题</text>
    </block>
    <text wx:if="{{selectedTopicName}}" class="invite__hint">{{selectedTopicName}}</text>
    <text class="invite__target">{{targetName}}</text>
    <block wx:if="{{!chapterId}}">
      <scroll-view wx:if="{{chapters.length}}" scroll-x show-scrollbar="{{false}}" scroll-left="{{0}}" class="invite__rail" aria-label="选择章节">
        <view class="invite__track"><view wx:for="{{chapters}}" wx:key="id" class="invite__card" data-id="{{item.id}}" bindtap="pickChapter" hover-class="cy-pressed" hover-stay-time="80" aria-role="radio" aria-checked="{{selectedChapterId == item.id}}" aria-label="{{item.name}}">
          <view class="invite__cover invite__cover--{{item.tone}}"><image class="invite__cover-img" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" /><text wx:else>{{item.number}}</text></view>
          <view class="invite__name"><text class="invite__name-text">{{item.name}}</text><cy-icon wx:if="{{selectedChapterId == item.id}}" name="check" size="24" /></view>
        </view></view>
      </scroll-view>
      <text wx:elif="{{chaptersLoading}}" class="invite__hint">加载中</text>
      <text wx:elif="{{!error}}" class="invite__hint">{{selectedId ? '该主题暂无章节' : '请先选择上方主题'}}</text>
    </block>
    <view wx:if="{{inviteType === 1}}">
      <view wx:if="{{selectedId}}" class="invite__hint" bindtap="queryOriginalInvite" aria-role="button" aria-label="查询原邀请请求" hover-class="cy-pressed" hover-stay-time="80">查询原请求</view>
      <view class="invite__hint" bindtap="discoverOriginalInvites" aria-role="button" aria-label="查找当前账号原邀请请求" hover-class="cy-pressed" hover-stay-time="80">{{receiptLoading ? '查询中…' : '查找原邀请请求（含其他设备）'}}</view>
      <cy-empty wx:if="{{receiptError}}" kind="error" title="原请求仍待确认" sub="{{receiptError}}" />
      <view wx:for="{{receiptRows}}" wx:key="requestId" class="invite__hint">请求 {{item.requestId}} · {{item.state === 'CREATED' ? ('已创建邀请 #' + item.inviteId + ' · 主题 #' + item.topicId + ' · 对象 #' + item.toId) : item.state === 'NOT_FOUND' ? '未查到该请求，可沿用原请求号再次发送' : '已受理，当前账号无法查看结果'}}</view>
      <view wx:if="{{receiptHasMore}}" class="invite__hint" bindtap="moreOriginalInvites" aria-role="button" aria-label="加载更多原邀请请求" hover-class="cy-pressed" hover-stay-time="80">加载更多原请求</view>
    </view>
    <textarea class="invite__message" value="{{message}}" bindinput="onMessage" placeholder="写下想对对方说的话" maxlength="100" disabled="{{submitting}}" />
    <view wx:if="{{error}}" class="invite__error" aria-role="alert">{{error}}<text wx:if="{{!chapters.length}}" bindtap="retry" aria-role="button" aria-label="重试加载邀约主题和章节" hover-class="cy-pressed" hover-stay-time="80"> 重试</text></view>

  </view>
  <cy-btn slot="footer" class="invite__send" variant="primary" loading="{{submitting}}" disabled="{{!selectedChapterId || chaptersLoading || unknown}}" bindtap="send" accessibility-label="发送邀约">{{submitting ? '发送中…' : '发送邀约'}}</cy-btn>
</cy-sheet>
</view>
