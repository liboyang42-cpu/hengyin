.invite-theme { --cy-page-x: 40rpx; --cy-sheet-body-margin-x: -40rpx; --cy-sheet-body-pad-x: 40rpx; --cy-sheet-heading-size: calc(var(--cy-type-label) * 2); --cy-comp-sheet-radius: calc(var(--cy-radius-md) + var(--cy-radius-lg)); }
.invite { display: flex; flex-direction: column; gap: 40rpx; padding: 16rpx 0 0; color: var(--cy-color-text-primary); }
.invite__target { font-size: var(--cy-type-card-title); line-height: 48rpx; font-weight: 700; }
.invite__hint { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
/* cy-sheet 自带正文页边距；仅横滑区延伸到弹窗边缘。 */
.invite__rail { width: calc(100% + var(--cy-page-x) * 2); margin-left: calc(-1 * var(--cy-page-x)); }
.invite__track { display: flex; gap: 48rpx; width: max-content; padding-right: var(--cy-page-x); }
.invite__card { flex: 0 0 220rpx; width: 220rpx; display: flex; flex-direction: column; gap: 16rpx; }
.invite__cover { width: 220rpx; height: 220rpx; border-radius: calc(var(--cy-radius-md) * 2); overflow: hidden; display: flex; align-items: center; justify-content: center; color: var(--cy-comp-photo-card-fg); font-size: var(--cy-type-data-xl); font-weight: 700; }
.invite__cover--0 { background: var(--cy-comp-invite-cover-rose); }
.invite__cover--1 { background: var(--cy-comp-invite-cover-charcoal); }
.invite__cover--2 { background: var(--cy-comp-invite-cover-cyan); }
.invite__cover-img { width: 100%; height: 100%; }
.invite__name { display: flex; align-items: center; gap: 6rpx; font-size: var(--cy-type-body); line-height: 42rpx; font-weight: 600; }
.invite__name-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.invite__message { width: 100%; min-height: 156rpx; height: 156rpx; box-sizing: border-box; padding: 32rpx; border-radius: var(--cy-radius-xl); background: var(--cy-color-bg-surface-subtle); font-size: var(--cy-type-body); line-height: 46rpx; }
.invite__error { font-size: var(--cy-type-caption); color: var(--cy-color-status-danger); }
.invite__send { display: block; width: 100%; --cy-comp-btn-radius: calc(var(--cy-radius-lg) + var(--cy-space-2-5)); }

.cy-pressed { opacity: .88; }
