/* 骨架屏→内容淡切:isolated 组件收不到全局 components.wxss,@import 同一份定义 */
@import '../../../../style/fade-in.wxss';
:host { display: block; height: 100%; }
.wallet-body { height: 100%; min-height: 0; display: flex; flex-direction: column; }
.wallet-tabs { display: flex; gap: var(--cy-space-1); padding: var(--cy-space-1) 0 var(--cy-space-3); flex: none; }
.wallet-tab { flex: 1; min-height: var(--cy-btn-h-sm); display: flex; align-items: center; justify-content: center; border-radius: var(--cy-radius-pill); color: var(--cy-color-text-secondary); font-size: var(--cy-type-label); }
.wallet-tab--on { background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); }
.wallet-list { flex: 1; min-height: 0; }
.wallet-card { margin-bottom: var(--cy-scene-card-gap, var(--cy-space-3)); padding: var(--cy-scene-card-pad-y, var(--cy-space-3)) var(--cy-scene-card-pad-x, var(--cy-space-3)); border-radius: var(--cy-scene-card-radius, var(--cy-radius-lg)); background: var(--cy-scene-card-bg, var(--cy-color-bg-surface-subtle)); border: 2rpx solid var(--cy-scene-card-border, transparent); }
.wallet-card--usable { border-color: var(--cy-scene-card-border, var(--cy-color-border-strong)); }
.wallet-card__head, .wallet-card__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-2); }
.wallet-card__name { color: var(--cy-color-text-primary); font-size: var(--cy-type-card-title); font-weight: 700; }
.wallet-card__desc, .wallet-card__foot { margin-top: var(--cy-space-2); color: var(--cy-color-text-secondary); font-size: var(--cy-type-caption); line-height: var(--cy-leading-normal); }
.wallet-card__desc { display: block; }
.wallet-card__foot { flex-wrap: wrap; }
.wallet-card__action { color: var(--cy-color-text-primary); font-weight: 600; }

.wallet-tab--press { opacity: 0.62; }
.wallet-card--press { opacity: 0.82; }
.wallet-card__action { display: inline-flex; flex-shrink: 0; align-items: center; gap: var(--cy-space-1); color: var(--cy-color-text-primary); font-weight: 600; }

/* isolated 组件内全局 .cy-pressed 进不来,必须本地定义一份。
   只减淡不位移:位移要配 .cy-motion-reduced 兜底,而那个类挂在组件外的祖先上,
   isolated 下同样够不着 —— 与其留个撤不掉的位移,不如按仓库既有组件按压类的做法只减淡。 */
.cy-pressed { opacity: .88; }

/* 2026-10-23 页面动效(utils/page-motion.js):容器 --pm-* 置 1 时先隐着,再依次浮上来;静止时无过渡,按压反馈不受影响;减少动态效果时从不触发 */
.wallet-card { filter: opacity(calc(1 - var(--pm-c, 0))); translate: 0 calc(var(--pm-c, 0) * 31rpx); transition: filter var(--pm-c-d, 0s) ease, translate var(--pm-c-d, 0s) cubic-bezier(.2,.82,.2,1), transform var(--cy-motion-press) var(--cy-ease-out), opacity var(--cy-motion-press) var(--cy-ease-out); transition-delay: calc(var(--pm-c-s, 0) * (0ms + min(var(--pmi, 0), 8) * 50ms)), calc(var(--pm-c-s, 0) * (0ms + min(var(--pmi, 0), 8) * 50ms)), 0s, 0s; }
