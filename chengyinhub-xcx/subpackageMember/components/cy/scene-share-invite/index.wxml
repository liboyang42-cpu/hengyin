<view class="siv siv--{{theme}} {{reducedMotion ? 'siv--reduced' : ''}}">
  <view wx:if="{{qrState === 'loading' || qrState === 'ready'}}" aria-role="button" aria-label="{{playerCode ? '预览我的个人小程序码' : '邀请二维码'}}" class="siv__qr-frame"
    hover-class="{{playerCode && qrState === 'ready' ? 'cy-pressed' : 'none'}}" hover-stay-time="80" bindtap="previewQr">
    <cy-progress-status wx:if="{{qrState === 'loading'}}" class="siv__qr-status"
      title="正在加载邀请二维码" sub="加载完成后即可扫码邀请好友" />
    <image wx:if="{{qrSrc}}" class="siv__qr {{qrState === 'ready' ? 'siv__qr--ready' : ''}}"
      src="{{qrSrc}}" data-src="{{qrSrc}}" mode="aspectFit" show-menu-by-longpress="{{playerCode}}"
      bindload="onQrLoad" binderror="onQrError" aria-role="img" aria-label="{{playerCode ? '我的个人小程序码，点击预览，长按可保存' : '邀请二维码'}}" />
    <!-- 2026-10-28 业主(参考 spottedinprod):码出现时颜色从中间一圈圈往外扩,再退成黑色;中间是黑色的城瘾 logo -->
    <view wx:if="{{qrSrc}}" class="siv__ripple {{qrState === 'ready' ? 'siv__ripple--done' : ''}}" aria-hidden="true"></view>
    <view wx:if="{{qrSrc}}" class="siv__logo {{qrState === 'ready' ? 'siv__logo--ready' : ''}}" aria-hidden="true"><image class="siv__logo-img" src="/images/cy_logo_mark.png" mode="aspectFit" /></view>
  </view>
  <view wx:elif="{{qrState === 'code-error'}}" class="siv__qr-state">
    <cy-error title="个人码加载失败" sub="{{qrErrorText}}"
      retry="重新生成" bind:retry="retryQr" />
  </view>
  <view wx:elif="{{qrState === 'error'}}" class="siv__qr-state">
    <cy-error load-failure title="二维码加载失败" sub="可以重新生成，或直接使用下方分享链接。"
      retry="{{playerCode ? '重新生成' : '重试'}}" bind:retry="retryQr" />
  </view>
  <view wx:else class="siv__qr-state">
    <cy-empty title="二维码暂时不可用" sub="你仍可以直接使用下方分享链接。" size="sm" />
  </view>

  <view class="siv__copy">
    <text class="siv__title">邀请好友一起探索城市</text>
    <text class="siv__description">分享城瘾给你的好友，一起发现城市里的新玩法。</text>
  </view>

  <button class="siv__share" open-type="share" data-share-kind="invite">分享链接</button>
</view>
