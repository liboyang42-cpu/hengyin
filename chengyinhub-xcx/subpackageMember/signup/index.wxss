/* 活动 */
.wallet{
  overflow: hidden;
}
.wallet .list {
  padding: var(--cy-space-6) var(--cy-legacy-72) var(--cy-space-7) var(--cy-legacy-72);
  box-sizing: border-box;
  height:100%;
  overflow-y:auto;
}

.wallet .list .li {
  margin-bottom: var(--cy-space-5);
}

.wallet .list .li .item {
  height: 368rpx;
  border-radius: 80rpx;
  position: relative;
  overflow: hidden;
  border: 10rpx solid rgba(255, 255, 255, 0.9);
}

.wallet .list .li .item image {
  width: 100%;
  border-radius: 80rpx; vertical-align: top;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}


/* 2026-07-31:优惠券票卡(.david、.david_tkb_li 系、.hong)已随"删除票夹页优惠券 tab"整体搬到
   独立的 subpackageMember/coupon(见 wt3b-visual-semantics-contract.test.js 的 P1-5 契约,已随实现迁移)。 */

/* 2026-07-31:原 position:fixed + top/left:50% 是"整屏居中"(会把内容顶到状态栏/标题下面去算中点),
   和用户明确的"标题下方到屏幕底部这段剩余空间里居中"不是一回事。改成 flex:1 让出的正常文档流子项,
   居中交给 cy-empty/cy-error 的 fill 变体做(.signup 根节点已经是 flex-col + height:100vh)。 */
.davidwu{ position: relative; z-index: 1; width: 100%; overflow: hidden; display: flex; flex-direction: column; flex: 1; }
/* cy-empty/cy-error 是 styleIsolation:isolated 组件,宿主标签默认 display:block,
   组件内部的 flex:1 要宿主自己也是 flex 容器才生效,从页面外部补一层。 */
.fill-slot{ display: flex !important; flex-direction: column !important; flex: 1 !important; min-height: 0 !important; }

/* 2026-07-31:优惠券详情弹框(.tkbg/.tkbox*)随优惠券 tab 一起删除,不再在本页触发。 */

/* UI-17:卡外的票名大字、票面 meta(名称/场次时间)与票根文字都已删——返修后票面零文字,
   票名/状态只在 aria-label 里出现(见 index.wxml 顶部说明)。 */

/* 票夹里的队伍入口(2026-09-04 判定表补的那条)。跟着当前票走,没有队伍整行不出。 */
.team-entry {
  position: absolute;
  left: var(--cy-page-x);
  right: var(--cy-page-x);
  bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  padding: var(--cy-space-4);
  border-radius: var(--cy-radius-md);
  background: var(--cy-bg-card);
}

@media (max-height: 700px) {
  .signup {
    height: auto;
    min-height: 100vh;
    overflow-y: auto;
  }

  .signup .main {
    flex: none;
    overflow: visible;
  }


  .team-entry {
    position: static;
    margin: var(--cy-space-4) var(--cy-page-x) 0;
  }
}

.team-entry__main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.team-entry__k {
  font-size: var(--cy-font-body);
  font-weight: 600;
  color: var(--cy-text-title);
}

.team-entry__v {
  margin-left: var(--cy-space-2-5);
  min-width: 0;
  font-size: var(--cy-font-caption);
  color: var(--cy-text-muted);
}

.team-entry__n {
  margin-right: var(--cy-space-2);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-muted);
}


/* ===== v13 票夹(业主 2026-10-22「和 HTML 一模一样」) ===== */
/* ds-ok: 本段颜色/尺寸逐项照 v13 原型取值 */
.signup { background: #050505; } /* ds-ok */
.signup .ztbg.wbg { top: -77rpx; left: -77rpx; width: calc(100% + 154rpx); height: calc(100% + 154rpx); filter: blur(42rpx) saturate(1.15); transform: scale(1.1); opacity: 0; transition: opacity .8s ease; }
.signup .ztbg.wbg.vis { opacity: 1; }
.signup-scrim.wmask { background: linear-gradient(180deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,.35) 35%, rgba(0,0,0,.82) 78%, #050505 100%); } /* ds-ok */
.wl-nav { position: fixed; left: 0; right: 0; z-index: 95; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.15; pointer-events: none; }
.wl-nav__b { font-size: 33rpx; font-weight: 600; color: #fff; } /* ds-ok */
.deck { position: fixed; left: 50%; top: calc(50vh - 414rpx); width: 577rpx; height: 865rpx; margin-left: -288rpx; z-index: 2; }
.wc { position: absolute; top: 0; left: 0; right: 0; bottom: 0; transform-origin: 50% 0; transition: transform .45s cubic-bezier(.2,.8,.2,1), filter .45s, opacity .3s; } /* ds-ok: v13 动效原型定值 */
/* 2026-10-28 翻面:卡面放到正反两面上,外层 .wc 只管卡堆位置 */
.wc__flip { position: absolute; top: 0; left: 0; right: 0; bottom: 0; transform-style: preserve-3d; transition: transform .62s cubic-bezier(.2,.9,.25,1.08); }
.wc__flip--back { transform: rotateY(180deg); }
.wc__face { position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 54rpx; overflow: hidden; backface-visibility: hidden; -webkit-backface-visibility: hidden; /* ds-ok: v13 卡面 */
  background: linear-gradient(180deg, #1c1d1f, #0f1011); box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.1), 0 46rpx 96rpx rgba(0,0,0,.55); } /* ds-ok */
.wc__back { transform: rotateY(180deg); background: #f6f6f4; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 46rpx; box-sizing: border-box; } /* ds-ok: 入场码白卡,深底上要读得清 */
.wc__bn { max-width: 100%; font-size: 40rpx; font-weight: 700; color: #111; } /* ds-ok */
.wc__qr { position: relative; margin-top: 48rpx; width: 400rpx; height: 400rpx; border-radius: 28rpx; background: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 28rpx rgba(0,0,0,.08); } /* ds-ok */
.wc__qr-tip { font-size: 27rpx; color: rgba(17,17,17,.55); padding: 20rpx 30rpx; } /* ds-ok */
.wc__exp { margin-top: 40rpx; font-size: 23rpx; color: rgba(17,17,17,.5); } /* ds-ok */
/* 开始游戏:进页扫一道光(transition,棘轮不许新增 @keyframes);按下去填满 → 票卡往前冲出 → 黑色从按钮处铺满 */
.wl-start { position: fixed; left: 50%; bottom: calc(58rpx + env(safe-area-inset-bottom)); z-index: 6; width: 460rpx; height: 104rpx; margin-left: -230rpx; border-radius: 52rpx; overflow: hidden; background: #fff; } /* ds-ok */
.wl-start__fill { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: #e8e8e8; transform: scaleX(0); transform-origin: 0 50%; transition: transform .5s cubic-bezier(.4,0,.2,1); } /* ds-ok */
.wl-start__shine { position: absolute; top: 0; bottom: 0; left: 0; width: 120rpx; background: linear-gradient(100deg, rgba(255,255,255,0), rgba(255,255,255,.9), rgba(255,255,255,0)); transform: translateX(-160rpx) skewX(-18deg); transition: transform 1.1s cubic-bezier(.4,0,.2,1); } /* ds-ok */
.wl-start--lit .wl-start__shine { transform: translateX(560rpx) skewX(-18deg); }
.wl-start__lbl { position: relative; height: 100%; display: flex; align-items: center; justify-content: center; gap: 14rpx; font-size: 31rpx; font-weight: 700; letter-spacing: 4rpx; color: #111; } /* ds-ok */
.wl-start__play { width: 24rpx; height: 24rpx; filter: invert(1); }
.wl-start--go .wl-start__fill { transform: scaleX(1); }
.wl-burst { position: fixed; left: 50%; bottom: calc(110rpx + env(safe-area-inset-bottom)); z-index: 7; width: 60rpx; height: 60rpx; margin: 0 0 -30rpx -30rpx; border-radius: 50%; background: #050505; transform: scale(0); pointer-events: none; transition: transform .55s cubic-bezier(.6,0,.4,1) .45s; } /* ds-ok */
.wl-burst--go { transform: scale(60); }
.signup--go .deck { transform: scale(1.18) translateY(-40rpx); opacity: 0; transition: transform .5s cubic-bezier(.5,0,.2,1) .3s, opacity .35s .45s; }
.signup--go .team-entry { opacity: 0; transition: opacity .2s; }
.signup--reduced .wc__flip, .signup--reduced .wl-burst, .signup--reduced .deck { transition: none; }
.deck--still .wc { transition: none; }
.wc__go { position: absolute; right: 31rpx; top: 27rpx; width: 62rpx; height: 62rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.wc__go image { width: 27rpx; height: 27rpx; }
.wc__t { position: absolute; left: 46rpx; right: 46rpx; top: 100rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.wc__b { font-size: 48rpx; font-weight: 600; line-height: 1.18; letter-spacing: 1rpx; color: #fff; } /* ds-ok */
.wc__s { margin-top: 15rpx; font-size: 21rpx; letter-spacing: 2rpx; color: rgba(255,255,255,.65); } /* ds-ok */
.wc__im { position: absolute; left: 27rpx; right: 27rpx; top: 288rpx; bottom: 27rpx; border-radius: 38rpx; overflow: hidden; } /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
.wc__im image { width: 100%; height: 100%; display: block; }
.wc__im::after { content: ''; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 65%, rgba(0,0,0,.6)); } /* ds-ok */
.signup .team-entry { bottom: auto; left: 50%; right: auto; transform: translateX(-50%); z-index: 4; padding: 12rpx 27rpx; gap: 15rpx; border-radius: 40rpx; background: rgba(40,40,42,.72); backdrop-filter: blur(31rpx); -webkit-backdrop-filter: blur(31rpx); } /* ds-ok */

