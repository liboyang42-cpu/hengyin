.signup {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

/* UI-17(2026-09-18):整页一张完整票卡 —— 标题条删掉后,背景图必须铺满全屏(含状态栏/返回行),
   否则顶部仍留一段页面黑。固定层 + 主题色遮罩,票卡浮在上面。 */
.signup .ztbg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  filter: blur(50rpx); opacity: .5;
  z-index: 0;
  pointer-events: none;
}

.signup-scrim {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(0deg, rgba(0, 0, 0, .3), rgba(0, 0, 0, .6) 30%); /* ds-ok: 沿用原 .main 的遮罩渐变(压在用户照片上,不随主题翻转) */
}

.signup .main {
  position: relative;
  overflow: hidden;
  z-index: 1;
  /* UI-17 二次返修:底部安全区(Home 指示条)不算可视区,卡不在它里面居中。 */
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

.signup .toolbar {
  position: relative;
  margin: 44rpx var(--cy-page-x) var(--cy-legacy-18) var(--cy-page-x); /* ds-ok: 44rpx 是 r1-c04-order-ticket-contract.test.js 锁定的横向边距修复值,不改 */
}

.signup .toolbar button {
  position: absolute;
  right: var(--cy-space-3-5);
  margin: 0;
  width: auto;
  top: 50%;
  transform: translateY(-50%);
}

.signup .toolbar button image {
  width: 48rpx;
  height: 48rpx;
}

