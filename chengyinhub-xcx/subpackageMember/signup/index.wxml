<!-- 2026-10-28 业主:票夹只放能用的票(registrationStatus 2 已报名、未核验),卡上不写状态,
     也没有「可用 / 已用 / 已过期」切换 —— 没付钱、用过、过期的票不进票夹。
     点卡翻面出示入场码(/api/verify/dyncode/issue,和 scene-qr-ticket 同一接口);底部「开始游戏」进 play。 -->
<view class="theme-dark">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
<view class="signup flex-col {{reduced ? 'signup--reduced' : ''}} {{entering ? 'signup--go' : ''}}">
  <!-- UI-17 二次返修(2026-09-18 用户追加):全屏背景 = 当前票主题图(固定层,压在整页下面)。
       卡在导航以下、底部安全区以上的区域里水平垂直居中并整体放大;票名移到卡外、紧贴卡顶之上,
       卡面本身仍然零叠字。 -->
  <image wx:if="{{wbg[0]}}" src="{{wbg[0]}}" mode="aspectFill" class="ztbg wbg {{wbgOn === 0 ? 'vis' : ''}}" />
  <image wx:if="{{wbg[1]}}" src="{{wbg[1]}}" mode="aspectFill" class="ztbg wbg {{wbgOn === 1 ? 'vis' : ''}}" />
  <view class="signup-scrim wmask"></view>
  <cy-nav-bar overlay pill pillDark tint="light" title="" />
  <view class="wl-nav" style="top: {{navTop - navH}}px; height: {{navH}}px;" aria-role="heading" aria-label="票夹"><text class="wl-nav__b">票夹</text></view>

  <!-- 2026-07-31:优惠券已独立(subpackageMember/coupon),「票夹/优惠券」那层 tab 已删。
       2026-09-09 用户裁决:「路线 / 场次」这层 tab 也删掉,两种票放一起。
       两类票在后端确实是两回事(ownerType 1/2,两个接口),但那是数据模型的区分,
       不是用户要做的选择 —— 打开票夹只想看「我有哪些票」。合并只在渲染层做,
       落点差异由每张票自己带的 kind 分流(见 index.js goTicket)。 -->

  <view class="davidwu" wx:if="{{focusState === 'loading'}}">
    <cy-skeleton class="fill-slot" type="ticket" count="1" loading-label="正在定位原报名凭证" />
  </view>
  <view class="davidwu" wx:elif="{{focusState === 'missing'}}">
    <cy-state-shell class="fill-slot" kind="error" title="未定位到原报名凭证" sub="{{focusError}}" primary="重试" fill="{{true}}" size="lg" theme="player" bind:primary="retryFocus" />
  </view>
  <view class="davidwu" wx:elif="{{walletState === 'loading'}}">
    <cy-skeleton class="fill-slot" type="ticket" count="1" loading-label="正在加载我的票" />
  </view>
  <view class="davidwu" wx:elif="{{walletState === 'error'}}">
    <cy-state-shell class="fill-slot" kind="error" title="票夹没能打开" sub="{{walletErrorMsg}}" primary="重试" fill="{{true}}" size="lg" theme="player" bind:primary="retryWallet" auto-back />
  </view>
  <!-- PR10 F-W1-12:未登录(无会话 / 401)给登录引导,不与加载失败一起留白 -->
  <view class="davidwu" wx:elif="{{walletState === 'login'}}">
    <cy-state-shell class="fill-slot" kind="no-permission" title="登录后查看票夹" primary="登录" fill="{{true}}" size="lg" theme="player" bind:primary="loginWallet" />
  </view>
  <view class="davidwu" wx:elif="{{walletState === 'empty'}}">
    <cy-state-shell class="fill-slot" kind="empty" title="还没有票" fill="{{true}}" size="lg" theme="player" />
  </view>

  <view class="flex-a flex-col main" wx:if="{{walletState === 'ready' && (!focusState || focusState === 'ready')}}" style="padding-top:{{navTop}}px;">
    <!-- v13 票夹:卡片叠放(后面几张往上错开、缩小、变暗),最前一张跟手拖,甩出去下一张上来;点卡进入 -->
    <view class="deck {{deckStill ? 'deck--still' : ''}}" bindtouchstart="onDeckStart" bindtouchmove="onDeckMove" bindtouchend="onDeckEnd" bindtouchcancel="onDeckEnd">
      <!-- 2026-10-28 业主:点卡片翻到背面出示入场码,再点翻回;进游戏改由底部「开始游戏」。
           票夹只放能用的票(已付款、未核验、未过期),卡上不写状态。 -->
      <view wx:for="{{ticketList}}" wx:key="wKey" class="wc" style="{{deckPoses[index]}}{{index === currentSwiperTicket ? '' : 'pointer-events: none;'}}" bindtap="onCardTap" data-index="{{index}}" hover-class="cy-pressed" hover-stay-time="80"
        aria-role="button" aria-label="{{flipped && index === currentSwiperTicket ? '翻回正面' : '出示入场码'}}，{{item.wTitle}}" aria-hidden="{{index !== currentSwiperTicket}}">
        <view class="wc__flip {{flipped && index === currentSwiperTicket ? 'wc__flip--back' : ''}}">
          <view class="wc__face wc__front">
            <view class="wc__go" style="background: {{item.wColor}};"><image src="./icon_go.svg" mode="aspectFit" /></view>
            <view class="wc__t"><text class="wc__b">{{item.wTitle}}</text><text class="wc__s">{{item.wSub}}</text></view>
            <view class="wc__im"><image lazy-load="true" src="{{item.wImg}}" mode="aspectFill" /></view>
          </view>
          <view class="wc__face wc__back" wx:if="{{index === currentSwiperTicket}}">
            <text class="wc__bn ep1">{{item.wTitle}}</text>
            <view class="wc__qr">
              <image wx:if="{{qrState === 'ready'}}" class="wc__qr-img" src="{{qrUrl}}" mode="aspectFit" />
              <view wx:if="{{qrState === 'ready'}}" class="wc__qr-logo"><image class="wc__qr-logo-img" src="/images/cy_logo_mark.png" mode="aspectFit" /></view>
              <text wx:elif="{{qrState === 'error'}}" class="wc__qr-tip" catchtap="retryQr" aria-role="button" aria-label="重新生成入场码" hover-class="cy-pressed" hover-stay-time="80">重新生成</text>
              <text wx:else class="wc__qr-tip">生成中…</text>
            </view>
            <text wx:if="{{item.wExpiry}}" class="wc__exp">{{item.wExpiry}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 2026-09-04 判定表:「票夹全页没有任何队伍入口」。这一行跟着当前那张票走 ——
         队伍是挂在具体某场/某条路线上的,放在票外面写死一个「我的队伍」会指向别的票。
         没有队伍就整行不出:不摆一个点进去是空的入口。 -->
    <view class="team-entry" wx:if="{{currentTeam}}" style="top: {{navTop + 4}}px;" bindtap="goMyTeam"
      hover-class="cy-pressed" hover-stay-time="80"
      aria-role="button" aria-label="打开我的队伍{{currentTeam.title ? '：' + currentTeam.title : ''}}">
      <view class="team-entry__main">
        <text class="team-entry__k">我的队伍</text>
        <text class="team-entry__v ep1" wx:if="{{currentTeam.title}}">{{currentTeam.title}}</text>
      </view>
      <!-- 人数拿不到就不写,不补 0/0 -->
      <text class="team-entry__n" wx:if="{{currentTeam.joinedCount !== null && currentTeam.maxMembers !== null}}">{{currentTeam.joinedCount}}/{{currentTeam.maxMembers}}</text>
      <cy-icon name="arrow-right" size="24" />
    </view>
  </view>
  <view class="wl-start {{entering ? 'wl-start--go' : ''}} {{startLit ? 'wl-start--lit' : ''}}" wx:if="{{walletState === 'ready' && ticketList.length}}" bindtap="goTicket" data-index="{{currentSwiperTicket}}" data-go="1" aria-role="button" aria-label="开始游戏：{{ticketList[currentSwiperTicket].wTitle}}" hover-class="cy-pressed" hover-stay-time="80">
    <view class="wl-start__fill"></view><view class="wl-start__shine" wx:if="{{!reduced}}"></view>
    <view class="wl-start__lbl"><image class="wl-start__play" src="./icon_play.svg" mode="aspectFit" /><text>开始游戏</text></view>
  </view>
  <view class="wl-burst {{entering ? 'wl-burst--go' : ''}}" wx:if="{{walletState === 'ready'}}"></view>
</view>
</view>
