@import '../../../style/reduced-motion.wxss';
/* r2-finish 榜单:月桂大名次(refs2/team-rank-laurel-frames)+ 深色玻璃数据卡,颜色全走 token */
.rb { display: flex; flex-direction: column; gap: var(--cy-space-4); color: var(--cy-color-text-primary); }
.rb-bar { display: flex; align-items: center; justify-content: flex-end; gap: var(--cy-space-3); min-height: 88rpx; }
.rb-bar__tabs { flex: 1; min-width: 0; }
.rb-more { flex: none; display: flex; align-items: center; gap: 6rpx; min-height: 88rpx; padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-pill);
  font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); background: var(--cy-comp-sheet-group-bg); }
.rb-more.is-on { color: var(--cy-color-text-primary); }
/* l-after(proto st-rank .lau2 / MOTION M13):两枝细茎小叶月桂(images/laurel.svg,右枝镜像)从 .6 弹到 1,
   中间 168rpx 等宽数字按位滚动(--cy-motion-roll / --cy-ease-roll),「前 N%」滚完后升起 */
.rb-hero { display: flex; flex-direction: column; align-items: center; padding-top: var(--cy-space-2); }
.rb-hero__wreath { position: relative; display: flex; align-items: center; justify-content: center; gap: 8rpx; height: 240rpx; }
.rb-hero__laurel { flex: none; width: 96rpx; height: 220rpx; opacity: 0; transform: scale(.6);
  transition: transform var(--cy-motion-reveal, 450ms) var(--cy-ease-spring), opacity var(--cy-motion-fast) ease; }
.rb-hero__laurel--r { transform: scale(.6) scaleX(-1); }
.rb-hero.is-on .rb-hero__laurel { opacity: 1; transform: none; }
.rb-hero.is-on .rb-hero__laurel--r { transform: scaleX(-1); }
.rb-hero__num { position: relative; display: flex; height: 168rpx; margin: 0 16rpx; overflow: hidden; }
.rb-digit { height: 168rpx; overflow: hidden; }
.rb-digit__col { display: flex; flex-direction: column; transition: transform var(--cy-motion-roll, 520ms) var(--cy-ease-roll, cubic-bezier(.2, .9, .2, 1)); }
.rb-digit__n { display: block; height: 168rpx; line-height: 168rpx; font-size: 168rpx; font-weight: 800; letter-spacing: -.04em; /* ds-ok 月桂大名次字号(proto 84px) */
  font-variant-numeric: tabular-nums; color: var(--cy-color-text-primary); text-align: center; } /* ds-ok 月桂大名次(参考 team-rank-laurel)*/
.rb-hero__pct { margin-top: var(--cy-space-1); font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); opacity: 0; transform: translateY(16rpx);
  transition: opacity var(--cy-motion-standard) ease 640ms, transform var(--cy-motion-standard) var(--cy-ease-settle, cubic-bezier(.16, 1, .3, 1)) 640ms; }
.rb-hero.is-on .rb-hero__pct { opacity: 1; transform: none; }
.rb-stats { align-self: stretch; display: grid; grid-template-columns: 1fr 1fr; gap: var(--cy-space-3); margin-top: var(--cy-space-4); }
.rb-stat { display: flex; flex-direction: column; gap: 8rpx; padding: var(--cy-space-3) var(--cy-space-4); border-radius: var(--cy-comp-sheet-group-radius);
  background: var(--cy-color-bg-glass); border: 1rpx solid var(--cy-comp-sheet-group-line); }
.rb-stat__l { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.rb-stat__v { font-size: var(--cy-type-section-title); font-weight: 700; font-variant-numeric: tabular-nums; }
.rb-period { display: flex; justify-content: center; }
.rb-list { border-radius: var(--cy-comp-sheet-group-radius); overflow: hidden; background: var(--cy-comp-sheet-group-bg); transition: opacity .2s ease; }
.rb-list.is-busy { opacity: .5; }
.rb-row { position: relative; display: flex; align-items: center; gap: 24rpx; min-height: 96rpx; padding: 16rpx 31rpx; box-sizing: border-box; }
.rb-row + .rb-row::before { content: ''; position: absolute; top: 0; left: 31rpx; right: 0; height: 1rpx; background: var(--cy-comp-sheet-group-line); }
.rb-row--head { justify-content: space-between; min-height: 80rpx; }
.rb-row.is-me .rb-row__b { color: var(--cy-color-status-success); }
.rb-row__b { font-size: var(--cy-type-body); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rb-row__s { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.rb-row__v { flex: none; font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); font-variant-numeric: tabular-nums; }
.rb-grow { flex: 1; min-width: 0; }
.rb-rank { flex: none; width: 48rpx; text-align: center; font-size: var(--cy-type-body); font-weight: 700; color: var(--cy-color-text-secondary); font-variant-numeric: tabular-nums; }
.rb-rank.is-top { color: var(--cy-color-status-success); }
.rb-av { flex: none; width: 64rpx; height: 64rpx; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center;
  background: var(--cy-color-bg-elevated); font-size: var(--cy-type-label); font-weight: 600; }
.rb-av__img { width: 100%; height: 100%; }
.rb-note { display: block; padding: 20rpx 31rpx; font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.rb--reduced .rb-digit__col, .rb--reduced .rb-list, .rb--reduced .rb-hero__laurel, .rb--reduced .rb-hero__pct { transition: none; }
.rb--reduced .rb-hero__laurel, .rb--reduced .rb-hero__pct { opacity: 1; transform: none; }
.rb--reduced .rb-hero__laurel--r { transform: scaleX(-1); }
.rb-more__ic { display: flex; transform: rotate(90deg); }
.rb-bar__tabs.is-single { flex: none; margin-right: auto; }
/* qx-final:isolated 组件取不到全局 .cy-pressed,按压类在组件内定义(同 components/cy/card) */
.cy-pressed { opacity: .88; }

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.rb-more { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
.rb-stat__l { font-variant-numeric: tabular-nums; }
