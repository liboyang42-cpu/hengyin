.ib--pass.p1 .x-lan { transform: rotate(6deg); transition: transform 1600ms ease-in-out 100ms; }
.ib--pass.p1 .x-valid { opacity: 1; transform: scale(1.25); transition: transform 1600ms ease-in-out, opacity 1600ms ease-in-out; }

/* 积分:三枚依次落下压实(主)· 顶上那枚翻一面(次)· 叠完冒个 + */
.ib--points .x-c1, .ib--points .x-c2, .ib--points .x-c3 { transform-origin: 50% 71.67%; opacity: 0; transform: translateY(-38.33%); }
.ib--points.is-on .x-c1 { opacity: 1; transform: none; transition: transform 550ms cubic-bezier(.34,1.56,.64,1) 60ms, opacity 200ms ease 60ms; }
.ib--points.is-on .x-c2 { opacity: 1; transform: none; transition: transform 550ms cubic-bezier(.34,1.56,.64,1) 260ms, opacity 200ms ease 260ms; }
.ib--points.is-on .x-c3 { opacity: 1; transform: none; transition: transform 550ms cubic-bezier(.34,1.56,.64,1) 460ms, opacity 200ms ease 460ms; }
.ib--points .x-plus { transform-origin: 83.33% 25%; opacity: 0; transform: scale(0); }
.ib--points.is-on .x-plus { opacity: 0; transform: scale(0); transition: none; }
.ib--points.is-idle .x-c3 { transition: transform 400ms ease-in-out; }
.ib--points.p1 .x-c3 { transform: scaleX(.1); transition: transform 400ms ease-in-out; }
.ib--points.p2 .x-plus { opacity: 1; transform: scale(1.2) translateY(-1.67%); transition: transform 240ms ease-out, opacity 240ms ease-out; }
.ib--points.p3 .x-c3 { transform: none; transition: transform 400ms ease-in-out; }
.ib--points.p3 .x-plus { opacity: 1; transform: scale(1) translateY(-6.67%); transition: transform 600ms ease-out; }
.ib--points.p4 .x-plus { opacity: 0; transition: opacity 200ms ease-out; }

/* 章节印:举起、落下、压实再抬起(主)· 印记压下那一刻才显出、溅两点墨(次) */
.ib--seal .x-stp { opacity: 0; transform: translateY(-25%); }
.ib--seal.is-on .x-stp { opacity: 1; transform: none; transition: transform 1000ms cubic-bezier(.34,1.56,.64,1) 80ms, opacity 300ms ease 80ms; }
.ib--seal .x-imp { transform-origin: 50% 75.83%; opacity: 0; transform: scale(1.5); }
.ib--seal.is-on .x-imp { opacity: 1; transform: none; transition: transform 400ms cubic-bezier(.34,1.56,.64,1) 560ms, opacity 200ms ease 560ms; }
.ib--seal .x-ink { transform-origin: 81.67% 65%; opacity: 0; transform: scale(0); }
.ib--seal .x-ink-i2 { transform-origin: 18.33% 70%; opacity: 0; transform: scale(0); }
.ib--seal .x-stamped { transform-origin: 85% 25%; }
.ib--seal.is-idle .x-stp { transition: transform 288ms cubic-bezier(.5,0,.2,1); }
.ib--seal.is-idle .x-imp { transition: transform 792ms ease-out; }
.ib--seal.is-idle .x-ink, .ib--seal.is-idle .x-ink-i2, .ib--seal.is-idle .x-stamped { transition: none; }
.ib--seal.p1 .x-stp { transform: translateY(-8.33%); transition: transform 288ms cubic-bezier(.5,0,.2,1); }
.ib--seal.p2 .x-stp { transform: translateY(8.33%) scale(1.02, .96); transition: transform 288ms cubic-bezier(.5,0,.2,1); }
.ib--seal.p3 .x-imp { transform: scale(1.06, .9); transition: transform 108ms ease-out; }
.ib--seal.p4 .x-imp { transform: none; transition: transform 792ms ease-out; }
.ib--seal.p4 .x-ink, .ib--seal.p4 .x-ink-i2, .ib--seal.p4 .x-stamped { opacity: 1; transform: scale(1.25) rotate(20deg); transition: transform 216ms ease-out, opacity 216ms ease-out; }
.ib--seal.p4 .x-ink-i2 { transition-delay: 100ms; }
.ib--seal.p5 .x-stp { transform: none; transition: transform 288ms cubic-bezier(.5,0,.2,1); }
.ib--seal.p5 .x-ink, .ib--seal.p5 .x-ink-i2, .ib--seal.p5 .x-stamped { opacity: 1; transform: scale(1) rotate(40deg); transition: transform 288ms ease-out; }
.ib--seal.p6 .x-ink, .ib--seal.p6 .x-ink-i2, .ib--seal.p6 .x-stamped { opacity: 0; transform: scale(.6) rotate(60deg); transition: transform 288ms ease-out, opacity 288ms ease-out; }

/* 减少动态效果:直接终态(原型 prefers-reduced-motion:动画全停,闪光 / 爆星 / 纸屑 / + 全部静态显示,钩画满) */
.ib.is-reduced .ib__l { transition: none; opacity: 1; transform: none; clip-path: none; }
