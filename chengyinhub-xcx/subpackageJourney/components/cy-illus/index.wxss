.ib--pass .x-lan { transform-origin: 50% 1.67%; }
.ib--pass .x-valid { transform-origin: 66.67% 29.17%; }
.ib--pass.is-idle .x-card { transform: rotate(-6deg); transition: transform 1600ms ease-in-out; }
.ib--pass.is-idle .x-lan { transform: rotate(-6deg); transition: transform 1600ms ease-in-out 100ms; }
