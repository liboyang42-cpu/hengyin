.ib--team.p8 .x-heart { opacity: 0; transform: scale(.8) translateY(-18.33%); transition: transform 600ms ease-out, opacity 600ms ease-out; }

/* 通行证:挂在绳上来回荡(主)· 挂绳慢半拍(次)· 票头「有效」小点呼吸 */
