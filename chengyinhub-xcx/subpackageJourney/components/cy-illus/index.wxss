.ib--clue.p9 .x-found, .ib--clue.p9 .x-found-f2 { opacity: 0; transform: scale(.6) rotate(60deg); transition: transform 288ms ease-out, opacity 288ms ease-out; }

/* 勋章:落下压扁(主)· 绶带慢半拍摆(次)· 落定爆一次星 */
.ib--badge .x-md { transform-origin: 50% 41.67%; opacity: 0; transform: translateY(-33.33%) scale(.9); }
