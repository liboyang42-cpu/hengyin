.ib--badge.e1 .x-burst-0, .ib--badge.e1 .x-burst-1, .ib--badge.e1 .x-burst-2, .ib--badge.e1 .x-burst-3 { opacity: 1; transform: scale(1.25) rotate(20deg); transition: transform 330ms ease-out, opacity 330ms ease-out; }
.ib--badge.e2 .x-burst-0, .ib--badge.e2 .x-burst-1, .ib--badge.e2 .x-burst-2, .ib--badge.e2 .x-burst-3 { opacity: 1; transform: scale(1) rotate(40deg); transition: transform 440ms ease-out; }
.ib--badge.e3 .x-burst-0, .ib--badge.e3 .x-burst-1, .ib--badge.e3 .x-burst-2, .ib--badge.e3 .x-burst-3 { opacity: 0; transform: scale(.6) rotate(60deg); transition: transform 330ms ease-out, opacity 330ms ease-out; }
.ib--badge.is-idle .x-md { transition: transform 2600ms ease-in-out; }
.ib--badge.is-idle .x-rib { transition: transform 780ms ease-in-out; }
.ib--badge.p1 .x-rib { transform: rotate(-7deg); transition: transform 520ms ease-in-out; }
.ib--badge.p1 .x-md { transform: translateY(-2.5%); transition: transform 2600ms ease-in-out; }
.ib--badge.p2 .x-rib { transform: rotate(5deg); transition: transform 650ms ease-in-out; }
.ib--badge.p3 .x-rib { transform: rotate(-2deg); transition: transform 650ms ease-in-out; }
.ib--badge.p4 .x-rib { transform: none; transition: transform 780ms ease-in-out; }
.ib--badge.p5 .x-rib { transform: rotate(-7deg); transition: transform 520ms ease-in-out; }
.ib--badge.p5 .x-md { transform: none; transition: transform 2600ms ease-in-out; }
