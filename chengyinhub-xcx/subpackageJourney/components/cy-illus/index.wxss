.ib--wait .x-sand-b { transform-origin: 50% 76.67%; }
.ib--wait.is-idle .x-hg { transform: none; transition: none; }
.ib--wait.is-idle .x-sand-t { transform: none; transition: none; }
.ib--wait.is-idle .x-sand-b { transform: scaleY(.35); transition: none; }
.ib--wait.is-idle .x-grain, .ib--wait.is-idle .x-grain-g2, .ib--wait.is-idle .x-grain-gr3 { opacity: 1; transform: translateY(-6.67%); transition: none; }
.ib--wait.is-idle .x-glint { transition: transform 2100ms ease-in-out; }
.ib--wait.p1 .x-sand-t { transform: scaleY(.25); transition: transform 3108ms linear; }
.ib--wait.p1 .x-sand-b { transform: scaleY(1); transition: transform 3108ms linear; }
.ib--wait.p1 .x-glint { transform: translateX(2.5%); transition: transform 2100ms ease-in-out; }
.ib--wait.p1 .x-grain, .ib--wait.p1 .x-grain-g2, .ib--wait.p1 .x-grain-gr3 { opacity: 0; transform: translateY(13.33%); transition: transform 700ms linear, opacity 700ms cubic-bezier(.7,0,1,1); }
.ib--wait.p1 .x-grain-g2 { transition-delay: 150ms; }
.ib--wait.p1 .x-grain-gr3 { transition-delay: 300ms; }
.ib--wait.p2 .x-grain, .ib--wait.p2 .x-grain-g2, .ib--wait.p2 .x-grain-gr3 { opacity: 1; transform: translateY(-6.67%); transition: none; }
.ib--wait.p3 .x-grain, .ib--wait.p3 .x-grain-g2, .ib--wait.p3 .x-grain-gr3 { opacity: 0; transform: translateY(13.33%); transition: transform 700ms linear, opacity 700ms cubic-bezier(.7,0,1,1); }
.ib--wait.p3 .x-grain-g2 { transition-delay: 150ms; }
.ib--wait.p3 .x-grain-gr3 { transition-delay: 300ms; }
.ib--wait.p4 .x-grain, .ib--wait.p4 .x-grain-g2, .ib--wait.p4 .x-grain-gr3 { opacity: 1; transform: translateY(-6.67%); transition: none; }
.ib--wait.p4 .x-glint { transform: none; transition: transform 2100ms ease-in-out; }
.ib--wait.p5 .x-grain, .ib--wait.p5 .x-grain-g2, .ib--wait.p5 .x-grain-gr3 { opacity: 0; transform: translateY(13.33%); transition: transform 700ms linear, opacity 700ms cubic-bezier(.7,0,1,1); }
.ib--wait.p5 .x-grain-g2 { transition-delay: 150ms; }
.ib--wait.p5 .x-grain-gr3 { transition-delay: 300ms; }
.ib--wait.p6 .x-hg { transform: rotate(180deg); transition: transform 756ms cubic-bezier(.5,0,.25,1.3); }
.ib--wait.p6 .x-grain, .ib--wait.p6 .x-grain-g2, .ib--wait.p6 .x-grain-gr3 { opacity: 0; transform: translateY(-6.67%); transition: none; }
.ib--wait.p7 .x-sand-t { transform: none; transition: none; }
.ib--wait.p7 .x-sand-b { transform: scaleY(.35); transition: none; }

/* 队伍:两侧往中间靠(主)· 中间那个蹦一下、头顶冒一颗心(次) */
