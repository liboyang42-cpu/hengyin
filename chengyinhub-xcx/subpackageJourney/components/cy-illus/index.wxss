/* cy-illus:原型 page.css 的 .il / .il--* 改写成过渡(不新增 keyframes)。只动 transform / opacity。 */
.il { position: relative; display: inline-block; flex: none; }
.il__bl, .il__fg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform-origin: 50% 50%; will-change: transform, opacity; }

/* 进场起点(未加 is-on) */
.il__bl { opacity: 0; transform: scale(.3) rotate(-20deg); transition: transform 600ms cubic-bezier(.16,1,.3,1), opacity 600ms cubic-bezier(.16,1,.3,1); }
.il__fg { opacity: 0; transform: scale(.5) rotate(-8deg); transition: transform 650ms cubic-bezier(.2,1.4,.5,1) 120ms, opacity 400ms ease 120ms; }
.il-in--swing .il__fg { transform-origin: 33% 35%; transform: rotate(-70deg); transition: transform 900ms cubic-bezier(.16,1,.3,1) 500ms, opacity 300ms ease 500ms; }
.il-in--press .il__fg { transform: scale(1.5); transition: transform 600ms cubic-bezier(.3,1.3,.5,1) 200ms, opacity 400ms ease 200ms; }
.il-in--drop .il__fg { transform: translateY(-28rpx) scale(.6); transition: transform 500ms cubic-bezier(.2,1.4,.5,1) 600ms, opacity 400ms ease 600ms; }
.il-in--burst .il__fg { transform-origin: 50% 47%; transform: scale(0) rotate(-40deg); transition: transform 700ms cubic-bezier(.2,1.4,.5,1) 300ms, opacity 400ms ease 300ms; }

/* 进场终点 */
.il.is-on .il__bl, .il.is-on .il__fg { opacity: 1; transform: none; }

/* 待机往复:is-idle 在终点与偏移之间来回切,过渡时长 = 半周期 */
.il.is-on.is-idle .il__bl { transform: scale(1.06) rotate(3deg); }
.il.is-on .il__bl { transition: transform 2500ms ease-in-out, opacity 600ms ease; }
.il.is-on .il__fg { transition: transform 1800ms ease-in-out, opacity 400ms ease; }
.il-idle--float.is-on.is-idle .il__fg { transform: translateY(-6rpx); }
.il-idle--sway.is-on .il__fg { transition: transform 4500ms linear, opacity 400ms ease; }
.il-idle--sway.is-on.is-idle .il__fg { transform: rotate(24deg); }
.il-idle--flip.is-on .il__fg { transition: transform 900ms ease-in-out, opacity 400ms ease; }
.il-idle--flip.is-on.is-idle .il__fg { transform: rotate(180deg); }
.il-idle--wobble.is-on.is-idle .il__fg { transform: rotate(-5deg) translateY(-4rpx); }
.il-idle--swing.is-on .il__fg { transform-origin: 33% 35%; }
.il-idle--swing.is-on.is-idle .il__fg { transform: rotate(6deg); }
.il-idle--hang.is-on .il__fg { transform-origin: 50% 15%; }
.il-idle--hang.is-on.is-idle .il__fg { transform: rotate(3deg); }
.il-idle--scan.is-on.is-idle .il__fg { transform: translateX(10rpx) rotate(3deg); }
.il-idle--drift.is-on.is-idle .il__fg { transform: translateX(6rpx); }

/* 减少动态效果:直接终态 */
.il.is-reduced .il__bl, .il.is-reduced .il__fg { transition: none; opacity: 1; transform: none; }

/* ===== 风格 B v2 精致插画(l-iconsB,proto/icons icons-b.js + icons.css .ib--*)=====
   每层是一张 120×120 画布的图,transform-origin / translate 的百分比 = 原型 px ÷ 1.2。
   原型的关键帧动画改成阶段类上的过渡:is-on 进场终点,e1… 进场后续阶段(只加不撤),is-idle 待机底态,p1… 一圈内逐个累加(index.js / art-b.js MOTION)。
   同一层在后面的阶段规则覆盖前面的(同权重,按书写顺序)。 */
.ib { position: relative; display: inline-block; flex: none; }
.ib__l { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform-origin: 50% 50%; }
/* 原型 .ib svg>g:每个顶层组从 .2 弹出 */
.ib__g--g { opacity: 0; transform: scale(.2); }
.ib.is-on .ib__g--g { opacity: 1; transform: none; transition: transform 620ms cubic-bezier(.34,1.56,.64,1) 80ms, opacity 300ms ease 80ms; }
/* 地影横向展开 */
.ib .x-gd { transform-origin: 50% 89.17%; opacity: 0; transform: scaleX(.2); }
.ib.is-on .x-gd { opacity: 1; transform: none; transition: transform 600ms cubic-bezier(.34,1.56,.64,1), opacity 300ms ease; }
/* 顶层闪光星(原型 svg>path.sp):平时不出,只在「完成」那一下闪 */
.ib .x-sp, .ib .x-found, .ib .x-found-f2, .ib .x-click, .ib .x-click-f2, .ib .x-stamped { opacity: 0; transform: scale(0); }

/* 线索:放大镜左右找(主)· 纸条探头、镜面反光扫过(次)· 找到才闪 */
.ib--clue .x-note { transform-origin: 41.67% 71.67%; }
.ib--clue.is-on .x-note { transition: transform 500ms cubic-bezier(.34,1.56,.64,1), opacity 300ms ease; }
.ib--clue .x-mg { transform-origin: 41.67% 41.67%; }
.ib--clue .x-glint { opacity: 0; clip-path: inset(0 72% 0 28%); }
.ib--clue .x-found { transform-origin: 80% 25%; }
.ib--clue .x-found-f2 { transform-origin: 18.33% 21.67%; }
.ib--clue.is-idle .x-mg { transition: transform 1010ms ease-in-out; }
.ib--clue.is-idle .x-note { transition: transform 430ms ease-in-out; }
.ib--clue.is-idle .x-glint, .ib--clue.is-idle .x-found, .ib--clue.is-idle .x-found-f2 { transition: none; }
.ib--clue.p1 .x-mg { transform: translate(-7.5%, 3.33%) rotate(-7deg); transition: transform 790ms ease-in-out; }
.ib--clue.p2 .x-mg { transform: translate(5.83%, -2.5%) rotate(6deg); transition: transform 1010ms ease-in-out; }
.ib--clue.p2 .x-glint { opacity: 1; clip-path: inset(0 57% 0 28%); transition: opacity 200ms ease, clip-path 540ms ease-in-out; }
.ib--clue.p3 .x-mg { transform: translate(-1.67%, 1.67%) rotate(-1deg); transition: transform 790ms ease-in-out; }
.ib--clue.p3 .x-glint { opacity: 0; clip-path: inset(0 57% 0 43%); transition: opacity 400ms ease, clip-path 720ms ease-in-out; }
.ib--clue.p4 .x-note { transform: translateY(-5%) rotate(-6deg); transition: transform 540ms ease-in-out; }
.ib--clue.p5 .x-mg { transform: none; transition: transform 1010ms ease-in-out; }
.ib--clue.p6 .x-note { transform: translateY(-1.67%) rotate(2deg); transition: transform 470ms ease-in-out; }
.ib--clue.p7 .x-found, .ib--clue.p7 .x-found-f2 { opacity: 1; transform: scale(1.25) rotate(20deg); transition: transform 216ms ease-out, opacity 216ms ease-out; }
.ib--clue.p7 .x-found-f2 { transition-delay: 160ms; }
.ib--clue.p8 .x-note { transform: none; transition: transform 430ms ease-in-out; }
