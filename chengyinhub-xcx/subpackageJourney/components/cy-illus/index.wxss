.ib--badge.p8 .x-rib { transform: none; transition: transform 780ms ease-in-out; }

/* 钥匙:在锁里转四分之一圈再弹回(主)· 宝石随转动闪(次)· 转到底才有一粒绿光 */
.ib--key .x-kb, .ib--key .x-gem { transform-origin: 33.33% 33.33%; }
.ib--key .x-click { transform-origin: 83.33% 23.33%; }
.ib--key .x-click-f2 { transform-origin: 18.33% 70%; }
.ib--key.is-idle .x-kb { transition: transform 1020ms cubic-bezier(.5,0,.3,1); }
.ib--key.is-idle .x-gem { transition: transform 1360ms ease-in-out; }
.ib--key.is-idle .x-click, .ib--key.is-idle .x-click-f2 { transition: none; }
.ib--key.p1 .x-kb { transform: rotate(-90deg); transition: transform 612ms cubic-bezier(.5,0,.3,1); }
.ib--key.p2 .x-gem { transform: scale(1.18); transition: transform 340ms ease-in-out; }
.ib--key.p3 .x-kb { transform: rotate(-82deg); transition: transform 408ms cubic-bezier(.5,0,.3,1); }
.ib--key.p4 .x-gem { transform: none; transition: transform 1360ms ease-in-out; }
.ib--key.p5 .x-kb { transform: none; transition: transform 1020ms cubic-bezier(.5,0,.3,1); }
.ib--key.p6 .x-click, .ib--key.p6 .x-click-f2 { opacity: 1; transform: scale(1.25) rotate(20deg); transition: transform 204ms ease-out, opacity 204ms ease-out; }
.ib--key.p6 .x-click-f2 { transition-delay: 150ms; }
.ib--key.p7 .x-click, .ib--key.p7 .x-click-f2 { opacity: 1; transform: scale(1) rotate(40deg); transition: transform 272ms ease-out; }
.ib--key.p8 .x-click, .ib--key.p8 .x-click-f2 { opacity: 0; transform: scale(.6) rotate(60deg); transition: transform 272ms ease-out, opacity 272ms ease-out; }

/* 成功:方砖盖下(主)· 钩从左往右画出 · 画完三色纸屑弹出再落下(只一次) */
.ib--success .x-tile { transform-origin: 50% 48.33%; opacity: 0; transform: scale(1.5); }
.ib--success.is-on .x-tile { opacity: 1; transform: none; transition: transform 500ms cubic-bezier(.34,1.56,.64,1) 80ms, opacity 300ms ease 80ms; }
.ib--success .x-ck { clip-path: inset(0 72% 0 0); }
.ib--success.is-on .x-ck { clip-path: inset(0 27% 0 0); transition: clip-path 450ms ease-out 440ms; }
.ib--success .x-conf { opacity: 0; transform: none; }
.ib--success.is-on .x-conf { opacity: 0; transform: none; transition: none; }
.ib--success .x-conf-0, .ib--success .x-conf-1, .ib--success .x-conf-2, .ib--success .x-conf-3, .ib--success .x-conf-4 { opacity: 0; transform: scale(0); }
.ib--success .x-conf-0 { transform-origin: 85.42% 22.08%; }
.ib--success .x-conf-1 { transform-origin: 16.67% 26.67%; }
.ib--success .x-conf-2 { transform-origin: 86.67% 53.33%; }
.ib--success .x-conf-3 { transform-origin: 15% 60%; }
