.ib--success.e1 .x-conf { opacity: 1; transition: opacity 100ms linear; }
.ib--success.e1 .x-conf-0, .ib--success.e1 .x-conf-1, .ib--success.e1 .x-conf-2, .ib--success.e1 .x-conf-3, .ib--success.e1 .x-conf-4 { opacity: 1; transform: scale(1.3) translateY(-8.33%) rotate(40deg); transition: transform 240ms cubic-bezier(.2,.6,.3,1), opacity 240ms cubic-bezier(.2,.6,.3,1); }
.ib--success.e2 .x-conf-0, .ib--success.e2 .x-conf-1, .ib--success.e2 .x-conf-2, .ib--success.e2 .x-conf-3, .ib--success.e2 .x-conf-4 { opacity: 0; transform: scale(.9) translateY(21.67%) rotate(200deg); transition: transform 1360ms cubic-bezier(.2,.6,.3,1), opacity 1360ms ease-in; }

/* 失败:落地后(D-63 业主「去掉」落地抖动)再裂成两半 · 小云飘来(次)、只掉一滴 */
.ib--fail .x-tile { transform-origin: 50% 48.33%; opacity: 0; transform: translateY(-25%); }
.ib--fail.is-on .x-tile { opacity: 1; transform: none; transition: transform 550ms cubic-bezier(.2,.8,.2,1) 80ms, opacity 300ms ease 80ms; }
.ib--fail .x-hl { transform-origin: 38.33% 56.67%; }
.ib--fail .x-hr { transform-origin: 63.33% 56.67%; }
.ib--fail.e1 .x-hl { transform: translate(-1.67%, .83%) rotate(-2deg); transition: transform 600ms cubic-bezier(.34,1.56,.64,1); }
.ib--fail.e1 .x-hr { transform: translate(3.33%, 2.5%) rotate(4deg); transition: transform 600ms cubic-bezier(.34,1.56,.64,1); }
.ib--fail .x-cloud { transform-origin: 80% 23.33%; opacity: 0; transform: translateX(21.67%); }
.ib--fail.is-on .x-cloud { opacity: 1; transform: none; transition: transform 900ms cubic-bezier(.2,.8,.2,1) 1100ms, opacity 600ms ease 1100ms; }
.ib--fail .x-drop { transform-origin: 80% 32.92%; }
.ib--fail.is-idle .x-cloud { transition: transform 1800ms ease-in-out; }
.ib--fail.is-idle .x-drop { opacity: 0; transform: scale(0); transition: none; }
.ib--fail.p1 .x-cloud { transform: translateY(-2.5%); transition: transform 1800ms ease-in-out; }
.ib--fail.p2 .x-drop { opacity: 1; transform: scale(1); transition: transform 270ms ease-in, opacity 270ms ease-in; }
.ib--fail.p3 .x-drop { opacity: 0; transform: translateY(33.33%) scale(1); transition: transform 990ms ease-in, opacity 990ms ease-in; }
.ib--fail.p4 .x-drop { opacity: 0; transform: scale(0); transition: none; }
.ib--fail.p4 .x-cloud { transform: none; transition: transform 1800ms ease-in-out; }
.ib--fail.p5 .x-drop { opacity: 1; transform: scale(1); transition: transform 270ms ease-in, opacity 270ms ease-in; }
.ib--fail.p6 .x-drop { opacity: 0; transform: translateY(33.33%) scale(1); transition: transform 990ms ease-in, opacity 990ms ease-in; }

/* 调查中:金沙一粒粒落、底堆慢慢涨(主)· 到点整只翻转带过冲 · 玻璃高光跟着晃(次) */
