@import '../../style/journey.wxss';
/* l-after 结算四步(proto/game .stl):主题之外的纯玩家黑底白字,整屏居中;底部按钮固定在底部,圆角走按钮 token。
   动效只用 transition(keyframes 棘轮不新增);减少动态效果直接终态。 */
.st { --st-gold: #E9C47C; /* ds-ok 与章节完成卡、结局印章同一金色(五星 / 已通关眉题) */ min-height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; color: var(--cy-color-text-primary);
  background: var(--cy-color-bg-page); padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }
.st-dots { display: flex; justify-content: center; gap: 12rpx; margin-top: 4rpx; }
.st-dot { width: 60rpx; height: 4rpx; border-radius: var(--cy-radius-pill); background: var(--cy-comp-sheet-group-bg); transition: background-color var(--cy-motion-standard) ease; }
.st-dot.is-on { background: var(--cy-color-text-primary); }
.st-body { flex: 1; display: flex; flex-direction: column; gap: var(--cy-space-4); padding: var(--cy-space-5) 48rpx 0; }
.st-body--center { justify-content: center; align-items: center; text-align: center; padding-top: 0; }
.st-body--top { justify-content: flex-start; padding-top: 120rpx; }
.st-body--share { align-items: center; padding-top: var(--cy-space-4); }
.st-h { display: block; font-size: var(--cy-type-card-title); font-weight: 700; margin-bottom: var(--cy-space-4); }

/* 总览:奖杯插图 + 两点闪光 + 光晕;字与两格依次升起(M1 + stagger-hero) */
.st-hero { position: relative; width: 300rpx; height: 300rpx; margin-bottom: 24rpx; display: flex; align-items: center; justify-content: center; }
.st-glow { position: absolute; left: -90rpx; top: -90rpx; width: 480rpx; height: 480rpx; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(233, 196, 124, .28) 0%, rgba(233, 196, 124, 0) 68%); /* ds-ok 奖杯金色光晕 */
  opacity: 0; transform: scale(.6); transition: opacity var(--cy-motion-reveal, 450ms) ease 400ms, transform var(--cy-motion-reveal, 450ms) var(--cy-ease-settle, cubic-bezier(.16, 1, .3, 1)) 400ms; }
.st-ov.is-on .st-glow { opacity: 1; transform: none; }
.st-spk { position: absolute; }
.st-spk--a { right: -36rpx; top: -10rpx; }
.st-spk--b { left: -30rpx; bottom: 20rpx; }
.st-rise { opacity: 0; transform: translateY(36rpx);
  transition: opacity var(--cy-motion-slow) ease calc(500ms + var(--i, 0) * var(--cy-motion-stagger-hero, 90ms)), transform var(--cy-motion-slow) var(--cy-ease-settle, cubic-bezier(.16, 1, .3, 1)) calc(500ms + var(--i, 0) * var(--cy-motion-stagger-hero, 90ms)); }
.st-ov.is-on .st-rise { opacity: 1; transform: none; }
.st-kicker { font-size: var(--cy-type-label); letter-spacing: .12em; color: var(--cy-color-text-secondary); }
.st-title { font-size: var(--cy-type-page-title); font-weight: 800; line-height: 1.25; }
.st-rank { font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); }
.st-rank__n { color: var(--cy-color-text-primary); font-weight: 700; }
.st-two { display: flex; width: 600rpx; margin-top: 28rpx; gap: 2rpx; border-radius: var(--cy-radius-md); overflow: hidden;
  background: var(--cy-comp-sheet-group-line); border: 1rpx solid var(--cy-comp-sheet-group-line); }
.st-two__c { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 36rpx 20rpx; background: var(--cy-color-bg-page); }
.st-two__v { font-size: var(--cy-type-section-title); font-weight: 700; font-variant-numeric: tabular-nums; }
.st-two__l { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }

/* 排行榜:导航栏以下的近全屏弹层,从下方升起 */
.st-rankwrap { flex: 1; }
.st-panel { position: fixed; left: 0; right: 0; bottom: 0; z-index: 4; border-radius: var(--cy-radius-xl) var(--cy-radius-xl) 0 0; overflow: hidden;
  background: var(--cy-comp-sheet-player-glass, var(--cy-color-bg-elevated)); box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, .45); /* ds-ok 弹层投影 */
  transform: translateY(100%); transition: transform var(--cy-motion-sheet-full-in) var(--cy-ease-standard); }
.st-panel.is-on { transform: none; }
.st-panel__sv { height: 100%; box-sizing: border-box; padding: 32rpx 32rpx 0; }
.st-panel__pad { height: calc(220rpx + env(safe-area-inset-bottom)); }

/* 评价:五颗金星依次点亮(每颗 micro 一拍),标签片错开升起 */
.st-stars { display: flex; gap: var(--cy-space-3); color: var(--cy-color-text-secondary); margin-top: var(--cy-space-2); }
.st-star { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center;
  transition: transform var(--cy-motion-standard) var(--cy-ease-spring) calc(var(--i, 0) * var(--cy-motion-micro, 100ms)), color var(--cy-motion-micro, 100ms) ease calc(var(--i, 0) * var(--cy-motion-micro, 100ms)); }
.st-star.is-on { color: var(--st-gold); transform: scale(1.08); } /* ds-ok */
.st-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 16rpx; min-height: 64rpx; }
.st-tag { display: inline-flex; align-items: center; min-height: 64rpx; padding: 0 26rpx; border-radius: var(--cy-radius-pill); font-size: var(--cy-type-label);
  background: var(--cy-comp-sheet-group-bg); border: 1rpx solid var(--cy-comp-sheet-group-line); color: var(--cy-color-text-primary);
  opacity: 0; transform: translateY(16rpx); transition: opacity var(--cy-motion-standard) ease calc(var(--i, 0) * var(--cy-motion-stagger, 40ms)), transform var(--cy-motion-standard) var(--cy-ease-settle, cubic-bezier(.16, 1, .3, 1)) calc(var(--i, 0) * var(--cy-motion-stagger, 40ms)), background-color var(--cy-motion-micro, 100ms) ease; }
.st-tags .st-tag { opacity: 1; transform: none; }
.st-tag.is-on { background: var(--cy-color-text-primary); color: var(--cy-color-bg-page); border-color: var(--cy-color-text-primary); }
.st-field { align-self: stretch; position: relative; padding: var(--cy-space-3) var(--cy-space-4) 48rpx; border-radius: var(--cy-comp-sheet-group-radius); background: var(--cy-comp-sheet-group-bg); text-align: left; }
.st-textarea { width: 100%; min-height: 220rpx; font-size: var(--cy-type-body); color: var(--cy-color-text-primary); }
.st-ph { color: var(--cy-color-text-secondary); }
.st-count { position: absolute; right: var(--cy-space-4); bottom: var(--cy-space-2); font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); font-variant-numeric: tabular-nums; }
.st-err { align-self: stretch; text-align: left; font-size: var(--cy-type-label); color: var(--cy-color-status-danger); }

/* 分享卡:封面淡入底 + 勋章插图 + 已通关 + 主题名 + 成绩 + 城瘾(proto .scard2) */
.st-seg { display: flex; justify-content: center; }
.st-scard { position: relative; width: 500rpx; height: 720rpx; border-radius: var(--cy-radius-xl); overflow: hidden; display: flex; align-items: center; justify-content: center; text-align: center;
  background: linear-gradient(180deg, #1C1C1E, #0A0A0B); box-shadow: 0 48rpx 120rpx rgba(0, 0, 0, .6); } /* ds-ok 分享卡自带画面色(导出图同) */
.st-scard--story { width: 460rpx; height: 800rpx; }
.st-scard__bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: .35; }
.st-scard__in { position: relative; display: flex; flex-direction: column; align-items: center; padding: 0 40rpx; }
.st-scard__k { margin-top: 24rpx; font-size: var(--cy-type-caption); color: var(--st-gold); letter-spacing: .1em; } /* ds-ok */
.st-scard__t { margin-top: 8rpx; font-size: var(--cy-type-card-title); font-weight: 800; line-height: 1.3; }
.st-scard__m { margin-top: 8rpx; font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.st-scard__logo { position: absolute; left: 0; right: 0; bottom: 28rpx; font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.st-cv { position: fixed; left: -9999rpx; top: 0; width: 360px; height: 480px; }

/* 底部:固定在底部的实底托盘;分享步是一行两颗 */
.st-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx 48rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--cy-color-bg-page); }
.st-footer--row { flex-direction: row; gap: 20rpx; }
.st-footer--row > .st-share, .st-footer--row > .st-footer__i { flex: 1; min-width: 0; }
.st-link { min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); }
.st-share { display: block; width: 100%; margin: 0; padding: 0; background: none; border: 0; line-height: normal; }
.st-share::after { display: none; }

/* 评价已提交:居中弹窗 */
.st-pop { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: var(--cy-z-modal); display: flex; align-items: center; justify-content: center; }
.st-pop__mask { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, .6); } /* ds-ok 压暗 */
.st-pop__card { position: relative; width: 560rpx; box-sizing: border-box; padding: 48rpx 40rpx 40rpx; border-radius: var(--cy-radius-xl); display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  background: var(--cy-comp-sheet-player-glass, var(--cy-color-bg-elevated)); box-shadow: 0 48rpx 96rpx rgba(0, 0, 0, .45); } /* ds-ok 弹窗投影 */
.st-pop__t { margin-top: 12rpx; font-size: var(--cy-type-section-title); font-weight: 800; }
.st-pop__s { margin-bottom: 20rpx; font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); text-align: center; }
.st-pop__card cy-btn { align-self: stretch; }

/* 减少动态效果:直接终态 */
.st--reduced .st-rise, .st--reduced .st-glow, .st--reduced .st-tag, .st--reduced .st-star, .st--reduced .st-panel, .st--reduced .st-dot { transition: none; }
.st--reduced .st-rise, .st--reduced .st-glow { opacity: 1; transform: none; }
.st--reduced .st-panel { transform: none; }
@media (prefers-reduced-motion: reduce) {
  .st-rise, .st-glow, .st-tag, .st-star, .st-panel, .st-dot { transition: none; }
  .st-rise, .st-glow { opacity: 1; transform: none; }
  .st-panel { transform: none; }
}
