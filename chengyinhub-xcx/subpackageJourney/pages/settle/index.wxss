@import '../../style/journey.wxss';
/* r2-finish 结算流程:玩家深色,短屏居中;底部按钮固定在底部(规则 5),圆角走按钮 token */
.st { --st-gold: #E9C47C; /* ds-ok 与章节完成卡、结局印章同一金色 */ min-height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; color: var(--cy-color-text-primary);
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }
.st-dots { display: flex; justify-content: center; gap: 12rpx; margin-top: 4rpx; }
.st-dot { width: 40rpx; height: 6rpx; border-radius: var(--cy-radius-pill); background: var(--cy-comp-sheet-group-bg); transition: background .3s ease; }
.st-dot.is-on { background: var(--cy-color-text-primary); }
.st-body { flex: 1; display: flex; flex-direction: column; gap: var(--cy-space-4); padding: var(--cy-space-5) 38rpx 0; }
.st-body--center { justify-content: center; align-items: center; text-align: center; padding-top: 0; }
.st-h { font-size: var(--cy-type-card-title); font-weight: 700; }
.st-seal { position: relative; width: 168rpx; height: 168rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: var(--st-gold); opacity: 0; transform: scale(.3) rotate(-20deg);
  transition: opacity var(--cy-motion-slow) var(--cy-ease-out), transform var(--cy-motion-celebrate) var(--cy-ease-spring); } /* ds-ok 无 token 时退回印章金 */
/* r4-motion 2026-11-10(MOTION.md 4.6 第 1 步):印章弹入、两圈光环外扩、眉题 → 标题 → 名次 → 数据 → 按钮按 stagger-hero 依次上浮,
   分数在卡落定后数上去(count.wxs),彩旗与 heavy 触感在 900ms 那一拍只放一次。全部 transition,棘轮不动;减动效时一步到位。 */
.st--in .st-seal { opacity: 1; transform: none; }
.st-h-i { opacity: 0; transform: translateY(var(--cy-motion-rise-sm)); transition: opacity var(--cy-motion-reveal) var(--cy-ease-out), transform var(--cy-motion-reveal) var(--cy-ease-settle); transition-delay: calc(var(--i, 0) * var(--cy-motion-stagger-hero)); }
.st--in .st-h-i { opacity: 1; transform: none; }
.st--reduced .st-seal, .st--reduced .st-h-i { transition: none; opacity: 1; transform: none; }
.st-seal.is-plain { background: var(--cy-color-bg-elevated); }
.st-seal__tick { width: 58rpx; height: 30rpx; margin-top: -12rpx; border-left: 11rpx solid var(--cy-color-bg-page, #000); border-bottom: 11rpx solid var(--cy-color-bg-page, #000); transform: rotate(-45deg); } /* ds-ok */
.st-seal.is-plain .st-seal__tick { border-color: var(--cy-color-text-primary); }
.st-seal__ring { position: absolute; inset: 0; border-radius: 50%; border: 4rpx solid var(--st-gold); opacity: .9; } /* ds-ok */
.st--in .st-seal__ring { opacity: 0; transform: scale(2.3); transition: opacity calc(var(--cy-motion-celebrate) * 2) var(--cy-ease-out) var(--cy-motion-slow), transform calc(var(--cy-motion-celebrate) * 2) var(--cy-ease-out) var(--cy-motion-slow); }
.st--in .st-seal__ring--2 { transition-delay: calc(var(--cy-motion-slow) + var(--cy-motion-hold)); }
.st--reduced .st-seal__ring { display: none; }
.st-kicker { margin-top: var(--cy-space-4); font-size: var(--cy-type-label); letter-spacing: .12em; color: var(--cy-color-text-secondary); }
.st-title { font-size: var(--cy-type-page-title); font-weight: 800; line-height: 1.25; }
.st-rank { font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); }
.st-stats { align-self: stretch; display: flex; margin-top: var(--cy-space-4); border-radius: var(--cy-comp-sheet-group-radius); background: var(--cy-comp-sheet-group-bg);
  border: 1rpx solid var(--cy-comp-sheet-group-line); }
.st-stat { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: var(--cy-space-4) 0; }
.st-stat + .st-stat { border-left: 1rpx solid var(--cy-comp-sheet-group-line); }
.st-stat__v { font-size: var(--cy-type-section-title); font-weight: 700; font-variant-numeric: tabular-nums; }
.st-stat__l { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.st-stars { display: flex; gap: var(--cy-space-2); color: var(--cy-color-text-secondary); }
.st-star { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; transition: transform .2s ease; }
.st-star.is-on { color: var(--st-gold); transform: scale(1.06); } /* ds-ok */
.st-field { align-self: stretch; position: relative; padding: var(--cy-space-3) var(--cy-space-4) 48rpx; border-radius: var(--cy-comp-sheet-group-radius); background: var(--cy-comp-sheet-group-bg); text-align: left; }
.st-textarea { width: 100%; min-height: 160rpx; font-size: var(--cy-type-body); color: var(--cy-color-text-primary); }
.st-ph { color: var(--cy-color-text-secondary); }
.st-count { position: absolute; right: var(--cy-space-4); bottom: var(--cy-space-2); font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.st-err { align-self: stretch; text-align: left; font-size: var(--cy-type-label); color: var(--cy-color-status-danger); }
.st-seg { display: flex; justify-content: center; }
.st-card { align-self: center; border-radius: var(--cy-radius-xl); overflow: hidden; box-shadow: 0 16rpx 60rpx rgba(0,0,0,.5); } /* ds-ok 卡片投影 */
.st-card--post { width: 520rpx; height: 650rpx; }
.st-card--story { width: 380rpx; height: 676rpx; }
.st-cv { width: 100%; height: 100%; display: block; }
.st-acts { display: flex; flex-direction: column; gap: var(--cy-space-3); }
.st-acts__row { display: flex; gap: var(--cy-space-3); }
.st-acts__i { flex: 1; min-width: 0; }
.st-share { display: block; width: 100%; margin: 0; padding: 0; background: none; border: 0; line-height: normal; }
.st-share::after { display: none; }
.st-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx 38rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--cy-bg-page); }
.st-link { min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: var(--cy-type-body); color: var(--cy-color-text-secondary); }
.st-confetti { position: fixed; inset: 0; z-index: 6; pointer-events: none; --cy-motion-celebrate: 2200ms; }
@media (prefers-reduced-motion: reduce) { .st-seal, .st-h-i { transition: none; opacity: 1; transform: none; } .st-seal__ring { display: none; } }
