<view class="theme-dark jn">
  <cy-nav-bar plain />
  <cy-page-title title="邀请与收益" />
  <cy-empty wx:if="{{state !== 'ready'}}" kind="{{stateKind}}" title="{{stateTitle}}" cta="{{stateCta}}" bind:cta="onStateCta" fill size="lg" />
  <block wx:else>
    <view class="jn-sec jn-sec--first">
      <view class="jn-group">
        <view class="jn-row" wx:for="{{promo.buckets}}" wx:key="key">
          <view class="jn-row__t"><text class="jn-row__b">{{item.label}}</text><text class="jn-row__s" wx:if="{{item.count}}">{{item.count}}</text></view>
          <text class="jn-row__v is-strong">{{item.amount}}</text>
        </view>
        <view class="jn-row" wx:if="{{promo.held}}"><view class="jn-row__t"><text class="jn-row__b">待核算</text></view><text class="jn-row__v">{{promo.held}}</text></view>
      </view>
    </view>
    <view class="jn-sec" wx:if="{{promo.campaigns.length}}">
      <text class="jn-sec__h">成交</text>
      <view class="jn-group">
        <view class="jn-row" wx:for="{{promo.campaigns}}" wx:key="key">
          <view class="jn-row__t"><text class="jn-row__b">{{item.title}}</text><text class="jn-row__s">来源 {{item.attributed === null ? '未知' : item.attributed}} · 已付 {{item.paid === null ? '未知' : item.paid}}{{item.refunded ? ' · 退款 ' + item.refunded : ''}}</text></view>
        </view>
      </view>
    </view>
    <view class="jn-sec" wx:if="{{promo.links.length}}">
      <text class="jn-sec__h">我的邀请链接</text>
      <view class="jn-group">
        <view class="jn-row" wx:for="{{promo.links}}" wx:key="key">
          <view class="jn-row__t"><text class="jn-row__b">{{item.title}}</text><text class="jn-row__s" wx:if="{{item.expires}}">{{item.expires}}</text></view>
          <text class="jn-row__v">{{item.status}}</text>
        </view>
      </view>
    </view>
    <cy-empty wx:if="{{!promo.hasRecords && !promo.links.length}}" kind="empty" title="暂无可核实记录" size="sm" />
  </block>
</view>
