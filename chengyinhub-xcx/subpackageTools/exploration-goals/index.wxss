@import '../style/tool-ui.wxss';
.rd-label { padding: 31rpx 31rpx 15rpx; font-size: var(--cy-type-label); color: var(--cy-comp-sheet-player-text-secondary); }
.gl-detail { margin-top: 31rpx; display: flex; flex-direction: column; }
.gl-k { font-size: var(--cy-type-label); color: var(--cy-comp-sheet-player-text-secondary); }
.gl-big { margin-top: 8rpx; font-size: 92rpx; font-weight: 900; font-style: italic; letter-spacing: -3rpx; line-height: 1; } /* ds-ok 原型 NRC 读数 */
.gl-of { font-size: var(--cy-type-sheet-title); font-style: normal; font-weight: 700; color: var(--cy-comp-sheet-player-text-secondary); }
.gl-m { display: block; margin-top: 15rpx; font-size: var(--cy-type-label); color: var(--cy-comp-sheet-player-text-secondary); }
.gl-acts { display: flex; gap: 15rpx; margin-top: 27rpx; }
.gl-cancel { color: #F87171; } /* ds-ok 取消 */
.gl-seg { display: flex; margin: 0 31rpx; padding: 6rpx; border-radius: var(--cy-radius-md); background: var(--cy-comp-sheet-player-bg); }
.gl-seg__i { flex: 1; height: 72rpx; border-radius: var(--cy-radius-sm); display: flex; align-items: center; justify-content: center; font-size: var(--cy-type-body); font-weight: 600; color: var(--cy-comp-sheet-player-text-secondary); }
.gl-seg__i.is-on { background: var(--cy-comp-sheet-player-surface-strong); color: var(--cy-comp-sheet-player-text); }
.gl-step { display: flex; align-items: center; justify-content: center; gap: 54rpx; margin-top: 42rpx; }
.gl-step__b { width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--cy-comp-sheet-player-elevated); display: flex; align-items: center; justify-content: center; font-size: var(--cy-type-page-title); }
.gl-step__v { min-width: 212rpx; text-align: center; font-size: 123rpx; font-weight: 900; font-style: italic; letter-spacing: -4rpx; } /* ds-ok 原型 .stepper .v 64px */
.gl-step__l { display: block; margin-top: 8rpx; text-align: center; font-size: var(--cy-type-body); color: var(--cy-comp-sheet-player-text-secondary); }
.gl-row__top { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; }
.gl-row__t { font-size: var(--cy-type-button); font-weight: 700; }
/* V3-28:空态与标准页一致,插画在「我的目标」下方的余白里居中 */
.gl-empty { padding-top: var(--cy-space-8); }

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.gl-cancel { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
.gl-seg__i { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
.gl-step__b { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
