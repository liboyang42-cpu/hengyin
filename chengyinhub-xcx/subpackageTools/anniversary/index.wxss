@import '../style/tool-ui.wxss';
.an-date { display: flex; align-items: flex-end; justify-content: space-between; padding: 0 31rpx 31rpx; }
/* 原型 .mem:上半封面 + 下半正文;封面用路线色渐变,年数用 NRC 斜体 */
.an-card { margin: 0 31rpx 23rpx; border-radius: var(--cy-radius-xl); overflow: hidden; background: var(--cy-comp-sheet-player-bg); }
.an-cover { position: relative; height: 230rpx; background: linear-gradient(135deg, #5A4632, #1E1915); } /* ds-ok 原型 .mem .cv */
.an-years { position: absolute; left: 31rpx; bottom: 23rpx; font-size: 65rpx; font-weight: 900; font-style: italic; letter-spacing: -2rpx; } /* ds-ok 原型 .yr 34px */
.an-body { padding: 27rpx 31rpx 31rpx; display: flex; flex-direction: column; align-items: flex-start; gap: 8rpx; }
.an-t { font-size: var(--cy-type-button); font-weight: 700; }
.an-m { font-size: var(--cy-type-label); color: var(--cy-comp-sheet-player-text-secondary); }
.an-go { margin-top: 15rpx; }
