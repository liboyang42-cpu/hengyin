page { background: var(--cy-color-bg-page); }
.vb { min-height: 100vh; display: flex; flex-direction: column; color: var(--cy-color-text-primary); }
.vb__frame { flex: 1; display: flex; flex-direction: column; }
.vb__body { flex: 1; display: flex; flex-direction: column; gap: var(--cy-space-3); padding: 0 var(--cy-page-x, var(--cy-space-4)) calc(var(--cy-space-6) + env(safe-area-inset-bottom)); }
.vb-form { display: flex; flex-direction: column; gap: var(--cy-space-2); padding: var(--cy-space-4); background: var(--cy-color-bg-surface); border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); }
.vb-input { min-height: 88rpx; padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-md); background: var(--cy-color-bg-page); border: 1rpx solid var(--cy-color-border-subtle); font-size: var(--cy-type-body); color: var(--cy-color-text-primary); }
.vb-field__err { font-size: var(--cy-type-caption); color: var(--cy-color-status-danger); }
.vb-group { background: var(--cy-color-bg-surface); border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); overflow: hidden; }
.vb-row { display: flex; align-items: flex-start; gap: var(--cy-space-3); min-height: 88rpx; box-sizing: border-box; padding: var(--cy-space-3) var(--cy-space-4); border-bottom: 1rpx solid var(--cy-color-border-subtle); }
.vb-row:last-child { border-bottom: none; }
.vb-row__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.vb-row__title { font-size: var(--cy-type-body); font-weight: 600; }
.vb-row__sub { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); }
.vb-row__url { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.vb-row__acts { flex: none; display: flex; flex-direction: column; align-items: flex-end; }
.vb-act { min-height: 88rpx; line-height: 88rpx; padding: 0 var(--cy-space-2); font-size: var(--cy-type-body); color: var(--cy-color-text-primary); }
.vb-act--danger { color: var(--cy-color-status-danger); }
