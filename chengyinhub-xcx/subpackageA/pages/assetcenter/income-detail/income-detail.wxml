<!-- 2026-08-11 用户裁决:「这个就放到页面上,不要做弹窗了」。
     原来是一个页面一进来就永久弹一个 cy-sheet(默认 variant=bottom,只盖 70vh),
     于是页面标题与弹层标题同屏各出一个「收益明细」—— 走查 D28 报的重复就是这么来的。
     现在正文直接落在页上,标题只剩 cy-page-title 这一个,不再有弹层与叉号。 -->
<!-- G-10 / M-35(2026-10-29):商家从账户收益进来(theme=merchant)整页浅色,含加载骨架 -->
<view class="{{merchantView ? 'theme-merchant' : 'theme-dark'}}">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
<cy-nav-bar custom-back bind:back="goBack" />
<cy-page-title title="收益明细" />
<view class="id-page-body">
  <!-- §19/§27.10:分佣是营销分配投影,与上面的收益明细是两条账,不相加;只在服务端有本人分项时出现 -->
  <cy-tabs wx:if="{{!merchantView && rev.state !== 'hidden'}}" class="id-tabs" variant="chip" tabs="{{revTabs}}" active="{{revTab}}" bind:change="onRevTab" />
  <cy-scene-asset-income-detail wx:if="{{revTab === 'income'}}" id="incomeDetail" surface="page" theme="{{merchantView ? 'merchant' : 'player'}}" />
  <block wx:else>
    <cy-error wx:if="{{rev.state === 'error'}}" title="收益暂不可用" retry="重试" bind:retry="loadRevenue" />
    <view class="rv-card" wx:for="{{rev.rows}}" wx:key="key">
      <view class="rv-card__head">
        <text class="rv-card__title">{{item.title}}</text>
        <text class="rv-card__status rv-card__status--{{item.statusCode}}">{{item.status}}</text>
      </view>
      <text class="rv-card__when" wx:if="{{item.when}}">{{item.when}}</text>
      <view class="rv-line" wx:for="{{item.items}}" wx:for-item="line" wx:key="key">
        <text class="rv-line__k">{{line.label}}</text>
        <text class="rv-line__v {{line.reverse ? 'is-reverse' : ''}}">{{line.value}}</text>
      </view>
    </view>
  </block>
</view>
</view>
