<view class="mp-page theme-merchant">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-nav-bar />
  <cy-page-title title="我的项目" />
  <!-- C6:主结构 = 类型三 tab(主题 / 活动 / 模板) -->
  <view class="mp-tabs">
    <cy-tabs variant="fill" wide="{{true}}" tabs="{{typeTabs}}" active="{{typeTab}}" bind:change="switchTypeTab" />
  </view>

  <view class="mp-state" wx:if="{{authRequired}}">
    <cy-empty kind="no-permission" title="登录后查看我的项目"
      cta="登录" bind:cta="onLogin" fill size="lg" />
  </view>
  <!-- ===== 主题 / 活动 ===== -->
  <block wx:elif="{{typeTab !== 'template'}}">
    <view class="mp-state" wx:if="{{projectState === 'loading'}}">
      <cy-empty kind="loading" title="项目加载中" fill size="lg" />
    </view>
    <view class="mp-state" wx:elif="{{projectState === 'error'}}">
      <cy-empty wx:if="{{projectAccessDenied}}" kind="no-permission" title="当前身份不能查看这些项目" fill size="lg" />
      <cy-error wx:else load-failure title="项目加载失败" sub="{{projectErrorMsg}}" bind:retry="loadProjects" fill size="lg" />
    </view>
    <view wx:if="{{loading && loaded}}" class="mp-refreshing" aria-role="status" aria-live="polite">正在同步最新项目…</view>

    <!-- 2026-10-28 业主 m693:列表上方不放发布活动的按钮(没有活动时空态里仍可发起) -->
    <!-- 上下架 / 删除按稿撤出卡面后,长按是它们唯一的入口 —— 藏起来的入口要写出来,
         否则一条已下架的路线就再也回不到上架。列表里一张卡都不可操作时不出这行。 -->
    <view class="mp-longtip" wx:if="{{projectState === 'ready' && list.length > 0 && hasRowOps}}">长按卡片管理</view>
    <view class="mp-list" wx:if="{{projectState === 'ready'}}" style="{{pmList === 1 ? '--pm-l:1;' : (pmList === 2 ? '--pm-l-d:.32s;--pm-l-s:1;' : '')}}">
      <!-- 稿 260:277 的裁决(节点 260:369):「单列列表的行**整行可点,不放按钮**(连箭头都不放)。
           每张卡的下一步动作不同(去核销 / 承接进度 / 去管理),进项目页再做」。
           所以卡面上原来那排 候选池 / 上下架 / 删除 / 「继续编辑」药丸全部撤掉:
           · 候选池已下线 → 申请与报名统一进协作列表「收到的」处理(本面板入口同指那里);
           · 下一步动作 → 就是点这一行本身(onCardTap 按状态分流:草稿进编辑器、其余进项目页);
           · 上下架 / 删除 → 长按这张卡打开操作面板。这两个是列表管理动作,不是「下一步」,
             把它们留在卡面上就是稿里明确不要的那排按钮;但也不能删掉 —— 已下架的路线
             除了这里没有别的路能重新上架。长按是它们唯一的入口,所以列表上方那行提示要写出来。
           卡内顺序也按稿改:tag 行在最上面(整行,状态 tag 靠右),再是「封面 | 档期/标题」,
           最后是底行统计。稿里标题下面那行地址后端没有下发,按稿自己的规矩缺就不出。 -->
      <view class="mp-card" wx:for="{{list}}" wx:key="id" data-item="{{item}}" bindtap="onCardTap" bindlongpress="onCardLong" hover-class="cy-pressed" hover-stay-time="80">
        <!-- 2026-10-28 业主 m693:左封面,右边 档期 + 状态 / 标题 / 地址 / 报名·浏览;身份、类型小标签撤掉 -->
        <view class="mp-main">
          <image lazy-load="true" class="mp-cover" src="{{item.cover || '/images/route_free_cover.png'}}" mode="aspectFill" />
          <view class="mp-body">
            <view class="mp-when-row">
              <text class="mp-when">{{item._whenText}}</text>
              <cy-badge type="status" variant="{{item._stateVariant}}" label="{{item.stateText}}" />
            </view>
            <view class="mp-tit-row">
              <view class="mp-dot" wx:if="{{item._dot}}"></view>
              <view class="mp-tit">{{item.title}}</view>
            </view>
            <view class="mp-addr" wx:if="{{item._address}}">{{item._address}}</view>
            <view class="mp-stats">
              <text class="mp-stat" wx:if="{{item._showPendingVerify}}">{{item._pendingVerifyText}}</text>
              <text class="mp-stat" wx:elif="{{item._showAccept}}">{{item.acceptStatusText}}</text>
              <text class="mp-stat" wx:else>{{item.signupCount || 0}} 报名 · {{item.viewCount || 0}} 浏览</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="mp-state" wx:if="{{projectState === 'ready' && list.length === 0}}">
      <cy-empty kind="empty" title="{{emptyTit}}" sub="{{emptySub}}"
        cta="{{typeTab === 'topic' ? '去发布' : (typeTab === 'activity' && canPublishActivity ? '发布单场活动' : '')}}"
        bind:cta="onEmptyCta" fill size="lg" />
    </view>

    <view class="mp-more" wx:if="{{projectState === 'ready' && capped}}">仅显示最近 200 条</view>
  </block>

  <!-- ===== 模板(原 mytemplate 节点玩法列表收编) ===== -->
  <block wx:else>
    <view class="mp-list">
      <view class="mp-card" wx:for="{{tplList}}" wx:key="id" data-id="{{item.id}}" bindtap="tplTap" hover-class="cy-pressed" hover-stay-time="80">
        <view class="mp-main">
          <image lazy-load="true" class="mp-cover" src="{{item.imgUrl || '/images/route_city_cover.png'}}" mode="aspectFill" />
          <view class="mp-body">
            <view class="mp-tit">{{item.title}}</view>
            <view class="mp-tags">
              <text class="mp-type">节点玩法</text>
              <cy-badge type="status" variant="{{item._stateVariant}}" label="{{item._statusText}}" />
              <text class="mp-owner">{{item._marketText}}</text>
            </view>
            <view class="mp-stats">
              <text class="mp-stat" wx:if="{{item.useNum != null && item.useNum !== ''}}">{{ item.useNum || 0 }} 次引用</text>
              <text class="mp-stat" wx:if="{{item.duration}}">{{ item.duration || 0 }} 分钟</text>
            </view>
            <view class="mp-stats" wx:if="{{item.reason}}"><text class="mp-stat">个人审核：{{item.reason}}</text></view>
            <view class="mp-stats" wx:if="{{item.marketReason}}"><text class="mp-stat">广场：{{item.marketReason}}</text></view>
          </view>
        </view>
        <view class="mp-ops">
          <view wx:if="{{item._canSubmitMarket}}" class="mp-op mp-op-toggle" catchtap="tplSubmitMarket" data-id="{{item.id}}" aria-role="button" aria-label="提交广场审核" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">提交广场</view>
          <view wx:if="{{item._canToggleMarket}}" class="mp-op mp-op-toggle" catchtap="tplToggle" data-id="{{item.id}}" data-target="{{item._marketPublishTarget}}" aria-role="button" aria-label="{{item._marketActionText}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">{{item._marketActionText}}</view>
          <view wx:if="{{item._audit}}" class="mp-op mp-op-toggle" catchtap="tplAudit" data-biz="{{item._audit.bizType}}" data-bizid="{{item._audit.bizId}}" data-title="{{item.title}}" aria-role="button" aria-label="查看{{item.title}}的审核记录" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">审核记录</view>
          <view class="mp-op mp-op-del" catchtap="tplDelete" data-id="{{item.id}}" data-title="{{item.title}}" data-pub="{{item.marketPublishStatus}}" aria-role="button" aria-label="删除{{item.title}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">删除</view>
        </view>
      </view>
    </view>

    <cy-skeleton wx:if="{{tplLoading && !tplLoaded}}" type="card" count="{{skeletonItems.length}}" />
    <cy-empty wx:if="{{tplAccessDenied}}" kind="no-permission" title="当前身份不能查看这些模板" fill size="lg" />
    <cy-error load-failure wx:if="{{!tplAccessDenied && !tplLoading && tplErrorMsg && !tplLoaded}}" title="{{tplErrorMsg}}" sub="" retry="重试" bind:retry="retryTemplates" />
    <view wx:if="{{tplLoading && tplLoaded}}" class="mp-refreshing" aria-role="status" aria-live="polite">正在同步最新节点玩法…</view>
    <cy-empty wx:if="{{tplLoaded && !tplErrorMsg && tplList.length===0}}" title="还没有节点玩法" />
  </block>

</view>

<!-- 长按卡片打开的操作面板:装稿里不许放在卡面上的那几个列表管理动作。
     2026-10-28 业主 m694:统一成 Threads 式分组菜单(style/threads-menu.wxss)—— 文字左、图标右,不写说明;
     删除单独一组标红。行是按这张卡的 _canEdit / _canToggle / _canDelete… 现算的,不可用的动作整行不出。 -->
<cy-sheet show="{{opsSheet.show}}" inset bind:close="closeOpsSheet">
  <view class="tm">
    <view class="tm-group" wx:if="{{opsSheet.canEdit || opsSheet.canViewApplies || opsSheet.canToggle || opsSheet.canCancel || opsSheet.canAudit || opsSheet.canSaveAsTemplate}}">
      <view class="tm-row" wx:if="{{opsSheet.canEdit}}" bindtap="onOpsPick" data-k="edit" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="编辑"><text class="tm-label">编辑</text><cy-icon class="tm-ico" name="edit" size="40" /></view>
      <view class="tm-row" wx:if="{{opsSheet.canViewApplies}}" bindtap="onOpsPick" data-k="received" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="收到的申请"><text class="tm-label">收到的申请</text><cy-icon class="tm-ico" name="list" size="40" /></view>
      <view class="tm-row" wx:if="{{opsSheet.canToggle}}" bindtap="onOpsPick" data-k="toggle" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="{{opsSheet.toggleLabel}}"><text class="tm-label">{{opsSheet.toggleLabel}}</text><cy-icon class="tm-ico" name="flag" size="40" /></view>
      <view class="tm-row" wx:if="{{opsSheet.canCancel}}" bindtap="onOpsPick" data-k="cancel" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="{{opsSheet.biz === 'topic' ? '取消主题并退款' : '取消活动'}}"><text class="tm-label">{{opsSheet.biz === 'topic' ? '取消主题并退款' : '取消活动'}}</text><cy-icon class="tm-ico" name="close" size="40" /></view>
      <view class="tm-row" wx:if="{{opsSheet.canAudit}}" bindtap="onOpsPick" data-k="audit" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="审核记录"><text class="tm-label">审核记录</text><cy-icon class="tm-ico" name="info" size="40" /></view>
      <view class="tm-row" wx:if="{{opsSheet.canSaveAsTemplate}}" bindtap="onOpsPick" data-k="saveAsTemplate" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="另存为模板"><text class="tm-label">另存为模板</text><cy-icon class="tm-ico" name="draft" size="40" /></view>
    </view>
    <view class="tm-group" wx:if="{{opsSheet.canDelete}}">
      <view class="tm-row tm-row--danger" bindtap="onOpsPick" data-k="delete" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="删除"><text class="tm-label">删除</text><cy-icon class="tm-ico" name="trash" size="40" /></view>
    </view>
  </view>
</cy-sheet>

<!-- FOLLOWUP-A-2:审核记录(GET /api/audit/timeline)。行样式沿用上面长按面板;申诉只在回包 canAppeal 时出现 -->
<cy-sheet show="{{auditSheet.show}}" title="审核记录" bind:close="closeAuditSheet">
  <view class="mp-ops-sheet">
    <view class="mp-ops-row" wx:if="{{auditSheet.loading}}" aria-role="status" aria-live="polite">
      <text class="mp-ops-sub">加载中</text>
    </view>
    <view class="mp-ops-row" wx:elif="{{auditSheet.error}}" bindtap="loadAudit" hover-class="cy-pressed" hover-stay-time="80">
      <text class="mp-ops-label">{{auditSheet.error}}</text>
      <text class="mp-ops-sub">重试</text>
    </view>
    <block wx:else>
      <view class="mp-ops-row" wx:if="{{!auditSheet.rows.length}}">
        <text class="mp-ops-sub">暂无记录</text>
      </view>
      <view class="mp-ops-row" wx:for="{{auditSheet.rows}}" wx:key="key">
        <text class="mp-ops-label">{{item.label}}</text>
        <text class="mp-ops-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
      </view>
      <view class="mp-ops-row" wx:if="{{auditSheet.appealText}}">
        <text class="mp-ops-label">申诉</text>
        <text class="mp-ops-sub">{{auditSheet.appealText}}</text>
      </view>
      <view class="mp-ops-row" wx:if="{{auditSheet.canAppeal}}" bindtap="appealAudit" hover-class="cy-pressed" hover-stay-time="80">
        <text class="mp-ops-label">申诉</text>
        <text class="mp-ops-sub">每条内容可申诉一次</text>
      </view>
    </block>
  </view>
</cy-sheet>

<!-- 危险动作三段式确认:文案来自 utils/danger-actions.js,页面只给 key -->
<cy-danger-confirm id="dcActivity" bind:confirm="onConfirmDeleteActivity" bind:alt="onDeleteItemAlt" />
<cy-danger-confirm id="dcCancel" bind:confirm="onConfirmCancelActivity" />
<cy-danger-confirm id="dcCancelTopic" bind:confirm="onConfirmCancelTopic" />
<cy-danger-confirm id="dcRoute" bind:confirm="onConfirmDeleteRoute" bind:alt="onDeleteItemAlt" />
<cy-danger-confirm id="dcTpl" bind:confirm="onConfirmDeleteTemplate" bind:alt="onDeleteTemplateAlt" />
