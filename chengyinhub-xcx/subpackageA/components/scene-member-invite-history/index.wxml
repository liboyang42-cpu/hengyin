<!-- V1-P59 / G-11:pmIn 置 1 先隐着,置 2 后汇总卡、头像、记录行依次上浮(只用过渡,减少动态效果时不触发) -->
<view class="ir-scene" style="{{pmIn === 1 ? '--pm-i:1;' : (pmIn === 2 ? '--pm-i-d:.36s;--pm-i-s:1;' : '')}}">
  <!-- r2 a7-v1-p59 业主「页面设计的不对 参考其他页面怎么做的 参考revolut」:Revolut 邀请页结构 ——
       顶部直接在页面底上放「已获积分」大数字 + 邀请人数一行(头像叠放),下面一张列表卡,每行头像 / 名字 / 时间 + 右侧状态胶囊。 -->
  <view class="ir-hero" wx:if="{{groups.length}}">
    <view class="ir-hero-top">
      <text class="ir-hero-label">首购奖励积分</text>
      <!-- r3-visual:余额胶囊 = 积分流水最新一行的 afterPoints;读不到不出 -->
      <view class="ir-bal" wx:if="{{balanceText}}" aria-label="当前积分 {{balanceText}}"><text class="ir-bal-dot"></text><text class="ir-bal-n">{{balanceText}}</text></view>
    </view>
    <text class="ir-hero-value" wx:if="{{rewardReady}}">+{{earnedTotalText}}</text>
    <text class="ir-hero-value ir-hero-value--pending" wx:else>待同步</text>
    <view class="ir-hero-row">
      <view class="ir-stack" wx:if="{{stack.length}}" aria-hidden="true">
        <view class="ir-stack-i" wx:for="{{stack}}" wx:key="id"><cy-avatar size="56" src="{{item.avatar}}" name="{{item.nickname}}" /></view>
      </view>
      <text class="ir-hero-meta">已邀请 {{total}} 人<block wx:if="{{rewardReady}}"> · 已到账 {{earnedCount}} 人</block></text>
    </view>
  </view>

  <!-- r3-visual 分享赚积分(refs4/share-earn-credits-frames):最新一笔真实到账的邀请奖励。
       扫描框里是被邀请人头像 → 金额浮现 → 卡片上滑到位 → 打勾。没有到账就整张不出。 -->
  <view class="ir-earn ir-earn--s{{earnStage}}" wx:if="{{latest && groups.length}}" aria-label="{{latest.nickname}} 首购奖励已到账 +{{latest.points}} 积分">
    <view class="ir-earn-scan" aria-hidden="true">
      <cy-avatar size="88" src="{{latest.avatar}}" name="{{latest.nickname}}" />
      <view class="ir-earn-beam"></view>
      <view class="ir-earn-ok"><cy-icon name="check" size="28" /></view>
    </view>
    <view class="ir-earn-copy">
      <text class="ir-earn-amt">+{{latest.points}} 积分</text>
      <text class="ir-earn-sub ep1">{{latest.nickname ? latest.nickname + ' · ' : ''}}首购奖励已到账</text>
    </view>
    <text class="ir-earn-time" wx:if="{{latest.timeText}}">{{latest.timeText}}</text>
  </view>

  <cy-skeleton wx:if="{{loading && !groups.length}}" type="list" count="{{4}}" />
  <cy-error load-failure="{{!authRequired && !accessDenied}}" wx:elif="{{loadErr && !groups.length}}" fill size="lg"
    title="{{authRequired ? '登录后查看邀请记录' : accessDenied ? '当前账号无法查看邀请记录' : '邀请记录加载失败'}}" retry="{{authRequired ? '登录' : '重试'}}" bind:retry="retry" />
  <cy-empty wx:elif="{{empty}}" fill size="lg" kind="empty"
    title="还没有人接受你的邀请" />

  <block wx:else>
    <view class="ir-group" wx:for="{{groups}}" wx:for-item="group" wx:key="label">
      <view class="ir-group-head">
        <text class="ir-group-title">{{group.label}}</text>
        <text class="ir-group-total">{{group.rewardText}}</text>
      </view>
      <view class="ir-card">
        <view class="ir-row" wx:for="{{group.items}}" wx:for-item="item" wx:key="id" aria-label="{{item.nickname}} {{item.timeText}} {{item.statusText}}">
          <cy-avatar class="ir-avatar" size="md" src="{{item.avatar}}" name="{{item.nickname}}" />
          <view class="ir-copy">
            <text class="ir-name ep1">{{item.nickname}}</text>
            <text class="ir-time">{{item.timeText}}</text>
            <text class="ir-status">{{item.statusText}}</text>
          </view>
          <view class="ir-pill"><text class="ir-reward">{{item.rewardText}}</text></view>
        </view>
      </view>
    </view>

    <view class="ir-more" wx:if="{{hasMore && !loading && !loadMoreError}}" bindtap="loadMore" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">加载更多</view>
    <!-- 下一页失败:留在「加载更多」原位,同一行样式,点按重试(不另起一张大错误卡) -->
    <view class="ir-more" wx:if="{{loadMoreError && groups.length && !loading}}" bindtap="loadMore" aria-role="button" hover-class="cy-pressed" hover-stay-time="80">没加载出来 · 重试</view>
    <view class="ir-more ir-more--loading" wx:if="{{loading && groups.length}}">正在加载…</view>
  </block>
</view>
