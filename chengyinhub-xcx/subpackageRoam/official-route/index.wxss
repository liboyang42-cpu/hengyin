page { background: var(--cy-color-bg-page); }
.orr { min-height: 100vh; color: var(--cy-color-text-primary); }
.orr__body { padding: var(--cy-space-3) var(--cy-page-x, var(--cy-space-4)) var(--cy-space-6); display: flex; flex-direction: column; gap: var(--cy-space-3); }
.orr__cover { width: 100%; height: 360rpx; border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-elevated); }
.orr__sec { font-size: var(--cy-type-body); font-weight: 600; color: var(--cy-color-text-secondary); }
.orr-node { display: flex; align-items: center; gap: var(--cy-space-3); padding: var(--cy-space-3); border-radius: var(--cy-radius-md); background: var(--cy-color-bg-elevated); }
.orr-node__no { flex: none; width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 50%; font-size: var(--cy-type-body); color: var(--cy-color-brand); border: 1rpx solid var(--cy-color-brand); }
.orr-node__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.orr-node__name { font-size: var(--cy-type-body); font-weight: 600; }
.orr-node__sub { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.orr-node__img { flex: none; width: 112rpx; height: 112rpx; border-radius: var(--cy-radius-sm); }
.orr__follow { display: flex; flex-direction: column; gap: var(--cy-space-2); }
.orr__hint { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
