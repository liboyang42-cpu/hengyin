@import "../../../style/addr-tap.wxss";
:host { display: block; }
.guide { position: fixed; inset: 0; z-index: 3000; display: flex; flex-direction: column; box-sizing: border-box; padding: calc(var(--cy-safe-top) + var(--cy-space-8)) var(--cy-page-x) calc(var(--cy-safe-bottom) + var(--cy-space-4)); background: var(--cy-color-bg-page); color: var(--cy-color-text-primary); }
.guide__header, .guide__city { display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-3); }
.guide__header { flex: none; margin-bottom: var(--cy-space-3); }
.guide__title { font-size: var(--cy-type-section-title); font-weight: 800; }
.guide__action { display: flex; align-items: center; justify-content: center; min-width: var(--cy-btn-h); min-height: var(--cy-btn-h); box-sizing: border-box; padding: var(--cy-space-2) var(--cy-space-3); font-size: var(--cy-type-label); color: var(--cy-color-text-primary); border-radius: var(--cy-radius-pill); }
.guide__city { min-height: var(--cy-btn-h); padding: var(--cy-space-2) var(--cy-space-3); background: var(--cy-color-bg-surface-subtle); border-radius: var(--cy-radius-md); font-size: var(--cy-type-body); }
.guide__city-name { font-weight: 700; }
.guide__city-meta { flex: 1; color: var(--cy-color-text-secondary); font-size: var(--cy-type-caption); }
.guide__categories { flex: none; width: 100%; white-space: nowrap; padding: var(--cy-space-3) 0; }
.guide__category { display: inline-flex; align-items: center; min-height: var(--cy-btn-h); padding: 0 var(--cy-space-3); margin-right: var(--cy-space-2); border-radius: var(--cy-radius-pill); background: var(--cy-color-bg-surface-subtle); color: var(--cy-color-text-secondary); font-size: var(--cy-type-label); }
.guide__category.is-on, .guide__primary { background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); }
.guide__body { flex: 1; min-height: 0; height: 100%; }
.guide__note, .guide__empty { display: block; color: var(--cy-color-text-secondary); font-size: var(--cy-type-caption); line-height: var(--cy-leading-normal); padding: var(--cy-space-3) 0; }
.guide__row { display: flex; flex-direction: column; gap: var(--cy-space-2); padding: var(--cy-space-4); margin-bottom: var(--cy-space-3); border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-surface-subtle); }
.guide__label { display: block; color: var(--cy-color-text-secondary); font-size: var(--cy-type-caption); }
.guide__name { display: block; font-size: var(--cy-type-card-title); font-weight: 700; line-height: var(--cy-leading-tight); }
.guide__reason, .guide__address { display: block; font-size: var(--cy-type-body); line-height: var(--cy-leading-normal); overflow-wrap: break-word; }
.guide__address { color: var(--cy-color-text-secondary); font-size: var(--cy-type-caption); }
.guide__detail { display: flex; flex-direction: column; gap: var(--cy-space-3); padding-bottom: var(--cy-space-4); }
.guide__back { justify-content: flex-start; flex: none; padding-left: 0; }
.guide__tags { display: flex; flex-wrap: wrap; gap: var(--cy-space-2); }
.guide__tag { padding: var(--cy-space-1) var(--cy-space-2); background: var(--cy-color-bg-surface-subtle); border-radius: var(--cy-radius-sm); color: var(--cy-color-text-secondary); font-size: var(--cy-type-caption); }
.guide__section { margin-top: var(--cy-space-3); font-weight: 700; font-size: var(--cy-type-body); }
.cy-pressed { opacity: .88; }
