/* 加载中整层透明(地图照常可见),真正开播才显形;结尾 0.6s 淡出 */
.atm { position: fixed; inset: 0; z-index: 400; background: transparent; opacity: 0; transition: opacity .6s ease-out; }
.atm.is-on { opacity: 1; background: #000000; } /* ds-ok 视频底色,开播前不出现 */
.atm.is-fade { opacity: 0; pointer-events: none; }
.atm__video { width: 100%; height: 100%; }
