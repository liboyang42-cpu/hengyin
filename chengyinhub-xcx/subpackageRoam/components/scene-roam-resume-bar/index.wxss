:host { display: block; }
.resume-bar {
  display: flex;
  align-items: center;
  margin: var(--cy-space-3) var(--cy-space-4) 0;
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-elevated);
  color: var(--cy-color-text-primary);
}
.resume-bar__main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--cy-space-3);
  min-height: var(--cy-btn-h);
  padding: var(--cy-space-2) 0 var(--cy-space-2) var(--cy-space-3);
  color: var(--cy-color-brand);
}
.resume-bar__text { flex: 1; min-width: 0; display: flex; flex-direction: column; color: var(--cy-color-text-primary); }
.resume-bar__title { font-size: var(--cy-type-body); font-weight: 600; }
.resume-bar__sub { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.resume-bar__cta { flex: none; font-size: var(--cy-type-body); color: var(--cy-color-brand); }
.resume-bar__close {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-color-text-secondary);
}
.cy-pressed { opacity: .88; }

/* 细节打磨二期(2026-11-12)L1/L5/L7:卡面层次、按压松手回弹、读数等宽;只改质感,不动版式/文案/配色 */
.resume-bar__main { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
.resume-bar__close { transition: transform var(--cy-motion-press-out) var(--cy-ease-release), opacity var(--cy-motion-press-out) var(--cy-ease-out); }
