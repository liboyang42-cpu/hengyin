.roam-photo { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; }
/* 2026-11-10 r2 a4-v3-36:档案三卡统一成同一底色 + 居中 3D 图标(静止;不新增 keyframes,见 motion-property-ratchet) */
.roam-3d { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  background: radial-gradient(80% 70% at 30% 20%, #FFFFFF 0, rgba(255, 255, 255, 0) 70%), #F1EFEA; /* ds-ok: 漫游档案卡浅底,与方卡定稿底 #F6F5F2 同族 */ }
.roam-3d__img { width: 58%; height: 58%; filter: drop-shadow(0 14rpx 18rpx rgba(40, 36, 30, .22)); /* ds-ok: 浅底上的落影 */ }
