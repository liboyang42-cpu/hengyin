/* 官方地点展开:相册(左右滑)→ 介绍 → 地点玩法 → 小红书 / 信息行 → 玩家评价。沿用本卡的灰阶、圆角和行样式 */
.pb__gal { position: relative; margin-bottom: 23rpx; }
.pb__sw { height: 420rpx; border-radius: 31rpx; overflow: hidden; background: #2C2C2E; } /* ds-ok 同 .pc__ph 照片底 */
.pb__swi { width: 100%; height: 100%; display: block; }
.pb__cnt { position: absolute; right: 19rpx; bottom: 19rpx; padding: 6rpx 17rpx; border-radius: 23rpx; background: rgba(0,0,0,.55); color: #fff; font-size: 23rpx; font-variant-numeric: tabular-nums; } /* ds-ok 同 .pc__avn */
.pb__game { margin-top: 27rpx; padding: 27rpx; border-radius: 31rpx; background: #2C2C2E; } /* ds-ok */
.pb__game-h { display: flex; align-items: center; justify-content: space-between; }
.pb__game-k { font-size: 23rpx; color: #8E8E93; } /* ds-ok */
.pb__game-st { font-size: 23rpx; font-weight: 600; color: #34C759; } /* ds-ok v13 地点绿 */
.pb__game-t { display: block; margin-top: 8rpx; font-size: 31rpx; font-weight: 700; color: #fff; } /* ds-ok */
.pb__game-d { display: block; margin-top: 8rpx; font-size: 25rpx; line-height: 1.6; color: rgba(255,255,255,.78); } /* ds-ok */
.pb__steps { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 19rpx; }
.pb__step { padding: 8rpx 19rpx; border-radius: 27rpx; background: rgba(255,255,255,.08); font-size: 23rpx; color: #fff; } /* ds-ok */
.pb__row--link .pb__xhs { color: #FF2442; } /* ds-ok 小红书品牌红,只用在这一行 */
.pb__rv { text-align: right; }
.pb__rv-h { display: flex; align-items: center; gap: 12rpx; margin-top: 35rpx; font-size: 29rpx; font-weight: 700; color: #fff; } /* ds-ok */
.pb__rv-n { font-size: 25rpx; font-weight: 400; color: #8E8E93; } /* ds-ok */
.pb__qt { padding: 21rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.08); } /* ds-ok 同 .pb__row 分隔 */
.pb__qt-t { display: block; font-size: 27rpx; line-height: 1.6; color: rgba(255,255,255,.86); } /* ds-ok */
.pb__qt-s { display: block; margin-top: 8rpx; font-size: 23rpx; color: #8E8E93; } /* ds-ok */
.pb__cm { padding: 21rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.08); } /* ds-ok 同 .pb__row 分隔 */
.pb__cm-h { display: flex; align-items: center; gap: 12rpx; font-size: 23rpx; color: #8E8E93; } /* ds-ok */
.pb__cm-n { color: #fff; font-weight: 600; } /* ds-ok */
.pb__cm-s { display: flex; align-items: center; gap: 6rpx; color: #FF9F0A; } /* ds-ok 同 .pc__rib */
.pb__cm-time { margin-left: auto; }
.pb__cm-t { display: block; margin-top: 8rpx; font-size: 27rpx; line-height: 1.6; color: rgba(255,255,255,.86); } /* ds-ok */
.pb__cm-empty { display: block; padding: 23rpx 0; font-size: 25rpx; color: #8E8E93; } /* ds-ok */
.pb__mine { margin-top: 19rpx; padding: 23rpx; border-radius: 31rpx; background: #2C2C2E; } /* ds-ok */
.pb__stars { display: flex; gap: 8rpx; }
.pb__star { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: #48484A; } /* ds-ok */
.pb__star.on { color: #FF9F0A; } /* ds-ok */
.pb__ta { width: 100%; min-height: 96rpx; margin-top: 12rpx; font-size: 27rpx; line-height: 1.5; color: #fff; } /* ds-ok */
.pb__ph { color: #8E8E93; } /* ds-ok */
.pb__send { margin-top: 12rpx; height: 72rpx; border-radius: 36rpx; display: flex; align-items: center; justify-content: center; background: #fff; color: #000; font-size: 27rpx; font-weight: 600; } /* ds-ok 同 .pb__btn--w */
.pb__send.is-off { opacity: .5; }
.pb__hint2 { display: block; margin-top: 15rpx; font-size: 23rpx; color: #FF9F0A; text-align: center; } /* ds-ok */
.pb__hint { display: flex; align-items: center; gap: 8rpx; }
.pb__up { width: 12rpx; height: 12rpx; border-left: 4rpx solid currentColor; border-top: 4rpx solid currentColor; transform: translateY(3rpx) rotate(45deg); }
/* v13 点位长成卡:裁切从圆(点位照片)过渡成圆角卡;点位照片 + 白圈在前段淡出;类型小牌、小尾巴最后出现 */
.pc__clip { position: absolute; top: 0; right: 0; bottom: 0; left: 0; clip-path: inset(25rpx 0 25rpx 0 round 279rpx); transition: clip-path .45s cubic-bezier(.2,.82,.2,1); }
.pc.is-in .pc__clip { clip-path: inset(0 round 42rpx); }
.pc__cover { position: absolute; left: 0; top: 25rpx; width: 558rpx; height: 558rpx; border-radius: 50%; opacity: 1; transition: opacity .25s ease .1s; pointer-events: none; }
.pc__ring { position: absolute; left: 0; top: 25rpx; width: 558rpx; height: 558rpx; border-radius: 50%; box-shadow: inset 0 0 0 19rpx #fff; opacity: 1; transition: opacity .25s ease .1s; pointer-events: none; } /* ds-ok 点位白圈(缩到 .16 时约 3px) */
.pc.is-in .pc__cover, .pc.is-in .pc__ring { opacity: 0; }
.pc__chip, .pc__tail { opacity: 0; transition: opacity .2s ease .3s; }
.pc.is-in .pc__chip, .pc.is-in .pc__tail { opacity: 1; }
.pc.is-x .pc__cover, .pc.is-x .pc__ring { display: none; }
.pc--reduced .pc__clip, .pc--reduced .pc__cover, .pc--reduced .pc__ring, .pc--reduced .pc__chip, .pc--reduced .pc__tail { transition: none; }
/* 卡开着时顶部计数条、筛选行淡出(原型 map-open),只留地图和卡 */
.nb .mt-top, .nb .mt-filter { transition: opacity .25s ease; }
.nb.map-open .mt-top, .nb.map-open .mt-filter { opacity: 0; pointer-events: none; }

/* 2026-10-25 业主:顶部一行 = 筛选(文字)+ 地图 / 列表(图标);底部横滑卡片(漫游首页「附近活动」卡,加高,与标题左缘对齐) */
.mt-toprow { position: absolute; left: 23rpx; right: 23rpx; z-index: 20; display: flex; align-items: center; gap: 14rpx; transition: opacity .25s ease; }
.mt-toprow__chips { flex: 1; min-width: 0; white-space: nowrap; }
.mt-toprow .mt-chip { padding: 0 20rpx; margin-right: 12rpx; font-size: 24rpx; gap: 8rpx; } /* ds-ok 同 .mt-chip 原型定值;四枚筛选与图标切换并排时整行放得下,不被截在图标边上 */
.mt-toprow .mt-chip:last-child { margin-right: 0; }
.mt-toprow .mt-mode { flex: none; height: 65rpx; padding: 4rpx; }
.mt-toprow .mt-mode__i { min-width: 64rpx; padding: 0; color: rgba(255,255,255,.6); } /* ds-ok 同 .mt-mode__i 未选 */
.mt-toprow .mt-mode__i.is-on { color: var(--cy-color-play-ink); }
.nb.map-open .mt-toprow { opacity: 0; pointer-events: none; }
/* 业主 2026-10-25:不加黑色渐变,卡片直接压在地图上;标题用和筛选胶囊同底的小牌,地图上也读得清 */
.mt-strip { position: absolute; left: 0; right: 0; bottom: 0; z-index: 18; pointer-events: none; }
.mt-strip__head, .mt-strip__cards { pointer-events: auto; }
.mt-strip__head { display: inline-flex; margin: 0 0 15rpx 31rpx; height: 54rpx; padding: 0 23rpx; align-items: center; border-radius: 27rpx; background: rgba(28,28,30,.88); box-shadow: 0 8rpx 24rpx rgba(0,0,0,.25); font-size: 25rpx; font-weight: 600; color: #fff; } /* ds-ok 同 .mt-chip 底色 */
.mt-strip__cards { width: 100%; height: 290rpx; white-space: nowrap; } /* 2026-10-28 业主:卡片加宽,铺在最底部 */
.mt-strip__track { display: inline-flex; gap: 23rpx; padding: 0 31rpx; }
.mt-card { position: relative; display: inline-flex; flex: none; width: 620rpx; height: 260rpx; overflow: hidden; border-radius: 27rpx; background: #2C2C2E; vertical-align: top; box-shadow: 0 12rpx 31rpx rgba(0,0,0,.3); } /* ds-ok 同 .entry-card,加高;压在地图上加投影 */
.mt-card__cover { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.mt-card__cover--team { background: linear-gradient(135deg, #0d2a4d, #123b6b); } /* ds-ok 队伍蓝 */
.mt-card__cover--place, .mt-card__cover--shop { background: #2C2C2E; } /* ds-ok */
.mt-card__shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,.8)); } /* ds-ok 同 .entry-card__shade */
.mt-card__copy { position: absolute; left: 27rpx; right: 27rpx; bottom: 23rpx; display: flex; flex-direction: column; color: #fff; } /* ds-ok */
.mt-card__tag { margin-bottom: 8rpx; font-size: 21rpx; font-weight: 700; } /* ds-ok */
.mt-card__tag--team { color: #64D2FF; } /* ds-ok 队伍蓝 */
.mt-card__tag--place { color: #7CF0A6; } /* ds-ok 地点绿 */
.mt-card__tag--shop { color: #FFB340; } /* ds-ok 商家橙 */
.mt-card__title { font-size: 29rpx; line-height: 1.25; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } /* ds-ok */
.mt-card__meta { margin-top: 6rpx; font-size: 21rpx; color: rgba(255,255,255,.72); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } /* ds-ok */
.mt-corner--icon { position: relative; width: 88rpx; padding: 0; justify-content: center; }
.mt-corner__n { position: absolute; top: -6rpx; right: -6rpx; min-width: 34rpx; height: 34rpx; padding: 0 8rpx; box-sizing: border-box; border-radius: 17rpx; background: #0A84FF; color: #fff; font-size: 21rpx; font-weight: 700; line-height: 34rpx; text-align: center; } /* ds-ok 队伍蓝角标 */
/* 2026-10-25 业主:展开卡里「网上怎么说」「玩家评价」左右滑,一条一张卡 */
.pb__hs { width: 100%; white-space: nowrap; }
.pb__hs-track { display: inline-flex; gap: 19rpx; padding-bottom: 4rpx; }
.pb__hs .pb__qt, .pb__hs .pb__cm { display: inline-flex; flex-direction: column; flex: none; width: 470rpx; min-height: 200rpx; box-sizing: border-box; padding: 23rpx 27rpx; border: 0; border-radius: 31rpx; background: #2C2C2E; white-space: normal; vertical-align: top; } /* ds-ok 同 .pb__game 卡底 */
.pb__hs .pb__qt-t, .pb__hs .pb__cm-t { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
.pb__hs .pb__qt-s { margin-top: auto; padding-top: 12rpx; }
/* 2026-10-27 owner P-38:地图 / 列表切换挪到右侧、筛选行下方、竖排;返回键按胶囊行定位;底部卡片带始终在(空态卡) */
.mt-mode--side { position: absolute; right: 23rpx; z-index: 21; height: auto; width: auto; flex-direction: column; gap: 4rpx; padding: 4rpx; border-radius: var(--cy-radius-pill); }
.mt-mode--side .mt-mode__i { min-width: 74rpx; height: 74rpx; padding: 0; }
.nb.map-open .mt-mode--side { opacity: 0; pointer-events: none; }
.mt-list { padding-right: 140rpx; }
.nb-back { position: fixed; left: 23rpx; z-index: 40; display: flex; align-items: center; }
.nb-back__pill { border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(28,28,30,.88); color: #fff; } /* ds-ok 同 .mt-chip 底色 */
.nb-back::after { content: ''; position: absolute; left: 50%; top: 50%; width: 88rpx; height: 88rpx; transform: translate(-50%, -50%); }
.mt-card--empty { align-items: flex-end; background: linear-gradient(180deg, #2C2C2E, #1C1C1E); } /* ds-ok 空态卡与 .mt-card 同底 */
