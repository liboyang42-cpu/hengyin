/* 点位卡:290×316,深灰底,上方类型小牌,下方小尾巴;正面照片 + 名字压图;背面介绍,上滑展开 */
/* 点位卡的透明收起层必须压在卡片(.pc z 40)下面:共用 .pdim 是 z 60(给半屏 z 70 垫底用),
   原样用会盖住卡片,点卡片任何地方都点在这层上 → 卡片一点就收、翻不了面也展不开。39 仍高于地图、筛选行和底部卡片条。 */
.pdim--clear { background: transparent !important; z-index: 39; }
.pc { position: absolute; left: 50%; z-index: 40; width: 558rpx; height: 608rpx; margin-left: -279rpx; opacity: 0; transform: translateY(52rpx) scale(.16); transform-origin: 50% calc(100% + 40rpx);
  transition: transform .42s cubic-bezier(.5,0,.7,.4), opacity .1s ease .36s; } /* 收回:先缩回点位,最后一下才淡掉 */
.pc.is-in { opacity: 1; transform: none; transition: transform .5s cubic-bezier(.34,1.32,.64,1), opacity .12s ease; }
.pc.is-x { width: calc(100% - 46rpx); margin-left: calc(-50% + 23rpx); height: auto; }
.pc.is-cam { opacity: 0; pointer-events: none; transition: opacity .2s ease; } /* 取景卡开着:点位卡让开,不叠两层 */
.pc--reduced, .pc--reduced .pc__in { transition: none; }
.pc__chip { position: absolute; left: 50%; top: -31rpx; z-index: 4; transform: translateX(-50%); display: flex; align-items: center; gap: 12rpx; padding: 10rpx 23rpx 10rpx 12rpx; border-radius: 35rpx; white-space: nowrap; /* ds-ok: v13 动效原型定值,业主 2026-10-23 要求与原型一致 */
  background: #2C2C2E; color: #fff; font-size: 29rpx; font-weight: 800; box-shadow: 0 12rpx 31rpx rgba(0,0,0,.4); } /* ds-ok */
.pc__chip-i { width: 46rpx; height: 46rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 25rpx; color: #fff; } /* ds-ok */
.pc__in { position: absolute; top: 0; right: 0; bottom: 0; left: 0; transform-style: preserve-3d; transition: transform .6s cubic-bezier(.3,.7,.2,1); }
.pc__in.is-flip { transform: rotateY(180deg); }
.pc__f, .pc__b { position: absolute; top: 0; right: 0; bottom: 0; left: 0; border-radius: 42rpx; overflow: hidden; clip-path: inset(0 round 42rpx); backface-visibility: hidden; -webkit-backface-visibility: hidden; background: #1C1C1E; color: #fff; } /* ds-ok */
.pc__b { transform: rotateY(180deg); padding: 35rpx 35rpx 27rpx; box-sizing: border-box; display: flex; flex-direction: column; }
.pc__ph { position: absolute; left: 15rpx; right: 15rpx; top: 15rpx; height: 408rpx; border-radius: 31rpx; overflow: hidden; background: #333; } /* ds-ok */
.pc__img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.pc__img--ph { background: linear-gradient(160deg, #2a3140, #121418); } /* ds-ok */
.pc__phs { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,.72)); } /* ds-ok */
.pc__rib { position: absolute; left: 31rpx; top: 31rpx; z-index: 3; font-size: 21rpx; font-weight: 700; padding: 8rpx 17rpx; border-radius: 17rpx; background: #FF9F0A; color: #000; } /* ds-ok */
.pc__avs { position: absolute; left: 31rpx; top: 31rpx; z-index: 3; display: flex; align-items: center; }
.pc__av { width: 58rpx; height: 58rpx; border-radius: 50%; margin-right: -15rpx; border: 4rpx solid #1C1C1E; } /* ds-ok */
.pc__avn { margin-left: 27rpx; font-size: 23rpx; padding: 6rpx 15rpx; border-radius: 15rpx; background: rgba(0,0,0,.6); color: #fff; } /* ds-ok */
.pc__nm { position: absolute; left: 23rpx; right: 23rpx; bottom: 23rpx; z-index: 2; display: flex; flex-direction: column; }
.pc__nmb { font-size: 40rpx; font-weight: 700; line-height: 1.15; color: #fff; } /* ds-ok */
.pc__nms { font-size: 25rpx; color: rgba(255,255,255,.78); } /* ds-ok */
.pc__meta { position: absolute; left: 35rpx; right: 35rpx; top: 446rpx; display: flex; flex-direction: column; font-size: 23rpx; line-height: 1.6; color: #8E8E93; } /* ds-ok */
.pc__ml { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pc__st { color: #fff; font-weight: 600; } /* ds-ok */
.pc__tail { position: absolute; left: 50%; bottom: -21rpx; z-index: -1; width: 42rpx; height: 42rpx; margin-left: -21rpx; background: #1C1C1E; transform: rotate(45deg); border-radius: 6rpx; } /* ds-ok */
.pb__hd { display: flex; align-items: flex-start; gap: 19rpx; }
