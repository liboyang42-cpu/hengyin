<!-- C2 玩家据点核销码:出示给商家扫码领券。
     PG-091 薄壳:出码/倒计时/重试只有 components/cy/scene-qr-citynode 一份(漫游、玩法页同用),本页只透传 poiId/name。
     PG-005 进页先判登录:游客由 cy-access-gate 盖住并给登录,不发出码请求。 -->
<view class="theme-dark">
  <cy-access-gate kind="login" />
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
<!-- 出码/错误/加载态的出口是 cy-qr-voucher 右上角✕(同一 onClose);页面返回钮只在缺参态与游客态出现。 -->
<cy-nav-bar custom-back bind:back="onClose" wx:if="{{state === 'missing' || guest}}" />
<view wx:if="{{state === 'missing'}}" class="cc-missing">
  <cy-empty
    kind="missing-param"
    fill="{{true}}"
    size="lg"
    cta="返回"
    bind:cta="onMissingBack"
  />
</view>
<view wx:elif="{{!guest}}" class="cc-scene">
  <cy-scene-qr-citynode poi-id="{{poiId}}" name="{{name}}" bind:close="onClose" />
</view>
</view>
