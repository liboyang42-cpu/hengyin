+    ['topic 登录拒绝', topic, (s) => s.replace('memberId == null || memberId <= 0L', 'false')],
+    ['topic 归属调用', topic, (s) => s.replaceAll('String denial = editableDenial(topic, scope);', 'String denial = null;')],
+    ['topic scope', topic, (s) => s.replace('MerchantOperationScope.isMerchant(scope)', 'true')],
+    ['topic 岗位', topic, (s) => s.replace('MerchantPermission.PROJECT_MANAGE', 'MerchantPermission.BASIC_READ')],
+    ['topic owner', topic, (s) => s.replace('.getOwnerMemberId()', '.getMemberId()')],
+    ['topic 归属判断', topic, (s) => s.replace('OwnershipUtils.notOwner(topic.getMemberId(), memberId)', 'false')],
+    ['topic HTTP', topic, (s) => s.replace('@GetMapping("/publish-check")', '@PostMapping("/publish-check")')],
+    ['topic 非法ID', topic, (s) => s.replace('return topicId == null || topicId <= 0L;', 'return false;')],
+  ];
+  for (const [name, original, mutate] of changes) {
+    const changed = mutate(original);
+    assert.notEqual(changed, original, name + '变异必须生效');
+    assert.throws(() => assertNewGetBackend(original === capability ? changed : capability,
+      original === topic ? changed : topic), assert.AssertionError, name);
+  }
+  for (const row of NEW_GET_ROWS) {
+    for (const [column, wrong] of [[2, 'optional'], [3, 'visitor/member'], [4, 'current-session']]) {
+      const mutated = MATRIX.map((item) => item === row ? item.map((value, i) => i === column ? wrong : value) : item);
+      assert.throws(() => assertNewGetBackend(capability, topic, mutated), assert.AssertionError);
+    }
+  }
+});
+
+const SYSTEM_ROOT = path.resolve(XCX_ROOT, '../chengyinhub-system/src/main');
+function readThemeBackend() {
+  return [fs.readFileSync(path.join(API_ROOT, 'ApiThemeRuntimeController.java'), 'utf8'),
+    fs.readFileSync(path.join(SYSTEM_ROOT, 'java/com/chengyinhub/business/service/impl/TopicRouteRuntimeServiceImpl.java'), 'utf8'),
+    fs.readFileSync(path.join(SYSTEM_ROOT, 'resources/mapper/business/TopicRouteSessionMapper.xml'), 'utf8')];
+}
+function assertThemeReadOwnership(controller, service, mapper) {
+  const api = stripJavaComments(controller);
+  assert.match(api, /@GetMapping\("\/card"\)\s*public AjaxResult card\(Long sessionId\)/);
+  assert.equal(javaMethod(api, 'public AjaxResult card(Long sessionId)'), 'return success(runtime.themeCard(member(),sessionId));');
+  assert.match(api, /@GetMapping\("\/history"\)\s*public AjaxResult historyPage\(Long topicId,Long beforeSessionId,Integer limit\)/);
+  assert.equal(javaMethod(api, 'public AjaxResult historyPage(Long topicId,Long beforeSessionId,Integer limit)'),
+    'return success(runtime.themeHistory(member(),topicId,beforeSessionId,limit));');
+  const card = javaMethod(service, 'public Map<String,Object> themeCard(Long memberId,Long sessionId)');
+  assert.match(card, /^themeRuntimePolicy\.requireEnabled\(\);\s*if\(memberId==null \|\| memberId<=0 \|\| sessionId==null\)throw new IllegalArgumentException\("参数不正确"\);\s*TopicRouteSession session=routeMapper\.selectAccessibleById\(sessionId,memberId\);\s*if\(session==null\)throw new ServiceException\("本局不存在或无权查看",403\);/);
+  assert.match(card, /if\(result==null\)throw new ServiceException\("本局尚未结束"\);\s*ObjectNode card=themeEngine\.card\(result\);/);
+  assert.match(card, /routeMapper\.selectEndingResults\(memberId,session\.getTopicId\(\)\)/);
+  const history = javaMethod(service, 'public List<Map<String,Object>> themeHistory(Long memberId,Long topicId,Long beforeSessionId,Integer limit)');
+  assert.match(history, /^themeRuntimePolicy\.requireEnabled\(\);\s*if\(memberId==null \|\| memberId<=0\)throw new ServiceException\("请先登录",403\);/);
+  assert.match(history, /routeMapper\.selectHistoryPage\(memberId,topicId,cursor,scanSize\)/);
+  assert.match(history, /if\(session==null \|\| !memberId\.equals\(session\.getMemberId\(\)\) \|\| !topicId\.equals\(session\.getTopicId\(\)\)\)\s*throw new ServiceException\("无权访问历史场次",403\);/);
+  const sql = mapper.replace(/<!--[\s\S]*?-->/g, '');
+  const select = (id) => {
+    const match = sql.match(new RegExp('<select id="' + id + '"[^>]*>([\\s\\S]*?)</select>'));
+    assert.ok(match, '后端必须保留 SQL ' + id);
+    return match[1].replace(/\s+/g, ' ').trim();
+  };
+  assert.equal(select('selectAccessibleById'), 'select <include refid="sessionColumns"/> from topic_route_session where id=#{id} and member_id=#{memberId} limit 1');
+  assert.equal(select('selectHistoryPage'), 'select <include refid="sessionColumns"/> from topic_route_session where member_id=#{memberId} and topic_id=#{topicId} <if test="beforeSessionId != null">and id &lt; #{beforeSessionId}</if> order by id desc limit #{limit}');
+  assert.match(select('selectEndingResults'), /where member_id=#\{memberId\} and topic_id=#\{topicId\}/);
+}
+
+test('背包历史与结果 GET：controller 从登录身份派生，service 和 SQL 双层约束本人/主题', () => {
+  assertThemeReadOwnership(...readThemeBackend());
+});
+
+test('背包历史/结果负控：伪造身份、移除本人/主题过滤、跳过403或终局限制都判红', () => {
+  const sources = readThemeBackend();
+  const mutations = [
+    [0, 'card 伪造身份', (s) => s.replace('themeCard(member(),sessionId)', 'themeCard(1L,sessionId)')],
+    [0, 'history 伪造身份', (s) => s.replace('themeHistory(member(),topicId,beforeSessionId,limit)', 'themeHistory(1L,topicId,beforeSessionId,limit)')],
+    [1, 'card 跨会员', (s) => s.replace('selectAccessibleById(sessionId,memberId)', 'selectAccessibleById(sessionId,1L)')],
+    [1, 'card 无权未拒绝', (s) => s.replace('if(session==null)throw new ServiceException("本局不存在或无权查看",403);', '')],
+    [1, 'card 未结束放行', (s) => s.replace('if(result==null)throw new ServiceException("本局尚未结束");', '')],
+    [1, 'history 跨会员', (s) => s.replace('selectHistoryPage(memberId,topicId,cursor,scanSize)', 'selectHistoryPage(1L,topicId,cursor,scanSize)')],
+    [1, 'history 漏本人复核', (s) => s.replace('session==null || !memberId.equals(session.getMemberId()) || !topicId.equals(session.getTopicId())', 'session==null || !topicId.equals(session.getTopicId())')],
+    [1, 'history 漏主题复核', (s) => s.replace('session==null || !memberId.equals(session.getMemberId()) || !topicId.equals(session.getTopicId())', 'session==null || !memberId.equals(session.getMemberId())')],
+    [2, 'SQL card 漏本人', (s) => s.replace('where id=#{id} and member_id=#{memberId} limit 1\n', 'where id=#{id} limit 1\n')],
+    [2, 'SQL history 漏本人', (s) => s.replace('where member_id=#{memberId} and topic_id=#{topicId}\n', 'where topic_id=#{topicId}\n')],
+    [2, 'SQL history 漏主题', (s) => s.replace('where member_id=#{memberId} and topic_id=#{topicId}\n', 'where member_id=#{memberId}\n')],
+  ];
+  for (const [index, name, mutate] of mutations) {
+    const changed = sources.slice(); changed[index] = mutate(changed[index]);
+    assert.notEqual(changed[index], sources[index], name + '变异必须生效');
+    assert.throws(() => assertThemeReadOwnership(...changed), assert.AssertionError, name);
+  }
 });
 
