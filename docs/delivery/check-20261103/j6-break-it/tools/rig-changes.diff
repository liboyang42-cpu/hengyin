diff --git a/docs/delivery/cloud-walk-20261101/rig/app.py b/docs/delivery/cloud-walk-20261101/rig/app.py
index 6d94c96b2..f7db92af6 100755
--- a/docs/delivery/cloud-walk-20261101/rig/app.py
+++ b/docs/delivery/cloud-walk-20261101/rig/app.py
@@ -52,7 +52,10 @@ def start(fail_path=""):
     # [SEAM] login: profile "local" lets the product's own non-prod switch send jscode2session to the rig's fake
     # WeChat endpoint (mpweb/server.mjs on 8097). Only /sns/jscode2session uses this base URL.
     cmd += ["--spring.profiles.active=druid,local",
-            "--chengyin.test.wechat-api-base-url=http://127.0.0.1:%s" % os.environ.get("RIG_WEB_PORT", "8097")]
+            "--chengyin.test.wechat-api-base-url=http://127.0.0.1:%s" % os.environ.get("RIG_WEB_PORT", "8097"),
+            # j6 HARNESS: dummy OSS config so URL builders do not throw (no OSS is reachable from the rig)
+            "--CHENGYIN_OSS_ENDPOINT=oss-rig.invalid", "--CHENGYIN_OSS_ACCESS_KEY_ID=rigdummy",
+            "--CHENGYIN_OSS_ACCESS_KEY_SECRET=rigdummysecret", "--CHENGYIN_OSS_BUCKET_NAME=rig-bucket"]
     log = open(LOG, "ab")
     p = subprocess.Popen(cmd, cwd=str(RIG_HOME / "work"), env=env(), stdout=log, stderr=subprocess.STDOUT,
                          start_new_session=True)
