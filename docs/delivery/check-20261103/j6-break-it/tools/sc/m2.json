[{"wait":3500},{"tapSel":".profile-quit"},{"wait":1200},{"eval":"(()=>{const p=getCurrentPages().slice(-1)[0];const dc=p.selectComponent('#dcQuit');return JSON.stringify(dc.data).slice(0,600)})()"},{"eval":"(()=>{let r=[];(function walk(root){for(const e of root.querySelectorAll('*')){if(e.shadowRoot)walk(e.shadowRoot);if(e.id==='dcQuit'){const b=e.getBoundingClientRect();r.push([b.x,b.y,b.width,b.height,getComputedStyle(e).display]);const s=e.shadowRoot||e;r.push(s.innerHTML.slice(0,300))}}})(document);return r})()"}]
