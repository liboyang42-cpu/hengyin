diff --git a/chengyinhub-xcx/tests/unit/roam-city-catalog.test.js b/chengyinhub-xcx/tests/unit/roam-city-catalog.test.js
new file mode 100644
index 0000000000..cfdcd6a18c
--- /dev/null
+++ b/chengyinhub-xcx/tests/unit/roam-city-catalog.test.js
@@ -0,0 +1,139 @@
+'use strict'
+const { test } = require('node:test')
+const assert = require('node:assert/strict')
+const raw = require('../../data/roam-city-catalog.json')
+const catalog = require('../../utils/roam-city-catalog.js')
+const { presentationForPoi } = require('../../utils/roam-poi-presentation.js')
+const { buildImport, coordinateTemplate } = require('../../../scripts/roam-catalog-import.js')
+
+test('11城33处真实目录身份独立，四类与来源可检查，未伪造坐标或合作身份', () => {
+  assert.equal(raw.cities.length, 11)
+  assert.equal(raw.places.length, 33)
+  assert.equal(new Set(raw.places.map(row => row.id)).size, raw.places.length)
+  for (const city of raw.cities) assert.equal(catalog.listPlaces(city.id, 'all').length, 3)
+  for (const place of raw.places) {
+    assert.ok(raw.cities.some(city => city.id === place.city))
+    assert.ok(['street','park','shop','landmark'].includes(place.category))
+    assert.equal(place.coordinate, null)
+    assert.ok(place.address && place.reason && place.visitNote)
+    assert.equal(place.reviewMethod, 'public_sources')
+    assert.ok(new Set(place.sources).size >= 2)
+    for (const url of place.sources) assert.match(url, /^https:\/\/[^\s]+$/)
+    for (const key of ['merchantId','templateId','couponId','found','xp']) assert.equal(Object.hasOwn(place, key), false)
+  }
+})
+test('城市和分类严格筛选，未知条件不会泄漏其他城市，行选择保持稳定', () => {
+  assert.deepEqual(catalog.listPlaces('BJ','shop').map(row => row.id), ['bj-zhengyang-books'])
+  assert.equal(catalog.listPlaces('HZ','shop').length, 0)
+  assert.equal(catalog.listPlaces('unknown','all').length, 0)
+  assert.equal(catalog.listPlaces('SH','unknown').length, 0)
+  assert.equal(catalog.findPlace('unknown'), null)
+  const row = catalog.findPlace('bj-zhengyang-books')
+  row.name = 'local edit'
+  assert.equal(catalog.findPlace('bj-zhengyang-books').name, '正阳书局（西四店）')
+})
+test('公园与街道按明确标签展示，普通推荐店铺不进入商家打卡链', () => {
+  assert.equal(presentationForPoi({type:1,tags:'["roam:park"]'}).cat, 'park')
+  assert.equal(presentationForPoi({type:1,tags:['roam:street']}).catLabel, '宝藏街道')
+  const shop = presentationForPoi({type:1,tags:['roam:shop']})
+  assert.equal(shop.cat, 'landmark')
+  assert.equal(shop.catLabel, '推荐店铺')
+  assert.equal(presentationForPoi({type:1,name:'公园咖啡',tags:'bad json'}).cat, 'landmark')
+  assert.equal(presentationForPoi({type:1,tags:'{"roam:park":true}'}).cat, 'landmark')
+})
+test('合作标签必须有真实商家关联，分类标签不能覆盖type=2的既有业务链', () => {
+  assert.equal(presentationForPoi({type:2,merchantId:7,tags:['roam:park']}).cat, 'merchant')
+  assert.equal(presentationForPoi({type:2,merchantId:7}).catLabel, '合作商家 · 探店')
+  assert.equal(presentationForPoi({type:2,merchantId:null}).catLabel, '商家据点')
+  assert.equal(presentationForPoi({type:2,merchantId:'invalid'}).catLabel, '商家据点')
+})
+
+const example = raw.places[0]
+const fixtureCatalog = {places:[example]}
+const now = new Date('2026-10-24T06:00:00Z')
+// Synthetic fixture only. This is not a production coordinate manifest.
+function verified(overrides) {
+  return Object.assign({}, coordinateTemplate(fixtureCatalog)[0], {
+    provider:'amap',providerPoiId:'fixture-only',verificationSource:'https://www.amap.com/place/fixture-only',
+    lat:31.25,lng:121.5,verifiedOn:'2026-10-23',matchConfirmed:true,
+  }, overrides)
+}
+test('原始坐标模板不能生成导入文件，缺行、空值和未确认入口全部拒绝', () => {
+  assert.equal(coordinateTemplate(raw).length, 33)
+  assert.throws(() => buildImport(fixtureCatalog, coordinateTemplate(fixtureCatalog), null, now))
+  assert.throws(() => buildImport(fixtureCatalog, [], null, now))
+  for (const overrides of [{lat:null},{lng:''},{matchConfirmed:false},{lat:Infinity},{lat:NaN}]) {
+    assert.throws(() => buildImport(fixtureCatalog, [verified(overrides)], null, now))
+  }
+})
+test('坐标城市、坐标系、名称地址及来源必须一致，不接受同名误匹配', () => {
+  for (const overrides of [
+    {city:'BJ'},{lat:39.9,lng:116.4},{coordinateSystem:'WGS-84'},
+    {name:'other'},{address:'other'},{providerPoiId:''},{provider:'unknown'},
+    {verificationSource:'https://www.amap.com.evil.invalid/place/1'},
+  ]) assert.throws(() => buildImport(fixtureCatalog, [verified(overrides)], null, now))
+})
+test('过期、未来或伪日期核验不发布，重复与未知身份不合并', () => {
+  for (const verifiedOn of ['2025-01-01','2026-10-25','2026-02-30','yesterday']) {
+    assert.throws(() => buildImport(fixtureCatalog, [verified({verifiedOn})], null, now))
+  }
+  assert.throws(() => buildImport(fixtureCatalog, [verified(),verified()], null, now))
+  assert.throws(() => buildImport(fixtureCatalog, [verified({id:'unknown'})], null, now))
+  assert.throws(() => buildImport(fixtureCatalog, [verified()], 'unknown', now))
+})
+test('导入保持下架type=1，不造合作商家和券；按稳定标签去重并附回读', () => {
+  const sql = buildImport(fixtureCatalog, [verified()], 'SH', now)
+  assert.match(sql, /START TRANSACTION;/)
+  assert.match(sql, /, 1, 31\.250000, 121\.500000, 80,/)
+  assert.match(sql, /, 0, NULL, NULL, NULL,/)
+  assert.match(sql, /WHERE NOT EXISTS/)
+  assert.match(sql, /JSON_CONTAINS/)
+  assert.match(sql, /COMMIT;/)
+  assert.match(sql, /SELECT id, name, type, city_code, status/)
+  assert.doesNotMatch(sql, /UPDATE |DELETE |DROP |TRUNCATE |CREATE TABLE/i)
+})
+test('SQL文本使用UTF8十六进制，目录文字不能注入额外语句', () => {
+  const hostile = Object.assign({},example,{name:"quote'; DELETE FROM roam_poi; --"})
+  const sql = buildImport({places:[hostile]}, [verified({name:hostile.name})], null, now)
+  assert.doesNotMatch(sql, /DELETE FROM/)
+  assert.match(sql, /CONVERT\(0x[0-9a-f]+ USING utf8mb4\)/)
+})
+
+test('目录组件可切城筛选、点开详情和复制地址，旧列表点击不会选到另一城市', () => {
+  const previousComponent = global.Component
+  const previousWx = global.wx
+  const copied = []
+  let definition
+  global.Component = value => { definition = value }
+  global.wx = { setClipboardData: options => copied.push(options.data) }
+  try {
+    require('../../components/cy/roam-city-guide/index.js')
+    const instance = Object.assign({
+      data:JSON.parse(JSON.stringify(definition.data)),
+      setData(patch) { Object.assign(this.data,patch) },
+      triggerEvent(name) { this.closedEvent = name },
+    }, definition.methods)
+    instance.onCityChange({detail:{value:1}})
+    assert.equal(instance.data.cityName, '北京')
+    instance.onCategoryTap({currentTarget:{dataset:{id:'shop'}}})
+    assert.equal(instance.data.places.length, 1)
+    instance.onPlaceTap({currentTarget:{dataset:{id:'sh-uchiyama-books'}}})
+    assert.equal(instance.data.selected, null)
+    instance.onPlaceTap({currentTarget:{dataset:{id:'bj-zhengyang-books'}}})
+    assert.equal(instance.data.selected.name, '正阳书局（西四店）')
+    instance.copyAddress()
+    instance.copySources()
+    assert.match(copied[0], /西四南大街43号/)
+    assert.equal(copied[1].split('\n').length, 2)
+    instance.backToList()
+    instance.copyAddress()
+    assert.equal(copied.length, 2)
+    instance.onCityChange({detail:{value:999}})
+    assert.equal(instance.data.cityName, '北京')
+    instance.close()
+    assert.equal(instance.closedEvent, 'close')
+  } finally {
+    global.Component = previousComponent
+    global.wx = previousWx
+  }
+})
diff --git a/chengyinhub-xcx/utils/roam-city-catalog.js b/chengyinhub-xcx/utils/roam-city-catalog.js
new file mode 100644
index 0000000000..427fc08036
--- /dev/null
+++ b/chengyinhub-xcx/utils/roam-city-catalog.js
@@ -0,0 +1,20 @@
+'use strict'
+
+const catalog = require('../data/roam-city-catalog.json')
+const { CATEGORY_LABELS } = require('./roam-poi-presentation.js')
+const categories = Object.keys(CATEGORY_LABELS).map(id => ({ id, name: CATEGORY_LABELS[id] }))
+const cities = catalog.cities.map(city => Object.assign({}, city, {
+  count: catalog.places.filter(place => place.city === city.id).length,
+}))
+function listPlaces(city, category) {
+  if (!cities.some(row => row.id === city) || !categories.some(row => row.id === category)) return []
+  return catalog.places.filter(place => place.city === city && (category === 'all' || place.category === category))
+    .map(place => Object.assign({}, place, {
+      categoryLabel: CATEGORY_LABELS[place.category], sourceCount: place.sources.length,
+    }))
+}
+function findPlace(id) {
+  const place = catalog.places.find(row => row.id === id)
+  return place ? listPlaces(place.city, 'all').find(row => row.id === id) : null
+}
+module.exports = { cities, categories, listPlaces, findPlace, reviewNote: catalog.reviewNote }
diff --git a/chengyinhub-xcx/utils/roam-poi-presentation.js b/chengyinhub-xcx/utils/roam-poi-presentation.js
new file mode 100644
index 0000000000..61f12b8eb2
--- /dev/null
+++ b/chengyinhub-xcx/utils/roam-poi-presentation.js
@@ -0,0 +1,26 @@
+'use strict'
+
+// Presentation is separate from the server's reward/ownership type.
+// Reserved tags are written by the reviewed catalog importer, never inferred from names.
+const CATEGORY_LABELS = Object.freeze({
+  all: '全部', street: '宝藏街道', shop: '推荐店铺', park: '公园绿地', landmark: '文化地标',
+})
+function readTags(value) {
+  if (Array.isArray(value)) return value
+  if (typeof value !== 'string') return []
+  try { const tags = JSON.parse(value); return Array.isArray(tags) ? tags : [] } catch (_) { return [] }
+}
+function presentationForPoi(row) {
+  const poi = row || {}
+  if (Number(poi.type) === 2) {
+    const linked = /^[1-9]\d*$/.test(String(poi.merchantId || ''))
+    return { cat: 'merchant', icon: 'poi-shop', catLabel: linked ? '合作商家 · 探店' : '商家据点' }
+  }
+  const tags = readTags(poi.tags)
+  if (tags.includes('roam:park')) return { cat: 'park', icon: 'poi-park', catLabel: CATEGORY_LABELS.park }
+  if (tags.includes('roam:street')) return { cat: 'landmark', icon: 'poi-landmark', catLabel: CATEGORY_LABELS.street }
+  // A recommended shop remains an official discovery point (type=1), outside shop visits/coupons.
+  if (tags.includes('roam:shop')) return { cat: 'landmark', icon: 'poi-shop', catLabel: CATEGORY_LABELS.shop }
+  return { cat: 'landmark', icon: 'poi-landmark', catLabel: CATEGORY_LABELS.landmark }
+}
+module.exports = { CATEGORY_LABELS, readTags, presentationForPoi }
diff --git a/docs/roam-city-catalog-20261023.md b/docs/roam-city-catalog-20261023.md
new file mode 100644
index 0000000000..8c261ecae5
--- /dev/null
+++ b/docs/roam-city-catalog-20261023.md
@@ -0,0 +1,55 @@
+# 城市漫游目录与地图布点交接
+
+本次给漫游入口增加「城市清单」，按城市和分类浏览、点开详情，能复制地址和资料来源。首批 11 城、33 处内容随小程序提供，不依赖附近活动接口成功或定位授权。用户主动浏览的远方城市不改动当前漫游锚点、定位、轨迹或会话。
+
+## 分类与身份
+
+- 展示分类：宝藏街道、推荐店铺、公园绿地、文化地标。
+- 后端业务类型继续保持 type=1 平台地点、type=2 商家据点。
+- 平台地点通过 tags 中的保留标签 roam:street / roam:shop / roam:park / roam:landmark 指定展示分类。
+- 推荐店铺的业务类型是 1，沿平台地点确认到点链路，不进入商家探店、集章或领券链路。
+- type=2 沿用原有业务链；只有 merchantId 是有效正整数时显示「合作商家」，无关联显示「商家据点」。分类标签不能把它改成平台地点。
+- 旧地点没有分类标签时保持地标展示，不按名字猜测「公园」或批量回填身份。
+- 非商户的 description 仍不作为审核后的「地点记忆」展示；地点意义沿用独立内容审核链。
+
+## 首批数据与核验边界
+
+数据文件：chengyinhub-xcx/data/roam-city-catalog.json。
+
+上海、北京、杭州、成都、西安、重庆、深圳、广州、武汉、香港、厦门，每城 3 处；11 段街巷/步道、11 处公园、4 处推荐书店/茶馆、7 处文化空间。已排除停业信息冲突的不在书店，避免把 A4 美术馆旧址、香蜜湖公园和香蜜公园混用，也未收录晓港公园已停业的旧游乐场项目。
+
+每条保留稳定 ID、城市、类别、地址、原创推荐理由、标签、到访说明、两个来源链接和公开资料核对日期。收录依据是公开资料交叉核对，不是实地探访；不声称实时营业、人少、免费或已成为合作商家。目录界面明确显示核对日期和来源，并提示以经营方或管理方最新公告为准。
+
+首批坐标一律为空，不把街区中心或猜测坐标变成可领取奖励的地图点。目录已可浏览和复制地址，但这些条目不会凭空成为已上架的附近点位。
+
+## 地图布点工具
+
+工具只在本机编译 SQL，不连接数据库、不自动发布。没有新依赖，没有新增表或列。
+
+生成坐标核验模板：
+
+```sh
+node scripts/roam-catalog-import.js --template > /tmp/roam-coordinate-review.json
+```
+
+运营用腾讯/高德地图逐条确认同名门店、城市、地址、可公开到达的入口，填写 provider、providerPoiId、verificationSource、lat、lng、verifiedOn，并在确认匹配后设置 matchConfirmed=true。坐标必须由地图服务明确返回为 GCJ-02，不猜测坐标系、不自动偏移转换。街道和大型公园的入口必须适合步行，不使用几何中心代替。
+
+按一个城市编译待审核数据，例如：
+
+```sh
+node scripts/roam-catalog-import.js --coordinates /tmp/roam-coordinate-review.json --city SH --output /tmp/roam-sh-review.sql
+```
+
+未确认、缺失、重复、过期超过 90 天、未来日期、坐标系错误、跨城或名称地址不一致的记录会拒绝生成。模板中的空值不会变成 0,0。输出文件使用独占创建，不覆盖已有文件。
+
+SQL 将新点位设为 status=0（下架）、type=1、无 merchant_id/template_id/coupon_template_id，沿用平台地点探索值配置。种子标识写入 tags，顺序重跑不重复导入；不覆盖旧地点、已有归属或已下架状态。SQL 附带回读，执行前需在隔离测试库确认现有列、同名重复点和生成语句。并发执行不受此种子标签的唯一约束保护，须由单个运营者串行执行。
+
+数据上线继续使用仓库既有迁移/运营审核路径：核对同名点、入口与来源 → 测试库执行和回读 → 按生产变更流程执行 → 后台审核上架。直接连生产数据库及绕过审核均不属于此工具。商家认领、互动模板、优惠券仍走原有申请审核流程。
+
+## 验证与验收
+
+自动测试：chengyinhub-xcx/tests/unit/roam-city-catalog.test.js，覆盖分类与业务身份隔离、目录筛选、过时选择、详情和复制动作、坐标空值/错城/过期/未来/伪日期/重复身份、SQL 下架和去重以及文本注入。
