+        assertDoesNotThrow(() -> new StubJob(new IllegalStateException("must-not-run")).execute(context));
+        assertEquals(Map.of("requestId", "previous_123"), MDC.getCopyOfContextMap());
+        verifyNoInteractions(jobLogService);
+    }
