+    <select id="selectImRouteCardTopicsByIds" resultMap="CmsTopicResult" useCache="false" flushCache="true">
+        select id,name,img_url,total_mileage,location_count,status,user_status,del_flag,club_member_only
+        from cms_topic
+        where
+        <choose>
+            <when test="topicIds != null and topicIds.size() > 0">
