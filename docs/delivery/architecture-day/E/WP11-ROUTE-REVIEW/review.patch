+              where active_club.id = cms_topic.club_id and active_club.del_flag = 0
+          ))
+          and ((status = 1 and user_status = 1 and <include refid="primaryCirclePublicGate"/>)
+            or (#{viewerMemberId} is not null and #{viewerMemberId} &gt; 0 and member_id = #{viewerMemberId}))
+          and <include refid="clubMemberOnlyGate"/>
+    </select>
