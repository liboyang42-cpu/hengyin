<!-- SOURCE proposal only. B/root owns actual admin POM and fixed three-call-site wiring.
     This explicit profile is admin-only; retain inherited compiler version/release/parameters.
     No activation and no main-source/test-resource/Surefire selection changes. -->
<profile>
  <id>controlled-combination-test-closure</id>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testIncludes>
            <testInclude>com/chengyinhub/business/it/CrossDomainCombinedLoadMySqlIT.java</testInclude>
            <testInclude>com/chengyinhub/business/it/CombinedCoreHttpWorkload.java</testInclude>
            <testInclude>com/chengyinhub/business/it/CombinedControlledProviders.java</testInclude>
            <testInclude>com/chengyinhub/business/it/CrossDomainStorageFixture.java</testInclude>
            <testInclude>com/chengyinhub/business/it/CrossDomainTransportStage.java</testInclude>
            <testInclude>com/chengyinhub/business/it/GameplayProcessRecoveryChild.java</testInclude>
            <testInclude>com/chengyinhub/business/it/GenericGameplayHttpE2eIT.java</testInclude>
            <testInclude>com/chengyinhub/business/it/MybatisItDatabase.java</testInclude>
            <testInclude>com/chengyinhub/business/it/P0AcceptanceSchema.java</testInclude>
            <testInclude>com/chengyinhub/business/it/ItSchema.java</testInclude>
            <testInclude>com/chengyinhub/business/it/R5WeRunFixture.java</testInclude>
            <testInclude>com/chengyinhub/business/service/MysqlIntegrationTestConfig.java</testInclude>
            <testInclude>com/chengyinhub/business/service/ai/AiNotSentGatewayFixture.java</testInclude>
            <testInclude>com/chengyinhub/business/service/impl/CrossDomainSubscriptionProvider.java</testInclude>
            <testInclude>com/chengyinhub/business/service/impl/WechatVerifiedFactTestSupport.java</testInclude>
            <testInclude>com/chengyinhub/business/service/impl/WechatPayTestWiring.java</testInclude>
            <testInclude>com/chengyinhub/quartz/util/CrossDomainSchedulerStage.java</testInclude>
            <testInclude>com/chengyinhub/quartz/util/SchedulerFenceProcessProbe.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</profile>
