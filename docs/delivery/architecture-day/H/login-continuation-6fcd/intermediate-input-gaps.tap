  actual: |-
      goStart() {
        if (this.data.entrySheet) this.closeEntrySheet();
        if (this._roamStartPending) return;
        // 未登录不开漫游:没有会话时 /api/roam/* 全被后端 401 挡下 —— 据点层永远「没加载出来」、
        // 每次揭雾上报弹一次「请先登录」、结算永远失败,而页面自己没有任何出路。
