      '    if (this._roamStartPending) return;\n' +
      '    // 未登录不开漫游:没有会话时 /api/roam/* 全被后端 401 挡下 —— 据点层永远「没加载出来」、\n' +
      '    // 每次揭雾上报弹一次「请先登录」、结算永远失败,而页面自己没有任何出路。\n' +
      '    // 先补一次登录(单航班,与首登共享在途锁);仍没会话就把门闩放掉,给一句人话让人再点。\n' +
      '    // ⚠️ 只在能拿到会话 API 时才判:getApp 抛 / getUserID 不存在(测试沙箱、极早期初始化)\n' +
      '    //    一律放行走原流程 —— 门闩语义不能因为判登录这层新闸被改变。\n' +
      '    let loginApp = null;\n' +
      '    try { loginApp = getApp(); } catch (e) { loginApp = null; }\n' +
      "    if (loginApp && typeof loginApp.getUserID === 'function' && !loginApp.getUserID()) {\n" +
      '      this._roamStartPending = true;\n' +
      '      Promise.resolve(loginApp.firstLogin ? loginApp.firstLogin() : null).then(() => {\n' +
      '        this._roamStartPending = false;\n' +
      "        if (typeof loginApp.getUserID === 'function' && loginApp.getUserID()) { this.goStart(); return; }\n" +
      "        this.setData({ introError: '登录失败，请重试', locErr: false });\n" +
      '      });\n' +
      '      return;\n' +
      '    }\n' +
      '    '

  code: 'ERR_ASSERTION'
  name: 'AssertionError'
