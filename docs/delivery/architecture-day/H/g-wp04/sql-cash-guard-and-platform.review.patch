+    @Test void realPlatformSettlementLineMustInsertAndReadBackAgainstRepositorySchema() throws Exception {
+        Path baseline = Path.of("../sql/base_schema_20260818.sql");
+        if (!Files.isRegularFile(baseline)) baseline = Path.of("sql/base_schema_20260818.sql");
+        Matcher ddl = Pattern.compile("(?s)CREATE TABLE `coop_settlement` \\(.*?\\) ENGINE=.*?;")
+                .matcher(Files.readString(baseline));
+        assertTrue(ddl.find());
+        db.execute(ddl.group()); // only the existing fixture's isolated UUID database
+        try {
+            SqlSessionFactoryBean factory = new SqlSessionFactoryBean();
+            factory.setDataSource(db.getDataSource());
+            factory.setTypeAliasesPackage("com.chengyinhub.business.domain");
+            factory.setMapperLocations(new ClassPathResource("mapper/business/CoopSettlementMapper.xml"));
+            com.chengyinhub.business.mapper.CoopSettlementMapper settlements =
+                    new SqlSessionTemplate(factory.getObject()).getMapper(
+                            com.chengyinhub.business.mapper.CoopSettlementMapper.class);
+            com.chengyinhub.business.domain.CmsTopic topic = new com.chengyinhub.business.domain.CmsTopic();
+            topic.setId(11L);
+            com.chengyinhub.business.domain.CoopSettlement platform =
+                    org.springframework.test.util.ReflectionTestUtils.invokeMethod(
+                            new com.chengyinhub.business.service.impl.CmsTopicServiceImpl(),
+                            "newSettlementLine", topic, null, new java.math.BigDecimal("1.00"),
+                            "PLATFORM", "platform", 1, new Date(), new Date(), 1,
+                            new java.math.BigDecimal("10.00"), "1");
+            // Do not invent a fake member ID/default or weaken the real DDL to make this pass.
+            tx.execute(status -> {
+                assertEquals(1, settlements.insertCoopSettlement(platform));
+                assertNotNull(platform.getId());
+                assertEquals("PLATFORM", db.queryForObject(
+                        "SELECT line_type FROM coop_settlement WHERE id=?", String.class, platform.getId()));
+                assertEquals(1, db.queryForObject(
+                        "SELECT status FROM coop_settlement WHERE id=?", Integer.class, platform.getId()));
+                assertEquals(0, new java.math.BigDecimal("1.00").compareTo(db.queryForObject(
+                        "SELECT amount FROM coop_settlement WHERE id=?", java.math.BigDecimal.class, platform.getId())));
+                return null;
+            });
+        } finally {
+            db.execute("DROP TABLE coop_settlement");
+        }
+        // Covers this positive header write only; full claims/payout/balance acceptance remains separate.
+    }
