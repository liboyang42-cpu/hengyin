+    @Test void cashBasisGuardCannotRemainEmptyAfterCurrentEvidenceSeesCommittedActivityCash() throws Exception {
+        db.update("UPDATE cms_registration SET payment_status=1,verification_status=0 WHERE owner_type=2");
+        java.util.concurrent.ExecutorService callback = java.util.concurrent.Executors.newSingleThreadExecutor();
+        try {
+            tx.execute(status -> {
+                assertEquals(0, mapper.countPaidActivityRegistrations(11L)); // establish RR read view
+                java.util.concurrent.Future<Integer> paid = callback.submit(() -> db.update(
+                        "UPDATE cms_registration SET payment_status=2,registration_status=2 WHERE id=2"));
+                try {
+                    assertEquals(1, paid.get(5, java.util.concurrent.TimeUnit.SECONDS));
+                } catch (Exception failure) {
+                    throw new IllegalStateException("payment fixture did not commit independently", failure);
+                }
+                List<CoopSettlementCandidate> locked = mapper.selectTopicEvidenceCandidatesForUpdate(
+                        snapshot("TOPIC",11), List.of(201L), cutoff());
+                CoopSettlementCandidate activity = locked.stream()
+                        .filter(row -> Long.valueOf(2L).equals(row.getRegistrationId())).findFirst().orElseThrow();
+                assertEquals(2, activity.getPaymentStatus()); // FOR UPDATE sees the committed payment
+                assertEquals(0, activity.getVerificationStatus()); // originLines excludes it before context validation
+                assertEquals(1, mapper.countPaidActivityRegistrations(11L),
+                        "cash guard must agree with current locked financial facts, not an earlier cached/RR miss");
+                return null;
+            });
+        } finally {
+            callback.shutdownNow();
+        }
+        // This isolates the real Mapper/transaction race; it does not claim full payment callback or settlement acceptance.
+    }
