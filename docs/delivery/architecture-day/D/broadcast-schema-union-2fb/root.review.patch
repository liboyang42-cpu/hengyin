+class BroadcastForwardCallerTest(unittest.TestCase):
+    """SOURCE controls: exact broadcast composition, not MySQL or production migration evidence."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.plan = tool.build_plan()
