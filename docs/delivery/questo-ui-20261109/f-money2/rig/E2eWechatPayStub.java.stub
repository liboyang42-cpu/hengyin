                                                  String description, String openid) {
        return createOrder(null);
    }

    /** 受控参数从 body 直读(明文 JSON),再交给真实业务回调处理。 */
    @Override
    public String handlePayCallback(String requestBody, Map<String, String> headers) {
        try {
            JsonNode root = JSON.readTree(requestBody);
            Map<String, String> resultMap = new HashMap<String, String>();
            resultMap.put("out_trade_no", root.path("out_trade_no").asText(null));
            resultMap.put("transaction_id", root.path("transaction_id").asText(null));
            resultMap.put("trade_state", root.path("trade_state").asText(null));
            if (root.hasNonNull("total")) {
                resultMap.put("total", String.valueOf(root.path("total").asInt()));
            }
            // 原始可信事实的引用与渠道身份只做透传:真实回调按 verified_fact_id/hash 回读已存在的 VERIFIED 行逐项核对,
            // 桩不造事实,也不替业务侧判断它对不对。
            for (String key : new String[]{"verified_fact_id", "verified_fact_hash", "wx_out_trade_no",
                    "mchid", "appid", "trade_type", "currency"}) {
                if (root.hasNonNull(key)) resultMap.put(key, root.path(key).asText());
            }
            String outTradeNo = resultMap.get("out_trade_no");
            String transactionId = resultMap.get("transaction_id");
            Integer total = root.hasNonNull("total") ? root.path("total").asInt() : null;
            String result;
            IClubMembershipService membership = clubMembershipServiceProvider == null
                    ? null : clubMembershipServiceProvider.getIfAvailable();
            if (outTradeNo != null && outTradeNo.startsWith("CLM")) {
                RigChannelLedger.move("PAYMENT", "PAYER", root.path("mchid").asText(""), total == null ? 0 : total, outTradeNo, transactionId);
                boolean paid = "SUCCESS".equals(resultMap.get("trade_state"));
                result = paid && membership != null && membership.supportsOutTradeNo(outTradeNo)
                        && membership.handlePaidInvoice(outTradeNo, paid, total, transactionId, verifiedReference(root,outTradeNo,total,transactionId))
                        ? "SUCCESS" : "FAIL";
            } else if (outTradeNo != null && outTradeNo.startsWith("PPO") && callbackRouter != null) {
                // [f-money2 rig] 通行证 JSAPI 回调交给产品真实路由(WechatPaymentCallbackRouter → PlatformPassService.handleJsapiPaid)。
                RigChannelLedger.move("PAYMENT", "PAYER", root.path("mchid").asText(""), total == null ? 0 : total, outTradeNo, transactionId);
                result = callbackRouter.payment(resultMap).result();
            } else if (merchantCommerceService.supportsOutTradeNo(outTradeNo)) {
                boolean paid = "SUCCESS".equalsIgnoreCase(resultMap.get("trade_state"));
                result = paid && merchantCommerceService.handlePaidOrder(outTradeNo, paid, total, transactionId, verifiedReference(root,outTradeNo,total,transactionId))
                        ? "SUCCESS" : "FAIL";
            } else if (outTradeNo != null && outTradeNo.startsWith("DEP")) {
                boolean paid = "SUCCESS".equalsIgnoreCase(resultMap.get("trade_state"));
                result = "FAIL";
                if (paid && total != null && "CNY".equals(root.path("currency").asText(null))
                        && wxPayConfig.getMerchantId() != null
                        && wxPayConfig.getMerchantId().equals(root.path("mchid").asText(null))
                        && depositPaymentFacts != null) {
                    // The fake channel never creates VERIFIED facts; only an already trusted original may be consumed.
                    var original = depositPaymentFacts.findPaymentSuccess(wxPayConfig.getMerchantId(), outTradeNo, transactionId);
                    if (original != null && outTradeNo.equals(original.facts().businessOutTradeNo())
                            && "CNY".equals(original.facts().currency())
                            && original.facts().totalFen() == total.longValue()
                            && original.facts().amountFen() == total.longValue()
                            && coopInviteService.markDepositPaid(outTradeNo, total.longValue(), transactionId, original.reference()))
                        result = "SUCCESS";
                }
            } else {
                RigChannelLedger.move("PAYMENT", "PAYER", root.path("mchid").asText(""), total == null ? 0 : total, outTradeNo, transactionId);
                result = registrationService.handleWechatPayCallback(resultMap);
            }
            if (!"SUCCESS".equalsIgnoreCase(result)) {
                return "{\"code\": \"FAIL\",\"message\": \"" + result + "\"}";
            }
            return "{\"code\": \"SUCCESS\",\"message\": \"成功\"}";
        } catch (Exception e) {
            return "{\"code\": \"FAIL\",\"message\": \"" + e.getClass().getSimpleName() + "\"}";
        }
    }

    /** Fixture consumes an explicitly stored original Reference; never creates proof from plaintext. */
    private com.chengyinhub.business.domain.dto.WechatVerifiedPaymentFact.Reference verifiedReference(
            JsonNode root,String no,Integer fen,String tx) {
        var ref=new com.chengyinhub.business.domain.dto.WechatVerifiedPaymentFact.Reference(
                root.path("verified_fact_id").asLong(0),root.path("verified_fact_hash").asText(null));
        var stored=verifiedPaymentFacts.requireVerified(ref);var fact=stored.facts();
        if(!ref.equals(stored.reference()) || !ref.hash().equals(fact.factHash())
                || fact.kind()!=com.chengyinhub.business.domain.dto.WechatVerifiedPaymentFact.Kind.PAYMENT
                || !no.equals(fact.businessOutTradeNo()) || fen==null || fact.totalFen()!=fen.longValue()
                || !tx.equals(fact.transactionId()))throw new IllegalArgumentException("original fixture payment required");
        return ref;
    }

    @Override
    public String handleRefundCallback(String requestBody, Map<String, String> headers) {
        // [f-money2 rig] 模拟微信退款通知:通知体只给 out_refund_no,事实一律回查(同真实网关),再交真实路由落账。
        try {
            String no = JSON.readTree(requestBody).path("out_refund_no").asText(null);
            RigRefund r = no == null ? null : rigRefunds.get(no);
            if (r == null) return "{\"code\": \"FAIL\",\"message\": \"unknown refund\"}";
            Map<String, String> facts = queryRefundFacts(r.original(), no);
            boolean ok = facts != null && "SUCCESS".equals(facts.get("status")) && callbackRouter.refund(facts);
            return ok ? "{\"code\": \"SUCCESS\",\"message\": \"成功\"}" : "{\"code\": \"FAIL\",\"message\": \"not applied\"}";
        } catch (Exception e) {
            return "{\"code\": \"FAIL\",\"message\": \"" + e.getClass().getSimpleName() + "\"}";
        }
    }

