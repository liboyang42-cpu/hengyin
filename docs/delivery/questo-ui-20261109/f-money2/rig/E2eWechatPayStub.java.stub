    public boolean isReady() {
        return true;
    }

    @Override
    public boolean isAppReady() {
        return true;
    }

    @Override
    public Map<String, String> createOrder(CmsRegistration registration) {
        // [f-money2 rig] 同 WechatPaymentSdkGateway.createOrder:先问产品的电商收付通适配器,不是卖家收款单才走直连桩。
        if (registration != null) {
            Map<String, String> partnerParams = partnerBridge.createOrder(registration, wxPayConfig.getMerchantId());
            if (partnerParams != null) return partnerParams;
        }
        Map<String, String> params = new LinkedHashMap<String, String>();
        params.put("appId", "e2e-stub-appid");
        params.put("timeStamp", "0");
        params.put("nonceStr", "e2estub");
        params.put("package", "prepay_id=e2e-stub");
        params.put("signType", "RSA");
        params.put("paySign", "e2e-stub");
        return params;
    }

