/**
 * ★桩:支付可用性(环境依赖)。只存在于本地 e2e 运行时的 exploded jar 里,仓库产品码一行都没有。
 *
 * <p>桩掉的只有【外部支付通道】这一层:商户凭据、SDK 构造、官方验签、预下单。
 * 「支付成功」仍然走【真实回调入口】 POST /api/registration/callback →
 * 会员、商城、押金或报名的真实业务服务,因此金额冻结校验
 * (matchesFrozenWechatAmount)、订单状态机、entitlement 等业务侧一条都没被绕过。
 * 绝不直接改 payment_status。
 */
@Component
@Primary
public class E2eWechatPayStub implements IWechatPayService {

    private static final ObjectMapper JSON = new ObjectMapper();
    // 用 @Lazy 字段注入而不是构造注入:产品码里 CmsTopicServiceImpl 也注入 IWechatPayService,
    // 构造注入会形成 stub → registrationService → … → wechatPayService → stub 的循环。
    @org.springframework.beans.factory.annotation.Autowired
    @org.springframework.context.annotation.Lazy
    private ICmsRegistrationService registrationService;

    @org.springframework.beans.factory.annotation.Autowired
    private ObjectProvider<IClubMembershipService> clubMembershipServiceProvider;

    @org.springframework.beans.factory.annotation.Autowired
    @org.springframework.context.annotation.Lazy
    private IMerchantCommerceService merchantCommerceService;

    @org.springframework.beans.factory.annotation.Autowired
    @org.springframework.context.annotation.Lazy
    private ICoopInviteService coopInviteService;

    @org.springframework.beans.factory.annotation.Autowired
    private com.chengyinhub.business.service.impl.WechatVerifiedPaymentFactService depositPaymentFacts;

    @org.springframework.beans.factory.annotation.Autowired
    private WxPayConfig wxPayConfig;

    /** [f-money2 rig] 产品真实回调路由;退款通知与通行证支付都经它分发。 */
    @org.springframework.beans.factory.annotation.Autowired
    @org.springframework.context.annotation.Lazy
    private com.chengyinhub.business.service.impl.WechatPaymentCallbackRouter callbackRouter;

    @org.springframework.beans.factory.annotation.Autowired
    @org.springframework.context.annotation.Lazy
    private com.chengyinhub.business.service.impl.RigPartnerBridge partnerBridge;

    /** [f-money2 rig] 直连商户号退款通道模拟:outRefundNo → 受理记录。 */
    private final java.util.concurrent.ConcurrentHashMap<String, RigRefund> rigRefunds = new java.util.concurrent.ConcurrentHashMap<>();
    private record RigRefund(com.chengyinhub.business.domain.dto.WechatVerifiedPaymentFact.Reference original,
                             String outRefundNo, long refundFen, String refundId, java.time.Instant successAt) { }

    @org.springframework.beans.factory.annotation.Autowired
    private com.chengyinhub.business.service.impl.WechatVerifiedPaymentFactService verifiedPaymentFacts;

    @Override
    public String resolveBusinessOrderNo(String wxOutTradeNo) {
        // 夹具没有真实支付尝试，不伪造持久化订单映射。
        return null;
    }

