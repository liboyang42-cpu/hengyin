    }

    @Override
    public String handleEcommerceRefundCallback(String requestBody, Map<String, String> headers) {
        try { return partnerBridge.ecommerceRefundCallback(requestBody, headers); }
        catch (Exception e) { return "{\"code\": \"FAIL\",\"message\": \"" + e.getClass().getSimpleName() + "\"}"; }
    }

