    }
    @Override
    public Map<String,String> queryRefundFacts(com.chengyinhub.business.domain.dto.WechatVerifiedPaymentFact.Reference originalPayment, String outRefundNo) {
        boolean[] handled = new boolean[1];
        Map<String,String> partnerFacts = partnerBridge.queryRefundFacts(originalPayment, outRefundNo, handled);
        if (handled[0]) return partnerFacts;
        // [f-money2 rig] 模拟微信退款查单:只回本通道受理过的退款;SUCCESS 时与真实网关同口径写一条 VERIFIED REFUND 事实。
        RigRefund r = outRefundNo == null ? null : rigRefunds.get(outRefundNo);
        if (r == null) { Map<String,String> missing = new HashMap<>(); missing.put("status","NOT_FOUND"); return missing; }
        if (!r.original().equals(originalPayment)) return null;
        var paid = verifiedPaymentFacts.requireVerified(originalPayment).facts();
        Map<String,String> facts = new HashMap<>();
        facts.put("outRefundNo", outRefundNo); facts.put("outTradeNo", paid.businessOutTradeNo());
        facts.put("wxOutTradeNo", paid.wxOutTradeNo()); facts.put("status", "SUCCESS");
        facts.put("refund", String.valueOf(r.refundFen())); facts.put("total", String.valueOf(paid.totalFen()));
        facts.put("currency", "CNY"); facts.put("mchid", paid.mchid()); facts.put("appid", paid.appid());
        facts.put("tradeType", paid.tradeType()); facts.put("transactionId", paid.transactionId());
        facts.put("refundId", r.refundId()); facts.put("successTime", r.successAt().toString());
        var fact = new com.chengyinhub.business.domain.dto.WechatVerifiedPaymentFact(
                com.chengyinhub.business.domain.dto.WechatVerifiedPaymentFact.Kind.REFUND,
                paid.mchid(), paid.appid(), paid.businessOutTradeNo(), paid.wxOutTradeNo(), outRefundNo, r.refundId(),
                paid.transactionId(), paid.tradeType(), "CNY", paid.totalFen(), r.refundFen(), r.successAt(),
                paid.intentRequestHash(), "SUCCESS");
        var ref = verifiedPaymentFacts.recordVerified(fact);
        facts.put("verified_fact_id", Long.toString(ref.id())); facts.put("verified_fact_hash", ref.hash());
        return facts;
    }

    @Override public boolean lockClosablePaymentAttemptForUpdate(String businessNo,String observedWxNo) { return false; }

