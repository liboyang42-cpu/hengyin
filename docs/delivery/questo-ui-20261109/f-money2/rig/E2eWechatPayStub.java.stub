/**
 * [f-money2 rig] 通道资金移动记账:每笔「从 → 到 金额」追加一行 JSON 到 $RIG_CHANNEL_LEDGER(默认不写)。
 * 只描述模拟通道里发生的移动,不参与任何业务判断。
 */
final class RigChannelLedger {
    private RigChannelLedger() { }
    static synchronized void move(String kind, String from, String to, long fen, String ref, String ref2) {
        // 应用进程只继承白名单环境变量;rig 应用的工作目录是 $RIG_HOME/work,账本固定写在 $RIG_HOME/out。
        String path = System.getenv().getOrDefault("RIG_CHANNEL_LEDGER", "../out/channel-ledger.jsonl");
        String line = String.format("{\"at\":\"%s\",\"kind\":\"%s\",\"from\":\"%s\",\"to\":\"%s\",\"fen\":%d,\"ref\":\"%s\",\"ref2\":\"%s\"}%n",
                java.time.Instant.now(), kind, from, to, fen, ref, ref2 == null ? "" : ref2);
        try {
            java.nio.file.Files.writeString(java.nio.file.Path.of(path), line, java.nio.charset.StandardCharsets.UTF_8,
                    java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);
        } catch (java.io.IOException ignored) { }
    }
}

/**
 * [f-money2 rig] 电商收付通通道模拟器:把产品的 wechatEcommercePayGateway bean 换成内存通道,
 * 按微信语义回包(下单 → 通知 → 查单、分账 → 查询 → 完结、回退、电商退款 → 查询),每笔移动记账。
 * 只在 rig 的 exploded jar 里存在;开关(payout.ecommerce.*)仍由产品 PayoutSwitches 判定,关时产品根本不会调到这里。
 * 支付通知:rig 只 POST {"sub_mchid","out_trade_no"} 到真实通知入口,本模拟器把它当作「付款人已付」,
 * 产品随后照真实流程回查 queryPartnerOrder 并逐字段核对后才写 PAYMENT 事实。
 */
@org.springframework.stereotype.Component
class RigEcommerceChannel implements org.springframework.beans.factory.config.BeanPostProcessor {
    @Override
    public Object postProcessAfterInitialization(Object bean, String beanName) {
        if ("wechatEcommercePayGateway".equals(beanName)
                && bean instanceof com.chengyinhub.business.payout.EcommercePayGateway
                && !(bean instanceof Channel)) {
            return new Channel();
        }
        return bean;
    }

    static final class Channel implements com.chengyinhub.business.payout.EcommercePayGateway {
        private record Order(String sub, String outTradeNo, long totalFen, String state, String txn, String successTime) { }
        private record Refund(String sub, String outRefundNo, String outTradeNo, String txn, long fen, long total) { }
        private final java.util.Map<String, Order> orders = new java.util.concurrent.ConcurrentHashMap<>();
        private final java.util.Map<String, ShareResult> shares = new java.util.concurrent.ConcurrentHashMap<>();
        private final java.util.Map<String, ReturnResult> returns = new java.util.concurrent.ConcurrentHashMap<>();
        private final java.util.Map<String, Refund> refunds = new java.util.concurrent.ConcurrentHashMap<>();
        private static final com.fasterxml.jackson.databind.ObjectMapper JSON = new com.fasterxml.jackson.databind.ObjectMapper();

        // 与 install-channel.sh 的 --payout.ecommerce.sp-mchid / sp-appid 同值(应用进程不继承任意环境变量)。
        private static String sp() { return "1900009001"; }
        private static String spAppid() { return "wxrigsp000000001"; }

        @Override public java.util.Map<String, String> prepayJsapi(String subMchid, String outTradeNo, long totalFen, String description, String spOpenid) {
            orders.putIfAbsent(outTradeNo, new Order(subMchid, outTradeNo, totalFen, "NOTPAY", null, null));
            java.util.Map<String, String> p = new java.util.LinkedHashMap<>();
            p.put("appId", spAppid()); p.put("timeStamp", "0"); p.put("nonceStr", "rigecom");
            p.put("package", "prepay_id=rig-ecom-" + outTradeNo); p.put("signType", "RSA"); p.put("paySign", "rig");
            return p;
        }
        @Override public ApplymentSubmitted submitApplyment(String outRequestNo, java.util.Map<String, Object> body) { return new ApplymentSubmitted(1L); }
        /** 进件:rig 视为微信已审核通过并签约,按 out_request_no 派生一个稳定的二级商户号。 */
        @Override public ApplymentStatus queryApplyment(String outRequestNo) {
            String sub = "1901" + String.format("%06d", Math.floorMod(outRequestNo.hashCode(), 1000000));
            return new ApplymentStatus(1L, "FINISH", "rig 视为已完成进件", null, sub);
        }

        @Override public ShareResult createProfitSharing(String subMchid, String transactionId, String outOrderNo,
                                                         java.util.List<com.chengyinhub.business.payout.ProfitSharePlanner.Receiver> receivers, boolean finish) {
            ShareResult existing = shares.get(outOrderNo);
            if (existing != null) return existing;
            java.util.List<ReceiverResult> out = new java.util.ArrayList<>();
            for (var r : receivers) {
                out.add(new ReceiverResult(r.mchid(), r.amountFen(), "SUCCESS", null));
                RigChannelLedger.move("PROFIT_SHARE", subMchid, r.mchid(), r.amountFen(), outOrderNo, transactionId);
            }
            ShareResult result = new ShareResult("FINISHED", "RIG-PS-" + outOrderNo, out);
            shares.put(outOrderNo, result);
            if (finish) RigChannelLedger.move("UNFREEZE", subMchid + "(冻结)", subMchid, 0, outOrderNo, "finish=true");
            return result;
        }
        @Override public ShareResult queryProfitSharing(String subMchid, String transactionId, String outOrderNo) {
            ShareResult r = shares.get(outOrderNo);
            if (r == null) throw new IllegalStateException("RESOURCE_NOT_EXISTS");
            return r;
        }
        @Override public ReturnResult createReturn(String subMchid, String outOrderNo, String outReturnNo, String returnMchid, long amountFen, String description) {
            ReturnResult existing = returns.get(outReturnNo);
            if (existing != null) return existing;
            RigChannelLedger.move("PROFIT_SHARE_RETURN", returnMchid, subMchid, amountFen, outOrderNo, outReturnNo);
            ReturnResult r = new ReturnResult("SUCCESS", "RIG-RT-" + outReturnNo, null);
            returns.put(outReturnNo, r);
            return r;
        }
        @Override public ReturnResult queryReturn(String subMchid, String outOrderNo, String outReturnNo) {
            ReturnResult r = returns.get(outReturnNo);
            if (r == null) throw new IllegalStateException("RESOURCE_NOT_EXISTS");
            return r;
        }
        @Override public void finishProfitSharing(String subMchid, String transactionId, String outOrderNo, String description) {
            RigChannelLedger.move("UNFREEZE", subMchid + "(冻结)", subMchid, 0, outOrderNo, "finish");
        }
        @Override public RefundAccepted createRefund(String subMchid, String transactionId, String outRefundNo, long refundFen, long totalFen, String reason) {
            Order o = null;
            for (Order x : orders.values()) if (transactionId != null && transactionId.equals(x.txn())) o = x;
            if (o == null || !subMchid.equals(o.sub()) || refundFen <= 0 || refundFen > totalFen) throw new IllegalStateException("INVALID_REQUEST");
            if (refunds.putIfAbsent(outRefundNo, new Refund(subMchid, outRefundNo, o.outTradeNo(), transactionId, refundFen, totalFen)) == null)
                RigChannelLedger.move("REFUND", subMchid, "PAYER", refundFen, o.outTradeNo(), outRefundNo);
            return new RefundAccepted("RIG-ERF-" + outRefundNo, outRefundNo);
        }
        @Override public String paymentNotifyUrl() { return "https://rig.invalid/api/payout/ecommerce/notify"; }
        @Override public PartnerOrder queryPartnerOrder(String subMchid, String outTradeNo) {
            Order o = orders.get(outTradeNo);
            if (o == null || !o.sub().equals(subMchid)) throw new PartnerOrderNotFound("ORDER_NOT_EXIST", null);
            return new PartnerOrder(sp(), o.sub(), spAppid(), o.outTradeNo(), o.txn(), o.state(), "JSAPI", o.totalFen(), "CNY", o.successTime());
        }
        @Override public void closePartnerOrder(String subMchid, String outTradeNo) {
            orders.computeIfPresent(outTradeNo, (k, o) -> "NOTPAY".equals(o.state()) ? new Order(o.sub(), k, o.totalFen(), "CLOSED", null, null) : o);
        }
        @Override public PartnerOrder parsePaymentNotification(String body, java.util.Map<String, String> headers) {
            try {
                var n = JSON.readTree(body);
                String no = n.path("out_trade_no").asText(null), sub = n.path("sub_mchid").asText(null);
                Order o = no == null ? null : orders.get(no);
                if (o == null || !o.sub().equals(sub)) throw new IllegalArgumentException("unknown order");
                if ("NOTPAY".equals(o.state())) {
                    String txn = "RIG-ETX-" + no;
                    String at = java.time.OffsetDateTime.now(java.time.ZoneOffset.ofHours(8)).withNano(0).toString();
                    o = new Order(o.sub(), no, o.totalFen(), "SUCCESS", txn, at);
                    orders.put(no, o);
                    RigChannelLedger.move("PAYMENT", "PAYER", o.sub() + "(冻结)", o.totalFen(), no, txn);
                }
                return queryPartnerOrder(o.sub(), no);
            } catch (java.io.IOException e) { throw new IllegalArgumentException(e); }
        }
        @Override public RefundNotice parseRefundNotification(String body, java.util.Map<String, String> headers) {
            try {
                var n = JSON.readTree(body);
                Refund r = refunds.get(n.path("out_refund_no").asText(""));
                if (r == null) throw new IllegalArgumentException("unknown refund");
                return new RefundNotice(sp(), r.sub(), r.outRefundNo());
            } catch (java.io.IOException e) { throw new IllegalArgumentException(e); }
        }
        @Override public RefundQuery queryRefund(String subMchid, String outRefundNo) {
            Refund r = refunds.get(outRefundNo);
            if (r == null || !r.sub().equals(subMchid)) throw new RefundNotFound("RESOURCE_NOT_EXISTS", null);
            return new RefundQuery(outRefundNo, "RIG-ERF-" + outRefundNo, r.outTradeNo(), r.txn(), "SUCCESS", r.fen(), "CNY",
                    java.time.OffsetDateTime.now(java.time.ZoneOffset.ofHours(8)).withNano(0).toString());
        }
    }
}
