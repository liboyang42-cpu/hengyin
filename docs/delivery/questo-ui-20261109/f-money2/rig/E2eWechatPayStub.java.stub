    @Override
    public RefundRequestResult submitRefund(String outTradeNo, String outRefundNo, BigDecimal refundAmount,
                                            BigDecimal totalAmount, String reason) {
        return RefundRequestResult.DEFINITIVE_FAILED;
    }

    @Override
    public RefundRequestResult submitRefund(com.chengyinhub.business.domain.dto.WechatVerifiedPaymentFact.Reference originalPayment,
                                            String outTradeNo, String outRefundNo, BigDecimal refundAmount,
                                            BigDecimal totalAmount, String reason) {
        RefundRequestResult partnerResult = partnerBridge.submitRefund(originalPayment, outTradeNo, outRefundNo,
                refundAmount.movePointRight(2).longValueExact(), totalAmount.movePointRight(2).longValueExact(), reason);
        if (partnerResult != null) return partnerResult;
        // [f-money2 rig] 模拟微信退款受理:只认已存在的 VERIFIED 原支付事实,金额不得超过原单;受理即记一笔通道移动。
        try {
            var paid = verifiedPaymentFacts.requireVerified(originalPayment).facts();
            long fen = refundAmount.movePointRight(2).longValueExact();
            if (paid.kind() != com.chengyinhub.business.domain.dto.WechatVerifiedPaymentFact.Kind.PAYMENT
                    || !paid.businessOutTradeNo().equals(outTradeNo) || fen <= 0 || fen > paid.totalFen()
                    || outRefundNo == null || !outRefundNo.matches("[A-Za-z0-9_-]{1,64}")) return RefundRequestResult.DEFINITIVE_FAILED;
            RigRefund existing = rigRefunds.putIfAbsent(outRefundNo, new RigRefund(originalPayment, outRefundNo, fen,
                    "RIG-RF-" + outRefundNo, java.time.Instant.now().truncatedTo(java.time.temporal.ChronoUnit.SECONDS)));
            if (existing == null) RigChannelLedger.move("REFUND", paid.mchid(), "PAYER", fen, outTradeNo, outRefundNo);
            return RefundRequestResult.ACCEPTED;
        } catch (RuntimeException e) {
            return RefundRequestResult.UNKNOWN;
        }
    }

