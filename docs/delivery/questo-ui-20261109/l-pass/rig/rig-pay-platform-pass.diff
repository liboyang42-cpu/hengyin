+    if not rows:
+        return None
+    oid, ono, fen = rows[0]
+    txn = "RIG-PPO-TXN-%d" % oid
+    with contextlib.redirect_stdout(io.StringIO()):
+        fact = cp.store_trusted_payment_fact(ono, txn, int(fen))
+        cb = http("POST", "/api/registration/callback", json_body=dict(fact, **{
+            "out_trade_no": ono, "transaction_id": txn, "trade_state": "SUCCESS", "total": int(fen)}))
+    after = q("SELECT status,transaction_id FROM platform_pass_order WHERE id=%s", (oid,))[0]
+    ok = cb.get("_status") == 204 and after[1] == txn and int(after[0]) == 1
+    return {"ok": ok, "platformPassOrder": ono, "totalFen": int(fen), "callbackStatus": cb.get("_status"),
+            "readback": [str(x) for x in after], "callbackBody": str(cb.get("_raw", ""))[:200]}
+
+
 def pay(member=None, reg_no=None):
+    if member and not reg_no:
+        pp = pay_platform_pass(member)
+        if pp is not None:
+            return pp
     if reg_no:
