 from chain_lib import http, q  # noqa: E402
 
 
+def pay_platform_pass(member):
+    # [SEAM l-pass] newest pending JSAPI 通行证 order of this member, through the same real callback path.
+    rows = q("SELECT id,order_no,price_fen FROM platform_pass_order WHERE member_id=%s AND status=0 AND channel='JSAPI' "
