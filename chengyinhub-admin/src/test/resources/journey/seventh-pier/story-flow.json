        "npcId": 102
      },
      {
        "type": "text",
        "beat": "outcome",
        "field": "lineIfFail",
        "content": "「授权页写得很清楚。照着做就行。」",
        "nodeIndex": 1
      },
      {
        "type": "text",
        "beat": "outcome",
        "field": "fact",
        "content": "P-02 合照、公共演奏:同意展陈",
