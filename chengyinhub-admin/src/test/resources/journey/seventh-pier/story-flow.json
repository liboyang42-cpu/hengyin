      {
        "type": "text",
        "beat": "outcome",
        "field": "fact",
        "content": "被剪的 02:00—03:00 是「私人告别,不予公开」",
        "nodeIndex": 0
      },
      {
        "type": "text",
        "beat": "outcome",
        "field": "fact",
        "content": "私人限制不等于不存在",
        "nodeIndex": 0
      },
      {
        "type": "text",
        "beat": "outcome",
        "field": "fact",
        "content": "原声:居民称这里为第七码头",
