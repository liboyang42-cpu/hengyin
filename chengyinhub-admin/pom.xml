    <build>
        <plugins>
            <!-- Mockito 5 on Java 21 uses a startup agent instead of restricted dynamic self-attach. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.10.0</version>
                <executions>
                    <execution>
                        <id>resolve-test-agent</id>
                        <phase>initialize</phase>
                        <goals><goal>properties</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <warName>${project.artifactId}</warName>
                </configuration>
           </plugin>
            <!-- 把 commit id 打进 jar(BOOT-INF/classes/git.properties),让制品能自报出身。
                 .github/workflows/deploy.yml 据此断言「构建产物 == 本次要部署的 commit」;
                 再配合 jar 指纹比对,才能传递出「生产上跑的 == 这个 commit」。
                 没有它,就只剩"部署器自己写个 SHA 文件再读回来"那种恒真断言。 -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>5.0.0</version>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git\.commit\.id$</includeOnlyProperty>
                    </includeOnlyProperties>
                    <!-- 非 git 环境(如从 tar 包)构建时不炸;此时 git.properties 不生成,
                         deploy.yml 的断言会因读不到而变红——该红的地方仍然红。 -->
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <!-- ⚠️ 别删:内置 JGit 读不了 git worktree —— worktree 里 .git 是个文件
                         (内容 `gitdir: /主仓/.git/worktrees/xxx`)而不是目录,JGit 会报
                         「Could not get HEAD Ref」直接炸掉构建。而本仓的标准工作流是
                         「一并行任务 = 一 worktree」,等于每个会话本地 mvn 都会炸。
                         改用系统 git 命令行即可,它天然认 worktree。
                         (4.9.10 与 5.0.0 的 JGit 实测都炸;CI 用 actions/checkout 是真 .git
                          目录所以不炸 —— 这个坑只在本地 worktree 里现形。) -->
                    <useNativeGit>true</useNativeGit>
                </configuration>
            </plugin>
        </plugins>
        <finalName>${project.artifactId}</finalName>
    </build>

    <profiles>
